 column=(type=char(120) updatewhereclause=yes name=prod_foto_editada dbname="inmprodu.prod_foto_editada" dbalias=".prod_foto_editada" )
 retrieve="  SELECT  inmprodu.prod_producto ,           inmprodu.prod_descripcion ,           inmprodu.prod_producto_dos ,           inmprodu.prod_descripcion_dos ,           inmprodu.prod_medida ,           inmprodu.prod_peso ,           inmprodu.prod_cubicaje ,           inmprodu.prod_empaque ,           inmprodu.prod_empaque_descripcion ,           inmprodu.prod_peso_descripcion ,           inmprodu.prod_fecha_creacion ,           inmprodu.prod_owner ,           inmprodu.prod_barra ,           inmprodu.prod_arancel ,           inmprodu.prod_codigo_modelo ,           inmprodu.prod_cod_alternativo ,           inmprodu.prod_ultima_actualizacion ,           inmprodu.prod_foto_dir ,           inmprodu.prod_ultima_salida_doc ,           inmprodu.prod_salida_fecha ,           inmprodu.prod_entrada_fecha ,           inmprodu.prod_ultima_entrada_doc ,           inmprodu.prod_ultima_entrada_can ,           inmprodu.prod_cant_transito ,           inmprodu.prod_reserva_total ,           inmprodu.prod_existencia_total ,           inmprodu.prod_precio1 ,           inmprodu.prod_precio2 ,           inmprodu.prod_precio3 ,           inmprodu.prod_precio4 ,           inmprodu.prod_precio5 , prod_foto_catalogo, prod_foto_editada    FROM inmprodu      WHERE ( inmprodu.prod_g_financiero = :grupo ) and          ( inmprodu.prod_empresa = :empresa ) and          ( inmprodu.prod_producto = :producto ) and          ( substring(inmprodu.prod_owner,1,1) = ~"1~" ) and          ( inmprodu.prod_status = 1 )  ORDER BY inmprodu.prod_producto          ASC  " arguments=(("grupo", number),("empresa", number),("producto", string)) )
