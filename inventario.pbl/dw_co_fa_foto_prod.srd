 column=(type=char(14) updatewhereclause=yes name=inmprodu_prod_codigo_modelo dbname="inmprodu.prod_codigo_modelo" dbalias=".prod_codigo_modelo" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_cod_alternativo dbname="inmprodu.prod_cod_alternativo" dbalias=".prod_cod_alternativo" )
 column=(type=datetime updatewhereclause=yes name=inmprodu_prod_ultima_actualizacion dbname="inmprodu.prod_ultima_actualizacion" dbalias=".prod_ultima_actualizacion" )
 column=(type=char(120) updatewhereclause=yes name=inmprodu_prod_foto_dir dbname="inmprodu.prod_foto_dir" dbalias=".prod_foto_dir" )
