 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_can dbname="inmprodu.prod_ultima_entrada_can" dbalias=".prod_ultima_entrada_can" initial="0" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_cant_transito dbname="inmprodu.prod_cant_transito" dbalias=".prod_cant_transito" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_reserva_total dbname="inmprodu.prod_reserva_total" dbalias=".prod_reserva_total" initial="0" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_existencia_total dbname="inmprodu.prod_existencia_total" dbalias=".prod_existencia_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=prod_precio1 dbname="inmprodu.prod_precio1" dbalias=".prod_precio1" )
 column=(type=decimal(4) updatewhereclause=yes name=prod_precio2 dbname="inmprodu.prod_precio2" dbalias=".prod_precio2" )
 column=(type=decimal(4) updatewhereclause=yes name=prod_precio3 dbname="inmprodu.prod_precio3" dbalias=".prod_precio3" )
 column=(type=decimal(4) updatewhereclause=yes name=prod_precio4 dbname="inmprodu.prod_precio4" dbalias=".prod_precio4" )
 column=(type=decimal(4) updatewhereclause=yes name=prod_precio5 dbname="inmprodu.prod_precio5" dbalias=".prod_precio5" )
