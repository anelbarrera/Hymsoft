 column=(type=datetime updatewhereclause=yes name=prod_fecha_creacion dbname="inmprodu.prod_fecha_creacion" dbalias=".prod_fecha_creacion" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_owner dbname="inmprodu.prod_owner" dbalias=".prod_owner" values="00	00/01	01/10	10/11	11/" )
