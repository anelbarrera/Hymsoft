 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cradivis~" ) COMPUTE(NAME=~"li_check = 0~") COMPUTE(NAME=~"max( cradivis.adiv_nombre_div) adiv_nombre_div~") COMPUTE(NAME=~"max(cradivis.adiv_codigo_div) adiv_codigo_div~")WHERE(    EXP1 =~"( ( cradivis.adiv_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cradivis.adiv_empresa~"   OP =~"=~"    EXP2 =~":empresa ) )~" )  GROUP(NAME=~"cradivis.adiv_nombre_div~")) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="adiv_nombre_div A " )
