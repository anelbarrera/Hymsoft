 column=(type=decimal(8) updatewhereclause=yes name=prod_costo_promedio dbname="prod_costo_promedio" )
 column=(type=char(2) updatewhereclause=yes name=prod_medida dbname="inmprodu.prod_medida" dbalias=".prod_medida" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cradivis~" )  TABLE(NAME=~"cragrupo~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"inaparam~" )  TABLE(NAME=~"cramarca~" ) COLUMN(NAME=~"cradivis.adiv_codigo_div~") COLUMN(NAME=~"cradivis.adiv_nombre_div~") COLUMN(NAME=~"cragrupo.agru_codigo_grupo~") COLUMN(NAME=~"cragrupo.agru_descripcion_grupo~") COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_costo_cif~") COMPUTE(NAME=~"inmprodu.prod_existencia_total - (convert(numeric(11,0),(inmprodu.prod_existencia_total/inamedid.medi_cantidad)) * inamedid.medi_cantidad) fraccion~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COLUMN(NAME=~"inamedid.medi_tipo_medida~") COMPUTE(NAME=~"case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_existencia_total/inamedid.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_existencia_total/inamedid.medi_cantidad)) end entero~") COLUMN(NAME=~"inmprodu.prod_producto_dos~") COLUMN(NAME=~"inamedid.medi_abre~") COLUMN(NAME=~"inmprodu.prod_peso~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_cubicaje~") COLUMN(NAME=~"inmprodu.prod_existencia1~") COLUMN(NAME=~"inmprodu.prod_existencia2~") COLUMN(NAME=~"inmprodu.prod_existencia3~") COMPUTE(NAME=~"case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_reserva_total/inamedid.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_reserva_total/inamedid.medi_cantidad)) end reserva~") COMPUTE(NAME=~"case medi_tipo_medida when 10 then convert(numeric(11,0),((inmprodu.prod_existencia_total - prod_reserva_total) /inamedid.medi_cantidad)) else convert(numeric(11,3),((inmprodu.prod_existencia_total - prod_reserva_total) /inamedid.medi_cantidad)) end disponible~") COMPUTE(NAME=~"case medi_tipo_medida when 10 then convert(numeric(11,0),((inmprodu.prod_existencia1 ) /inamedid.medi_cantidad)) else convert(numeric(11,3),((inmprodu.prod_existencia1 ) /inamedid.medi_cantidad)) end exis1~") COMPUTE(NAME=~"case medi_tipo_medida when 10 then convert(numeric(11,0),((inmprodu.prod_existencia2 ) /inamedid.medi_cantidad)) else convert(numeric(11,3),((inmprodu.prod_existencia2 ) /inamedid.medi_cantidad)) end exis2~") COMPUTE(NAME=~"case medi_tipo_medida when 10 then convert(numeric(11,0),((inmprodu.prod_existencia3  ) /inamedid.medi_cantidad)) else convert(numeric(11,3),((inmprodu.prod_existencia3 ) /inamedid.medi_cantidad)) end exis3~") COLUMN(NAME=~"inmprodu.prod_entrada_fecha~") COMPUTE(NAME=~"datediff(month, prod_entrada_fecha, getdate()) mes~") COLUMN(NAME=~"inaparam.para_clave_costos~") COLUMN(NAME=~"inmprodu.prod_costo_fob~") COLUMN(NAME=~"inmprodu.prod_foto_dir~") COLUMN(NAME=~"cramarca.amar_nombre_marca~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COMPUTE(NAME=~"costo_promedio = '               '~") COMPUTE(NAME=~"costo_cif = '               '~") COMPUTE(NAME=~"costo_fob = '               '~") COMPUTE(NAME=~"valor_inv_promedio = '               '~") COMPUTE(NAME=~"valor_inv_cif_letras = '               '~") COMPUTE(NAME=~"valor_inv_fob_letras = '               '~") COMPUTE(NAME=~"total_valor_letras = '                  '~") COMPUTE(NAME=~"total_ultimo_letras = '                  '~") COMPUTE(NAME=~"total_fob_letras = '                  '~") COMPUTE(NAME=~"1 incluir~") COMPUTE(NAME=~"1 ver_existencia~") COMPUTE(NAME=~"case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_cant_confirma / inamedid.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_cant_confirma /inamedid.medi_cantidad)) end orden_compra~") COMPUTE(NAME=~"case when prod_costo_promedio = null or prod_costo_promedio = 0 then prod_costo_fob else prod_costo_promedio end prod_costo_promedio~") COLUMN(NAME=~"inmprodu.prod_medida~")    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cradivis.adiv_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cradivis.adiv_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_division~"    OP =~"=~"RIGHT=~"cradivis.adiv_codigo_div~"    OUTER1 =~"inmprodu.prod_division~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cragrupo.agru_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cragrupo.agru_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_grupo~"    OP =~"=~"RIGHT=~"cragrupo.agru_codigo_grupo~"    OUTER1 =~"inmprodu.prod_grupo~" )    JOIN (LEFT=~"inmprodu.prod_division~"    OP =~"=~"RIGHT=~"cragrupo.agru_codigo_div~"    OUTER1 =~"inmprodu.prod_division~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cramarca.amar_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cramarca.amar_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_marca~"    OP =~"=~"RIGHT=~"cramarca.amar_num_marca~"    OUTER1 =~"inmprodu.prod_marca~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"inaparam.para_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"inaparam.para_empresa~" )WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_status~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="cradivis_adiv_nombre_div A cragrupo_agru_descripcion_grupo A inmprodu_prod_descripcion A " )
