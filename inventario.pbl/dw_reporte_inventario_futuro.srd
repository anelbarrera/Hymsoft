 column=(type=char(15) updatewhereclause=yes name=valor_inv_cif_letras dbname="valor_inv_cif_letras" )
 column=(type=char(15) updatewhereclause=yes name=valor_inv_fob_letras dbname="valor_inv_fob_letras" )
