 column=(type=char(11) updatewhereclause=yes name=para_clave_costos dbname="inaparam.para_clave_costos" dbalias=".para_clave_costos" )
 column=(type=decimal(8) updatewhereclause=yes name=prod_costo_fob dbname="inmprodu.prod_costo_fob" dbalias=".prod_costo_fob" )
