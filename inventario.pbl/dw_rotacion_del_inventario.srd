table(column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" dbalias=".prod_empaque" initial="0" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_empaque_descripcion dbname="inmprodu.prod_empaque_descripcion" dbalias=".prod_empaque_descripcion" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_empaque_um dbname="inmprodu.prod_empaque_um" dbalias=".prod_empaque_um" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_can dbname="inmprodu.prod_ultima_entrada_can" dbalias=".prod_ultima_entrada_can" initial="0" )
 column=(type=datetime updatewhereclause=yes name=inmprodu_prod_entrada_fecha dbname="inmprodu.prod_entrada_fecha" dbalias=".prod_entrada_fecha" )
 column=(type=char(5) updatewhereclause=yes name=cramarca_amar_num_marca dbname="cramarca.amar_num_marca" dbalias=".amar_num_marca" )
 column=(type=char(25) updatewhereclause=yes name=cramarca_amar_nombre_marca dbname="cramarca.amar_nombre_marca" dbalias=".amar_nombre_marca" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_producto dbname="inmprodu.prod_producto" dbalias=".prod_producto" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_producto_dos dbname="inmprodu.prod_producto_dos" dbalias=".prod_producto_dos" )
 column=(type=char(65) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" dbalias=".prod_descripcion" initial="empty" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_existencia_total dbname="inmprodu.prod_existencia_total" dbalias=".prod_existencia_total" initial="0" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_reserva_total dbname="inmprodu.prod_reserva_total" dbalias=".prod_reserva_total" initial="0" )
 column=(type=decimal(8) updatewhereclause=yes name=inmprodu_prod_costo_unitario dbname="prod_costo_unitario" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_precio_mayor dbname="prod_precio_mayor" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_precio_venta_unidad dbname="inmprodu.prod_precio_venta_unidad" dbalias=".prod_precio_venta_unidad" initial="0.00" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_medida dbname="inmprodu.prod_medida" dbalias=".prod_medida" initial="empty" values="Medida de Longitud	1/Medida de Superficie	2/Medida de Volumen	3/Otras Medidas	4/Medidas de Peso	5/Medidas Electricas	6/Medidas de Presión	7/Factores de Conversión	8/Unidades	10/" )
 column=(type=char(1) updatewhereclause=yes name=c_compute1 dbname="c_compute1" )
 column=(type=char(1) updatewhereclause=yes name=c_compute2 dbname="c_compute2" )
 column=(type=char(1) updatewhereclause=yes name=c_compute3 dbname="c_compute3" )
 column=(type=char(1) updatewhereclause=yes name=c_compute4 dbname="c_compute4" )
 column=(type=char(1) updatewhereclause=yes name=c_compute5 dbname="c_compute5" )
 column=(type=char(1) updatewhereclause=yes name=c_descripcion1 dbname="c_descripcion1" )
 column=(type=char(1) updatewhereclause=yes name=c_descripcion2 dbname="c_descripcion2" )
 column=(type=char(1) updatewhereclause=yes name=c_descripcion3 dbname="c_descripcion3" )
 column=(type=char(1) updatewhereclause=yes name=c_descripcion4 dbname="c_descripcion4" )
 column=(type=char(1) updatewhereclause=yes name=c_descripcion5 dbname="c_descripcion5" )
 column=(type=ulong updatewhereclause=yes name=inmprodu_prod_definicion dbname="inmprodu.prod_definicion" dbalias=".prod_definicion" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" dbalias=".medi_cantidad" )
 column=(type=decimal(6) updatewhereclause=yes name=inhprome_prom_trim_i dbname="inhprome.prom_trim_i" dbalias=".prom_trim_i" )
 column=(type=decimal(6) updatewhereclause=yes name=inhprome_prom_trim_ii dbname="inhprome.prom_trim_ii" dbalias=".prom_trim_ii" )
 column=(type=decimal(6) updatewhereclause=yes name=inhprome_prom_trim_iii dbname="inhprome.prom_trim_iii" dbalias=".prom_trim_iii" )
 column=(type=decimal(6) updatewhereclause=yes name=inhprome_prom_trim_vi dbname="inhprome.prom_trim_vi" dbalias=".prom_trim_vi" )
 column=(type=char(10) updatewhereclause=yes name=inamedid_medi_abre dbname="inamedid.medi_abre" dbalias=".medi_abre" )
 column=(type=decimal(0) updatewhereclause=yes name=tran_entero dbname="tran_entero" )
 column=(type=char(3) updatewhereclause=yes name=prod_division dbname="inmprodu.prod_division" dbalias=".prod_division" )
 column=(type=char(5) updatewhereclause=yes name=prod_grupo dbname="inmprodu.prod_grupo" dbalias=".prod_grupo" )
 column=(type=char(5) updatewhereclause=yes name=prod_marca dbname="inmprodu.prod_marca" dbalias=".prod_marca" )
 column=(type=decimal(0) updatewhereclause=yes name=prod_tercero dbname="inmprodu.prod_tercero" dbalias=".prod_tercero" )
 column=(type=char(60) updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
 column=(type=char(50) updatewhereclause=yes name=cradivis_adiv_nombre_div dbname="cradivis.adiv_nombre_div" dbalias=".adiv_nombre_div" )
 column=(type=char(50) updatewhereclause=yes name=cragrupo_agru_descripcion_grupo dbname="cragrupo.agru_descripcion_grupo" dbalias=".agru_descripcion_grupo" )
 retrieve="  SELECT inmprodu.prod_empaque,   
         inmprodu.prod_empaque_descripcion,   
         inmprodu.prod_empaque_um,   
         inmprodu.prod_ultima_entrada_can,   
         inmprodu.prod_entrada_fecha,   
         cramarca.amar_num_marca,   
         cramarca.amar_nombre_marca,   
         inmprodu.prod_producto,   
         inmprodu.prod_producto_dos,   
         inmprodu.prod_descripcion,   
         inmprodu.prod_existencia_total,   
         inmprodu.prod_reserva_total,   
         prod_costo_unitario = prod_costo_cif,   
         prod_precio_mayor = inmprodu.prod_precio1,   
         inmprodu.prod_precio_venta_unidad,   
         inmprodu.prod_medida,   
         c_compute1 = ~"~",   
         c_compute2 = ~"~",   
         c_compute3 = ~"~",   
         c_compute4 = ~"~",   
         c_compute5 = ~"~",   
         c_descripcion1 = ~"~",   
         c_descripcion2 = ~"~",   
         c_descripcion3 = ~"~",   
         c_descripcion4 = ~"~",   
         c_descripcion5 = ~"~",   
         inmprodu.prod_definicion,   
         inamedid.medi_cantidad ,
         inhprome.prom_trim_i,   
         inhprome.prom_trim_ii,   
         inhprome.prom_trim_iii,   
         inhprome.prom_trim_vi,
			inamedid.medi_abre,			
			convert(numeric(10, 0), ( inmprodu.prod_cant_confirma / inamedid.medi_cantidad )) + convert(numeric(10, 0), (inmprodu.prod_cant_transito / inamedid.medi_cantidad)) tran_entero,
		inmprodu.prod_division,
		inmprodu.prod_grupo,
		inmprodu.prod_marca,
		inmprodu.prod_tercero,
		dgmterce.terc_descripcion,
		cradivis.adiv_nombre_div,
		cragrupo.agru_descripcion_grupo
    FROM inmprodu,   
         cramarca,   
         cradivis,  
         cragrupo,   
         inhprome,   
         inamedid,
		dgmterce 
   WHERE ( inmprodu.prod_g_financiero = inhprome.prom_g_financiero) and  
         ( inmprodu.prod_empresa = inhprome.prom_empresa) and  
         ( inmprodu.prod_producto = inhprome.prom_producto) and  
         ( cramarca.amar_g_financiero = inmprodu.prod_g_financiero) and  
         ( cramarca.amar_empresa = inmprodu.prod_empresa) and  
         ( cramarca.amar_num_marca = inmprodu.prod_marca) and  
         ( cradivis.adiv_g_financiero = inmprodu.prod_g_financiero) and  
         ( cradivis.adiv_empresa = inmprodu.prod_empresa) and  
         ( cradivis.adiv_codigo_div = inmprodu.prod_division) and  
         ( cragrupo.agru_g_financiero = inmprodu.prod_g_financiero) and  
         ( cragrupo.agru_empresa = inmprodu.prod_empresa) and  
         ( cragrupo.agru_codigo_div = inmprodu.prod_division) and  
         ( cragrupo.agru_codigo_grupo = inmprodu.prod_grupo) and  
		( inmprodu.prod_tercero = dgmterce.terc_tercero ) and
         ( inamedid.medi_medida = inmprodu.prod_medida )  and datepart(yy, prod_entrada_fecha) >= 2013"  sort="c_descripcion2 A c_descripcion3 A c_descripcion4 A c_descripcion5 A inmprodu_prod_descripcion A " )
