 column=(type=decimal(19) updatewhereclause=yes name=bultos dbname="bultos" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" dbalias=".prod_empaque" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"indtranfer~" )  TABLE(NAME=~"intranfer~" ) COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"intranfer.tmov_secuencia~") COLUMN(NAME=~"intranfer.tmov_fecha~") COLUMN(NAME=~"intranfer.tmov_documento~") COLUMN(NAME=~"intranfer.tmov_comentario~") COLUMN(NAME=~"intranfer.tmov_id~") COLUMN(NAME=~"indtranfer.dmov_producto~") COLUMN(NAME=~"indtranfer.dmov_bodega~") COLUMN(NAME=~"indtranfer.dmov_ubicacion~") COLUMN(NAME=~"indtranfer.dmov_bodega_destino~") COLUMN(NAME=~"indtranfer.dmov_ubicacion_destino~") COLUMN(NAME=~"indtranfer.dmov_modelo~") COLUMN(NAME=~"indtranfer.dmov_cantidad~") COLUMN(NAME=~"indtranfer.dmov_cant1~") COLUMN(NAME=~"indtranfer.dmov_unidad_medida~") COLUMN(NAME=~"indtranfer.dmov_linea~") COMPUTE(NAME=~"bultos = round(dmov_cantidad / prod_empaque,2)~") COLUMN(NAME=~"inmprodu.prod_empaque~")    JOIN (LEFT=~"intranfer.tmov_g_financiero~"    OP =~"=~"RIGHT=~"indtranfer.dmov_g_financiero~" )    JOIN (LEFT=~"intranfer.tmov_empresa~"    OP =~"=~"RIGHT=~"indtranfer.dmov_empresa~" )    JOIN (LEFT=~"intranfer.tmov_aplicacion~"    OP =~"=~"RIGHT=~"indtranfer.dmov_aplicacion~" )    JOIN (LEFT=~"intranfer.tmov_tipo_transaccion~"    OP =~"=~"RIGHT=~"indtranfer.dmov_tipo_transaccion~" )    JOIN (LEFT=~"intranfer.tmov_secuencia~"    OP =~"=~"RIGHT=~"indtranfer.dmov_secuencia~" )    JOIN (LEFT=~"intranfer.tmov_anual~"    OP =~"=~"RIGHT=~"indtranfer.dmov_anual~" )    JOIN (LEFT=~"intranfer.tmov_concepto~"    OP =~"=~"RIGHT=~"indtranfer.dmov_concepto~" )    JOIN (LEFT=~"indtranfer.dmov_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"indtranfer.dmov_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"indtranfer.dmov_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"intranfer.tmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intranfer.tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intranfer.tmov_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intranfer.tmov_fecha~"   OP =~"<~"    EXP2 =~"dateadd(dd,1, :fecha2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"intranfer.tmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = date)  ARG(NAME = ~"fecha2~" TYPE = date) " arguments=(("grupo", number),("empresa", number),("fecha1", date),("fecha2", date))  sort="intranfer_tmov_secuencia A dmov_linea A " )
