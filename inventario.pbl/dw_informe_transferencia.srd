table(column=(type=char(65) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" dbalias=".prod_descripcion" )
 column=(type=decimal(0) updatewhereclause=yes name=intranfer_tmov_secuencia dbname="intranfer.tmov_secuencia" dbalias=".tmov_secuencia" )
