 column=(type=char(5) updatewhereclause=yes name=prod_marca dbname="inmprodu.prod_marca" dbalias=".prod_marca" )
 column=(type=char(60) updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
 column=(type=char(20) updatewhereclause=yes name=prod_producto dbname="inmprodu.prod_producto" dbalias=".prod_producto" )
 column=(type=datetime updatewhereclause=yes name=inmprodu_prod_entrada_fecha dbname="inmprodu.prod_entrada_fecha" dbalias=".prod_entrada_fecha" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_doc dbname="inmprodu.prod_ultima_entrada_doc" dbalias=".prod_ultima_entrada_doc" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_ultima_salida_doc dbname="inmprodu.prod_ultima_salida_doc" dbalias=".prod_ultima_salida_doc" )
 column=(type=datetime updatewhereclause=yes name=prod_salida_fecha dbname="inmprodu.prod_salida_fecha" dbalias=".prod_salida_fecha" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_existencia_total dbname="inmprodu.prod_existencia_total" dbalias=".prod_existencia_total" )
 column=(type=decimal(0) updatewhereclause=yes name=entero dbname="entero" )
 column=(type=decimal(8) updatewhereclause=yes name=fraccion dbname="fraccion" )
 column=(type=decimal(0) updatewhereclause=yes name=prod_ultima_entrada_can dbname="prod_ultima_entrada_can" )
 column=(type=long updatewhereclause=yes name=imprimir dbname="imprimir" )
 column=(type=decimal(8) updatewhereclause=yes name=prod_costo_promedio dbname="inmprodu.prod_costo_promedio" dbalias=".prod_costo_promedio" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"cramarca~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"inmprodu.prod_producto_dos~") COLUMN(NAME=~"inmprodu.prod_costo_fob~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_descripcion_dos~") COLUMN(NAME=~"cramarca.amar_nombre_marca~") COLUMN(NAME=~"inmprodu.prod_foto_dir~") COLUMN(NAME=~"inmprodu.prod_marca~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_entrada_fecha~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_doc~") COLUMN(NAME=~"inmprodu.prod_ultima_salida_doc~") COLUMN(NAME=~"inmprodu.prod_salida_fecha~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COMPUTE(NAME=~"convert(numeric(10,0),(inmprodu.prod_existencia_total/inamedid.medi_cantidad)) entero~") COMPUTE(NAME=~"inmprodu.prod_existencia_total - (convert(numeric(10,0),(inmprodu.prod_existencia_total/inamedid.medi_cantidad)) * inamedid.medi_cantidad) fraccion~") COMPUTE(NAME=~"convert(numeric(10,0),(inmprodu.prod_ultima_entrada_can / inamedid.medi_cantidad)) prod_ultima_entrada_can~") COMPUTE(NAME=~"0 imprimir~") COLUMN(NAME=~"inmprodu.prod_costo_promedio~")    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cramarca.amar_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cramarca.amar_empresa~" )    JOIN (LEFT=~"inmprodu.prod_marca~"    OP =~"=~"RIGHT=~"cramarca.amar_num_marca~" )    JOIN (LEFT=~"inmprodu.prod_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_existencia_total~"   OP =~">=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="prod_salida_fecha D inmprodu_prod_descripcion A " )
