 column=(type=decimal(0) updatewhereclause=yes name=medi_tipo_medida dbname="inamedid.medi_tipo_medida" )
 column=(type=datetime updatewhereclause=yes name=tmov_fecha_registro dbname="intmovim.tmov_fecha_registro" )
 column=(type=char(1) updatewhereclause=yes name=tmov_tipo_movimiento dbname="intmovim.tmov_tipo_movimiento" )
 column=(type=decimal(8) updatewhereclause=yes name=dmov_costo_promedio dbname="indmovim.dmov_costo_promedio" )
 column=(type=char(3) updatewhereclause=yes name=dmov_concepto dbname="indmovim.dmov_concepto" )
 column=(type=datetime updatewhereclause=yes name=dmov_fecha_registro dbname="indmovim.dmov_fecha_registro" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_producto_dos dbname="inmprodu.prod_producto_dos" )
 column=(type=decimal(2) updatewhereclause=yes name=ganancia dbname="ganancia" )
 column=(type=decimal(15) updatewhereclause=yes name=porc_venta dbname="porc_venta" )
 column=(type=decimal(15) updatewhereclause=yes name=porc_costo dbname="porc_costo" )
 column=(type=decimal(2) updatewhereclause=yes name=costos dbname="costos" )
 column=(type=decimal(2) updatewhereclause=yes name=ventas dbname="ventas" )
 column=(type=long updatewhereclause=yes name=ver_en_letras dbname="ver_en_letras" )
 column=(type=char(15) updatewhereclause=yes name=valor_en_letras dbname="valor_en_letras" )
 column=(type=char(15) updatewhereclause=yes name=margen_en_letras dbname="margen_en_letras" )
 column=(type=long updatewhereclause=yes name=costo_en_letras dbname="costo_en_letras" )
 retrieve="SELECT indmovim.dmov_secuencia,   
		indmovim.dmov_documento,   
		indmovim.dmov_bodega,   
		indmovim.dmov_producto,   
		indmovim.dmov_cantidad,   
		indmovim.dmov_cant1,   
		indmovim.dmov_unidad_medida,   
		indmovim.dmov_costo,   
		indmovim.dmov_precio,   
		indmovim.dmov_costo_cif,   
		indmovim.dmov_ubicacion_destino,   
		indmovim.dmov_bodega_destino,   
		indmovim.dmov_tipo_transaccion,   
		intmovim.tmov_fecha,   
		inamedid_a.medi_descripcion,   
		inmprodu.prod_descripcion,   
		inmprodu.prod_costo_cif,   
		intmovim.tmov_tipo,   
		inamedid_a.medi_cantidad,   
		inmprodu.prod_medida,   
		dgmterce.terc_descripcion,   
		inamedid_b.medi_cantidad,   
		inamedid_b.medi_descripcion,   
		inmprodu.prod_empaque,   
		inmprodu.prod_empaque_descripcion,   
		inamedid_c.medi_descripcion,   
		intmovim.tmov_tipo_transaccion,   
		indmovim.dmov_ubicacion,   
		0 c2,   
		inmprodu.prod_medida medida,   
		dgmterce.terc_descripcion tercero,   
		(indmovim.dmov_cantidad*inamedid_a.medi_cantidad+isnull(indmovim.dmov_cant1,0)) cantidad_piezas,   
		inamedid_b.medi_cantidad medida_producto,
		inamedid_b.medi_descripcion medida_producto_descripcion,   
		inamedid_c.medi_descripcion medida_empaque,   
		inaparam.para_formato_decimal,   
		00.00 frac,  
		intmovim.tmov_nombre_tercero,
     	 inmprodu.prod_definicion,
		tmov_comentario,
      	inamedid_a.medi_abre medi_abre_a,
		tmov_no_pedido,
		dmov_aplicacion,
		prod_reserva_total,
		prod_foto_dir,
		indmovim.dmov_anual, 
		indmovim.dmov_aplicacion,
		intmovim.tmov_terceros,
		0 user_especial,
		indmovim.dmov_costo_fob,
		inamedid_a.medi_tipo_medida,
		intmovim.tmov_fecha_registro,
		intmovim.tmov_tipo_movimiento,
		indmovim.dmov_costo_promedio,
		indmovim.dmov_concepto,
		indmovim.dmov_fecha_registro,
		prod_producto_dos,
		ganancia = convert(numeric(10,2),case when dmov_tipo_transaccion = 'DV' then -1 else 1 end * case when dmov_aplicacion = 'FA' then (dmov_precio * dmov_cantidad) + ((dmov_precio / inamedid_a.medi_cantidad) * dmov_cant1 ) - (dmov_costo_promedio * dmov_cantidad) + ((dmov_costo_promedio / inamedid_a.medi_cantidad) * dmov_cant1 )  end),
		porc_venta = case when dmov_aplicacion = 'FA' then round(((convert(numeric(10,2),((dmov_precio * dmov_cantidad) + ((dmov_precio / inamedid_a.medi_cantidad) * dmov_cant1 ))) - convert(numeric(10,2),((dmov_costo_promedio * dmov_cantidad) + ((dmov_costo_promedio / inamedid_a.medi_cantidad) * dmov_cant1)))) / case when convert(numeric(10,2),((dmov_precio * dmov_cantidad) + ((dmov_precio / inamedid_a.medi_cantidad) * dmov_cant1 ))) = 0 then 1 else convert(numeric(10,2),((dmov_precio * dmov_cantidad) + ((dmov_precio / inamedid_a.medi_cantidad) * dmov_cant1 ))) end ) * 100,2) * case when dmov_tipo_transaccion = 'DV' then -1 else 1 end end ,
		porc_costo = case when dmov_aplicacion = 'FA' then round(((convert(numeric(10,2),((dmov_precio * dmov_cantidad) + ((dmov_precio / inamedid_a.medi_cantidad) * dmov_cant1 ))) - convert(numeric(10,2),((dmov_costo_promedio * dmov_cantidad) + ((dmov_costo_promedio / inamedid_a.medi_cantidad) * dmov_cant1)))) / case when convert(numeric(10,2),((dmov_costo_promedio * dmov_cantidad) + ((dmov_costo_promedio / inamedid_a.medi_cantidad) * dmov_cant1 ))) = 0 then 1 else convert(numeric(10,2),((dmov_costo_promedio * dmov_cantidad) + ((dmov_costo_promedio / inamedid_a.medi_cantidad) * dmov_cant1 ))) end ) * 100,2) * case when dmov_tipo_transaccion = 'DV' then -1 else 1 end end ,
		costos =  case when dmov_aplicacion = 'FA' then convert(numeric(10,2),((dmov_costo_promedio * dmov_cantidad) + ((dmov_costo_promedio / inamedid_a.medi_cantidad) * dmov_cant1))) * case when dmov_tipo_transaccion = 'DV' then -1 else 1 end end ,
		ventas =  case when dmov_aplicacion = 'FA' then convert(numeric(10,2),((dmov_precio * dmov_cantidad) + ((dmov_precio / inamedid_a.medi_cantidad) * dmov_cant1))) * case when dmov_tipo_transaccion = 'DV' then -1 else 1 end end,
		ver_en_letras = 0,
		valor_en_letras = '               ',
		margen_en_letras = '               ',
		costo_en_letras = 0
 FROM indmovim,   
		intmovim LEFT JOIN dgmterce ON (  intmovim.tmov_terceros = dgmterce.terc_tercero ) ,   
		inamedid inamedid_a,   
		inmprodu,     
		inamedid inamedid_b,   
		inamedid inamedid_c,   
		inaparam  
WHERE ( indmovim.dmov_g_financiero = intmovim.tmov_g_financiero ) and  
		( intmovim.tmov_empresa = indmovim.dmov_empresa ) and  
		( indmovim.dmov_aplicacion = intmovim.tmov_aplicacion ) and  
		( intmovim.tmov_tipo_transaccion = indmovim.dmov_tipo_transaccion ) and  
      ( intmovim.tmov_concepto  = indmovim.dmov_concepto  ) and  
		( indmovim.dmov_secuencia = intmovim.tmov_secuencia ) and  
		( indmovim.dmov_anual = intmovim.tmov_anual ) and  
		( inamedid_a.medi_medida = indmovim.dmov_unidad_medida ) and  
		( indmovim.dmov_g_financiero = inmprodu.prod_g_financiero ) and  
		( inmprodu.prod_empresa = indmovim.dmov_empresa ) and  
		( indmovim.dmov_producto = inmprodu.prod_producto ) and  
		( inmprodu.prod_medida = inamedid_b.medi_medida ) and  
		( inmprodu.prod_medida = inamedid_c.medi_medida ) and  
		( inaparam.para_g_financiero = indmovim.dmov_g_financiero ) and  
		( inaparam.para_empresa = indmovim.dmov_empresa ) and  
		( ( indmovim.dmov_g_financiero = :grupo ) AND  
		( indmovim.dmov_empresa = :empresa ) AND  
		( indmovim.dmov_producto = :producto_k ) AND  
		( intmovim.tmov_fecha >= :fecha_ini ) AND  
		( intmovim.tmov_fecha <= :fecha_fin ) )   
ORDER BY indmovim.dmov_producto ASC,   
		intmovim.tmov_fecha ASC" arguments=(("grupo", number),("empresa", number),("producto_k", string),("fecha_ini", datetime),("fecha_fin", datetime))  sort="intmovim_tmov_fecha A tmov_fecha_registro A dmov_fecha_registro A " )
