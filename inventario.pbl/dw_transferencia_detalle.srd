 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"indtranfer~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"indtranfer.dmov_g_financiero~") COLUMN(NAME=~"indtranfer.dmov_empresa~") COLUMN(NAME=~"indtranfer.dmov_aplicacion~") COLUMN(NAME=~"indtranfer.dmov_tipo_transaccion~") COLUMN(NAME=~"indtranfer.dmov_concepto~") COLUMN(NAME=~"indtranfer.dmov_secuencia~") COLUMN(NAME=~"indtranfer.dmov_anual~") COLUMN(NAME=~"indtranfer.dmov_linea~") COLUMN(NAME=~"indtranfer.dmov_documento~") COLUMN(NAME=~"indtranfer.dmov_bodega~") COLUMN(NAME=~"indtranfer.dmov_ubicacion~") COLUMN(NAME=~"indtranfer.dmov_producto~") COLUMN(NAME=~"indtranfer.dmov_cantidad~") COLUMN(NAME=~"indtranfer.dmov_cant1~") COLUMN(NAME=~"indtranfer.dmov_unidad_medida~") COLUMN(NAME=~"indtranfer.dmov_cubicaje~") COLUMN(NAME=~"indtranfer.dmov_peso~") COLUMN(NAME=~"indtranfer.dmov_bulto~") COLUMN(NAME=~"indtranfer.dmov_id~") COLUMN(NAME=~"indtranfer.dmov_costo_fob~") COLUMN(NAME=~"indtranfer.dmov_costo~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COLUMN(NAME=~"inamedid.medi_tipo_medida~") COLUMN(NAME=~"indtranfer.dmov_producto_destino~") COLUMN(NAME=~"inamedid.medi_descripcion~") COLUMN(NAME=~"indtranfer.dmov_modelo~") COLUMN(NAME=~"indtranfer.dmov_bodega_destino~") COLUMN(NAME=~"indtranfer.dmov_ubicacion_destino~")    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"indtranfer.dmov_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"indtranfer.dmov_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"indtranfer.dmov_producto~" )WHERE(    EXP1 =~"indtranfer.dmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"indtranfer.dmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"indtranfer.dmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"indtranfer.dmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'TR'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indtranfer.dmov_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indtranfer.dmov_anual~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " update="indtranfer" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number))  sort="dmov_linea A " )
