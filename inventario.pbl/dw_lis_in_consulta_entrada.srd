table(column=(type=decimal(0) updatewhereclause=yes name=intmovim_tmov_secuencia dbname="intmovim.tmov_secuencia" )
 column=(type=char(20) updatewhereclause=yes name=indmovim_dmov_producto dbname="indmovim.dmov_producto" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" )
 column=(type=decimal(6) updatewhereclause=yes name=indmovim_dmov_cantidad dbname="indmovim.dmov_cantidad" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_existencia_total dbname="inmprodu.prod_existencia_total" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_reserva_total dbname="inmprodu.prod_reserva_total" )
 column=(type=decimal(0) updatewhereclause=yes name=intmovim_tmov_g_financiero dbname="intmovim.tmov_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=intmovim_tmov_empresa dbname="intmovim.tmov_empresa" )
 column=(type=decimal(0) updatewhereclause=yes name=indmovim_dmov_cant1 dbname="dmov_cant1" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medi_descripcion dbname="inamedid.medi_descripcion" )
 column=(type=char(10) updatewhereclause=yes name=inamedid_medi_abre dbname="inamedid.medi_abre" )
 column=(type=char(10) updatewhereclause=yes name=inamedid_medi_abre dbname="inamedid.medi_abre" )
 column=(type=decimal(6) updatewhereclause=yes name=indmovim_dmov_costo_fob dbname="indmovim.dmov_costo_fob" )
 column=(type=decimal(0) updatewhereclause=yes name=entero dbname="entero" )
 column=(type=decimal(0) updatewhereclause=yes name=fraccion dbname="fraccion" )
 column=(type=decimal(0) updatewhereclause=yes name=rentero dbname="rentero" )
 column=(type=decimal(0) updatewhereclause=yes name=rfraccion dbname="rfraccion" )
 column=(type=decimal(0) updatewhereclause=yes name=dentero dbname="dentero" )
 column=(type=decimal(0) updatewhereclause=yes name=dfraccion dbname="dfraccion" )
 column=(type=datetime updatewhereclause=yes name=intmovim_tmov_fecha dbname="intmovim.tmov_fecha" )
 column=(type=decimal(0) updatewhereclause=yes name=intmovim_tmov_anual dbname="intmovim.tmov_anual" )
 column=(type=char(18) updatewhereclause=yes name=intmovim_tmov_documento dbname="intmovim.tmov_documento" )
 column=(type=char(1) updatewhereclause=yes name=intmovim_tmov_tipo dbname="intmovim.tmov_tipo" )
 retrieve="  SELECT intmovim.tmov_secuencia,   
         indmovim.dmov_producto,   
         inmprodu.prod_descripcion,   
         indmovim.dmov_cantidad,   
         inmprodu.prod_existencia_total,   
         inmprodu.prod_reserva_total,   
         intmovim.tmov_g_financiero,   
         intmovim.tmov_empresa,   
         indmovim.dmov_cant1,   
         inamedid_a.medi_cantidad,   
         inamedid_a.medi_descripcion,   
         inamedid_a.medi_abre,   
         inamedid_b.medi_abre,   
         indmovim.dmov_costo_fob,   
         convert(numeric(15,0),(inmprodu.prod_existencia_total/inamedid_b.medi_cantidad)) entero,   
         convert(numeric(4,0),inmprodu.prod_existencia_total - (convert(numeric(15,0),(inmprodu.prod_existencia_total/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) ) fraccion,   
         convert(numeric(15,0),(inmprodu.prod_reserva_total/inamedid_b.medi_cantidad)) rentero,   
         convert(numeric(4,0), inmprodu.prod_reserva_total - (convert(numeric(15,0),(inmprodu.prod_reserva_total/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) ) rfraccion,   
         convert(numeric(15,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) /inamedid_b.medi_cantidad)) dentero,   
         convert(numeric(4,0), (inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) - (convert(numeric(15,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) /inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) ) dfraccion,   
         intmovim.tmov_fecha,   
         intmovim.tmov_anual,   
         intmovim.tmov_documento,   
         intmovim.tmov_tipo  
    FROM indmovim,   
         intmovim,   
         inmprodu,   
         inamedid inamedid_a,   
         inamedid inamedid_b  
   WHERE ( intmovim.tmov_g_financiero = indmovim.dmov_g_financiero ) and  
         ( intmovim.tmov_empresa = indmovim.dmov_empresa ) and  
         ( intmovim.tmov_aplicacion = indmovim.dmov_aplicacion ) and  
         ( intmovim.tmov_tipo_transaccion = indmovim.dmov_tipo_transaccion ) and  
         ( intmovim.tmov_secuencia = indmovim.dmov_secuencia ) and  
         ( intmovim.tmov_anual = indmovim.dmov_anual ) and  
         ( intmovim.tmov_concepto = indmovim.dmov_concepto ) and  
         ( inmprodu.prod_g_financiero = indmovim.dmov_g_financiero ) and  
         ( inmprodu.prod_empresa = indmovim.dmov_empresa ) and  
         ( inmprodu.prod_producto = indmovim.dmov_producto ) and  
         ( inamedid_a.medi_medida = indmovim.dmov_unidad_medida ) and  
         ( inmprodu.prod_medida = inamedid_b.medi_medida ) and  
         ( ( intmovim.tmov_tipo_transaccion = 'EN' ) )    
"  sort="intmovim_tmov_secuencia A indmovim_dmov_producto A " )
