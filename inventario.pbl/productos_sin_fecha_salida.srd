 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_g_financiero~") COLUMN(NAME=~"inmprodu.prod_empresa~") COLUMN(NAME=~"inmprodu.prod_entrada_fecha~") COMPUTE(NAME=~"actual = prod_entrada_fecha~") COLUMN(NAME=~"inmprodu.prod_salida_fecha~")WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~"1~" ) ) " update="inmprodu" updatewhere=0 updatekeyinplace=yes )
