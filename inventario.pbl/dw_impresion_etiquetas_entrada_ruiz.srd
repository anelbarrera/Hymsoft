 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"indmovim~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"intmovim~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"indmovim.dmov_producto~") COMPUTE(NAME=~"costo = '               '~") COMPUTE(NAME=~"dmov_secuencia dmov_secuencia~") COMPUTE(NAME=~"dmov_documento dmov_documento~") COMPUTE(NAME=~"dmov_unidad_medida dmov_unidad_medida~") COMPUTE(NAME=~"dmov_costo_cif dmov_costo_cif~") COMPUTE(NAME=~"dmov_costo_fob dmov_costo_fob~") COMPUTE(NAME=~"prod_costo_cif prod_costo_cif~") COMPUTE(NAME=~"prod_costo_cif prod_costo_fob~") COMPUTE(NAME=~"prod_producto_dos prod_producto_dos~") COMPUTE(NAME=~"prod_descripcion prod_descripcion~") COMPUTE(NAME=~"prod_empaque prod_empaque~") COMPUTE(NAME=~"prod_peso prod_peso~") COMPUTE(NAME=~"prod_precio1 prod_precio1~") COMPUTE(NAME=~"prod_costo_promedio prod_costo_promedio~") COMPUTE(NAME=~"medi_abre medi_abre~") COMPUTE(NAME=~"precio = '               '~") COMPUTE(NAME=~"prod_barra prod_barra~") COLUMN(NAME=~"indmovim.dmov_linea~")    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"indmovim.dmov_producto~" )    JOIN (LEFT=~"intmovim.tmov_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"intmovim.tmov_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"intmovim.tmov_aplicacion~"    OP =~"=~"RIGHT=~"indmovim.dmov_aplicacion~" )    JOIN (LEFT=~"intmovim.tmov_tipo_transaccion~"    OP =~"=~"RIGHT=~"indmovim.dmov_tipo_transaccion~" )    JOIN (LEFT=~"intmovim.tmov_secuencia~"    OP =~"=~"RIGHT=~"indmovim.dmov_secuencia~" )    JOIN (LEFT=~"intmovim.tmov_anual~"    OP =~"=~"RIGHT=~"indmovim.dmov_anual~" )    JOIN (LEFT=~"intmovim.tmov_concepto~"    OP =~"=~"RIGHT=~"indmovim.dmov_concepto~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )WHERE(    EXP1 =~"intmovim.tmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_anual~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_concepto~"   OP =~"=~"    EXP2 =~":tipo~" ) ) ORDER(NAME=~"indmovim.dmov_linea~" ASC=yes ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"tipo~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number),("tipo", string))  sort="indmovim_dmov_linea A " )
