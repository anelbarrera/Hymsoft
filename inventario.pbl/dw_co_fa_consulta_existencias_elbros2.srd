ecio_mayor~") COLUMN(NAME=~"inmprodu.prod_precio_menor~") COLUMN(NAME=~"inmprodu.prod_precio_afiliadas~") COLUMN(NAME=~"inmprodu.prod_precio_otros~") COLUMN(NAME=~"inmprodu.prod_precio_especial~") COLUMN(NAME=~"inamedid_b.medi_descripcion~") COLUMN(NAME=~"inamedid_a.medi_abre~") COLUMN(NAME=~"inmprodu.prod_reserva_trans~") COLUMN(NAME=~"inamedid_c.medi_abre~") COMPUTE(NAME=~"convert(numeric(15,0),(inmprodu.prod_reserva_total/inamedid_b.medi_cantidad))  rentero~") COMPUTE(NAME=~"convert(numeric(15,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) /inamedid_b.medi_cantidad))  dentero~") COMPUTE(NAME=~"convert(numeric(15,0),(inmprodu.prod_cant_transito  /inamedid_b.medi_cantidad))  tran_entero~") COMPUTE(NAME=~"convert(numeric(15,0),(inmprodu.prod_reserva_trans/inamedid_b.medi_cantidad))  tran_rentero~") COMPUTE(NAME=~"convert(numeric(15,0),((inmprodu.prod_cant_transito - inmprodu.prod_reserva_trans) /inamedid_b.medi_cantidad))  tran_dentero~") COMPUTE(NAME=~"convert(numeric(15,0), ( inmprodu.prod_existencia_total / inamedid_b.medi_cantidad ) )  entero~") COMPUTE(NAME=~"convert(numeric(4,0), inmprodu.prod_reserva_total - (convert(numeric(15,0),(inmprodu.prod_reserva_total/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) )  rfraccion~") COMPUTE(NAME=~"convert(numeric(4,0), (inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) - (convert(numeric(15,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) /inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) )  dfraccion~") COMPUTE(NAME=~"convert(numeric(4,0), inmprodu.prod_cant_transito - (convert(numeric(15,0),(inmprodu.prod_cant_transito/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) )  tran_fraccion~") COMPUTE(NAME=~"convert( numeric(4,0), inmprodu.prod_reserva_trans - (convert(numeric(15,0),(inmprodu.prod_reserva_trans/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) )  tran_rfraccion~") COMPUTE(NAME=~"convert(numeric(4,0), (inmprodu.prod_cant_transito - inmprodu.prod_reserva_trans) - (convert(numeric(15,0),((inmprodu.prod_cant_transito - inmprodu.prod_reserva_trans) /inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) )  tran_dfraccion~") COMPUTE(NAME=~"convert(numeric(15,0), ( inmbodeg.mbod_cantidad / inamedid_b.medi_cantidad ) )  bentero~") COMPUTE(NAME=~"convert(numeric(4,0), inmbodeg.mbod_cantidad - (convert(numeric(15,0),(inmbodeg.mbod_cantidad/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) )  bfraccion~") COMPUTE(NAME=~"convert(numeric(4,0), inmbodeg.mbod_reserva - (convert(numeric(15,0),(inmbodeg.mbod_reserva/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) )  brfraccion~") COMPUTE(NAME=~"convert(numeric(4,0), (inmbodeg.mbod_cantidad - inmbodeg.mbod_reserva) - (convert(numeric(15,0),((inmbodeg.mbod_cantidad - inmbodeg.mbod_reserva) /inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) )  bdfraccion~") COLUMN(NAME=~"cragrupo.agru_descripcion_grupo~") COLUMN(NAME=~"inmprodu.prod_observacion~") COMPUTE(NAME=~"convert(numeric(4,0), inmprodu.prod_existencia_total - (convert(numeric(15,0),(inmprodu.prod_existencia_total/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) ) fraccion~") COMPUTE(NAME=~"convert(numeric(15,0),(inmbodeg.mbod_reserva/inamedid_b.medi_cantidad)) brentero~") COMPUTE(NAME=~"convert(numeric(15,0),((inmbodeg.mbod_cantidad - inmbodeg.mbod_reserva) /inamedid_b.medi_cantidad))  bdentero~") COLUMN(NAME=~"inmprodu.prod_costo_cif~") COLUMN(NAME=~"cramarca.amar_nombre_marca~") COLUMN(NAME=~"inaaranc.aran_descripcion~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_sec~")    JOIN (LEFT=~"inmbodeg.mbod_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~"    OUTER2 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmbodeg.mbod_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~"    OUTER2 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmbodeg.mbod_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~"    OUTER2 =~"inmprodu.prod_producto~" )    JOIN (LEFT=~"cramarca.amar_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~"    OUTER2 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cramarca.amar_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~"    OUTER2 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cramarca.amar_num_marca~"    OP =~"=~"RIGHT=~"inmprodu.prod_marca~"    OUTER2 =~"inmprodu.prod_marca~" )    JOIN (LEFT=~"inaaranc.aran_arancel~"    OP =~"=~"RIGHT=~"inmprodu.prod_arancel~"    OUTER2 =~"inmprodu.prod_arancel~" )    JOIN (LEFT=~"inamedid_a.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_peso_unidad_medida~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid_b.medi_medida~" )    JOIN (LEFT=~"inmprodu.prod_empaque_um~"    OP =~"=~"RIGHT=~"inamedid_c.medi_medida~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cragrupo.agru_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cragrupo.agru_empresa~" )    JOIN (LEFT=~"inmprodu.prod_division~"    OP =~"=~"RIGHT=~"cragrupo.agru_codigo_div~" )    JOIN (LEFT=~"inmprodu.prod_grupo~"    OP =~"=~"RIGHT=~"cragrupo.agru_codigo_grupo~" )WHERE(    EXP1 =~"( inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( inmprodu.prod_producto~"   OP =~"=~"    EXP2 =~":producto )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_status~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmbodeg.mbod_bodega+inmbodeg.mbod_ubicacion~"   OP =~"<>~"    EXP2 =~":bod_ubica~" ) ) ORDER(NAME=~"inmprodu.prod_producto~" ASC=yes ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"producto~" TYPE = string)  ARG(NAME = ~"bod_ubica~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("producto", string),("bod_ubica", string))  sort="inmbodeg_mbod_bodega A inmbodeg_mbod_ubicacion A " )
