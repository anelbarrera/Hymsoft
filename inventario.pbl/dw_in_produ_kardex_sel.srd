table(column=(type=char(20) updatewhereclause=yes name=prod_producto dbname="inmprodu.prod_producto" initial="empty" )
 column=(type=char(65) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" initial="empty" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" initial="0" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_empaque_descripcion dbname="inmprodu.prod_empaque_descripcion" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medi_descripcion dbname="inamedid.medi_descripcion" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" )
 column=(type=char(15) updatewhereclause=yes name=inmprodu_prod_barra dbname="inmprodu.prod_barra" )
 column=(type=char(10) updatewhereclause=yes name=medi_abre dbname="inamedid.medi_abre" )
 column=(type=ulong updatewhereclause=yes name=prod_definicion dbname="inmprodu.prod_definicion" )
 column=(type=decimal(8) updatewhereclause=yes name=prod_costo_cif dbname="inmprodu.prod_costo_cif" )
 column=(type=char(120) updatewhereclause=yes name=inmprodu_prod_foto_dir dbname="inmprodu.prod_foto_dir" )
 column=(type=char(2) updatewhereclause=yes name=medi_medida dbname="inamedid.medi_medida" )
 column=(type=long updatewhereclause=yes name=user_especial dbname="user_especial" )
 column=(type=char(255) updatewhereclause=yes name=prod_observacion dbname="inmprodu.prod_observacion" )
 column=(type=char(20) updatewhereclause=yes name=secundario1 dbname="secundario1" )
 column=(type=char(20) updatewhereclause=yes name=secundario2 dbname="secundario2" )
 column=(type=char(20) updatewhereclause=yes name=secundario3 dbname="secundario3" )
 column=(type=char(20) updatewhereclause=yes name=secundario4 dbname="secundario4" )
 column=(type=char(20) updatewhereclause=yes name=prod_producto_dos dbname="inmprodu.prod_producto_dos" )
 column=(type=char(30) updatewhereclause=yes name=cracltam_acta_descripcion dbname="cracltam.acta_descripcion" )
 column=(type=char(20) updatewhereclause=yes name=taman1 dbname="taman1" )
 column=(type=char(20) updatewhereclause=yes name=taman2 dbname="taman2" )
 column=(type=char(20) updatewhereclause=yes name=taman3 dbname="taman3" )
 column=(type=char(20) updatewhereclause=yes name=taman4 dbname="taman4" )
 column=(type=decimal(0) updatewhereclause=yes name=medi_tipo_medida dbname="inamedid.medi_tipo_medida" )
 column=(type=decimal(4) updatewhereclause=yes name=prod_cubicaje dbname="inmprodu.prod_cubicaje" )
 column=(type=decimal(8) updatewhereclause=yes name=prod_costo_promedio dbname="inmprodu.prod_costo_promedio" )
 column=(type=char(23) updatewhereclause=yes name=costo dbname="costo" )
 column=(type=char(20) updatewhereclause=yes name=prod_contrato dbname="inmprodu.prod_contrato" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"cracltam~" ) COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_descripcion~") COLUMN(NAME=~"inamedid.medi_descripcion~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"inmprodu.prod_barra~") COLUMN(NAME=~"inamedid.medi_abre~") COLUMN(NAME=~"inmprodu.prod_definicion~") COLUMN(NAME=~"inmprodu.prod_costo_cif~") COLUMN(NAME=~"inmprodu.prod_foto_dir~") COLUMN(NAME=~"inamedid.medi_medida~") COMPUTE(NAME=~"0 user_especial~") COLUMN(NAME=~"inmprodu.prod_observacion~") COMPUTE(NAME=~"'                    ' secundario1~") COMPUTE(NAME=~"'                    ' secundario2~") COMPUTE(NAME=~"'                    ' secundario3~") COMPUTE(NAME=~"'                    ' secundario4~") COLUMN(NAME=~"inmprodu.prod_producto_dos~") COLUMN(NAME=~"cracltam.acta_descripcion~") COMPUTE(NAME=~"'                    ' taman1~") COMPUTE(NAME=~"'                    ' taman2~") COMPUTE(NAME=~"'                    ' taman3~") COMPUTE(NAME=~"'                    ' taman4~") COLUMN(NAME=~"inamedid.medi_tipo_medida~") COLUMN(NAME=~"inmprodu.prod_cubicaje~") COLUMN(NAME=~"inmprodu.prod_costo_promedio~") COMPUTE(NAME=~"costo = '                       '~") COLUMN(NAME=~"inmprodu.prod_contrato~")    JOIN (LEFT=~"cracltam.acta_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~"    OUTER2 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cracltam.acta_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~"    OUTER2 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cracltam.acta_cod_clase_tam~"    OP =~"=~"RIGHT=~"inmprodu.prod_cod_clase_tam~"    OUTER2 =~"inmprodu.prod_cod_clase_tam~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_producto~"   OP =~"=~"    EXP2 =~":producto~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"producto~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("producto", string)) )
