 column=(type=decimal(4) updatewhereclause=yes name=indmovim_dmov_precio_ent dbname="indmovim.dmov_precio_ent" dbalias="d.dmov_precio_ent" )
 column=(type=char(3) updatewhereclause=yes name=indmovim_dmov_id dbname="indmovim.dmov_id" dbalias="d.dmov_id" )
 column=(type=char(5) updatewhereclause=yes name=indmovim_dmov_bodega_destino dbname="indmovim.dmov_bodega_destino" dbalias="d.dmov_bodega_destino" )
 column=(type=char(5) updatewhereclause=yes name=indmovim_dmov_ubicacion_destino dbname="indmovim.dmov_ubicacion_destino" dbalias="d.dmov_ubicacion_destino" )
 column=(type=decimal(0) updatewhereclause=yes name=indmovim_dmov_anual dbname="indmovim.dmov_anual" dbalias="d.dmov_anual" )
 column=(type=char(20) updatewhereclause=yes name=indmovim_dmov_fabricante dbname="indmovim.dmov_fabricante" dbalias="d.dmov_fabricante" )
 column=(type=decimal(6) updatewhereclause=yes name=dmov_costo_fob dbname="indmovim.dmov_costo_fob" dbalias="d.dmov_costo_fob" )
 column=(type=decimal(2) updatewhereclause=yes name=dmov_monto_final dbname="indmovim.dmov_monto_final" dbalias="d.dmov_monto_final" )
 column=(type=decimal(8) updatewhereclause=yes name=dmov_costo_promedio dbname="indmovim.dmov_costo_promedio" dbalias="d.dmov_costo_promedio" )
 column=(type=char(20) updatewhereclause=yes name=indmovim_dmov_modelo dbname="indmovim.dmov_modelo" dbalias="d.dmov_modelo" )
 column=(type=char(250) updatewhereclause=yes name=indmovim_dmov_comentarios dbname="indmovim.dmov_comentarios" dbalias="d.dmov_comentarios" )
 column=(type=datetime updatewhereclause=yes name=intmovim_tmov_fecha dbname="intmovim.tmov_fecha" dbalias="t.tmov_fecha" initial="set to gf_fecha_serv" )
 column=(type=long updatewhereclause=yes name=intmovim_tmov_tipo_costo dbname="intmovim.tmov_tipo_costo" dbalias="t.tmov_tipo_costo" initial="0" values="Costo F.O.B.	0/Costo C.I.F.	1/Costo C.Z.L.	2/Costo C.&.F.	3/" )
 column=(type=decimal(4) updatewhereclause=yes name=intmovim_tmov_total_cargos dbname="intmovim.tmov_total_cargos" dbalias="t.tmov_total_cargos" initial="0" )
 column=(type=decimal(0) updatewhereclause=yes name=intmovim_tmov_terceros dbname="intmovim.tmov_terceros" dbalias="t.tmov_terceros" )
 column=(type=char(200) updatewhereclause=yes name=intmovim_tmov_comentario dbname="intmovim.tmov_comentario" dbalias="t.tmov_comentario" )
 column=(type=char(100) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" dbalias="p.prod_descripcion" initial="empty" )
 column=(type=decimal(2) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" dbalias="p.prod_empaque" initial="0" )
 column=(type=long updatewhereclause=yes name=inmprodu_prod_definicion dbname="inmprodu.prod_definicion" dbalias="p.prod_definicion" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_medida dbname="inmprodu.prod_medida" dbalias="p.prod_medida" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medi_descripcion dbname="inamedid.medi_descripcion" dbalias="m.medi_descripcion" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" dbalias="m.medi_cantidad" )
 column=(type=decimal(0) updatewhereclause=yes name=medi_tipo_medida dbname="inamedid.medi_tipo_medida" dbalias="m.medi_tipo_medida" )
 column=(type=char(250) updatewhereclause=yes name=dgmsubse_subs_descripcion dbname="dgmsubse.subs_descripcion" dbalias="s.subs_descripcion" )
 retrieve="SELECT     
    d.dmov_linea,
    d.dmov_g_financiero,
    d.dmov_empresa,
    d.dmov_aplicacion,
    d.dmov_tipo_transaccion,
    d.dmov_secuencia,
    d.dmov_documento,
    d.dmov_bodega,
    d.dmov_ubicacion,
    d.dmov_producto,
    d.dmov_cantidad,
    d.dmov_cant1,
    d.dmov_unidad_medida,
    d.dmov_costo,
    d.dmov_precio,
    d.dmov_cubicaje,
    d.dmov_peso,
    d.dmov_bulto,
    d.dmov_costo_cif,
    d.dmov_cargos,
    d.dmov_precio_ent,
    d.dmov_id,
    d.dmov_bodega_destino,
    d.dmov_ubicacion_destino,
    d.dmov_anual,
    d.dmov_fabricante,
    d.dmov_costo_fob,
    d.dmov_monto_final,
    d.dmov_costo_promedio,
    d.dmov_modelo,
    d.dmov_comentarios,    
    t.tmov_fecha,
    t.tmov_tipo_costo,
    t.tmov_total_cargos,
    t.tmov_terceros,
    t.tmov_comentario,    
    p.prod_descripcion,
    p.prod_empaque,
    p.prod_definicion,
    p.prod_medida,    
    m.medi_descripcion,
    m.medi_cantidad,
    m.medi_tipo_medida,    
    s.subs_descripcion
FROM intmovim t
INNER JOIN indmovim d 
    ON  d.dmov_g_financiero      = t.tmov_g_financiero
    AND d.dmov_empresa           = t.tmov_empresa
    AND d.dmov_tipo_transaccion  = t.tmov_tipo_transaccion
    AND d.dmov_secuencia         = t.tmov_secuencia
    AND d.dmov_concepto          = t.tmov_concepto
    AND d.dmov_anual             = t.tmov_anual
INNER JOIN inmprodu p 
    ON  p.prod_g_financiero      = d.dmov_g_financiero
    AND p.prod_empresa           = d.dmov_empresa
    AND p.prod_producto          = d.dmov_producto
INNER JOIN inamedid m 
    ON  m.medi_medida            = d.dmov_unidad_medida
INNER JOIN dgmsubse s 
    ON  s.subs_g_financiero      = t.tmov_g_financiero
    AND s.subs_empresa           = t.tmov_empresa
    AND s.subs_transaccion       = t.tmov_tipo_transaccion
    AND s.subs_sub_trans         = t.tmov_concepto
WHERE t.tmov_g_financiero       = :grupo
  AND t.tmov_empresa            =  :empresa 
  AND t.tmov_aplicacion         = 'IN'
  AND t.tmov_tipo_transaccion   = 'AE'
  AND t.tmov_secuencia          = :secuencia 
  AND t.tmov_anual              = :ann;


 
 
        
" arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number)) )
