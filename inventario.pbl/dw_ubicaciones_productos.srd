 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inaubica~" ) COLUMN(NAME=~"inaubica.ubic_g_financiero~") COLUMN(NAME=~"inaubica.ubic_empresa~") COLUMN(NAME=~"inaubica.ubic_bodega~") COLUMN(NAME=~"inaubica.ubic_ubicacion~") COLUMN(NAME=~"inaubica.ubic_descripcion~")WHERE(    EXP1 =~"inaubica.ubic_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"inaubica.ubic_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inaubica.ubic_bodega~"   OP =~"=~"    EXP2 =~":bodega~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"bodega~" TYPE = string) " update="inaubica" updatewhere=1 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("bodega", string)) )
