table(column=(type=datetime updatewhereclause=yes name=prod_entrada_fecha dbname="inmprodu.prod_entrada_fecha" dbalias=".prod_entrada_fecha" )
 column=(type=char(20) updatewhereclause=yes name=prod_producto dbname="inmprodu.prod_producto" dbalias=".prod_producto" )
 column=(type=char(20) updatewhereclause=yes name=prod_producto_dos dbname="inmprodu.prod_producto_dos" dbalias=".prod_producto_dos" )
 column=(type=char(65) updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" dbalias=".prod_descripcion" )
 column=(type=decimal(0) updatewhereclause=yes name=inmprodu_prod_g_financiero dbname="inmprodu.prod_g_financiero" dbalias=".prod_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=inmprodu_prod_empresa dbname="inmprodu.prod_empresa" dbalias=".prod_empresa" )
 column=(type=char(120) updatewhereclause=yes name=prod_foto_dir dbname="inmprodu.prod_foto_dir" dbalias=".prod_foto_dir" )
 column=(type=char(25) updatewhereclause=yes name=cramarca_amar_nombre_marca dbname="cramarca.amar_nombre_marca" dbalias=".amar_nombre_marca" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" dbalias=".prod_empaque" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_cubicaje dbname="inmprodu.prod_cubicaje" dbalias=".prod_cubicaje" )
 column=(type=decimal(8) updatewhereclause=yes name=inmprodu_prod_costo_fob dbname="prod_costo_fob" )
 column=(type=decimal(8) updatewhereclause=yes name=inmprodu_prod_costo_cif dbname="inmprodu.prod_costo_cif" dbalias=".prod_costo_cif" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_descripcion_dos dbname="inmprodu.prod_descripcion_dos" dbalias=".prod_descripcion_dos" )
 column=(type=char(255) updatewhereclause=yes name=inmprodu_prod_observacion dbname="inmprodu.prod_observacion" dbalias=".prod_observacion" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_precio_venta_unidad dbname="inmprodu.prod_precio_venta_unidad" dbalias=".prod_precio_venta_unidad" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_existencia_total dbname="inmprodu.prod_existencia_total" dbalias=".prod_existencia_total" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_reserva_total dbname="inmprodu.prod_reserva_total" dbalias=".prod_reserva_total" )
 column=(type=char(1) updatewhereclause=yes name=letras dbname="letras" )
 column=(type=char(1) updatewhereclause=yes name=desde dbname="desde" )
 column=(type=char(1) updatewhereclause=yes name=hasta dbname="hasta" )
 column=(type=char(5) updatewhereclause=yes name=inmprodu_prod_marca dbname="inmprodu.prod_marca" dbalias=".prod_marca" )
 column=(type=char(17) updatewhereclause=yes name=barra dbname="barra" )
 column=(type=char(3) updatewhereclause=yes name=inmprodu_prod_division dbname="inmprodu.prod_division" dbalias=".prod_division" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" dbalias=".medi_cantidad" )
 column=(type=decimal(0) updatewhereclause=yes name=disponibles dbname="disponibles" )
 column=(type=decimal(0) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_sec dbname="inmprodu.prod_ultima_entrada_sec" dbalias=".prod_ultima_entrada_sec" )
 column=(type=char(10) updatewhereclause=yes name=precio dbname="precio" )
 column=(type=char(10) updatewhereclause=yes name=costo dbname="costo" )
 column=(type=decimal(4) updatewhereclause=yes name=precio_numero dbname="inmprodu.precio_numero" dbalias=".precio_numero" )
 column=(type=decimal(0) updatewhereclause=yes name=dentero dbname="dentero" )
 column=(type=decimal(0) updatewhereclause=yes name=total_entrada dbname="total_entrada" )
 column=(type=decimal(0) updatewhereclause=yes name=prod_tercero dbname="inmprodu.prod_tercero" dbalias=".prod_tercero" )
 column=(type=long updatewhereclause=yes name=incluir dbname="incluir" initial="1" values="	1/	0" )
 column=(type=decimal(0) updatewhereclause=yes name=rentero dbname="rentero" )
 column=(type=decimal(6) updatewhereclause=yes name=prod_ultima_entrada_can dbname="prod_ultima_entrada_can" )
 column=(type=decimal(0) updatewhereclause=yes name=prod_ultima_entrada_can_2 dbname="prod_ultima_entrada_can_2" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_empaque_um dbname="inmprodu.prod_empaque_um" dbalias=".prod_empaque_um" )
 column=(type=decimal(4) updatewhereclause=yes name=precio_numero2 dbname="precio_numero2" )
 column=(type=long updatewhereclause=yes name=ver_precio dbname="ver_precio" )
 column=(type=long updatewhereclause=yes name=ver_cantidad dbname="ver_cantidad" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_nivel1 dbname="inmprodu.prod_nivel1" dbalias=".prod_nivel1" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_nivel2 dbname="inmprodu.prod_nivel2" dbalias=".prod_nivel2" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_nivel3 dbname="inmprodu.prod_nivel3" dbalias=".prod_nivel3" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_nivel4 dbname="inmprodu.prod_nivel4" dbalias=".prod_nivel4" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_nivel5 dbname="inmprodu.prod_nivel5" dbalias=".prod_nivel5" )
 column=(type=char(120) updatewhereclause=yes name=prod_foto_catalogo dbname="inmprodu.prod_foto_catalogo" dbalias=".prod_foto_catalogo" )
 column=(type=char(30) updatewhereclause=yes name=talla dbname="talla" )
 column=(type=char(20) updatewhereclause=yes name=precio1 dbname="precio1" )
 column=(type=char(20) updatewhereclause=yes name=precio2 dbname="precio2" )
 column=(type=decimal(4) updatewhereclause=yes name=precio_numero3 dbname="precio_numero3" )
 column=(type=char(20) updatewhereclause=yes name=precio3 dbname="precio3" )
 retrieve="  SELECT inmprodu.prod_entrada_fecha,   
         inmprodu.prod_producto,   
         inmprodu.prod_producto_dos,   
         inmprodu.prod_descripcion,   
		inmprodu.prod_g_financiero,   
         inmprodu.prod_empresa,    
         inmprodu.prod_foto_dir,
		cramarca.amar_nombre_marca,      
         inmprodu.prod_empaque,   
         inmprodu.prod_cubicaje,   
         prod_costo_fob = case when prod_empresa = 9 then round(inmprodu.prod_costo_fob + prod_flete,2) else prod_costo_fob end,   
         inmprodu.prod_costo_cif,   
         inmprodu.prod_descripcion_dos,   
         inmprodu.prod_observacion,        
         inmprodu.prod_precio_venta_unidad,   
         inmprodu.prod_existencia_total,   
         inmprodu.prod_reserva_total,   
         letras = '',   
         desde = '',   
         hasta = '',   
         inmprodu.prod_marca,   
         '*' + inmprodu.prod_barra +'*' barra,   
         inmprodu.prod_division, 
         inamedid.medi_cantidad,   
         convert(numeric(10, 0), ((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) /inamedid.medi_cantidad)) disponibles,  
         inmprodu.prod_ultima_entrada_sec,   
         '          ' precio,   
         '          ' costo,   
         inmprodu.prod_precio1 precio_numero,
         convert(numeric(10, 0), ((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) /inamedid.medi_cantidad)) dentero,   
         total_entrada = convert(numeric(10, 0), ( inmprodu.prod_ultima_entrada_can /inamedid.medi_cantidad) * prod_costo_fob),   
         inmprodu.prod_tercero,   
         incluir=0,   
         convert(numeric(10, 0), (inmprodu.prod_reserva_total / inamedid.medi_cantidad)) rentero,   
         prod_ultima_entrada_can = ( SELECT sum(dmov_cantidad) FROM indmovim,  intmovim   WHERE ( indmovim.dmov_g_financiero = intmovim.tmov_g_financiero ) and   ( indmovim.dmov_empresa = intmovim.tmov_empresa ) and  ( indmovim.dmov_aplicacion = intmovim.tmov_aplicacion ) and  ( indmovim.dmov_tipo_transaccion = intmovim.tmov_tipo_transaccion ) and  ( indmovim.dmov_concepto = intmovim.tmov_concepto ) and  ( indmovim.dmov_secuencia = intmovim.tmov_secuencia ) and  ( indmovim.dmov_anual = intmovim.tmov_anual ) and  ( ( indmovim.dmov_g_financiero = inmprodu.prod_g_financiero ) AND ( indmovim.dmov_empresa = inmprodu.prod_empresa ) AND ( indmovim.dmov_aplicacion = 'IN' ) AND  ( indmovim.dmov_tipo_transaccion = 'EN' ) AND  ( indmovim.dmov_producto = inmprodu.prod_producto) )),   
         convert(numeric(10, 0), ( inmprodu.prod_ultima_entrada_can /inamedid.medi_cantidad)) prod_ultima_entrada_can_2,   
		inmprodu.prod_empaque_um,
         case when ( inmprodu.prod_precio2 = 0 or inmprodu.prod_precio2 is null ) then inmprodu.prod_precio1 else  inmprodu.prod_precio2 end precio_numero2 ,
		ver_precio = 1,
		ver_cantidad = 1,
		prod_nivel1,
		prod_nivel2,
		prod_nivel3,
		prod_nivel4,
		prod_nivel5,
		inmprodu.prod_foto_catalogo,
		talla = (select max(t.acta_descripcion) from cracltam t where inmprodu.prod_cod_clase_tam = t.acta_cod_clase_tam and inmprodu.prod_empresa = t.acta_empresa and inmprodu.prod_g_financiero = t.acta_g_financiero),
		precio1 = '                    ',
		precio2 = '                    ',
		case when ( inmprodu.prod_precio3 = 0 or inmprodu.prod_precio3 is null  ) then case when ( inmprodu.prod_precio2 = 0 or inmprodu.prod_precio2 is null  ) then inmprodu.prod_precio1 else inmprodu.prod_precio2 end else inmprodu.prod_precio3 end precio_numero3 ,
		precio3 = '                    '
    FROM inmprodu,   
         inamedid,   
         cramarca
   WHERE ( inmprodu.prod_medida = inamedid.medi_medida ) and  
         ( inmprodu.prod_g_financiero = cramarca.amar_g_financiero ) and  
         ( inmprodu.prod_empresa = cramarca.amar_empresa ) and  
         ( cramarca.amar_num_marca = inmprodu.prod_marca ) and  
         ( ( inmprodu.prod_g_financiero = :grupo ) AND  
         ( inmprodu.prod_empresa = :empresa ) AND  
         (inmprodu.prod_entrada_fecha >= :fecini AND  
         inmprodu.prod_entrada_fecha < dateadd(dd,1,:fecfin)) )    
" arguments=(("grupo", number),("empresa", number),("fecini", date),("fecfin", date))  sort="prod_producto A " )
