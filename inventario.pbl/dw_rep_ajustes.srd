rce.terc_tercero~"    OP =~"=~"RIGHT=~"intmovim.tmov_terceros~"    OUTER2 =~"intmovim.tmov_terceros~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"indmovim.dmov_producto~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"indmovim.dmov_unidad_medida~" )    JOIN (LEFT=~"dgmsubse.subs_g_financiero~"    OP =~"=~"RIGHT=~"intmovim.tmov_g_financiero~" )    JOIN (LEFT=~"dgmsubse.subs_empresa~"    OP =~"=~"RIGHT=~"intmovim.tmov_empresa~" )    JOIN (LEFT=~"dgmsubse.subs_transaccion~"    OP =~"=~"RIGHT=~"intmovim.tmov_tipo_transaccion~" )    JOIN (LEFT=~"dgmsubse.subs_sub_trans~"    OP =~"=~"RIGHT=~"intmovim.tmov_concepto~" )    JOIN (LEFT=~"intmovim.tmov_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"intmovim.tmov_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"intmovim.tmov_tipo_transaccion~"    OP =~"=~"RIGHT=~"indmovim.dmov_tipo_transaccion~" )    JOIN (LEFT=~"intmovim.tmov_secuencia~"    OP =~"=~"RIGHT=~"indmovim.dmov_secuencia~" )    JOIN (LEFT=~"inabodeg.abod_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"inabodeg.abod_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"inabodeg.abod_bodega~"    OP =~"=~"RIGHT=~"indmovim.dmov_bodega~" )    JOIN (LEFT=~"intmovim.tmov_concepto~"    OP =~"=~"RIGHT=~"indmovim.dmov_concepto~" )    JOIN (LEFT=~"intmovim.tmov_anual~"    OP =~"=~"RIGHT=~"indmovim.dmov_anual~" )WHERE(    EXP1 =~"intmovim.tmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_tipo_transaccion~"   OP =~"=~"  