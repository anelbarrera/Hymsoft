table(column=(type=char(20) updatewhereclause=yes name=modelo dbname="modelo" )
 column=(type=char(65) updatewhereclause=yes name=descripcion dbname="descripcion" )
 column=(type=char(30) updatewhereclause=yes name=unidad dbname="unidad" )
 column=(type=decimal(3) updatewhereclause=yes name=entero dbname="entero" )
 column=(type=decimal(8) updatewhereclause=yes name=costo_fob dbname="costo_fob" )
 column=(type=decimal(8) updatewhereclause=yes name=costo_promedio dbname="costo_promedio" )
 column=(type=char(50) updatewhereclause=yes name=adiv_nombre_div dbname="adiv_nombre_div" )
 column=(type=char(50) updatewhereclause=yes name=agru_descripcion_grupo dbname="agru_descripcion_grupo" )
 column=(type=decimal(4) updatewhereclause=yes name=venta dbname="venta" )
 column=(type=decimal(6) updatewhereclause=yes name=cantidad dbname="cantidad" )
 column=(type=decimal(2) updatewhereclause=yes name=margen dbname="margen" )
 column=(type=char(20) updatewhereclause=yes name=facd_codigo_item dbname="faddiari.facd_codigo_item" dbalias=".facd_codigo_item" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cradivis~" )  TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"cragrupo~" ) COMPUTE(NAME=~"max(prod_producto) modelo~") COMPUTE(NAME=~"max(prod_descripcion) descripcion~") COMPUTE(NAME=~"max(inamedid.medi_descripcion) unidad~") COMPUTE(NAME=~"max(case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_existencia_total/inamedid.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_existencia_total/inamedid.medi_cantidad)) end) entero~") COMPUTE(NAME=~"max(prod_costo_cif) costo_fob~") COMPUTE(NAME=~"max(prod_costo_promedio) costo_promedio~") COMPUTE(NAME=~"max(adiv_nombre_div) adiv_nombre_div~") COMPUTE(NAME=~"max(agru_descripcion_grupo) agru_descripcion_grupo~") COMPUTE(NAME=~"sum(faddiari.facd_monto_final) venta~") COMPUTE(NAME=~"sum(faddiari.facd_cantidad) cantidad~") COMPUTE(NAME=~"margen = 0.00~") COLUMN(NAME=~"faddiari.facd_codigo_item~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"faddiari.facd_codigo_item~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cradivis.adiv_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cradivis.adiv_empresa~" )    JOIN (LEFT=~"inmprodu.prod_division~"    OP =~"=~"RIGHT=~"cradivis.adiv_codigo_div~" )    JOIN (LEFT=~"cragrupo.agru_g_financiero~"    OP =~"=~"RIGHT=~"cradivis.adiv_g_financiero~" )    JOIN (LEFT=~"cragrupo.agru_empresa~"    OP =~"=~"RIGHT=~"cradivis.adiv_empresa~" )    JOIN (LEFT=~"cragrupo.agru_codigo_div~"    OP =~"=~"RIGHT=~"cradivis.adiv_codigo_div~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cragrupo.agru_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cragrupo.agru_empresa~" )    JOIN (LEFT=~"inmprodu.prod_division~"    OP =~"=~"RIGHT=~"cragrupo.agru_codigo_div~" )    JOIN (LEFT=~"inmprodu.prod_grupo~"    OP =~"=~"RIGHT=~"cragrupo.agru_codigo_grupo~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~" )  GROUP(NAME=~"faddiari.facd_codigo_item~")) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("fecha1", datetime),("fecha2", datetime))  sort="cantidad D " )
