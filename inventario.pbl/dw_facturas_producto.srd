 column=(type=char(200) updatewhereclause=yes name=tmov_ruta_factura dbname="intmovim.tmov_ruta_factura" dbalias=".tmov_ruta_factura" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"indmovim~" )  TABLE(NAME=~"intmovim~" )  TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"intmovim.tmov_documento~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"intmovim.tmov_secuencia~") COLUMN(NAME=~"intmovim.tmov_anual~") COLUMN(NAME=~"intmovim.tmov_concepto~") COLUMN(NAME=~"intmovim.tmov_ruta_factura~")    JOIN (LEFT=~"intmovim.tmov_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"intmovim.tmov_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"intmovim.tmov_aplicacion~"    OP =~"=~"RIGHT=~"indmovim.dmov_aplicacion~" )    JOIN (LEFT=~"intmovim.tmov_tipo_transaccion~"    OP =~"=~"RIGHT=~"indmovim.dmov_tipo_transaccion~" )    JOIN (LEFT=~"intmovim.tmov_secuencia~"    OP =~"=~"RIGHT=~"indmovim.dmov_secuencia~" )    JOIN (LEFT=~"intmovim.tmov_anual~"    OP =~"=~"RIGHT=~"indmovim.dmov_anual~" )    JOIN (LEFT=~"intmovim.tmov_concepto~"    OP =~"=~"RIGHT=~"indmovim.dmov_concepto~" )    JOIN (LEFT=~"intmovim.tmov_terceros~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"indmovim.dmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_producto~"   OP =~"=~"    EXP2 =~":producto~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"producto~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("producto", string))  sort="intmovim_tmov_fecha D " )
