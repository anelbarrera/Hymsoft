 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_descripcion_dos dbname="inmprodu.prod_descripcion_dos" dbalias=".prod_descripcion_dos" )
 column=(type=char(255) updatewhereclause=yes name=inmprodu_prod_observacion dbname="inmprodu.prod_observacion" dbalias=".prod_observacion" )
