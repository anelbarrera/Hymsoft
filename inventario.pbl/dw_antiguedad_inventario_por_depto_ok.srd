table(column=(type=char(20) updatewhereclause=yes name=adiv_nombre_div dbname="adiv_nombre_div" )
 column=(type=number updatewhereclause=yes name=valor dbname="valor" )
 retrieve="  SELECT adiv_codigo_div + '-'+ cradivis.adiv_nombre_div adiv_nombre_div,
         sum(round(prom_existencia *prom_costo_promedio,4)) valor,   
  case  DATEDIFF(mm,max(inmprodu.prod_entrada_fecha),max(prom_fecha)) 
       when 0 then ~"0 Corriente~"    
       when 1 then ~"030 dias~"  
       when 2 then ~"060 dias~"  
       when 3 then ~"090 dias~"  
       when 4 then ~"120 dias~"  
       when 5 then ~"150 dias~"  
       when 6 then ~"180 dias~" 
       when 7 then ~"210 dias~"   
       when 8 then ~"240 dias~"   
       when 9 then ~"270 dias~"   
       when 10 then ~"300 dias~"   
       when 11 then ~"330 dias~"   
       when 12 then ~"360 dias~"   
       else ~"mas 360~" end mes,max(dgmempre.empr_razon_social) empr_razon_social
    FROM inmprodu,   
         cradivis,
         inhprome,
         dgmempre  
   WHERE ( inmprodu.prod_g_financiero = cradivis.adiv_g_financiero ) and  
         ( inmprodu.prod_empresa = cradivis.adiv_empresa ) and  
         ( inmprodu.prod_division = cradivis.adiv_codigo_div ) and 
         ( prom_g_financiero = prod_g_financiero ) and
         ( prom_empresa = prod_empresa ) and
         ( prom_producto = prod_producto ) and
         ( dgmempre.empr_g_financiero = prod_g_financiero) AND  
         ( dgmempre.empr_empresa = prod_empresa )  and
         ( ( inmprodu.prod_g_financiero = :grupo ) AND  
         ( inmprodu.prod_empresa = :empresa )  AND
         ( prom_maquina =:USUARIO))  
GROUP BY datepart(yy,prod_entrada_fecha),datepart(mm,prod_entrada_fecha), adiv_codigo_div , cradivis.adiv_nombre_div" arguments=(("grupo", number),("empresa", number),("usuario", string))  sort="adiv_nombre_div A " )
