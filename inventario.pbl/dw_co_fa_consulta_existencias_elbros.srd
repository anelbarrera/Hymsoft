table(column=(type=char(20) updatewhereclause=yes name=prod_producto dbname="inmprodu.prod_producto" initial="empty" )
 column=(type=char(65) updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" initial="empty" )
 column=(type=char(20) updatewhereclause=yes name=prod_producto_dos dbname="inmprodu.prod_producto_dos" )
 column=(type=char(50) updatewhereclause=yes name=prod_descripcion_dos dbname="inmprodu.prod_descripcion_dos" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_medida dbname="inmprodu.prod_medida" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_peso dbname="inmprodu.prod_peso" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_cubicaje dbname="inmprodu.prod_cubicaje" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_empaque_descripcion dbname="inmprodu.prod_empaque_descripcion" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_peso_descripcion dbname="inmprodu.prod_peso_descripcion" )
 column=(type=datetime updatewhereclause=yes name=prod_fecha_creacion dbname="inmprodu.prod_fecha_creacion" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_owner dbname="inmprodu.prod_owner" values="00	00/01	01/10	10/11	11/" )
 column=(type=char(15) updatewhereclause=yes name=inmprodu_prod_barra dbname="inmprodu.prod_barra" initial="empty" )
 column=(type=char(12) updatewhereclause=yes name=inmprodu_prod_arancel dbname="inmprodu.prod_arancel" initial="empty" )
 column=(type=char(14) updatewhereclause=yes name=inmprodu_prod_codigo_modelo dbname="inmprodu.prod_codigo_modelo" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_cod_alternativo dbname="inmprodu.prod_cod_alternativo" )
 column=(type=datetime updatewhereclause=yes name=inmprodu_prod_ultima_actualizacion dbname="inmprodu.prod_ultima_actualizacion" )
 column=(type=char(120) updatewhereclause=yes name=inmprodu_prod_foto_dir dbname="inmprodu.prod_foto_dir" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medi_descripcion dbname="inamedid.medi_descripcion" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_ultima_salida_doc dbname="inmprodu.prod_ultima_salida_doc" )
 column=(type=datetime updatewhereclause=yes name=inmprodu_prod_salida_fecha dbname="inmprodu.prod_salida_fecha" )
 column=(type=datetime updatewhereclause=yes name=inmprodu_prod_entrada_fecha dbname="inmprodu.prod_entrada_fecha" )
 column=(type=char(18) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_doc dbname="inmprodu.prod_ultima_entrada_doc" initial="empty" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_can dbname="inmprodu.prod_ultima_entrada_can" initial="0" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_cant_transito dbname="inmprodu.prod_cant_transito" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_reserva_total dbname="inmprodu.prod_reserva_total" initial="0" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_existencia_total dbname="inmprodu.prod_existencia_total" initial="0" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" )
 column=(type=decimal(4) updatewhereclause=yes name=prod_precio1 dbname="inmprodu.prod_precio1" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_precio2 dbname="inmprodu.prod_precio2" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_precio3 dbname="inmprodu.prod_precio3" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_precio4 dbname="inmprodu.prod_precio4" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_precio5 dbname="inmprodu.prod_precio5" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medi_descripcion dbname="inamedid.medi_descripcion" )
 column=(type=char(10) updatewhereclause=yes name=inamedid_medi_abre dbname="inamedid.medi_abre" )
 column=(type=decimal(6) updatewhereclause=yes name=prod_reserva_trans dbname="inmprodu.prod_reserva_trans" )
 column=(type=char(10) updatewhereclause=yes name=inamedid_medi_abre dbname="inamedid.medi_abre" )
 column=(type=decimal(3) updatewhereclause=yes name=rentero dbname="rentero" )
 column=(type=decimal(3) updatewhereclause=yes name=dentero dbname="dentero" )
 column=(type=decimal(3) updatewhereclause=yes name=entero dbname="entero" )
 column=(type=decimal(2) updatewhereclause=yes name=fraccion dbname="fraccion" )
 column=(type=decimal(2) updatewhereclause=yes name=rfraccion dbname="rfraccion" )
 column=(type=decimal(2) updatewhereclause=yes name=dfraccion dbname="dfraccion" )
 column=(type=char(50) updatewhereclause=yes name=agru_descripcion_grupo dbname="cragrupo.agru_descripcion_grupo" )
 column=(type=char(255) updatewhereclause=yes name=inmprodu_prod_observacion dbname="inmprodu.prod_observacion" )
 column=(type=decimal(8) updatewhereclause=yes name=prod_costo_cif dbname="inmprodu.prod_costo_cif" )
 column=(type=char(25) updatewhereclause=yes name=cramarca_amar_nombre_marca dbname="cramarca.amar_nombre_marca" )
 column=(type=char(60) updatewhereclause=yes name=inaaranc_aran_descripcion dbname="inaaranc.aran_descripcion" )
 column=(type=long updatewhereclause=yes name=dias_en_bodega dbname="dias_en_bodega" )
 column=(type=decimal(0) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_sec dbname="inmprodu.prod_ultima_entrada_sec" )
 column=(type=char(100) updatewhereclause=yes name=acol_nombre_color dbname="cracolor.acol_nombre_color" )
 column=(type=char(5) updatewhereclause=yes name=acol_num_color dbname="cracolor.acol_num_color" )
 column=(type=char(30) updatewhereclause=yes name=cracltam_acta_descripcion dbname="cracltam.acta_descripcion" )
 column=(type=char(120) updatewhereclause=yes name=inmprodu_prod_gramaje dbname="prod_gramaje" )
 column=(type=decimal(2) updatewhereclause=yes name=inmprodu_prod_alto dbname="inmprodu.prod_alto" initial=" " )
 column=(type=decimal(2) updatewhereclause=yes name=inmprodu_prod_ancho dbname="inmprodu.prod_ancho" initial=" " )
 column=(type=decimal(2) updatewhereclause=yes name=inmprodu_prod_largo dbname="inmprodu.prod_largo" initial=" " )
 column=(type=char(15) updatewhereclause=yes name=inmprodu_prod_documento_entrada dbname="inmprodu.prod_documento_entrada" )
 column=(type=decimal(3) updatewhereclause=yes name=transito dbname="transito" )
 column=(type=char(20) updatewhereclause=yes name=prod_contrato dbname="inmprodu.prod_contrato" )
 retrieve="SELECT  inmprodu.prod_producto ,
           inmprodu.prod_descripcion ,
           inmprodu.prod_producto_dos ,
           inmprodu.prod_descripcion_dos ,
           inmprodu.prod_medida ,
           inmprodu.prod_peso ,
           inmprodu.prod_cubicaje ,
           inmprodu.prod_empaque ,
           inmprodu.prod_empaque_descripcion ,
           inmprodu.prod_peso_descripcion ,
           inmprodu.prod_fecha_creacion ,
           inmprodu.prod_owner ,
           inmprodu.prod_barra ,
           inmprodu.prod_arancel ,
           inmprodu.prod_codigo_modelo ,
           inmprodu.prod_cod_alternativo ,
           inmprodu.prod_ultima_actualizacion ,
           inmprodu.prod_foto_dir ,
           inamedid_a.medi_descripcion ,
           inmprodu.prod_ultima_salida_doc ,
           inmprodu.prod_salida_fecha ,
           inmprodu.prod_entrada_fecha ,
           inmprodu.prod_ultima_entrada_doc ,
           inmprodu.prod_ultima_entrada_can ,
           inmprodu.prod_cant_transito ,
           inmprodu.prod_reserva_total ,
           inmprodu.prod_existencia_total ,
           inamedid_b.medi_cantidad ,
           inmprodu.prod_precio1 ,
           inmprodu.prod_precio2 ,
           inmprodu.prod_precio3 ,
           inmprodu.prod_precio4 ,
           inmprodu.prod_precio5 ,
           inamedid_b.medi_descripcion ,
           inamedid_a.medi_abre ,
           inmprodu.prod_reserva_trans ,
           inamedid_c.medi_abre ,
 case inamedid_b.medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_reserva_total/inamedid_b.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_reserva_total/inamedid_b.medi_cantidad)) end rentero,
 case inamedid_b.medi_tipo_medida when 10 then convert(numeric(11,0),((inmprodu.prod_existencia_total - prod_reserva_total) /inamedid_b.medi_cantidad)) else convert(numeric(11,3),((inmprodu.prod_existencia_total - prod_reserva_total) /inamedid_b.medi_cantidad)) end dentero,
 case inamedid_b.medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_existencia_total/inamedid_b.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_existencia_total/inamedid_b.medi_cantidad)) end entero,
 0.00  fraccion,
 0.00 rfraccion,
 0.00 dfraccion,
           cragrupo.agru_descripcion_grupo ,
           inmprodu.prod_observacion ,
           inmprodu.prod_costo_cif ,
           cramarca.amar_nombre_marca ,
           inaaranc.aran_descripcion ,
           datediff(dd, inmprodu.prod_entrada_fecha, getdate()) dias_en_bodega,
           inmprodu.prod_ultima_entrada_sec,
           cracolor.acol_nombre_color,
           cracolor.acol_num_color,
			  cracltam.acta_descripcion,
			  case when inmprodu.prod_gramaje = null or len(isnull(inmprodu.prod_gramaje,'')) = 0 then convert(varchar(5), convert(int, prod_alto))+'X'+convert(varchar(5),convert(int,prod_ancho))+'X'+convert(varchar(5),convert(int,prod_largo))+'CM.' else inmprodu.prod_gramaje end prod_gramaje ,
			  prod_alto,
			  prod_ancho,
			  prod_largo,
		inmprodu.prod_documento_entrada,
 case inamedid_b.medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_cant_confirma /inamedid_b.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_cant_confirma /inamedid_b.medi_cantidad)) end transito ,
		inmprodu.prod_contrato
        FROM inmprodu left join cramarca on ( cramarca.amar_g_financiero = inmprodu.prod_g_financiero) and   
              ( cramarca.amar_empresa = inmprodu.prod_empresa) and    
              ( cramarca.amar_num_marca = inmprodu.prod_marca) ,
           inamedid inamedid_a ,
            inamedid inamedid_b ,
           inamedid inamedid_c ,
           cragrupo ,
           inaaranc,
           cracolor,
			  cracltam      
        WHERE   ( cracltam.acta_g_financiero = inmprodu.prod_g_financiero) and   
              ( cracltam.acta_empresa = inmprodu.prod_empresa) and    
              ( cracltam.acta_cod_clase_tam = inmprodu.prod_cod_clase_tam) and    
              ( inaaranc.aran_arancel = inmprodu.prod_arancel) and 
              ( inamedid_a.medi_medida = inmprodu.prod_peso_unidad_medida ) and
              ( inmprodu.prod_medida = inamedid_b.medi_medida ) and  
              ( inmprodu.prod_empaque_um = inamedid_c.medi_medida ) and   
              ( inmprodu.prod_g_financiero = cragrupo.agru_g_financiero ) and  
              ( inmprodu.prod_empresa      = cragrupo.agru_empresa ) and   
              ( inmprodu.prod_division     = cragrupo.agru_codigo_div ) and 
              ( inmprodu.prod_grupo        = cragrupo.agru_codigo_grupo ) and 
              ( inmprodu.prod_g_financiero = cracolor.acol_g_financiero ) and  
              ( inmprodu.prod_empresa      = cracolor.acol_empresa ) and   
              ( inmprodu.prod_color        = cracolor.acol_num_color ) and 
              ( ( inmprodu.prod_g_financiero = :grupo    ) and  
                ( inmprodu.prod_empresa      = :empresa  ) and    
                ( inmprodu.prod_producto     = :producto ) and    
                ( inmprodu.prod_status       = 1 ) ) 
        ORDER BY inmprodu.prod_producto          ASC  " arguments=(("grupo", number),("empresa", number),("producto", string)) )
