table(column=(type=char(20) updatewhereclause=yes name=prod_producto_dos dbname="inmprodu.prod_producto_dos" )
 column=(type=decimal(8) updatewhereclause=yes name=prod_costo_fob dbname="inmprodu.prod_costo_fob" )
 column=(type=char(65) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_descripcion_dos dbname="inmprodu.prod_descripcion_dos" )
 column=(type=char(25) updatewhereclause=yes name=cramarca_amar_nombre_marca dbname="cramarca.amar_nombre_marca" )
 column=(type=char(120) updatewhereclause=yes name=prod_foto_dir dbname="inmprodu.prod_foto_dir" )
 column=(type=char(5) updatewhereclause=yes name=prod_marca dbname="inmprodu.prod_marca" )
 column=(type=char(60) updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" )
 column=(type=char(20) updatewhereclause=yes key=yes name=prod_producto dbname="inmprodu.prod_producto" )
 column=(type=datetime updatewhereclause=yes name=inmprodu_prod_entrada_fecha dbname="inmprodu.prod_entrada_fecha" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_doc dbname="inmprodu.prod_ultima_entrada_doc" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_ultima_salida_doc dbname="inmprodu.prod_ultima_salida_doc" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_existencia_total dbname="inmprodu.prod_existencia_total" )
 column=(type=decimal(0) updatewhereclause=yes name=entero dbname="entero" )
 column=(type=decimal(8) updatewhereclause=yes name=fraccion dbname="fraccion" )
 column=(type=decimal(0) updatewhereclause=yes name=prod_ultima_entrada_can dbname="prod_ultima_entrada_can" )
 column=(type=long updatewhereclause=yes name=imprimir dbname="imprimir" )
 column=(type=decimal(8) updatewhereclause=yes name=prod_costo_promedio dbname="inmprodu.prod_costo_promedio" )
 column=(type=decimal(4) updatewhereclause=yes name=porc_vendido dbname="porc_vendido" )
 column=(type=long updatewhereclause=yes name=dias_vendidos dbname="dias_vendidos" )
 column=(type=decimal(0) updatewhereclause=yes name=cant_bulto dbname="cant_bulto" )
 column=(type=long updatewhereclause=yes name=rango_dias dbname="rango_dias" )
 column=(type=datetime updatewhereclause=yes name=prod_salida_fecha dbname="prod_salida_fecha" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=prod_excluir_de_sugerido dbname="inmprodu.prod_excluir_de_sugerido" initial="0" values="	1/	0" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=inmprodu_prod_g_financiero dbname="inmprodu.prod_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=inmprodu_prod_empresa dbname="inmprodu.prod_empresa" )
 column=(type=datetime updatewhereclause=yes name=fecha_reserva dbname="fecha_reserva" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"cramarca~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_a~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_b~" ) COLUMN(NAME=~"inmprodu.prod_producto_dos~") COLUMN(NAME=~"inmprodu.prod_costo_fob~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_descripcion_dos~") COLUMN(NAME=~"cramarca.amar_nombre_marca~") COLUMN(NAME=~"inmprodu.prod_foto_dir~") COLUMN(NAME=~"inmprodu.prod_marca~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_entrada_fecha~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_doc~") COLUMN(NAME=~"inmprodu.prod_ultima_salida_doc~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COMPUTE(NAME=~"convert(numeric(10,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total )/inamedid_a.medi_cantidad)) entero~") COMPUTE(NAME=~"inmprodu.prod_existencia_total - (convert(numeric(10,0),(inmprodu.prod_existencia_total/inamedid_a.medi_cantidad)) * inamedid_a.medi_cantidad) fraccion~") COMPUTE(NAME=~"convert(numeric(10,0),(inmprodu.prod_ultima_entrada_can / inamedid_a.medi_cantidad)) prod_ultima_entrada_can~") COMPUTE(NAME=~" 0 imprimir~") COLUMN(NAME=~"inmprodu.prod_costo_promedio~") COMPUTE(NAME=~"(1 - (convert(numeric(10,4),(case when inmprodu.prod_ultima_entrada_can > 0 then inmprodu.prod_existencia_total / inmprodu.prod_ultima_entrada_can end )))) * 100 porc_vendido~") COMPUTE(NAME=~"case when prod_salida_fecha >= inmprodu.prod_entrada_fecha then  datediff(dd, inmprodu.prod_entrada_fecha, prod_salida_fecha ) end dias_vendidos~") COMPUTE(NAME=~"convert(numeric(10,0),prod_empaque * inamedid_b.medi_cantidad) cant_bulto~") COMPUTE(NAME=~"case when prod_salida_fecha >= inmprodu.prod_entrada_fecha then   case when datediff(dd, inmprodu.prod_entrada_fecha, prod_salida_fecha ) <= 15 then 1 when datediff(dd, inmprodu.prod_entrada_fecha, prod_salida_fecha ) <= 45 then 2 when datediff(dd, inmprodu.prod_entrada_fecha, prod_salida_fecha ) <= 75 then 3 when datediff(dd, inmprodu.prod_entrada_fecha, prod_salida_fecha ) <= 90 then 4  when datediff(dd, inmprodu.prod_entrada_fecha, prod_salida_fecha ) <= 120 then 5 else 0 end    else 0 end rango_dias~") COMPUTE(NAME=~"case when prod_salida_fecha >= prod_entrada_fecha then prod_salida_fecha else null end prod_salida_fecha~") COLUMN(NAME=~"inmprodu.prod_excluir_de_sugerido~") COLUMN(NAME=~"inmprodu.prod_g_financiero~") COLUMN(NAME=~"inmprodu.prod_empresa~") COMPUTE(NAME=~"case when inmprodu.prod_reserva_total > 0 then (  SELECT max(fatdiari.fact_fecha) FROM faddiari, fatdiari  WHERE ( fatdiari.fact_g_financiero = faddiari.facd_g_financiero ) and  ( fatdiari.fact_empresa = faddiari.facd_empresa ) and  ( fatdiari.fact_tipo = faddiari.facd_tipo ) and  ( fatdiari.fact_no_pedido = faddiari.facd_no_pedido ) and  ( fatdiari.fact_ann = faddiari.facd_ann ) and  ( ( faddiari.facd_g_financiero = inmprodu.prod_g_financiero ) AND ( faddiari.facd_empresa = inmprodu.prod_empresa ) AND ( faddiari.facd_codigo_item = inmprodu.prod_producto ) AND  ( fatdiari.fact_estado = 'A' ) ))  end fecha_reserva~")    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cramarca.amar_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cramarca.amar_empresa~" )    JOIN (LEFT=~"inmprodu.prod_marca~"    OP =~"=~"RIGHT=~"cramarca.amar_num_marca~" )    JOIN (LEFT=~"inmprodu.prod_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid_a.medi_medida~" )    JOIN (LEFT=~"inmprodu.prod_empaque_um~"    OP =~"=~"RIGHT=~"inamedid_b.medi_medida~" )WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_salida_fecha~"   OP =~"<>~"    EXP2 =~"null~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " update="inmprodu" updatewhere=0 updatekeyinplace=yes filter="prod_excluir_de_sugerido = 0 and entero <= ( prod_ultima_entrada_can / 2)"arguments=(("grupo", number),("empresa", number))  sort="inmprodu_prod_entrada_fecha D inmprodu_prod_descripcion A " )
