table(column=(type=char(20) updatewhereclause=yes key=yes name=prod_producto dbname="inmprodu.prod_producto" dbalias=".prod_producto" )
 column=(type=char(65) updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" dbalias=".prod_descripcion" )
 column=(type=char(50) update=yes updatewhereclause=yes name=prod_nivel1 dbname="inmprodu.prod_nivel1" dbalias=".prod_nivel1" )
 column=(type=char(50) update=yes updatewhereclause=yes name=prod_nivel2 dbname="inmprodu.prod_nivel2" dbalias=".prod_nivel2" )
 column=(type=char(50) update=yes updatewhereclause=yes name=prod_nivel3 dbname="inmprodu.prod_nivel3" dbalias=".prod_nivel3" )
 column=(type=char(50) update=yes updatewhereclause=yes name=prod_nivel4 dbname="inmprodu.prod_nivel4" dbalias=".prod_nivel4" )
 column=(type=char(120) update=yes updatewhereclause=yes name=prod_foto_dir dbname="inmprodu.prod_foto_dir" dbalias=".prod_foto_dir" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=prod_g_financiero dbname="inmprodu.prod_g_financiero" dbalias=".prod_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=prod_empresa dbname="inmprodu.prod_empresa" dbalias=".prod_empresa" )
 column=(type=decimal(6) updatewhereclause=yes name=prod_existencia_total dbname="inmprodu.prod_existencia_total" dbalias=".prod_existencia_total" )
 column=(type=datetime updatewhereclause=yes name=prod_entrada_fecha dbname="inmprodu.prod_entrada_fecha" dbalias=".prod_entrada_fecha" )
 column=(type=char(25) updatewhereclause=yes name=marca dbname="marca" )
 column=(type=char(50) update=yes updatewhereclause=yes name=prod_nivel5 dbname="inmprodu.prod_nivel5" dbalias=".prod_nivel5" )
 column=(type=char(120) update=yes updatewhereclause=yes name=prod_foto_catalogo dbname="inmprodu.prod_foto_catalogo" dbalias=".prod_foto_catalogo" )
 column=(type=long updatewhereclause=yes name=foto_existe dbname="foto_existe" values="	1/	0" )
 column=(type=char(50) updatewhereclause=yes name=departamento dbname="departamento" )
 column=(type=char(65) updatewhereclause=yes name=tipo dbname="tipo" )
 column=(type=char(8000) updatewhereclause=yes name=taman dbname="taman" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_nivel1~") COLUMN(NAME=~"inmprodu.prod_nivel2~") COLUMN(NAME=~"inmprodu.prod_nivel3~") COLUMN(NAME=~"inmprodu.prod_nivel4~") COLUMN(NAME=~"inmprodu.prod_foto_dir~") COLUMN(NAME=~"inmprodu.prod_g_financiero~") COLUMN(NAME=~"inmprodu.prod_empresa~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COLUMN(NAME=~"inmprodu.prod_entrada_fecha~") COMPUTE(NAME=~"marca = (select amar_nombre_marca from cramarca where amar_g_financiero = inmprodu.prod_g_financiero and cramarca.amar_empresa = inmprodu.prod_empresa and cramarca.amar_num_marca = inmprodu.prod_marca )~") COLUMN(NAME=~"inmprodu.prod_nivel5~") COLUMN(NAME=~"inmprodu.prod_foto_catalogo~") COMPUTE(NAME=~"0 foto_existe~") COMPUTE(NAME=~"departamento = (select d.adiv_nombre_catalogo from cradivis d where d.adiv_g_financiero = inmprodu.prod_g_financiero and d.adiv_empresa = inmprodu.prod_empresa and d.adiv_codigo_div = inmprodu.prod_division )~") COMPUTE(NAME=~"tipo = rtrim((substring(ltrim(prod_descripcion),1,CHARINDEX(' ',ltrim(prod_descripcion)))))~") COMPUTE(NAME=~"taman = (select ltrim(replace(t.acta_descripcion,'/','-')) from cracltam t where t.acta_g_financiero = inmprodu.prod_g_financiero and t.acta_empresa = inmprodu.prod_empresa and t.acta_cod_clase_tam = inmprodu.prod_cod_clase_tam )~")WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"inmprodu.prod_status~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " update="inmprodu" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number))  sort="prod_descripcion A " )
