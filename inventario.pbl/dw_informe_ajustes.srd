 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"intmovim~" )  TABLE(NAME=~"indmovim~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"intmovim.tmov_secuencia~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"indmovim.dmov_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"indmovim.dmov_cantidad~") COLUMN(NAME=~"indmovim.dmov_costo~") COLUMN(NAME=~"intmovim.tmov_documento~") COLUMN(NAME=~"indmovim.dmov_modelo~") COLUMN(NAME=~"indmovim.dmov_bodega~") COLUMN(NAME=~"indmovim.dmov_costo_cif~") COLUMN(NAME=~"indmovim.dmov_costo_fob~") COLUMN(NAME=~"inmprodu.prod_producto_dos~") COLUMN(NAME=~"intmovim.tmov_terceros~") COLUMN(NAME=~"intmovim.tmov_comentario~")    JOIN (LEFT=~"indmovim.dmov_g_financiero~"    OP =~"=~"RIGHT=~"intmovim.tmov_g_financiero~" )    JOIN (LEFT=~"indmovim.dmov_empresa~"    OP =~"=~"RIGHT=~"intmovim.tmov_empresa~" )    JOIN (LEFT=~"indmovim.dmov_aplicacion~"    OP =~"=~"RIGHT=~"intmovim.tmov_aplicacion~" )    JOIN (LEFT=~"indmovim.dmov_tipo_transaccion~"    OP =~"=~"RIGHT=~"intmovim.tmov_tipo_transaccion~" )    JOIN (LEFT=~"indmovim.dmov_secuencia~"    OP =~"=~"RIGHT=~"intmovim.tmov_secuencia~" )    JOIN (LEFT=~"indmovim.dmov_anual~"    OP =~"=~"RIGHT=~"intmovim.tmov_anual~" )    JOIN (LEFT=~"indmovim.dmov_concepto~"    OP =~"=~"RIGHT=~"intmovim.tmov_concepto~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"indmovim.dmov_producto~" )WHERE(    EXP1 =~"intmovim.tmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_fecha~"   OP =~"<~"    EXP2 =~"dateadd(dd,1, :fecha2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"intmovim.tmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'AE'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = date)  ARG(NAME = ~"fecha2~" TYPE = date) " arguments=(("grupo", number),("empresa", number),("fecha1", date),("fecha2", date))  sort="tmov_secuencia A intmovim_tmov_fecha A inmprodu_prod_producto_dos A indmovim_dmov_bodega A " )
