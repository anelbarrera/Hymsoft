table(column=(type=char(3) updatewhereclause=yes name=cradivis_adiv_codigo_div dbname="cradivis.adiv_codigo_div" dbalias=".adiv_codigo_div" )
 column=(type=char(50) updatewhereclause=yes name=cradivis_adiv_nombre_div dbname="cradivis.adiv_nombre_div" dbalias=".adiv_nombre_div" )
 column=(type=char(5) updatewhereclause=yes name=cragrupo_agru_codigo_grupo dbname="cragrupo.agru_codigo_grupo" dbalias=".agru_codigo_grupo" )
 column=(type=char(50) updatewhereclause=yes name=cragrupo_agru_descripcion_grupo dbname="cragrupo.agru_descripcion_grupo" dbalias=".agru_descripcion_grupo" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_producto dbname="inmprodu.prod_producto" dbalias=".prod_producto" )
 column=(type=char(255) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" dbalias=".prod_descripcion" )
 column=(type=decimal(8) updatewhereclause=yes name=inmprodu_prod_costo_cif dbname="inmprodu.prod_costo_cif" dbalias=".prod_costo_cif" )
 column=(type=decimal(8) updatewhereclause=yes name=fraccion dbname="fraccion" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" dbalias="inamedid_a.medi_cantidad" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_existencia_total dbname="inmprodu.prod_existencia_total" dbalias=".prod_existencia_total" )
 column=(type=decimal(0) updatewhereclause=yes name=inamedid_medi_tipo_medida dbname="inamedid.medi_tipo_medida" dbalias="inamedid_a.medi_tipo_medida" )
 column=(type=decimal(3) updatewhereclause=yes name=entero dbname="entero" )
 column=(type=decimal(8) updatewhereclause=yes name=inmprodu_prod_costo_promedio dbname="inmprodu.prod_costo_promedio" dbalias=".prod_costo_promedio" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_producto_dos dbname="inmprodu.prod_producto_dos" dbalias=".prod_producto_dos" )
 column=(type=char(10) updatewhereclause=yes name=inamedid_medi_abre dbname="inamedid.medi_abre" dbalias="inamedid_a.medi_abre" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_peso dbname="inmprodu.prod_peso" dbalias=".prod_peso" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" dbalias=".prod_empaque" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_cubicaje dbname="inmprodu.prod_cubicaje" dbalias=".prod_cubicaje" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_existencia1 dbname="inmprodu.prod_existencia1" dbalias=".prod_existencia1" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_existencia2 dbname="inmprodu.prod_existencia2" dbalias=".prod_existencia2" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_existencia3 dbname="inmprodu.prod_existencia3" dbalias=".prod_existencia3" )
 column=(type=decimal(3) updatewhereclause=yes name=reserva dbname="reserva" )
 column=(type=decimal(3) updatewhereclause=yes name=disponible dbname="disponible" )
 column=(type=decimal(3) updatewhereclause=yes name=exis1 dbname="exis1" )
 column=(type=decimal(3) updatewhereclause=yes name=exis2 dbname="exis2" )
 column=(type=decimal(3) updatewhereclause=yes name=exis3 dbname="exis3" )
 column=(type=datetime updatewhereclause=yes name=inmprodu_prod_entrada_fecha dbname="inmprodu.prod_entrada_fecha" dbalias=".prod_entrada_fecha" )
 column=(type=long updatewhereclause=yes name=mes dbname="mes" )
 column=(type=char(11) updatewhereclause=yes name=inaparam_para_clave_costos dbname="inaparam.para_clave_costos" dbalias=".para_clave_costos" )
 column=(type=decimal(8) updatewhereclause=yes name=inmprodu_prod_costo_fob dbname="inmprodu.prod_costo_fob" dbalias=".prod_costo_fob" )
 column=(type=char(120) updatewhereclause=yes name=inmprodu_prod_foto_dir dbname="inmprodu.prod_foto_dir" dbalias=".prod_foto_dir" )
 column=(type=char(25) updatewhereclause=yes name=cramarca_amar_nombre_marca dbname="cramarca.amar_nombre_marca" dbalias=".amar_nombre_marca" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_empaque_um dbname="inmprodu.prod_empaque_um" dbalias=".prod_empaque_um" )
 column=(type=char(15) updatewhereclause=yes name=costo_promedio dbname="costo_promedio" )
 column=(type=char(15) updatewhereclause=yes name=costo_cif dbname="costo_cif" )
 column=(type=char(15) updatewhereclause=yes name=costo_fob dbname="costo_fob" )
 column=(type=char(15) updatewhereclause=yes name=valor_inv_promedio dbname="valor_inv_promedio" )
 column=(type=char(15) updatewhereclause=yes name=valor_inv_cif_letras dbname="valor_inv_cif_letras" )
 column=(type=char(15) updatewhereclause=yes name=valor_inv_fob_letras dbname="valor_inv_fob_letras" )
 column=(type=char(18) updatewhereclause=yes name=total_valor_letras dbname="total_valor_letras" )
 column=(type=char(18) updatewhereclause=yes name=total_ultimo_letras dbname="total_ultimo_letras" )
 column=(type=char(18) updatewhereclause=yes name=total_fob_letras dbname="total_fob_letras" )
 column=(type=long updatewhereclause=yes name=incluir dbname="incluir" )
 column=(type=long updatewhereclause=yes name=ver_existencia dbname="ver_existencia" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_medida dbname="inmprodu.prod_medida" dbalias=".prod_medida" )
 retrieve="   SELECT cradivis.adiv_codigo_div,   
         cradivis.adiv_nombre_div,   
         cragrupo.agru_codigo_grupo,   
         cragrupo.agru_descripcion_grupo,   
         inmprodu.prod_producto,   
         inmprodu.prod_descripcion,   
         inmprodu.prod_costo_cif,   
         inmprodu.prod_existencia_total - (convert(numeric(11,0),(inmprodu.prod_existencia_total/inamedid_a.medi_cantidad)) * inamedid_a.medi_cantidad) fraccion,   
         inamedid_a.medi_cantidad,   
         inmprodu.prod_existencia_total,   
         inamedid_a.medi_tipo_medida,   
         case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_existencia_total/inamedid_a.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_existencia_total/inamedid_a.medi_cantidad)) end entero,   
         inmprodu.prod_costo_promedio,   
         inmprodu.prod_producto_dos,   
         inamedid_a.medi_abre,   
         inmprodu.prod_peso,   
         inmprodu.prod_empaque,   
         inmprodu.prod_cubicaje,   
         inmprodu.prod_existencia1,   
         inmprodu.prod_existencia2,   
         inmprodu.prod_existencia3,   
         case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_reserva_total/inamedid_a.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_reserva_total/inamedid_a.medi_cantidad)) end reserva,   
         case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_existencia_total - prod_reserva_total /inamedid_a.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_existencia_total - prod_reserva_total /inamedid_a.medi_cantidad)) end disponible,   
         case medi_tipo_medida when 10 then convert(numeric(11,0),((inmprodu.prod_existencia1 - inmprodu.prod_reserva1) /inamedid_a.medi_cantidad)) else convert(numeric(11,3),((inmprodu.prod_existencia1 - inmprodu.prod_reserva1) /inamedid_a.medi_cantidad)) end exis1,   
         case medi_tipo_medida when 10 then convert(numeric(11,0),((inmprodu.prod_existencia2 - inmprodu.prod_reserva2) /inamedid_a.medi_cantidad)) else convert(numeric(11,3),((inmprodu.prod_existencia2 - inmprodu.prod_reserva2) /inamedid_a.medi_cantidad)) end exis2,   
         case medi_tipo_medida when 10 then convert(numeric(11,0),((inmprodu.prod_existencia3 - inmprodu.prod_reserva3 ) /inamedid_a.medi_cantidad)) else convert(numeric(11,3),((inmprodu.prod_existencia3 - inmprodu.prod_reserva3) /inamedid_a.medi_cantidad)) end exis3,   
         inmprodu.prod_entrada_fecha,   
         datediff(month, prod_entrada_fecha, getdate()) mes,   
         inaparam.para_clave_costos,   
         inmprodu.prod_costo_fob,   
         inmprodu.prod_foto_dir,
		cramarca.amar_nombre_marca,
		inmprodu.prod_empaque_um,
		costo_promedio = '               ',
		costo_cif = '               ',
		costo_fob = '               ',
		valor_inv_promedio = '               ',
		valor_inv_cif_letras = '               ',
		valor_inv_fob_letras = '               ',
		total_valor_letras = '                  ',
		total_ultimo_letras = '                  ',
		total_fob_letras = '                  ',
		1 incluir,
		1 ver_existencia,
		prod_medida
    FROM inmprodu LEFT OUTER JOIN cramarca ON inmprodu.prod_g_financiero = cramarca.amar_g_financiero AND inmprodu.prod_empresa = cramarca.amar_empresa AND inmprodu.prod_marca = cramarca.amar_num_marca  LEFT OUTER JOIN cradivis ON inmprodu.prod_g_financiero = cradivis.adiv_g_financiero AND inmprodu.prod_empresa = cradivis.adiv_empresa AND inmprodu.prod_division = cradivis.adiv_codigo_div LEFT OUTER JOIN cragrupo ON inmprodu.prod_g_financiero = cragrupo.agru_g_financiero AND inmprodu.prod_empresa = cragrupo.agru_empresa AND inmprodu.prod_grupo = cragrupo.agru_codigo_grupo AND inmprodu.prod_division = cragrupo.agru_codigo_div,   
         inamedid inamedid_a,   
         inaparam
   WHERE ( inamedid_a.medi_medida = inmprodu.prod_medida ) and  
         ( inmprodu.prod_g_financiero = inaparam.para_g_financiero ) and  
         ( inmprodu.prod_empresa = inaparam.para_empresa ) and 
         ( ( inmprodu.prod_g_financiero = :grupo ) AND  
         ( inmprodu.prod_empresa = :empresa ) AND  
         ( inmprodu.prod_status = 1 ) )    
" filter=" disponible > 0"arguments=(("grupo", number),("empresa", number))  sort="inmprodu_prod_descripcion A " )
