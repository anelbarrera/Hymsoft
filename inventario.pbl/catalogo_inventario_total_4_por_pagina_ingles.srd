table(column=(type=decimal(0) updatewhereclause=yes name=inmprodu_prod_g_financiero dbname="inmprodu.prod_g_financiero" dbalias=".prod_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=inmprodu_prod_empresa dbname="inmprodu.prod_empresa" dbalias=".prod_empresa" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_producto dbname="inmprodu.prod_producto" dbalias=".prod_producto" )
 column=(type=char(65) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" dbalias=".prod_descripcion" )
 column=(type=char(120) updatewhereclause=yes name=inmprodu_prod_foto_dir dbname="inmprodu.prod_foto_dir" dbalias=".prod_foto_dir" )
 column=(type=char(100) updatewhereclause=yes name=cramarca_amar_foto dbname="cramarca.amar_foto" dbalias=".amar_foto" )
 column=(type=char(25) updatewhereclause=yes name=cramarca_amar_nombre_marca dbname="cramarca.amar_nombre_marca" dbalias=".amar_nombre_marca" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" dbalias=".prod_empaque" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_cubicaje dbname="inmprodu.prod_cubicaje" dbalias=".prod_cubicaje" )
 column=(type=decimal(8) updatewhereclause=yes name=inmprodu_prod_costo_fob dbname="inmprodu.prod_costo_fob" dbalias=".prod_costo_fob" )
 column=(type=decimal(8) updatewhereclause=yes name=inmprodu_prod_costo_cif dbname="inmprodu.prod_costo_cif" dbalias=".prod_costo_cif" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_descripcion_dos dbname="inmprodu.prod_descripcion_dos" dbalias=".prod_descripcion_dos" )
 column=(type=char(255) updatewhereclause=yes name=inmprodu_prod_observacion dbname="inmprodu.prod_observacion" dbalias=".prod_observacion" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_existencia_total dbname="inmprodu.prod_existencia_total" dbalias=".prod_existencia_total" )
 column=(type=decimal(6) updatewhereclause=yes name=inmprodu_prod_reserva_total dbname="inmprodu.prod_reserva_total" dbalias=".prod_reserva_total" )
 column=(type=char(17) updatewhereclause=yes name=barra dbname="barra" )
