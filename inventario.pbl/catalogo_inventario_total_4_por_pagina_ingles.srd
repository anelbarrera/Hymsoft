 column=(type=char(100) updatewhereclause=yes name=cracolor_acol_nombre_color dbname="cracolor.acol_nombre_color" dbalias=".acol_nombre_color" )
 column=(type=long updatewhereclause=yes name=disponibles dbname="disponibles" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" dbalias="inamedid_a.medi_cantidad" )
 column=(type=decimal(0) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_sec dbname="inmprodu.prod_ultima_entrada_sec" dbalias=".prod_ultima_entrada_sec" )
 column=(type=char(10) updatewhereclause=yes name=precio dbname="precio" )
 column=(type=char(10) updatewhereclause=yes name=costo dbname="costo" )
 column=(type=decimal(4) updatewhereclause=yes name=precio_numero dbname="inmprodu.precio_numero" dbalias=".precio_numero" )
 column=(type=decimal(0) updatewhereclause=yes name=dentero dbname="dentero" )
 column=(type=decimal(0) updatewhereclause=yes name=total_entrada dbname="total_entrada" )
 column=(type=decimal(0) updatewhereclause=yes name=inmprodu_prod_tercero dbname="inmprodu.prod_tercero" dbalias=".prod_tercero" )
 column=(type=long updatewhereclause=yes name=incluir dbname="incluir" )
 column=(type=decimal(0) updatewhereclause=yes name=rentero dbname="rentero" )
 column=(type=decimal(6) updatewhereclause=yes name=prod_ultima_entrada_can dbname="prod_ultima_entrada_can" )
 column=(type=decimal(0) updatewhereclause=yes name=prod_ultima_entrada_can_2 dbname="prod_ultima_entrada_can_2" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_empaque_um dbname="inmprodu.prod_empaque_um" dbalias=".prod_empaque_um" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_precio_numero2 dbname="inmprodu.precio_numero2" dbalias=".precio_numero2" )
 column=(type=long updatewhereclause=yes name=ver_precio dbname="ver_precio" )
 column=(type=long updatewhereclause=yes name=ver_cantidad dbname="ver_cantidad" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_nivel1 dbname="inmprodu.prod_nivel1" dbalias=".prod_nivel1" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_nivel2 dbname="inmprodu.prod_nivel2" dbalias=".prod_nivel2" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_nivel3 dbname="inmprodu.prod_nivel3" dbalias=".prod_nivel3" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_nivel4 dbname="inmprodu.prod_nivel4" dbalias=".prod_nivel4" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_nivel5 dbname="inmprodu.prod_nivel5" dbalias=".prod_nivel5" )
 column=(type=char(120) updatewhereclause=yes name=inmprodu_prod_foto_catalogo dbname="inmprodu.prod_foto_catalogo" dbalias=".prod_foto_catalogo" )
 column=(type=char(30) updatewhereclause=yes name=talla dbname="talla" )
 column=(type=char(20) updatewhereclause=yes name=precio1 dbname="precio1" )
 column=(type=char(20) updatewhereclause=yes name=precio2 dbname="precio2" )
 column=(type=char(20) updatewhereclause=yes name=costo dbname="costo" )
 retrieve="    SELECT inmprodu.prod_g_financiero,   
         inmprodu.prod_empresa,  
		inmprodu.prod_producto,   
         inmprodu.prod_descripcion,    
         inmprodu.prod_foto_dir, 
         cramarca.amar_foto,
		cramarca.amar_nombre_marca,      
         inmprodu.prod_empaque,   
         inmprodu.prod_cubicaje,   
         inmprodu.prod_costo_fob,
         inmprodu.prod_costo_cif,   
         inmprodu.prod_descripcion_dos,   
         inmprodu.prod_observacion,        
         inmprodu.prod_existencia_total, 
		inmprodu.prod_reserva_total,  
         '*' + inmprodu.prod_barra +'*' barra,   
         inmprodu.prod_division, 
		cracolor.acol_nombre_color,  
         0 disponibles,  
         inamedid_a.medi_cantidad,   
         inmprodu.prod_ultima_entrada_sec,   
         '          ' precio,   
         '          ' costo,   
         inmprodu.prod_precio1 precio_numero ,
         convert(numeric(10, 0), ((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) /inamedid_a.medi_cantidad)) dentero,   
         total_entrada = convert(numeric(10, 0), ( inmprodu.prod_ultima_entrada_can /inamedid_a.medi_cantidad) * prod_costo_fob),   
         inmprodu.prod_tercero,   
         incluir=0,   
         convert(numeric(10, 0), (inmprodu.prod_reserva_total / inamedid_a.medi_cantidad)) rentero,   
         prod_ultima_entrada_can = ( SELECT sum(dmov_cantidad) FROM indmovim,  intmovim   WHERE ( indmovim.dmov_g_financiero = intmovim.tmov_g_financiero ) and   ( indmovim.dmov_empresa = intmovim.tmov_empresa ) and  ( indmovim.dmov_aplicacion = intmovim.tmov_aplicacion ) and  ( indmovim.dmov_tipo_transaccion = intmovim.tmov_tipo_transaccion ) and  ( indmovim.dmov_concepto = intmovim.tmov_concepto ) and  ( indmovim.dmov_secuencia = intmovim.tmov_secuencia ) and  ( indmovim.dmov_anual = intmovim.tmov_anual ) and  ( ( indmovim.dmov_g_financiero = inmprodu.prod_g_financiero ) AND ( indmovim.dmov_empresa = inmprodu.prod_empresa ) AND ( indmovim.dmov_aplicacion = 'IN' ) AND  ( indmovim.dmov_tipo_transaccion = 'EN' ) AND  ( indmovim.dmov_producto = inmprodu.prod_producto) )),   
         convert(numeric(10, 0), ( inmprodu.prod_ultima_entrada_can /inamedid_a.medi_cantidad)) prod_ultima_entrada_can_2,   
		inmprodu.prod_empaque_um ,
         inmprodu.prod_precio2 precio_numero2 ,
		ver_precio = 1,
		ver_cantidad = 1,
		prod_nivel1,
		prod_nivel2,
		prod_nivel3,
		prod_nivel4,
		prod_nivel5,
		inmprodu.prod_foto_catalogo,
		talla = (select max(t.acta_descripcion) from cracltam t where inmprodu.prod_cod_clase_tam = t.acta_cod_clase_tam and inmprodu.prod_empresa = t.acta_empresa and inmprodu.prod_g_financiero = t.acta_g_financiero),
		precio1 = '                    ',
		precio2 = '                    ',
		costo = '                    '
    FROM inmprodu ,
         cramarca,
         cracolor,   
         inamedid inamedid_a,   
         inamedid inamedid_b
   WHERE  ( cramarca.amar_g_financiero = inmprodu.prod_g_financiero ) and  
         ( cramarca.amar_empresa = inmprodu.prod_empresa ) and  
         ( cramarca.amar_num_marca = inmprodu.prod_marca ) and  
         ( inmprodu.prod_g_financiero = cracolor.acol_g_financiero ) and  
         ( inmprodu.prod_empresa = cracolor.acol_empresa ) and  
         ( inmprodu.prod_color = cracolor.acol_num_color ) and  
         ( inmprodu.prod_medida = inamedid_a.medi_medida ) and 
		( inmprodu.prod_empaque_um = inamedid_b.medi_medida ) and 
         ( ( inmprodu.prod_g_financiero = :grupo ) AND  
         ( inmprodu.prod_empresa = :empresa ) AND  
         ( inmprodu.prod_entrada_fecha >= :fecha_inicio ) AND  
         ( inmprodu.prod_entrada_fecha <= :fecha_final ) and
         (len (rtrim(inmprodu.prod_foto_dir))>0 ) and
		( round( (( inmprodu.prod_existencia_total - inmprodu.prod_reserva_total ) / inamedid_b.medi_cantidad ), 0) >= 1 ))
  

" arguments=(("grupo", number),("empresa", number),("fecha_inicio", date),("fecha_final", date))  sort="inmprodu_prod_producto A " )
