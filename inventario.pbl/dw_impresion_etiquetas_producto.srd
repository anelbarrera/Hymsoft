 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"inmprodu.prod_costo_fob~") COLUMN(NAME=~"inmprodu.prod_costo_cif~") COLUMN(NAME=~"inmprodu.prod_costo_promedio~") COLUMN(NAME=~"inmprodu.prod_producto_dos~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inamedid.medi_abre~") COLUMN(NAME=~"inmprodu.prod_cubicaje~") COLUMN(NAME=~"inmprodu.prod_peso~") COLUMN(NAME=~"inmprodu.prod_alto~") COLUMN(NAME=~"inmprodu.prod_ancho~") COLUMN(NAME=~"inmprodu.prod_largo~") COLUMN(NAME=~"inmprodu.prod_precio1~") COLUMN(NAME=~"inmprodu.prod_metros_cubicos~") COMPUTE(NAME=~"costo = '               '~") COLUMN(NAME=~"inmprodu.prod_producto~")    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"inmprodu.prod_producto~"   OP =~"=~"    EXP2 =~":producto~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"producto~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("producto", string)) )
