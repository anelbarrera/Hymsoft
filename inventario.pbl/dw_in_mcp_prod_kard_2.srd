 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medida_producto dbname="inamedid.medida_producto" dbalias="inamedid_b.medida_producto" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medida_producto_descripcion dbname="inamedid.medida_producto_descripcion" dbalias="inamedid_b.medida_producto_descripcion" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medida_empaque dbname="inamedid.medida_empaque" dbalias="inamedid_c.medida_empaque" )
 column=(type=long updatewhereclause=yes name=para_formato_decimal dbname="inaparam.para_formato_decimal" dbalias=".para_formato_decimal" initial="2" )
 column=(type=decimal(2) updatewhereclause=yes name=frac dbname="frac" )
 column=(type=char(100) updatewhereclause=yes name=tmov_nombre_tercero dbname="intmovim.tmov_nombre_tercero" dbalias=".tmov_nombre_tercero" )
