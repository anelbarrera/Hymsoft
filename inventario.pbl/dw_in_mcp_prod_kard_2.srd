 column=(type=char(8) updatewhereclause=yes name=intmovim_tmov_no_pedido dbname="intmovim.tmov_no_pedido" dbalias=".tmov_no_pedido" )
 column=(type=char(2) updatewhereclause=yes name=indmovim_dmov_aplicacion dbname="indmovim.dmov_aplicacion" dbalias=".dmov_aplicacion" )
 column=(type=decimal(6) updatewhereclause=yes name=prod_reserva_total dbname="inmprodu.prod_reserva_total" dbalias=".prod_reserva_total" )
 column=(type=char(120) updatewhereclause=yes name=inmprodu_prod_foto_dir dbname="inmprodu.prod_foto_dir" dbalias=".prod_foto_dir" )
 column=(type=decimal(0) updatewhereclause=yes name=dmov_anual dbname="indmovim.dmov_anual" dbalias=".dmov_anual" )
 column=(type=char(2) updatewhereclause=yes name=dmov_aplicacion dbname="indmovim.dmov_aplicacion" dbalias=".dmov_aplicacion" )
 column=(type=decimal(0) updatewhereclause=yes name=tmov_terceros dbname="intmovim.tmov_terceros" dbalias=".tmov_terceros" )
 column=(type=long updatewhereclause=yes name=user_especial dbname="user_especial" )
 column=(type=decimal(8) updatewhereclause=yes name=dmov_costo_fob dbname="indmovim.dmov_costo_fob" dbalias=".dmov_costo_fob" )
 column=(type=decimal(0) updatewhereclause=yes name=medi_tipo_medida dbname="inamedid.medi_tipo_medida" dbalias="inamedid_a.medi_tipo_medida" )
 column=(type=datetime updatewhereclause=yes name=tmov_fecha_registro dbname="intmovim.tmov_fecha_registro" dbalias=".tmov_fecha_registro" )
 column=(type=char(1) updatewhereclause=yes name=tmov_tipo_movimiento dbname="intmovim.tmov_tipo_movimiento" dbalias=".tmov_tipo_movimiento" )
 column=(type=decimal(8) updatewhereclause=yes name=dmov_costo_promedio dbname="indmovim.dmov_costo_promedio" dbalias=".dmov_costo_promedio" )
 column=(type=char(3) updatewhereclause=yes name=dmov_concepto dbname="indmovim.dmov_concepto" dbalias=".dmov_concepto" )
 column=(type=datetime updatewhereclause=yes name=dmov_fecha_registro dbname="indmovim.dmov_fecha_registro" dbalias=".dmov_fecha_registro" )
 retrieve="  SELECT indmovim.dmov_secuencia,   
         indmovim.dmov_documento,   
         indmovim.dmov_bodega,   
         indmovim.dmov_producto,   
         indmovim.dmov_cantidad,   
         indmovim.dmov_cant1,   
         indmovim.dmov_unidad_medida,   
         indmovim.dmov_costo,   
         indmovim.dmov_precio,   
         indmovim.dmov_costo_cif,   
         indmovim.dmov_ubicacion_destino,   
         indmovim.dmov_bodega_destino,   
         indmovim.dmov_tipo_transaccion,   
         intmovim.tmov_fecha,   
         inamedid_a.medi_descripcion,   
         inmprodu.prod_descripcion,   
         inmprodu.prod_costo_cif,   
         intmovim.tmov_tipo,   
         inamedid_a.medi_cantidad,   
         inmprodu.prod_medida,   
         dgmterce.terc_descripcion,   
         inamedid_b.medi_cantidad,   
         inamedid_b.medi_descripcion,   
         inmprodu.prod_empaque,   
         inmprodu.prod_empaque_descripcion,   
         inamedid_c.medi_descripcion,   
         intmovim.tmov_tipo_transaccion,   
         indmovim.dmov_ubicacion,   
         0 c2,   
         inmprodu.prod_medida medida,   
         dgmterce.terc_descripcion tercero,   
         (indmovim.dmov_cantidad*inamedid_a.medi_cantidad+isnull(indmovim.dmov_cant1,0)) cantidad_piezas,   
         inamedid_b.medi_cantidad medida_producto,   
         inamedid_b.medi_descripcion medida_producto_descripcion,   
         inamedid_c.medi_descripcion medida_empaque,   
         inaparam.para_formato_decimal,
			00.00 frac,
			intmovim.tmov_nombre_tercero,
         inmprodu.prod_definicion,
			intmovim.tmov_comentario,
	      inamedid_a.medi_abre medi_abre_a,
			tmov_no_pedido,
			dmov_aplicacion,
			prod_reserva_total,
			prod_foto_dir,
			indmovim.dmov_anual,
		   indmovim.dmov_aplicacion,
     		intmovim.tmov_terceros,
			0 user_especial,
			indmovim.dmov_costo_fob,
			inamedid_a.medi_tipo_medida,
			intmovim.tmov_fecha_registro,
			intmovim.tmov_tipo_movimiento,
			indmovim.dmov_costo_promedio,
			indmovim.dmov_concepto,
			indmovim.dmov_fecha_registro
    FROM indmovim,   
         intmovim left join dgmterce on  ( dgmterce.terc_tercero = intmovim.tmov_terceros),      
         inamedid inamedid_a,   
         inmprodu,            
         inamedid inamedid_b,   
         inamedid inamedid_c,   
         inaparam  
   WHERE ( indmovim.dmov_g_financiero = intmovim.tmov_g_financiero ) and  
         ( intmovim.tmov_empresa = indmovim.dmov_empresa ) and  
         ( indmovim.dmov_aplicacion = intmovim.tmov_aplicacion ) and  
         ( intmovim.tmov_tipo_transaccion = indmovim.dmov_tipo_transaccion ) and  
         ( intmovim.tmov_concepto = indmovim.dmov_concepto) and  
         ( indmovim.dmov_secuencia = intmovim.tmov_secuencia ) and  
         ( indmovim.dmov_anual = intmovim.tmov_anual ) and  
         ( inamedid_a.medi_medida = indmovim.dmov_unidad_medida ) and  
         ( indmovim.dmov_g_financiero = inmprodu.prod_g_financiero ) and  
         ( inmprodu.prod_empresa = indmovim.dmov_empresa ) and  
         ( indmovim.dmov_producto = inmprodu.prod_producto ) and  
         ( inmprodu.prod_medida = inamedid_b.medi_medida ) and  
         ( inmprodu.prod_medida = inamedid_c.medi_medida ) and  
         ( inaparam.para_g_financiero = indmovim.dmov_g_financiero ) and  
         ( inaparam.para_empresa = indmovim.dmov_empresa ) and  
         ( ( indmovim.dmov_g_financiero = :grupo ) AND  
         ( indmovim.dmov_empresa = :empresa ) AND  
         ( indmovim.dmov_producto = :producto_k ) AND  
         ( intmovim.tmov_fecha >= :fecha_ini ) AND  
         ( intmovim.tmov_fecha <= :fecha_fin ) )   
ORDER BY indmovim.dmov_producto ASC,   
         intmovim.tmov_fecha ASC   
" arguments=(("grupo", number),("empresa", number),("producto_k", string),("fecha_ini", datetime),("fecha_fin", datetime))  sort="intmovim_tmov_fecha A tmov_fecha_registro A dmov_fecha_registro A " )
