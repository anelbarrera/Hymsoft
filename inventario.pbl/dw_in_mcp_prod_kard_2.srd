 column=(type=char(2) updatewhereclause=yes name=inmprodu_medida dbname="inmprodu.medida" dbalias=".medida" initial="empty" values="Ninguna	0/Medida Lineal	1/Medida Cuadrada	2/Medida de Volumenes	3/Otras Medidas	4/Medidas de Peso	5/Medidas Electricas	6/Medidas de Presión	7/Factores de Conversión	8/Unidades	10/" )
 column=(type=char(60) updatewhereclause=yes name=tercero dbname="dgmterce.tercero" dbalias=".tercero" initial="spaces" )
