 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"notascr_encab~" ) COLUMN(NAME=~"notascr_encab.g_financiero~") COLUMN(NAME=~"notascr_encab.empresa~") COLUMN(NAME=~"notascr_encab.documento~") COLUMN(NAME=~"notascr_encab.ann~") COLUMN(NAME=~"notascr_encab.fecha~") COLUMN(NAME=~"notascr_encab.proveedor~") COLUMN(NAME=~"notascr_encab.comentario~") COLUMN(NAME=~"notascr_encab.estado~") COLUMN(NAME=~"notascr_encab.usuario~") COLUMN(NAME=~"notascr_encab.factura~") COLUMN(NAME=~"notascr_encab.tipo~")WHERE(    EXP1 =~"notascr_encab.g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"notascr_encab.empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"notascr_encab.documento~"   OP =~"=~"    EXP2 =~":documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"notascr_encab.ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"documento~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="notascr_encab" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("documento", string),("ann", number)) )
