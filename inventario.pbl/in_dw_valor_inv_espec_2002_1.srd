table(column=(type=decimal(0) updatewhereclause=yes name=dmov_secuencia dbname="indmovim.dmov_secuencia" dbalias=".dmov_secuencia" initial="0" )
 column=(type=char(18) updatewhereclause=yes name=dmov_documento dbname="indmovim.dmov_documento" dbalias=".dmov_documento" )
 column=(type=char(5) updatewhereclause=yes name=dmov_bodega dbname="indmovim.dmov_bodega" dbalias=".dmov_bodega" )
 column=(type=char(20) updatewhereclause=yes name=dmov_producto dbname="indmovim.dmov_producto" dbalias=".dmov_producto" )
 column=(type=decimal(6) updatewhereclause=yes name=dmov_cantidad dbname="indmovim.dmov_cantidad" dbalias=".dmov_cantidad" initial="0" )
 column=(type=decimal(0) updatewhereclause=yes name=dmov_cant1 dbname="indmovim.dmov_cant1" dbalias=".dmov_cant1" initial="0" )
 column=(type=char(2) updatewhereclause=yes name=dmov_unidad_medida dbname="indmovim.dmov_unidad_medida" dbalias=".dmov_unidad_medida" )
 column=(type=decimal(8) updatewhereclause=yes name=dmov_costo dbname="indmovim.dmov_costo" dbalias=".dmov_costo" initial="0" )
 column=(type=decimal(8) updatewhereclause=yes name=dmov_precio dbname="indmovim.dmov_precio" dbalias=".dmov_precio" initial="0" )
 column=(type=decimal(8) updatewhereclause=yes name=dmov_costo_cif dbname="indmovim.dmov_costo_cif" dbalias=".dmov_costo_cif" initial="0" )
 column=(type=char(5) updatewhereclause=yes name=dmov_ubicacion_destino dbname="indmovim.dmov_ubicacion_destino" dbalias=".dmov_ubicacion_destino" )
 column=(type=char(5) updatewhereclause=yes name=dmov_bodega_destino dbname="indmovim.dmov_bodega_destino" dbalias=".dmov_bodega_destino" )
 column=(type=char(2) updatewhereclause=yes name=dmov_tipo_transaccion dbname="indmovim.dmov_tipo_transaccion" dbalias=".dmov_tipo_transaccion" )
 column=(type=datetime updatewhereclause=yes name=intmovim_tmov_fecha dbname="intmovim.tmov_fecha" dbalias=".tmov_fecha" initial="set to gf_fecha_serv" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medi_descripcion dbname="inamedid.medi_descripcion" dbalias="inamedid_a.medi_descripcion" )
 column=(type=char(65) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" dbalias=".prod_descripcion" initial="empty" )
 column=(type=decimal(8) updatewhereclause=yes name=inmprodu_prod_costo_cif dbname="inmprodu.prod_costo_cif" dbalias=".prod_costo_cif" initial="0.00" )
 column=(type=char(1) updatewhereclause=yes name=intmovim_tmov_tipo dbname="intmovim.tmov_tipo" dbalias=".tmov_tipo" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" dbalias="inamedid_a.medi_cantidad" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_medida dbname="inmprodu.prod_medida" dbalias=".prod_medida" initial="empty" values="Ninguna	0/Medida Lineal	1/Medida Cuadrada	2/Medida de Volumenes	3/Otras Medidas	4/Medidas de Peso	5/Medidas Electricas	6/Medidas de Presión	7/Factores de Conversión	8/Unidades	10/" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" initial="spaces" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" dbalias="inamedid_b.medi_cantidad" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medi_descripcion dbname="inamedid.medi_descripcion" dbalias="inamedid_b.medi_descripcion" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" dbalias=".prod_empaque" initial="0" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_empaque_descripcion dbname="inmprodu.prod_empaque_descripcion" dbalias=".prod_empaque_descripcion" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medi_descripcion dbname="inamedid.medi_descripcion" dbalias="inamedid_c.medi_descripcion" )
 column=(type=char(2) updatewhereclause=yes name=intmovim_tmov_tipo_transaccion dbname="intmovim.tmov_tipo_transaccion" dbalias=".tmov_tipo_transaccion" )
 column=(type=char(5) updatewhereclause=yes name=dmov_ubicacion dbname="indmovim.dmov_ubicacion" dbalias=".dmov_ubicacion" )
 column=(type=decimal(6) updatewhereclause=yes name=cc2 dbname="c2" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_medida dbname="inmprodu.medida" dbalias=".medida" initial="empty" values="Ninguna	0/Medida Lineal	1/Medida Cuadrada	2/Medida de Volumenes	3/Otras Medidas	4/Medidas de Peso	5/Medidas Electricas	6/Medidas de Presión	7/Factores de Conversión	8/Unidades	10/" )
 column=(type=char(60) updatewhereclause=yes name=tercero dbname="dgmterce.tercero" dbalias=".tercero" initial="spaces" )
 column=(type=decimal(14) updatewhereclause=yes name=ccantidad_piezas dbname="cantidad_piezas" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medida_producto dbname="inamedid.medida_producto" dbalias="inamedid_b.medida_producto" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medida_producto_descripcion dbname="inamedid.medida_producto_descripcion" dbalias="inamedid_b.medida_producto_descripcion" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medida_empaque dbname="inamedid.medida_empaque" dbalias="inamedid_c.medida_empaque" )
 column=(type=long updatewhereclause=yes name=para_formato_decimal dbname="inaparam.para_formato_decimal" dbalias=".para_formato_decimal" initial="2" )
 column=(type=decimal(2) updatewhereclause=yes name=frac dbname="frac" )
 column=(type=char(100) updatewhereclause=yes name=tmov_nombre_tercero dbname="intmovim.tmov_nombre_tercero" dbalias=".tmov_nombre_tercero" )
 column=(type=ulong updatewhereclause=yes name=inmprodu_prod_definicion dbname="inmprodu.prod_definicion" dbalias=".prod_definicion" )
 column=(type=char(200) updatewhereclause=yes name=intmovim_tmov_comentario dbname="intmovim.tmov_comentario" dbalias=".tmov_comentario" )
 column=(type=char(10) updatewhereclause=yes name=inamedid_medi_abre_a dbname="inamedid.medi_abre_a" dbalias="inamedid_a.medi_abre_a" )
 column=(type=char(2) updatewhereclause=yes name=intmovim_tmov_aplicacion dbname="intmovim.tmov_aplicacion" dbalias=".tmov_aplicacion" )
 column=(type=decimal(8) updatewhereclause=yes name=dmov_medi_cantidad dbname="inamedid.dmov_medi_cantidad" dbalias="inamedid_a.dmov_medi_cantidad" )
 retrieve="SELECT indmovim.dmov_secuencia,   
		indmovim.dmov_documento,   
		indmovim.dmov_bodega,   
		indmovim.dmov_producto,   
		indmovim.dmov_cantidad,   
		indmovim.dmov_cant1,   
		indmovim.dmov_unidad_medida,   
		indmovim.dmov_costo,   
		indmovim.dmov_precio,   
		indmovim.dmov_costo_cif,   
		indmovim.dmov_ubicacion_destino,   
		indmovim.dmov_bodega_destino,   
		indmovim.dmov_tipo_transaccion,   
		intmovim.tmov_fecha,   
		inamedid_a.medi_descripcion,   
		inmprodu.prod_descripcion,   
		inmprodu.prod_costo_cif,   
		intmovim.tmov_tipo,   
		inamedid_a.medi_cantidad,   
		inmprodu.prod_medida,   
		dgmterce.terc_descripcion,   
		inamedid_b.medi_cantidad,   
		inamedid_b.medi_descripcion,   
		inmprodu.prod_empaque,   
		inmprodu.prod_empaque_descripcion,   
		inamedid_c.medi_descripcion,   
		intmovim.tmov_tipo_transaccion,   
		indmovim.dmov_ubicacion,   
		00.000000 c2,   
		inmprodu.prod_medida medida,   
		dgmterce.terc_descripcion tercero,   
		(indmovim.dmov_cantidad*inamedid_a.medi_cantidad+isnull(indmovim.dmov_cant1,0)) cantidad_piezas,   
		inamedid_b.medi_cantidad medida_producto,
		inamedid_b.medi_descripcion medida_producto_descripcion,   
		inamedid_c.medi_descripcion medida_empaque,   
		inaparam.para_formato_decimal,   
		00.00 frac,  
		intmovim.tmov_nombre_tercero,
      inmprodu.prod_definicion,
		tmov_comentario,
      inamedid_a.medi_abre medi_abre_a,tmov_aplicacion,
		inamedid_a.medi_cantidad dmov_medi_cantidad
 FROM indmovim,   
		intmovim,   
		inamedid inamedid_a,   
		inmprodu,   
		dgmterce,   
		inamedid inamedid_b,   
		inamedid inamedid_c,   
		inaparam  
WHERE ( dgmterce.terc_tercero = intmovim.tmov_terceros) and  
		( indmovim.dmov_g_financiero = intmovim.tmov_g_financiero ) and  
		( intmovim.tmov_empresa = indmovim.dmov_empresa ) and  
		( indmovim.dmov_aplicacion = intmovim.tmov_aplicacion ) and  
		( intmovim.tmov_tipo_transaccion = indmovim.dmov_tipo_transaccion ) and  
      ( intmovim.tmov_concepto  = indmovim.dmov_concepto  ) and  
		( indmovim.dmov_secuencia = intmovim.tmov_secuencia ) and  
		( indmovim.dmov_anual = intmovim.tmov_anual ) and  
		( inamedid_a.medi_medida = indmovim.dmov_unidad_medida ) and  
		( indmovim.dmov_g_financiero = inmprodu.prod_g_financiero ) and  
		( inmprodu.prod_empresa = indmovim.dmov_empresa ) and  
		( indmovim.dmov_producto = inmprodu.prod_producto ) and  
		( inmprodu.prod_medida = inamedid_b.medi_medida ) and  
		( inmprodu.prod_medida = inamedid_c.medi_medida ) and  
		( inaparam.para_g_financiero = indmovim.dmov_g_financiero ) and  
		( inaparam.para_empresa = indmovim.dmov_empresa ) and  
		( ( indmovim.dmov_g_financiero = :grupo ) AND  
		( indmovim.dmov_empresa = :empresa ) AND  
		( indmovim.dmov_producto = :producto_k ) AND  
		( intmovim.tmov_fecha >= :fecha_ini ) AND  
		( intmovim.tmov_fecha <= :fecha_fin ) )   
ORDER BY indmovim.dmov_producto ASC,   
		intmovim.tmov_fecha ASC" arguments=(("grupo", number),("empresa", number),("producto_k", string),("fecha_ini", datetime),("fecha_fin", datetime))  sort="dmov_producto A intmovim_tmov_fecha A dmov_tipo_transaccion A dmov_secuencia A dmov_costo D " )
