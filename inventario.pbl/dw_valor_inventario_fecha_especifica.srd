table(column=(type=char(200) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" initial="empty" )
 column=(type=char(30) updatewhereclause=yes name=medi_descripcion dbname="inamedid.medi_descripcion" )
 column=(type=decimal(8) updatewhereclause=yes name=medi_cantidad dbname="inamedid.medi_cantidad" )
 column=(type=char(20) updatewhereclause=yes name=prod_producto dbname="inmprodu.prod_producto" initial="empty" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_producto_dos dbname="prod_producto_dos" )
 column=(type=char(1) updatewhereclause=yes name=c_compute1 dbname="c_compute1" )
 column=(type=char(1) updatewhereclause=yes name=c_compute2 dbname="c_compute2" )
 column=(type=char(1) updatewhereclause=yes name=c_compute3 dbname="c_compute3" )
 column=(type=char(1) updatewhereclause=yes name=c_compute4 dbname="c_compute4" )
 column=(type=char(1) updatewhereclause=yes name=c_compute5 dbname="c_compute5" )
 column=(type=char(1) updatewhereclause=yes name=c_descripcion1 dbname="c_descripcion1" )
 column=(type=char(1) updatewhereclause=yes name=c_descripcion2 dbname="c_descripcion2" )
 column=(type=char(1) updatewhereclause=yes name=c_descripcion3 dbname="c_descripcion3" )
 column=(type=char(1) updatewhereclause=yes name=c_descripcion4 dbname="c_descripcion4" )
 column=(type=char(1) updatewhereclause=yes name=c_descripcion5 dbname="c_descripcion5" )
 column=(type=decimal(6) updatewhereclause=yes name=inhprome_prom_existencia dbname="inhprome.prom_existencia" )
 column=(type=decimal(8) updatewhereclause=yes name=inhprome_prom_costo_promedio dbname="inhprome.prom_costo_promedio" )
 column=(type=long updatewhereclause=yes name=inmprodu_prod_definicion dbname="inmprodu.prod_definicion" )
 column=(type=decimal(0) updatewhereclause=yes name=entero dbname="entero" )
 column=(type=decimal(14) updatewhereclause=yes name=fraccion dbname="fraccion" )
 column=(type=decimal(6) updatewhereclause=yes name=inhprome_prom_fraccion dbname="inhprome.prom_fraccion" )
 column=(type=decimal(6) updatewhereclause=yes name=inhprome_prom_cant_medida dbname="inhprome.prom_cant_medida" )
 column=(type=long updatewhereclause=yes name=incluir dbname="incluir" )
 retrieve="  SELECT inmprodu.prod_descripcion,   
         inamedid.medi_descripcion,   
         inamedid.medi_cantidad,   
         inmprodu.prod_producto,  
         case when inmprodu.prod_producto_dos = null then inmprodu.prod_producto else inmprodu.prod_producto_dos end prod_producto_dos, 
         c_compute1 =~"~",   
         c_compute2 = ~"~",   
         c_compute3 = ~"~",   
         c_compute4 = ~"~",   
         c_compute5 = ~"~",   
         c_descripcion1 = ~"~",   
         c_descripcion2 = ~"~",   
         c_descripcion3 = ~"~",   
         c_descripcion4 = ~"~",   
         c_descripcion5 = ~"~",   
         inhprome.prom_existencia,   
         inhprome.prom_costo_promedio,   
         inmprodu.prod_definicion,
			FLOOR(inhprome.prom_existencia) entero ,
			ROUND((inhprome.prom_existencia - FLOOR(inhprome.prom_existencia)) * inamedid.medi_cantidad,0) fraccion,
         inhprome.prom_fraccion,
         inhprome.prom_cant_medida ,
		incluir = 1
    FROM inmprodu,   
         inamedid,  
         cradivis,   
         cragrupo,   
         cramarca,   
         inhprome  
   WHERE ( cradivis.adiv_g_financiero = inmprodu.prod_g_financiero) and  
         ( cradivis.adiv_empresa = inmprodu.prod_empresa) and  
         ( cradivis.adiv_codigo_div = inmprodu.prod_division) and  
         ( cramarca.amar_g_financiero = inmprodu.prod_g_financiero) and  
         ( cramarca.amar_empresa = inmprodu.prod_empresa) and  
         ( cramarca.amar_num_marca = inmprodu.prod_marca) and  
         ( cragrupo.agru_g_financiero = inmprodu.prod_g_financiero) and  
         ( cragrupo.agru_empresa = inmprodu.prod_empresa) and  
         ( cragrupo.agru_codigo_div = inmprodu.prod_division) and  
         ( cragrupo.agru_codigo_grupo = inmprodu.prod_grupo) and  
         ( inamedid.medi_medida = inmprodu.prod_medida ) and  
         ( inhprome.prom_g_financiero = inmprodu.prod_g_financiero ) and  
         ( inhprome.prom_empresa = inmprodu.prod_empresa ) and  
         ( inhprome.prom_producto = inmprodu.prod_producto ) and
         ( inhprome.prom_g_financiero = :grupo ) and  
         ( inhprome.prom_empresa = :empresa ) and  
		( inhprome.prom_maquina = :maquina)
" arguments=(("grupo", number),("empresa", number),("maquina", string))  sort="inmprodu_prod_descripcion A prod_producto A c_descripcion1 A c_descripcion2 A c_descripcion3 A c_descripcion4 A c_descripcion5 A " )
