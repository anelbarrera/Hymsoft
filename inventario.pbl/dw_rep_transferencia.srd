 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"indtranfer~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"intranfer~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"dgmsubse~" ) COLUMN(NAME=~"indtranfer.dmov_linea~") COLUMN(NAME=~"indtranfer.dmov_g_financiero~") COLUMN(NAME=~"indtranfer.dmov_empresa~") COLUMN(NAME=~"indtranfer.dmov_aplicacion~") COLUMN(NAME=~"indtranfer.dmov_tipo_transaccion~") COLUMN(NAME=~"indtranfer.dmov_secuencia~") COLUMN(NAME=~"indtranfer.dmov_documento~") COLUMN(NAME=~"indtranfer.dmov_bodega~") COLUMN(NAME=~"indtranfer.dmov_ubicacion~") COLUMN(NAME=~"indtranfer.dmov_producto~") COLUMN(NAME=~"indtranfer.dmov_cantidad~") COLUMN(NAME=~"indtranfer.dmov_cant1~") COLUMN(NAME=~"indtranfer.dmov_unidad_medida~") COLUMN(NAME=~"indtranfer.dmov_costo~") COLUMN(NAME=~"indtranfer.dmov_precio~") COLUMN(NAME=~"indtranfer.dmov_cubicaje~") COLUMN(NAME=~"indtranfer.dmov_peso~") COLUMN(NAME=~"indtranfer.dmov_bulto~") COLUMN(NAME=~"indtranfer.dmov_costo_cif~") COLUMN(NAME=~"indtranfer.dmov_cargos~") COLUMN(NAME=~"indtranfer.dmov_precio_ent~") COLUMN(NAME=~"indtranfer.dmov_id~") COLUMN(NAME=~"indtranfer.dmov_bodega_destino~") COLUMN(NAME=~"indtranfer.dmov_ubicacion_destino~") COLUMN(NAME=~"indtranfer.dmov_anual~") COLUMN(NAME=~"indtranfer.dmov_fabricante~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inamedid.medi_descripcion~") COLUMN(NAME=~"intranfer.tmov_fecha~") COLUMN(NAME=~"intranfer.tmov_tipo_costo~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"intranfer.tmov_total_cargos~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"intranfer.tmov_terceros~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"inmprodu.prod_definicion~") COLUMN(NAME=~"indtranfer.dmov_costo_fob~") COLUMN(NAME=~"inmprodu.prod_medida~") COLUMN(NAME=~"intranfer.tmov_comentario~") COLUMN(NAME=~"inamedid.medi_tipo_medida~") COLUMN(NAME=~"indtranfer.dmov_producto_destino~") COLUMN(NAME=~"indtranfer.dmov_modelo~") COLUMN(NAME=~"intranfer.tmov_id~") COMPUTE(NAME=~"bultos = round(dmov_cantidad / prod_empaque,2)~")    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"intranfer.tmov_terceros~"    OUTER2 =~"intranfer.tmov_terceros~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"indtranfer.dmov_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"indtranfer.dmov_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"indtranfer.dmov_producto~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"indtranfer.dmov_unidad_medida~" )    JOIN (LEFT=~"dgmsubse.subs_g_financiero~"    OP =~"=~"RIGHT=~"intranfer.tmov_g_financiero~" )    JOIN (LEFT=~"dgmsubse.subs_empresa~"    OP =~"=~"RIGHT=~"intranfer.tmov_empresa~" )    JOIN (LEFT=~"dgmsubse.subs_transaccion~"    OP =~"=~"RIGHT=~"intranfer.tmov_tipo_transaccion~" )    JOIN (LEFT=~"dgmsubse.subs_sub_trans~"    OP =~"=~"RIGHT=~"intranfer.tmov_concepto~" )    JOIN (LEFT=~"intranfer.tmov_g_financiero~"    OP =~"=~"RIGHT=~"indtranfer.dmov_g_financiero~" )    JOIN (LEFT=~"intranfer.tmov_empresa~"    OP =~"=~"RIGHT=~"indtranfer.dmov_empresa~" )    JOIN (LEFT=~"intranfer.tmov_tipo_transaccion~"    OP =~"=~"RIGHT=~"indtranfer.dmov_tipo_transaccion~" )    JOIN (LEFT=~"intranfer.tmov_secuencia~"    OP =~"=~"RIGHT=~"indtranfer.dmov_secuencia~" )    JOIN (LEFT=~"intranfer.tmov_concepto~"    OP =~"=~"RIGHT=~"indtranfer.dmov_concepto~" )    JOIN (LEFT=~"intranfer.tmov_anual~"    OP =~"=~"RIGHT=~"indtranfer.dmov_anual~" )WHERE(    EXP1 =~"intranfer.tmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intranfer.tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intranfer.tmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intranfer.tmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'TR'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intranfer.tmov_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intranfer.tmov_anual~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number)) )
