//objectcomments Para la Mascara de las Cuentas Contables
global type gf_dg_mascara_de_cuentas from function_object
end type

forward prototypes
global function string gf_dg_mascara_de_cuentas ()
end prototypes

global function string gf_dg_mascara_de_cuentas ();dataStore	lds_mascaras_cuentas
long			ll_lineas
string		ls_cadena

// CREACIÓN DEL DATASTORE DE MÁSCARAS DE CUENTAS
lds_mascaras_cuentas = create ds_dg_import_file
lds_mascaras_cuentas.DataObject = "dw_dg_man_niveles"

lds_mascaras_cuentas.SetTransObject(sqlca)
ll_lineas=lds_mascaras_cuentas.Retrieve(str.g_financiero,str.empresa)

If ll_lineas < 1 Then
	mensaje("Información", "Por Favor, Antes de Ejecutar Esta Opción Proceda " + &
				"a Confeccionar la Máscara de las Cuentas.", "Máscara: " + &
				"Formato que se Crea en la Ventana de Niveles y Máscara de Cuentas " + &
				"Ubicada en la Opción de Manejo de Cuentas en Parámetros" ) 	
	Return("")
End If

lds_mascaras_cuentas.Setsort("nive_no_nivel A")
lds_mascaras_cuentas.Sort()

ls_cadena = lds_mascaras_cuentas.getitemstring(lds_mascaras_cuentas.Rowcount(),"nive_mascara")

ls_cadena = Replace(ls_cadena, 1, 3, "XXX")

destroy lds_mascaras_cuentas

return(ls_cadena)

end function

