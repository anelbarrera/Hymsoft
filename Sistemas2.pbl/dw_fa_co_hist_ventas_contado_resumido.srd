release 7;
datawindow(units=2 timer_interval=60000 color=79741120 processing=0 HTMLDW=no print.documentname="" print.orientation = 2 print.margin.left = 250 print.margin.right = 250 print.margin.top = 250 print.margin.bottom = 250 print.paper.source = 0 print.paper.size = 1 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=187 color="536870912" )
summary(height=197 color="-1" )
footer(height=0 color="-1" )
detail(height=166 color="-1" )
table(column=(type=char(8) updatewhereclause=yes name=fact_no_pedido dbname="fatdiari.fact_no_pedido" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_factura dbname="fatdiari.fact_no_factura" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fatdiari.fact_ann" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_cliente dbname="fatdiari.fact_cliente" )
 column=(type=char(20) updatewhereclause=yes name=fact_ruc_cliente dbname="fatdiari.fact_ruc_cliente" )
 column=(type=char(2) updatewhereclause=yes name=fact_condicion_pago dbname="fatdiari.fact_condicion_pago" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_tipo_venta dbname="fatdiari.fact_tipo_venta" values="CONTADO	CO/CRÉDITO	CR/C.O.D	CD/" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fatdiari.fact_fecha" initial="today" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_g_financiero dbname="fatdiari.fact_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_empresa dbname="fatdiari.fact_empresa" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_gastos_total dbname="fatdiari.fact_gastos_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_fact_total dbname="fatdiari.fact_monto_fact_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_final dbname="fatdiari.fact_monto_final" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fatdiari.fact_a_nombre" )
 column=(type=long updatewhereclause=yes name=gastos_fac dbname="gastos_fac" )
 column=(type=long updatewhereclause=yes name=desc_fac dbname="desc_fac" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_tipo_venta~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COMPUTE(NAME=~"0 gastos_fac~") COMPUTE(NAME=~"0 desc_fac~")WHERE(    EXP1 =~"( ( fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa ) )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="fact_a_nombre A long(fact_no_factura) A fact_no_pedido A fact_ann A " )
