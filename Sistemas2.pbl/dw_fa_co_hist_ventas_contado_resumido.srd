venta_cli+t_gastos_cli - t_desc_clie"border="5" color="8388608" x="6833" y="230" height="145" width="781" format="$##,###,##0.00"  name=t_monto_final_clie  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
