compute(band=trailer.1 alignment="1" expression=" sum(  If ( IsNull (fact_gastos_total  ) ,0, fact_gastos_total )  *  operando for group 1DISTINCT )   "border="5" color="8388608" x="5395" y="219" height="145" width="833" format="$##,###,##0.00"  name=t_gastos_cli  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
