 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crdconfi~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"crtconfi~" )  TABLE(NAME=~"inmbodeg~" )  TABLE(NAME=~"crmparam~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_a~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_b~" ) COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"crdconfi.dcof_num_conf_oc~") COLUMN(NAME=~"crdconfi.dcof_anno_oc~") COLUMN(NAME=~"crtconfi.tcof_fecha_conf_oc~") COLUMN(NAME=~"crdconfi.dcof_cantidad_total~") COLUMN(NAME=~"inmbodeg.mbod_cant_confirma~") COLUMN(NAME=~"inmbodeg.mbod_reserva_conf~") COLUMN(NAME=~"crdconfi.dcof_cantidad_reservada~") COLUMN(NAME=~"crdconfi.dcof_cant1~") COLUMN(NAME=~"inamedid_b.medi_abre~") COMPUTE(NAME=~"convert(numeric(15,0),(crdconfi.dcof_cantidad_reservada/inamedid_a.medi_cantidad)) res_entero~") COMPUTE(NAME=~"crdconfi.dcof_cantidad_reservada - (convert(numeric(15,0),(crdconfi.dcof_cantidad_reservada / inamedid_a.medi_cantidad)) * inamedid_a.medi_cantidad) res_fraccion~") COMPUTE(NAME=~"convert(numeric(15,0),( (((crdconfi.dcof_cantidad_total * inamedid_b.medi_cantidad ) + crdconfi.dcof_cant1) - crdconfi.dcof_cantidad_reservada)/inamedid_a.medi_cantidad)) dis_entero~") COMPUTE(NAME=~" (((crdconfi.dcof_cantidad_total * inamedid_b.medi_cantidad ) + crdconfi.dcof_cant1) - (crdconfi.dcof_cantidad_reservada) - convert(numeric(15,0),( (((crdconfi.dcof_cantidad_total * inamedid_b.medi_cantidad ) + crdconfi.dcof_cant1) - crdconfi.dcof_cantidad_reservada)/inamedid_a.medi_cantidad)) * inamedid_a.medi_cantidad) dis_fraccion~") COLUMN(NAME=~"inamedid_a.medi_abre~") COLUMN(NAME=~"crdconfi.dcof_num_ren_confi~")    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"crdconfi.dcof_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"crdconfi.dcof_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"crdconfi.dcof_producto~" )    JOIN (LEFT=~"crtconfi.tcof_g_financiero~"    OP =~"=~"RIGHT=~"crdconfi.dcof_g_financiero~" )    JOIN (LEFT=~"crtconfi.tcof_empresa~"    OP =~"=~"RIGHT=~"crdconfi.dcof_empresa~" )    JOIN (LEFT=~"crtconfi.tcof_num_conf_oc~"    OP =~"=~"RIGHT=~"crdconfi.dcof_num_conf_oc~" )    JOIN (LEFT=~"crtconfi.tcof_anno_oc~"    OP =~"=~"RIGHT=~"crdconfi.dcof_anno_oc~" )    JOIN (LEFT=~"inmbodeg.mbod_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmbodeg.mbod_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmbodeg.mbod_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"inmbodeg.mbod_g_financiero~"    OP =~"=~"RIGHT=~"crmparam.mpar_g_financiero~" )    JOIN (LEFT=~"inmbodeg.mbod_empresa~"    OP =~"=~"RIGHT=~"crmparam.mpar_empresa~" )    JOIN (LEFT=~"inmbodeg.mbod_bodega~"    OP =~"=~"RIGHT=~"crmparam.mpar_bodega~" )    JOIN (LEFT=~"inmbodeg.mbod_ubicacion~"    OP =~"=~"RIGHT=~"crmparam.mpar_ubicacion~" )    JOIN (LEFT=~"inamedid_a.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )    JOIN (LEFT=~"crdconfi.dcof_unidad~"    OP =~"=~"RIGHT=~"inamedid_b.medi_medida~" )WHERE(    EXP1 =~"crdconfi.dcof_g_financiero~"   OP =~"=~"    EXP2 =~":confi_grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"crdconfi.dcof_empresa~"   OP =~"=~"    EXP2 =~":confi_empre~" ) ) ARG(NAME = ~"confi_grupo~" TYPE = number)  ARG(NAME = ~"confi_empre~" TYPE = number) " arguments=(("confi_grupo", number),("confi_empre", number))  sort="prod_producto A " )
