table(column=(type=char(10) updatewhereclause=yes name=medi_abre dbname="inamedid.medi_abre" )
 column=(type=char(10) updatewhereclause=yes name=medi_abre_2 dbname="inamedid.medi_abre" )
 column=(type=char(10) updatewhereclause=yes name=doco_codigo_oc dbname="crdordco.doco_codigo_oc" )
 column=(type=decimal(0) updatewhereclause=yes name=doco_anno_oc dbname="crdordco.doco_anno_oc" )
 column=(type=char(20) updatewhereclause=yes name=doco_id_referencia dbname="crdordco.doco_id_referencia" )
 column=(type=decimal(4) updatewhereclause=yes name=doco_cantidad_total dbname="crdordco.doco_cantidad_total" )
 column=(type=decimal(0) updatewhereclause=yes name=doco_cant1 dbname="crdordco.doco_cant1" )
 column=(type=decimal(6) updatewhereclause=yes name=doco_cantidad_reserva dbname="crdordco.doco_cantidad_reserva" )
 column=(type=decimal(0) updatewhereclause=yes name=res_entero dbname="res_entero" )
 column=(type=decimal(8) updatewhereclause=yes name=res_fraccion dbname="res_fraccion" )
 column=(type=decimal(0) updatewhereclause=yes name=dis_entero dbname="dis_entero" )
 column=(type=decimal(12) updatewhereclause=yes name=dis_fraccion dbname="dis_fraccion" )
 column=(type=long updatewhereclause=yes name=doco_num_renglon_oc dbname="crdordco.doco_num_renglon_oc" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_a~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_b~" )  TABLE(NAME=~"crdordco~" ) COLUMN(NAME=~"inamedid_b.medi_abre~") COLUMN(NAME=~"inamedid_a.medi_abre~") COLUMN(NAME=~"crdordco.doco_codigo_oc~") COLUMN(NAME=~"crdordco.doco_anno_oc~") COLUMN(NAME=~"crdordco.doco_id_referencia~") COLUMN(NAME=~"crdordco.doco_cantidad_total~") COLUMN(NAME=~"crdordco.doco_cant1~") COLUMN(NAME=~"crdordco.doco_cantidad_reserva~") COMPUTE(NAME=~"convert(numeric(15,0),(crdordco.doco_cantidad_reserva/inamedid_a.medi_cantidad)) res_entero~") COMPUTE(NAME=~"crdordco.doco_cantidad_reserva - (convert(numeric(15,0),(crdordco.doco_cantidad_reserva / inamedid_a.medi_cantidad)) * inamedid_a.medi_cantidad) res_fraccion~") COMPUTE(NAME=~"convert(numeric(15,0),( (((crdordco.doco_cantidad_total * inamedid_b.medi_cantidad ) + crdordco.doco_cant1) - crdordco.doco_cantidad_reserva)/inamedid_a.medi_cantidad)) dis_entero~") COMPUTE(NAME=~" (((crdordco.doco_cantidad_total * inamedid_b.medi_cantidad ) + crdordco.doco_cant1) - (crdordco.doco_cantidad_reserva) - convert(numeric(15,0),( ((( crdordco.doco_cantidad_total * inamedid_b.medi_cantidad ) +  crdordco.doco_cant1 ) - crdordco.doco_cantidad_reserva)/inamedid_a.medi_cantidad)) * inamedid_a.medi_cantidad) dis_fraccion~") COLUMN(NAME=~"crdordco.doco_num_renglon_oc~")    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid_a.medi_medida~" )    JOIN (LEFT=~"crdordco.doco_unidad~"    OP =~"=~"RIGHT=~"inamedid_b.medi_medida~" )    JOIN (LEFT=~"crdordco.doco_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"crdordco.doco_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"crdordco.doco_id_referencia~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"crdordco.doco_g_financiero~"   OP =~"=~"    EXP2 =~":tran_grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"crdordco.doco_empresa~"   OP =~"=~"    EXP2 =~":tran_empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"crdordco.doco_id_referencia~"   OP =~"=~"    EXP2 =~":tran_producto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crdordco.doco_cant_facturada~"   OP =~"<~"    EXP2 =~"crdordco.doco_cantidad_total * inamedid_b.medi_cantidad + crdordco.doco_cant1~" ) ) ARG(NAME = ~"tran_grupo~" TYPE = number)  ARG(NAME = ~"tran_empresa~" TYPE = number)  ARG(NAME = ~"tran_producto~" TYPE = string) " arguments=(("tran_grupo", number),("tran_empresa", number),("tran_producto", string)) )
