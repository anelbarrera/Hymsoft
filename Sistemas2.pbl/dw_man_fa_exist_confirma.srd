 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmbodeg~" ) COLUMN(NAME=~"inmbodeg.mbod_producto~") COLUMN(NAME=~"inmbodeg.mbod_bodega~") COLUMN(NAME=~"inmbodeg.mbod_ubicacion~") COMPUTE(NAME=~"~~~"   ~~~"  co_unidad~") COMPUTE(NAME=~"0 cexistencia~") COMPUTE(NAME=~"0 creserva~") COMPUTE(NAME=~"0 cdisponible~") COMPUTE(NAME=~"0 fdispo~") COMPUTE(NAME=~"0 freserva~") COMPUTE(NAME=~"0 fexistencia~") COLUMN(NAME=~"inmbodeg.mbod_cant_confirma~") COLUMN(NAME=~"inmbodeg.mbod_reserva_conf~")WHERE(    EXP1 =~"inmbodeg.mbod_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmbodeg.mbod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmbodeg.mbod_producto~"   OP =~"=~"    EXP2 =~":item~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmbodeg.mbod_bodega~"   OP =~"=~"    EXP2 =~":bodega~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmbodeg.mbod_ubicacion~"   OP =~"=~"    EXP2 =~":ubicacion~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"item~" TYPE = string)  ARG(NAME = ~"bodega~" TYPE = string)  ARG(NAME = ~"ubicacion~" TYPE = string) " arguments=(("g_financiero", number),("empresa", number),("item", string),("bodega", string),("ubicacion", string)) )
