 column=(type=char(15) updatewhereclause=yes name=prod_barra dbname="inmprodu.prod_barra" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crdordco~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_a~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_b~" ) COLUMN(NAME=~"crdordco.doco_codigo_oc~") COLUMN(NAME=~"crdordco.doco_anno_oc~") COLUMN(NAME=~"crdordco.doco_num_renglon_oc~") COLUMN(NAME=~"crdordco.doco_id_referencia~") COLUMN(NAME=~"crdordco.doco_descripcion_ref~") COLUMN(NAME=~"crdordco.doco_unidad~") COLUMN(NAME=~"crdordco.doco_cantidad_total~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COMPUTE(NAME=~"convert(numeric(6,0), ( crdordco.doco_cantidad_total * inamedid_a.medi_cantidad ) / ( inmprodu.prod_empaque * inamedid_b.medi_cantidad )) bultos~") COMPUTE(NAME=~"1 imprimir~") COMPUTE(NAME=~"0 desde~") COMPUTE(NAME=~"0 hasta~") COLUMN(NAME=~"inmprodu.prod_barra~")    JOIN (LEFT=~"crdordco.doco_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"crdordco.doco_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"crdordco.doco_id_referencia~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"crdordco.doco_unidad~"    OP =~"=~"RIGHT=~"inamedid_a.medi_medida~" )    JOIN (LEFT=~"inmprodu.prod_empaque_um~"    OP =~"=~"RIGHT=~"inamedid_b.medi_medida~" )WHERE(    EXP1 =~"crdordco.doco_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"crdordco.doco_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"crdordco.doco_codigo_oc~"   OP =~"=~"    EXP2 =~":transito~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"crdordco.doco_anno_oc~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transito~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("transito", string),("ann", number)) )
