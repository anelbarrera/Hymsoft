 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_a~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_b~" )  TABLE(NAME=~"bobultos~" ) COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COMPUTE(NAME=~"0 desde~") COMPUTE(NAME=~"0 hasta~") COLUMN(NAME=~"inmprodu.prod_barra~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"bobultos.bulto_item~") COLUMN(NAME=~"bobultos.bulto_cedula~") COLUMN(NAME=~"bobultos.bulto_unidad~") COLUMN(NAME=~"bobultos.bulto_empaque~") COMPUTE(NAME=~"0 desactivar~")    JOIN (LEFT=~"inmprodu.prod_empaque_um~"    OP =~"=~"RIGHT=~"inamedid_b.medi_medida~" )    JOIN (LEFT=~"bobultos.bulto_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"bobultos.bulto_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"bobultos.bulto_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"bobultos.bulto_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"bobultos.bulto_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"bobultos.bulto_transito~"   OP =~"=~"    EXP2 =~":transito~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"bobultos.bulto_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transito~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("transito", string),("ann", number))  sort="bulto_cedula A " )
