 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"vi_productos_pedidos~" ) COLUMN(NAME=~"vi_productos_pedidos.prod_producto~") COLUMN(NAME=~"vi_productos_pedidos.prod_producto_dos~") COLUMN(NAME=~"vi_productos_pedidos.prod_descripcion~") COLUMN(NAME=~"vi_productos_pedidos.prod_descripcion_dos~") COLUMN(NAME=~"vi_productos_pedidos.prod_grupo~") COLUMN(NAME=~"vi_productos_pedidos.prod_sub_grupo~") COLUMN(NAME=~"vi_productos_pedidos.prod_division~") COLUMN(NAME=~"vi_productos_pedidos.prod_clase~") COLUMN(NAME=~"vi_productos_pedidos.prod_medida~") COLUMN(NAME=~"vi_productos_pedidos.prod_cubicaje~") COLUMN(NAME=~"vi_productos_pedidos.prod_peso~") COLUMN(NAME=~"vi_productos_pedidos.prod_peso_descripcion~") COLUMN(NAME=~"vi_productos_pedidos.prod_empaque~") COLUMN(NAME=~"vi_productos_pedidos.prod_empaque_descripcion~") COLUMN(NAME=~"vi_productos_pedidos.prod_cod_alternativo~") COLUMN(NAME=~"vi_productos_pedidos.prod_pais~") COLUMN(NAME=~"vi_productos_pedidos.prod_existencia_total~") COLUMN(NAME=~"vi_productos_pedidos.prod_reserva_total~") COLUMN(NAME=~"vi_productos_pedidos.mbod_producto~") COLUMN(NAME=~"vi_productos_pedidos.mbod_costo_cif~") COLUMN(NAME=~"vi_productos_pedidos.mbod_cantidad~") COLUMN(NAME=~"vi_productos_pedidos.mbod_bodega~") COLUMN(NAME=~"vi_productos_pedidos.mbod_ubicacion~") COLUMN(NAME=~"vi_productos_pedidos.prod_foto_dir~") COLUMN(NAME=~"vi_productos_pedidos.prod_g_financiero~") COLUMN(NAME=~"vi_productos_pedidos.prod_empresa~") COLUMN(NAME=~"vi_productos_pedidos.mbod_reserva~") COMPUTE(NAME=~"vi_productos_pedidos.mbod_cantidad - vi_productos_pedidos.mbod_reserva disponible~") COMPUTE(NAME=~"convert(numeric(10,0),(mbod_cantidad/medi_cantidad)) entero~") COMPUTE(NAME=~"mbod_cantidad - (convert(numeric(10,0),(mbod_cantidad / medi_cantidad)) * medi_cantidad) fraccion~") COMPUTE(NAME=~"convert(numeric(10,0),(mbod_reserva/medi_cantidad)) rentero~") COMPUTE(NAME=~"mbod_reserva - (convert(numeric(10,0),(mbod_reserva / medi_cantidad)) * medi_cantidad) rfraccion~") COMPUTE(NAME=~"convert(numeric(10,0),((mbod_cantidad - mbod_reserva)/medi_cantidad)) dis_entero~") COMPUTE(NAME=~"(mbod_cantidad - mbod_reserva) - (convert(numeric(10,0),((mbod_cantidad - mbod_reserva )/ medi_cantidad)) * medi_cantidad) dis_fraccion~")WHERE(    EXP1 =~"vi_productos_pedidos.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_producto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"vi_productos_pedidos.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa_producto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"vi_productos_pedidos.prod_producto~"   OP =~"=~"    EXP2 =~":producto_producto~" ) ) ARG(NAME = ~"grupo_producto~" TYPE = number)  ARG(NAME = ~"empresa_producto~" TYPE = number)  ARG(NAME = ~"producto_producto~" TYPE = string) " arguments=(("grupo_producto", number),("empresa_producto", number),("producto_producto", string))  sort="prod_producto A mbod_bodega A mbod_ubicacion A " )
