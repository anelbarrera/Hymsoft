//objectcomments Devuelve la Unidad del Producto 1, 12 , 300
global type gf_unidad_prod from function_object
end type

forward prototypes
global function any gf_unidad_prod (string unidad_prod, long medi_conver)
end prototypes

global function any gf_unidad_prod (string unidad_prod, long medi_conver);//* Carga Los Datos de Converción de la Unidad del Producto a la Nueva unidad o 
// Cantidad de unidades minimas de la unidad del producto
			
// Devuelve 1 si la unidad del producto es PZ : Piezas
//  "      12        "                    DO : Docenas
//  "      144        "                   GR : Gruesas

	long ll_mconver_prod

	  SELECT isnull(inamedid.medi_cantidad,0)
	  INTO	:ll_mconver_prod
	  FROM  inamedid  
	  WHERE inamedid.medi_tipo_medida = :medi_conver and
			  inamedid.medi_medida = :unidad_prod;

if sqlca.sqlcode = -1 then
	gf_mensaje("","Erro en el Select "+sqlca.sqlerrtext,1,1,"E")
end if

return(ll_mconver_prod)
end function

