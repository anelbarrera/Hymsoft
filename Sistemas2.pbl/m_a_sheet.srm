event clicked;GraphicObject goObject
DataWindow dwUndo
EditMask emUndo
MultiLineEdit mleUndo
SingleLineEdit sleUndo

goObject = GetFocus()		

If Not IsNull( goObject) Then
	Choose Case TypeOf( goObject)
		Case DataWindow!
			dwUndo = goObject
			If dwUndo.CanUndo() Then
				dwUndo.Undo()
			End If
		Case EditMask!
			emUndo = goObject
			If emUndo.CanUndo() Then
				emUndo.Undo()
			End If
		Case MultiLineEdit!
			mleUndo = goObject
			If mleUndo.CanUndo() Then
				mleUndo.Undo()
			End If
		Case SingleLineEdit!
			sleUndo = goObject
			If sleUndo.CanUndo() Then
				sleUndo.Undo()
			End If
	End Choose
End If

end event

on m_deshacer.create
this.Text="&Deshacer~tCtrl+Z"
this.Microhelp="Deshace el Ultimo Cambio"
this.Shortcut=346
end on

