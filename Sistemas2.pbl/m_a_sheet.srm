global type m_a_sheet from menu
m_archivo m_archivo
m_edicion m_edicion
m_panel m_panel
m_m_panel m_m_panel
m_entidad_b m_entidad_b
m_contabilidad m_contabilidad
end type
global m_a_sheet m_a_sheet

forward prototypes
public subroutine mf_check_view (menu am_item)
end prototypes

public subroutine mf_check_view (menu am_item);If am_item <> m_a_sheet.m_panel.m_vericonos.m_grandes Then &
									m_a_sheet.m_panel.m_vericonos.m_grandes.checked = false
If am_item <> m_a_sheet.m_panel.m_vericonos.m_pequeos Then &
									m_a_sheet.m_panel.m_vericonos.m_pequeos.checked = false
If am_item <> m_a_sheet.m_panel.m_vericonos.m_lista Then &
									m_a_sheet.m_panel.m_vericonos.m_lista.checked = false
If am_item <> m_a_sheet.m_panel.m_vericonos.m_detalles Then &
									m_a_sheet.m_panel.m_vericonos.m_detalles.checked = false
									
am_item.checked = true

end subroutine

on m_a_sheet.create
m_a_sheet=this
this.m_archivo=create m_archivo
this.m_edicion=create m_edicion
this.m_panel=create m_panel
this.m_m_panel=create m_m_panel
this.m_entidad_b=create m_entidad_b
this.m_contabilidad=create m_contabilidad
this.Item[]={this.m_archivo, &
this.m_edicion, &
this.m_panel, &
this.m_m_panel, &
this.m_entidad_b, &
this.m_contabilidad}
end on

on m_a_sheet.destroy
destroy(this.m_archivo)
destroy(this.m_edicion)
destroy(this.m_panel)
destroy(this.m_m_panel)
destroy(this.m_entidad_b)
destroy(this.m_contabilidad)
end on

