compute(band=header alignment="2" expression="''"border="0" color="33554592" x="1677" y="1187" height="218" width="4854" format="[general]"  name=rango_fecha  font.face="Arial" font.height="-12" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1083244543" )
text(band=header alignment="0" text="Hora:" border="0" color="33554432" x="62" y="1520" height="145" width="447"  name=t_3  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=header alignment="0" expression="''"border="0" color="33554592" x="645" y="1520" height="145" width="739" format="[general]"  name=hora  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1083244543" )
line(band=header x1="31" y1="1760" x2="7750" y2="1750"  name=l_1 pen.style="0" pen.width="20" pen.color="0"  background.mode="2" background.color="1090519039" )
text(band=header alignment="2" text="Monto Final" border="0" color="33554432" x="6541" y="1802" height="145" width="791"  name=t_9  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
line(band=header x1="20" y1="1989" x2="7739" y2="1989"  name=l_2 pen.style="0" pen.width="20" pen.color="0"  background.mode="2" background.color="1090519039" )
text(band=header alignment="2" text="Codigo Cta." border="0" color="33554432" x="500" y="1802" height="145" width="760"  name=t_1  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=header alignment="2" text="Nombre" border="0" color="33554432" x="2322" y="1802" height="145" width="541"  name=t_4  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
text(band=header alignment="2" text="Fecha" border="0" color="33554592" x="5656" y="1802" height="145" width="677"  name=date_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1083244543" )
text(band=header alignment="2" text="Pedido" border="0" color="33554592" x="5052" y="1802" height="145" width="468"  name=t_5  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1083244543" )
text(band=header alignment="2" text="Factura" border="0" color="33554592" x="4072" y="1802" height="145" width="802"  name=number_t  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1083244543" )
compute(band=header alignment="1" expression="''"border="0" color="0" x="5697" y="1385" height="145" width="2052" format="[general]"  name=data_window  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=header alignment="1" expression="~"Página ~"+string(page())+~" de ~" + string(pageCount())"border="0" color="33554592" x="6125" y="1562" height="156" width="1625" format="[general]"  name=paginas  font.face="Arial" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="1083244543" )
compute(band=detail alignment="1" expression="if(  Pos (  fact_no_pedido, 'NC' ,1 ) > 0, - 1 ,  1  )"border="0" color="33554432" x="5260" y="417" height="156" width="416" format="$##,###,##0.00"  name=operando  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=detail alignment="1" expression="/*   facd_costo_cif *  operando  */"border="0" color="33554432" x="3302" y="438" height="145" width="645" format="$#,###,##0.00"  name=costo1  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
column(band=detail id=5 alignment="0" tabsequence=32766 border="0" color="0" x="385" y="21" height="145" width="1062" format="[general]"  name=fact_ruc_cliente edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
column(band=detail id=8 alignment="2" tabsequence=32766 border="0" color="0" x="5645" y="21" height="145" width="697" format="dd/mm/yyyy"  name=fact_fecha edit.name="Fecha_only" editmask.mask="dd/mm/yyyy" editmask.focusrectangle=no  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
column(band=detail id=1 alignment="0" tabsequence=32766 border="0" color="0" x="4958" y="21" height="145" width="635" format="[general]"  name=fact_no_pedido edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
compute(band=detail alignment="0" expression=" fact_no_factura"border="0" color="0" x="4093" y="21" height="145" width="802" format="[general]"  name=numero  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
column(band=detail id=14 alignment="0" tabsequence=32766 border="0" color="0" x="1500" y="21" height="145" width="2531" format="[general]"  name=fact_a_nombre edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="553648127" )
