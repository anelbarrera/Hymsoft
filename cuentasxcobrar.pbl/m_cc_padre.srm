this.Item[UpperBound(this.Item)+1]=this.m_cambiar_cuenta
this.Item[UpperBound(this.Item)+1]=this.m_tiposdeclientes1
this.Item[UpperBound(this.Item)+1]=this.m_vendedores
this.Item[UpperBound(this.Item)+1]=this.m_plazas
