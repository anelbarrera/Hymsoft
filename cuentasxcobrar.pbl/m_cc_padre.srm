this.toolbarbackcolor = 15780518
this.toolbarhighlightcolor = 8388608
this.toolbargradient = true
this.bitmapgradient = true
this.m_documentospost-fechados1=create m_documentospost-fechados1
this.m_recibospordepositar=create m_recibospordepositar
this.m_vencimientodedocumentos=create m_vencimientodedocumentos
this.m_depsitosajustados=create m_depsitosajustados
this.m_tarjetasmanuales=create m_tarjetasmanuales
this.m_historialdetarjeta=create m_historialdetarjeta
this.m_movimientodetarjetascredito=create m_movimientodetarjetascredito
this.m_costosporfacturas=create m_costosporfacturas
this.m_historialdecuentas=create m_historialdecuentas
this.m_justificar=create m_justificar
this.m_documentosabonados=create m_documentosabonados
this.m_recibosnoaplicados=create m_recibosnoaplicados
this.m_documentosnoaplicados=create m_documentosnoaplicados
this.m_2=create m_2
this.Item[UpperBound(this.Item)+1]=this.m_documentospost-fechados1
this.Item[UpperBound(this.Item)+1]=this.m_recibospordepositar
this.Item[UpperBound(this.Item)+1]=this.m_vencimientodedocumentos
this.Item[UpperBound(this.Item)+1]=this.m_depsitosajustados
this.Item[UpperBound(this.Item)+1]=this.m_tarjetasmanuales
this.Item[UpperBound(this.Item)+1]=this.m_historialdetarjeta
this.Item[UpperBound(this.Item)+1]=this.m_movimientodetarjetascredito
this.Item[UpperBound(this.Item)+1]=this.m_costosporfacturas
this.Item[UpperBound(this.Item)+1]=this.m_historialdecuentas
this.Item[UpperBound(this.Item)+1]=this.m_justificar
this.Item[UpperBound(this.Item)+1]=this.m_documentosabonados
this.Item[UpperBound(this.Item)+1]=this.m_recibosnoaplicados
this.Item[UpperBound(this.Item)+1]=this.m_documentosnoaplicados
this.Item[UpperBound(this.Item)+1]=this.m_2
end on

on m_otros2.destroy
call super::destroy
destroy(this.m_documentospost-fechados1)
destroy(this.m_recibospordepositar)
destroy(this.m_vencimientodedocumentos)
destroy(this.m_depsitosajustados)
destroy(this.m_tarjetasmanuales)
destroy(this.m_historialdetarjeta)
destroy(this.m_movimientodetarjetascredito)
destroy(this.m_costosporfacturas)
destroy(this.m_historialdecuentas)
destroy(this.m_justificar)
destroy(this.m_documentosabonados)
destroy(this.m_recibosnoaplicados)
destroy(this.m_documentosnoaplicados)
destroy(this.m_2)
end on

event selected;string ls_tag

//Llamado de funcion de acceso a opciones (SEGURIDAD)
ls_tag = this.Tag

if gf_ss_accesos(str.grupo,'CC','m_cc_padre',ls_tag) = true then
	this.enabled = true
else
	this.enabled = false
	return
end if

end event

event clicked;string ls_proy_anam, ls_error,ls_comision_prl,ls_tarjetas_poppys

SELECT isnull(ccmparam.para_proy_anam,'N'),isnull(ccmparam.para_comision_prl,'N'),
isnull(ccmparam.para_especial_tarjetas,'N')
    INTO :ls_proy_anam,:ls_comision_prl,:ls_tarjetas_poppys
    FROM ccmparam  
    WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
          ( ccmparam.para_empresa = :str.empresa )   ;
if sqlca.sqldbcode = -1 then
	ls_error = sqlca.sqlerrtext
	Rollback;
	mensaje("Error","Ha ocurrido un error al recuperar el tipo de pais-region",ls_error)
end if

if ls_proy_anam = 'S' then
	this.m_tarjetasmanuales.visible = false
	this.m_historialdetarjeta.visible = false
	this.m_movimientodetarjetascredito.visible = false
	this.m_2.visible = false
else
	if ls_tarjetas_poppys = 'T' then//t de tarjetas
		this.m_tarjetasmanuales.visible = true
		this.m_historialdetarjeta.visible = true
		this.m_movimientodetarjetascredito.visible = true
	else
		this.m_tarjetasmanuales.visible = false
		this.m_historialdetarjeta.visible = false
		this.m_movimientodetarjetascredito.visible = false
	end if	
	if ls_comision_prl = 'P' then
		this.m_2.visible = true
	end if
end if
end event

