event clicked;string ls_opcion_informe
  SELECT ccmparam.para_tipo_informe_caja  
    INTO :ls_opcion_informe  
    FROM ccmparam  
   WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
         ( ccmparam.para_empresa = :str.empresa )   ;

if isnull(ls_opcion_informe) or ls_opcion_informe = 'T' then
	m_justificasaldoinicial.enabled = true
	m_capturadetrans-saldoinicial.enabled = false

elseif ls_opcion_informe = 'S' then
	m_justificasaldoinicial.enabled = false
	m_capturadetrans-saldoinicial.enabled = true
end if	
end event

