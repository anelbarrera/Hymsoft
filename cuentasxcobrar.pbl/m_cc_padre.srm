on m_cobros.create
call super::create
this.tag = "m_cc_padre.m_reportes.m_cobros"
this.text = "Cobros"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 8388608
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbarstyle = contemporarytoolbar!
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 15780518
this.toolbarhighlightcolor = 8388608
this.toolbargradient = true
this.bitmapgradient = true
this.m_porcliente=create m_porcliente
this.m_porpasoregin=create m_porpasoregin
this.m_resumido=create m_resumido
this.m_resumendeopraciones=create m_resumendeopraciones
this.m_proyeccioncobros=create m_proyeccioncobros
this.Item[UpperBound(this.Item)+1]=this.m_porcliente
this.Item[UpperBound(this.Item)+1]=this.m_porpasoregin
this.Item[UpperBound(this.Item)+1]=this.m_resumido
this.Item[UpperBound(this.Item)+1]=this.m_resumendeopraciones
this.Item[UpperBound(this.Item)+1]=this.m_proyeccioncobros
end on

on m_cobros.destroy
call super::destroy
destroy(this.m_porcliente)
destroy(this.m_porpasoregin)
destroy(this.m_resumido)
destroy(this.m_resumendeopraciones)
destroy(this.m_proyeccioncobros)
end on

event selected;string ls_tag

//Llamado de funcion de acceso a opciones (SEGURIDAD)
ls_tag = this.Tag

if gf_ss_accesos(str.grupo,'CC','m_cc_padre',ls_tag) = true then
	this.enabled = true
else
	this.enabled = false
	return
end if

end event

event clicked;string ls_proy_anam, ls_error

SELECT isnull(ccmparam.para_proy_anam,'N')
    INTO :ls_proy_anam
    FROM ccmparam  
    WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
          ( ccmparam.para_empresa = :str.empresa )   ;
if sqlca.sqldbcode = -1 then
	ls_error = sqlca.sqlerrtext
	Rollback;
	mensaje("Error","Ha ocurrido un error al recuperar el tipo de pais-region",ls_error)
end if

if ls_proy_anam = 'S' then
	this.m_resumendeopraciones.visible = false
else
	this.m_resumendeopraciones.visible = true
end if
end event

