event selected;string ls_tag

//Llamado de funcion de acceso a opciones (SEGURIDAD)
ls_tag = this.Tag

if gf_ss_accesos(str.grupo,'CC','m_cc_padre',ls_tag) = true then
	this.enabled = true
else
	this.enabled = false
	return
end if

end event

event clicked;string ls_proy_anam, ls_error, ls_usa_servicios,ls_tarjetas,ls_siafpa

 SELECT isnull(ccmparam.para_proy_anam,'N'),
		 isnull(ccmparam.para_usa_servicios,'N'),
		 isnull(ccmparam.para_especial_tarjetas,'N'),
   	  isnull(ccmparam.para_siafpa,'N')
    INTO :ls_proy_anam,:ls_usa_servicios,:ls_tarjetas,:ls_siafpa
    FROM ccmparam  
    WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
          ( ccmparam.para_empresa = :str.empresa )   ;
if sqlca.sqldbcode = -1 then
	ls_error = sqlca.sqlerrtext
	Rollback;
	mensaje("Error","Ha ocurrido un error al recuperar el tipo de pais-region",ls_error)
end if
	
	
if ls_proy_anam = 'S' then
	if ls_siafpa = 'S' then
		m_parmetros.m_configuraciónasientoscontables.visible = true
	elseif ls_siafpa = 'N' then
		m_parmetros.m_configuraciónasientoscontables.visible = false
	end if

	m_parmetros.m_cliente.m_vendedores.visible = false
	m_parmetros.m_cliente.m_plazas.visible = false
	m_parmetros.m_facturaciondeservicios.text = 'Servicios'
	m_parmetros.m_sistema.m_conciliacindetarjetas1.text = 'Mensajes'
else
	m_parmetros.m_configuraciónasientoscontables.visible = false
	m_parmetros.m_cliente.m_vendedores.visible = true
	m_parmetros.m_cliente.m_plazas.visible = true
	if ls_usa_servicios = 'V' then
		m_parmetros.m_facturaciondeservicios.visible = true
	else
		m_parmetros.m_facturaciondeservicios.visible = false
	end if
	m_parmetros.m_facturaciondeservicios.text = 'Facturación de Servicios'
	if ls_tarjetas = 'T' then
		m_parmetros.m_sistema.m_conciliacindetarjetas1.visible = true
	else
		m_parmetros.m_sistema.m_conciliacindetarjetas1.visible = false
	end if
	m_parmetros.m_sistema.m_conciliacindetarjetas1.text = 'Conciliación de Tarjetas'
end if

//Para que se oculte opcion de configurar tarjeta, propio de ROFA
if pos(Upper(str.empr_acceso_especial),'ROFA,') > 0 then
	m_sistema.m_configurartarjetasdecredito.visible = true
end if

//Para que se oculte opcion de configurar tarjeta, propio de ROFA
if pos(Upper(str.empr_acceso_especial),'ACISA,') > 0 then
	m_sistema.m_antiguedaddesaldosdinamica.visible= true
END IF

if pos(Upper(str.empr_acceso_especial),'CORPINSA,') > 0 then
	this.m_cliente.m_proyectos.visible = true
	this.m_cliente.m_vendedores.visible = false
	this.m_cliente.m_plazas.visible = false
else
	this.m_cliente.m_vendedores.visible = true
	this.m_cliente.m_plazas.visible = true
end if
end event

