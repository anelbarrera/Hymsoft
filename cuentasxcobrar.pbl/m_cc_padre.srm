end on

event clicked;string ls_imprime, ls_error, ls_proy_anam, ls_especial_tarjetas,ls_usa_servicios,ls_siafpa
datetime ldt_feha_ini
integer li_mes, li_anno, li_mesi,li_anoi
  
  SELECT ccmparam.para_imprime_informe, ccmparam.para_fecha_ini_apli,
         ccmparam.para_mes,ccmparam.para_ano,
			isnull(ccmparam.para_proy_anam,'N'),
			isnull(ccmparam.para_especial_tarjetas,'N'),
			isnull(ccmparam.para_usa_servicios,'N'),
			isnull(ccmparam.para_siafpa,'N')
    INTO :ls_imprime,:ldt_feha_ini,:li_mes,:li_anno,:ls_proy_anam,:ls_especial_tarjetas,
	      :ls_usa_servicios, :ls_siafpa
    FROM ccmparam  
    WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
          ( ccmparam.para_empresa = :str.empresa )   ;
if sqlca.sqlcode = -1 then
	ls_error = sqlca.sqlerrtext
	rollback;
	messagebox('Error','Error al selecionar datos en ccmparam'+ls_error)
end if


//Informe de caja
if ls_imprime = 'S' then
	m_capturas1.m_saldoinicialdecaja.visible = true
else
	m_capturas1.m_saldoinicialdecaja.visible = false
end if

	

//Captura de Proyecciones ANAM
if ls_proy_anam = 'S' then
	if ls_siafpa = 'S' then
		m_capturas1.m_proyeccióndeventas.visible = true
	elseif ls_siafpa = 'N' then
		m_capturas1.m_proyeccióndeventas.visible = false
	end if
	m_capturas1.m_documentospost-fechados2.visible = false
	m_capturas1.m_transaccioneshistóricas.visible = false
	m_capturas1.m_capturadetarjetas.visible = false

	m_capturas1.m_saldoinicialdecaja.visible = false
	m_capturas1.m_facturadeserviciosautómatica.text = 'Cargos de Servicios Autómaticos'
	m_capturas1.m_depsitos.visible = false
else
	m_capturas1.m_proyeccióndeventas.visible =  false
	m_capturas1.m_documentospost-fechados2.visible = true
	m_capturas1.m_transaccioneshistóricas.visible = true
	if ls_especial_tarjetas = 'T' then//t de tarjetas
		m_capturas1.m_capturadetarjetas.visible = true
	else
		m_capturas1.m_capturadetarjetas.visible = false
	end if
	
	if ls_usa_servicios = 'V' then
		m_capturas1.m_facturadeserviciosautómatica.visible = true
		m_capturas1.m_facturas.visible = true
	else
		m_capturas1.m_facturadeserviciosautómatica.visible = false
		m_capturas1.m_facturas.visible = false
	end if
	m_capturas1.m_facturadeserviciosautómatica.text = 'Factura de Servicios Autómatica'
	m_capturas1.m_depsitos.visible = true
end if

//Captura de Saldos iniciales
li_mesi = month(date(ldt_feha_ini))
li_anoi = year(date(ldt_feha_ini))

if li_mesi = li_mes and li_anoi = li_anno then
	m_capturas1.m_saldosiniciales.visible = true
else
	m_capturas1.m_saldosiniciales.visible = false
end if

//Para que se oculte la captura de saldos del informe de cajas
if pos(Upper(str.empr_acceso_especial),'ACISA,') > 0 then
	m_capturas1.m_saldoinicialdecaja.visible = false
end if

if pos(Upper(str.empr_acceso_especial),'POPPYS,') > 0 then
	m_capturas1.m_capturadetarjetas.visible = true
end if

if pos(str.empr_acceso_especial,'NAT',1) > 0 then 
   m_depsitos.visible = false
end if

if pos(Upper(str.empr_acceso_especial),'CORPINSA,') > 0 then
	m_capturas1.m_recibodecobromúltiple.visible = true
end if
end event

