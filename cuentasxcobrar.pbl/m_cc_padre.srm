event clicked;string ls_pais_region, ls_error,ls_proy_anam, ls_tarjetas_poppys,ls_usa_servicios
 SELECT  isnull(ccmparam.para_cambio_pais_region,'N'),
		   isnull(ccmparam.para_proy_anam,'N'),
			isnull(ccmparam.para_especial_tarjetas,'N'),
			isnull(ccmparam.para_usa_servicios,'N')
    INTO :ls_pais_region,:ls_proy_anam,:ls_tarjetas_poppys,:ls_usa_servicios
    FROM ccmparam  
   WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
         ( ccmparam.para_empresa = :str.empresa )   ;
if sqlca.sqldbcode = -1 then
	ls_error = sqlca.sqlerrtext
	Rollback;
	mensaje("Error","Ha ocurrido un error al recuperar el tipo de pais-region",ls_error)
end if

if ls_pais_region = 'S' then//se cambia el texto de pais
	if ls_proy_anam = 'S' then
		this.m_clientes2.m_clientesporpaisyregion.text = 'Clientes por Regional y Agencia'
		this.m_clientes2.m_codificadordepas.text = 'Codificador de Regional'
		this.m_clientes2.m_codificadordeclientesporpas.text = 'Codificador de Clientes por Regional'		
		this.m_clientes2.m_capturasdetarjetas.visible = false	
		this.m_transacciones2.m_mantenimientodeservicioscosto.visible = false
		this.m_transacciones2.m_tipodeproveedores.visible = false
		this.m_clientes2.m_clientesporvendedor1.visible = false
		this.m_clientes2.m_clientesporsocio.visible = false
		this.m_clientes2.m_clientesporauditor.visible = false
	else
		this.m_clientes2.m_clientesporpaisyregion.text = 'Clientes por Asociación e Institución'
		this.m_clientes2.m_codificadordepas.text = 'Codificador de Asociación'
		this.m_clientes2.m_codificadordeclientesporpas.text = 'Codificador de Clientes por Asociación'
	   if ls_tarjetas_poppys = 'T' then
			this.m_clientes2.m_capturasdetarjetas.visible = true	
		else
			this.m_clientes2.m_capturasdetarjetas.visible = false
		end if
		if ls_usa_servicios = 'V' then//la V que lleva servicios
			this.m_transacciones2.visible = true
		else
			this.m_transacciones2.visible = false
		end if
		
		this.m_clientes2.m_clientesporvendedor1.visible = true
		this.m_clientes2.m_clientesporsocio.visible = true
		this.m_clientes2.m_clientesporauditor.visible = true
	end if	
else
	this.m_clientes2.m_clientesporpaisyregion.text = 'Clientes por País y Región'	
	this.m_clientes2.m_codificadordepas.text = 'Codificador de País'
	this.m_clientes2.m_codificadordeclientesporpas.text = 'Codificador de Clientes por País'
	if ls_tarjetas_poppys = 'T' then//t de tarjetas
		this.m_clientes2.m_capturasdetarjetas.visible = true
	else
		this.m_clientes2.m_capturasdetarjetas.visible = false
	end if
	if ls_usa_servicios = 'V' then//la V que lleva servicios
		this.m_transacciones2.visible = true
	else
		this.m_transacciones2.visible = false
	end if
	
	this.m_transacciones2.m_tipodeproveedores.visible = true

end if


end event

