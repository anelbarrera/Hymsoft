end event

event clicked;string ls_proy_anam, ls_error, ls_comision_prl, ls_tarjetas_poppys,&
       ls_usa_servicios, ls_siafpa

 SELECT isnull(ccmparam.para_proy_anam,'N'),isnull(ccmparam.para_comision_prl,'N'),
 isnull(ccmparam.para_especial_tarjetas,'N'),isnull(ccmparam.para_usa_servicios,'N'),
 isnull(ccmparam.para_siafpa,'N')
    INTO :ls_proy_anam,:ls_comision_prl,:ls_tarjetas_poppys,:ls_usa_servicios,:ls_siafpa
    FROM ccmparam  
    WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
          ( ccmparam.para_empresa = :str.empresa )   ;
if sqlca.sqldbcode = -1 then
	ls_error = sqlca.sqlerrtext
	Rollback;
	mensaje("Error","Ha ocurrido un error al recuperar el tipo de pais-region",ls_error)
end if
	
	
if ls_proy_anam = 'S' then
	if ls_siafpa = 'S' then
		m_procesos.m_pasescontablesadicionales.visible = true
		m_procesos.m_importarinformaciónderegionales.visible = true
		m_procesos.m_division_pase.visible = true
		m_procesos.m_-2002.visible = true
	elseif ls_siafpa = 'N' then
		m_procesos.m_pasescontablesadicionales.visible = false
		m_procesos.m_importarinformaciónderegionales.visible = false
		m_procesos.m_division_pase.visible = false
		m_procesos.m_-2002.visible = false
	end if
	
	m_procesos.m_actualizacindetransacciones.visible = false
	m_procesos.m_recibosdepositados.visible = false
	m_procesos.m_5.visible = false
	m_procesos.m_comisiones.visible = false
	m_procesos.m_modificacindedepositos.visible = false
	
	m_procesos.m_especiales.visible = false
//   m_procesos.m_generaciónautomáticadefacturasporservicios.text = 'Gereración Automática de Cargos por Servicios'
else
	m_procesos.m_pasescontablesadicionales.visible = false
	m_procesos.m_importarinformaciónderegionales.visible = false
	m_procesos.m_division_pase.visible = false
	m_procesos.m_-2002.visible = false
	if ls_tarjetas_poppys = 'T' then//t de tarjetas
		m_procesos.m_actualizacindetransacciones.visible = true
	else
		m_procesos.m_actualizacindetransacciones.visible = false
	end if
	m_procesos.m_recibosdepositados.visible = true
	m_procesos.m_5.visible = true	
	if ls_comision_prl = 'P' then
		m_procesos.m_comisiones.visible = true
	end if
	m_procesos.m_modificacindedepositos.visible = true
	m_procesos.m_division_pase.visible = false
	//m_procesos.m_especiales.visible = true
	if ls_usa_servicios = 'V' then
		m_procesos.m_gereraciónautomáticadefacturasporservic.visible = true
	else
		m_procesos.m_gereraciónautomáticadefacturasporservic.visible = false
	end if
end if	

if pos(str.empr_acceso_especial,'NAT',1) > 0 then 
   m_modificacindedepositos.visible = false
	m_recibosdepositados.visible = false 
end if
end event

