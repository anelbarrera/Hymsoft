type m_empresa from menu within m_archivo
end type

event clicked;// Herick
// Fue creada para que el usuario pueda escoger las ventanas que desea cerrar
// cuando va a cambiar de empresa


String	ls_aplicacion, ls_gf
Integer	li_pos, li_rtn_msg, li_i=1, li_j,li_mes, li_ano

str_active_sheet str_wsheet


str_wsheet.wSheet[li_i] = str.frame.GetFirstSheet()

IF IsValid(str_wsheet.wSheet[li_i]) THEN

	str_wsheet.titulo[li_i] = str_wsheet.wsheet[li_i].Title
	str_wsheet.nombre[li_i] = str_wsheet.wsheet[li_i].ClassName()

	If IsValid(str_wsheet.wSheet[li_i]) And (lower(Right(str_wsheet.nombre[li_i],5)) <> &
													"fondo" And Len(str_wsheet.nombre[li_i]) <> 10 ) Then

		DO WHILE IsValid(str_wsheet.wSheet[li_i])				
			
			If (lower(Right(str_wsheet.nombre[li_i],5)) = "fondo" And &
															Len(str_wsheet.nombre[li_i]) = 10 ) Then Exit
		
			li_j = li_i
			li_i++
			str_wsheet.wSheet[li_i] = str.frame.GetNextSheet(str_wsheet.wSheet[li_j])
			
			If Not IsValid(str_wsheet.wSheet[li_i]) Then Continue
			
				str_wsheet.titulo[li_i] = str_wsheet.wsheet[li_i].Title
				str_wsheet.nombre[li_i] = str_wsheet.wsheet[li_i].ClassName()
		LOOP

//		//OpenWithParm(w_active_sheets, str_wsheet)
	End if
END IF

yield()

li_pos = Pos(str.frame.title, " -- ")

ls_aplicacion = Right(str.frame.title, Len(str.frame.title) - (li_pos + 3))

////OpenWithParm(w_select_empr, str.usuario)
SELECT ccmparam.para_mes,  ccmparam.para_ano
INTO :li_mes,   
     :li_ano
   FROM ccmparam  
   WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
         ( ccmparam.para_empresa = :str.empresa ) ;  



str.frame.title = gf_dg_nom_empresa(str.g_financiero,str.empresa) + ' -- ' + ls_aplicacion

ls_gf = gf_dg_nom_gfinanciero(str.g_financiero, str.empresa)
w_cc_fondo.Title = ls_gf +".  Mes de Proceso " +  &
				 string(gf_dg_mes(li_mes)) +" de "+string(li_ano)
				 
//w_cc_fondo.Title = "(CC) Sistema de Cuentas por Cobrar. Mes de Proceso " + &
//							string(gf_dg_mes(li_mes)) + " de " + string(li_ano)
str.frame.title = w_cc_fondo.Title
w_cc_fondo.st_empresa.text = '  '+gf_fa_nom_empr(str.g_financiero,str.empresa)

w_cc_fondo.st_1.y = w_cc_fondo.Height - w_cc_fondo.st_1.Height
w_cc_fondo.st_1.x = w_cc_fondo.width  - w_cc_fondo.st_1.width

w_cc_fondo.st_empresa.y = w_cc_fondo.Height - w_cc_fondo.st_empresa.Height
w_cc_fondo.st_empresa.x = 1

w_cc_fondo.st_1.visible = true
w_cc_fondo.st_empresa.visible = true



end event

