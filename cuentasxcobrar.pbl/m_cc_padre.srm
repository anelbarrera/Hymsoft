on m_listados.create
call super::create
this.tag = "m_cc_padre.m_listados"
this.text = "Listados"
this.microhelp = "Informes de Cuentas por Cobrar"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 8388608
this.textsize = 8
