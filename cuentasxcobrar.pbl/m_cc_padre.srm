//Llamado de funcion de acceso a opciones (SEGURIDAD)
ls_tag = this.Tag

if gf_ss_accesos(str.grupo,'CC','m_cc_padre',ls_tag) = true then
	this.enabled = true
else
	this.enabled = false
	return
end if

end event

