type m_conciliacindetarjetas1 from menu within m_sistema
end type

event clicked;
string ls_proy_anam, ls_error

 SELECT isnull(ccmparam.para_proy_anam,'N')
    INTO :ls_proy_anam
    FROM ccmparam  
    WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
          ( ccmparam.para_empresa = :str.empresa )   ;
if sqlca.sqldbcode = -1 then
	ls_error = sqlca.sqlerrtext
	Rollback;
	mensaje("Error","Ha ocurrido un error al recuperar el tipo de pais-region",ls_error)
end if
	

if ls_proy_anam = 'S' then
	SetPointer(HourGlass!)
	//OpenSheet(w_cc_man_mensajes,parentwindow,9,Original!)
else
	SetPointer(HourGlass!)
	//OpenSheet(w_cc_man_para_concili_mensajes,parentwindow,9,Original!)
end if
end event

