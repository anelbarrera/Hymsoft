event clicked;string ls_imprime,ls_pais_region, ls_error,ls_proyeccion,ls_consolida,&
       ls_proy_anam, ls_siafpa
  
  SELECT isnull(ccmparam.para_imprime_informe,'N'),
			isnull(ccmparam.para_cambio_pais_region,'N'),
			isnull(ccmparam.para_proyeccion_cobros,'N'),
			isnull(ccmparam.para_consolidados,'N'),
			isnull(ccmparam.para_proy_anam,'N'),
			isnull(ccmparam.para_siafpa,'N')
    INTO :ls_imprime,:ls_pais_region,:ls_proyeccion,:ls_consolida,:ls_proy_anam,:ls_siafpa
    FROM ccmparam  
    WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
          ( ccmparam.para_empresa = :str.empresa )   ;
if sqlca.sqldbcode = -1 then
	ls_error = sqlca.sqlerrtext
	Rollback;
	mensaje("Error","Ha ocurrido un error al recuperar el tipo de pais-region",ls_error)
end if
	
	
if ls_imprime = 'S' then
	m_reportes.m_informediariodecaja.visible = true
else
	m_reportes.m_informediariodecaja.visible = false
end if	

//Colegio de Contadores

if ls_pais_region = 'S' then
	this.m_cobros.m_porpasoregin.text = 'por Asociación / Vendedor'
else
	this.m_cobros.m_porpasoregin.text = 'Por País / Vendedor'
end if

if ls_consolida = 'S' then //VICSONS
	this.m_antigüedad.m_antigüedadconsolidada.visible = true
else
	this.m_antigüedad.m_antigüedadconsolidada.visible = false
end if

//proyeccion de cobros BR VICSONS
if ls_proyeccion = 'S' then
	this.m_cobros.m_proyeccioncobros.visible = true
else
	this.m_cobros.m_proyeccioncobros.visible = false 
end if

//Anam
//Informes de Ingresos ANAM
if ls_proy_anam = 'S' then
	if ls_siafpa = 'S' then
		this.m_7.visible = true
		this.m_8.visible = true
	elseif ls_siafpa = 'N' then
		this.m_7.visible = false
		this.m_8.visible = false
	end if
	
//	this.m_informediariodecaja.visible = false
	this.m_declientes.m_saldosporzonasdeventas.visible = false
	this.m_cobros.m_porpasoregin.visible = false
	this.m_movimientos.m_depositosregistrados.visible = false
else
	this.m_7.visible = false 
	this.m_8.visible = false 
//	this.m_informediariodecaja.visible = true
	this.m_declientes.m_saldosporzonasdeventas.visible = true
	this.m_cobros.m_porpasoregin.visible = true
	this.m_movimientos.m_depositosregistrados.visible = true
end if

//Para que se oculte informe de cajas
if pos(Upper(str.empr_acceso_especial),'ACISA,') > 0 then
	this.m_informediariodecaja.visible = false	
end if

if pos(Upper(str.empr_acceso_especial),'ROFA,') > 0 then
	this.m_informediariodecaja.m_consolidado.visible= false
end if

if pos(Upper(str.empr_acceso_especial),'CORPINSA,') > 0 or pos(Upper(str.empr_acceso_especial),'FOSTER,') > 0 then
	this.m_declientes.m_estadoconsolidado.visible = true
end if
end event

event selected;string ls_tag

//Llamado de funcion de acceso a opciones (SEGURIDAD)
ls_tag = this.Tag

if gf_ss_accesos(str.grupo,'CC','m_cc_padre',ls_tag) = true then
	this.enabled = true
else
	this.enabled = false
	return
end if

end event

