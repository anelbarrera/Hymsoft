this.toolbarbackcolor = 15780518
this.toolbarhighlightcolor = 8388608
this.toolbargradient = true
this.bitmapgradient = true
this.m_clientes2=create m_clientes2
this.m_transacciones2=create m_transacciones2
this.m_otros1=create m_otros1
this.Item[UpperBound(this.Item)+1]=this.m_clientes2
this.Item[UpperBound(this.Item)+1]=this.m_transacciones2
this.Item[UpperBound(this.Item)+1]=this.m_otros1
end on

