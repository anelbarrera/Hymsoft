event clicked;    integer li_cant_cierre
	 SELECT count(*)  
    INTO  :li_cant_cierre  
    FROM  ccbinfcja  
    WHERE ( ccbinfcja.infcja_g_financiero = :str.empresa ) AND  
          ( ccbinfcja.infcja_empresa = :str.g_financiero ) AND  
          ( ccbinfcja.infcja_aplicacion = 'CC' )   ;
			
		    if li_cant_cierre = 0 then
				SetPointer(HourGlass!)
				//OpenSheet(w_cc_man_infocaja_captura_tran,parentwindow,9,Original!)
			 else
	          mensaje('Informacion', 'Sr. Usuario ya existe un cierre del Informe de Caja', 'Recuerde que esta opción solo se ejecuta una sola vez')
	       end if	




end event

