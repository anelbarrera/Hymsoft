end type

on m_consultas.create
call super::create
this.tag = "m_cc_padre.m_consultas"
this.text = "&Consultas"
this.checked = true
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 8388608
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbarstyle = contemporarytoolbar!
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 15780518
this.toolbarhighlightcolor = 8388608
this.toolbargradient = true
this.bitmapgradient = true
this.m_clientes=create m_clientes
this.m_-1=create m_-1
this.m_transacciones1=create m_transacciones1
this.m_-10=create m_-10
this.m_informedecajadiaria=create m_informedecajadiaria
this.m_otrasconsultas=create m_otrasconsultas
this.Item[UpperBound(this.Item)+1]=this.m_clientes
this.Item[UpperBound(this.Item)+1]=this.m_-1
this.Item[UpperBound(this.Item)+1]=this.m_transacciones1
this.Item[UpperBound(this.Item)+1]=this.m_-10
this.Item[UpperBound(this.Item)+1]=this.m_informedecajadiaria
this.Item[UpperBound(this.Item)+1]=this.m_otrasconsultas
end on

on m_consultas.destroy
call super::destroy
destroy(this.m_clientes)
destroy(this.m_-1)
destroy(this.m_transacciones1)
destroy(this.m_-10)
destroy(this.m_informedecajadiaria)
destroy(this.m_otrasconsultas)
end on

event clicked;string ls_imprime, ls_proy, ls_error
  
  SELECT ccmparam.para_imprime_informe,
         isnull(ccmparam.para_proy_anam,'N')
    INTO :ls_imprime,:ls_proy
    FROM ccmparam  
    WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
          ( ccmparam.para_empresa = :str.empresa )   ;
if sqlca.sqldbcode = -1 then
	ls_error = sqlca.sqlerrtext
	Rollback;
	mensaje("Error","Ha ocurrido un error al recuperar el tipo de pais-region",ls_error)
end if

	
if ls_imprime = 'S' then
	m_consultas.m_informedecajadiaria.enabled = true
else
	m_consultas.m_informedecajadiaria.enabled = false
end if	

//ANAM
if ls_proy = 'S' then
	m_consultas.m_otrasconsultas.m_calendariodepago.visible = true
	m_consultas.m_informedecajadiaria.visible = false
	this.m_clientes.m_estadistica.visible = false
	this.m_transacciones1.m_depositos.visible = false
	this.m_transacciones1.m_recibosdecobrosporregional.visible = true
else
	m_consultas.m_otrasconsultas.m_calendariodepago.visible = false
	this.m_clientes.m_estadistica.visible = true
	this.m_transacciones1.m_depositos.visible = true
	this.m_transacciones1.m_recibosdecobrosporregional.visible = false
end if

//Para que se oculte la consulta de informe de cajas consolidado
if pos(Upper(str.empr_acceso_especial),'ACISA,') > 0 then
	m_consultas.m_informedecajadiaria.m_consolidado1.visible = false
end if

if pos(Upper(str.empr_acceso_especial),'ROFA,') > 0 then
	m_consultas.m_informedecajadiaria.m_consolidado1.visible = false
end if
end event

