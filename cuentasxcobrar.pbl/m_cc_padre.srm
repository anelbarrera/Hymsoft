event clicked;SetPointer(HourGlass!)
String ls_null, ls_ejecutar
////OpenSheet(w_cc_infocaja_co_informe_caja,parentwindow,9,layered!)

ls_ejecutar = str.path + "Project1\comprobante.exe"

if pos(Upper(str.empr_acceso_especial),'ACISA,') > 0 then
	SetNull (ls_null)
	ShellExecuteA(Handle(this), ls_null, ls_ejecutar, &
																		ls_null, ls_null, 1)
else
	//OpenSheet(w_cc_co_infocaja_empresa,parentwindow,9,layered!)
end if
end event

