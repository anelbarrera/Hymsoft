type m_facturaciondeservicios from menu within m_parmetros
end type

event clicked;string ls_fact_anam, ls_error,ls_siafpa

  SELECT isnull(ccmparam.para_proy_anam,'N'),
			isnull(ccmparam.para_siafpa,'N')
    INTO :ls_fact_anam,:ls_siafpa
    FROM ccmparam  
   WHERE ( ccmparam.para_g_financiero = :str.g_financiero ) AND  
         ( ccmparam.para_empresa = :str.empresa )   ;
if sqlca.sqlcode = - 1 then
	ls_error = sqlca.sqlerrtext
	messagebox('Error','Error al recuperar ls_fact_anam en ccmparam : '+ls_error)
	return
end if

if ls_fact_anam  = 'S' then
	if ls_siafpa = 'S' then
		SetPointer(HourGlass!)
//		//OpenSheet(w_cc_man_servicios_anam,parentwindow,9,Original!)
	elseif ls_siafpa = 'N' then
		SetPointer(HourGlass!)
		//OpenSheet(w_cc_man_servicios,parentwindow,9,Original!)
	end if
else
	SetPointer(HourGlass!)
	//OpenSheet(w_cc_man_servicios,parentwindow,9,Original!)
end if
end event

