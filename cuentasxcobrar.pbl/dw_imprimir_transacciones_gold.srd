 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cctmovim~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaregio~" )  TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"dgmserie~" )  TABLE(NAME=~"dgmsubse~" )  TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"cctmovim.movi_documento~") COLUMN(NAME=~"cctmovim.movi_anno~") COLUMN(NAME=~"cctmovim.movi_referencia~") COLUMN(NAME=~"cctmovim.movi_fecha_tran~") COLUMN(NAME=~"cctmovim.movi_monto~") COLUMN(NAME=~"dgmserie.mser_descripcion~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"dgaregio.regi_descripcion~") COLUMN(NAME=~"cctmovim.movi_a_nombre~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"dgmterce.terc_telefono1~") COLUMN(NAME=~"dgmterce.terc_telefono2~") COLUMN(NAME=~"dgmterce.terc_fax1~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_direccion~") COLUMN(NAME=~"dgmempre.empr_telefono1~") COLUMN(NAME=~"dgmempre.empr_telefono2~") COLUMN(NAME=~"dgmempre.empr_fax1~") COLUMN(NAME=~"dgmempre.empr_e_mail~") COLUMN(NAME=~"dgmempre.empr_logo_t~") COLUMN(NAME=~"cctmovim.movi_tercero~") COLUMN(NAME=~"cctmovim.movi_ruc_tercero~") COLUMN(NAME=~"cctmovim.movi_comentario~") COLUMN(NAME=~"cctmovim.movi_efectivo~") COLUMN(NAME=~"cctmovim.movi_cheque~") COLUMN(NAME=~"cctmovim.movi_comments~") COLUMN(NAME=~"cctmovim.movi_fecha_vence~") COLUMN(NAME=~"cctmovim.movi_usuario~")    JOIN (LEFT=~"dgmsubse.subs_g_financiero~"    OP =~"=~"RIGHT=~"cctmovim.movi_g_financiero~" )    JOIN (LEFT=~"dgmsubse.subs_empresa~"    OP =~"=~"RIGHT=~"cctmovim.movi_empresa~" )    JOIN (LEFT=~"dgmsubse.subs_transaccion~"    OP =~"=~"RIGHT=~"cctmovim.movi_tipo_transaccion~" )    JOIN (LEFT=~"dgmsubse.subs_sub_trans~"    OP =~"=~"RIGHT=~"cctmovim.movi_sub_transaccion~" )    JOIN (LEFT=~"dgmterce.terc_region~"    OP =~"=~"RIGHT=~"dgaregio.regi_codigo_region~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgaregio.regi_pais~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"cctmovim.movi_tercero~" )    JOIN (LEFT=~"cctmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"cctmovim.movi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"cctmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"dgmserie.mser_g_financiero~" )    JOIN (LEFT=~"cctmovim.movi_empresa~"    OP =~"=~"RIGHT=~"dgmserie.mser_empresa~" )    JOIN (LEFT=~"cctmovim.movi_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmserie.mser_tipo_transaccion~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )WHERE(    EXP1 =~"cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_aplicacion~"   OP =~"=~"    EXP2 =~":app~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_tipo_transaccion~"   OP =~"=~"    EXP2 =~":transaccion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_documento~"   OP =~"=~"    EXP2 =~":docu~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_anno~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_tipo_transaccion+cctmovim.movi_sub_transaccion~"   OP =~"<>~"    EXP2 =~"'ND8'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_sub_transaccion~"   OP =~"=~"    EXP2 =~":subtran~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"docu~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"app~" TYPE = string)  ARG(NAME = ~"subtran~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("transaccion", string),("docu", string),("ann", number),("app", string),("subtran", string)) )
