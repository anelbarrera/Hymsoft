 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cctantig~" ) COLUMN(NAME=~"cctantig.ant_g_financiero~") COLUMN(NAME=~"cctantig.ant_empresa~") COLUMN(NAME=~"cctantig.ant_tercero~") COLUMN(NAME=~"cctantig.ant_inicio~") COLUMN(NAME=~"cctantig.ant_fin~") COLUMN(NAME=~"cctantig.ant_usuario_maquina~") COLUMN(NAME=~"cctantig.ant_facturas~") COLUMN(NAME=~"cctantig.ant_recibos~") COLUMN(NAME=~"cctantig.ant_saldo~")WHERE(    EXP1 =~"cctantig.ant_g_financiero~"   OP =~"=~"    EXP2 =~":g_f~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctantig.ant_empresa~"   OP =~"=~"    EXP2 =~":emp~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctantig.ant_usuario_maquina~"   OP =~"=~"    EXP2 =~":maquina~" ) ) ORDER(NAME=~"cctantig.ant_g_financiero~" ASC=yes )  ORDER(NAME=~"cctantig.ant_empresa~" ASC=yes )  ORDER(NAME=~"cctantig.ant_tercero~" ASC=yes )  ORDER(NAME=~"cctantig.ant_inicio~" ASC=yes ) ARG(NAME = ~"g_f~" TYPE = number)  ARG(NAME = ~"emp~" TYPE = number)  ARG(NAME = ~"maquina~" TYPE = string) " update="cctantig" updatewhere=1 updatekeyinplace=yes arguments=(("g_f", number),("emp", number),("maquina", string))  sort="ant_g_financiero A ant_empresa A ant_tercero A ant_inicio D " )
