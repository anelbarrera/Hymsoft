table(column=(type=datetime updatewhereclause=yes name=cctmovim_movi_fecha_tran dbname="cctmovim.movi_fecha_tran" )
 column=(type=char(20) updatewhereclause=yes name=cctmovim_movi_ruc_tercero dbname="cctmovim.movi_ruc_tercero" )
 column=(type=char(100) updatewhereclause=yes name=cctmovim_movi_a_nombre dbname="cctmovim.movi_a_nombre" )
 column=(type=decimal(2) updatewhereclause=yes name=cctmovim_movi_tarjeta dbname="cctmovim.movi_tarjeta" )
 column=(type=decimal(2) updatewhereclause=yes name=cctmovim_movi_porcentaje_visa dbname="cctmovim.movi_porcentaje_visa" )
 column=(type=decimal(2) updatewhereclause=yes name=cctmovim_movi_comision dbname="cctmovim.movi_comision" )
 column=(type=decimal(15) updatewhereclause=yes name=comision_visa dbname="comision_visa" )
 column=(type=char(8) updatewhereclause=yes name=movi_documento dbname="cctmovim.movi_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=movi_tercero dbname="cctmovim.movi_tercero" )
 column=(type=decimal(0) updatewhereclause=yes name=movi_anno dbname="cctmovim.movi_anno" )
 column=(type=char(2) updatewhereclause=yes name=movi_tipo_transaccion dbname="cctmovim.movi_tipo_transaccion" )
 column=(type=char(3) updatewhereclause=yes name=movi_sub_transaccion dbname="cctmovim.movi_sub_transaccion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ccmparam~" )  TABLE(NAME=~"cctmovim~" ) COLUMN(NAME=~"cctmovim.movi_fecha_tran~") COLUMN(NAME=~"cctmovim.movi_ruc_tercero~") COLUMN(NAME=~"cctmovim.movi_a_nombre~") COLUMN(NAME=~"cctmovim.movi_tarjeta~") COLUMN(NAME=~"cctmovim.movi_porcentaje_visa~") COLUMN(NAME=~"cctmovim.movi_comision~") COMPUTE(NAME=~"round(cctmovim.movi_tarjeta *  ( ccmparam.para_visa / 100),2)  comision_visa~") COLUMN(NAME=~"cctmovim.movi_documento~") COLUMN(NAME=~"cctmovim.movi_tercero~") COLUMN(NAME=~"cctmovim.movi_anno~") COLUMN(NAME=~"cctmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cctmovim.movi_sub_transaccion~")    JOIN (LEFT=~"cctmovim.movi_empresa~"    OP =~"=~"RIGHT=~"ccmparam.para_empresa~" )    JOIN (LEFT=~"cctmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"ccmparam.para_g_financiero~" )WHERE(    EXP1 =~"cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_fecha_tran~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_fecha_tran~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_tarjeta~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("fecha1", datetime),("fecha2", datetime)) )
