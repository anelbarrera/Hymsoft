 column=(type=char(250) updatewhereclause=yes name=ccmparam_para_mens_mora dbname="ccmparam.para_mens_mora" dbalias=".para_mens_mora" )
 column=(type=char(1) updatewhereclause=yes name=ccmparam_para_mostrar_mora dbname="ccmparam.para_mostrar_mora" dbalias=".para_mostrar_mora" )
 column=(type=long updatewhereclause=yes name=page dbname="page" )
 column=(type=decimal(2) updatewhereclause=yes name=suma dbname="suma" )
 column=(type=char(15) updatewhereclause=yes name=vi_cc_movimientos_movi_referencia dbname="vi_cc_movimientos.movi_referencia" dbalias=".movi_referencia" )
 column=(type=char(40) updatewhereclause=yes name=ccmclien_clie_contacto dbname="ccmclien.clie_contacto" dbalias=".clie_contacto" )
 column=(type=char(100) updatewhereclause=yes name=pais_descripcion dbname="pais_descripcion" )
 retrieve="  SELECT dgmterce.terc_descripcion,   
         ccmclien.clie_tercero,   
         dgmterce.terc_identificacion,   
         ccmclien.clie_ruc_tercero,   
         vi_cc_movimientos.movi_tipo_transaccion,   
         vi_cc_movimientos.movi_sub_transaccion,   
         vi_cc_movimientos.movi_documento,   
         vi_cc_movimientos.movi_monto,   
         vi_cc_movimientos.movi_fecha_tran,   
         vi_cc_movimientos.subs_descripcion,   
         vi_cc_movimientos.movi_naturaleza,   
         vi_cc_movimientos.movi_estado,   
         vi_cc_movimientos.movi_saldo,
         vi_cc_movimientos.movi_fecha_reg,
         dgmterce.terc_direccion,   
         dgmterce.terc_telefono1,   
         dgmterce.terc_telefono2,   
         dgmterce.terc_apartado_postal,   
         dgmterce.terc_pais,   
         dgmterce.terc_region,   
         ccmclien.clie_ref_anterior,   
         dgaregio.regi_descripcion,   
         ccatpan.tpan_col1,   
         ccatpan.tpan_col2,   
         ccatpan.tpan_col3,   
         ccatpan.tpan_col4,   
         ccatpan.tpan_col5,   
         ccatpan.tpan_col6, 
         ccatpan.tpan_col7,   
         ccatpan.tpan_col8,    
         ccatpan.tpan_col9,   
         ccatpan.tpan_col10,  
         ccatpan.tpan_col11,   
         ccatpan.tpan_col12,  
         ccatpan.tpan_col13,   
         ccatpan.tpan_col21,   
         ccatpan.tpan_col1_t,   
         ccatpan.tpan_col2_t,   
         ccatpan.tpan_col3_t,   
         ccatpan.tpan_col4_t,   
         ccatpan.tpan_col5_t,   
         ccatpan.tpan_col6_t, 
         ccatpan.tpan_col7_t,   
         ccatpan.tpan_col8_t,   
         ccatpan.tpan_col9_t,   
         ccatpan.tpan_col10_t,   
         ccatpan.tpan_col11_t,   
         ccatpan.tpan_col12_t, 
         ccatpan.tpan_col13_t,  
         ccatpan.tpan_col21_t,
			ccatpan.tpan_saldo_anterior, 
         '' empre_logo,   
         dgmempre.empr_direccion,   
         dgmempre.empr_apartado_postal,   
         dgmempre.empr_telefono1,   
         dgmempre.empr_telefono2,   
         dgmempre.empr_fax1,   
         dgmempre.empr_fax2,   
         dgmempre.empr_e_mail,   
         dgmterce.terc_email,   
         ccmclien.clie_g_financiero,   
         ccmclien.clie_empresa,   
         ccmparam.para_mens_aldia,   
         ccmparam.para_mens_mora,   
         ccmparam.para_mostrar_mora,
         page = 1 ,
ccatpan.tpan_col1 + ccatpan.tpan_col2 +ccatpan.tpan_col3 + ccatpan.tpan_col4 + ccatpan.tpan_col5  + ccatpan.tpan_col6 + ccatpan.tpan_col7 + ccatpan.tpan_col8 + ccatpan.tpan_col9 + ccatpan.tpan_col10 +ccatpan.tpan_col11 +ccatpan.tpan_col12 +ccatpan.tpan_col13 +ccatpan.tpan_col21 suma,
vi_cc_movimientos.movi_referencia   ,
			ccmclien.clie_contacto,
			pais_descripcion = (select p.pais_descripcion from dgapais p where dgmterce.terc_pais = p.pais_pais)
    FROM vi_cc_movimientos,   
         dgmterce,   
         ccmclien,   
         dgaregio,   
         ccatpan,   
         dgmempre,   
         ccmparam  
   WHERE ( vi_cc_movimientos.movi_g_financiero = ccmclien.clie_g_financiero) and  
         ( vi_cc_movimientos.movi_empresa = ccmclien.clie_empresa) and  
         ( vi_cc_movimientos.movi_tercero = ccmclien.clie_tercero) and  
         ( ccmclien.clie_g_financiero = ccatpan.tpan_g_financiero ) and  
         ( ccmclien.clie_empresa = ccatpan.tpan_empresa ) and  
         ( ccmclien.clie_tercero = ccatpan.tpan_tercero ) and  
         ( dgaregio.regi_codigo_region = dgmterce.terc_region ) and  
         ( dgaregio.regi_pais = dgmterce.terc_pais ) and  
         ( dgmterce.terc_tercero = ccmclien.clie_tercero ) and  
         ( dgmempre.empr_g_financiero = ccmclien.clie_g_financiero ) and  
         ( dgmempre.empr_empresa = ccmclien.clie_empresa ) and  
         ( ccmparam.para_g_financiero = dgmempre.empr_g_financiero ) and  
         ( ccmparam.para_empresa = dgmempre.empr_empresa ) and  
         ( ( ccmclien.clie_g_financiero = :gfinanciero ) AND  
         ( ccmclien.clie_empresa = :empresa ) AND  
			( ccatpan.tpan_col1 + ccatpan.tpan_col2 +ccatpan.tpan_col3 + ccatpan.tpan_col4 + ccatpan.tpan_col5  + ccatpan.tpan_col6 + ccatpan.tpan_col7 + ccatpan.tpan_col8 + ccatpan.tpan_col9 + ccatpan.tpan_col10 +ccatpan.tpan_col11 +ccatpan.tpan_col12 +ccatpan.tpan_col13 +ccatpan.tpan_col21 > 0) and
         dgmterce.terc_pais >= :desdecliente AND  
         dgmterce.terc_pais <= :hastacliente AND  
         ( vi_cc_movimientos.movi_fecha_tran >= :fecha1 ) AND  
         ( vi_cc_movimientos.movi_fecha_tran <= dateadd(dd,1,:fecha2)) AND  
         ( vi_cc_movimientos.movi_estado = 'IM' ) ) AND  
         vi_cc_movimientos.movi_tipo_transaccion+vi_cc_movimientos.movi_naturaleza <> 'RCD' AND  
         vi_cc_movimientos.movi_tran_contado <> 'S'    
" arguments=(("gfinanciero", number),("empresa", number),("fecha1", datetime),("fecha2", datetime),("desdecliente", number),("hastacliente", number))  sort="dgmterce_terc_pais A ccmclien_clie_ref_anterior A vi_cc_movimientos_movi_fecha_tran A vi_cc_movimientos_movi_tipo_transaccion A vi_cc_movimientos_movi_fecha_reg A " )
