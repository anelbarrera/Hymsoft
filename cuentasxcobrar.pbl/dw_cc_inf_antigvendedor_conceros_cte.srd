rcero~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"dgaregio.regi_codigo_region~"    OP =~"=~"RIGHT=~"dgmterce.terc_region~" )    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgmterce.terc_pais~" )    JOIN (LEFT=~"ccmclien.clie_g_financiero~"    OP =~"=~"RIGHT=~"famvende.vend_g_financiero~" )    JOIN (LEFT=~"ccmclien.clie_empresa~"    OP =~"=~"RIGHT=~"famvende.vend_empresa~" )    JOIN (LEFT=~"ccmclien.clie_vendedor~"    OP =~"=~"RIGHT=~"famvende.vend_vendedor~" )WHERE(    EXP1 =~"ccatpan.tpan_g_financiero~"   OP =~"=~"    EXP2 =~":gf~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccatpan.tpan_empresa~"   OP =~"=~"    EXP2 =~":emp~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccatpan.tpan_maquina~"   OP =~"=~"    EXP2 =~":maq~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccatpan.tpan_tercero~"   OP =~"<>~"    EXP2 =~"99999~" ) ) ARG(NAME = ~"gf~" TYPE = number)  ARG(NAME = ~"emp~" TYPE = number)  ARG(NAME = ~"maq~" TYPE = string) " arguments=(("gf", number),("emp", number),("maq", string))  sort="dgapais_pais_descripcion A dgaregio_regi_descripcion A ccmclien_clie_ref_anterior A " )
