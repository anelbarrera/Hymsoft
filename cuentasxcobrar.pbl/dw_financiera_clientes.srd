 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccmclien~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_tipo_persona~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"dgmterce.terc_telefono1~") COLUMN(NAME=~"dgmterce.terc_telefono2~") COLUMN(NAME=~"dgmterce.terc_fax1~") COLUMN(NAME=~"dgmterce.terc_fax2~") COLUMN(NAME=~"dgmterce.terc_email~") COLUMN(NAME=~"dgmterce.terc_apartado_postal~") COLUMN(NAME=~"dgmterce.terc_pais~") COLUMN(NAME=~"dgmterce.terc_clasificacion~") COLUMN(NAME=~"dgmterce.terc_clave_tercero~") COLUMN(NAME=~"dgmterce.terc_region~") COLUMN(NAME=~"dgmterce.terc_digito_verificador~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COLUMN(NAME=~"ccmclien.clie_contacto~") COLUMN(NAME=~"ccmclien.clie_contacto_cargo~") COLUMN(NAME=~"ccmclien.clie_contacto_telefono~") COLUMN(NAME=~"ccmclien.clie_comentario~") COLUMN(NAME=~"ccmclien.clie_clasificacion~") COLUMN(NAME=~"dgmterce.terc_tipo~") COLUMN(NAME=~"ccmclien.clie_mg_cuenta~") COLUMN(NAME=~"ccmclien.clie_limite_credito~") COLUMN(NAME=~"ccmclien.clie_estado~") COLUMN(NAME=~"ccmclien.clie_vendedor~") COLUMN(NAME=~"ccmclien.clie_limite_morosidad~") COLUMN(NAME=~"ccmclien.clie_cargo_morocidad~") COMPUTE(NAME=~"0 cambiar_limite~") COLUMN(NAME=~"ccmclien.clie_cuenta_mala~") COLUMN(NAME=~"ccmclien.clie_foto_pasaporte~") COLUMN(NAME=~"ccmclien.clie_cuenta_oficial~") COLUMN(NAME=~"ccmclien.clie_pasaporte~") COLUMN(NAME=~"ccmclien.clie_cuenta_relacionada~") COLUMN(NAME=~"ccmclien.clie_cuenta_relacionada2~") COLUMN(NAME=~"ccmclien.clie_exento_itbm~") COLUMN(NAME=~"dgmterce.terc_provincia~") COLUMN(NAME=~"dgmterce.terc_distrito~") COLUMN(NAME=~"dgmterce.terc_corregimiento~") COLUMN(NAME=~"dgmterce.terc_tipo_fact~") COMPUTE(NAME=~"cod_pais = (select max(p.pais_fe_codigo) from dgapais p where dgmterce.terc_pais = p.pais_pais)~")    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"ccmclien.clie_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccmclien.clie_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccmclien.clie_tercero~"   OP =~"=~"    EXP2 =~":tercero~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"tercero~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("tercero", number)) )
