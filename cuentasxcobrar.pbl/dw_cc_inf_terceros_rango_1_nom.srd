table(column=(type=decimal(0) updatewhereclause=yes name=ccmclien_clie_tercero dbname="ccmclien.clie_tercero" dbalias=".clie_tercero" )
 column=(type=decimal(0) updatewhereclause=yes name=ccmclien_clie_empresa dbname="ccmclien.clie_empresa" dbalias=".clie_empresa" )
 column=(type=long updatewhereclause=yes name=ccmclien_clie_clasificacion dbname="ccmclien.clie_clasificacion" dbalias=".clie_clasificacion" )
 column=(type=char(20) updatewhereclause=yes name=ccmclien_clie_ruc_tercero dbname="ccmclien.clie_ruc_tercero" dbalias=".clie_ruc_tercero" )
 retrieve="  SELECT DISTINCT ccmclien.clie_tercero,   
         ccmclien.clie_empresa,   
         ccmclien.clie_clasificacion,
         ccmclien.clie_ruc_tercero  
    FROM dgmterce,   
         ccmclien  
   WHERE ( ccmclien.clie_tercero = dgmterce.terc_tercero ) and  
         ( ( ccmclien.clie_g_financiero = :grupo ) AND  
         ( ccmclien.clie_empresa = :empresa ) AND  
         ( rtrim(dgmterce.terc_descripcion) +convert(char(5),dgmterce.terc_tercero) = :desdecliente ) AND  
         ( rtrim(dgmterce.terc_descripcion) +convert(char(5),dgmterce.terc_tercero) = :hastacliente ) )   
ORDER BY ccmclien.clie_empresa ASC,   
         ccmclien.clie_tercero ASC   
" arguments=(("grupo", number),("empresa", number),("desdecliente", string),("hastacliente", string)) )
