 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"faddiari.facd_codigo_item~") COMPUTE(NAME=~"sum( case when facd_precio_recargo <= 0.80 then facd_monto_final else 0 end ) corriente_monto~") COMPUTE(NAME=~"sum( CASE  WHEN facd_precio_recargo <=  0.80 THEN facd_cantidad else 0 end ) corriente_gramos~") COMPUTE(NAME=~"sum( case when facd_precio_recargo > 0.80 and facd_precio_recargo <= 1.99 then facd_monto_final else 0 end ) especial_monto1~") COMPUTE(NAME=~"sum( case when facd_precio_recargo > 0.80 and facd_precio_recargo <= 1.99 then facd_cantidad else 0 end ) especial_gramos1~") COMPUTE(NAME=~"sum( case when facd_precio_recargo > 1.99 and facd_precio_recargo <= 3.50 then facd_monto_final else 0 end ) especial_monto2~") COMPUTE(NAME=~"sum( case when facd_precio_recargo > 1.99 and facd_precio_recargo <= 3.50 then facd_cantidad else 0 end ) especial_gramos2~") COMPUTE(NAME=~"sum( case when facd_precio_recargo > 3.50 then facd_cantidad else 0 end ) especial_gramos3~") COMPUTE(NAME=~"sum( case when facd_precio_recargo > 3.50 then facd_monto_final else 0 end ) especial_monto3~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"faddiari.facd_codigo_item~" )WHERE(    EXP1 =~"faddiari.facd_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_cliente~"   OP =~"=~"    EXP2 =~":tercero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~" )  GROUP(NAME=~"faddiari.facd_codigo_item~")) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"tercero~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("tercero", number)) )
