 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"badetalledep~" ) COLUMN(NAME=~"badetalledep.deta_g_financiero~") COLUMN(NAME=~"badetalledep.deta_empresa~") COLUMN(NAME=~"badetalledep.deta_tipo_transaccion~") COLUMN(NAME=~"badetalledep.deta_sub_transaccion~") COLUMN(NAME=~"badetalledep.deta_documento~") COLUMN(NAME=~"badetalledep.deta_anno~") COLUMN(NAME=~"badetalledep.deta_banco~") COLUMN(NAME=~"badetalledep.deta_cuenta~") COLUMN(NAME=~"badetalledep.deta_no_recibo~") COLUMN(NAME=~"badetalledep.deta_recib_anno~") COLUMN(NAME=~"badetalledep.deta_tipo_recibo~") COLUMN(NAME=~"badetalledep.deta_subtipo_recibo~") COLUMN(NAME=~"badetalledep.deta_monto~") COLUMN(NAME=~"badetalledep.deta_efectivo~") COLUMN(NAME=~"badetalledep.deta_cheque~") COLUMN(NAME=~"badetalledep.deta_tarjeta~") COLUMN(NAME=~"badetalledep.deta_referencia_recibo~") COLUMN(NAME=~"badetalledep.deta_tercero~") COLUMN(NAME=~"badetalledep.deta_a_nombre~")WHERE(    EXP1 =~"badetalledep.deta_g_financiero~"   OP =~"=~"    EXP2 =~":det_grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"badetalledep.deta_empresa~"   OP =~"=~"    EXP2 =~":det_empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"badetalledep.deta_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'SD'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"badetalledep.deta_sub_transaccion~"   OP =~"=~"    EXP2 =~"'0'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"badetalledep.deta_banco~"   OP =~"=~"    EXP2 =~":det_banco~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"badetalledep.deta_cuenta~"   OP =~"=~"    EXP2 =~":det_cuenta~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"badetalledep.deta_documento~"   OP =~"=~"    EXP2 =~":det_documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"badetalledep.deta_anno~"   OP =~"=~"    EXP2 =~":det_ann~" ) ) ARG(NAME = ~"det_grupo~" TYPE = number)  ARG(NAME = ~"det_empresa~" TYPE = number)  ARG(NAME = ~"det_banco~" TYPE = number)  ARG(NAME = ~"det_cuenta~" TYPE = string)  ARG(NAME = ~"det_documento~" TYPE = string)  ARG(NAME = ~"det_ann~" TYPE = number) " update="badetalledep" updatewhere=1 updatekeyinplace=no arguments=(("det_grupo", number),("det_empresa", number),("det_banco", number),("det_cuenta", string),("det_documento", string),("det_ann", number)) )
