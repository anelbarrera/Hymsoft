table(column=(type=char(20) updatewhereclause=yes name=fact_ruc_cliente dbname="fact_ruc_cliente" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fact_a_nombre" )
 column=(type=char(250) updatewhereclause=yes name=comentario dbname="comentario" )
 column=(type=decimal(6) updatewhereclause=yes name=cantidad dbname="cantidad" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_cliente dbname="fatdiari.fact_cliente" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_factura dbname="fact_no_factura" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fact_ann" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"ccmclien~" ) COMPUTE(NAME=~"max(fact_ruc_cliente) fact_ruc_cliente~") COMPUTE(NAME=~"max(fact_a_nombre) fact_a_nombre~") COMPUTE(NAME=~"max(clie_comentario) comentario~") COMPUTE(NAME=~"sum(facd_cantidad - facd_cantidad_cerrada ) cantidad~") COLUMN(NAME=~"fatdiari.fact_cliente~") COMPUTE(NAME=~"max(fact_no_factura) fact_no_factura~") COMPUTE(NAME=~"max(fact_ann) fact_ann~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"ccmclien.clie_g_financiero~"    OP =~"=~"RIGHT=~"fatdiari.fact_g_financiero~" )    JOIN (LEFT=~"ccmclien.clie_empresa~"    OP =~"=~"RIGHT=~"fatdiari.fact_empresa~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"fatdiari.fact_cliente~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_metal_pendiente~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_cierre_de_metal~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~" )  GROUP(NAME=~"fatdiari.fact_cliente~") GROUP(NAME=~"fatdiari.fact_no_pedido~") GROUP(NAME=~"fatdiari.fact_ann~")) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " filter="cantidad <> 0"arguments=(("grupo", number),("empresa", number))  sort="fact_cliente A fact_no_factura A " )
