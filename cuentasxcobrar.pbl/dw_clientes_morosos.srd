 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ccmclien~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccatpan~" ) COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"ccmclien.clie_limite_morosidad~") COLUMN(NAME=~"ccmclien.clie_cargo_morocidad~") COLUMN(NAME=~"ccmclien.clie_tercero~") COLUMN(NAME=~"ccatpan.tpan_col1~") COLUMN(NAME=~"ccatpan.tpan_col2~") COLUMN(NAME=~"ccatpan.tpan_col3~") COLUMN(NAME=~"ccatpan.tpan_col4~") COLUMN(NAME=~"ccatpan.tpan_col5~") COLUMN(NAME=~"ccatpan.tpan_col6~") COLUMN(NAME=~"ccatpan.tpan_col7~") COLUMN(NAME=~"ccatpan.tpan_col8~") COLUMN(NAME=~"ccatpan.tpan_col9~") COLUMN(NAME=~"ccatpan.tpan_col10~") COLUMN(NAME=~"ccatpan.tpan_col21~") COLUMN(NAME=~"ccatpan.tpan_col11~") COLUMN(NAME=~"ccatpan.tpan_col12~") COLUMN(NAME=~"ccatpan.tpan_col13~") COMPUTE(NAME=~"round( tpan_col1 +  tpan_col2  +  tpan_col3  +  tpan_col4 +  tpan_col5 +  tpan_col6 +  tpan_col7 + tpan_col8 + tpan_col9 + tpan_col10 + tpan_col11 + tpan_col12 + tpan_col13, 2) saldo~") COMPUTE(NAME=~"round( round( tpan_col1 +  tpan_col2  +  tpan_col3  +  tpan_col4 +  tpan_col5 +  tpan_col6 +  tpan_col7 + tpan_col8 + tpan_col9 + tpan_col10 + tpan_col11 + tpan_col12 + tpan_col13, 2) *  ( ccmclien.clie_cargo_morocidad / 100 ) ,2) cargo~") COMPUTE(NAME=~"0 aplicar~")    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )    JOIN (LEFT=~"ccmclien.clie_g_financiero~"    OP =~"=~"RIGHT=~"ccatpan.tpan_g_financiero~" )    JOIN (LEFT=~"ccmclien.clie_empresa~"    OP =~"=~"RIGHT=~"ccatpan.tpan_empresa~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"ccatpan.tpan_tercero~" )WHERE(    EXP1 =~"ccmclien.clie_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccmclien.clie_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccmclien.clie_estado~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccmclien.clie_cuenta_mala~"   OP =~"<>~"    EXP2 =~"1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccmclien.clie_cargo_morocidad~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccatpan.tpan_maquina~"   OP =~"=~"    EXP2 =~":maquina~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccatpan.tpan_col21~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"datediff( dd, ccmclien.clie_fecha_intereses, getdate())~"   OP =~">~"    EXP2 =~"30~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"maquina~" TYPE = string) " filter=" saldo  > 0"arguments=(("grupo", number),("empresa", number),("maquina", string)) )
