table(column=(type=decimal(2) updatewhereclause=yes name=saldo_aldia dbname="saldo_aldia" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" initial="spaces" )
 column=(type=char(15) updatewhereclause=yes name=ccmclien_clie_ref_anterior dbname="ccmclien.clie_ref_anterior" dbalias=".clie_ref_anterior" )
 column=(type=decimal(0) updatewhereclause=yes name=terc_tercero dbname="terc_tercero" )
 column=(type=char(12) updatewhereclause=yes name=terc_telefono1 dbname="terc_telefono1" )
 column=(type=long updatewhereclause=yes name=clie_clasificacion dbname="clie_clasificacion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ccmclien~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"cctmovim~" ) COMPUTE(NAME=~"sum(case cctmovim.movi_naturaleza when 'D' then cctmovim.movi_monto else - cctmovim.movi_monto end) saldo_aldia~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COMPUTE(NAME=~"max(terc_tercero) terc_tercero~") COMPUTE(NAME=~"max(terc_telefono1) terc_telefono1~") COMPUTE(NAME=~"max(clie_clasificacion) clie_clasificacion~")    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )    JOIN (LEFT=~"ccmclien.clie_g_financiero~"    OP =~"=~"RIGHT=~"cctmovim.movi_g_financiero~" )    JOIN (LEFT=~"ccmclien.clie_empresa~"    OP =~"=~"RIGHT=~"cctmovim.movi_empresa~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"cctmovim.movi_tercero~" )WHERE(    EXP1 =~"ccmclien.clie_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccmclien.clie_empresa~"   OP =~"=~"    EXP2 =~":empresa~" )  GROUP(NAME=~"ccmclien.clie_ref_anterior~") GROUP(NAME=~"dgmterce.terc_descripcion~")) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " filter=" saldo_aldia > 0"arguments=(("grupo", number),("empresa", number))  sort="dgmterce_terc_descripcion A " )
