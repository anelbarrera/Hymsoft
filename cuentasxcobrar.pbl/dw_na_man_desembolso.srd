 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ntdesem~" ) COLUMN(NAME=~"ntdesem.desem_g_financiero~") COLUMN(NAME=~"ntdesem.desem_empresa~") COLUMN(NAME=~"ntdesem.desem_desembolso~") COLUMN(NAME=~"ntdesem.desem_ann~") COLUMN(NAME=~"ntdesem.desem_fecha~") COLUMN(NAME=~"ntdesem.desem_cuenta_mg~") COLUMN(NAME=~"ntdesem.desem_pagado_a~") COLUMN(NAME=~"ntdesem.desem_monto~") COLUMN(NAME=~"ntdesem.desem_class~") COLUMN(NAME=~"ntdesem.desem_wording~") COLUMN(NAME=~"ntdesem.desem_descripcion~") COLUMN(NAME=~"ntdesem.desem_usuario~") COLUMN(NAME=~"ntdesem.desem_status~") COLUMN(NAME=~"ntdesem.desem_cuenta~") COLUMN(NAME=~"ntdesem.desem_transito~") COLUMN(NAME=~"ntdesem.desem_cargado_a~") COLUMN(NAME=~"ntdesem.desem_caja~") COLUMN(NAME=~"ntdesem.desem_tercero~") COMPUTE(NAME=~"right( ntdesem.desem_transito , 4) ann~") COLUMN(NAME=~"ntdesem.desem_no_caso~") COLUMN(NAME=~"ntdesem.desem_fecha_registro~") COLUMN(NAME=~"ntdesem.desem_monto_final~") COLUMN(NAME=~"ntdesem.desem_valor_itbm~") COLUMN(NAME=~"ntdesem.desem_paga_itbm~") COLUMN(NAME=~"ntdesem.desem_cuenta_itbm~")WHERE(    EXP1 =~"ntdesem.desem_g_financiero~"   OP =~"=~"    EXP2 =~":gfinan~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ntdesem.desem_empresa~"   OP =~"=~"    EXP2 =~":emp~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ntdesem.desem_desembolso~"   OP =~"=~"    EXP2 =~":desem~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ntdesem.desem_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"gfinan~" TYPE = number)  ARG(NAME = ~"emp~" TYPE = number)  ARG(NAME = ~"desem~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " update="ntdesem" updatewhere=1 updatekeyinplace=yes arguments=(("gfinan", number),("emp", number),("desem", number),("ann", number)) )
