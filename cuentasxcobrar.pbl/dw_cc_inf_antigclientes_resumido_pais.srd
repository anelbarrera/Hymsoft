_t~") COMPUTE(NAME=~"rtrim(tpan_col14_t) as tpan_col14_t~") COMPUTE(NAME=~"rtrim(tpan_col15_t) as tpan_col15_t~") COMPUTE(NAME=~"rtrim(tpan_col16_t) as tpan_col16_t~")    JOIN (LEFT=~"ccatpan.tpan_g_financiero~"    OP =~"=~"RIGHT=~"ccmclien.clie_g_financiero~" )    JOIN (LEFT=~"ccatpan.tpan_empresa~"    OP =~"=~"RIGHT=~"ccmclien.clie_empresa~" )    JOIN (LEFT=~"ccatpan.tpan_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"dgaregio.regi_codigo_region~"    OP =~"=~"RIGHT=~"dgmterce.terc_region~" )    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgmterce.terc_pais~" )WHERE(    EXP1 =~"( ( ccatpan.tpan_g_financiero~"   OP =~"=~"    EXP2 =~":gf )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ccatpan.tpan_empresa~"   OP =~"=~"    EXP2 =~":emp )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(ccatpan.tpan_maquina~"   OP =~"=~"    EXP2 =~":maq ) ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(ccatpan.tpan_tercero~"   OP =~"<>~"    EXP2 =~"99999))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccmclien.clie_cuenta_mala~"   OP =~"<>~"    EXP2 =~"1~" ) ) ARG(NAME = ~"gf~" TYPE = number)  ARG(NAME = ~"emp~" TYPE = number)  ARG(NAME = ~"maq~" TYPE = string) " arguments=(("gf", number),("emp", number),("maq", string))  sort="dgapais_pais_descripcion A dgaregio_regi_descripcion A dgmterce_terc_descripcion A ccmclien_clie_ref_anterior A " )
