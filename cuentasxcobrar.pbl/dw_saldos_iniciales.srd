 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cctmovim~" )  TABLE(NAME=~"ccmparam~" ) COLUMN(NAME=~"cctmovim.movi_g_financiero~") COLUMN(NAME=~"cctmovim.movi_empresa~") COLUMN(NAME=~"cctmovim.movi_aplicacion~") COLUMN(NAME=~"cctmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cctmovim.movi_sub_transaccion~") COLUMN(NAME=~"cctmovim.movi_documento~") COLUMN(NAME=~"cctmovim.movi_anno~") COLUMN(NAME=~"cctmovim.movi_referencia~") COLUMN(NAME=~"cctmovim.movi_tercero~") COLUMN(NAME=~"cctmovim.movi_ruc_tercero~") COLUMN(NAME=~"cctmovim.movi_naturaleza~") COLUMN(NAME=~"cctmovim.movi_monto~") COLUMN(NAME=~"cctmovim.movi_fecha_tran~") COLUMN(NAME=~"cctmovim.movi_usuario~") COLUMN(NAME=~"ccmparam.para_fecha_ini_apli~") COLUMN(NAME=~"cctmovim.movi_estado~")    JOIN (LEFT=~"cctmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"ccmparam.para_g_financiero~" )    JOIN (LEFT=~"cctmovim.movi_empresa~"    OP =~"=~"RIGHT=~"ccmparam.para_empresa~" )WHERE(    EXP1 =~"cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_aplicacion~"   OP =~"=~"    EXP2 =~"'CC'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'ND'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_sub_transaccion~"   OP =~"=~"    EXP2 =~"'8'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " update="cctmovim" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number))  sort="long(movi_referencia) A " )
