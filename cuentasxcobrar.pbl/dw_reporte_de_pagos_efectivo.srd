 column=(type=decimal(2) updatewhereclause=yes name=cctmovim_movi_efectivo dbname="cctmovim.movi_efectivo" dbalias=".movi_efectivo" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cctmovim~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccmclien~" ) COLUMN(NAME=~"cctmovim.movi_monto~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"cctmovim.movi_tercero~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COLUMN(NAME=~"cctmovim.movi_documento~") COLUMN(NAME=~"cctmovim.movi_fecha_tran~") COLUMN(NAME=~"cctmovim.movi_sub_transaccion~") COLUMN(NAME=~"cctmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cctmovim.movi_anno~") COLUMN(NAME=~"cctmovim.movi_aplicacion~") COLUMN(NAME=~"cctmovim.movi_comments~") COLUMN(NAME=~"ccmclien.clie_clasificacion~") COLUMN(NAME=~"cctmovim.movi_efectivo~")    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"cctmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"ccmclien.clie_g_financiero~" )    JOIN (LEFT=~"cctmovim.movi_empresa~"    OP =~"=~"RIGHT=~"ccmclien.clie_empresa~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"cctmovim.movi_tercero~" )WHERE(    EXP1 =~"( cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cctmovim.movi_fecha_tran~"   OP =~">=~"    EXP2 =~":fecha_inicio )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cctmovim.movi_fecha_tran~"   OP =~"<=~"    EXP2 =~":fecha_final )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_estado~"   OP =~"=~"    EXP2 =~"'IM'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(((cctmovim.movi_tipo_transaccion+cctmovim.movi_naturaleza~"   OP =~"=~"    EXP2 =~":transaccion + 'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"cctmovim.movi_tipo_transaccion+cctmovim.movi_naturaleza~"   OP =~"=~"    EXP2 =~"'RMC' )))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_efectivo~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha_inicio~" TYPE = datetime)  ARG(NAME = ~"fecha_final~" TYPE = datetime)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"descripcion~" TYPE = string) " arguments=(("g_financiero", number),("empresa", number),("fecha_inicio", datetime),("fecha_final", datetime),("transaccion", string),("descripcion", string))  sort="cctmovim_movi_fecha_tran A movi_documento A " )
