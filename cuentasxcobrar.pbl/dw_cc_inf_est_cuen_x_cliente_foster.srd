~") COLUMN(NAME=~"ccmclien.clie_contacto~") COLUMN(NAME=~"dgmempre.empr_direccion~") COLUMN(NAME=~"dgmempre.empr_apartado_postal~") COLUMN(NAME=~"dgmempre.empr_telefono1~") COLUMN(NAME=~"dgmempre.empr_telefono2~") COLUMN(NAME=~"dgmempre.empr_fax1~") COLUMN(NAME=~"dgmempre.empr_fax2~") COLUMN(NAME=~"dgmempre.empr_e_mail~") COLUMN(NAME=~"ccmclien.clie_g_financiero~") COLUMN(NAME=~"ccmclien.clie_empresa~") COLUMN(NAME=~"ccmparam.para_mens_aldia~") COLUMN(NAME=~"ccmparam.para_mens_mora~") COMPUTE(NAME=~"page = 1~") COLUMN(NAME=~"vi_cc_movimientos.movi_saldo~") COLUMN(NAME=~"ccmparam.para_mostrar_mora~") COLUMN(NAME=~"ccatpan.tpan_saldo_anterior~") COLUMN(NAME=~"ccmclien.clie_a_nombrede~") COLUMN(NAME=~"ccmparam.para_estcuenta_anombrede~") COLUMN(NAME=~"ccmclien.clie_socio~") COLUMN(NAME=~"ccmclien.clie_auditor~") COLUMN(NAME=~"dgmempre.empr_icono~") COMPUTE(NAME=~"ccatpan.tpan_col1 + ccatpan.tpan_col2 +ccatpan.tpan_col3 + ccatpan.tpan_col4 + ccatpan.tpan_col5  + ccatpan.tpan_col6 + ccatpan.tpan_col7 + ccatpan.tpan_col8 + ccatpan.tpan_col9 + ccatpan.tpan_col10 + ccatpan.tpan_col21 suma~") COLUMN(NAME=~"vi_cc_movimientos.movi_tran_contado~") COLUMN(NAME=~"ccatpan.tpan_col9~") COLUMN(NAME=~"ccatpan.tpan_col10~") COLUMN(NAME=~"ccatpan.tpan_col9_t~") COLUMN(NAME=~"ccatpan.tpan_col10_t~") COLUMN(NAME=~"ccatpan.tpan_col11~") COLUMN(NAME=~"ccatpan.tpan_col12~") COLUMN(NAME=~"ccatpan.tpan_col13~") COLUMN(NAME=~"ccatpan.tpan_col11_t~") COLUMN(NAME=~"ccatpan.tpan_col12_t~") COLUMN(NAME=~"ccatpan.tpan_col13_t~") COLUMN(NAME=~"dgaregio.regi_codigo_area~") COLUMN(NAME=~"dgapais.pais_codigo_pais~") COLUMN(NAME=~"vi_cc_movimientos.movi_ann~")    JOIN (LEFT=~"vi_cc_movimientos.movi_g_financiero~"    OP =~"=~"RIGHT=~"ccmclien.clie_g_financiero~"    OUTER2 =~"ccmclien.clie_g_financiero~" )    JOIN (LEFT=~"vi_cc_movimientos.movi_empresa~"    OP =~"=~"RIGHT=~"ccmclien.clie_empresa~"    OUTER2 =~"ccmclien.clie_empresa~" )    JOIN (LEFT=~"vi_cc_movimientos.movi_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~"    OUTER2 =~"ccmclien.clie_tercero~" )    JOIN (LEFT=~"ccmclien.clie_g_financiero~"    OP =~"=~"RIGHT=~"ccatpan.tpan_g_financiero~" )    JOIN (LEFT=~"ccmclien.clie_empresa~"    OP =~"=~"RIGHT=~"ccatpan.tpan_empresa~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"ccatpan.tpan_tercero~" )    JOIN (LEFT=~"dgaregio.regi_codigo_region~"    OP =~"=~"RIGHT=~"dgmterce.terc_region~" )    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgmterce.terc_pais~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )    JOIN (LEFT=~"dgmempre.empr_g_financiero~"    OP =~"=~"RIGHT=~"ccmclien.clie_g_financiero~" )    JOIN (LEFT=~"dgmempre.empr_empresa~"    OP =~"=~"RIGHT=~"ccmclien.clie_empresa~" )    JOIN (LEFT=~"ccmparam.para_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"ccmparam.para_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"dgapais.pais_pais~"    OP =~"=~"RIGHT=~"dgaregio.regi_pais~" )WHERE(    EXP1 =~"( ( ccmclien.clie_g_financiero~"   OP =~"=~"    EXP2 =~":gfinanciero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ccmclien.clie_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( vi_cc_movimientos.movi_fecha_tran~"   OP =~">=~"    EXP2 =~":fecha1 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( vi_cc_movimientos.movi_fecha_tran~"   OP =~"<=~"    EXP2 =~":fecha2 ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"vi_cc_movimientos.movi_estado~"   OP =~"=~"    EXP2 =~"'IM'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"vi_cc_movimientos.movi_tran_contado~"   OP =~"<>~"    EXP2 =~"'S'~" ) ) ARG(NAME = ~"gfinanciero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("gfinanciero", number),("empresa", number),("fecha1", datetime),("fecha2", datetime))  sort="dgmterce_terc_descripcion A vi_cc_movimientos_movi_fecha_tran A " )
