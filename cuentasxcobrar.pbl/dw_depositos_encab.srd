 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"batdiari~" ) COLUMN(NAME=~"batdiari.btdi_g_financiero~") COLUMN(NAME=~"batdiari.btdi_empresa~") COLUMN(NAME=~"batdiari.btdi_tipo_transaccion~") COLUMN(NAME=~"batdiari.btdi_sub_transaccion~") COLUMN(NAME=~"batdiari.btdi_banco~") COLUMN(NAME=~"batdiari.btdi_no_cuenta~") COLUMN(NAME=~"batdiari.btdi_documento~") COLUMN(NAME=~"batdiari.btdi_ann~") COLUMN(NAME=~"batdiari.btdi_aplicacion~") COLUMN(NAME=~"batdiari.btdi_fecha_tran~") COLUMN(NAME=~"batdiari.btdi_comentario~") COLUMN(NAME=~"batdiari.btdi_estado~") COLUMN(NAME=~"batdiari.btdi_id_usuario_registra~") COLUMN(NAME=~"batdiari.btdi_monto~") COLUMN(NAME=~"batdiari.btdi_conciliacion~") COLUMN(NAME=~"batdiari.btdi_referencia~") COLUMN(NAME=~"batdiari.btdi_aplica_origen~")WHERE(    EXP1 =~"( batdiari.btdi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( batdiari.btdi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( batdiari.btdi_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'SD' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( batdiari.btdi_sub_transaccion~"   OP =~"=~"    EXP2 =~"'0' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( batdiari.btdi_banco~"   OP =~"=~"    EXP2 =~":banco )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( batdiari.btdi_no_cuenta~"   OP =~"=~"    EXP2 =~":cuenta )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( batdiari.btdi_documento~"   OP =~"=~"    EXP2 =~":documento )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( batdiari.btdi_ann~"   OP =~"=~"    EXP2 =~":annio )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"batdiari.btdi_aplicacion~"   OP =~"=~"    EXP2 =~"'CC'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"banco~" TYPE = number)  ARG(NAME = ~"cuenta~" TYPE = string)  ARG(NAME = ~"documento~" TYPE = string)  ARG(NAME = ~"annio~" TYPE = number) " update="batdiari" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("banco", number),("cuenta", string),("documento", string),("annio", number)) )
