 column=(type=char(12) updatewhereclause=yes name=empr_fax2 dbname="dgmempre.empr_fax2" dbalias=".empr_fax2" )
 column=(type=char(40) updatewhereclause=yes name=dgmempre_empr_e_mail dbname="dgmempre.empr_e_mail" dbalias=".empr_e_mail" )
 column=(type=char(20) updatewhereclause=yes name=dgmempre_empr_apartado_postal dbname="dgmempre.empr_apartado_postal" dbalias=".empr_apartado_postal" )
 column=(type=decimal(2) updatewhereclause=yes name=ntdesem_desem_valor_itbm dbname="ntdesem.desem_valor_itbm" dbalias=".desem_valor_itbm" )
 column=(type=decimal(2) updatewhereclause=yes name=ntdesem_desem_monto_final dbname="ntdesem.desem_monto_final" dbalias=".desem_monto_final" )
 column=(type=decimal(0) updatewhereclause=yes name=ntdesem_desem_paga_itbm dbname="ntdesem.desem_paga_itbm" dbalias=".desem_paga_itbm" )
 retrieve="  SELECT ntdesem.desem_pagado_a,   
         ntdesem.desem_transito,   
         ntdesem.desem_fecha,   
         ntdesem.desem_monto,   
         ntdesem.desem_desembolso,   
         ntdesem.desem_descripcion,
			ntdesem.desem_usuario,
			ntdesem.desem_caja,
			ntdesem.desem_cuenta_mg,
			ntdesem.desem_cuenta,
			ntdesem.desem_tercero,
			ntdesem.desem_no_caso,
         dgmempre.empr_ficha,   
         dgmempre.empr_rollo,   
         dgmempre.empr_imagen,   
         dgmempre.empr_dijito_verificador,   
         dgmempre.empr_direccion,   
         dgmempre.empr_telefono1,   
         dgmempre.empr_telefono2,   
         dgmempre.empr_fax1,   
         dgmempre.empr_fax2,   
         dgmempre.empr_e_mail,   
         dgmempre.empr_apartado_postal,
		desem_valor_itbm,
		desem_monto_final,
		desem_paga_itbm
    FROM ntdesem,
			dgmempre
	WHERE ( dgmempre.empr_g_financiero = ntdesem.desem_g_financiero ) AND
			( dgmempre.empr_empresa = ntdesem.desem_empresa ) AND
			( ntdesem.desem_g_financiero = :gfinan ) AND  
         ( ntdesem.desem_empresa = :emp ) AND  
         ( ntdesem.desem_caja = :caja ) AND  
         ( ntdesem.desem_desembolso >= :desem ) AND  
         ( ntdesem.desem_desembolso <= :desem2 ) " arguments=(("gfinan", number),("emp", number),("caja", string),("desem", number),("desem2", number)) )
