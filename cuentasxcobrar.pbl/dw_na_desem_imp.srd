 column=(type=char(5) updatewhereclause=yes name=dgmempre_empr_dijito_verificador dbname="dgmempre.empr_dijito_verificador" dbalias=".empr_dijito_verificador" )
 column=(type=char(100) updatewhereclause=yes name=dgmempre_empr_direccion dbname="dgmempre.empr_direccion" dbalias=".empr_direccion" )
 column=(type=char(12) updatewhereclause=yes name=empr_telefono1 dbname="dgmempre.empr_telefono1" dbalias=".empr_telefono1" )
