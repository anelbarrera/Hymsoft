table(column=(type=decimal(0) update=yes updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" initial="0" )
 column=(type=char(20) update=yes updatewhereclause=yes name=terc_identificacion dbname="dgmterce.terc_identificacion" )
 column=(type=char(60) update=yes updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" )
 column=(type=char(150) updatewhereclause=yes name=terc_direccion dbname="dgmterce.terc_direccion" )
 column=(type=char(20) updatewhereclause=yes name=mg_cuenta dbname="ccmclien.clie_mg_cuenta" initial="spaces" )
 column=(type=char(162) updatewhereclause=yes name=descrip dbname="descrip" )
 column=(type=char(15) updatewhereclause=yes name=clie_ref_anterior dbname="ccmclien.clie_ref_anterior" )
 column=(type=char(20) updatewhereclause=yes name=clie_ruc_tercero dbname="ccmclien.clie_ruc_tercero" )
 column=(type=decimal(0) updatewhereclause=yes name=dgmterce_terc_region dbname="dgmterce.terc_region" )
 column=(type=decimal(0) updatewhereclause=yes name=dgmterce_terc_pais dbname="dgmterce.terc_pais" )
 column=(type=decimal(0) updatewhereclause=yes name=ccmclien_clie_vendedor dbname="ccmclien.clie_vendedor" )
 column=(type=long updatewhereclause=yes name=clie_clasificacion dbname="ccmclien.clie_clasificacion" )
 column=(type=decimal(0) updatewhereclause=yes name=clie_socio dbname="ccmclien.clie_socio" )
 column=(type=decimal(0) updatewhereclause=yes name=clie_auditor dbname="ccmclien.clie_auditor" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccmclien~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"ccmclien.clie_mg_cuenta~") COMPUTE(NAME=~"dgmterce.terc_descripcion+'                                                                                                 '+convert(varchar(5) , dgmterce.terc_tercero) descrip~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COLUMN(NAME=~"ccmclien.clie_ruc_tercero~") COLUMN(NAME=~"dgmterce.terc_region~") COLUMN(NAME=~"dgmterce.terc_pais~") COLUMN(NAME=~"ccmclien.clie_vendedor~") COLUMN(NAME=~"ccmclien.clie_clasificacion~") COLUMN(NAME=~"ccmclien.clie_socio~") COLUMN(NAME=~"ccmclien.clie_auditor~")    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )WHERE(    EXP1 =~"( ccmclien.clie_g_financiero~"   OP =~"=~"    EXP2 =~":clie_grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ccmclien.clie_empresa~"   OP =~"=~"    EXP2 =~":clie_empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(ccmclien.clie_estado~"   OP =~"in~"    EXP2 =~"('A','AC'))~" ) ) ARG(NAME = ~"clie_grupo~" TYPE = number)  ARG(NAME = ~"clie_empresa~" TYPE = number) " arguments=(("clie_grupo", number),("clie_empresa", number))  sort="terc_descripcion A " )
