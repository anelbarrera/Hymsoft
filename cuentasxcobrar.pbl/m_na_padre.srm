this.toolbaritemvisible = false
this.toolbaritemtext = "Foto del producto"
end on

event clicked;//Check y Uncheck de la opcion
If This.Checked Then
	This.UnCheck()
	This.ToolbarItemDown	= False
	str.frame.GetActiveSheet().Event Dynamic Trigger ue_foto(False)
Else
	This.Check()
	This.ToolbarItemDown	= True
	str.frame.GetActiveSheet().Event Dynamic Trigger ue_foto(True)	
End If
end event

on m_verfoto.destroy
call super::destroy
end on

