this.m_clasedecargos=create m_clasedecargos
this.m_cargos=create m_cargos
this.m_-5=create m_-5
this.m_clientes=create m_clientes
this.m_-8=create m_-8
this.m_banderas=create m_banderas
this.m_barconave=create m_barconave
