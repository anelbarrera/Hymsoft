type prototypes
Function long ShellExecuteA (ulong hwind, string lpOperation, string lpFile, string lpParameters, string lpDirectory, long nShowCmd) library "shell32.dll" alias for "ShellExecuteA;Ansi"
end prototypes

type variables
str_fa_carg_ped str_formato
str_fa_formato str_formato_pr

end variables

forward prototypes
public subroutine mf_selecciona_formato (ref integer ai_existe, ref boolean ab_aceptar, ref string as_tipo_formato, ref string as_forma_formato)
public subroutine mf_selec_formato (ref integer ai_existe, ref boolean ab_aceptar, ref string as_tipo_formato, ref string as_forma_formato)
public subroutine mf_actualiza_reservados ()
public subroutine mf_subcontrol ()
end prototypes

public subroutine mf_selecciona_formato (ref integer ai_existe, ref boolean ab_aceptar, ref string as_tipo_formato, ref string as_forma_formato);/* Esta función verifica cuantos formatos existen del documento
solicitado, si hay más de uno abre la ventana de selección, si sólo
hay uno toma el datawindow del mismo y abre la ventana principal*/

String	ls_dberror

SELECT count(*) 
 INTO :ai_existe
    FROM faaforma  
   WHERE (faaforma.forma_tipo_formato = :as_tipo_formato ) AND  
         (faaforma.forma_formato =:as_forma_formato);   
	if sqlca.sqlcode = -1 then
		mensaje("Aviso","Error al Validar Existencia del Formato",sqlca.sqlerrtext)
		return
	end if

if ai_existe <= 0 then
	mensaje("Atención ","No se ha configurado el formato del documento, por favor contacte al personal de soporte, o al programador..gracias", "")
	ab_aceptar = false
	return
End If

	// Sólo hay un formato no abre ventana selección de formatos
	Declare cur_formato cursor for
	  SELECT faaforma.forma_datawindow  
	 FROM faaforma  
   WHERE (faaforma.forma_tipo_formato = :as_tipo_formato ) AND  
         (faaforma.forma_formato = :as_forma_formato)
			Order by forma_cod_fomato ;   
	
	if sqlca.sqlcode = -1 then
		ls_dberror = sqlca.sqlerrtext
		mensaje("Atención ","Error al declarar el cursor", ls_dberror)
		ab_aceptar = false
		return
	End If
	
	//Abre el cursor
	open cur_formato;
	if sqlca.sqlcode = -1 then
		ls_dberror = sqlca.sqlerrtext
		mensaje("Atención ","Error al abrir el cursor", ls_dberror)
		ab_aceptar = false
		return
	End If
	
	//Selecciona el primer registro del cursor
	fetch cur_formato into :str_formato.datawindow ;
	
	if sqlca.sqlcode = -1 then
		ls_dberror = sqlca.sqlerrtext
		mensaje("Atención ","Error en el fetch del cursor", ls_dberror)
		ab_aceptar = false
		return
	End If
	
	//Cierra el cursor
	close cur_formato;
	
	
//Scrip que asigna el datawindow de listas de empaques de facturas
if as_forma_formato = 'LEMPQ' then
  integer li_pos
  li_pos = pos(str_formato.datawindow,"_pedi_")
  str_formato.datawindow2	= left(str_formato.datawindow,li_pos)+"fact_"+mid(str_formato.datawindow,li_pos + 6)
end if


ab_aceptar = true

end subroutine

public subroutine mf_selec_formato (ref integer ai_existe, ref boolean ab_aceptar, ref string as_tipo_formato, ref string as_forma_formato);/*Scrip agregado por HGN el 20 de marzo del 2000*/

/* Esta función verifica cuantos formatos existen del documento
solicitado, si hay más de uno abre la ventana de selección, si sólo
hay uno toma el datawindow del mismo y abre la ventana principal*/

String	ls_dberror

SELECT count(*) 
 INTO :ai_existe
    FROM faaforma  
   WHERE (faaforma.forma_tipo_formato = :as_tipo_formato ) AND  
         (faaforma.forma_formato =:as_forma_formato);   

if ai_existe <= 0 then
	mensaje("Atención ","No se ha configurado el formato del documento, por favor contacte al personal de soporte, o al programador..gracias", "")
	ab_aceptar = false
	return
End If

If ai_existe = 1 then
	// Sólo hay un formato no abre ventana selección de formatos
	  SELECT faaforma.forma_datawindow  
	 INTO :str_formato.datawindow 
	 FROM faaforma  
   WHERE (faaforma.forma_tipo_formato = :as_tipo_formato ) AND  
         (faaforma.forma_formato = :as_forma_formato);   
	
	if sqlca.sqlcode = -1 then
		ls_dberror = sqlca.sqlerrtext
		mensaje("Atención ","Error al leer el formato del documento", ls_dberror)
		ab_aceptar = false
		return
	End If
	
	//Scrip que asigna el datawindow de listas de empaques de facturas
	if as_forma_formato = 'LEMPQ' then
	  integer li_pos
	  li_pos = pos(str_formato.datawindow,"_pedi_")
     str_formato.datawindow2	= left(str_formato.datawindow,li_pos)+"fact_"+mid(str_formato.datawindow,li_pos + 6)	  
   end if
end  if

ab_aceptar = true

end subroutine

public subroutine mf_actualiza_reservados ();string ls_error

 str.frame.setmicrohelp("Inicializando los Productos Reservados.............por favor Espere")

 sqlca.autocommit = false
 
  UPDATE inmprodu  
     SET prod_reserva_total = 0  
	  where prod_g_financiero = :str.g_financiero and
	  		  prod_empresa		  = :str.empresa ;
	  
	  if sqlca.sqlcode = -1 then
		ls_error = sqlca.sqlerrtext
		rollback;
		mensaje("Aviso","Error al Actualizar las Reservas a 0 (inmprodu) ",ls_error)
		sqlca.autocommit = true
		return
	  end if

  UPDATE inmbodeg  
     SET mbod_reserva = 0  
	  Where mbod_g_financiero = :str.g_financiero and
	  		  mbod_empresa	= :str.empresa ;

	  if sqlca.sqlcode = -1 then
		ls_error = sqlca.sqlerrtext
		rollback;
		mensaje("Aviso","Error al Actualizar las Reservas a 0 (inmbodeg) ",ls_error)
		sqlca.autocommit = true
		return
	  end if

str.frame.setmicrohelp("Actualizando los Productos Reservados.............por favor Espere")

/*Actualiza los reservados del producto, procedentes de pedidos*/
  UPDATE inmprodu  
     SET prod_reserva_total = prod_reserva_total + vi_reserva.reservado  
    FROM inmprodu,   
         vi_reserva  
   WHERE ( inmprodu.prod_g_financiero = vi_reserva.dped_g_financiero ) AND  
         ( inmprodu.prod_empresa      = vi_reserva.dped_empresa ) AND  
         ( inmprodu.prod_producto     = vi_reserva.dped_codigo_item )  AND
			( inmprodu.prod_g_financiero = :str.g_financiero ) AND
	  		( inmprodu.prod_empresa		  = :str.empresa ) ;
	  if sqlca.sqlcode = -1 then
		ls_error = sqlca.sqlerrtext
		rollback;
		mensaje("Aviso","Error al Actualizar las Reservas de los Productos ",ls_error)
		sqlca.autocommit = true
		return
	  end if

/*Actualiza los reservados del producto, procedentes de factura*/
  UPDATE inmprodu  
     SET prod_reserva_total = prod_reserva_total + vi_reserva_fac.reservado
    FROM inmprodu,   
         vi_reserva_fac  
   WHERE ( inmprodu.prod_g_financiero = vi_reserva_fac.facd_g_financiero ) AND  
         ( inmprodu.prod_empresa = vi_reserva_fac.facd_empresa ) AND  
         ( inmprodu.prod_producto = vi_reserva_fac.facd_codigo_item ) AND
			( inmprodu.prod_g_financiero = :str.g_financiero ) AND
	  		( inmprodu.prod_empresa		  = :str.empresa ) ;
			
	  if sqlca.sqlcode = -1 then
		ls_error = sqlca.sqlerrtext
		rollback;
		mensaje("Aviso","Error al Actualizar las Reservas de Productos ",ls_error)
		sqlca.autocommit = true
		return
	  end if

/*Para actualizar las cantidades pasadas con la cantidad total del Registro, si la cantidad
 pasada es mayor a la total*/
  UPDATE fadpedid  
     SET dped_pasada = fadpedid.dped_cantidad * inamedid.medi_cantidad + fadpedid.dped_fraccion  
    FROM fadpedid,   
         inamedid  
   WHERE ( fadpedid.dped_pasada > fadpedid.dped_cantidad * inamedid.medi_cantidad + fadpedid.dped_fraccion ) AND  
         ( fadpedid.dped_unidad_venta = inamedid.medi_medida ) AND
			( fadpedid.dped_g_financiero = :str.g_financiero ) AND
			( fadpedid.dped_empresa = :str.empresa );
			
	  if sqlca.sqlcode = -1 then
		ls_error = sqlca.sqlerrtext
		rollback;
		mensaje("Aviso","Error al Actualizar las Cantidades Pasadas",ls_error)
		sqlca.autocommit = true
		return
	  end if

/*Actualiza los reservados por bodega, procedentes de factura*/
 str.frame.setmicrohelp("Actualizando los Productos Reservados por Bodega.............por favor Espere")

  UPDATE inmbodeg  
     SET mbod_reserva = mbod_reserva + vi_reserva_fac_bodega.reservado
    FROM inmbodeg,   
         vi_reserva_fac_bodega  
   WHERE ( inmbodeg.mbod_g_financiero = vi_reserva_fac_bodega.facd_g_financiero ) AND  
         ( inmbodeg.mbod_empresa = vi_reserva_fac_bodega.facd_empresa ) AND  
         ( inmbodeg.mbod_bodega = vi_reserva_fac_bodega.facd_bodega ) AND  
         ( inmbodeg.mbod_ubicacion = vi_reserva_fac_bodega.facd_ubicacion ) AND  
         ( inmbodeg.mbod_producto = vi_reserva_fac_bodega.facd_codigo_item ) AND
			( inmbodeg.mbod_g_financiero = :str.g_financiero ) AND  
         ( inmbodeg.mbod_empresa = :str.empresa );
			
	  if sqlca.sqlcode = -1 then
		ls_error = sqlca.sqlerrtext
		rollback;
		mensaje("Aviso","Error al Actualizar las Reservas de productos por bodega ",ls_error)
		sqlca.autocommit = true
		return
	  end if
			

/*Actualiza los reservados por bodega, procedentes de pedidos*/
  UPDATE inmbodeg  
     SET mbod_reserva = mbod_reserva  +  vi_reserva_ped_bodega.reservado
    FROM inmbodeg,   
         vi_reserva_ped_bodega  
   WHERE ( inmbodeg.mbod_g_financiero = vi_reserva_ped_bodega.dped_g_financiero ) AND  
         ( inmbodeg.mbod_empresa = vi_reserva_ped_bodega.dped_empresa ) AND  
         ( inmbodeg.mbod_bodega = vi_reserva_ped_bodega.dped_bodega ) AND  
         ( inmbodeg.mbod_ubicacion = vi_reserva_ped_bodega.dped_ubicacion ) AND  
         ( inmbodeg.mbod_producto = vi_reserva_ped_bodega.dped_codigo_item ) AND
			( inmbodeg.mbod_g_financiero = :str.g_financiero ) AND  
         ( inmbodeg.mbod_empresa = :str.empresa ) ;
	  if sqlca.sqlcode = -1 then
		ls_error = sqlca.sqlerrtext
		rollback;
		mensaje("Aviso","Error al Actualizar las Reservas de productos por bodega ",ls_error)
		sqlca.autocommit = true
		return
	  end if
	
	
	//Si no manda error , guarda en la base de datos
	
	commit;

	sqlca.autocommit = true	
	
end subroutine

public subroutine mf_subcontrol ();
end subroutine

