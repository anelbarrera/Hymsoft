this.m_plantillas=create m_plantillas
this.m_cajas=create m_cajas
this.Item[UpperBound(this.Item)+1]=this.m_inicialesdelsistemaalquiler
this.Item[UpperBound(this.Item)+1]=this.m_-4
this.Item[UpperBound(this.Item)+1]=this.m_clasedecargos
