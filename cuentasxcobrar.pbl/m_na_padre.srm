on m_ventanas.create
call super::create
this.tag = "m_na_padre.m_ventanas"
this.text = "&Ventanas"
this.m_horizontal=create m_horizontal
this.m_vertical=create m_vertical
this.m_pantallacompleta=create m_pantallacompleta
this.m_cascada=create m_cascada
this.m_-6=create m_-6
this.m_zoom=create m_zoom
this.m_zoom2=create m_zoom2
this.m_zoom3=create m_zoom3
this.m_regla=create m_regla
this.Item[UpperBound(this.Item)+1]=this.m_horizontal
this.Item[UpperBound(this.Item)+1]=this.m_vertical
this.Item[UpperBound(this.Item)+1]=this.m_pantallacompleta
this.Item[UpperBound(this.Item)+1]=this.m_cascada
this.Item[UpperBound(this.Item)+1]=this.m_-6
this.Item[UpperBound(this.Item)+1]=this.m_zoom
this.Item[UpperBound(this.Item)+1]=this.m_zoom2
this.Item[UpperBound(this.Item)+1]=this.m_zoom3
this.Item[UpperBound(this.Item)+1]=this.m_regla
end on

on m_ventanas.destroy
call super::destroy
destroy(this.m_horizontal)
destroy(this.m_vertical)
destroy(this.m_pantallacompleta)
destroy(this.m_cascada)
destroy(this.m_-6)
destroy(this.m_zoom)
destroy(this.m_zoom2)
destroy(this.m_zoom3)
destroy(this.m_regla)
end on

