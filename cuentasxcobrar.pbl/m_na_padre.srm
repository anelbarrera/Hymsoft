this.Item[UpperBound(this.Item)+1]=this.m_200%
end on

on m_zoom.destroy
call super::destroy
destroy(this.m_20%)
destroy(this.m_40%)
destroy(this.m_60%)
destroy(this.m_80%)
destroy(this.m_100%)
destroy(this.m_200%)
end on

type m_20% from menu within m_zoom
end type

event clicked;str.zoom = 20
//parentwindow.getactivesheet().triggerevent('ue_zoom2')


////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Scale the display area to 20%
////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////

window	lw_frame, lw_sheet

// uncheck all zoom menu items
parent.m_20%.checked = false
parent.m_40%.checked = false
parent.m_60%.checked = false
parent.m_80%.checked = false
parent.m_100%.checked = false
parent.m_200%.checked = false

this.checked = not this.checked

lw_frame = ParentWindow.ParentWindow()
if IsValid (lw_frame) then
	lw_sheet = lw_frame.GetActiveSheet()	
	if IsValid (lw_sheet) then
		lw_sheet.TriggerEvent ("ue_zoom")
	end if
end if
end event

on m_20%.create
call super::create
this.tag = "m_na_padre.m_ventanas.m_zoom.m_20%"
this.text = "20%"
this.microhelp = "20 %"
end on

on m_20%.destroy
call super::destroy
end on

