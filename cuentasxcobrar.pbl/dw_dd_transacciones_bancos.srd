 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"dgmserie~" )  TABLE(NAME=~"dgmserdr~" ) COLUMN(NAME=~"dgmserie.mser_descripcion~") COLUMN(NAME=~"dgmserie.mser_tipo_transaccion~") COLUMN(NAME=~"dgmserie.mser_movimiento~") COLUMN(NAME=~"dgmserie.mser_sec_auto~") COMPUTE(NAME=~"isnull(dgmserie.mser_repetir_transaccion,0) mser_repite_transaccion~")    JOIN (LEFT=~"dgmserie.mser_g_financiero~"    OP =~"=~"RIGHT=~"dgmserdr.serd_g_financiero~" )    JOIN (LEFT=~"dgmserie.mser_empresa~"    OP =~"=~"RIGHT=~"dgmserdr.serd_empresa~" )    JOIN (LEFT=~"dgmserie.mser_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmserdr.serd_transaccion~" )WHERE(    EXP1 =~"dgmserie.mser_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"dgmserie.mser_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmserdr.serd_aplicacion~"   OP =~"=~"    EXP2 =~"'BA'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number)) )
