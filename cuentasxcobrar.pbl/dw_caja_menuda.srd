 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cajamenuda~" ) COLUMN(NAME=~"cajamenuda.caja_g_financiero~") COLUMN(NAME=~"cajamenuda.caja_empresa~") COLUMN(NAME=~"cajamenuda.caja_id~") COLUMN(NAME=~"cajamenuda.caja_fecha_inicio~") COLUMN(NAME=~"cajamenuda.caja_fecha_cierre~") COLUMN(NAME=~"cajamenuda.caja_cerrada~") COLUMN(NAME=~"cajamenuda.caja_saldo~") COLUMN(NAME=~"cajamenuda.caja_ing_efectivo~") COLUMN(NAME=~"cajamenuda.caja_ing_cheque~") COLUMN(NAME=~"cajamenuda.caja_ing_tarjeta~") COLUMN(NAME=~"cajamenuda.caja_ing_vuelto~") COLUMN(NAME=~"cajamenuda.caja_egre_efectivo~") COLUMN(NAME=~"cajamenuda.caje_egre_cheque~") COLUMN(NAME=~"cajamenuda.caja_egre_tarjeta~") COLUMN(NAME=~"cajamenuda.caja_ajuste_falsos~") COLUMN(NAME=~"cajamenuda.caja_ajuste_faltantes~") COLUMN(NAME=~"cajamenuda.caja_ajuste_sobrantes~") COLUMN(NAME=~"cajamenuda.caja_saldo_actual~")WHERE(    EXP1 =~"( cajamenuda.caja_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cajamenuda.caja_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cajamenuda.caja_id~"   OP =~"=~"    EXP2 =~":id )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cajamenuda.caja_fecha_inicio~"   OP =~"=~"    EXP2 =~":fecha )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"id~" TYPE = number)  ARG(NAME = ~"fecha~" TYPE = datetime) " update="cajamenuda" updatewhere=1 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("id", number),("fecha", datetime)) )
