table(column=(type=char(15) updatewhereclause=yes name=ccmclien_clie_ref_anterior dbname="ccmclien.clie_ref_anterior" dbalias=".clie_ref_anterior" )
 column=(type=char(100) updatewhereclause=yes name=dgapais_pais_descripcion dbname="pais_descripcion" )
 column=(type=char(100) updatewhereclause=yes name=dgaregio_regi_descripcion dbname="regi_descripcion" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="terc_descripcion" initial="spaces" )
 column=(type=char(20) updatewhereclause=yes name=terc_telefono1 dbname="terc_telefono1" )
 column=(type=decimal(0) updatewhereclause=yes name=terc_tercero dbname="terc_tercero" )
 column=(type=long updatewhereclause=yes name=clie_clasificacion dbname="clie_clasificacion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ccmclien~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaregio~" ) COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COMPUTE(NAME=~"max(dgapais.pais_descripcion) pais_descripcion~") COMPUTE(NAME=~"max(dgaregio.regi_descripcion) regi_descripcion~") COMPUTE(NAME=~"max(dgmterce.terc_descripcion) terc_descripcion~") COMPUTE(NAME=~"max(dgmterce.terc_telefono1) terc_telefono1~") COMPUTE(NAME=~"max(terc_tercero) terc_tercero~") COMPUTE(NAME=~"max(clie_clasificacion) clie_clasificacion~")    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"dgaregio.regi_codigo_region~"    OP =~"=~"RIGHT=~"dgmterce.terc_region~" )    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgmterce.terc_pais~" )WHERE(    EXP1 =~"ccmclien.clie_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccmclien.clie_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccmclien.clie_cuenta_mala~"   OP =~"<>~"    EXP2 =~"1~" )  GROUP(NAME=~"ccmclien.clie_tercero~") GROUP(NAME=~"ccmclien.clie_ref_anterior~") GROUP(NAME=~"dgmterce.terc_descripcion~")) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="dgmterce_terc_descripcion A ccmclien_clie_ref_anterior A " )
