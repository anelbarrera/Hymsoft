 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"directorio~" ) COLUMN(NAME=~"directorio.id~") COLUMN(NAME=~"directorio.apellido~") COLUMN(NAME=~"directorio.nombre_1~") COLUMN(NAME=~"directorio.nombre_2~") COLUMN(NAME=~"directorio.direc_1~") COLUMN(NAME=~"directorio.direc_2~") COLUMN(NAME=~"directorio.direc_3~") COLUMN(NAME=~"directorio.area~") COLUMN(NAME=~"directorio.cod_1~") COLUMN(NAME=~"directorio.tel_1~") COLUMN(NAME=~"directorio.dat_1~") COLUMN(NAME=~"directorio.cod_2~") COLUMN(NAME=~"directorio.tel_2~") COLUMN(NAME=~"directorio.dat_2~") COLUMN(NAME=~"directorio.cod_3~") COLUMN(NAME=~"directorio.tel_3~") COLUMN(NAME=~"directorio.dat_3~") COLUMN(NAME=~"directorio.cod_4~") COLUMN(NAME=~"directorio.tel_4~") COLUMN(NAME=~"directorio.dat_4~") COLUMN(NAME=~"directorio.cod_5~") COLUMN(NAME=~"directorio.tel_5~") COLUMN(NAME=~"directorio.dat_5~") COLUMN(NAME=~"directorio.cod_6~") COLUMN(NAME=~"directorio.tel_6~") COLUMN(NAME=~"directorio.dat_6~") COLUMN(NAME=~"directorio.cod_7~") COLUMN(NAME=~"directorio.fax~") COLUMN(NAME=~"directorio.dat_7~") COLUMN(NAME=~"directorio.pasaporte~") COLUMN(NAME=~"directorio.fecha~") COLUMN(NAME=~"directorio.nota_1~") COLUMN(NAME=~"directorio.nota_2~") COLUMN(NAME=~"directorio.nota_3~") COLUMN(NAME=~"directorio.ruta_foto~") COLUMN(NAME=~"directorio.ruta_pasaporte~") COLUMN(NAME=~"directorio.fecha_vencimiento~")WHERE(    EXP1 =~"directorio.id~"   OP =~"=~"    EXP2 =~":ident~" ) ) ARG(NAME = ~"ident~" TYPE = number) " update="directorio" updatewhere=1 updatekeyinplace=no arguments=(("ident", number)) )
