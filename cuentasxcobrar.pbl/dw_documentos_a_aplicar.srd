table(column=(type=char(8) updatewhereclause=yes name=movi_documento dbname="cctmovim.movi_documento" )
 column=(type=char(15) updatewhereclause=yes name=movi_referencia dbname="cctmovim.movi_referencia" )
 column=(type=decimal(2) updatewhereclause=yes name=movi_monto dbname="cctmovim.movi_monto" )
