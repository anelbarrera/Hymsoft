 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ccdrefac~" )  TABLE(NAME=~"dgmsubse~" ) COLUMN(NAME=~"ccdrefac.refa_fecha_factura~") COLUMN(NAME=~"ccdrefac.refa_documento_ori~") COLUMN(NAME=~"ccdrefac.refa_monto_pagado~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"ccdrefac.refa_aplicacion_ori~") COLUMN(NAME=~"ccdrefac.refa_tipo_transaccion_ori~") COLUMN(NAME=~"ccdrefac.refa_sub_transaccion_ori~") COLUMN(NAME=~"ccdrefac.refa_referencia_ori~") COLUMN(NAME=~"ccdrefac.refa_ann_ori~") COLUMN(NAME=~"ccdrefac.refa_g_financiero~") COLUMN(NAME=~"ccdrefac.refa_empresa~") COLUMN(NAME=~"ccdrefac.refa_tipo_transaccion~") COLUMN(NAME=~"ccdrefac.refa_sub_transaccion~") COLUMN(NAME=~"ccdrefac.refa_documento~") COLUMN(NAME=~"ccdrefac.refa_referencia~") COLUMN(NAME=~"ccdrefac.refa_ann~") COLUMN(NAME=~"ccdrefac.refa_tercero~") COLUMN(NAME=~"ccdrefac.refa_linea~") COLUMN(NAME=~"ccdrefac.refa_fecha_recibo~") COLUMN(NAME=~"ccdrefac.refa_usuario~")    JOIN (LEFT=~"ccdrefac.refa_g_financiero~"    OP =~"=~"RIGHT=~"dgmsubse.subs_g_financiero~" )    JOIN (LEFT=~"ccdrefac.refa_empresa~"    OP =~"=~"RIGHT=~"dgmsubse.subs_empresa~" )    JOIN (LEFT=~"ccdrefac.refa_tipo_transaccion_ori~"    OP =~"=~"RIGHT=~"dgmsubse.subs_transaccion~" )    JOIN (LEFT=~"ccdrefac.refa_sub_transaccion_ori~"    OP =~"=~"RIGHT=~"dgmsubse.subs_sub_trans~" )WHERE(    EXP1 =~"ccdrefac.refa_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdrefac.refa_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdrefac.refa_tipo_transaccion~"   OP =~"=~"    EXP2 =~":transaccion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdrefac.refa_sub_transaccion~"   OP =~"=~"    EXP2 =~":subtransaccion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdrefac.refa_documento~"   OP =~"=~"    EXP2 =~":documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdrefac.refa_referencia~"   OP =~"=~"    EXP2 =~":referencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdrefac.refa_ann~"   OP =~"=~"    EXP2 =~":annio~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"subtransaccion~" TYPE = string)  ARG(NAME = ~"documento~" TYPE = string)  ARG(NAME = ~"referencia~" TYPE = string)  ARG(NAME = ~"annio~" TYPE = number) " update="ccdrefac" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("transaccion", string),("subtransaccion", string),("documento", string),("referencia", string),("annio", number))  sort="refa_fecha_factura A refa_documento_ori A " )
