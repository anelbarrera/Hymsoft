 column=(type=decimal(0) updatewhereclause=yes name=cctmovim_movi_tercero dbname="cctmovim.movi_tercero" dbalias=".movi_tercero" )
 column=(type=char(15) updatewhereclause=yes name=ccmclien_clie_ref_anterior dbname="ccmclien.clie_ref_anterior" dbalias=".clie_ref_anterior" )
 column=(type=char(8) updatewhereclause=yes name=movi_documento dbname="cctmovim.movi_documento" dbalias=".movi_documento" )
 column=(type=datetime updatewhereclause=yes name=cctmovim_movi_fecha_tran dbname="cctmovim.movi_fecha_tran" dbalias=".movi_fecha_tran" )
 column=(type=char(3) updatewhereclause=yes name=movi_sub_transaccion dbname="cctmovim.movi_sub_transaccion" dbalias=".movi_sub_transaccion" )
 column=(type=char(2) updatewhereclause=yes name=movi_tipo_transaccion dbname="cctmovim.movi_tipo_transaccion" dbalias=".movi_tipo_transaccion" )
 column=(type=decimal(0) updatewhereclause=yes name=movi_anno dbname="cctmovim.movi_anno" dbalias=".movi_anno" )
 column=(type=char(2) updatewhereclause=yes name=movi_aplicacion dbname="cctmovim.movi_aplicacion" dbalias=".movi_aplicacion" )
 column=(type=char(250) updatewhereclause=yes name=cctmovim_movi_comments dbname="cctmovim.movi_comments" dbalias=".movi_comments" )
 column=(type=long updatewhereclause=yes name=clie_clasificacion dbname="ccmclien.clie_clasificacion" dbalias=".clie_clasificacion" )
 column=(type=decimal(2) updatewhereclause=yes name=efectivo dbname="cctmovim.efectivo" dbalias=".efectivo" )
 column=(type=decimal(2) updatewhereclause=yes name=cheque dbname="cctmovim.cheque" dbalias=".cheque" )
 column=(type=decimal(2) updatewhereclause=yes name=tarjeta dbname="cctmovim.tarjeta" dbalias=".tarjeta" )
 column=(type=decimal(2) updatewhereclause=yes name=transferencia dbname="cctmovim.transferencia" dbalias=".transferencia" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cctmovim~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccmclien~" ) COLUMN(NAME=~"cctmovim.movi_monto~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"cctmovim.movi_tercero~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COLUMN(NAME=~"cctmovim.movi_documento~") COLUMN(NAME=~"cctmovim.movi_fecha_tran~") COLUMN(NAME=~"cctmovim.movi_sub_transaccion~") COLUMN(NAME=~"cctmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cctmovim.movi_anno~") COLUMN(NAME=~"cctmovim.movi_aplicacion~") COLUMN(NAME=~"cctmovim.movi_comments~") COLUMN(NAME=~"ccmclien.clie_clasificacion~") COMPUTE(NAME=~"case when movi_efectivo > 0 then movi_efectivo else 0 end efectivo~") COMPUTE(NAME=~"case when movi_cheque > 0 then movi_cheque else 0 end cheque~") COMPUTE(NAME=~"case when movi_tarjeta > 0 then movi_tarjeta else 0 end tarjeta~") COMPUTE(NAME=~"case when movi_transferencia > 0 then movi_transferencia else 0 end transferencia~")    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"cctmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"ccmclien.clie_g_financiero~" )    JOIN (LEFT=~"cctmovim.movi_empresa~"    OP =~"=~"RIGHT=~"ccmclien.clie_empresa~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"cctmovim.movi_tercero~" )WHERE(    EXP1 =~"( cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cctmovim.movi_fecha_tran~"   OP =~">=~"    EXP2 =~":fecha_inicio )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cctmovim.movi_fecha_tran~"   OP =~"<=~"    EXP2 =~":fecha_final  )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_estado~"   OP =~"=~"    EXP2 =~"'IM'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(((cctmovim.movi_tipo_transaccion~"   OP =~"=~"    EXP2 =~":transaccion~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"cctmovim.movi_tipo_transaccion+cctmovim.movi_naturaleza~"   OP =~"=~"    EXP2 =~"'RMC' )))~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha_inicio~" TYPE = datetime)  ARG(NAME = ~"fecha_final~" TYPE = datetime)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"descripcion~" TYPE = string) " arguments=(("g_financiero", number),("empresa", number),("fecha_inicio", datetime),("fecha_final", datetime),("transaccion", string),("descripcion", string))  sort="cctmovim_movi_fecha_tran A movi_documento A " )
