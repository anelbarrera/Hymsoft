table(column=(type=decimal(2) updatewhereclause=yes name=cctmovim_movi_monto dbname="cctmovim.movi_monto" dbalias=".movi_monto" )
 column=(type=char(20) updatewhereclause=yes name=dgmterce_terc_identificacion dbname="dgmterce.terc_identificacion" dbalias=".terc_identificacion" )
