 column=(type=char(32767) updatewhereclause=no name=movi_comentario dbname="cctmovim.movi_comentario" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cctmovim~" ) COLUMN(NAME=~"cctmovim.movi_g_financiero~") COLUMN(NAME=~"cctmovim.movi_empresa~") COLUMN(NAME=~"cctmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cctmovim.movi_sub_transaccion~") COLUMN(NAME=~"cctmovim.movi_aplicacion~") COLUMN(NAME=~"cctmovim.movi_documento~") COLUMN(NAME=~"cctmovim.movi_anno~") COLUMN(NAME=~"cctmovim.movi_referencia~") COLUMN(NAME=~"cctmovim.movi_monto~") COLUMN(NAME=~"cctmovim.movi_fecha_tran~") COLUMN(NAME=~"cctmovim.movi_tercero~") COLUMN(NAME=~"cctmovim.movi_cant_depositada~") COLUMN(NAME=~"cctmovim.movi_estado~") COLUMN(NAME=~"cctmovim.movi_efectivo~") COLUMN(NAME=~"cctmovim.movi_cheque~") COLUMN(NAME=~"cctmovim.movi_tarjeta~") COLUMN(NAME=~"cctmovim.movi_efectivo_dep~") COLUMN(NAME=~"cctmovim.movi_cheque_dep~") COLUMN(NAME=~"cctmovim.movi_tarjeta_dep~") COMPUTE(NAME=~"movi_efectivo - movi_efectivo_dep efectivo_x_dep~") COMPUTE(NAME=~"movi_cheque - movi_cheque_dep cheque_x_dep~") COMPUTE(NAME=~"movi_tarjeta - movi_tarjeta_dep tarjeta_x_dep~") COMPUTE(NAME=~"0 seleccionar~") COLUMN(NAME=~"cctmovim.movi_a_nombre~") COMPUTE(NAME=~"movi_monto - movi_cant_depositada pendiente~") COLUMN(NAME=~"cctmovim.movi_comentario~")WHERE(    EXP1 =~"cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_monto~"   OP =~">~"    EXP2 =~"cctmovim.movi_cant_depositada~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_estado~"   OP =~"<>~"    EXP2 =~"'AN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_tipo_transaccion + cctmovim.movi_naturaleza~"   OP =~"=~"    EXP2 =~"'RCC'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " update="cctmovim" updatewhere=1 updatekeyinplace=no arguments=(("grupo", number),("empresa", number))  sort="movi_fecha_tran A " )
