 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccmclien~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"ccmclien.clie_mg_cuenta~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COLUMN(NAME=~"ccmclien.clie_ruc_tercero~") COMPUTE(NAME=~"rtrim(dgmterce.terc_descripcion)+'                                                                                           '  cliente~") COLUMN(NAME=~"ccmclien.clie_clasificacion~") COLUMN(NAME=~"ccmclien.clie_socio~") COLUMN(NAME=~"ccmclien.clie_auditor~")    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )WHERE(    EXP1 =~"( ccmclien.clie_g_financiero~"   OP =~"=~"    EXP2 =~":clie_grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ccmclien.clie_empresa~"   OP =~"=~"    EXP2 =~":clie_empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(ccmclien.clie_estado~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"ccmclien.clie_estado~"   OP =~"=~"    EXP2 =~"'AC')~" ) ) ARG(NAME = ~"clie_grupo~" TYPE = number)  ARG(NAME = ~"clie_empresa~" TYPE = number) " arguments=(("clie_grupo", number),("clie_empresa", number))  sort="cliente A " )
