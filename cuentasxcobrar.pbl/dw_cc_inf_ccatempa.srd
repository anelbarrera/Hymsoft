 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ccatempa~" ) COLUMN(NAME=~"ccatempa.tmpa_g_financiero~") COLUMN(NAME=~"ccatempa.tmpa_empresa~") COLUMN(NAME=~"ccatempa.tmpa_tercero~") COLUMN(NAME=~"ccatempa.tmpa_ruc_tercero~") COLUMN(NAME=~"ccatempa.tmpa_maxdias~") COLUMN(NAME=~"ccatempa.tmpa_descantig~") COLUMN(NAME=~"ccatempa.tmpa_monto~") COLUMN(NAME=~"ccatempa.tmpa_orden~") COLUMN(NAME=~"ccatempa.tmpa_saldo_anterior~") COLUMN(NAME=~"ccatempa.tmpa_fecha_ultima~") COLUMN(NAME=~"ccatempa.tmpa_usuario_maquina~") COLUMN(NAME=~"ccatempa.tmpa_dias_morosos~")WHERE(    EXP1 =~"ccatempa.tmpa_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccatempa.tmpa_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccatempa.tmpa_tercero~"   OP =~"=~"    EXP2 =~":tercero~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"tercero~" TYPE = number) " update="ccatempa" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("tercero", number)) )
