 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cctmovim~" ) COLUMN(NAME=~"cctmovim.movi_g_financiero~") COLUMN(NAME=~"cctmovim.movi_empresa~") COLUMN(NAME=~"cctmovim.movi_aplicacion~") COLUMN(NAME=~"cctmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cctmovim.movi_sub_transaccion~") COLUMN(NAME=~"cctmovim.movi_documento~") COLUMN(NAME=~"cctmovim.movi_anno~") COLUMN(NAME=~"cctmovim.movi_referencia~") COLUMN(NAME=~"cctmovim.movi_tercero~") COLUMN(NAME=~"cctmovim.movi_ruc_tercero~") COLUMN(NAME=~"cctmovim.movi_naturaleza~") COLUMN(NAME=~"cctmovim.movi_monto~") COLUMN(NAME=~"cctmovim.movi_fecha_tran~") COLUMN(NAME=~"cctmovim.movi_usuario~") COLUMN(NAME=~"cctmovim.movi_estado~") COLUMN(NAME=~"cctmovim.movi_cobrador~") COLUMN(NAME=~"cctmovim.movi_comentario~") COLUMN(NAME=~"cctmovim.movi_a_nombre~") COLUMN(NAME=~"cctmovim.movi_estado_pase_conta~") COMPUTE(NAME=~"0.00 saldo~") COLUMN(NAME=~"cctmovim.movi_impreso~") COLUMN(NAME=~"cctmovim.movi_efectivo~") COLUMN(NAME=~"cctmovim.movi_cheque~") COLUMN(NAME=~"cctmovim.movi_tarjeta~") COLUMN(NAME=~"cctmovim.movi_porcentaje_visa~") COLUMN(NAME=~"cctmovim.movi_comision~") COLUMN(NAME=~"cctmovim.movi_vuelto~") COLUMN(NAME=~"cctmovim.movi_cierre_mensual~") COLUMN(NAME=~"cctmovim.movi_historica~") COLUMN(NAME=~"cctmovim.movi_saldo~") COLUMN(NAME=~"cctmovim.movi_fecha_vence~") COLUMN(NAME=~"cctmovim.movi_transferencia~") COLUMN(NAME=~"cctmovim.movi_comments~") COLUMN(NAME=~"cctmovim.movi_afecta_ganancia~")WHERE(    EXP1 =~"cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_aplicacion~"   OP =~"=~"    EXP2 =~"'CC'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_tipo_transaccion~"   OP =~"=~"    EXP2 =~":transaccion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_documento~"   OP =~"=~"    EXP2 =~":documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_anno~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_tipo_transaccion+cctmovim.movi_sub_transaccion~"   OP =~"<>~"    EXP2 =~"'ND8'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_sub_transaccion~"   OP =~"=~"    EXP2 =~":subtran~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"documento~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"subtran~" TYPE = string) " update="cctmovim" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("transaccion", string),("documento", string),("ann", number),("subtran", string)) )
