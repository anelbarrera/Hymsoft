table(column=(type=decimal(2) updatewhereclause=yes name=cctmovim_movi_monto dbname="cctmovim.movi_monto" )
 column=(type=char(2) updatewhereclause=yes name=movi_tipo_transaccion dbname="cctmovim.movi_tipo_transaccion" )
 column=(type=char(3) updatewhereclause=yes name=movi_sub_transaccion dbname="cctmovim.movi_sub_transaccion" )
 column=(type=char(1) updatewhereclause=yes name=movi_naturaleza dbname="cctmovim.movi_naturaleza" )
 column=(type=char(8) updatewhereclause=yes name=movi_documento dbname="cctmovim.movi_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=movi_anno dbname="cctmovim.movi_anno" )
 column=(type=decimal(0) updatewhereclause=yes name=cctmovim_movi_tercero dbname="cctmovim.movi_tercero" )
 column=(type=datetime updatewhereclause=yes name=cctmovim_movi_fecha_tran dbname="cctmovim.movi_fecha_tran" )
 column=(type=decimal(0) updatewhereclause=yes name=cctmovim_movi_cobrador dbname="cctmovim.movi_cobrador" )
 column=(type=char(20) updatewhereclause=yes name=ccmclien_clie_ruc_tercero dbname="ccmclien.clie_ruc_tercero" )
 column=(type=char(15) updatewhereclause=yes name=ccmclien_clie_ref_anterior dbname="ccmclien.clie_ref_anterior" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" initial="spaces" )
 column=(type=char(250) updatewhereclause=yes name=dgmsubse_subs_descripcion dbname="dgmsubse.subs_descripcion" )
 column=(type=char(20) updatewhereclause=yes name=famvende_vend_nombre dbname="famvende.vend_nombre" )
 column=(type=char(20) updatewhereclause=yes name=famvende_vend_apellido dbname="famvende.vend_apellido" )
 column=(type=char(100) updatewhereclause=yes name=dgapais_pais_descripcion dbname="dgapais.pais_descripcion" )
 column=(type=decimal(0) updatewhereclause=yes name=dgapais_pais_pais dbname="dgapais.pais_pais" )
 column=(type=char(100) updatewhereclause=yes name=dgaregio_regi_descripcion dbname="dgaregio.regi_descripcion" )
 column=(type=decimal(0) updatewhereclause=yes name=dgaregio_regi_codigo_region dbname="dgaregio.regi_codigo_region" )
 column=(type=decimal(2) updatewhereclause=yes name=comision dbname="comision" )
 retrieve="  SELECT DISTINCT cctmovim.movi_monto,   
         cctmovim.movi_tipo_transaccion,   
         cctmovim.movi_sub_transaccion,   
			cctmovim.movi_naturaleza,
         cctmovim.movi_documento,   
         cctmovim.movi_anno,   
         cctmovim.movi_tercero,   
         cctmovim.movi_fecha_tran,   
         cctmovim.movi_cobrador,   
         ccmclien.clie_ruc_tercero,   
         ccmclien.clie_ref_anterior,   
         dgmterce.terc_descripcion,   
         dgmsubse.subs_descripcion,   
         famvende.vend_nombre,   
         famvende.vend_apellido,   
         dgapais.pais_descripcion,   
         dgapais.pais_pais,   
         dgaregio.regi_descripcion,   
         dgaregio.regi_codigo_region,
			0.00 comision
    FROM cctmovim,   
         ccmclien,   
         dgmterce,   
         dgmsubse,   
         famvende,   
         dgapais,   
         dgaregio  
   WHERE ( cctmovim.movi_g_financiero = ccmclien.clie_g_financiero ) and  
         ( cctmovim.movi_empresa = ccmclien.clie_empresa ) and  
         ( cctmovim.movi_tercero = ccmclien.clie_tercero ) and  
         ( dgmterce.terc_tercero = ccmclien.clie_tercero ) and  
         ( dgmterce.terc_tercero = cctmovim.movi_tercero ) and  
         ( dgmsubse.subs_g_financiero = cctmovim.movi_g_financiero ) and  
         ( dgmsubse.subs_empresa = cctmovim.movi_empresa ) and  
         ( dgmsubse.subs_transaccion = cctmovim.movi_tipo_transaccion ) and  
         ( dgmsubse.subs_sub_trans = cctmovim.movi_sub_transaccion ) and  
         ( famvende.vend_g_financiero = ccmclien.clie_g_financiero ) and  
         ( famvende.vend_empresa = ccmclien.clie_empresa ) and  
         ( famvende.vend_vendedor = ccmclien.clie_vendedor ) and  
         ( dgmterce.terc_pais = dgapais.pais_pais ) and  
         ( dgaregio.regi_pais = dgapais.pais_pais ) and  
         ( dgaregio.regi_codigo_region = dgmterce.terc_region ) and  
         ( dgaregio.regi_pais = dgmterce.terc_pais ) and  
         ( ( cctmovim.movi_g_financiero = :g_financiero       ) AND  
           ( cctmovim.movi_empresa = :empresa                 ) AND  
           ( cctmovim.movi_fecha_tran >= :fecha1              ) AND  
           ( cctmovim.movi_fecha_tran < dateadd(dd,1,:fecha2) ) AND  
           (cctmovim.movi_tipo_transaccion + cctmovim.movi_naturaleza= 'RCC' OR  
            cctmovim.movi_tipo_transaccion + cctmovim.movi_naturaleza = 'RMC' OR
            cctmovim.movi_tipo_transaccion + cctmovim.movi_sub_transaccion = 'ND4') AND  
            cctmovim.movi_estado = 'IM' )    
" arguments=(("g_financiero", number),("empresa", number),("fecha1", datetime),("fecha2", datetime))  sort="dgapais_pais_pais A dgaregio_regi_codigo_region A cctmovim_movi_fecha_tran A " )
