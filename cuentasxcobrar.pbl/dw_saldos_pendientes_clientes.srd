 column=(type=char(8) updatewhereclause=yes name=movi_documento dbname="cctmovim.movi_documento" dbalias=".movi_documento" )
 column=(type=char(15) updatewhereclause=yes name=movi_referencia dbname="cctmovim.movi_referencia" dbalias=".movi_referencia" )
