 column=(type=char(3) updatewhereclause=yes name=movi_sub_transaccion dbname="cctmovim.movi_sub_transaccion" dbalias=".movi_sub_transaccion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cctmovim~" ) COMPUTE(NAME=~"cctmovim.movi_monto - cctmovim.movi_monto_aplicado pendiente~") COLUMN(NAME=~"cctmovim.movi_documento~") COLUMN(NAME=~"cctmovim.movi_referencia~") COLUMN(NAME=~"cctmovim.movi_fecha_tran~") COLUMN(NAME=~"cctmovim.movi_monto~") COLUMN(NAME=~"cctmovim.movi_monto_aplicado~") COLUMN(NAME=~"cctmovim.movi_comments~") COLUMN(NAME=~"cctmovim.movi_saldo~") COLUMN(NAME=~"cctmovim.movi_anno~") COLUMN(NAME=~"cctmovim.movi_aplicacion~") COLUMN(NAME=~"cctmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cctmovim.movi_sub_transaccion~")WHERE(    EXP1 =~"cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_tercero~"   OP =~"=~"    EXP2 =~":proveedor~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_naturaleza~"   OP =~"=~"    EXP2 =~"'D'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_monto - cctmovim.movi_monto_aplicado~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_saldo~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_monto~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_fecha_tran~"   OP =~"<=~"    EXP2 =~":fecha~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"proveedor~" TYPE = number)  ARG(NAME = ~"fecha~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("proveedor", number),("fecha", datetime))  sort="movi_fecha_tran A " )
