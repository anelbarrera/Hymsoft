table(column=(type=decimal(0) updatewhereclause=yes key=yes name=desem_desembolso dbname="ntdesem.desem_desembolso" )
 column=(type=datetime updatewhereclause=yes name=desem_fecha dbname="ntdesem.desem_fecha" )
 column=(type=char(100) updatewhereclause=yes name=desem_pagado_a dbname="ntdesem.desem_pagado_a" )
 column=(type=decimal(2) updatewhereclause=yes name=desem_monto dbname="ntdesem.desem_monto" )
 column=(type=char(32768) updatewhereclause=no name=desem_descripcion dbname="ntdesem.desem_descripcion" )
 column=(type=char(3) updatewhereclause=yes name=desem_usuario dbname="ntdesem.desem_usuario" )
 column=(type=char(20) updatewhereclause=yes name=desem_cuenta_mg dbname="ntdesem.desem_cuenta_mg" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=desem_ann dbname="ntdesem.desem_ann" )
 column=(type=char(10) updatewhereclause=yes name=desem_class dbname="ntdesem.desem_class" )
 column=(type=char(1) update=yes updatewhereclause=yes name=desem_status dbname="ntdesem.desem_status" )
 column=(type=long updatewhereclause=yes name=desem_cuenta dbname="ntdesem.desem_cuenta" )
 column=(type=char(15) updatewhereclause=yes name=desem_transito dbname="ntdesem.desem_transito" )
 column=(type=char(1) updatewhereclause=yes name=desem_cargado_a dbname="ntdesem.desem_cargado_a" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=desem_g_financiero dbname="ntdesem.desem_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=desem_empresa dbname="ntdesem.desem_empresa" )
 column=(type=char(10) updatewhereclause=yes name=desem_caja dbname="ntdesem.desem_caja" )
 column=(type=char(25) updatewhereclause=yes name=desem_no_caso dbname="ntdesem.desem_no_caso" )
 column=(type=long updatewhereclause=yes name=ap dbname="ap" initial="1" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=re dbname="re" values="	1/	0" )
 column=(type=decimal(0) updatewhereclause=yes name=desem_tercero dbname="ntdesem.desem_tercero" )
 column=(type=datetime update=yes updatewhereclause=yes name=desem_fecha_cambia_status dbname="ntdesem.desem_fecha_cambia_status" )
 column=(type=decimal(0) updatewhereclause=yes name=desem_paga_itbm dbname="ntdesem.desem_paga_itbm" )
 column=(type=decimal(2) updatewhereclause=yes name=desem_valor_itbm dbname="ntdesem.desem_valor_itbm" )
 column=(type=decimal(2) updatewhereclause=yes name=desem_monto_final dbname="ntdesem.desem_monto_final" )
 retrieve="  SELECT ntdesem.desem_desembolso,   
         ntdesem.desem_fecha,   
         ntdesem.desem_pagado_a,   
         ntdesem.desem_monto,   
         ntdesem.desem_descripcion,   
         ntdesem.desem_usuario,   
         ntdesem.desem_cuenta_mg,   
         ntdesem.desem_ann,   
         ntdesem.desem_class,   
         ntdesem.desem_status,   
         ntdesem.desem_cuenta,   
         ntdesem.desem_transito,   
         ntdesem.desem_cargado_a,   
         ntdesem.desem_g_financiero,   
         ntdesem.desem_empresa,   
         ntdesem.desem_caja,
			ntdesem.desem_no_caso,   
         1 ap, 0 re,   
         ntdesem.desem_tercero,
			ntdesem.desem_fecha_cambia_status,
		ntdesem.desem_paga_itbm,
		ntdesem.desem_valor_itbm,
		ntdesem.desem_monto_final 
    FROM ntdesem  
   WHERE ( ntdesem.desem_g_financiero = :gfinan ) AND  
         ( ntdesem.desem_empresa = :emp ) AND  
         ( ntdesem.desem_status = 'S' ) 
" update="ntdesem" updatewhere=1 updatekeyinplace=yes arguments=(("gfinan", number),("emp", number))  sort="desem_desembolso A " )
