table(column=(type=decimal(2) updatewhereclause=yes name=cctmovim_movi_monto dbname="cctmovim.movi_monto" )
 column=(type=char(20) updatewhereclause=yes name=dgmterce_terc_identificacion dbname="dgmterce.terc_identificacion" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" )
 column=(type=decimal(0) updatewhereclause=yes name=cctmovim_movi_tercero dbname="cctmovim.movi_tercero" )
 column=(type=char(15) updatewhereclause=yes name=ccmclien_clie_ref_anterior dbname="ccmclien.clie_ref_anterior" )
 column=(type=char(8) updatewhereclause=yes name=movi_documento dbname="cctmovim.movi_documento" )
 column=(type=datetime updatewhereclause=yes name=cctmovim_movi_fecha_tran dbname="cctmovim.movi_fecha_tran" )
 column=(type=char(3) updatewhereclause=yes name=movi_sub_transaccion dbname="cctmovim.movi_sub_transaccion" )
 column=(type=char(2) updatewhereclause=yes name=movi_tipo_transaccion dbname="cctmovim.movi_tipo_transaccion" )
 column=(type=decimal(0) updatewhereclause=yes name=movi_anno dbname="cctmovim.movi_anno" )
 column=(type=char(2) updatewhereclause=yes name=movi_aplicacion dbname="cctmovim.movi_aplicacion" )
 column=(type=char(1) updatewhereclause=yes name=movi_naturaleza dbname="cctmovim.movi_naturaleza" )
 column=(type=decimal(2) updatewhereclause=yes name=debito dbname="debito" )
 column=(type=decimal(2) updatewhereclause=yes name=credito dbname="credito" )
 column=(type=decimal(2) updatewhereclause=yes name=saldo_inicial dbname="saldo_inicial" )
 column=(type=char(1) updatewhereclause=yes name=cctmovim_movi_historica dbname="cctmovim.movi_historica" values="H	S/	N/" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cctmovim~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccmclien~" ) COLUMN(NAME=~"cctmovim.movi_monto~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"cctmovim.movi_tercero~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COLUMN(NAME=~"cctmovim.movi_documento~") COLUMN(NAME=~"cctmovim.movi_fecha_tran~") COLUMN(NAME=~"cctmovim.movi_sub_transaccion~") COLUMN(NAME=~"cctmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cctmovim.movi_anno~") COLUMN(NAME=~"cctmovim.movi_aplicacion~") COLUMN(NAME=~"cctmovim.movi_naturaleza~") COMPUTE(NAME=~"case when movi_naturaleza = 'D' then movi_monto else 0 end debito~") COMPUTE(NAME=~"case when movi_naturaleza = 'C' then movi_monto else 0 end credito~") COMPUTE(NAME=~"0.00 saldo_inicial~") COLUMN(NAME=~"cctmovim.movi_historica~")    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"cctmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"ccmclien.clie_g_financiero~" )    JOIN (LEFT=~"cctmovim.movi_empresa~"    OP =~"=~"RIGHT=~"ccmclien.clie_empresa~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"cctmovim.movi_tercero~" )WHERE(    EXP1 =~"( cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cctmovim.movi_fecha_tran~"   OP =~">=~"    EXP2 =~":fecha_inicio )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cctmovim.movi_fecha_tran~"   OP =~"<~"    EXP2 =~"dateadd(dd,1,:fecha_final) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_estado~"   OP =~"=~"    EXP2 =~"'IM'~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha_inicio~" TYPE = datetime)  ARG(NAME = ~"fecha_final~" TYPE = datetime) " arguments=(("g_financiero", number),("empresa", number),("fecha_inicio", datetime),("fecha_final", datetime))  sort="cctmovim_movi_fecha_tran A movi_documento A " )
