 column=(type=char(15) updatewhereclause=yes name=ccmclien_clie_ref_anterior dbname="ccmclien.clie_ref_anterior" dbalias=".clie_ref_anterior" )
 retrieve="  SELECT ccatpan.tpan_g_financiero,   
         ccatpan.tpan_empresa,   
         ccatpan.tpan_tercero,   
         ccatpan.tpan_saldo_anterior,   
         ccatpan.tpan_col1,   
         ccatpan.tpan_col2,   
         ccatpan.tpan_col3,   
         ccatpan.tpan_col4,   
         ccatpan.tpan_col5,   
         ccatpan.tpan_col6,   
         ccatpan.tpan_col7,   
         ccatpan.tpan_col8,   
         ccatpan.tpan_col9,   
         ccatpan.tpan_col10,   
         ccatpan.tpan_col11,
         ccatpan.tpan_col12,
         ccatpan.tpan_col13,
		ccatpan.tpan_col14 ,
         ccatpan.tpan_col15 ,
         ccatpan.tpan_col16 ,
         ccatpan.tpan_col14_t ,
         ccatpan.tpan_col15_t ,
         ccatpan.tpan_col16_t,
         ccatpan.tpan_col21,   
         ccatpan.tpan_col1_t,   
         ccatpan.tpan_col2_t,   
         ccatpan.tpan_col3_t,   
         ccatpan.tpan_col4_t,   
         ccatpan.tpan_col5_t,   
         ccatpan.tpan_col6_t,   
         ccatpan.tpan_col7_t,   
         ccatpan.tpan_col8_t,   
         ccatpan.tpan_col9_t,   
         ccatpan.tpan_col10_t,   
         ccatpan.tpan_col11_t,   
         ccatpan.tpan_col12_t,   
         ccatpan.tpan_col13_t,   
         ccatpan.tpan_col21_t,   
         dgmterce.terc_descripcion,   
         dgapais.pais_descripcion,   
         dgaregio.regi_codigo_region,   
         dgaregio.regi_descripcion,   
         dgapais.pais_pais,   
         ccmclien.clie_ref_anterior  
    FROM ccatpan,   
         ccmclien,   
         dgmterce,   
         dgapais,   
         dgaregio  
   WHERE ( ccatpan.tpan_g_financiero = ccmclien.clie_g_financiero ) and  
         ( ccatpan.tpan_empresa = ccmclien.clie_empresa ) and  
         ( ccatpan.tpan_tercero = ccmclien.clie_tercero ) and  
         ( dgmterce.terc_tercero = ccmclien.clie_tercero ) and  
         ( dgaregio.regi_pais = dgapais.pais_pais ) and  
         ( dgaregio.regi_codigo_region = dgmterce.terc_region ) and  
         ( dgaregio.regi_pais = dgmterce.terc_pais ) and  
         ( ( ccatpan.tpan_g_financiero = :gf ) AND  
         ( ccatpan.tpan_empresa = :emp ) AND 
         ( ccatpan.tpan_maquina = :maq) and
         ( ccatpan.tpan_tercero <> 99999 ) )    
" arguments=(("gf", number),("emp", number),("maq", string))  sort="dgapais_pais_descripcion A dgaregio_regi_descripcion A ccmclien_clie_ref_anterior A " )
