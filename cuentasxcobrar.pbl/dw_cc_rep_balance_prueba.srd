table(column=(type=decimal(0) updatewhereclause=yes name=movi_tercero dbname="cctmovim.movi_tercero" )
 column=(type=char(15) updatewhereclause=yes name=ccmclien_clie_ref_anterior dbname="ccmclien.clie_ref_anterior" )
 column=(type=decimal(2) updatewhereclause=yes name=saldo_inicial dbname="saldo_inicial" )
 column=(type=decimal(2) updatewhereclause=yes name=credito dbname="credito" )
 column=(type=decimal(2) updatewhereclause=yes name=debito dbname="debito" )
 column=(type=char(19) updatewhereclause=yes name=cebito dbname="" )
 column=(type=char(19) updatewhereclause=yes name=cebito dbname="" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="terc_descripcion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cctmovim~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccmclien~" ) COLUMN(NAME=~"cctmovim.movi_tercero~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COMPUTE(NAME=~"sum( case  when cctmovim.movi_fecha_tran < :fecha1 then (case when cctmovim.movi_naturaleza = 'D'  then cctmovim.movi_monto else - cctmovim.movi_monto end) else 0 end ) saldo_inicial~") COMPUTE(NAME=~"sum( case  when cctmovim.movi_fecha_tran >= :fecha1 and cctmovim.movi_fecha_tran <= :fecha2  then (case when cctmovim.movi_naturaleza = 'C'  then cctmovim.movi_monto else 0 end) else 0 end ) credito~") COMPUTE(NAME=~"sum( case  when cctmovim.movi_fecha_tran >= :fecha1 and cctmovim.movi_fecha_tran <= :fecha2 then  (case when cctmovim.movi_naturaleza = 'D'  then cctmovim.movi_monto else - 0 end) else 0 end ) debito~") COMPUTE(NAME=~":fecha1~") COMPUTE(NAME=~":fecha2~") COMPUTE(NAME=~"max(terc_descripcion) terc_descripcion~")    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"cctmovim.movi_tercero~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"cctmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"ccmclien.clie_g_financiero~" )    JOIN (LEFT=~"cctmovim.movi_empresa~"    OP =~"=~"RIGHT=~"ccmclien.clie_empresa~" )    JOIN (LEFT=~"cctmovim.movi_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )WHERE(    EXP1 =~"( cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":financ )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empr )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cctmovim.movi_estado~"   OP =~"=~"    EXP2 =~"'IM' )~" )  GROUP(NAME=~"cctmovim.movi_tercero~") GROUP(NAME=~"ccmclien.clie_ref_anterior~")) ARG(NAME = ~"financ~" TYPE = number)  ARG(NAME = ~"empr~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " filter="(( saldo_final   ) > 0  ) "arguments=(("financ", number),("empr", number),("fecha1", datetime),("fecha2", datetime))  sort="dgmterce_terc_descripcion A " )
