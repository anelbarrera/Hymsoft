 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ntdesem~" )  TABLE(NAME=~"dgmempre~" ) COLUMN(NAME=~"ntdesem.desem_pagado_a~") COLUMN(NAME=~"ntdesem.desem_transito~") COLUMN(NAME=~"ntdesem.desem_fecha~") COLUMN(NAME=~"ntdesem.desem_monto~") COLUMN(NAME=~"ntdesem.desem_desembolso~") COLUMN(NAME=~"ntdesem.desem_descripcion~") COLUMN(NAME=~"ntdesem.desem_usuario~") COLUMN(NAME=~"ntdesem.desem_caja~") COLUMN(NAME=~"ntdesem.desem_cuenta_mg~") COLUMN(NAME=~"ntdesem.desem_cuenta~") COLUMN(NAME=~"ntdesem.desem_tercero~") COLUMN(NAME=~"ntdesem.desem_no_caso~") COLUMN(NAME=~"dgmempre.empr_ficha~") COLUMN(NAME=~"dgmempre.empr_rollo~") COLUMN(NAME=~"dgmempre.empr_imagen~") COLUMN(NAME=~"dgmempre.empr_dijito_verificador~") COLUMN(NAME=~"dgmempre.empr_direccion~") COMPUTE(NAME=~"dgmempre.empr_telefono1~") COMPUTE(NAME=~"dgmempre.empr_telefono2~") COMPUTE(NAME=~"dgmempre.empr_fax1~") COMPUTE(NAME=~"dgmempre.empr_fax2~") COLUMN(NAME=~"dgmempre.empr_e_mail~") COLUMN(NAME=~"dgmempre.empr_apartado_postal~")    JOIN (LEFT=~"dgmempre.empr_g_financiero~"    OP =~"=~"RIGHT=~"ntdesem.desem_g_financiero~" )    JOIN (LEFT=~"dgmempre.empr_empresa~"    OP =~"=~"RIGHT=~"ntdesem.desem_empresa~" )WHERE(    EXP1 =~"( ntdesem.desem_g_financiero~"   OP =~"=~"    EXP2 =~":gfinan )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ntdesem.desem_empresa~"   OP =~"=~"    EXP2 =~":emp )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ntdesem.desem_caja~"   OP =~"=~"    EXP2 =~":caja )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ntdesem.desem_status~"   OP =~"=~"    EXP2 =~"~~~"S~~~" )~" ) ) ARG(NAME = ~"gfinan~" TYPE = number)  ARG(NAME = ~"emp~" TYPE = number)  ARG(NAME = ~"caja~" TYPE = string) " arguments=(("gfinan", number),("emp", number),("caja", string)) )
