table(column=(type=decimal(6) updatewhereclause=yes name=pendiente dbname="pendiente" )
 column=(type=char(8) updatewhereclause=yes name=fatdiari_fact_no_pedido dbname="fatdiari.fact_no_pedido" )
 column=(type=decimal(0) updatewhereclause=yes name=fatdiari_fact_ann dbname="fatdiari.fact_ann" )
 column=(type=char(20) updatewhereclause=yes name=faddiari_facd_codigo_item dbname="faddiari.facd_codigo_item" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=faddiari_facd_linea dbname="faddiari.facd_linea" )
 column=(type=datetime updatewhereclause=yes name=fatdiari_fact_fecha dbname="fatdiari.fact_fecha" )
 column=(type=char(8) updatewhereclause=yes name=fatdiari_fact_no_factura dbname="fatdiari.fact_no_factura" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=faddiari_facd_g_financiero dbname="faddiari.facd_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=faddiari_facd_empresa dbname="faddiari.facd_empresa" )
 column=(type=char(3) updatewhereclause=yes key=yes name=faddiari_facd_tipo dbname="faddiari.facd_tipo" )
 column=(type=char(8) updatewhereclause=yes key=yes name=faddiari_facd_no_pedido dbname="faddiari.facd_no_pedido" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=faddiari_facd_ann dbname="faddiari.facd_ann" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=facd_cantidad_cerrada dbname="faddiari.facd_cantidad_cerrada" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ccmclien~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"faddiari~" ) COMPUTE(NAME=~"faddiari.facd_cantidad - faddiari.facd_cantidad_cerrada pendiente~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_linea~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"faddiari.facd_g_financiero~") COLUMN(NAME=~"faddiari.facd_empresa~") COLUMN(NAME=~"faddiari.facd_tipo~") COLUMN(NAME=~"faddiari.facd_no_pedido~") COLUMN(NAME=~"faddiari.facd_ann~") COLUMN(NAME=~"faddiari.facd_cantidad_cerrada~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"ccmclien.clie_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"ccmclien.clie_empresa~" )    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"fatdiari.fact_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"fatdiari.fact_empresa~" )    JOIN (LEFT=~"faddiari.facd_tipo~"    OP =~"=~"RIGHT=~"fatdiari.fact_tipo~" )    JOIN (LEFT=~"faddiari.facd_no_pedido~"    OP =~"=~"RIGHT=~"fatdiari.fact_no_pedido~" )    JOIN (LEFT=~"faddiari.facd_ann~"    OP =~"=~"RIGHT=~"fatdiari.fact_ann~" )WHERE(    EXP1 =~"( ccmclien.clie_g_financiero~"   OP =~"=~"    EXP2 =~":clie_grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ccmclien.clie_empresa~"   OP =~"=~"    EXP2 =~":clie_empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccmclien.clie_estado~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_metal_pendiente~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_cierre_de_metal~"   OP =~"=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"abs(faddiari.facd_cantidad) - faddiari.facd_cantidad_cerrada~"   OP =~">~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccmclien.clie_tercero~"   OP =~"=~"    EXP2 =~":clie_cliente~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_factura_cierre~"   OP =~"=~"    EXP2 =~"0~" ) ) ARG(NAME = ~"clie_grupo~" TYPE = number)  ARG(NAME = ~"clie_empresa~" TYPE = number)  ARG(NAME = ~"clie_cliente~" TYPE = number) " update="faddiari" updatewhere=0 updatekeyinplace=yes arguments=(("clie_grupo", number),("clie_empresa", number),("clie_cliente", number))  sort="fatdiari_fact_fecha A fatdiari_fact_no_factura A faddiari_facd_linea A " )
