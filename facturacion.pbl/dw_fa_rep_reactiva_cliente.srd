 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccmclien~" ) COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"fatdiari.fact_act_cliente~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_tipo_venta~") COLUMN(NAME=~"fatdiari.fact_tipo_movimiento~") COLUMN(NAME=~"fatdiari.fact_no_traspaso~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_fecha_creacion~") COLUMN(NAME=~"fatdiari.fact_fecha_modificacion~") COLUMN(NAME=~"fatdiari.fact_dias_pago~") COLUMN(NAME=~"fatdiari.fact_fecha_fin_plazo~") COLUMN(NAME=~"fatdiari.fact_fecha_cancelado~") COLUMN(NAME=~"fatdiari.fact_consignado~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_a_nombre_direccion~") COLUMN(NAME=~"fatdiari.fact_despachado~") COLUMN(NAME=~"fatdiari.fact_via~") COLUMN(NAME=~"fatdiari.fact_con_emb_no~") COLUMN(NAME=~"fatdiari.fact_marca~") COLUMN(NAME=~"fatdiari.fact_bultos_total~") COLUMN(NAME=~"fatdiari.fact_cubicaje_total~") COLUMN(NAME=~"fatdiari.fact_peso_total~") COLUMN(NAME=~"fatdiari.fact_unidad_peso~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_descuento_subt_deta~") COLUMN(NAME=~"fatdiari.fact_por_descuento~") COLUMN(NAME=~"fatdiari.fact_supervisor~") COLUMN(NAME=~"fatdiari.fact_comentario~") COLUMN(NAME=~"fatdiari.fact_estado~") COLUMN(NAME=~"fatdiari.fact_act_inventario~") COLUMN(NAME=~"fatdiari.fact_act_conta~") COLUMN(NAME=~"fatdiari.fact_cerrada~") COLUMN(NAME=~"fatdiari.fact_referencia_fac~") COLUMN(NAME=~"fatdiari.fact_monto_abonado~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COLUMN(NAME=~"ccmclien.clie_ruc_tercero~")    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"ccmclien.clie_g_financiero~"    OP =~"=~"RIGHT=~"fatdiari.fact_g_financiero~" )    JOIN (LEFT=~"ccmclien.clie_empresa~"    OP =~"=~"RIGHT=~"fatdiari.fact_empresa~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"fatdiari.fact_cliente~" )WHERE(    EXP1 =~"( ( fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_act_cliente~"   OP =~"=~"    EXP2 =~"0 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_no_pedido~"   OP =~"not like~"    EXP2 =~"'%NC%' ) )~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("g_financiero", number),("empresa", number)) )
