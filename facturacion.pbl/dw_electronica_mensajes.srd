 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"feregistros~" ) COLUMN(NAME=~"feregistros.mensaje~") COLUMN(NAME=~"feregistros.cufe~") COLUMN(NAME=~"feregistros.fechaRecepcionDGI~") COLUMN(NAME=~"feregistros.fecharegistro~")WHERE(    EXP1 =~"feregistros.fere_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"feregistros.fere_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"feregistros.fere_codigo_sucursal_emisor~"   OP =~"=~"    EXP2 =~":sucursal~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"feregistros.fere_no_pedido~"   OP =~"=~"    EXP2 =~":pedido~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"feregistros.fere_ann~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"feregistros.fere_no_factura~"   OP =~"=~"    EXP2 =~":factura~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"sucursal~" TYPE = string)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"factura~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("sucursal", string),("pedido", string),("ann", number),("factura", string)) )
