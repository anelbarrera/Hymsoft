//objectcomments Muestra los tipos de sub transacciones de las aplicaciones
release 7;
datawindow(units=0 timer_interval=0 color=79741120 processing=0 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=72 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=76 color="536870912" )
table(column=(type=char(255) updatewhereclause=yes name=descrip dbname="descrip" )
 column=(type=char(2) updatewhereclause=yes name=dgmsubse_subs_transaccion dbname="dgmsubse.subs_transaccion" )
 column=(type=char(3) updatewhereclause=yes name=dgmsubse_subs_sub_trans dbname="dgmsubse.subs_sub_trans" )
 column=(type=char(250) updatewhereclause=yes name=dgmsubse_subs_descripcion dbname="dgmsubse.subs_descripcion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmserdr~" )  TABLE(NAME=~"dgmsubse~" ) COMPUTE(NAME=~"dgmsubse.subs_descripcion+'                                                                                    '+dgmsubse.subs_sub_trans descrip~") COLUMN(NAME=~"dgmsubse.subs_transaccion~") COLUMN(NAME=~"dgmsubse.subs_sub_trans~") COLUMN(NAME=~"dgmsubse.subs_descripcion~")    JOIN (LEFT=~"dgmsubse.subs_g_financiero~"    OP =~"=~"RIGHT=~"dgmserdr.serd_g_financiero~" )    JOIN (LEFT=~"dgmsubse.subs_empresa~"    OP =~"=~"RIGHT=~"dgmserdr.serd_empresa~" )    JOIN (LEFT=~"dgmsubse.subs_transaccion~"    OP =~"=~"RIGHT=~"dgmserdr.serd_transaccion~" )    JOIN (LEFT=~"dgmsubse.subs_sub_trans~"    OP =~"=~"RIGHT=~"dgmserdr.serd_sub_trans~" )WHERE(    EXP1 =~"dgmserdr.serd_g_financiero~"   OP =~"=~"    EXP2 =~":ser_grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmserdr.serd_empresa~"   OP =~"=~"    EXP2 =~":ser_empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmserdr.serd_aplicacion~"   OP =~"=~"    EXP2 =~":ser_aplica~" ) ) ARG(NAME = ~"ser_grupo~" TYPE = number)  ARG(NAME = ~"ser_empresa~" TYPE = number)  ARG(NAME = ~"ser_aplica~" TYPE = string) " arguments=(("ser_grupo", number),("ser_empresa", number),("ser_aplica", string)) )
