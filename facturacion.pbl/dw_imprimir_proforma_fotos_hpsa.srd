 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" dbalias=".prod_empaque" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_empaque_descripcion dbname="inmprodu.prod_empaque_descripcion" dbalias=".prod_empaque_descripcion" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_peso dbname="inmprodu.prod_peso" dbalias=".prod_peso" )
 column=(type=decimal(4) updatewhereclause=yes name=inmprodu_prod_cubicaje dbname="inmprodu.prod_cubicaje" dbalias=".prod_cubicaje" )
 column=(type=char(25) updatewhereclause=yes name=cramarca_amar_nombre_marca dbname="cramarca.amar_nombre_marca" dbalias=".amar_nombre_marca" )
 column=(type=decimal(3) updatewhereclause=yes name=disponible dbname="disponible" )
 column=(type=decimal(0) updatewhereclause=yes name=prof_cliente dbname="fatprofo.prof_cliente" dbalias=".prof_cliente" )
 column=(type=decimal(4) updatewhereclause=yes name=prof_monto_final dbname="fatprofo.prof_monto_final" dbalias=".prof_monto_final" )
 column=(type=char(2) updatewhereclause=yes name=inmprodu_prod_empaque_um dbname="inmprodu.prod_empaque_um" dbalias=".prod_empaque_um" )
 column=(type=decimal(2) updatewhereclause=yes name=fadprofo_dpro_bultos dbname="fadprofo.dpro_bultos" dbalias=".dpro_bultos" )
 column=(type=decimal(6) updatewhereclause=yes name=fadprofo_dpro_cantidad dbname="fadprofo.dpro_cantidad" dbalias=".dpro_cantidad" )
 column=(type=decimal(4) updatewhereclause=yes name=fadprofo_dpro_monto_final dbname="fadprofo.dpro_monto_final" dbalias=".dpro_monto_final" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fadprofo~" )  TABLE(NAME=~"fatprofo~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"cramarca~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"fatprofo.prof_no_proforma~") COLUMN(NAME=~"inmprodu.prod_producto_dos~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_foto_dir~") COLUMN(NAME=~"fadprofo.dpro_precio_unidad_producto~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_descripcion~") COLUMN(NAME=~"inmprodu.prod_peso~") COLUMN(NAME=~"inmprodu.prod_cubicaje~") COLUMN(NAME=~"cramarca.amar_nombre_marca~") COMPUTE(NAME=~"case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_existencia_total - prod_reserva_total /inamedid.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_existencia_total - prod_reserva_total /inamedid.medi_cantidad)) end disponible~") COLUMN(NAME=~"fatprofo.prof_cliente~") COLUMN(NAME=~"fatprofo.prof_monto_final~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COLUMN(NAME=~"fadprofo.dpro_bultos~") COLUMN(NAME=~"fadprofo.dpro_cantidad~") COLUMN(NAME=~"fadprofo.dpro_monto_final~")    JOIN (LEFT=~"fatprofo.prof_g_financiero~"    OP =~"=~"RIGHT=~"fadprofo.dpro_g_financiero~" )    JOIN (LEFT=~"fatprofo.prof_empresa~"    OP =~"=~"RIGHT=~"fadprofo.dpro_empresa~" )    JOIN (LEFT=~"fatprofo.prof_no_proforma~"    OP =~"=~"RIGHT=~"fadprofo.dpro_no_proforma~" )    JOIN (LEFT=~"fatprofo.prof_ann~"    OP =~"=~"RIGHT=~"fadprofo.dpro_ann~" )    JOIN (LEFT=~"fadprofo.dpro_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"fadprofo.dpro_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"fadprofo.dpro_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"cramarca.amar_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cramarca.amar_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cramarca.amar_num_marca~"    OP =~"=~"RIGHT=~"inmprodu.prod_marca~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"fadprofo.dpro_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadprofo.dpro_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadprofo.dpro_no_proforma~"   OP =~"=~"    EXP2 =~":proforma~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadprofo.dpro_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ORDER(NAME=~"fadprofo.dpro_linea~" ASC=yes ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"proforma~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("proforma", string),("ann", number)) )
