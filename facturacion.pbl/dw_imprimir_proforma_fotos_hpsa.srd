table(column=(type=char(8) updatewhereclause=yes name=fatprofo_prof_no_proforma dbname="fatprofo.prof_no_proforma" dbalias=".prof_no_proforma" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_producto_dos dbname="inmprodu.prod_producto_dos" dbalias=".prod_producto_dos" )
