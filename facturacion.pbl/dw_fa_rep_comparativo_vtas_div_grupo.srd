 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"cradivis~" )  TABLE(NAME=~"cragrupo~" ) COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"faddiari.facd_no_pedido~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_cantidad~") COLUMN(NAME=~"faddiari.facd_monto_final~") COLUMN(NAME=~"faddiari.facd_unidad_producto~") COLUMN(NAME=~"faddiari.facd_unidad_venta~") COLUMN(NAME=~"faddiari.facd_costo_cif~") COLUMN(NAME=~"faddiari.facd_precio_unidad_producto~") COLUMN(NAME=~"faddiari.facd_cantidad_fraccion~") COLUMN(NAME=~"faddiari.facd_monto_total~") COLUMN(NAME=~"inmprodu.prod_costo_cif~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"faddiari.facd_costo_total~") COLUMN(NAME=~"fatdiari.fact_costos_total~") COLUMN(NAME=~"cragrupo.agru_codigo_grupo~") COLUMN(NAME=~"cragrupo.agru_descripcion_grupo~") COLUMN(NAME=~"cradivis.adiv_codigo_div~") COLUMN(NAME=~"cradivis.adiv_nombre_div~") COLUMN(NAME=~"inmprodu.prod_division~") COLUMN(NAME=~"inmprodu.prod_grupo~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"faddiari.facd_codigo_item~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )    JOIN (LEFT=~"cradivis.adiv_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cradivis.adiv_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cradivis.adiv_codigo_div~"    OP =~"=~"RIGHT=~"inmprodu.prod_division~" )    JOIN (LEFT=~"cragrupo.agru_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cragrupo.agru_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cragrupo.agru_codigo_div~"    OP =~"=~"RIGHT=~"inmprodu.prod_division~" )    JOIN (LEFT=~"cragrupo.agru_codigo_grupo~"    OP =~"=~"RIGHT=~"inmprodu.prod_grupo~" )WHERE(    EXP1 =~"((fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha1)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":fecha2)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_monto_final~"   OP =~">~"    EXP2 =~"0))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("fecha1", datetime),("fecha2", datetime))  sort="inmprodu_prod_division A inmprodu_prod_grupo A " )
