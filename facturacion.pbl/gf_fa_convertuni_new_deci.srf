global type gf_fa_convertuni_new_deci from function_object
end type

forward prototypes
global subroutine gf_fa_convertuni_new_deci (string as_med, decimal ad_fracciones, ref decimal ad_cantidad, ref long al_fraccion)
end prototypes

global subroutine gf_fa_convertuni_new_deci (string as_med, decimal ad_fracciones, ref decimal ad_cantidad, ref long al_fraccion);/*Esta Función Convierte de Unidad Mínima a la Unidad que se Quiere*/
decimal  ld_mconvera, ld_ucom, ld_cantidad
long ll_frac
/*Extrae la Unidad comun "Pedo/Unidades/etc "*/
ld_ucom = gf_medi_prod(as_med)

/*Retorna el Factor de Conversión a unidades mínimas*/
ld_mconvera = gf_unidad_venta_dec_new(as_med, ld_ucom)

If ld_mconvera <= 0 Then ld_mconvera = 1
If IsNull(ad_fracciones) Then ad_fracciones = 0

ld_cantidad =  ad_fracciones / ld_mconvera

ll_frac = (Mod(ad_fracciones, ld_mconvera))

If IsNull(ll_frac) Then ll_frac = 0

ad_cantidad = ld_cantidad
al_fraccion = ll_frac


end subroutine

