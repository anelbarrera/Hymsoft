//objectcomments Datawindow encabezado de consulta de disponiblidad de un producto
release 7;
datawindow(units=0 timer_interval=0 color=79741120 processing=0 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=176 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=prod_producto dbname="inmprodu.prod_producto" )
 column=(type=char(50) updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" initial="empty" )
 column=(type=decimal(6) updatewhereclause=yes name=prod_existencia_total dbname="inmprodu.prod_existencia_total" initial="0" )
 column=(type=decimal(6) updatewhereclause=yes name=prod_reserva_total dbname="inmprodu.prod_reserva_total" initial="0" )
 column=(type=char(2) updatewhereclause=yes name=prod_medida dbname="inmprodu.prod_medida" )
 column=(type=long updatewhereclause=yes name=multiplicador dbname="multiplicador" )
 column=(type=char(120) updatewhereclause=yes name=prod_foto_dir dbname="inmprodu.prod_foto_dir" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COLUMN(NAME=~"inmprodu.prod_reserva_total~") COLUMN(NAME=~"inmprodu.prod_medida~") COMPUTE(NAME=~"0 multiplicador~") COLUMN(NAME=~"inmprodu.prod_foto_dir~")WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_producto~"   OP =~"=~"    EXP2 =~":producto~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"producto~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("producto", string)) )
text(band=detail alignment="2" text="Producto" border="0" color="0" x="14" y="16" height="56" width="261"  name=prod_producto_t  font.face="MS Sans Serif" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
column(band=detail id=1 alignment="0" tabsequence=32766 border="5" color="8388608" x="293" y="16" height="56" width="480" format="[general]"  name=prod_producto  tag="Codigo base del producto, codigo asignado por la empresa o proveedor para identificar el producto" edit.limit=0 edit.case=any edit.autoselect=no edit.displayonly=yes  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=2 alignment="0" tabsequence=32766 border="5" color="8388608" x="818" y="20" height="56" width="1609" format="[general]"  name=prod_descripcion  tag="Descripcion larga del Producto." edit.limit=50 edit.case=any edit.focusrectangle=no edit.autoselect=yes edit.autohscroll=yes  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=detail alignment="2" text="Existencia " border="0" color="0" x="14" y="108" height="52" width="288"  name=prod_existencia_total_t  font.face="MS Sans Serif" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=detail alignment="1" expression="Int( prod_existencia_total )"border="5" color="0" x="338" y="108" height="52" width="338" format="##,###,###,##0"  name=cantidad_exist  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="2" expression=" ( prod_existencia_total  -  Int( prod_existencia_total  ))* multiplicador "border="5" color="8388608" x="690" y="108" height="52" width="87" format="##0"  name=frac_exist  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=5 alignment="0" tabsequence=32766 border="5" color="8388608" x="800" y="108" height="52" width="123" format="[general]"  name=prod_medida edit.limit=0 edit.case=any edit.autoselect=yes  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=detail alignment="2" text="Reserva " border="0" color="0" x="951" y="108" height="52" width="270"  name=prod_reserva_total_t  font.face="MS Sans Serif" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=detail alignment="1" expression="Int(  prod_reserva_total )"border="5" color="0" x="1271" y="108" height="52" width="338" format="##,###,###,##0"  name=cant_reserva  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="2" expression=" (  prod_reserva_total -  Int(  prod_reserva_total ))* multiplicador "border="5" color="8388608" x="1623" y="108" height="52" width="96" format="##0"  name=frac_res  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=detail alignment="2" text="Disponible" border="0" color="0" x="1746" y="108" height="52" width="288"  name=t_1  font.face="MS Sans Serif" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="1" background.color="536870912" )
compute(band=detail alignment="1" expression="int  ( truncate(prod_existencia_total -  prod_reserva_total ,0))"border="5" color="8388608" x="2043" y="108" height="52" width="288" format="##,###,###,##0"  name=cant_dispo  font.face="MS Sans Serif" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="2" expression="(  (  ( prod_existencia_total -  prod_reserva_total ) )   - int  (truncate( prod_existencia_total -  prod_reserva_total,0) )  ) *  multiplicador "border="5" color="8388608" x="2345" y="108" height="52" width="96" format="##0"  name=frac_dispo  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=3 alignment="1" tabsequence=32766 border="5" color="8388608" x="347" y="192" height="56" width="315" format="###,###,##0.00"  name=prod_existencia_total  tag="Indica la existencial total que puede tener el producto" edit.limit=0 edit.case=any edit.focusrectangle=no edit.autoselect=yes edit.autohscroll=yes  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=6 alignment="0" tabsequence=32766 border="0" color="8388608" x="750" y="192" height="52" width="325" format="[general]"  name=multiplicador edit.limit=0 edit.case=any edit.autoselect=yes  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=4 alignment="2" tabsequence=32766 border="5" color="8388608" x="1271" y="192" height="56" width="366" format="###,###,##0.00"  name=prod_reserva_total  tag="Indica la reserva total del producto" edit.limit=0 edit.case=any edit.focusrectangle=no edit.autoselect=yes edit.autohscroll=yes  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="2" expression="If ( IsNull (  prod_existencia_total ),0, prod_existencia_total ) -  If ( IsNull ( prod_reserva_total ),0, prod_reserva_total  ) "border="5" color="8388608" x="2048" y="192" height="52" width="274" format="[General]"  name=disponible  font.face="MS Sans Serif" font.height="-8" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=background id=7 alignment="0" tabsequence=0 border="0" color="8388608" x="2473" y="8" height="228" width="393"  name=prod_foto_dir bitmapname=yes  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
htmltable(border="1" )
htmlgen(clientevents="1" clientvalidation="1" clientcomputedfields="1" clientformatting="0" clientscriptable="0" generatejavascript="1" )
