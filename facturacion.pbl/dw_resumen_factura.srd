table(column=(type=decimal(4) updatewhereclause=yes name=monto_final dbname="monto_final" )
 column=(type=decimal(6) updatewhereclause=yes name=cantidad dbname="cantidad" )
 column=(type=decimal(0) updatewhereclause=yes name=fraccion dbname="fraccion" )
 column=(type=decimal(0) updatewhereclause=yes name=tipo_medida dbname="tipo_medida" )
 column=(type=char(255) updatewhereclause=yes name=faddiari_facd_descripcion_alterna dbname="facd_descripcion_alterna" )
 column=(type=char(255) updatewhereclause=yes name=descrip dbname="descrip" )
 column=(type=char(20) updatewhereclause=yes name=faddiari_facd_codigo_item dbname="facd_codigo_item" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_producto_dos dbname="inmprodu.prod_producto_dos" dbalias=".prod_producto_dos" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"inmprodu~" ) COMPUTE(NAME=~"sum( facd_monto_final ) monto_final~") COMPUTE(NAME=~"sum( facd_cantidad ) cantidad~") COMPUTE(NAME=~"sum( facd_cantidad_fraccion ) fraccion~") COMPUTE(NAME=~"max(medi_tipo_medida) tipo_medida~") COMPUTE(NAME=~"max(facd_descripcion_alterna) facd_descripcion_alterna~") COMPUTE(NAME=~"case when max(prod_kilates) = 0 or max(prod_kilates) = null then 'P I E Z A S' else max(facd_descripcion_alterna) end descrip~") COMPUTE(NAME=~"case when max(prod_kilates) = 0 or max(prod_kilates) = null then ' ' else max(facd_codigo_item ) end facd_codigo_item~") COLUMN(NAME=~"inmprodu.prod_producto_dos~")    JOIN (LEFT=~"faddiari.facd_unidad_venta~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"faddiari.facd_codigo_item~" )WHERE(    EXP1 =~"faddiari.facd_g_financiero~"   OP =~"=~"    EXP2 =~":nes_grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_empresa~"   OP =~"=~"    EXP2 =~":nes_empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_no_pedido~"   OP =~"=~"    EXP2 =~":nes_pedido~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_ann~"   OP =~"=~"    EXP2 =~":nes_ann~" )  GROUP(NAME=~"inmprodu.prod_producto_dos~")) ARG(NAME = ~"nes_grupo~" TYPE = number)  ARG(NAME = ~"nes_empresa~" TYPE = number)  ARG(NAME = ~"nes_pedido~" TYPE = string)  ARG(NAME = ~"nes_ann~" TYPE = number) " arguments=(("nes_grupo", number),("nes_empresa", number),("nes_pedido", string),("nes_ann", number)) )
