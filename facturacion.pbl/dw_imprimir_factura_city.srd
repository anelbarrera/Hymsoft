OLUMN(NAME=~"vi_factura1.fact_monto_abonado~") COLUMN(NAME=~"vi_factura1.facd_tipo~") COLUMN(NAME=~"vi_factura1.facd_no_pedido~") COLUMN(NAME=~"vi_factura1.facd_pedido_original~") COLUMN(NAME=~"vi_factura1.facd_linea~") COLUMN(NAME=~"vi_factura1.facd_ann~") COLUMN(NAME=~"vi_factura1.facd_producto_servicio~") COLUMN(NAME=~"vi_factura1.facd_codigo_item~") COLUMN(NAME=~"vi_factura1.facd_cubicaje~") COLUMN(NAME=~"vi_factura1.facd_peso~") COLUMN(NAME=~"vi_factura1.facd_unidad_peso~") COLUMN(NAME=~"vi_factura1.facd_unidad_producto~") COLUMN(NAME=~"vi_factura1.facd_precio_mayor~") COLUMN(NAME=~"vi_factura1.facd_precio_menor~") COLUMN(NAME=~"vi_factura1.facd_bodega~") COLUMN(NAME=~"vi_factura1.facd_costo_fob~") COLUMN(NAME=~"vi_factura1.facd_costo_cif~") COLUMN(NAME=~"vi_factura1.facd_precio_unidad_producto~") COLUMN(NAME=~"vi_factura1.facd_unidad_venta~") COLUMN(NAME=~"vi_factura1.facd_cantidad~") COLUMN(NAME=~"vi_factura1.facd_cantidad_fraccion~") COLUMN(NAME=~"vi_factura1.facd_monto_total~") COLUMN(NAME=~"vi_factura1.facd_por_descuento~") COLUMN(NAME=~"vi_factura1.facd_monto_final~") COLUMN(NAME=~"vi_factura1.facd_fecha_reg~") COLUMN(NAME=~"vi_factura1.facd_usuario~") COLUMN(NAME=~"vi_factura1.facd_supervisor~") COLUMN(NAME=~"vi_factura1.facd_bultos~") COLUMN(NAME=~"vi_factura1.facd_pais~") COLUMN(NAME=~"vi_factura1.facd_ubicacion~") COLUMN(NAME=~"vi_factura1.facd_cant_devuelta~") COLUMN(NAME=~"vi_factura1.facd_linea_articulo_dev~") COLUMN(NAME=~"vi_factura1.pais_descripcion~") COLUMN(NAME=~"vi_factura1.fact_g_financiero~") COLUMN(NAME=~"vi_factura1.fara_logo_f~") COLUMN(NAME=~"vi_factura1.fara_logo~") COLUMN(NAME=~"vi_factura1.peri_descripcion~") COLUMN(NAME=~"vi_factura1.fara_jurada~") COLUMN(NAME=~"vi_factura1.fara_jurada_dos~") COLUMN(NAME=~"vi_factura1.amar_nombre_marca~") COLUMN(NAME=~"vi_factura1.peri_aplicacion~") COLUMN(NAME=~"vi_factura1.aesp_descripcion_espec~") COMPUTE(NAME=~"'                                            ' car_descripcion~") COMPUTE(NAME=~"'               ' bultos~") COMPUTE(NAME=~"0 linea_subt~") COLUMN(NAME=~"vi_factura1.terc_identificacion~") COLUMN(NAME=~"vi_factura1.fact_factura_de_bodega~") COLUMN(NAME=~"vi_factura1.facd_index~") COLUMN(NAME=~"vi_factura1.acta_descripcion~") COMPUTE(NAME=~"0 grupo, vi_factura1.facd_monto_final tot_por_registro~") COLUMN(NAME=~"vi_factura1.medi_abre~") COLUMN(NAME=~"vi_factura1.facd_bulto_inicio~") COLUMN(NAME=~"vi_factura1.facd_bulto_fin~") COLUMN(NAME=~"vi_factura1.prod_producto_dos~") COLUMN(NAME=~"vi_factura1.prod_gramaje~") COLUMN(NAME=~"vi_factura1.facd_precio_original~") COLUMN(NAME=~"vi_factura1.facd_precio_recargo~") COLUMN(NAME=~"vi_factura1.medi_tipo_medida~") COLUMN(NAME=~"vi_factura1.fact_metal_pendiente~") COLUMN(NAME=~"vi_factura1.fact_factura_cierre~") COLUMN(NAME=~"vi_factura1.fact_precio_onza~") COLUMN(NAME=~"vi_factura1.fact_fix~") COLUMN(NAME=~"vi_factura1.fact_fecha_despacho~") COLUMN(NAME=~"vi_factura1.fact_pasaporte~") COLUMN(NAME=~"vi_factura1.fact_linea_aerea~") COLUMN(NAME=~"vi_factura1.fact_usuario~") COLUMN(NAME=~"vi_factura1.fact_factura_trafico~") COMPUTE(NAME=~"0 tipo_medida~") COMPUTE(NAME=~"0.00 monto_final~") COLUMN(NAME=~"vi_factura1.fact_fecha_impresion~") COLUMN(NAME=~"vi_factura1.fact_detalle_liquidacion~") COMPUTE(NAME=~"'                    ' prod_original~") COMPUTE(NAME=~"0.00 costo_total~") COLUMN(NAME=~"vi_factura1.facd_descripcion_alterna~") COMPUTE(NAME=~"case when medi_tipo_medida = 5 then 0 else facd_cantidad end cantidad~") COMPUTE(NAME=~"case when medi_tipo_medida <> 5 then 0 else facd_cantidad end cantidad_pz~") COLUMN(NAME=~"vi_factura1.empr_direccion~") COLUMN(NAME=~"vi_factura1.empr_apartado_postal~") COLUMN(NAME=~"vi_factura1.empr_telefono1~") COLUMN(NAME=~"vi_factura1.empr_fax1~") COLUMN(NAME=~"vi_factura1.empr_e_mail~") COLUMN(NAME=~"vi_factura1.empr_ficha~") COLUMN(NAME=~"vi_factura1.empr_rollo~") COLUMN(NAME=~"vi_factura1.empr_imagen~") COLUMN(NAME=~"vi_factura1.empr_dijito_verificador~") COLUMN(NAME=~"vi_factura1.empr_telefono2~") COLUMN(NAME=~"vi_factura1.facd_g_financiero~") COLUMN(NAME=~"fadvenfa.vfac_vendedor~") COLUMN(NAME=~"vi_factura1.fact_no_factura~") COLUMN(NAME=~"vi_factura1.fact_nota_credito~") COLUMN(NAME=~"vi_factura1.fact_usuario_print~") COLUMN(NAME=~"vi_factura1.prod_barra~")    JOIN (LEFT=~"vi_factura1.facd_g_financiero~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_g_financiero~"    OUTER1 =~"vi_factura1.facd_g_financiero~" )    JOIN (LEFT=~"vi_factura1.facd_empresa~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_empresa~"    OUTER1 =~"vi_factura1.facd_empresa~" )    JOIN (LEFT=~"vi_factura1.facd_tipo~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_tipo~"    OUTER1 =~"vi_factura1.facd_tipo~" )    JOIN (LEFT=~"vi_factura1.facd_no_pedido~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_no_pedido~"    OUTER1 =~"vi_factura1.facd_no_pedido~" )    JOIN (LEFT=~"vi_factura1.facd_ann~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_ann~"    OUTER1 =~"vi_factura1.facd_ann~" )WHERE(    EXP1 =~"((vi_factura1.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_finan )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_ann~"   OP =~"=~"    EXP2 =~":an )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'))~" ) ) ARG(NAME = ~"grupo_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo_finan", number),("empresa", number),("pedido", string),("an", number))  sort="facd_index A " )
