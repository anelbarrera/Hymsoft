table(column=(type=char(8) updatewhereclause=yes name=fact_no_pedido dbname="fatdiari.fact_no_pedido" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fatdiari.fact_ann" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_gastos_total dbname="fatdiari.fact_gastos_total" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_gastos_total~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_cierre_de_metal~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_gastos_total~"   OP =~"<>~"    EXP2 =~"0~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("fecha1", datetime),("fecha2", datetime)) )
line(band=detail x1="41" y1="375" x2="7812" y2="375"  name=l_3 visible="1" pen.style="0" pen.width="10" pen.color="0"  background.mode="2" background.color="1090519039" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" )
