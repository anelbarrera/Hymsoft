 column=(type=char(1) updatewhereclause=yes name=bodega_ubicacion dbname="bodega_ubicacion" )
 column=(type=decimal(4) updatewhereclause=yes name=prof_monto_final dbname="fatprofo.prof_monto_final" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaperio~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"fadprofo~" )  TABLE(NAME=~"fatprofo~" ) COLUMN(NAME=~"dgmempre.empr_direccion~") COLUMN(NAME=~"dgmempre.empr_apartado_postal~") COLUMN(NAME=~"dgmempre.empr_telefono1~") COLUMN(NAME=~"dgmempre.empr_telefono2~") COLUMN(NAME=~"dgmempre.empr_fax1~") COLUMN(NAME=~"dgmempre.empr_fax2~") COLUMN(NAME=~"dgmempre.empr_e_mail~") COLUMN(NAME=~"inmprodu.prod_marca~") COLUMN(NAME=~"inmprodu.prod_pais~") COLUMN(NAME=~"dgmempre.empr_ficha~") COLUMN(NAME=~"dgmempre.empr_rollo~") COLUMN(NAME=~"dgmempre.empr_imagen~") COLUMN(NAME=~"dgmempre.empr_dijito_verificador~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"dgaperio.peri_descripcion~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_descripcion~") COLUMN(NAME=~"inmprodu.prod_medida~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COMPUTE(NAME=~"(prod_existencia_total -  prod_reserva_total) disponible,           ~~~"~~~" cambio,           ~~~"~~~" parcial~") COLUMN(NAME=~"inamedid.medi_descripcion~") COLUMN(NAME=~"fatprofo.prof_no_proforma~") COLUMN(NAME=~"fatprofo.prof_cliente~") COLUMN(NAME=~"fatprofo.prof_ruc_cliente~") COLUMN(NAME=~"fatprofo.prof_condicion_pago~") COLUMN(NAME=~"fatprofo.prof_fecha~") COLUMN(NAME=~"fatprofo.prof_dias_pago~") COLUMN(NAME=~"fatprofo.prof_consignado~") COLUMN(NAME=~"fatprofo.prof_a_nombre~") COLUMN(NAME=~"fatprofo.prof_a_nombre_direccion~") COLUMN(NAME=~"fatprofo.prof_despachado~") COLUMN(NAME=~"fatprofo.prof_marca~") COLUMN(NAME=~"fatprofo.prof_bultos_total~") COLUMN(NAME=~"fatprofo.prof_cubicaje_total~") COLUMN(NAME=~"fatprofo.prof_peso_total~") COLUMN(NAME=~"fatprofo.prof_unidad_peso~") COLUMN(NAME=~"fatprofo.prof_gastos_total~") COLUMN(NAME=~"fatprofo.prof_monto_total~") COLUMN(NAME=~"fatprofo.prof_comentario~") COLUMN(NAME=~"fadprofo.dpro_codigo_item~") COLUMN(NAME=~"fadprofo.dpro_descripcion_alterna~") COLUMN(NAME=~"fadprofo.dpro_cubucaje~") COLUMN(NAME=~"fadprofo.dpro_peso~") COLUMN(NAME=~"fadprofo.dpro_unidad_peso~") COLUMN(NAME=~"fadprofo.dpro_unidad_producto~") COLUMN(NAME=~"fadprofo.dpro_bodega~") COLUMN(NAME=~"fadprofo.dpro_cantidad~") COLUMN(NAME=~"fadprofo.dpro_fraccion~") COLUMN(NAME=~"fadprofo.dpro_bultos~") COLUMN(NAME=~"fadprofo.dpro_ubicacion~") COLUMN(NAME=~"fadprofo.dpro_unidad_venta~") COLUMN(NAME=~"fadprofo.dpro_index~") COMPUTE(NAME=~"convert(numeric(10,0),(prod_existencia_total /inamedid.medi_cantidad)) entero~") COMPUTE(NAME=~"prod_existencia_total - (convert(numeric(10,0),( prod_existencia_total  / inamedid.medi_cantidad)) * inamedid.medi_cantidad) fraccion~") COMPUTE(NAME=~"~~~"~~~" bodega_ubicacion~") COLUMN(NAME=~"fatprofo.prof_monto_final~")    JOIN (LEFT=~"inmprodu.prod_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )    JOIN (LEFT=~"fatprofo.prof_g_financiero~"    OP =~"=~"RIGHT=~"fadprofo.dpro_g_financiero~" )    JOIN (LEFT=~"fatprofo.prof_empresa~"    OP =~"=~"RIGHT=~"fadprofo.dpro_empresa~" )    JOIN (LEFT=~"fatprofo.prof_no_proforma~"    OP =~"=~"RIGHT=~"fadprofo.dpro_no_proforma~" )    JOIN (LEFT=~"fatprofo.prof_ann~"    OP =~"=~"RIGHT=~"fadprofo.dpro_ann~" )    JOIN (LEFT=~"fatprofo.prof_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatprofo.prof_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"fadprofo.dpro_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"fadprofo.dpro_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"fadprofo.dpro_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"fatprofo.prof_dias_pago~"    OP =~"=~"RIGHT=~"dgaperio.peri_periodo~" )WHERE(    EXP1 =~"((fatprofo.prof_g_financiero~"   OP =~"=~"    EXP2 =~":grupo)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatprofo.prof_empresa~"   OP =~"=~"    EXP2 =~":empresa)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatprofo.prof_no_proforma~"   OP =~"=~"    EXP2 =~":pedido)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatprofo.prof_ann~"   OP =~"=~"    EXP2 =~":an)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA' ) )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("pedido", string),("an", number))  sort="dpro_index A " )
