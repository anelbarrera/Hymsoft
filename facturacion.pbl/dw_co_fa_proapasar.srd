 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"fatprofo~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"vi_deproapas~" ) COLUMN(NAME=~"fatprofo.prof_estado~") COLUMN(NAME=~"fatprofo.prof_no_proforma~") COLUMN(NAME=~"fatprofo.prof_tipo~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatprofo.prof_ruc_cliente~") COLUMN(NAME=~"fatprofo.prof_condicion_pago~") COLUMN(NAME=~"fatprofo.prof_fecha~") COLUMN(NAME=~"fatprofo.prof_a_nombre~") COLUMN(NAME=~"fatprofo.prof_ann~") COLUMN(NAME=~"fatprofo.prof_cliente~") COLUMN(NAME=~"fatprofo.prof_tipo_venta~") COLUMN(NAME=~"fatprofo.prof_tipo_movimiento~") COLUMN(NAME=~"fatprofo.prof_no_traspaso~") COLUMN(NAME=~"fatprofo.prof_fecha_creacion~") COLUMN(NAME=~"fatprofo.prof_fecha_modificacion~") COLUMN(NAME=~"fatprofo.prof_dias_pago~") COLUMN(NAME=~"fatprofo.prof_via~") COLUMN(NAME=~"fatprofo.prof_descu_subt_deta~") COLUMN(NAME=~"fatprofo.prof_unidad_peso~") COLUMN(NAME=~"fatprofo.prof_g_financiero~") COLUMN(NAME=~"fatprofo.prof_empresa~") COLUMN(NAME=~"fatprofo.prof_consignado~") COLUMN(NAME=~"fatprofo.prof_a_nombre_direccion~") COLUMN(NAME=~"fatprofo.prof_despachado~") COLUMN(NAME=~"fatprofo.prof_con_emb_no~") COLUMN(NAME=~"fatprofo.prof_marca~") COLUMN(NAME=~"fatprofo.prof_bultos_total~") COLUMN(NAME=~"fatprofo.prof_cubicaje_total~") COLUMN(NAME=~"fatprofo.prof_peso_total~") COLUMN(NAME=~"fatprofo.prof_gastos_total~") COLUMN(NAME=~"fatprofo.prof_monto_total~") COLUMN(NAME=~"fatprofo.prof_por_descuento~") COLUMN(NAME=~"fatprofo.prof_supervisor~") COLUMN(NAME=~"fatprofo.prof_monto_final~") COLUMN(NAME=~"fatprofo.prof_comentario~") COLUMN(NAME=~"fatprofo.prof_documento~") COLUMN(NAME=~"fatprofo.prof_actualizo_cargos~") COLUMN(NAME=~"fatprofo.prof_actualizo_vendedor~") COLUMN(NAME=~"fatprofo.prof_factura_de_bodega~") COLUMN(NAME=~"fatprofo.prof_cuatro_decimales~") COLUMN(NAME=~"fatprofo.prof_precio_a_utilizar~") COLUMN(NAME=~"fatprofo.prof_costos_total~") COLUMN(NAME=~"fatprofo.prof_usuario~") COLUMN(NAME=~"fatprofo.prof_origen_venta~")    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"fatprofo.prof_cliente~" )    JOIN (LEFT=~"fatprofo.prof_g_financiero~"    OP =~"=~"RIGHT=~"vi_deproapas.dpro_g_financiero~" )    JOIN (LEFT=~"fatprofo.prof_empresa~"    OP =~"=~"RIGHT=~"vi_deproapas.dpro_empresa~" )    JOIN (LEFT=~"fatprofo.prof_no_proforma~"    OP =~"=~"RIGHT=~"vi_deproapas.dpro_no_proforma~" )    JOIN (LEFT=~"fatprofo.prof_ann~"    OP =~"=~"RIGHT=~"vi_deproapas.dpro_ann~" )WHERE(    EXP1 =~"( ( fatprofo.prof_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatprofo.prof_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatprofo.prof_cliente~"   OP =~"=~"    EXP2 =~":cliente ))~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"cliente~" TYPE = number) " retrieve.asneeded=yes arguments=(("g_financiero", number),("empresa", number),("cliente", number))  sort="fatprofo_prof_ann A integer(fatprofo_prof_no_proforma) A " )
