 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"fatprofo~" ) COMPUTE(NAME=~"0 incluir~") COLUMN(NAME=~"fatprofo.prof_no_proforma~") COLUMN(NAME=~"fatprofo.prof_tipo~") COLUMN(NAME=~"fatprofo.prof_ann~") COLUMN(NAME=~"fatprofo.prof_condicion_pago~") COLUMN(NAME=~"fatprofo.prof_fecha~") COLUMN(NAME=~"fatprofo.prof_ruc_cliente~") COLUMN(NAME=~"fatprofo.prof_a_nombre~") COLUMN(NAME=~"fatprofo.prof_monto_final~")    JOIN (LEFT=~"fatprofo.prof_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"fatprofo.prof_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatprofo.prof_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatprofo.prof_estado~"   OP =~"<>~"    EXP2 =~"'P'~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("g_financiero", number),("empresa", number))  sort="long(fatpedid_pedi_no_pedido) A fatprofo_prof_fecha A fatprofo_prof_ann A " )
