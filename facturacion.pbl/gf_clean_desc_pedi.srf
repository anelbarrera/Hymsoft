//objectcomments  
global type gf_clean_desc_pedi from function_object
end type

forward prototypes
global function integer gf_clean_desc_pedi (readonly string as_pedido, readonly integer as_ano)
end prototypes

global function integer gf_clean_desc_pedi (readonly string as_pedido, readonly integer as_ano);/*Función que limpia los descuentos del detalle de pedidos*/  
  
  UPDATE fadpedid  
     SET dped_monto_final = dped_monto_total,   
         dped_por_descuento = 0  
   WHERE ( fadpedid.dped_g_financiero = :str.g_financiero ) AND  
         ( fadpedid.dped_empresa = :str.empresa ) AND  
         ( fadpedid.dped_no_pedido = :as_pedido ) AND  
         ( fadpedid.dped_ann = :as_ano )   ;
			
If Sqlca.sqlcode = -1 Then
	Return(-1)
Else
	Return(1)
End If	
end function

