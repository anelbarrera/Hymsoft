nd e.aesp_empresa = inmprodu.prod_empresa and e.aesp_num_especificacion = inmprodu.prod_compuesto ) as aesp_descripcion_espec~") COMPUTE(NAME=~"(select a.acta_descripcion from cracltam a where a.acta_g_financiero = inmprodu.prod_g_financiero and a.acta_empresa = inmprodu.prod_empresa and a.acta_cod_clase_tam = inmprodu.prod_cod_clase_tam ) as acta_descripcion~") COMPUTE(NAME=~"(select c.acol_nombre_color from cracolor c where c.acol_g_financiero = inmprodu.prod_g_financiero and c.acol_empresa = inmprodu.prod_empresa and c.acol_num_color = inmprodu.prod_color ) as acol_nombre_color~")    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"fatdiari.fact_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"fatdiari.fact_empresa~" )    JOIN (LEFT=~"faddiari.facd_no_pedido~"    OP =~"=~"RIGHT=~"fatdiari.fact_no_pedido~" )    JOIN (LEFT=~"faddiari.facd_ann~"    OP =~"=~"RIGHT=~"fatdiari.fact_ann~" )    JOIN (LEFT=~"dgmempre.empr_g_financiero~"    OP =~"=~"RIGHT=~"fatdiari.fact_g_financiero~" )    JOIN (LEFT=~"dgmempre.empr_empresa~"    OP =~"=~"RIGHT=~"fatdiari.fact_empresa~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )    JOIN (LEFT=~"faddiari.facd_unidad_venta~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"fatdiari.fact_dias_pago~"    OP =~"=~"RIGHT=~"dgaperio.peri_periodo~" )    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"faddiari.facd_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"cramarca.amar_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cramarca.amar_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cramarca.amar_num_marca~"    OP =~"=~"RIGHT=~"inmprodu.prod_marca~" )    JOIN (LEFT=~"dgapais.pais_pais~"    OP =~"=~"RIGHT=~"inmprodu.prod_pais~" )    JOIN (LEFT=~"faddiari.facd_tipo~"    OP =~"=~"RIGHT=~"fatdiari.fact_tipo~" )WHERE(    EXP1 =~"( ( fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(faddiari.facd_ann~"   OP =~"=~"    EXP2 =~":ano ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ano~" TYPE = number) " arguments=(("g_financiero", number),("empresa", number),("pedido", string),("ano", number))  sort="facd_index A " )
