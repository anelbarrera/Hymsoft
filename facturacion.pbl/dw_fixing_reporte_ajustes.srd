 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fixing~" ) COLUMN(NAME=~"fixing.contrato~") COLUMN(NAME=~"fixing.fecha~") COLUMN(NAME=~"fixing.kilates~") COLUMN(NAME=~"fixing.precio_onza~") COLUMN(NAME=~"fixing.cantidad_onza~") COLUMN(NAME=~"fixing.mano_de_obra~") COLUMN(NAME=~"fixing.calo~") COLUMN(NAME=~"fixing.media~") COLUMN(NAME=~"fixing.total_gramos~") COLUMN(NAME=~"fixing.valor~") COLUMN(NAME=~"fixing.cerrado~") COLUMN(NAME=~"fixing.proveedor~")WHERE(    EXP1 =~"fixing.grupo~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fixing.empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fixing.fecha~"   OP =~">=~"    EXP2 =~":fecha_1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fixing.fecha~"   OP =~"<=~"    EXP2 =~":fecha_2~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha_1~" TYPE = datetime)  ARG(NAME = ~"fecha_2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("fecha_1", datetime),("fecha_2", datetime))  sort="fixing_kilates D long(contrato) A fixing_fecha A " )
