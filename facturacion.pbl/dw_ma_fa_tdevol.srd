 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_tipo_venta~") COLUMN(NAME=~"fatdiari.fact_tipo_movimiento~") COLUMN(NAME=~"fatdiari.fact_no_traspaso~") COLUMN(NAME=~"fatdiari.fact_fecha_creacion~") COLUMN(NAME=~"fatdiari.fact_fecha_modificacion~") COLUMN(NAME=~"fatdiari.fact_dias_pago~") COLUMN(NAME=~"fatdiari.fact_fecha_fin_plazo~") COLUMN(NAME=~"fatdiari.fact_fecha_cancelado~") COLUMN(NAME=~"fatdiari.fact_consignado~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_a_nombre_direccion~") COLUMN(NAME=~"fatdiari.fact_despachado~") COLUMN(NAME=~"fatdiari.fact_via~") COLUMN(NAME=~"fatdiari.fact_con_emb_no~") COLUMN(NAME=~"fatdiari.fact_marca~") COLUMN(NAME=~"fatdiari.fact_bultos_total~") COLUMN(NAME=~"fatdiari.fact_cubicaje_total~") COLUMN(NAME=~"fatdiari.fact_peso_total~") COLUMN(NAME=~"fatdiari.fact_unidad_peso~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_descuento_subt_deta~") COLUMN(NAME=~"fatdiari.fact_por_descuento~") COLUMN(NAME=~"fatdiari.fact_supervisor~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"fatdiari.fact_comentario~") COLUMN(NAME=~"fatdiari.fact_estado~") COLUMN(NAME=~"fatdiari.fact_act_cliente~") COLUMN(NAME=~"fatdiari.fact_act_inventario~") COLUMN(NAME=~"fatdiari.fact_act_conta~") COLUMN(NAME=~"fatdiari.fact_cerrada~") COLUMN(NAME=~"fatdiari.fact_referencia_fac~") COLUMN(NAME=~"fatdiari.fact_monto_abonado~") COLUMN(NAME=~"fatdiari.fact_actualizo_cargos~") COLUMN(NAME=~"fatdiari.fact_modificada_por~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatdiari.fact_descuento_ncr~") COLUMN(NAME=~"fatdiari.fact_ncr_descuento~") COLUMN(NAME=~"fatdiari.fact_provincia_fe~") COLUMN(NAME=~"fatdiari.fact_distrito~") COLUMN(NAME=~"fatdiari.fact_corregimiento~") COLUMN(NAME=~"fatdiari.fact_intcoterms~") COLUMN(NAME=~"fatdiari.fact_tipo_ventas~") COLUMN(NAME=~"fatdiari.fact_tipo_documento~") COLUMN(NAME=~"fatdiari.fact_ruc~") COLUMN(NAME=~"fatdiari.fact_dv~") COLUMN(NAME=~"fatdiari.fact_tipo_fact~") COMPUTE(NAME=~"pais = (select max(p.pais_pais) from dgapais p where p.pais_pais = dgmterce.terc_pais and fatdiari.fact_cliente = dgmterce.terc_tercero)~") COMPUTE(NAME=~"estadofe = (select max(f.codigo) from feregistros f where f.fere_g_financiero = fatdiari.fact_g_financiero and f.fere_empresa = fatdiari.fact_empresa and f.fere_no_pedido = fatdiari.fact_no_pedido and f.fere_ann = fatdiari.fact_ann and f.fere_no_factura = fatdiari.fact_no_factura )~") COMPUTE(NAME=~"pais_descripcion = (select max(p.pais_descripcion) from dgapais p where p.pais_pais = dgmterce.terc_pais and fatdiari.fact_cliente = dgmterce.terc_tercero)~")    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"( ( fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":ann ))~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="fatdiari" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("pedido", string),("ann", number)) )
