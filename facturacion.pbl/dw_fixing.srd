 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fixing~" ) COLUMN(NAME=~"fixing.grupo~") COLUMN(NAME=~"fixing.empresa~") COLUMN(NAME=~"fixing.contrato~") COLUMN(NAME=~"fixing.fecha~") COLUMN(NAME=~"fixing.proveedor~") COLUMN(NAME=~"fixing.kilates~") COLUMN(NAME=~"fixing.usuario~") COLUMN(NAME=~"fixing.total_gramos~") COLUMN(NAME=~"fixing.valor~") COLUMN(NAME=~"fixing.media~") COLUMN(NAME=~"fixing.calo~") COLUMN(NAME=~"fixing.mano_de_obra~") COLUMN(NAME=~"fixing.cantidad_onza~") COLUMN(NAME=~"fixing.precio_onza~") COLUMN(NAME=~"fixing.cerrado~") COLUMN(NAME=~"fixing.ann~")WHERE(    EXP1 =~"fixing.grupo~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fixing.empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fixing.contrato~"   OP =~"=~"    EXP2 =~":contrato~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fixing.ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"contrato~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="fixing" updatewhere=1 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("contrato", string),("ann", number)) )
