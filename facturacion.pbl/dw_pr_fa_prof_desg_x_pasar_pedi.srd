table(column=(type=decimal(0) update=yes updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" )
 column=(type=char(20) update=yes updatewhereclause=yes name=terc_identificacion dbname="dgmterce.terc_identificacion" )
 column=(type=char(40) update=yes updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" )
 column=(type=decimal(0) updatewhereclause=yes name=fatprofo_prof_g_financiero dbname="fatprofo.prof_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=fatprofo_prof_empresa dbname="fatprofo.prof_empresa" )
 column=(type=long updatewhereclause=yes name=cant_pedidos dbname="cant_pedidos" )
 column=(type=char(114) updatewhereclause=yes name=descrip dbname="descrip" )
 column=(type=long updatewhereclause=yes name=desglose dbname="desglose" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"fatprofo~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatprofo.prof_g_financiero~") COLUMN(NAME=~"fatprofo.prof_empresa~") COMPUTE(NAME=~"sum ( 1 ) cant_pedidos~") COMPUTE(NAME=~"dgmterce.terc_descripcion+'                                                                     '+convert(varchar(5), dgmterce.terc_tercero) descrip~") COMPUTE(NAME=~"0 desglose~")    JOIN (LEFT=~"fatprofo.prof_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"(fatprofo.prof_g_financiero~"   OP =~"=~"    EXP2 =~":cli_grupo)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatprofo.prof_empresa~"   OP =~"=~"    EXP2 =~":cli_empresa)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatprofo.prof_estado~"   OP =~"<>~"    EXP2 =~"'P')~" )  GROUP(NAME=~"fatprofo.prof_g_financiero~") GROUP(NAME=~"fatprofo.prof_empresa~") GROUP(NAME=~"dgmterce.terc_tercero~") GROUP(NAME=~"dgmterce.terc_identificacion~") GROUP(NAME=~"dgmterce.terc_descripcion~")) ORDER(NAME=~"fatprofo.prof_g_financiero~" ASC=yes )  ORDER(NAME=~"fatprofo.prof_empresa~" ASC=yes )  ORDER(NAME=~"dgmterce.terc_tercero~" ASC=yes )  ORDER(NAME=~"dgmterce.terc_identificacion~" ASC=yes )  ORDER(NAME=~"dgmterce.terc_descripcion~" ASC=yes ) ARG(NAME = ~"cli_grupo~" TYPE = number)  ARG(NAME = ~"cli_empresa~" TYPE = number) " arguments=(("cli_grupo", number),("cli_empresa", number))  sort="terc_descripcion A " )
