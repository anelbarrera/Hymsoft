table(column=(type=char(3) updatewhereclause=yes name=fact_tipo dbname="fact_tipo" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_pedido dbname="fact_no_pedido" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_factura dbname="fact_no_factura" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fact_a_nombre" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre_direccion dbname="fact_a_nombre_direccion" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_cliente dbname="fact_cliente" )
 column=(type=char(100) updatewhereclause=yes name=fact_consignado dbname="fact_consignado" )
 column=(type=char(20) updatewhereclause=yes name=fact_ruc_cliente dbname="fact_ruc_cliente" )
 column=(type=char(2) updatewhereclause=yes name=fact_condicion_pago dbname="fact_condicion_pago" )
 column=(type=char(1) updatewhereclause=yes name=fact_tipo_movimiento dbname="fact_tipo_movimiento" values="OTROS	O/TRASPASO	T/SALIDA	S/LIQUIDACION	L/" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fact_ann" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fact_fecha" )
 column=(type=char(100) updatewhereclause=yes name=fact_marca dbname="fact_marca" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_final dbname="fact_monto_final" )
 column=(type=char(3) updatewhereclause=yes name=facd_usuario dbname="facd_usuario" )
 column=(type=char(20) updatewhereclause=yes name=facd_codigo_item dbname="faddiari.facd_codigo_item" )
 column=(type=decimal(6) updatewhereclause=yes name=cantidad dbname="cantidad" )
 column=(type=decimal(4) updatewhereclause=yes name=gastos dbname="gastos" )
 column=(type=char(255) updatewhereclause=yes name=facd_descripcion_alterna dbname="facd_descripcion_alterna" )
 column=(type=decimal(0) updatewhereclause=yes name=fraccion dbname="fraccion" )
 column=(type=decimal(4) updatewhereclause=yes name=monto_final dbname="monto_final" )
 column=(type=decimal(0) updatewhereclause=yes name=tipo_medida dbname="tipo_medida" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha_despacho dbname="fact_fecha_despacho" )
 column=(type=char(30) updatewhereclause=yes name=fact_pasaporte dbname="fact_pasaporte" )
 column=(type=char(44) updatewhereclause=yes name=car_descripcion dbname="car_descripcion" )
 column=(type=char(15) updatewhereclause=yes name=bultos dbname="bultos" )
 column=(type=long updatewhereclause=yes name=linea_subt dbname="linea_subt" )
 column=(type=long updatewhereclause=yes name=grupo dbname="grupo" )
 column=(type=char(50) updatewhereclause=yes name=fact_linea_aerea dbname="fact_linea_aerea" )
 column=(type=long updatewhereclause=yes name=cantidad_pz dbname="cantidad_pz" )
 column=(type=char(3) updatewhereclause=yes name=fact_usuario dbname="fact_usuario" )
 column=(type=char(20) updatewhereclause=yes name=prod_original dbname="prod_original" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"inamedid~" ) COMPUTE(NAME=~"max(fatdiari.fact_tipo) fact_tipo~") COMPUTE(NAME=~"max(fatdiari.fact_no_pedido) fact_no_pedido~") COMPUTE(NAME=~"max(fatdiari.fact_no_factura) fact_no_factura~") COMPUTE(NAME=~"max(fatdiari.fact_a_nombre) fact_a_nombre~") COMPUTE(NAME=~"max(fatdiari.fact_a_nombre_direccion) fact_a_nombre_direccion~") COMPUTE(NAME=~"max(fatdiari.fact_cliente) fact_cliente~") COMPUTE(NAME=~"max(fatdiari.fact_consignado) fact_consignado~") COMPUTE(NAME=~"max(fatdiari.fact_ruc_cliente) fact_ruc_cliente~") COMPUTE(NAME=~"max(fatdiari.fact_condicion_pago) fact_condicion_pago~") COMPUTE(NAME=~"max(fatdiari.fact_tipo_movimiento) fact_tipo_movimiento~") COMPUTE(NAME=~"max(fatdiari.fact_ann) fact_ann~") COMPUTE(NAME=~"max(fatdiari.fact_fecha) fact_fecha~") COMPUTE(NAME=~"max(fatdiari.fact_marca) fact_marca~") COMPUTE(NAME=~"max(fatdiari.fact_monto_final) fact_monto_final~") COMPUTE(NAME=~"max(faddiari.facd_usuario) facd_usuario~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COMPUTE(NAME=~"sum( case when faddiari.facd_cantidad < 0 then 0 else faddiari.facd_cantidad end ) cantidad~") COMPUTE(NAME=~"max(fatdiari.fact_gastos_total) gastos~") COMPUTE(NAME=~"max(faddiari.facd_descripcion_alterna) facd_descripcion_alterna~") COMPUTE(NAME=~"sum(faddiari.facd_cantidad_fraccion) fraccion~") COMPUTE(NAME=~"sum(faddiari.facd_monto_final) monto_final~") COMPUTE(NAME=~"max(inamedid.medi_tipo_medida) tipo_medida~") COMPUTE(NAME=~"max(fatdiari.fact_fecha_despacho) fact_fecha_despacho~") COMPUTE(NAME=~"max(fatdiari.fact_pasaporte) fact_pasaporte~") COMPUTE(NAME=~"'                                            ' car_descripcion~") COMPUTE(NAME=~"'               ' bultos~") COMPUTE(NAME=~"0 linea_subt~") COMPUTE(NAME=~"0 grupo~") COMPUTE(NAME=~"max(fatdiari.fact_linea_aerea) fact_linea_aerea~") COMPUTE(NAME=~"0 cantidad_pz~") COMPUTE(NAME=~"max(fact_usuario) fact_usuario~") COMPUTE(NAME=~"'                    ' prod_original~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"faddiari.facd_unidad_venta~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"((fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_finan )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":an )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_tipo~"   OP =~"=~"    EXP2 =~":tipo ))~" )  GROUP(NAME=~"faddiari.facd_codigo_item~")) ARG(NAME = ~"grupo_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number)  ARG(NAME = ~"tipo~" TYPE = string) " arguments=(("grupo_finan", number),("empresa", number),("pedido", string),("an", number),("tipo", string)) )
