UMN(NAME=~"fatdiari.fact_vence_reserva~") COLUMN(NAME=~"fatdiari.fact_paga_itbm~") COLUMN(NAME=~"fatdiari.fact_fecha_fin_plazo~") COLUMN(NAME=~"fatdiari.fact_alerta_vencimiento~") COLUMN(NAME=~"fatdiari.fact_act_conta~")WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="fatdiari" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("pedido", string),("ann", number)) )
