table(column=(type=decimal(0) updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" initial="0" )
 column=(type=char(20) updatewhereclause=yes name=terc_identificacion dbname="dgmterce.terc_identificacion" initial="spaces" )
 column=(type=char(60) updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" initial="spaces" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_pedido dbname="fatdiari.fact_no_pedido" )
 column=(type=char(10) updatewhereclause=yes name=fact_no_factura dbname="fatdiari.fact_no_factura" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fatdiari.fact_ann" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_cliente dbname="fatdiari.fact_cliente" )
 column=(type=char(20) updatewhereclause=yes name=fact_ruc_cliente dbname="fatdiari.fact_ruc_cliente" )
 column=(type=char(2) updatewhereclause=yes name=fact_condicion_pago dbname="fatdiari.fact_condicion_pago" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_tipo_venta dbname="fatdiari.fact_tipo_venta" values="CONTADO	CO/CRÉDITO	CR/C.O.D	CD/" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fatdiari.fact_fecha" initial="today" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_g_financiero dbname="fatdiari.fact_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_empresa dbname="fatdiari.fact_empresa" )
 column=(type=char(250) updatewhereclause=yes name=fara_logo_f dbname="faaparam.fara_logo_f" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_gastos_total dbname="fatdiari.fact_gastos_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_fact_total dbname="fatdiari.fact_monto_fact_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_final dbname="fatdiari.fact_monto_final" )
 column=(type=char(250) updatewhereclause=yes name=faaparam_fara_logo dbname="faaparam.fara_logo" )
 column=(type=decimal(2) updatewhereclause=yes name=costo_totx dbname="compute_ct" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fatdiari.fact_a_nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=costo_tot dbname="fatdiari.fact_costos_total" initial="0" )
 column=(type=decimal(2) updatewhereclause=yes name=gramos dbname="gramos" )
 column=(type=long updatewhereclause=yes name=piezas dbname="piezas" initial="0" )
 column=(type=char(1) updatewhereclause=yes name=fatdiari_fact_tipo_movimiento dbname="fatdiari.fact_tipo_movimiento" values="SALIDA	S/TRASPASO	T/OTROS	O/LIQUIDACION	L/DESPACHO DIRECTO	D/" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_nota_credito dbname="fatdiari.fact_nota_credito" )
 column=(type=char(11) updatewhereclause=yes name=porc_costo dbname="porc_costo" )
 column=(type=char(11) updatewhereclause=yes name=porc_venta dbname="porc_venta" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=tra_sal dbname="tra_sal" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=flete dbname="flete" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=seguro dbname="seguro" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=otros dbname="otros" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=porc_venta_numerico dbname="porc_venta_numerico" initial="0" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"faaparam~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_tipo_venta~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"faaparam.fara_logo_f~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"faaparam.fara_logo~") COMPUTE(NAME=~"0.00 compute_ct~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_costos_total~") COMPUTE(NAME=~"0.00 gramos~") COMPUTE(NAME=~"0 piezas~") COLUMN(NAME=~"fatdiari.fact_tipo_movimiento~") COLUMN(NAME=~"fatdiari.fact_nota_credito~") COMPUTE(NAME=~"convert(varchar(10),round((( fact_monto_fact_total - fact_costos_total ) / case when fact_costos_total = 0 then 1 else fact_costos_total end) * case when fact_nota_credito = 1 then -1 else 1 end * 100,2)) + '%' porc_costo~") COMPUTE(NAME=~"convert(varchar(10),round((( fact_monto_fact_total - fact_costos_total ) / case when fact_monto_fact_total = 0 then 1 else fact_monto_fact_total end) * case when fact_nota_credito = 1 then -1 else 1 end * 100,2)) + '%' porc_venta~") COMPUTE(NAME=~"tra_sal = isnull((select dcar_monto from fadcargo where dcar_g_financiero = fatdiari.fact_g_financiero and dcar_empresa = fatdiari.fact_empresa and dcar_no_pedido = fatdiari.fact_no_pedido and dcar_ann = fatdiari.fact_ann and dcar_codigo = 3 ),0)~") COMPUTE(NAME=~"flete = isnull((select dcar_monto from fadcargo where dcar_g_financiero = fatdiari.fact_g_financiero and dcar_empresa = fatdiari.fact_empresa and dcar_no_pedido = fatdiari.fact_no_pedido and dcar_ann = fatdiari.fact_ann and dcar_codigo = 4 ),0)~") COMPUTE(NAME=~"seguro = isnull((select dcar_monto from fadcargo where dcar_g_financiero = fatdiari.fact_g_financiero and dcar_empresa = fatdiari.fact_empresa and dcar_no_pedido = fatdiari.fact_no_pedido and dcar_ann = fatdiari.fact_ann and dcar_codigo = 8 ),0)~") COMPUTE(NAME=~"otros = isnull((select sum(dcar_monto) from fadcargo where dcar_g_financiero = fatdiari.fact_g_financiero and dcar_empresa = fatdiari.fact_empresa and dcar_no_pedido = fatdiari.fact_no_pedido and dcar_ann = fatdiari.fact_ann and dcar_codigo not in (3,4,8) ),0)~") COMPUTE(NAME=~"round((( fact_monto_fact_total - fact_costos_total ) / case when fact_monto_fact_total = 0 then 1 else fact_monto_fact_total end) * case when fact_nota_credito = 1 then -1 else 1 end * 100,2) porc_venta_numerico~")    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_cierre_de_metal~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="fact_fecha A fact_no_factura A " )
