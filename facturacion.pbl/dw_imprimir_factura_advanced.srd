factura1.empr_telefono2~") COLUMN(NAME=~"vi_factura1.facd_g_financiero~") COLUMN(NAME=~"fadvenfa.vfac_vendedor~") COLUMN(NAME=~"vi_factura1.fact_no_factura~") COLUMN(NAME=~"vi_factura1.fact_nota_credito~") COLUMN(NAME=~"vi_factura1.fact_usuario_print~") COLUMN(NAME=~"vi_factura1.terc_telefono1~")    JOIN (LEFT=~"vi_factura1.facd_g_financiero~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_g_financiero~"    OUTER1 =~"vi_factura1.facd_g_financiero~" )    JOIN (LEFT=~"vi_factura1.facd_empresa~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_empresa~"    OUTER1 =~"vi_factura1.facd_empresa~" )    JOIN (LEFT=~"vi_factura1.facd_tipo~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_tipo~"    OUTER1 =~"vi_factura1.facd_tipo~" )    JOIN (LEFT=~"vi_factura1.facd_no_pedido~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_no_pedido~"    OUTER1 =~"vi_factura1.facd_no_pedido~" )    JOIN (LEFT=~"vi_factura1.facd_ann~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_ann~"    OUTER1 =~"vi_factura1.facd_ann~" )WHERE(    EXP1 =~"((vi_factura1.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_finan )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_ann~"   OP =~"=~"    EXP2 =~":an )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'))~" ) ) ARG(NAME = ~"grupo_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo_finan", number),("empresa", number),("pedido", string),("an", number))  sort="facd_index A " )
