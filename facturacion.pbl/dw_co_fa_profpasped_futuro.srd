 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fadprofo~" ) COLUMN(NAME=~"fadprofo.dpro_g_financiero~") COLUMN(NAME=~"fadprofo.dpro_empresa~") COLUMN(NAME=~"fadprofo.dpro_no_proforma~") COLUMN(NAME=~"fadprofo.dpro_ann~") COLUMN(NAME=~"fadprofo.dpro_linea~") COLUMN(NAME=~"fadprofo.dpro_producto_servicio~") COLUMN(NAME=~"fadprofo.dpro_codigo_item~") COLUMN(NAME=~"fadprofo.dpro_descripcion_alterna~") COLUMN(NAME=~"fadprofo.dpro_cubucaje~") COLUMN(NAME=~"fadprofo.dpro_peso~") COLUMN(NAME=~"fadprofo.dpro_unidad_peso~") COLUMN(NAME=~"fadprofo.dpro_unidad_producto~") COLUMN(NAME=~"fadprofo.dpro_precio_mayor~") COLUMN(NAME=~"fadprofo.dpro_precio_menor~") COLUMN(NAME=~"fadprofo.dpro_bodega~") COLUMN(NAME=~"fadprofo.dpro_costo_fob~") COLUMN(NAME=~"fadprofo.dpro_costo_cif~") COLUMN(NAME=~"fadprofo.dpro_precio_unidad_producto~") COLUMN(NAME=~"fadprofo.dpro_unidad_venta~") COLUMN(NAME=~"fadprofo.dpro_cantidad~") COLUMN(NAME=~"fadprofo.dpro_fraccion~") COLUMN(NAME=~"fadprofo.dpro_monto_total~") COLUMN(NAME=~"fadprofo.dpro_por_descuento~") COLUMN(NAME=~"fadprofo.dpro_monto_final~") COLUMN(NAME=~"fadprofo.dpro_fecha_reg~") COLUMN(NAME=~"fadprofo.dpro_usuario~") COLUMN(NAME=~"fadprofo.dpro_supervisor~") COLUMN(NAME=~"fadprofo.dpro_bultos~") COLUMN(NAME=~"fadprofo.dpro_ubicacion~") COLUMN(NAME=~"fadprofo.dpro_pasada~") COLUMN(NAME=~"fadprofo.dpro_index~") COMPUTE(NAME=~"0 c_por_pasar,0 c_cant_pas, 0 c_cant_frac, 0 c_a_pasar,' ' dpro_tipo~") COLUMN(NAME=~"fadprofo.dpro_bulto_inicio~") COLUMN(NAME=~"fadprofo.dpro_bulto_fin~") COLUMN(NAME=~"fadprofo.dpro_precio_original~") COLUMN(NAME=~"fadprofo.dpro_costo_total~") COLUMN(NAME=~"fadprofo.dpro_vendedor~")WHERE(    EXP1 =~"(fadprofo.dpro_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fadprofo.dpro_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fadprofo.dpro_no_proforma~"   OP =~"=~"    EXP2 =~":proforma )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadprofo.dpro_ann~"   OP =~"=~"    EXP2 =~":ano )~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"proforma~" TYPE = string)  ARG(NAME = ~"ano~" TYPE = number) " update="fadprofo" updatewhere=0 updatekeyinplace=no arguments=(("g_financiero", number),("empresa", number),("proforma", string),("ano", number))  sort="dpro_codigo_item A " )
