//objectcomments Verifica la secuencia de los pedidos enla tabla  fatdiari
global type gf_fa_verifica_secfad from function_object
end type

forward prototypes
global function str_pasefact gf_fa_verifica_secfad (string as_num_sec)
end prototypes

global function str_pasefact gf_fa_verifica_secfad (string as_num_sec);string ls_pedido, ls_max, ls_tipo, ls_ceros
integer li_existe
long ll_pedexit, ll_pediori
str_pasefact lstr_pase_f
 
  
ll_pediori = long(as_num_sec)
ll_pedexit = long(as_num_sec)

SELECT pedi_tipo
 INTO :ls_tipo 
 FROM fatpedid
WHERE (fatpedid.pedi_g_financiero = :str.g_financiero ) AND  
		( fatpedid.pedi_empresa = :str.empresa ) AND  
		( fatpedid.pedi_ann = :w_fa_fondo.str_para.ano ) AND
		( fatpedid.pedi_no_pedido = convert(varchar(8),:ll_pedexit) );
	if sqlca.sqlcode = -1 then
		mensaje("Aviso","Error al Validar el Ultimo Pedido",sqlca.sqlerrtext)
	end if
		
//If IsNull(ls_tipo) then
ls_ceros = left(as_num_sec,1)

if ll_pedexit <= 0 or ls_ceros = '0' then //Si el numero de la factura tiene ceros a la izq.
	
			 SELECT count(*)
			 INTO :li_existe  
			 FROM fatdiari  
			WHERE ( fatdiari.fact_g_financiero = :str.g_financiero ) AND  
					( fatdiari.fact_empresa = :str.empresa ) AND  
//					( fatdiari.fact_tipo = :ls_tipo ) AND  
					( fatdiari.fact_no_pedido = :as_num_sec ) AND  
					( fatdiari.fact_ann = :w_fa_fondo.str_para.ano )   ;
				if sqlca.sqlcode = -1 then
					mensaje("Aviso","Error al Buscar en Facturas",sqlca.sqlerrtext)
				end if	
			
			if li_existe > 0 then
				lstr_pase_f.numped = '0'
				mensaje("Aviso","La secuencia ya Existe. Verifique","")
			else
				lstr_pase_f.numped = as_num_sec
			end if
			
			lstr_pase_f.tipo = ls_tipo			
			return(lstr_pase_f)						

				
else
			
		DO	
			
			 SELECT count(*)
			 INTO :li_existe  
			 FROM fatdiari  
			WHERE ( fatdiari.fact_g_financiero = :str.g_financiero ) AND  
					( fatdiari.fact_empresa = :str.empresa ) AND  
//					( fatdiari.fact_tipo = :ls_tipo ) AND  
					( fatdiari.fact_no_pedido = convert(varchar(8),:ll_pedexit) ) AND  
					( fatdiari.fact_ann = :w_fa_fondo.str_para.ano )   ;
				if sqlca.sqlcode = -1 then
					mensaje("Aviso","Error al Buscar en Facturas",sqlca.sqlerrtext)
				end if
					
			If li_existe = 1 Then 
				ll_pedexit++
			Else
				//asigna la secuencia encontrada
				lstr_pase_f.numped = string(ll_pedexit)				
				lstr_pase_f.tipo = ls_tipo
				
				return(lstr_pase_f)		
			End If
			
		LOOP UNTIL li_existe = 0
end if


end function

