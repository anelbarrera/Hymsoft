act_modificada_por~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatdiari.fact_descuento_ncr~") COLUMN(NAME=~"fatdiari.fact_ncr_descuento~")    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"( ( fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_tipo~"   OP =~"=~"    EXP2 =~":tipo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":ann))~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"tipo~" TYPE = string)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="fatdiari" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("tipo", string),("pedido", string),("ann", number)) )
