table(column=(type=decimal(0) updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" dbalias=".terc_tercero" initial="0" )
 column=(type=char(20) updatewhereclause=yes name=terc_identificacion dbname="dgmterce.terc_identificacion" dbalias=".terc_identificacion" initial="spaces" )
 column=(type=char(60) updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" initial="spaces" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_pedido dbname="fatdiari.fact_no_pedido" dbalias=".fact_no_pedido" )
 column=(type=char(10) updatewhereclause=yes name=fact_no_factura dbname="fatdiari.fact_no_factura" dbalias=".fact_no_factura" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fatdiari.fact_ann" dbalias=".fact_ann" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_cliente dbname="fatdiari.fact_cliente" dbalias=".fact_cliente" )
 column=(type=char(20) updatewhereclause=yes name=fact_ruc_cliente dbname="fatdiari.fact_ruc_cliente" dbalias=".fact_ruc_cliente" )
 column=(type=char(2) updatewhereclause=yes name=fact_condicion_pago dbname="fatdiari.fact_condicion_pago" dbalias=".fact_condicion_pago" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_tipo_venta dbname="fatdiari.fact_tipo_venta" dbalias=".fact_tipo_venta" values="CONTADO	CO/CRÉDITO	CR/C.O.D	CD/" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fatdiari.fact_fecha" dbalias=".fact_fecha" initial="today" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_g_financiero dbname="fatdiari.fact_g_financiero" dbalias=".fact_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_empresa dbname="fatdiari.fact_empresa" dbalias=".fact_empresa" )
 column=(type=char(250) updatewhereclause=yes name=fara_logo_f dbname="faaparam.fara_logo_f" dbalias=".fara_logo_f" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_gastos_total dbname="fatdiari.fact_gastos_total" dbalias=".fact_gastos_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_fact_total dbname="fatdiari.fact_monto_fact_total" dbalias=".fact_monto_fact_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_final dbname="fatdiari.fact_monto_final" dbalias=".fact_monto_final" )
 column=(type=char(250) updatewhereclause=yes name=faaparam_fara_logo dbname="faaparam.fara_logo" dbalias=".fara_logo" )
 column=(type=decimal(2) updatewhereclause=yes name=costo_totx dbname="compute_ct" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fatdiari.fact_a_nombre" dbalias=".fact_a_nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=costo_tot dbname="fatdiari.fact_costos_total" dbalias=".fact_costos_total" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_nota_credito dbname="fatdiari.fact_nota_credito" dbalias=".fact_nota_credito" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"faaparam~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_tipo_venta~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"faaparam.fara_logo_f~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"faaparam.fara_logo~") COMPUTE(NAME=~"0.00 compute_ct~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_costos_total~") COLUMN(NAME=~"fatdiari.fact_nota_credito~")    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_cierre_de_metal~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="terc_descripcion A long(fact_no_factura) A " )
