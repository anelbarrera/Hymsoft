 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatprofo~" ) COLUMN(NAME=~"fatprofo.prof_g_financiero~") COLUMN(NAME=~"fatprofo.prof_empresa~") COLUMN(NAME=~"fatprofo.prof_no_proforma~") COLUMN(NAME=~"fatprofo.prof_ann~") COLUMN(NAME=~"fatprofo.prof_cliente~") COLUMN(NAME=~"fatprofo.prof_tipo~") COLUMN(NAME=~"fatprofo.prof_condicion_pago~") COLUMN(NAME=~"fatprofo.prof_tipo_movimiento~") COLUMN(NAME=~"fatprofo.prof_no_traspaso~") COLUMN(NAME=~"fatprofo.prof_fecha~") COLUMN(NAME=~"fatprofo.prof_a_nombre~") COLUMN(NAME=~"fatprofo.prof_a_nombre_direccion~") COLUMN(NAME=~"fatprofo.prof_despachado~") COLUMN(NAME=~"fatprofo.prof_marca~") COLUMN(NAME=~"fatprofo.prof_comentario~") COLUMN(NAME=~"fatprofo.prof_estado~") COLUMN(NAME=~"fatprofo.prof_usuario~") COLUMN(NAME=~"fatprofo.prof_consignado~") COLUMN(NAME=~"fatprofo.prof_ruc_cliente~") COLUMN(NAME=~"fatprofo.prof_dias_pago~") COMPUTE(NAME=~"0 vendedor~") COLUMN(NAME=~"fatprofo.prof_tipo_venta~") COLUMN(NAME=~"fatprofo.prof_monto_total~") COLUMN(NAME=~"fatprofo.prof_monto_final~") COLUMN(NAME=~"fatprofo.prof_gastos_total~") COMPUTE(NAME=~"0.00 limite~") COMPUTE(NAME=~"0.00 saldo~") COLUMN(NAME=~"fatprofo.prof_pasaporte~") COLUMN(NAME=~"fatprofo.prof_linea_aerea~") COLUMN(NAME=~"fatprofo.prof_via~") COLUMN(NAME=~"fatprofo.prof_descu_subt_deta~") COLUMN(NAME=~"fatprofo.prof_por_descuento~") COMPUTE(NAME=~"0 captura_por_bulto~") COLUMN(NAME=~"fatprofo.prof_paga_itbm~")WHERE(    EXP1 =~"( fatprofo.prof_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatprofo.prof_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatprofo.prof_no_proforma~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatprofo.prof_ann~"   OP =~"=~"    EXP2 =~":ann )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="fatprofo" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("pedido", string),("ann", number)) )
