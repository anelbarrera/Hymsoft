 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_bultos_total dbname="fatpedid.pedi_bultos_total" dbalias=".pedi_bultos_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_cubicaje_total dbname="fatpedid.pedi_cubicaje_total" dbalias=".pedi_cubicaje_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_peso_total dbname="fatpedid.pedi_peso_total" dbalias=".pedi_peso_total" initial="0" )
