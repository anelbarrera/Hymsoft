 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_tipo_venta dbname="fatpedid.pedi_tipo_venta" dbalias=".pedi_tipo_venta" )
 column=(type=char(1) updatewhereclause=yes name=fatpedid_pedi_tipo_movimiento dbname="fatpedid.pedi_tipo_movimiento" dbalias=".pedi_tipo_movimiento" values="OTROS	O/TRASPASO	T/SALIDA	S/" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_no_traspaso dbname="fatpedid.pedi_no_traspaso" dbalias=".pedi_no_traspaso" )
 column=(type=datetime updatewhereclause=yes name=fatpedid_pedi_fecha dbname="fatpedid.pedi_fecha" dbalias=".pedi_fecha" )
 column=(type=datetime updatewhereclause=yes name=fatpedid_pedi_fecha_creacion dbname="fatpedid.pedi_fecha_creacion" dbalias=".pedi_fecha_creacion" initial="today" )
 column=(type=datetime updatewhereclause=yes name=fatpedid_pedi_fecha_modificacion dbname="fatpedid.pedi_fecha_modificacion" dbalias=".pedi_fecha_modificacion" initial="today" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_dias_pago dbname="fatpedid.pedi_dias_pago" dbalias=".pedi_dias_pago" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_consignado dbname="fatpedid.pedi_consignado" dbalias=".pedi_consignado" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_a_nombre dbname="fatpedid.pedi_a_nombre" dbalias=".pedi_a_nombre" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_a_nombre_direccion dbname="fatpedid.pedi_a_nombre_direccion" dbalias=".pedi_a_nombre_direccion" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_despachado dbname="fatpedid.pedi_despachado" dbalias=".pedi_despachado" )
 column=(type=char(2) updatewhereclause=yes name=fatpedid_pedi_via dbname="fatpedid.pedi_via" dbalias=".pedi_via" initial="OT" values="AÉREA	AE/MARÍTIMA	MR/TERRESTRE	TR/OTROS	OT/" )
 column=(type=char(15) updatewhereclause=yes name=fatpedid_pedi_con_emb_no dbname="fatpedid.pedi_con_emb_no" dbalias=".pedi_con_emb_no" )
