table(column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_g_financiero dbname="fatpedid.pedi_g_financiero" dbalias=".pedi_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_empresa dbname="fatpedid.pedi_empresa" dbalias=".pedi_empresa" )
 column=(type=char(3) updatewhereclause=yes name=fatpedid_pedi_tipo dbname="fatpedid.pedi_tipo" dbalias=".pedi_tipo" )
 column=(type=char(8) updatewhereclause=yes name=fatpedid_pedi_no_pedido dbname="fatpedid.pedi_no_pedido" dbalias=".pedi_no_pedido" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_ann dbname="fatpedid.pedi_ann" dbalias=".pedi_ann" )
