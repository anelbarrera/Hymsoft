 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_monto_total dbname="fatpedid.pedi_monto_total" dbalias=".pedi_monto_total" initial="0" )
 column=(type=char(1) updatewhereclause=yes name=fatpedid_pedi_descu_subt_deta dbname="fatpedid.pedi_descu_subt_deta" dbalias=".pedi_descu_subt_deta" initial="N" )
 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_por_descuento dbname="fatpedid.pedi_por_descuento" dbalias=".pedi_por_descuento" initial="0" )
 column=(type=char(3) updatewhereclause=yes name=fatpedid_pedi_supervisor dbname="fatpedid.pedi_supervisor" dbalias=".pedi_supervisor" )
 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_monto_final dbname="fatpedid.pedi_monto_final" dbalias=".pedi_monto_final" initial="0" )
 column=(type=char(250) updatewhereclause=yes name=fatpedid_pedi_comentario dbname="fatpedid.pedi_comentario" dbalias=".pedi_comentario" )
 column=(type=char(1) updatewhereclause=yes name=fatpedid_pedi_estado dbname="fatpedid.pedi_estado" dbalias=".pedi_estado" initial="A" values="ACTIVA	A/ELIMINADA	E/PASADA	P/APROBADO	R/" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
 column=(type=char(5) updatewhereclause=yes name=fatpedid_pedi_autorizacion dbname="fatpedid.pedi_autorizacion" dbalias=".pedi_autorizacion" )
 column=(type=char(15) updatewhereclause=yes name=pedi_restaurado_por dbname="fatpedid.pedi_restaurado_por" dbalias=".pedi_restaurado_por" )
 column=(type=long updatewhereclause=yes name=incluir dbname="incluir" values="	1/	0" )
 column=(type=long updatewhereclause=yes name=pedi_pedido_vta_diaria dbname="fatpedid.pedi_pedido_vta_diaria" dbalias=".pedi_pedido_vta_diaria" )
 column=(type=char(30) updatewhereclause=yes name=pedi_guia dbname="fatpedid.pedi_guia" dbalias=".pedi_guia" )
 column=(type=char(80) updatewhereclause=yes name=pedi_destino dbname="fatpedid.pedi_destino" dbalias=".pedi_destino" )
 column=(type=char(255) updatewhereclause=yes name=pedi_origen_venta dbname="fatpedid.pedi_origen_venta" dbalias=".pedi_origen_venta" )
 retrieve="  SELECT fatpedid.pedi_g_financiero,   
         fatpedid.pedi_empresa,   
         fatpedid.pedi_tipo,   
         fatpedid.pedi_no_pedido,   
         fatpedid.pedi_ann,   
         fatpedid.pedi_cliente,   
         fatpedid.pedi_ruc_cliente,   
         fatpedid.pedi_condicion_pago,   
         fatpedid.pedi_tipo_venta,   
         fatpedid.pedi_tipo_movimiento,   
         fatpedid.pedi_no_traspaso,   
         fatpedid.pedi_fecha,   
         fatpedid.pedi_fecha_creacion,   
         fatpedid.pedi_fecha_modificacion,   
         fatpedid.pedi_dias_pago,   
         fatpedid.pedi_consignado,   
         fatpedid.pedi_a_nombre,   
         fatpedid.pedi_a_nombre_direccion,   
         fatpedid.pedi_despachado,   
         fatpedid.pedi_via,   
         fatpedid.pedi_con_emb_no,   
         fatpedid.pedi_marca,   
         fatpedid.pedi_bultos_total,   
         fatpedid.pedi_cubicaje_total,   
         fatpedid.pedi_peso_total,   
         fatpedid.pedi_unidad_peso,   
         fatpedid.pedi_gastos_total,   
         fatpedid.pedi_monto_total,   
         fatpedid.pedi_descu_subt_deta,   
         fatpedid.pedi_por_descuento,   
         fatpedid.pedi_supervisor,   
         fatpedid.pedi_monto_final,   
         fatpedid.pedi_comentario,   
         fatpedid.pedi_estado,   
         dgmterce.terc_descripcion,   
         fatpedid.pedi_autorizacion,   
         fatpedid.pedi_restaurado_por,   
         0 incluir,   
         fatpedid.pedi_pedido_vta_diaria,fatpedid.pedi_guia,
			fatpedid.pedi_destino,
		fatpedid.pedi_origen_venta
    FROM dgmterce,   
         fatpedid  
   WHERE ( dgmterce.terc_tercero = fatpedid.pedi_cliente ) and  
         ( ( fatpedid.pedi_g_financiero = :g_financiero ) AND  
         ( fatpedid.pedi_empresa = :empresa ) AND  
         ( fatpedid.pedi_cliente = :cliente )  AND  
         (fatpedid.pedi_estado <> 'P'))   and (not null = 
( 
 SELECT sum(1)
 FROM fadpedid 
 WHERE ( fatpedid.pedi_g_financiero = fadpedid.dped_g_financiero ) and 
 ( fatpedid.pedi_empresa = fadpedid.dped_empresa ) and 
 ( fatpedid.pedi_no_pedido = fadpedid.dped_no_pedido ) and 
 ( fatpedid.pedi_ann = fadpedid.dped_ann ) and 
 fadpedid.dped_pasada < (fadpedid.dped_fraccion + (fadpedid.dped_cantidad * (SELECT inamedid.medi_cantidad 
 FROM inamedid 
 WHERE inamedid.medi_medida = fadpedid.dped_unidad_venta))) )
 



)
 
            
" retrieve.asneeded=yes arguments=(("g_financiero", number),("empresa", number),("cliente", number))  sort="fatpedid_pedi_fecha A fatpedid_pedi_no_pedido A fatpedid_pedi_ann A " )
