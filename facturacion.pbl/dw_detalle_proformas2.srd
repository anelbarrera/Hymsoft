 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fadprofo2~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"fadprofo2.dpro_g_financiero~") COLUMN(NAME=~"fadprofo2.dpro_empresa~") COLUMN(NAME=~"fadprofo2.dpro_no_proforma~") COLUMN(NAME=~"fadprofo2.dpro_linea~") COLUMN(NAME=~"fadprofo2.dpro_ann~") COLUMN(NAME=~"fadprofo2.dpro_codigo_item~") COLUMN(NAME=~"fadprofo2.dpro_descripcion_alterna~") COLUMN(NAME=~"fadprofo2.dpro_cubucaje~") COLUMN(NAME=~"fadprofo2.dpro_peso~") COLUMN(NAME=~"fadprofo2.dpro_unidad_producto~") COLUMN(NAME=~"fadprofo2.dpro_precio_unidad_producto~") COLUMN(NAME=~"fadprofo2.dpro_unidad_venta~") COLUMN(NAME=~"fadprofo2.dpro_cantidad~") COLUMN(NAME=~"fadprofo2.dpro_fraccion~") COLUMN(NAME=~"fadprofo2.dpro_monto_total~") COLUMN(NAME=~"fadprofo2.dpro_monto_final~") COLUMN(NAME=~"fadprofo2.dpro_usuario~") COLUMN(NAME=~"fadprofo2.dpro_bultos~") COLUMN(NAME=~"fadprofo2.dpro_index~") COLUMN(NAME=~"fadprofo2.dpro_bulto_inicio~") COLUMN(NAME=~"fadprofo2.dpro_bulto_fin~") COLUMN(NAME=~"fadprofo2.dpro_costo_fob~") COLUMN(NAME=~"fadprofo2.dpro_costo_cif~") COLUMN(NAME=~"fadprofo2.dpro_costo_total~") COLUMN(NAME=~"fadprofo2.dpro_precio_original~") COLUMN(NAME=~"inamedid.medi_tipo_medida~") COLUMN(NAME=~"fadprofo2.dpro_bodega~") COLUMN(NAME=~"fadprofo2.dpro_ubicacion~") COLUMN(NAME=~"fadprofo2.dpro_modelo~") COLUMN(NAME=~"fadprofo2.dpro_bultos_original~") COLUMN(NAME=~"fadprofo2.dpro_comentario~") COLUMN(NAME=~"fadprofo2.dpro_peso_neto~") COLUMN(NAME=~"fadprofo2.dpro_cubicaje_metros~") COLUMN(NAME=~"fadprofo2.dpro_producto_servicio~") COLUMN(NAME=~"fadprofo2.dpro_unidad_peso~")    JOIN (LEFT=~"fadprofo2.dpro_unidad_venta~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"( ( fadprofo2.dpro_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadprofo2.dpro_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadprofo2.dpro_no_proforma~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadprofo2.dpro_ann~"   OP =~"=~"    EXP2 =~":ann ) )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="fadprofo2" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("pedido", string),("ann", number))  sort="dpro_linea A " )
