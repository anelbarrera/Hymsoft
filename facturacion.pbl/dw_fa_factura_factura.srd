 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COMPUTE(NAME=~"0 incluir~") COLUMN(NAME=~"fatdiari.fact_monto_final~")    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"in~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_nota_credito~"   OP =~"=~"    EXP2 =~"0~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("g_financiero", number),("empresa", number))  sort="long(fatpedid_pedi_no_pedido) A fatdiari_fact_fecha A fatdiari_fact_ann A " )
