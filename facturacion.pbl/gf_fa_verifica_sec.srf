//objectcomments  
global type gf_fa_verifica_sec from function_object
end type

forward prototypes
global function string gf_fa_verifica_sec (string as_num_sec)
end prototypes

global function string gf_fa_verifica_sec (string as_num_sec);string ls_pedido, ls_max, ls_ceros
integer li_existe, li_i
long ll_pedexit,ll_annio
 
ll_annio = Long(Year(Date(gf_fecha_serv())))
ls_ceros = left(as_num_sec,1)
ll_pedexit = long(as_num_sec)

if ll_pedexit <= 0 or ls_ceros = '0' then //Si el numero de la factura tiene ceros a la izq.
	
			 SELECT count(*)
			 INTO :li_existe  
			 FROM fatpedid  
			WHERE ( fatpedid.pedi_g_financiero = :str.g_financiero ) AND  
					( fatpedid.pedi_empresa = :str.empresa ) AND  
					( fatpedid.pedi_no_pedido = :as_num_sec ) AND  
					( fatpedid.pedi_ann = :ll_annio )   ;
				if sqlca.sqlcode = -1 then
					mensaje("Aviso","Error al Buscar en Facturas",sqlca.sqlerrtext)
				end if	
			
			if li_existe > 0 then
				ls_pedido = '0'
				mensaje("Aviso","La secuencia ya Existe. Verifique","")
			else
				ls_pedido = as_num_sec
			end if
			
			return(ls_pedido)				
else

		DO	
			
			SELECT count(*)
			 INTO :li_existe  
			 FROM fatpedid
			WHERE (fatpedid.pedi_g_financiero = :str.g_financiero ) AND  
					( fatpedid.pedi_empresa = :str.empresa ) AND  
					( fatpedid.pedi_ann = :ll_annio ) AND
					( fatpedid.pedi_no_pedido = convert(varchar(8),:ll_pedexit) ) ;
				if sqlca.sqlcode = -1 then
					mensaje("Aviso","Error al Validar el Pedido",sqlca.sqlerrtext)
				end if
					
					
			If li_existe > 0 Then
				
				SELECT  faaparam.fara_ult_pedido  
					INTO :ls_max
					FROM faaparam 
				WHERE (faaparam.fara_g_financiero = :str.g_financiero) AND  
					(faaparam.fara_empresa = :str.empresa);
				
				If sqlca.sqlcode = -1 then
					messagebox("ERROR EN PAÁMETRROS",sqlca.SQLErrText)
					return ('0')
				End If                      
				
				If ll_pedexit = long(ls_max) then
					ll_pedexit++
				Else
					ll_pedexit = long(ls_max) + 1
				End If
		//		Mensaje("AVISO","Este Número de Pedido ya existe el número a utilizar es el "+ ls_max +"","")
		//		return(long(ls_max))
			Else
				li_existe = 0
			End If
			
		LOOP UNTIL li_existe = 0
			If li_existe  = 0 then
				ls_pedido = string(ll_pedexit)
				return(ls_pedido)
			End If
			
End if //del pedexit <> 0
end function

