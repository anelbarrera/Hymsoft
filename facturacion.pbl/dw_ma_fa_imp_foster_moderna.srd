EXP1 =~"(vi_factura1.fact_ann~"   OP =~"=~"    EXP2 =~":an )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_tipo~"   OP =~"=~"    EXP2 =~":tipo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'))~" ) ) ARG(NAME = ~"grupo_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number)  ARG(NAME = ~"tipo~" TYPE = string) " arguments=(("grupo_finan", number),("empresa", number),("pedido", string),("an", number),("tipo", string))  sort="facd_index A " )
