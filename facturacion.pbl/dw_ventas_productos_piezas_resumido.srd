//objectcomments Ventas por Factura, Detallado.
release 12;
datawindow(units=2 timer_interval=60000 color=1090519039 brushmode=0 transparency=0 gradient.angle=0 gradient.color=8421504 gradient.focus=0 gradient.repetition.count=0 gradient.repetition.length=100 gradient.repetition.mode=0 gradient.scale=100 gradient.spread=100 gradient.transparency=0 picture.blur=0 picture.clip.bottom=0 picture.clip.left=0 picture.clip.right=0 picture.clip.top=0 picture.mode=0 picture.scale.x=100 picture.scale.y=100 picture.transparency=0 processing=0 HTMLDW=no print.printername="" print.documentname="" print.orientation = 2 print.margin.left = 250 print.margin.right = 322 print.margin.top = 250 print.margin.bottom = 250 print.paper.source = 0 print.paper.size = 1 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes print.background=no print.preview.background=no print.preview.outline=yes hidegrayline=no showbackcoloronxp=no picture.file="" )
header(height=10 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.count="0" gradient.repetition.length="100" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
summary(height=239 color="-1" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.count="0" gradient.repetition.length="100" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
footer(height=0 color="-1" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.count="0" gradient.repetition.length="100" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=187 color="-1" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.count="0" gradient.repetition.length="100" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=decimal(6) updatewhereclause=yes name=cantidad_gramos dbname="cantidad_gramos" )
 column=(type=decimal(4) updatewhereclause=yes name=valor_producto dbname="valor_producto" )
 column=(type=char(65) updatewhereclause=yes name=prod_descripcion dbname="prod_descripcion" )
 column=(type=decimal(10) updatewhereclause=yes name=valor_recargo dbname="valor_recargo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ) COMPUTE(NAME=~"sum( facd_cantidad ) cantidad_gramos~") COMPUTE(NAME=~"sum( facd_monto_final ) valor_producto~") COMPUTE(NAME=~"max( prod_descripcion ) prod_descripcion~") COMPUTE(NAME=~"sum( facd_precio_recargo * facd_cantidad ) valor_recargo~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"faddiari.facd_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_cierre_de_metal~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( inamedid.medi_tipo_medida~"   OP =~"<>~"    EXP2 =~"5~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"inamedid.medi_medida~"   OP =~"=~"    EXP2 =~"'GG')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_kilates~"   OP =~"=~"    EXP2 =~"0~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("fecha1", datetime),("fecha2", datetime))  sort="prod_descripcion A " )
