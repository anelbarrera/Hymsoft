 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fadprofo~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"fadprofo.dpro_linea~") COLUMN(NAME=~"fadprofo.dpro_codigo_item~") COLUMN(NAME=~"fadprofo.dpro_descripcion_alterna~") COLUMN(NAME=~"fadprofo.dpro_unidad_venta~") COLUMN(NAME=~"fadprofo.dpro_cantidad~") COLUMN(NAME=~"fadprofo.dpro_fraccion~") COMPUTE(NAME=~"fadprofo.dpro_pasada - (convert(numeric(10,0),( fadprofo.dpro_pasada /inamedid.medi_cantidad)) * inamedid.medi_cantidad) pasada_fraccion~") COMPUTE(NAME=~"case when inamedid.medi_tipo_medida = 5 then convert(numeric(12,3),( fadprofo.dpro_pasada /inamedid.medi_cantidad)) else convert(numeric(10,0),( fadprofo.dpro_pasada /inamedid.medi_cantidad)) end pasada~") COMPUTE(NAME=~"pasar = 0~") COMPUTE(NAME=~"((fadprofo.dpro_cantidad * inamedid.medi_cantidad + fadprofo.dpro_fraccion) - fadprofo.dpro_pasada ) - ( convert(numeric(10,0), ((fadprofo.dpro_cantidad * inamedid.medi_cantidad + fadprofo.dpro_fraccion) - fadprofo.dpro_pasada ) / inamedid.medi_cantidad) * inamedid.medi_cantidad) por_pasar_fraccion~") COMPUTE(NAME=~"case when inamedid.medi_tipo_medida = 5 then convert(numeric(12,3), ((fadprofo.dpro_cantidad * inamedid.medi_cantidad + fadprofo.dpro_fraccion) - fadprofo.dpro_pasada ) / inamedid.medi_cantidad) else convert(numeric(10,0), ((fadprofo.dpro_cantidad * inamedid.medi_cantidad + fadprofo.dpro_fraccion) - fadprofo.dpro_pasada ) / inamedid.medi_cantidad) end  por_pasar~") COMPUTE(NAME=~"((fadprofo.dpro_cantidad * inamedid.medi_cantidad + fadprofo.dpro_fraccion) - fadprofo.dpro_pasada ) - ( convert(numeric(10,0), ((fadprofo.dpro_cantidad * inamedid.medi_cantidad + fadprofo.dpro_fraccion) - fadprofo.dpro_pasada ) / inamedid.medi_cantidad) * inamedid.medi_cantidad) pendiente_fraccion~") COMPUTE(NAME=~"case when inamedid.medi_tipo_medida = 5 then convert(numeric(12,3), ((fadprofo.dpro_cantidad * inamedid.medi_cantidad + fadprofo.dpro_fraccion) - fadprofo.dpro_pasada ) / inamedid.medi_cantidad)  else convert(numeric(10,0), ((fadprofo.dpro_cantidad * inamedid.medi_cantidad + fadprofo.dpro_fraccion) - fadprofo.dpro_pasada ) / inamedid.medi_cantidad) end  pendiente~") COLUMN(NAME=~"inamedid.medi_tipo_medida~")    JOIN (LEFT=~"fadprofo.dpro_unidad_venta~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"fadprofo.dpro_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadprofo.dpro_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadprofo.dpro_no_proforma~"   OP =~"=~"    EXP2 =~":prof~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadprofo.dpro_ann~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"convert(numeric(12,3), ((isnull(fadprofo.dpro_cantidad,0) * inamedid.medi_cantidad + isnull(fadprofo.dpro_fraccion,0)) - isnull(fadprofo.dpro_pasada,0) ) / inamedid.medi_cantidad)~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"prof~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("prof", string),("ann", number))  sort="dpro_linea A " )
