 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faaparam~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"faaparam.fara_logo_f~") COLUMN(NAME=~"faaparam.fara_logo~") COLUMN(NAME=~"faaparam.fara_logo_apli~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COMPUTE(NAME=~"~~~"                                        ~~~"aprobado,~~~"                                        ~~~"recolectado, ~~~"              ~~~" asignado, ~~~"              ~~~"  noasignado, ~~~"            ~~~"cantidad~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"inamedid.medi_descripcion~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_consignado~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_marca~") COLUMN(NAME=~"faddiari.facd_linea~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_descripcion_alterna~") COLUMN(NAME=~"faddiari.facd_cubicaje~") COLUMN(NAME=~"faddiari.facd_peso~") COLUMN(NAME=~"faddiari.facd_unidad_peso~") COLUMN(NAME=~"faddiari.facd_unidad_producto~") COLUMN(NAME=~"faddiari.facd_bodega~") COLUMN(NAME=~"faddiari.facd_costo_cif~") COLUMN(NAME=~"faddiari.facd_unidad_venta~") COLUMN(NAME=~"faddiari.facd_cantidad~") COLUMN(NAME=~"faddiari.facd_cantidad_fraccion~") COLUMN(NAME=~"faddiari.facd_ubicacion~") COLUMN(NAME=~"faddiari.facd_cant_asignada~") COLUMN(NAME=~"faddiari.facd_bulto_inicio~") COLUMN(NAME=~"faddiari.facd_bulto_fin~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"faddiari.facd_bultos~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"faddiari.facd_unidad_venta~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"((fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_no_pedido~"   OP =~"=~"    EXP2 =~":no_pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":no_ped_anno )~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(fatdiari.fact_tipo~"   OP =~"=~"    EXP2 =~":tipo_fac))~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"no_pedido~" TYPE = string)  ARG(NAME = ~"no_ped_anno~" TYPE = number)  ARG(NAME = ~"tipo_fac~" TYPE = string) " arguments=(("g_financiero", number),("empresa", number),("no_pedido", string),("no_ped_anno", number),("tipo_fac", string))  sort="faddiari_facd_bulto_inicio A faddiari_facd_bulto_fin A faddiari_facd_bultos D " )
