table(column=(type=char(134) updatewhereclause=yes name=descrip dbname="descrip" )
 column=(type=decimal(0) updatewhereclause=yes name=fatprofo_prof_g_financiero dbname="fatprofo.prof_g_financiero" dbalias=".prof_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=fatprofo_prof_empresa dbname="fatprofo.prof_empresa" dbalias=".prof_empresa" )
 column=(type=char(8) updatewhereclause=yes name=no_pedido dbname="fatprofo.prof_no_proforma" dbalias=".prof_no_proforma" )
 column=(type=decimal(0) updatewhereclause=yes name=anno dbname="fatprofo.prof_ann" dbalias=".prof_ann" )
 column=(type=char(1) updatewhereclause=yes name=fatprofo_prof_estado dbname="fatprofo.prof_estado" dbalias=".prof_estado" )
 column=(type=char(3) updatewhereclause=yes name=fatprofo_prof_tipo dbname="fatprofo.prof_tipo" dbalias=".prof_tipo" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" dbalias=".terc_tercero" )
 column=(type=char(60) update=yes updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
 column=(type=char(20) update=yes updatewhereclause=yes name=terc_identificacion dbname="dgmterce.terc_identificacion" dbalias=".terc_identificacion" )
 column=(type=char(20) updatewhereclause=yes name=fatprofo_prof_ruc_cliente dbname="fatprofo.prof_ruc_cliente" dbalias=".prof_ruc_cliente" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"fatprofo~" )  TABLE(NAME=~"ccmclien~" )  TABLE(NAME=~"dgmterce~" ) COMPUTE(NAME=~"dgmterce.terc_descripcion+'                                                                     '+convert(varchar(5), dgmterce.terc_tercero) descrip~") COLUMN(NAME=~"fatprofo.prof_g_financiero~") COLUMN(NAME=~"fatprofo.prof_empresa~") COLUMN(NAME=~"fatprofo.prof_no_proforma~") COLUMN(NAME=~"fatprofo.prof_ann~") COLUMN(NAME=~"fatprofo.prof_estado~") COLUMN(NAME=~"fatprofo.prof_tipo~") COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"fatprofo.prof_ruc_cliente~")    JOIN (LEFT=~"ccmclien.clie_g_financiero~"    OP =~"=~"RIGHT=~"fatprofo.prof_g_financiero~" )    JOIN (LEFT=~"ccmclien.clie_empresa~"    OP =~"=~"RIGHT=~"fatprofo.prof_empresa~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"fatprofo.prof_cliente~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )WHERE(    EXP1 =~"fatprofo.prof_g_financiero~"   OP =~"=~"    EXP2 =~":cli_grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatprofo.prof_empresa~"   OP =~"=~"    EXP2 =~":cli_empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatprofo.prof_ann~"   OP =~"=~"    EXP2 =~":cli_anio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatprofo.prof_estado~"   OP =~"<>~"    EXP2 =~"'P'~" ) ) ARG(NAME = ~"cli_grupo~" TYPE = number)  ARG(NAME = ~"cli_empresa~" TYPE = number)  ARG(NAME = ~"cli_anio~" TYPE = number) " arguments=(("cli_grupo", number),("cli_empresa", number),("cli_anio", number))  sort="long(no_pedido) A terc_descripcion A " )
