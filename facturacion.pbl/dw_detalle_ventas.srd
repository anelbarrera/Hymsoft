table(column=(type=char(10) updatewhereclause=yes name=fact_no_factura dbname="fatdiari.fact_no_factura" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fatdiari.fact_fecha" )
 column=(type=char(20) updatewhereclause=yes name=fact_ruc_cliente dbname="fatdiari.fact_ruc_cliente" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fatdiari.fact_a_nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=subtotal dbname="subtotal" )
 column=(type=decimal(4) updatewhereclause=yes name=cargos dbname="cargos" )
 column=(type=decimal(4) updatewhereclause=yes name=total dbname="total" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COMPUTE(NAME=~"case when fact_nota_credito  = 1 then fact_monto_fact_total * -1 else fact_monto_fact_total end subtotal~") COMPUTE(NAME=~"case when fact_nota_credito  = 1 then fact_gastos_total * -1 else fact_gastos_total end cargos~") COMPUTE(NAME=~"case when fact_nota_credito  = 1 then fact_monto_final * -1 else fact_monto_final end total~")WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("fecha1", datetime),("fecha2", datetime))  sort="long(fact_no_factura) A fact_fecha A " )
