//objectcomments Resumen de la Factura
release 7;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=80 color="536870912" )
summary(height=236 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=faddiari_facd_codigo_item dbname="faddiari.facd_codigo_item" )
 column=(type=decimal(4) updatewhereclause=yes name=monto_final dbname="monto_final" )
 column=(type=decimal(0) updatewhereclause=yes name=fraccion dbname="fraccion" )
 column=(type=decimal(0) updatewhereclause=yes name=tipo_medida dbname="tipo_medida" )
 column=(type=char(255) updatewhereclause=yes name=faddiari_facd_descripcion_alterna dbname="facd_descripcion_alterna" )
 column=(type=decimal(6) updatewhereclause=yes name=cantidad dbname="cantidad" )
 column=(type=decimal(4) updatewhereclause=yes name=gastos dbname="gastos" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"faddiari.facd_codigo_item~") COMPUTE(NAME=~"sum( facd_monto_final ) monto_final~") COMPUTE(NAME=~"sum( facd_cantidad_fraccion ) fraccion~") COMPUTE(NAME=~"max(medi_tipo_medida) tipo_medida~") COMPUTE(NAME=~"max(facd_descripcion_alterna) facd_descripcion_alterna~") COMPUTE(NAME=~"sum( case when facd_cantidad < 0 then 0 else facd_cantidad end ) cantidad~") COMPUTE(NAME=~"max( fatdiari.fact_gastos_total ) gastos~")    JOIN (LEFT=~"faddiari.facd_unidad_venta~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )WHERE(    EXP1 =~"faddiari.facd_g_financiero~"   OP =~"=~"    EXP2 =~":nes_grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_empresa~"   OP =~"=~"    EXP2 =~":nes_empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_no_pedido~"   OP =~"=~"    EXP2 =~":nes_pedido~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_ann~"   OP =~"=~"    EXP2 =~":nes_ann~" )  GROUP(NAME=~"faddiari.facd_codigo_item~")) ARG(NAME = ~"nes_grupo~" TYPE = number)  ARG(NAME = ~"nes_empresa~" TYPE = number)  ARG(NAME = ~"nes_pedido~" TYPE = string)  ARG(NAME = ~"nes_ann~" TYPE = number) " arguments=(("nes_grupo", number),("nes_empresa", number),("nes_pedido", string),("nes_ann", number)) )
