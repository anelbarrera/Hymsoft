//objectcomments Reporte del Total de Onzas
release 7;
datawindow(units=2 timer_interval=60000 color=1090519039 processing=0 HTMLDW=no print.documentname="" print.orientation = 2 print.margin.left = 250 print.margin.right = 322 print.margin.top = 250 print.margin.bottom = 250 print.paper.source = 0 print.paper.size = 1 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=322 color="536870912" )
summary(height=1656 color="-1" )
footer(height=0 color="-1" )
detail(height=0 color="-1" )
table(column=(type=decimal(6) updatewhereclause=yes name=total_24 dbname="total_24" )
 column=(type=decimal(6) updatewhereclause=yes name=total_18 dbname="total_18" )
 column=(type=decimal(6) updatewhereclause=yes name=total_10 dbname="total_10" )
 column=(type=decimal(2) updatewhereclause=yes name=cerradas dbname="cerradas" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"inmprodu~" ) COMPUTE(NAME=~"sum( case prod_kilates when 24 then facd_cantidad else 0 end ) total_24~") COMPUTE(NAME=~"sum( case prod_kilates when 18 then facd_cantidad else 0 end ) total_18~") COMPUTE(NAME=~"sum( case prod_kilates when 10 then facd_cantidad else 0 end ) total_10~") COMPUTE(NAME=~"0.00 cerradas~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"faddiari.facd_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_cierre_de_metal~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_kilates~"   OP =~"<>~"    EXP2 =~"0~" )  GROUP(NAME=~"faddiari.facd_codigo_item~")) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("fecha1", datetime),("fecha2", datetime)) )
column(band=detail id=1 alignment="1" tabsequence=32766 border="2" color="0" x="1052" y="21" height="156" width="583" format="##,##0.00"  name=total_24 edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=2 alignment="1" tabsequence=32766 border="2" color="0" x="1468" y="0" height="156" width="583" format="##,##0.00"  name=total_18 edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=3 alignment="1" tabsequence=32766 border="2" color="0" x="1739" y="10" height="156" width="583" format="##,##0.00"  name=total_10 edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=header alignment="2" text="TOTALES DE ONZAS" border="3" color="0" x="83" y="72" height="156" width="1406"  name=t_4  resizeable=1  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="15780518" )
text(band=summary alignment="1" text="Excedentes:" border="3" color="0" x="114" y="1365" height="156" width="729"  name=t_7  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=summary alignment="0" text="24 KILATES: " border="2" color="0" x="52" y="31" height="156" width="854"  name=t_1  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=summary alignment="0" text="18 KILATES: " border="2" color="0" x="52" y="250" height="156" width="854"  name=t_2  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=summary alignment="0" text="10 KILATES: " border="2" color="0" x="52" y="469" height="156" width="854"  name=t_3  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=summary alignment="1" text="Cerradas:" border="3" color="0" x="114" y="1042" height="156" width="729"  name=t_6  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
text(band=summary alignment="1" text="Vendidas: " border="3" color="0" x="114" y="719" height="156" width="729"  name=t_5  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
line(band=summary x1="947" y1="656" x2="1718" y2="656"  name=l_1 pen.style="0" pen.width="10" pen.color="0"  background.mode="2" background.color="1090519039" )
compute(band=summary alignment="1" expression="( sum( total_10 ) / 31.1035 ) * .438"border="2" color="0" x="968" y="469" height="156" width="718" format="##,##0.00"  name=k10  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=summary alignment="1" expression="( sum( total_18 ) / 31.1035 ) *  .780"border="2" color="0" x="968" y="250" height="156" width="718" format="##,##0.00"  name=k18  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=summary alignment="1" expression="sum(  total_24  ) / 31.1035"border="2" color="0" x="968" y="31" height="156" width="718" format="##,##0.00"  name=k24  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=summary alignment="1" expression="round( k24 +  k18 +  k10  ,2)"border="2" color="0" x="968" y="719" height="166" width="729" format="##,##0.00"  name=vendidas  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=summary alignment="1" expression="sum(cerradas)"border="2" color="0" x="968" y="1031" height="166" width="729" format="##,##0.00"  name=cerradas  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=summary alignment="1" expression="round( cerradas - vendidas ,2)"border="2" color="0" x="968" y="1354" height="166" width="729" format="##,##0.00"  name=excedentes  font.face="Arial" font.height="-9" font.weight="700"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
htmltable(border="1" )
