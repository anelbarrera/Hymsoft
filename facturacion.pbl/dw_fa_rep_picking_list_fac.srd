 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaperio~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"dgmempre.empr_direccion~") COLUMN(NAME=~"dgmempre.empr_apartado_postal~") COLUMN(NAME=~"dgmempre.empr_telefono1~") COLUMN(NAME=~"dgmempre.empr_telefono2~") COLUMN(NAME=~"dgmempre.empr_fax1~") COLUMN(NAME=~"dgmempre.empr_fax2~") COLUMN(NAME=~"dgmempre.empr_e_mail~") COLUMN(NAME=~"inmprodu.prod_marca~") COLUMN(NAME=~"inmprodu.prod_pais~") COLUMN(NAME=~"dgmempre.empr_ficha~") COLUMN(NAME=~"dgmempre.empr_rollo~") COLUMN(NAME=~"dgmempre.empr_imagen~") COLUMN(NAME=~"dgmempre.empr_dijito_verificador~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_tipo_venta~") COLUMN(NAME=~"fatdiari.fact_tipo_movimiento~") COLUMN(NAME=~"fatdiari.fact_no_traspaso~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_fecha_creacion~") COLUMN(NAME=~"fatdiari.fact_fecha_modificacion~") COLUMN(NAME=~"fatdiari.fact_dias_pago~") COLUMN(NAME=~"fatdiari.fact_fecha_fin_plazo~") COLUMN(NAME=~"fatdiari.fact_fecha_cancelado~") COLUMN(NAME=~"fatdiari.fact_consignado~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_a_nombre_direccion~") COLUMN(NAME=~"fatdiari.fact_despachado~") COLUMN(NAME=~"fatdiari.fact_via~") COLUMN(NAME=~"fatdiari.fact_con_emb_no~") COLUMN(NAME=~"fatdiari.fact_marca~") COLUMN(NAME=~"fatdiari.fact_bultos_total~") COLUMN(NAME=~"fatdiari.fact_cubicaje_total~") COLUMN(NAME=~"fatdiari.fact_peso_total~") COLUMN(NAME=~"fatdiari.fact_unidad_peso~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_descuento_subt_deta~") COLUMN(NAME=~"fatdiari.fact_por_descuento~") COLUMN(NAME=~"fatdiari.fact_supervisor~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"fatdiari.fact_comentario~") COLUMN(NAME=~"fatdiari.fact_estado~") COLUMN(NAME=~"fatdiari.fact_act_cliente~") COLUMN(NAME=~"fatdiari.fact_act_inventario~") COLUMN(NAME=~"fatdiari.fact_act_conta~") COLUMN(NAME=~"fatdiari.fact_cerrada~") COLUMN(NAME=~"fatdiari.fact_referencia_fac~") COLUMN(NAME=~"fatdiari.fact_monto_abonado~") COLUMN(NAME=~"faddiari.facd_pedido_original~") COLUMN(NAME=~"faddiari.facd_linea~") COLUMN(NAME=~"faddiari.facd_producto_servicio~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_descripcion_alterna~") COLUMN(NAME=~"faddiari.facd_cubicaje~") COLUMN(NAME=~"faddiari.facd_peso~") COLUMN(NAME=~"faddiari.facd_unidad_peso~") COLUMN(NAME=~"faddiari.facd_unidad_producto~") COLUMN(NAME=~"faddiari.facd_precio_mayor~") COLUMN(NAME=~"faddiari.facd_precio_menor~") COLUMN(NAME=~"faddiari.facd_bodega~") COLUMN(NAME=~"faddiari.facd_costo_fob~") COLUMN(NAME=~"faddiari.facd_costo_cif~") COLUMN(NAME=~"faddiari.facd_precio_unidad_producto~") COLUMN(NAME=~"faddiari.facd_unidad_venta~") COLUMN(NAME=~"faddiari.facd_cantidad~") COLUMN(NAME=~"faddiari.facd_cantidad_fraccion~") COLUMN(NAME=~"faddiari.facd_monto_total~") COLUMN(NAME=~"faddiari.facd_por_descuento~") COLUMN(NAME=~"faddiari.facd_monto_final~") COLUMN(NAME=~"faddiari.facd_fecha_reg~") COLUMN(NAME=~"faddiari.facd_usuario~") COLUMN(NAME=~"faddiari.facd_supervisor~") COLUMN(NAME=~"faddiari.facd_bultos~") COLUMN(NAME=~"faddiari.facd_pais~") COLUMN(NAME=~"faddiari.facd_ubicacion~") COLUMN(NAME=~"faddiari.facd_cant_devuelta~") COLUMN(NAME=~"faddiari.facd_linea_articulo_dev~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"dgaperio.peri_descripcion~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_descripcion~") COLUMN(NAME=~"inmprodu.prod_medida~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COMPUTE(NAME=~"prod_existencia_total -  prod_reserva_total  disponible,           ~~~"~~~" cambio,           ~~~"~~~" parcial~") COLUMN(NAME=~"faddiari.facd_tipo~") COLUMN(NAME=~"faddiari.facd_no_pedido~") COLUMN(NAME=~"faddiari.facd_ann~") COLUMN(NAME=~"faddiari.facd_g_financiero~") COLUMN(NAME=~"faddiari.facd_empresa~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COMPUTE(NAME=~"convert(numeric(10,0),( prod_existencia_total / medi_cantidad)) exis_ent~") COMPUTE(NAME=~"round((convert(numeric(10,4),(prod_existencia_total / medi_cantidad)) - convert(numeric(10,0),( prod_existencia_total / medi_cantidad)) ) * medi_cantidad,2) exis_frac~") COMPUTE(NAME=~"convert(numeric(10,0),(( prod_existencia_total - prod_reserva_total ) / medi_cantidad)) dis_ent~") COMPUTE(NAME=~"round((convert(numeric(10,4),(( prod_existencia_total - prod_reserva_total ) / medi_cantidad)) - convert(numeric(10,0),(( prod_existencia_total - prod_reserva_total ) / medi_cantidad)) ) * medi_cantidad,2) dis_frac~") COLUMN(NAME=~"faddiari.facd_index~") COLUMN(NAME=~"inmprodu.prod_documento_entrada~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"faddiari.facd_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"inmprodu.prod_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"fatdiari.fact_dias_pago~"    OP =~"=~"RIGHT=~"dgaperio.peri_periodo~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )WHERE(    EXP1 =~"((fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":an)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA' ) )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("pedido", string),("an", number))  sort="facd_codigo_item A facd_bodega A facd_ubicacion A " )
