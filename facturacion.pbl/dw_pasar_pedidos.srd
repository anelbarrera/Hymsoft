 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatpedid~" ) COMPUTE(NAME=~"pasar = 0~") COLUMN(NAME=~"fatpedid.pedi_g_financiero~") COLUMN(NAME=~"fatpedid.pedi_empresa~") COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_ann~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fatpedid.pedi_monto_final~")WHERE(    EXP1 =~"fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_estado~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " update="fatpedid" updatewhere=0 updatekeyinplace=no arguments=(("grupo", number),("empresa", number))  sort="pedi_fecha A pedi_no_pedido A " )
