 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fadpedid~" ) COLUMN(NAME=~"fadpedid.dped_g_financiero~") COLUMN(NAME=~"fadpedid.dped_empresa~") COLUMN(NAME=~"fadpedid.dped_no_pedido~") COLUMN(NAME=~"fadpedid.dped_ann~") COLUMN(NAME=~"fadpedid.dped_linea~") COLUMN(NAME=~"fadpedid.dped_producto_servicio~") COLUMN(NAME=~"fadpedid.dped_codigo_item~") COLUMN(NAME=~"fadpedid.dped_descripcion_alterna~") COLUMN(NAME=~"fadpedid.dped_cubicaje~") COLUMN(NAME=~"fadpedid.dped_peso~") COLUMN(NAME=~"fadpedid.dped_unidad_peso~") COLUMN(NAME=~"fadpedid.dped_unidad_producto~") COLUMN(NAME=~"fadpedid.dped_precio_mayor~") COLUMN(NAME=~"fadpedid.dped_precio_menor~") COLUMN(NAME=~"fadpedid.dped_bodega~") COLUMN(NAME=~"fadpedid.dped_costo_fob~") COLUMN(NAME=~"fadpedid.dped_costo_cif~") COLUMN(NAME=~"fadpedid.dped_precio_unidad_producto~") COLUMN(NAME=~"fadpedid.dped_unidad_venta~") COLUMN(NAME=~"fadpedid.dped_cantidad~") COLUMN(NAME=~"fadpedid.dped_fraccion~") COLUMN(NAME=~"fadpedid.dped_monto_total~") COLUMN(NAME=~"fadpedid.dped_por_descuento~") COLUMN(NAME=~"fadpedid.dped_monto_final~") COLUMN(NAME=~"fadpedid.dped_fecha_reg~") COLUMN(NAME=~"fadpedid.dped_usuario~") COLUMN(NAME=~"fadpedid.dped_supervisor~") COLUMN(NAME=~"fadpedid.dped_bultos~") COLUMN(NAME=~"fadpedid.dped_ubicacion~") COLUMN(NAME=~"fadpedid.dped_pasada~") COLUMN(NAME=~"fadpedid.dped_index~") COMPUTE(NAME=~"0 c_por_pasar,0 c_cant_pas, 0 c_cant_frac, 0 c_a_pasar, 0 viene_de_pedido~") COLUMN(NAME=~"fadpedid.dped_bulto_inicio~") COLUMN(NAME=~"fadpedid.dped_bulto_fin~") COLUMN(NAME=~"fadpedid.dped_precio_original~") COLUMN(NAME=~"fadpedid.dped_costo_total~") COLUMN(NAME=~"fadpedid.dped_precio_descuento~") COLUMN(NAME=~"fadpedid.dped_descuento_ncr~") COLUMN(NAME=~"fadpedid.dped_vendedor~")WHERE(    EXP1 =~"( fadpedid.dped_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadpedid.dped_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadpedid.dped_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadpedid.dped_ann~"   OP =~"=~"    EXP2 =~":ano )~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ano~" TYPE = number) " update="fadpedid" updatewhere=0 updatekeyinplace=no arguments=(("g_financiero", number),("empresa", number),("pedido", string),("ano", number))  sort="dped_index A " )
