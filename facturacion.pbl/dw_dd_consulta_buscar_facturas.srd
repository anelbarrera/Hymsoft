 column=(type=decimal(4) updatewhereclause=yes name=fact_gastos_total dbname="fatdiari.fact_gastos_total" dbalias=".fact_gastos_total" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_estado~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_gastos_total~")) " sort="fact_no_factura A real(fact_no_pedido) A fact_ann A fact_fecha A " )
