table(column=(type=char(8) updatewhereclause=yes name=fact_no_pedido dbname="fatdiari.fact_no_pedido" dbalias=".fact_no_pedido" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fatdiari.fact_fecha" dbalias=".fact_fecha" initial="today" )
 column=(type=char(3) updatewhereclause=yes name=fact_tipo dbname="fatdiari.fact_tipo" dbalias=".fact_tipo" values="SI	1/NO	0/" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fatdiari.fact_ann" dbalias=".fact_ann" )
