table(column=(type=decimal(6) updatewhereclause=yes name=cantidad_gramos dbname="cantidad_gramos" )
 column=(type=decimal(4) updatewhereclause=yes name=valor_producto dbname="valor_producto" )
 column=(type=char(65) updatewhereclause=yes name=prod_descripcion dbname="prod_descripcion" )
 column=(type=char(20) updatewhereclause=yes name=facd_codigo_item dbname="faddiari.facd_codigo_item" )
 column=(type=decimal(2) updatewhereclause=yes name=valor_recargo dbname="valor_recargo" )
 column=(type=decimal(2) updatewhereclause=yes name=cerradas dbname="cerradas" )
 column=(type=decimal(2) updatewhereclause=yes name=k24 dbname="k24" )
 column=(type=decimal(2) updatewhereclause=yes name=k18 dbname="k18" )
 column=(type=decimal(2) updatewhereclause=yes name=k10 dbname="k10" )
 column=(type=decimal(2) updatewhereclause=yes name=promedio_costo dbname="promedio_costo" )
 column=(type=decimal(2) updatewhereclause=yes name=gastos dbname="gastos" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"inmprodu~" ) COMPUTE(NAME=~"sum( facd_cantidad ) cantidad_gramos~") COMPUTE(NAME=~"sum( facd_monto_final ) valor_producto~") COMPUTE(NAME=~"max( prod_descripcion ) prod_descripcion~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COMPUTE(NAME=~"0.00 valor_recargo~") COMPUTE(NAME=~"0.00 cerradas~") COMPUTE(NAME=~"0.00 k24~") COMPUTE(NAME=~"0.00 k18~") COMPUTE(NAME=~"0.00 k10~") COMPUTE(NAME=~"0.00 promedio_costo~") COMPUTE(NAME=~"0.00 gastos~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"faddiari.facd_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_cierre_de_metal~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_kilates~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_excluir_de_reporte~"   OP =~"=~"    EXP2 =~"0~" )  GROUP(NAME=~"faddiari.facd_codigo_item~")) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("fecha1", datetime),("fecha2", datetime))  sort="orden A      prod_descripcion A " )
