 column=(type=long updatewhereclause=yes name=monto_fin dbname="faddiari.monto_fin" )
 column=(type=long updatewhereclause=yes name=devuelta dbname="faddiari.devuelta" )
 column=(type=long updatewhereclause=yes name=devuelta_mod dbname="faddiari.devuelta_mod" )
 column=(type=long updatewhereclause=yes name=mod_precio dbname="faddiari.mod_precio" )
 retrieve="  SELECT faddiari.facd_g_financiero,   
         faddiari.facd_empresa,   
         faddiari.facd_tipo,   
         faddiari.facd_no_pedido,   
         faddiari.facd_pedido_original,   
         faddiari.facd_producto_servicio,   
         faddiari.facd_descripcion_alterna,   
         faddiari.facd_cubicaje,   
         faddiari.facd_peso,   
         faddiari.facd_unidad_peso,   
         faddiari.facd_unidad_producto,   
         faddiari.facd_precio_mayor,   
         faddiari.facd_precio_menor,   
         faddiari.facd_codigo_item,   
         faddiari.facd_unidad_venta,   
         faddiari.facd_precio_unidad_producto,   
         faddiari.facd_cantidad,   
         faddiari.facd_cantidad_fraccion,   
         faddiari.facd_por_descuento,   
         faddiari.facd_costo_fob,   
         faddiari.facd_costo_cif,   
         faddiari.facd_monto_total,   
         faddiari.facd_monto_final,   
         faddiari.facd_usuario,   
         faddiari.facd_supervisor,   
         faddiari.facd_bultos,   
         faddiari.facd_fecha_reg,   
         faddiari.facd_pais,   
         faddiari.facd_ann,   
         faddiari.facd_linea,   
         faddiari.facd_cant_devuelta,   
         faddiari.facd_linea_articulo_dev,   
         faddiari.facd_bodega,   
         faddiari.facd_ubicacion,   
         space (120) desglose,   
         0     linea,   
         faddiari.facd_cant_asignada,   
         faddiari.facd_index,facd_precio_descuento, facd_descuento_ncr,  
         0     cantidad,           0     fraccion,           0     total,           0     monto,           0     monto_fin,           0     devuelta, 0     devuelta_mod, 0    mod_precio  
    FROM faddiari  
   WHERE (faddiari.facd_g_financiero = :g_financiero ) AND  
         (faddiari.facd_empresa = :empresa ) AND  
         (faddiari.facd_tipo = :tipo ) AND  
         (faddiari.facd_no_pedido = :pedido ) AND  
         (faddiari.facd_ann = :an )    
" update="faddiari" updatewhere=0 updatekeyinplace=yes arguments=(("g_financiero", number),("empresa", number),("tipo", string),("pedido", string),("an", number))  sort="facd_linea A " )
