 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"ccmclien~" )  TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_estado~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~")    JOIN (LEFT=~"ccmclien.clie_g_financiero~"    OP =~"=~"RIGHT=~"fatdiari.fact_g_financiero~" )    JOIN (LEFT=~"ccmclien.clie_empresa~"    OP =~"=~"RIGHT=~"fatdiari.fact_empresa~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"fatdiari.fact_cliente~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )WHERE(    EXP1 =~"(fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":cli_grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":cli_empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":cli_anio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"in~"    EXP2 =~"'A')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_no_pedido~"   OP =~"not like~"    EXP2 =~"'%NC%'~" ) ) ARG(NAME = ~"cli_grupo~" TYPE = number)  ARG(NAME = ~"cli_empresa~" TYPE = number)  ARG(NAME = ~"cli_anio~" TYPE = number) " arguments=(("cli_grupo", number),("cli_empresa", number),("cli_anio", number))  sort="long(no_pedido) A dgmterce_terc_descripcion A " )
