         fatdiari.fact_fecha_creacion,   
         fatdiari.fact_fecha_modificacion,   
         fatdiari.fact_dias_pago,   
         fatdiari.fact_fecha_fin_plazo,   
         fatdiari.fact_fecha_cancelado,   
