global subroutine gf_fa_cambiar_tipo_fac_anio (string ls_ped_sel, integer li_ann_sel, string ls_pedido_repl, ref boolean lb_salvo);// Esta función permite cambiar el tipo de factura de un 
// pedido de factura , el año de la misma o el número del pedido
// Siempre y cuando no haya sido Impresa

String ls_sqlerrtext




  INSERT INTO fatdiari  
         ( fatdiari.fact_g_financiero,   
         fatdiari.fact_empresa,   
         fatdiari.fact_tipo,   
         fatdiari.fact_no_pedido,   
         fatdiari.fact_ann,   
         fatdiari.fact_no_factura,   
         fatdiari.fact_cliente,   
         fatdiari.fact_ruc_cliente,   
         fatdiari.fact_condicion_pago,   
         fatdiari.fact_tipo_venta,   
         fatdiari.fact_tipo_movimiento,   
         fatdiari.fact_no_traspaso,   
