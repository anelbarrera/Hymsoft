 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"intmovim~" ) COLUMN(NAME=~"intmovim.tmov_tipo_transaccion~") COLUMN(NAME=~"intmovim.tmov_secuencia~") COLUMN(NAME=~"intmovim.tmov_descripcion~") COLUMN(NAME=~"intmovim.tmov_anual~") COLUMN(NAME=~"intmovim.tmov_documento~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"intmovim.tmov_nombre_tercero~") COLUMN(NAME=~"intmovim.tmov_comentario~") COLUMN(NAME=~"intmovim.tmov_no_pedido~") COLUMN(NAME=~"intmovim.tmov_g_financiero~") COLUMN(NAME=~"intmovim.tmov_empresa~") COLUMN(NAME=~"intmovim.tmov_aplicacion~") COLUMN(NAME=~"intmovim.tmov_concepto~")WHERE(    EXP1 =~"intmovim.tmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_documento~"   OP =~"=~"    EXP2 =~":factura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_anual~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"factura~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="intmovim" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("factura", string),("ann", number)) )
