table(column=(type=char(20) updatewhereclause=yes name=prod_producto dbname="inmprodu.prod_producto" )
 column=(type=char(65) updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" initial="empty" )
 column=(type=decimal(6) updatewhereclause=yes name=prod_existencia_total dbname="inmprodu.prod_existencia_total" initial="0" )
 column=(type=decimal(6) updatewhereclause=yes name=prod_reserva_total dbname="inmprodu.prod_reserva_total" initial="0" )
 column=(type=char(2) updatewhereclause=yes name=prod_medida dbname="inmprodu.prod_medida" )
 column=(type=long updatewhereclause=yes name=multiplicador dbname="multiplicador" )
 column=(type=char(120) updatewhereclause=yes name=prod_foto_dir dbname="inmprodu.prod_foto_dir" )
 column=(type=decimal(0) updatewhereclause=yes name=tipo_medida dbname="inamedid.medi_tipo_medida" )
 column=(type=decimal(8) updatewhereclause=yes name=medi_cantidad dbname="inamedid.medi_cantidad" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COLUMN(NAME=~"inmprodu.prod_reserva_total~") COLUMN(NAME=~"inmprodu.prod_medida~") COMPUTE(NAME=~"0 multiplicador~") COLUMN(NAME=~"inmprodu.prod_foto_dir~") COLUMN(NAME=~"inamedid.medi_tipo_medida~") COLUMN(NAME=~"inamedid.medi_cantidad~")    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_producto~"   OP =~"=~"    EXP2 =~":producto~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"producto~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("producto", string)) )
column(band=background id=7 alignment="0" tabsequence=32766 border="5" color="8388608" x="2482" y="8" height="256" width="389" format="[general]" html.valueishtml="0"  name=prod_foto_dir visible="1"  resizeable=1  moveable=1 bitmapname=yes edit.limit=0 edit.case=any edit.autoselect=yes  font.face="MS Sans Serif" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" background.transparency="0" background.gradient.color="8421504" background.gradient.transparency="0" background.gradient.angle="0" background.brushmode="0" background.gradient.repetition.mode="0" background.gradient.repetition.count="0" background.gradient.repetition.length="100" background.gradient.focus="0" background.gradient.scale="100" background.gradient.spread="100" tooltip.backcolor="134217752" tooltip.delay.initial="0" tooltip.delay.visible="32000" tooltip.enabled="0" tooltip.hasclosebutton="0" tooltip.icon="0" tooltip.isbubble="0" tooltip.maxwidth="0" tooltip.textcolor="134217751" tooltip.transparency="0" transparency="0" )
