OLUMN(NAME=~"vi_factura1.pais_descripcion~") COLUMN(NAME=~"vi_factura1.fact_g_financiero~") COLUMN(NAME=~"vi_factura1.fara_logo_f~") COLUMN(NAME=~"vi_factura1.fara_logo~") COLUMN(NAME=~"vi_factura1.peri_descripcion~") COLUMN(NAME=~"vi_factura1.fara_jurada~") COLUMN(NAME=~"vi_factura1.fara_jurada_dos~") COLUMN(NAME=~"vi_factura1.amar_nombre_marca~") COLUMN(NAME=~"vi_factura1.peri_aplicacion~") COLUMN(NAME=~"vi_factura1.aesp_descripcion_espec~") COMPUTE(NAME=~"'                                            ' car_descripcion~") COMPUTE(NAME=~"'               ' bultos~") COMPUTE(NAME=~"0 linea_subt~") COLUMN(NAME=~"vi_factura1.terc_identificacion~") COLUMN(NAME=~"vi_factura1.fact_factura_de_bodega~") COLUMN(NAME=~"vi_factura1.facd_index~") COLUMN(NAME=~"vi_factura1.acta_descripcion~") COMPUTE(NAME=~"0 grupo, vi_factura1.facd_monto_final tot_por_registro~") COLUMN(NAME=~"vi_factura1.medi_abre~") COLUMN(NAME=~"vi_factura1.facd_bulto_inicio~") COLUMN(NAME=~"vi_factura1.facd_bulto_fin~") COLUMN(NAME=~"vi_factura1.prod_producto_dos~") COLUMN(NAME=~"vi_factura1.prod_gramaje~")WHERE(    EXP1 =~"((vi_factura1.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_finan )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_ann~"   OP =~"=~"    EXP2 =~":an )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'))~" ) ) ARG(NAME = ~"grupo_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo_finan", number),("empresa", number),("pedido", string),("an", number))  sort="facd_index A " )
