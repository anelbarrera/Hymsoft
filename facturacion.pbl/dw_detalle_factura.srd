 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"faddiari.facd_g_financiero~") COLUMN(NAME=~"faddiari.facd_empresa~") COLUMN(NAME=~"faddiari.facd_tipo~") COLUMN(NAME=~"faddiari.facd_no_pedido~") COLUMN(NAME=~"faddiari.facd_linea~") COLUMN(NAME=~"faddiari.facd_ann~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_descripcion_alterna~") COLUMN(NAME=~"faddiari.facd_cubicaje~") COLUMN(NAME=~"faddiari.facd_peso~") COLUMN(NAME=~"faddiari.facd_unidad_producto~") COLUMN(NAME=~"faddiari.facd_precio_unidad_producto~") COLUMN(NAME=~"faddiari.facd_unidad_venta~") COLUMN(NAME=~"faddiari.facd_cantidad~") COLUMN(NAME=~"faddiari.facd_cantidad_fraccion~") COLUMN(NAME=~"faddiari.facd_monto_total~") COLUMN(NAME=~"faddiari.facd_monto_final~") COLUMN(NAME=~"faddiari.facd_usuario~") COLUMN(NAME=~"faddiari.facd_bultos~") COLUMN(NAME=~"faddiari.facd_index~") COLUMN(NAME=~"faddiari.facd_bulto_inicio~") COLUMN(NAME=~"faddiari.facd_bulto_fin~") COLUMN(NAME=~"faddiari.facd_costo_fob~") COLUMN(NAME=~"faddiari.facd_costo_cif~") COLUMN(NAME=~"faddiari.facd_costo_total~") COLUMN(NAME=~"faddiari.facd_precio_original~") COLUMN(NAME=~"faddiari.facd_precio_recargo~") COLUMN(NAME=~"inamedid.medi_tipo_medida~") COLUMN(NAME=~"faddiari.facd_bodega~") COLUMN(NAME=~"faddiari.facd_ubicacion~") COLUMN(NAME=~"faddiari.facd_metal_pendiente~") COLUMN(NAME=~"faddiari.facd_rebajar~") COLUMN(NAME=~"faddiari.facd_modelo~") COLUMN(NAME=~"faddiari.facd_bultos_original~") COLUMN(NAME=~"faddiari.facd_comentario~") COLUMN(NAME=~"faddiari.facd_peso_neto~") COLUMN(NAME=~"faddiari.facd_cubicaje_metros~") COMPUTE(NAME=~"0 copiar~")    JOIN (LEFT=~"faddiari.facd_unidad_venta~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"faddiari.facd_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_no_pedido~"   OP =~"=~"    EXP2 =~":pedido~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="faddiari" updatewhere=0 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("pedido", string),("ann", number))  sort="facd_linea A " )
