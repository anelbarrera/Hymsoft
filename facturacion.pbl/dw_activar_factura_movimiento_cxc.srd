 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cctmovim~" ) COLUMN(NAME=~"cctmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cctmovim.movi_documento~") COLUMN(NAME=~"cctmovim.movi_anno~") COLUMN(NAME=~"cctmovim.movi_referencia~") COLUMN(NAME=~"cctmovim.movi_tercero~") COLUMN(NAME=~"cctmovim.movi_ruc_tercero~") COLUMN(NAME=~"cctmovim.movi_a_nombre~") COLUMN(NAME=~"cctmovim.movi_fecha_tran~") COLUMN(NAME=~"cctmovim.movi_monto~") COLUMN(NAME=~"cctmovim.movi_comentario~") COLUMN(NAME=~"cctmovim.movi_g_financiero~") COLUMN(NAME=~"cctmovim.movi_empresa~") COLUMN(NAME=~"cctmovim.movi_aplicacion~") COLUMN(NAME=~"cctmovim.movi_sub_transaccion~")WHERE(    EXP1 =~"cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_documento~"   OP =~"=~"    EXP2 =~":factura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_anno~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"factura~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="cctmovim" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("factura", string),("ann", number)) )
