detail(height=208 color="-1" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.count="0" gradient.repetition.length="100" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=decimal(2) updatewhereclause=yes name=costo_tott dbname="compute_ct" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fatdiari.fact_a_nombre" dbalias=".fact_a_nombre" )
 column=(type=char(100) updatewhereclause=yes name=dgapais_pais_descripcion dbname="dgapais.pais_descripcion" dbalias=".pais_descripcion" )
 column=(type=decimal(0) updatewhereclause=yes name=terc_tercero dbname="terc_tercero" initial="0" )
 column=(type=char(20) updatewhereclause=yes name=terc_identificacion dbname="terc_identificacion" initial="spaces" )
 column=(type=char(60) updatewhereclause=yes name=terc_descripcion dbname="terc_descripcion" initial="spaces" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_gastos_total dbname="fact_gastos_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_fact_total dbname="fact_monto_fact_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_final dbname="fact_monto_final" )
 column=(type=decimal(4) updatewhereclause=yes name=costo_tot dbname="fact_costos_total" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"dgapais~" ) COMPUTE(NAME=~"0.00 compute_ct~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"dgapais.pais_descripcion~") COMPUTE(NAME=~"max(terc_tercero) as terc_tercero~") COMPUTE(NAME=~"max(terc_identificacion) as terc_identificacion~") COMPUTE(NAME=~"max(terc_descripcion) as terc_descripcion~") COMPUTE(NAME=~"sum(case when fact_nota_credito = 1 then -1 else 1 end * fact_gastos_total) as fact_gastos_total~") COMPUTE(NAME=~"sum(case when fact_nota_credito = 1 then -1 else 1 end * fact_monto_fact_total) as fact_monto_fact_total~") COMPUTE(NAME=~"sum(case when fact_nota_credito = 1 then -1 else 1 end * fact_monto_final) as fact_monto_final~") COMPUTE(NAME=~"sum(case when fact_nota_credito = 1 then -1 else 1 end * fact_costos_total) as fact_costos_total~")    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )WHERE(    EXP1 =~"fatdiari.fact_cierre_de_metal~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~" )  GROUP(NAME=~"dgapais.pais_descripcion~") GROUP(NAME=~"fatdiari.fact_a_nombre~")) ORDER(NAME=~"dgapais.pais_descripcion~" ASC=yes )  ORDER(NAME=~"fatdiari.fact_a_nombre~" ASC=yes ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("fecha1", datetime),("fecha2", datetime))  sort="dgapais_pais_descripcion A fact_a_nombre A " )
