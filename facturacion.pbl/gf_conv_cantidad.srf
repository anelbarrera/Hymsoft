//objectcomments Función que convierte el ENTERO y FRACCIÓN a DECIMAL utilizando como base el enlace de la medida (CR, FA)
global type gf_conv_cantidad from function_object
end type

forward prototypes
global function decimal gf_conv_cantidad (ref integer ai_entero, ref decimal ad_fraccion, readonly character ac_tipo, readonly string as_medida)
end prototypes

global function decimal gf_conv_cantidad (ref integer ai_entero, ref decimal ad_fraccion, readonly character ac_tipo, readonly string as_medida);/******************************************************************************************
 *																														*
 * Function: gf_conv_cantidad																					*
 *																														*
 * Purpose: 	Rutina que convierte de DECIMAL a ENTERO, FRACCIÓN; y de ENTERO, FRACCIÓN	*
 *			a DECIMAL utilizando la tabla de Medida (inamedid) como base.  						*
 * 		Dependiendo del tipo	(ac_tipo).																	*
 *																														*
 *	Scope: global																									*
 *																														*
 *	Arguments: ad_entero 	{Parte Entera}																	*
 *				  ad_fraccion 	{Fracción}																		*
 *				  ac_tipo		{Tipo de Conversión A decimal -> entero, fracción					*
 *															  C entero, fracción -> decimal}					*
 *				  as_medida		{Unidad de Medida}															*
 *																														*
 *	Returns: decimal {sólo para ac_tipo = 'C', es el número resultante}							*
 *																														*
 * Created:	5 / Abril / 1999																					*
 * Last Modified: 6 / Abril / 1999																			*
 ******************************************************************************************/

Decimal		ld_cantidad, ldc_entero
Integer		li_entero


SELECT inamedid.medi_cantidad  
  INTO :ld_cantidad  
  FROM inamedid  
 WHERE inamedid.medi_medida = :as_medida;

CHOOSE CASE upper (ac_tipo)
	CASE 'A'
		ldc_entero	= ad_fraccion
		If ldc_entero = 0.0 Then Return 0
		li_entero	= truncate (ldc_entero, 0)		
		ad_fraccion = mod (ldc_entero, li_entero)
		ad_fraccion *= round (ld_cantidad, 0) 
		ai_entero   = integer (li_entero)
		Return 0		

	CASE 'C'
		//messagebox (string(ad_entero),string(ad_fraccion) + " / " + string (ld_cantidad ))
		ad_fraccion /= ld_cantidad
		//messagebox ("cantidad",string(ad_fraccion))
		ld_cantidad = ai_entero + ad_fraccion
		Return (ld_cantidad)
END CHOOSE
		
end function

