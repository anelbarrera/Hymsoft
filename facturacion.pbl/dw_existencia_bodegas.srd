 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"dgmempre~" ) COMPUTE(NAME=~"convert(numeric(10,2),prod_existencia1 / medi_cantidad) cantidad1~") COLUMN(NAME=~"dgmempre.empr_bodegas_definidas~") COLUMN(NAME=~"dgmempre.empr_bodega1~") COLUMN(NAME=~"dgmempre.empr_bodega2~") COLUMN(NAME=~"dgmempre.empr_bodega3~") COLUMN(NAME=~"dgmempre.empr_bodega4~") COLUMN(NAME=~"dgmempre.empr_bodega5~") COLUMN(NAME=~"dgmempre.empr_bodega6~") COLUMN(NAME=~"dgmempre.empr_bodega7~") COMPUTE(NAME=~"convert(numeric(10,2),prod_existencia2 / medi_cantidad) cantidad2~") COMPUTE(NAME=~"convert(numeric(10,2),prod_existencia3 / medi_cantidad) cantidad3~") COMPUTE(NAME=~"convert(numeric(10,2),prod_existencia4 / medi_cantidad) cantidad4~") COMPUTE(NAME=~"convert(numeric(10,2),prod_existencia5 / medi_cantidad) cantidad5~") COMPUTE(NAME=~"convert(numeric(10,2),prod_existencia6 / medi_cantidad) cantidad6~") COMPUTE(NAME=~"convert(numeric(10,2),prod_existencia7 / medi_cantidad) cantidad7~") COMPUTE(NAME=~"convert(numeric(10,2),prod_reserva1 / medi_cantidad) reserva1~") COMPUTE(NAME=~"convert(numeric(10,2),prod_reserva2 / medi_cantidad) reserva2~") COMPUTE(NAME=~"convert(numeric(10,2),prod_reserva3 / medi_cantidad) reserva3~") COMPUTE(NAME=~"convert(numeric(10,2),prod_reserva4 / medi_cantidad) reserva4~") COMPUTE(NAME=~"convert(numeric(10,2),prod_reserva5 / medi_cantidad) reserva5~") COMPUTE(NAME=~"convert(numeric(10,2),prod_reserva6 / medi_cantidad) reserva6~") COMPUTE(NAME=~"convert(numeric(10,2),prod_reserva7 / medi_cantidad) reserva7~") COMPUTE(NAME=~"convert(numeric(10,2),(prod_existencia1 - prod_reserva1) / medi_cantidad) disponible1~") COMPUTE(NAME=~"convert(numeric(10,2),(prod_existencia2 - prod_reserva2) / medi_cantidad) disponible2~") COMPUTE(NAME=~"convert(numeric(10,2),(prod_existencia3 - prod_reserva3) / medi_cantidad) disponible3~") COMPUTE(NAME=~"convert(numeric(10,2),(prod_existencia4 - prod_reserva4) / medi_cantidad) disponible4~") COMPUTE(NAME=~"convert(numeric(10,2),(prod_existencia5 - prod_reserva5) / medi_cantidad) disponible5~") COMPUTE(NAME=~"convert(numeric(10,2),(prod_existencia6 - prod_reserva6) / medi_cantidad) disponible6~") COMPUTE(NAME=~"convert(numeric(10,2),(prod_existencia7 - prod_reserva7) / medi_cantidad) disponible7~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COLUMN(NAME=~"inmprodu.prod_producto~")    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )    JOIN (LEFT=~"dgmempre.empr_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"dgmempre.empr_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"inmprodu.prod_producto~"   OP =~"=~"    EXP2 =~":prod~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"prod~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("prod", string)) )
