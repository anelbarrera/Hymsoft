table(column=(type=char(255) updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" dbalias=".prod_descripcion" )
 column=(type=decimal(2) updatewhereclause=yes name=existencia dbname="existencia" )
 column=(type=decimal(2) updatewhereclause=yes name=reserva dbname="reserva" )
 column=(type=decimal(2) updatewhereclause=yes name=disponible dbname="disponible" )
 column=(type=char(20) updatewhereclause=yes name=prod_producto_dos dbname="inmprodu.prod_producto_dos" dbalias=".prod_producto_dos" )
 column=(type=char(15) updatewhereclause=yes name=costo_letras dbname="costo_letras" )
 column=(type=long updatewhereclause=yes name=mostrar_ultimo dbname="mostrar_ultimo" )
 column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_producto dbname="inmprodu.prod_producto" dbalias=".prod_producto" )
 column=(type=decimal(8) updatewhereclause=yes name=prod_costo_promedio dbname="inmprodu.prod_costo_promedio" dbalias=".prod_costo_promedio" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"inmprodu.prod_descripcion~") COMPUTE(NAME=~"convert(numeric(10,2),prod_existencia_total / medi_cantidad) existencia~") COMPUTE(NAME=~"convert(numeric(10,2),prod_reserva_total / medi_cantidad) reserva~") COMPUTE(NAME=~"convert(numeric(10,2),(prod_existencia_total - prod_reserva_total) / medi_cantidad) disponible~") COLUMN(NAME=~"inmprodu.prod_producto_dos~") COMPUTE(NAME=~"costo_letras = '               '~") COMPUTE(NAME=~"mostrar_ultimo = 1~") COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_costo_promedio~")    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_producto~"   OP =~"like~"    EXP2 =~":producto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_existencia_total - inmprodu.prod_reserva_total~"   OP =~">=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"producto~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("producto", string))  sort="disponible D inmprodu_prod_producto A prod_descripcion A " )
