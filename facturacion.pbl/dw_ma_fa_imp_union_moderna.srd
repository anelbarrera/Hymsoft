           vi_factura1.facd_precio_unidad_producto ,
           vi_factura1.facd_unidad_venta ,
           vi_factura1.facd_cantidad ,
           vi_factura1.facd_cantidad_fraccion ,
           vi_factura1.facd_monto_total ,
           vi_factura1.facd_por_descuento ,
           vi_factura1.facd_monto_final ,
           vi_factura1.facd_fecha_reg ,
           vi_factura1.facd_usuario ,
           vi_factura1.facd_supervisor ,
           vi_factura1.facd_bultos ,
           vi_factura1.facd_pais ,
           vi_factura1.facd_ubicacion ,
           vi_factura1.facd_cant_devuelta ,
           vi_factura1.facd_linea_articulo_dev ,
           vi_factura1.pais_descripcion ,
           vi_factura1.fact_g_financiero ,
           vi_factura1.fara_logo_f ,
           vi_factura1.fara_logo ,
           vi_factura1.peri_descripcion ,
           vi_factura1.fara_jurada ,
           vi_factura1.fara_jurada_dos ,
           vi_factura1.amar_nombre_marca ,
           vi_factura1.peri_aplicacion ,
           vi_factura1.aesp_descripcion_espec ,
           '                                            ' car_descripcion,
           '               ' bultos,
           0 linea_subt,
           vi_factura1.terc_identificacion ,
           vi_factura1.fact_factura_de_bodega ,
           vi_factura1.facd_index ,
           vi_factura1.acta_descripcion ,
           0 grupo,
 vi_factura1.facd_monto_final tot_por_registro,
           vi_factura1.medi_abre ,
           vi_factura1.facd_bulto_inicio ,
           vi_factura1.facd_bulto_fin ,
           vi_factura1.prod_barra ,
           case when len(vi_factura1.prod_foto_editada) > 0 then vi_factura1.prod_foto_editada else vi_factura1.prod_foto_dir end prod_foto_dir,
           vi_factura1.prod_empaque ,
           vi_factura1.prod_empaque_um ,
           vi_factura1.prod_cubicaje ,
           vi_factura1.prod_peso ,
           vi_factura1.prod_arancel ,
           vi_factura1.aran_descripcion ,
           vi_factura1.acol_nombre_color,
			  vi_factura1.pais_origenes     
        FROM vi_factura1      
        WHERE ((vi_factura1.fact_g_financiero = :grupo_finan ) and          (vi_factura1.fact_empresa = :empresa ) and          (vi_factura1.fact_no_pedido = :pedido ) and          (vi_factura1.fact_ann = :an ) and        (vi_factura1.peri_aplicacion = 'FA'))   " arguments=(("grupo_finan", number),("empresa", number),("pedido", string),("an", number))  sort="facd_index A " )
