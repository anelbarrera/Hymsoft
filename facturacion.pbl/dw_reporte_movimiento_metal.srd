table(column=(type=char(10) updatewhereclause=yes name=fact_no_factura dbname="fatdiari.fact_no_factura" dbalias=".fact_no_factura" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_cliente dbname="fatdiari.fact_cliente" dbalias=".fact_cliente" )
 column=(type=decimal(6) updatewhereclause=yes name=envio dbname="envio" )
 column=(type=decimal(6) updatewhereclause=yes name=cierre dbname="cierre" )
 column=(type=char(20) updatewhereclause=yes name=cuenta dbname="cuenta" )
 column=(type=char(100) updatewhereclause=yes name=cliente dbname="cliente" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fatdiari.fact_ann" dbalias=".fact_ann" )
 column=(type=decimal(3) updatewhereclause=yes name=onza dbname="onza" )
 column=(type=decimal(0) updatewhereclause=yes name=fix dbname="fix" values=" 	0/I Fix	1/II Fix	2/" )
 column=(type=decimal(0) updatewhereclause=yes name=factura_cierre dbname="factura_cierre" )
 column=(type=datetime updatewhereclause=yes name=fatdiari_fact_fecha dbname="fact_fecha" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_cliente~") COMPUTE(NAME=~"sum(facd_cantidad) envio~") COMPUTE(NAME=~"sum(facd_cantidad_cerrada) cierre~") COMPUTE(NAME=~"max(fact_ruc_cliente) cuenta~") COMPUTE(NAME=~"max(fact_a_nombre) cliente~") COLUMN(NAME=~"fatdiari.fact_ann~") COMPUTE(NAME=~"max(fact_precio_onza) onza~") COMPUTE(NAME=~"max(fact_fix) fix~") COMPUTE(NAME=~"max(fact_factura_cierre) factura_cierre~") COMPUTE(NAME=~"max(fact_fecha) fact_fecha~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_metal_pendiente~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_cliente~"   OP =~"=~"    EXP2 =~":cliente~" )  GROUP(NAME=~"fatdiari.fact_g_financiero~") GROUP(NAME=~"fatdiari.fact_empresa~") GROUP(NAME=~"fatdiari.fact_no_factura~") GROUP(NAME=~"fatdiari.fact_ann~") GROUP(NAME=~"fatdiari.fact_cliente~")) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"cliente~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("cliente", number),("fecha1", datetime),("fecha2", datetime)) )
