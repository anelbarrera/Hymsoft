 column=(type=char(20) updatewhereclause=yes name=ccmclien_clie_ruc_tercero dbname="ccmclien.clie_ruc_tercero" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"ccmclien~" )  TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_descripcion_alterna~") COLUMN(NAME=~"faddiari.facd_precio_unidad_producto~") COLUMN(NAME=~"faddiari.facd_unidad_venta~") COLUMN(NAME=~"faddiari.facd_cantidad~") COLUMN(NAME=~"faddiari.facd_cantidad_fraccion~") COLUMN(NAME=~"faddiari.facd_monto_final~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"ccmclien.clie_ruc_tercero~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"ccmclien.clie_g_financiero~"    OP =~"=~"RIGHT=~"fatdiari.fact_g_financiero~" )    JOIN (LEFT=~"ccmclien.clie_empresa~"    OP =~"=~"RIGHT=~"fatdiari.fact_empresa~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"fatdiari.fact_cliente~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )WHERE(    EXP1 =~"( ( fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":ann )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_no_pedido + fatdiari.fact_tipo~"   OP =~"in~"    EXP2 =~":pedido_tipo))~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"pedido_tipo~" TYPE = stringlist) " arguments=(("grupo", number),("empresa", number),("ann", number),("pedido_tipo", stringlist)) )
