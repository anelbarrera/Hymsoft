table(column=(type=long updatewhereclause=yes name=pasar dbname="pasar" initial="0" values="	1/	0" )
 column=(type=decimal(0) updatewhereclause=yes name=tmov_g_financiero dbname="intmovim.tmov_g_financiero" dbalias=".tmov_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=tmov_empresa dbname="intmovim.tmov_empresa" dbalias=".tmov_empresa" )
 column=(type=decimal(0) updatewhereclause=yes name=tmov_secuencia dbname="intmovim.tmov_secuencia" dbalias=".tmov_secuencia" )
 column=(type=decimal(0) updatewhereclause=yes name=tmov_anual dbname="intmovim.tmov_anual" dbalias=".tmov_anual" )
 column=(type=char(60) updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
 column=(type=datetime updatewhereclause=yes name=tmov_fecha dbname="intmovim.tmov_fecha" dbalias=".tmov_fecha" )
 column=(type=char(18) updatewhereclause=yes name=tmov_documento dbname="intmovim.tmov_documento" dbalias=".tmov_documento" )
 column=(type=decimal(14) updatewhereclause=yes name=monto dbname="monto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"intmovim~" )  TABLE(NAME=~"dgmterce~" ) COMPUTE(NAME=~"pasar = 0~") COLUMN(NAME=~"intmovim.tmov_g_financiero~") COLUMN(NAME=~"intmovim.tmov_empresa~") COLUMN(NAME=~"intmovim.tmov_secuencia~") COLUMN(NAME=~"intmovim.tmov_anual~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"intmovim.tmov_documento~") COMPUTE(NAME=~"monto = (  SELECT sum(d.dmov_cantidad * d.dmov_costo_fob)  FROM indmovim d  WHERE ( intmovim.tmov_g_financiero = d.dmov_g_financiero ) and  ( intmovim.tmov_empresa = d.dmov_empresa ) and  ( intmovim.tmov_aplicacion = d.dmov_aplicacion ) and  ( intmovim.tmov_tipo_transaccion = d.dmov_tipo_transaccion ) and  ( intmovim.tmov_secuencia = d.dmov_secuencia ) and  ( intmovim.tmov_concepto = d.dmov_concepto ) and  ( intmovim.tmov_anual = d.dmov_anual )  )~")    JOIN (LEFT=~"intmovim.tmov_terceros~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"intmovim.tmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"intmovim.tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"intmovim.tmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_anual~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"intmovim.tmov_estado_entrada~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("ann", number))  sort="tmov_fecha D " )
