 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_a~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_b~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_c~" )  TABLE(NAME=~"cragrupo~" ) COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_producto_dos~") COLUMN(NAME=~"inmprodu.prod_descripcion_dos~") COLUMN(NAME=~"inmprodu.prod_medida~") COLUMN(NAME=~"inmprodu.prod_peso~") COLUMN(NAME=~"inmprodu.prod_cubicaje~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_descripcion~") COLUMN(NAME=~"inmprodu.prod_peso_descripcion~") COLUMN(NAME=~"inmprodu.prod_fecha_creacion~") COLUMN(NAME=~"inmprodu.prod_owner~") COLUMN(NAME=~"inmprodu.prod_barra~") COLUMN(NAME=~"inmprodu.prod_arancel~") COLUMN(NAME=~"inmprodu.prod_codigo_modelo~") COLUMN(NAME=~"inmprodu.prod_cod_alternativo~") COLUMN(NAME=~"inmprodu.prod_ultima_actualizacion~") COLUMN(NAME=~"inmprodu.prod_foto_dir~") COLUMN(NAME=~"inamedid_a.medi_descripcion~") COLUMN(NAME=~"inmprodu.prod_ultima_salida_doc~") COLUMN(NAME=~"inmprodu.prod_salida_fecha~") COLUMN(NAME=~"inmprodu.prod_entrada_fecha~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_doc~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_can~") COLUMN(NAME=~"inmprodu.prod_cant_transito~") COLUMN(NAME=~"inmprodu.prod_reserva_total~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COLUMN(NAME=~"inamedid_b.medi_cantidad~") COLUMN(NAME=~"inmprodu.prod_precio1~") COLUMN(NAME=~"inmprodu.prod_precio2~") COLUMN(NAME=~"inmprodu.prod_precio3~") COLUMN(NAME=~"inmprodu.prod_precio4~") COLUMN(NAME=~"inmprodu.prod_precio5~") COLUMN(NAME=~"inamedid_b.medi_descripcion~") COLUMN(NAME=~"inamedid_a.medi_abre~") COLUMN(NAME=~"inmprodu.prod_reserva_trans~") COLUMN(NAME=~"inamedid_c.medi_abre~") COMPUTE(NAME=~"convert(numeric(15,0),(inmprodu.prod_reserva_total/inamedid_b.medi_cantidad)) rentero~") COMPUTE(NAME=~"convert(numeric(15,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) /inamedid_b.medi_cantidad)) dentero~") COMPUTE(NAME=~"convert(numeric(15,0),(inmprodu.prod_cant_transito /inamedid_b.medi_cantidad)) tran_entero~") COMPUTE(NAME=~"convert(numeric(15,0),(inmprodu.prod_reserva_trans/inamedid_b.medi_cantidad)) tran_rentero~") COMPUTE(NAME=~"convert(numeric(15,0),((inmprodu.prod_cant_transito - inmprodu.prod_reserva_trans) /inamedid_b.medi_cantidad)) tran_dentero~") COMPUTE(NAME=~"convert(numeric(15,0),(inmprodu.prod_existencia_total/inamedid_b.medi_cantidad)) entero~") COMPUTE(NAME=~"convert(numeric(4,0), inmprodu.prod_reserva_total - (convert(numeric(15,0),(inmprodu.prod_reserva_total/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) ) rfraccion~") COMPUTE(NAME=~"convert(numeric(4,0), (inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) - (convert(numeric(15,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) /inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) ) dfraccion~") COMPUTE(NAME=~"convert(numeric(4,0), inmprodu.prod_cant_transito - (convert(numeric(15,0),(inmprodu.prod_cant_transito/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) ) tran_fraccion~") COMPUTE(NAME=~"convert(numeric(4,0), inmprodu.prod_reserva_trans - (convert(numeric(15,0),(inmprodu.prod_reserva_trans/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) ) tran_rfraccion~") COMPUTE(NAME=~"convert(numeric(4,0), (inmprodu.prod_cant_transito - inmprodu.prod_reserva_trans) - (convert(numeric(15,0),((inmprodu.prod_cant_transito - inmprodu.prod_reserva_trans) /inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) ) tran_dfraccion~") COLUMN(NAME=~"cragrupo.agru_descripcion_grupo~") COLUMN(NAME=~"inmprodu.prod_observacion~") COMPUTE(NAME=~"convert(numeric(4,0),inmprodu.prod_existencia_total - (convert(numeric(15,0),(inmprodu.prod_existencia_total/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad)) fraccion~") COLUMN(NAME=~"inmprodu.prod_costo_cif~") COLUMN(NAME=~"inmprodu.prod_contrato_regalias~") COMPUTE(NAME=~"convert(numeric(15,0),(inmprodu.prod_cant_confirma /inamedid_b.medi_cantidad)) oc_entero~") COMPUTE(NAME=~"convert(numeric(15,0),(inmprodu.prod_cant_transito /inamedid_b.medi_cantidad)) transito_entero~")    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid_b.medi_medida~"    OUTER1 =~"inmprodu.prod_medida~" )    JOIN (LEFT=~"inmprodu.prod_empaque_um~"    OP =~"=~"RIGHT=~"inamedid_c.medi_medida~"    OUTER1 =~"inmprodu.prod_empaque_um~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cragrupo.agru_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cragrupo.agru_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_division~"    OP =~"=~"RIGHT=~"cragrupo.agru_codigo_div~"    OUTER1 =~"inmprodu.prod_division~" )    JOIN (LEFT=~"inmprodu.prod_grupo~"    OP =~"=~"RIGHT=~"cragrupo.agru_codigo_grupo~"    OUTER1 =~"inmprodu.prod_grupo~" )WHERE(    EXP1 =~"( inamedid_a.medi_medida~"   OP =~"=~"    EXP2 =~"inmprodu.prod_peso_unidad_medida)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ( inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( inmprodu.prod_producto~"   OP =~"=~"    EXP2 =~":producto ) )~" ) ) ORDER(NAME=~"inmprodu.prod_producto~" ASC=yes ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"producto~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("producto", string)) )
