 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccmclien~" )  TABLE(NAME=~"dgmsubse~" )  TABLE(NAME=~"dgmserie~" )  TABLE(NAME=~"ccmparam~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"cctmovim~" ) COLUMN(NAME=~"ccmclien.clie_mg_cuenta~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmempre.empr_razon_comercial~") COLUMN(NAME=~"dgmempre.empr_direccion~") COLUMN(NAME=~"dgmempre.empr_apartado_postal~") COLUMN(NAME=~"dgmempre.empr_telefono1~") COLUMN(NAME=~"dgmempre.empr_telefono2~") COLUMN(NAME=~"dgmempre.empr_fax1~") COLUMN(NAME=~"dgmempre.empr_fax2~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_ficha~") COLUMN(NAME=~"dgmempre.empr_rollo~") COLUMN(NAME=~"dgmempre.empr_imagen~") COLUMN(NAME=~"dgmempre.empr_dijito_verificador~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"dgmserie.mser_descripcion~") COLUMN(NAME=~"ccmparam.para_empre_logo~") COLUMN(NAME=~"dgapais.pais_descripcion~") COMPUTE(NAME=~"cctmovim.movi_documento cctcarpa_carp_documento~") COMPUTE(NAME=~"cctmovim.movi_tipo_transaccion carp_tipo_transaccion~") COMPUTE(NAME=~"cctmovim.movi_sub_transaccion carp_sub_transaccion~") COMPUTE(NAME=~"cctmovim.movi_referencia carp_referencia~") COMPUTE(NAME=~"cctmovim.movi_monto carp_monto~") COMPUTE(NAME=~"cctmovim.movi_fecha_tran carp_fecha_tran~") COMPUTE(NAME=~"cctmovim.movi_comentario carp_comentario~") COMPUTE(NAME=~"dgmsubse.subs_descripcion subtran~") COMPUTE(NAME=~"dgmserie.mser_descripcion transac~")    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"ccmclien.clie_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"ccmclien.clie_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"dgmserie.mser_g_financiero~"    OP =~"=~"RIGHT=~"dgmsubse.subs_g_financiero~" )    JOIN (LEFT=~"dgmserie.mser_empresa~"    OP =~"=~"RIGHT=~"dgmsubse.subs_empresa~" )    JOIN (LEFT=~"dgmserie.mser_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmsubse.subs_transaccion~" )    JOIN (LEFT=~"ccmparam.para_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"ccmparam.para_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"cctmovim.movi_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"cctmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"cctmovim.movi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"cctmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"dgmsubse.subs_g_financiero~" )    JOIN (LEFT=~"cctmovim.movi_empresa~"    OP =~"=~"RIGHT=~"dgmsubse.subs_empresa~" )    JOIN (LEFT=~"cctmovim.movi_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmsubse.subs_transaccion~" )    JOIN (LEFT=~"cctmovim.movi_sub_transaccion~"    OP =~"=~"RIGHT=~"dgmsubse.subs_sub_trans~" )WHERE(    EXP1 =~"cctmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":g~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":e~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_referencia~"   OP =~"=~"    EXP2 =~":doc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_anno~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'~" ) ) ARG(NAME = ~"g~" TYPE = number)  ARG(NAME = ~"e~" TYPE = number)  ARG(NAME = ~"doc~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("g", number),("e", number),("doc", string),("ann", number)) )
