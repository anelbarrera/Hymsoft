table(column=(type=char(20) updatewhereclause=yes name=facd_codigo_item dbname="faddiari.facd_codigo_item" )
 column=(type=char(255) updatewhereclause=yes name=facd_descripcion_alterna dbname="faddiari.facd_descripcion_alterna" )
 column=(type=decimal(6) updatewhereclause=yes name=facd_cantidad dbname="faddiari.facd_cantidad" initial="0" )
 column=(type=decimal(0) updatewhereclause=yes name=facd_cantidad_fraccion dbname="faddiari.facd_cantidad_fraccion" initial="0" )
 column=(type=decimal(8) updatewhereclause=yes name=facd_precio_unidad_producto dbname="faddiari.facd_precio_unidad_producto" initial="0" )
 column=(type=char(3) updatewhereclause=yes name=facd_unidad_venta dbname="faddiari.facd_unidad_venta" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_pedido dbname="fatdiari.fact_no_pedido" )
 column=(type=char(10) updatewhereclause=yes name=fact_no_factura dbname="fatdiari.fact_no_factura" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fatdiari.fact_ann" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_cliente dbname="fatdiari.fact_cliente" )
 column=(type=char(20) updatewhereclause=yes name=fact_ruc_cliente dbname="fatdiari.fact_ruc_cliente" )
 column=(type=char(2) updatewhereclause=yes name=fact_condicion_pago dbname="fatdiari.fact_condicion_pago" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_tipo_venta dbname="fatdiari.fact_tipo_venta" values="CONTADO	CO/CRÉDITO	CR/C.O.D	CD/" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fatdiari.fact_fecha" initial="today" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_g_financiero dbname="fatdiari.fact_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_empresa dbname="fatdiari.fact_empresa" )
 column=(type=char(3) updatewhereclause=yes name=facd_unidad_producto dbname="faddiari.facd_unidad_producto" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_gastos_total dbname="fatdiari.fact_gastos_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_fact_total dbname="fatdiari.fact_monto_fact_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_final dbname="fatdiari.fact_monto_final" )
 column=(type=decimal(0) updatewhereclause=yes name=facd_linea dbname="faddiari.facd_linea" )
 column=(type=long updatewhereclause=yes name=facd_index dbname="faddiari.facd_index" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fatdiari.fact_a_nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=costo_tot dbname="faddiari.facd_costo_total" )
 column=(type=char(3) updatewhereclause=yes name=fatdiari_fact_tipo dbname="fatdiari.fact_tipo" )
 column=(type=char(1) updatewhereclause=yes name=fatdiari_fact_tipo_movimiento dbname="fatdiari.fact_tipo_movimiento" )
 column=(type=char(20) updatewhereclause=yes name=facd_modelo dbname="faddiari.facd_modelo" )
 column=(type=char(65) updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" )
 column=(type=decimal(2) updatewhereclause=yes name=existencia dbname="existencia" )
 column=(type=decimal(2) updatewhereclause=yes name=reserva dbname="reserva" )
 column=(type=decimal(2) updatewhereclause=yes name=disponible dbname="disponible" )
 column=(type=char(20) updatewhereclause=yes name=prod_producto_dos dbname="inmprodu.prod_producto_dos" )
 column=(type=decimal(8) updatewhereclause=yes name=facd_costo_cif dbname="faddiari.facd_costo_cif" )
 column=(type=char(15) updatewhereclause=yes name=costo_letras dbname="costo_letras" )
 column=(type=decimal(4) updatewhereclause=yes name=ganancia dbname="ganancia" )
 column=(type=decimal(4) updatewhereclause=yes name=faddiari_facd_monto_final dbname="faddiari.facd_monto_final" )
 column=(type=decimal(4) updatewhereclause=yes name=por_anterior dbname="por_anterior" )
 column=(type=decimal(4) updatewhereclause=yes name=porc_costo dbname="porc_costo" )
 column=(type=decimal(4) updatewhereclause=yes name=porc_venta dbname="porc_venta" )
 column=(type=long updatewhereclause=yes name=mostrar_ultimo dbname="mostrar_ultimo" )
 column=(type=long updatewhereclause=yes name=es_familia dbname="es_familia" )
 column=(type=char(15) updatewhereclause=yes name=margen_letras dbname="margen_letras" )
 column=(type=char(15) updatewhereclause=yes name=porc_costo_letras dbname="porc_costo_letras" )
 column=(type=char(15) updatewhereclause=yes name=porc_venta_letras dbname="porc_venta_letras" )
 column=(type=datetime updatewhereclause=yes name=fatdiari_fact_fecha_creacion dbname="fatdiari.fact_fecha_creacion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_descripcion_alterna~") COLUMN(NAME=~"faddiari.facd_cantidad~") COLUMN(NAME=~"faddiari.facd_cantidad_fraccion~") COLUMN(NAME=~"faddiari.facd_precio_unidad_producto~") COLUMN(NAME=~"faddiari.facd_unidad_venta~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_tipo_venta~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"faddiari.facd_unidad_producto~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"faddiari.facd_linea~") COLUMN(NAME=~"faddiari.facd_index~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"faddiari.facd_costo_total~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_tipo_movimiento~") COLUMN(NAME=~"faddiari.facd_modelo~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COMPUTE(NAME=~"convert(numeric(10,2),prod_existencia_total / medi_cantidad) existencia~") COMPUTE(NAME=~"convert(numeric(10,2),prod_reserva_total / medi_cantidad) reserva~") COMPUTE(NAME=~"convert(numeric(10,2),(prod_existencia_total - prod_reserva_total) / medi_cantidad) disponible~") COLUMN(NAME=~"inmprodu.prod_producto_dos~") COLUMN(NAME=~"faddiari.facd_costo_cif~") COMPUTE(NAME=~"costo_letras = '               '~") COMPUTE(NAME=~"ganancia = facd_monto_final - facd_costo_total~") COLUMN(NAME=~"faddiari.facd_monto_final~") COMPUTE(NAME=~"por_anterior = round((1- (facd_costo_total * case when fact_nota_credito = 1 then -1 else 1 end / ( facd_monto_final ) *  case when fact_nota_credito = 1 then -1 else 1 end  )) * 100,2) *  case when fact_nota_credito = 1 then -1 else 1 end~") COMPUTE(NAME=~"porc_costo= round((( facd_monto_final - facd_costo_total ) / facd_costo_total) * 100,2) * case when fact_nota_credito = 1 then -1 else 1 end~") COMPUTE(NAME=~"porc_venta = round((( facd_monto_final - facd_costo_total ) / facd_monto_final) * 100,2) * case when fact_nota_credito = 1 then -1 else 1 end~") COMPUTE(NAME=~"mostrar_ultimo = 1~") COMPUTE(NAME=~"es_familia = 0~") COMPUTE(NAME=~"margen_letras = '               '~") COMPUTE(NAME=~"porc_costo_letras = '               '~") COMPUTE(NAME=~"porc_venta_letras = '               '~") COLUMN(NAME=~"fatdiari.fact_fecha_creacion~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"faddiari.facd_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_cliente~"   OP =~"=~"    EXP2 =~":cliente~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":fecha2~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"cliente~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("cliente", number),("fecha1", datetime),("fecha2", datetime))  sort="long(fact_no_factura) A " )
