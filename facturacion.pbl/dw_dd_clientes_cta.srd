table(column=(type=decimal(0) update=yes updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" )
 column=(type=char(20) update=yes updatewhereclause=yes name=terc_identificacion dbname="dgmterce.terc_identificacion" )
 column=(type=char(60) update=yes updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" )
 column=(type=char(150) updatewhereclause=yes name=terc_direccion dbname="dgmterce.terc_direccion" )
 column=(type=char(154) updatewhereclause=yes name=descrip dbname="descrip" )
 column=(type=decimal(0) updatewhereclause=yes name=clie_limite_morosidad dbname="ccmclien.clie_limite_morosidad" )
 column=(type=char(100) updatewhereclause=yes name=pais_descripcion dbname="dgapais.pais_descripcion" )
 column=(type=char(15) updatewhereclause=yes name=clie_ref_anterior dbname="ccmclien.clie_ref_anterior" )
 column=(type=decimal(0) updatewhereclause=yes name=clie_vendedor dbname="ccmclien.clie_vendedor" )
 column=(type=decimal(4) updatewhereclause=yes name=clie_limite_credito dbname="ccmclien.clie_limite_credito" )
 column=(type=char(20) updatewhereclause=yes name=clie_pasaporte dbname="ccmclien.clie_pasaporte" )
 column=(type=char(100) updatewhereclause=yes name=regi_descripcion dbname="dgaregio.regi_descripcion" )
 column=(type=decimal(0) updatewhereclause=yes name=clie_exento_itbm dbname="ccmclien.clie_exento_itbm" )
 column=(type=char(2) updatewhereclause=yes name=terc_digito_verificador dbname="dgmterce.terc_digito_verificador" )
 column=(type=decimal(0) updatewhereclause=yes name=terc_provincia dbname="dgmterce.terc_provincia" )
 column=(type=decimal(0) updatewhereclause=yes name=terc_distrito dbname="dgmterce.terc_distrito" )
 column=(type=decimal(0) updatewhereclause=yes name=terc_corregimiento dbname="dgmterce.terc_corregimiento" )
 column=(type=char(1) updatewhereclause=yes name=terc_tipo_fact dbname="dgmterce.terc_tipo_fact" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccmclien~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaregio~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_direccion~") COMPUTE(NAME=~"dgmterce.terc_descripcion+~~~"                                                                                    ~~~"+convert(varchar(10),dgmterce.terc_tercero) descrip~") COLUMN(NAME=~"ccmclien.clie_limite_morosidad~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COLUMN(NAME=~"ccmclien.clie_vendedor~") COLUMN(NAME=~"ccmclien.clie_limite_credito~") COLUMN(NAME=~"ccmclien.clie_pasaporte~") COLUMN(NAME=~"dgaregio.regi_descripcion~") COLUMN(NAME=~"ccmclien.clie_exento_itbm~") COLUMN(NAME=~"dgmterce.terc_digito_verificador~") COLUMN(NAME=~"dgmterce.terc_provincia~") COLUMN(NAME=~"dgmterce.terc_distrito~") COLUMN(NAME=~"dgmterce.terc_corregimiento~") COLUMN(NAME=~"dgmterce.terc_tipo_fact~")    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"dgaregio.regi_codigo_region~"    OP =~"=~"RIGHT=~"dgmterce.terc_region~" )    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgmterce.terc_pais~" )WHERE(    EXP1 =~"( ccmclien.clie_g_financiero~"   OP =~"=~"    EXP2 =~":clie_grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ccmclien.clie_empresa~"   OP =~"=~"    EXP2 =~":clie_empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccmclien.clie_estado~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccmclien.clie_cuenta_mala~"   OP =~"<>~"    EXP2 =~"1~" ) ) ARG(NAME = ~"clie_grupo~" TYPE = number)  ARG(NAME = ~"clie_empresa~" TYPE = number) " arguments=(("clie_grupo", number),("clie_empresa", number))  sort="terc_descripcion A " )
