           vi_factura1.fact_empresa ,
           vi_factura1.fact_tipo ,
           vi_factura1.fact_no_pedido ,
           vi_factura1.fact_cliente ,
           vi_factura1.fact_ruc_cliente ,
           vi_factura1.fact_condicion_pago ,
           vi_factura1.fact_tipo_venta ,
           vi_factura1.fact_tipo_movimiento ,
           vi_factura1.fact_no_traspaso ,
           vi_factura1.fact_fecha_creacion ,
           vi_factura1.fact_fecha_modificacion ,
           vi_factura1.fact_dias_pago ,
           vi_factura1.fact_consignado ,
           vi_factura1.fact_a_nombre ,
           vi_factura1.fact_a_nombre_direccion ,
           vi_factura1.fact_despachado ,
           vi_factura1.fact_via ,
           vi_factura1.fact_con_emb_no ,
           vi_factura1.fact_marca ,
           vi_factura1.fact_bultos_total ,
           vi_factura1.fact_cubicaje_total ,
           vi_factura1.fact_peso_total ,
           vi_factura1.fact_unidad_peso ,
           vi_factura1.fact_gastos_total ,
           vi_factura1.fact_monto_fact_total ,
           vi_factura1.fact_descuento_subt_deta ,
           vi_factura1.fact_por_descuento ,
           vi_factura1.fact_supervisor ,
           vi_factura1.fact_monto_final ,
           vi_factura1.fact_comentario ,
           vi_factura1.fact_estado ,
           vi_factura1.empr_direccion ,
           vi_factura1.empr_apartado_postal ,
           vi_factura1.empr_telefono1 ,
           vi_factura1.empr_telefono2 ,
           vi_factura1.empr_fax1 ,
           vi_factura1.empr_fax2 ,
           vi_factura1.empr_e_mail ,
           vi_factura1.fact_fecha ,
           vi_factura1.fact_ann ,
           vi_factura1.fara_logo_f ,
           vi_factura1.fara_logo ,
           vi_factura1.medi_descripcion ,
           vi_factura1.empr_ficha ,
           vi_factura1.empr_rollo ,
           vi_factura1.empr_imagen ,
           vi_factura1.empr_dijito_verificador ,
           vi_factura1.car_descripcion ,
           vi_factura1.grupo ,
           vi_factura1.linea_subt ,
           vi_factura1.bultos ,
           vi_factura1.facd_ann ,
           vi_factura1.facd_index ,
           vi_factura1.facd_ubicacion ,
           vi_factura1.tot_por_registro ,
           vi_factura1.peri_descripcion ,
           vi_factura1.fara_jurada ,
           vi_factura1.fara_jurada_dos ,
           vi_factura1.amar_nombre_marca ,
           vi_factura1.aesp_descripcion_espec ,
           vi_factura1.acta_descripcion ,
           vi_factura1.pais_descripcion ,
           vi_factura1.prod_foto_dir ,
           vi_factura1.prod_barra ,
           vi_factura1.pais_origenes ,
           vi_factura1.acol_nombre_color   ,
           inv = convert(numeric(10,0),(vi_factura1.prod_existencia_total - vi_factura1.prod_reserva_total) / vi_factura1.medi_cantidad),
			  vi_factura1.fact_no_factura,
			  vi_factura1.prod_arancel,
			  vi_factura1.prod_barra      
        FROM vi_factura1     
        WHERE ( ( vi_factura1.fact_g_financiero = :fact_grupo ) and          ( vi_factura1.fact_empresa = :fact_empresa ) and          ( vi_factura1.fact_no_pedido = :fact_proforma ) and          ( vi_factura1.fact_ann = :fact_anio ) )  " arguments=(("fact_grupo", number),("fact_empresa", number),("fact_proforma", string),("fact_anio", number)) )
