table(column=(type=decimal(0) update=yes updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" dbalias=".terc_tercero" )
 column=(type=char(60) update=yes updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
 column=(type=long updatewhereclause=yes name=cant_pedidos dbname="cant_pedidos" )
 column=(type=decimal(0) updatewhereclause=yes name=fatdiari_fact_g_financiero dbname="fatdiari.fact_g_financiero" dbalias=".fact_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=fatdiari_fact_empresa dbname="fatdiari.fact_empresa" dbalias=".fact_empresa" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fatdiari.fact_ann" dbalias=".fact_ann" )
 column=(type=char(140) updatewhereclause=yes name=descrip dbname="descrip" )
 column=(type=char(20) updatewhereclause=yes name=fatdiari_fact_ruc_cliente dbname="fatdiari.fact_ruc_cliente" dbalias=".fact_ruc_cliente" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COMPUTE(NAME=~"sum ( 1 ) cant_pedidos~") COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"fatdiari.fact_ann~") COMPUTE(NAME=~"dgmterce.terc_descripcion +'                                                                           '+convert(varchar(5), dgmterce.terc_tercero ) descrip~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~")    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"(fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_clie)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa_clie)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":anio_clie)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_monto_final~"   OP =~"<>~"    EXP2 =~"0)~" )  GROUP(NAME=~"fatdiari.fact_g_financiero~") GROUP(NAME=~"fatdiari.fact_empresa~") GROUP(NAME=~"fatdiari.fact_ann~") GROUP(NAME=~"dgmterce.terc_tercero~") GROUP(NAME=~"fatdiari.fact_ruc_cliente~") GROUP(NAME=~"dgmterce.terc_descripcion~")) ORDER(NAME=~"fatdiari.fact_g_financiero~" ASC=yes )  ORDER(NAME=~"fatdiari.fact_empresa~" ASC=yes )  ORDER(NAME=~"fatdiari.fact_ann~" ASC=yes )  ORDER(NAME=~"dgmterce.terc_tercero~" ASC=yes )  ORDER(NAME=~"dgmterce.terc_descripcion~" ASC=yes ) ARG(NAME = ~"grupo_clie~" TYPE = number)  ARG(NAME = ~"empresa_clie~" TYPE = number)  ARG(NAME = ~"anio_clie~" TYPE = number) " arguments=(("grupo_clie", number),("empresa_clie", number),("anio_clie", number))  sort="terc_descripcion A " )
