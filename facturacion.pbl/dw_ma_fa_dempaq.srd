 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fadempaq~" )  TABLE(NAME=~"fatempaq~" )  TABLE(NAME=~"fadpedid~" ) COLUMN(NAME=~"fadempaq.empa_g_financiero~") COLUMN(NAME=~"fadempaq.empa_empresa~") COLUMN(NAME=~"fadempaq.empa_lista_empaque~") COLUMN(NAME=~"fadempaq.empa_ann~") COLUMN(NAME=~"fadempaq.empa_linea~") COLUMN(NAME=~"fadempaq.empa_codigo_producto~") COLUMN(NAME=~"fadempaq.empa_bodega~") COLUMN(NAME=~"fadempaq.empa_ubicacion~") COLUMN(NAME=~"fadempaq.empa_unidad~") COLUMN(NAME=~"fadempaq.empa_linea_original~") COLUMN(NAME=~"fadempaq.empa_bulto_inicio~") COLUMN(NAME=~"fadempaq.empa_bulto_fin~") COLUMN(NAME=~"fadempaq.empa_cantidad~") COLUMN(NAME=~"fadempaq.empa_peso~") COLUMN(NAME=~"fadempaq.empa_unidad_peso~") COLUMN(NAME=~"fadempaq.empa_cubicaje~") COLUMN(NAME=~"fadempaq.empa_largo~") COLUMN(NAME=~"fadempaq.empa_alto~") COLUMN(NAME=~"fadempaq.empa_ancho~") COLUMN(NAME=~"fadpedid.dped_g_financiero~") COLUMN(NAME=~"fadpedid.dped_empresa~") COLUMN(NAME=~"fadpedid.dped_no_pedido~") COLUMN(NAME=~"fadpedid.dped_ann~") COLUMN(NAME=~"fadpedid.dped_linea~") COLUMN(NAME=~"fadpedid.dped_producto_servicio~") COLUMN(NAME=~"fadpedid.dped_codigo_item~") COLUMN(NAME=~"fadpedid.dped_descripcion_alterna~") COLUMN(NAME=~"fadpedid.dped_cubicaje~") COLUMN(NAME=~"fadpedid.dped_peso~") COLUMN(NAME=~"fadpedid.dped_unidad_peso~") COLUMN(NAME=~"fadpedid.dped_unidad_producto~") COLUMN(NAME=~"fadpedid.dped_precio_mayor~") COLUMN(NAME=~"fadpedid.dped_precio_menor~") COLUMN(NAME=~"fadpedid.dped_bodega~") COLUMN(NAME=~"fadpedid.dped_costo_fob~") COLUMN(NAME=~"fadpedid.dped_costo_cif~") COLUMN(NAME=~"fadpedid.dped_precio_unidad_producto~") COLUMN(NAME=~"fadpedid.dped_unidad_venta~") COLUMN(NAME=~"fadpedid.dped_cantidad~") COLUMN(NAME=~"fadpedid.dped_fraccion~") COLUMN(NAME=~"fadpedid.dped_monto_total~") COLUMN(NAME=~"fadpedid.dped_por_descuento~") COLUMN(NAME=~"fadpedid.dped_monto_final~") COLUMN(NAME=~"fadpedid.dped_fecha_reg~") COLUMN(NAME=~"fadpedid.dped_usuario~") COLUMN(NAME=~"fadpedid.dped_supervisor~") COLUMN(NAME=~"fadpedid.dped_bultos~") COLUMN(NAME=~"fadpedid.dped_ubicacion~") COLUMN(NAME=~"fadpedid.dped_pasada~") COLUMN(NAME=~"fadpedid.dped_cant_asignada~") COLUMN(NAME=~"fadpedid.dped_index~") COMPUTE(NAME=~"~~~"                ~~~" c_cant_frac,0 c_cant_e,0 c_cant_f~") COLUMN(NAME=~"fadempaq.empa_bultos~") COLUMN(NAME=~"fadpedid.dped_precio_original~")    JOIN (LEFT=~"fatempaq.enca_g_financiero~"    OP =~"=~"RIGHT=~"fadempaq.empa_g_financiero~" )    JOIN (LEFT=~"fatempaq.enca_empresa~"    OP =~"=~"RIGHT=~"fadempaq.empa_empresa~" )    JOIN (LEFT=~"fatempaq.enca_lista_empaque~"    OP =~"=~"RIGHT=~"fadempaq.empa_lista_empaque~" )    JOIN (LEFT=~"fatempaq.enca_ann~"    OP =~"=~"RIGHT=~"fadempaq.empa_ann~" )    JOIN (LEFT=~"fatempaq.enca_g_financiero~"    OP =~"=~"RIGHT=~"fadpedid.dped_g_financiero~" )    JOIN (LEFT=~"fatempaq.enca_empresa~"    OP =~"=~"RIGHT=~"fadpedid.dped_empresa~" )    JOIN (LEFT=~"fatempaq.enca_no_pedido~"    OP =~"=~"RIGHT=~"fadpedid.dped_no_pedido~" )    JOIN (LEFT=~"fatempaq.enca_ann_pedido~"    OP =~"=~"RIGHT=~"fadpedid.dped_ann~" )    JOIN (LEFT=~"fadempaq.empa_linea_original~"    OP =~"=~"RIGHT=~"fadpedid.dped_linea~" )WHERE(    EXP1 =~"fatempaq.enca_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatempaq.enca_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatempaq.enca_lista_empaque~"   OP =~"=~"    EXP2 =~":listempaq~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatempaq.enca_ann~"   OP =~"=~"    EXP2 =~":anno~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"listempaq~" TYPE = string)  ARG(NAME = ~"anno~" TYPE = number) " arguments=(("g_financiero", number),("empresa", number),("listempaq", string),("anno", number))  sort="empa_bulto_inicio A empa_bulto_fin A " )
group(level=1 header.height=0 trailer.height=0 by=("empa_linea_original" ) header.color="536870912" trailer.color="536870912" )
