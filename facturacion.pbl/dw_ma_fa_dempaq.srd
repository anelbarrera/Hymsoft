compute(band=detail alignment="2" expression=" empa_lista_empaque + ~" / ~" + empa_ann "border="5" color="8388608~tif( getrow() = currentRow(),rgb(255,255,255),rgb(0,0,128) )" x="14" y="4" height="56" width="315" format="[general]"  name=compute_1  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="0" background.color="16777215~tif( getrow() = currentRow(),rgb(0,0,255),if ( fadpedid_dped_pasada   > 0, rgb(192,192,192), rgb(255,255,255)))" )
compute(band=detail alignment="2" expression="  empa_codigo_producto +~"_~"+empa_bodega  + ~"_~" + empa_ubicacion "border="5" color="8388608~tif( getrow() = currentRow(),rgb(255,255,255),rgb(0,0,128) )" x="347" y="4" height="56" width="466" format="[general]"  name=compute_2  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="0" background.color="16777215~tif( getrow() = currentRow(),rgb(0,0,255),if ( fadpedid_dped_pasada   > 0, rgb(192,192,192), rgb(255,255,255)))" )
