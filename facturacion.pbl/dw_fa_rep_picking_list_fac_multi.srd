ento~") COLUMN(NAME=~"fatdiari.fact_supervisor~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"fatdiari.fact_comentario~") COLUMN(NAME=~"fatdiari.fact_estado~") COLUMN(NAME=~"fatdiari.fact_act_cliente~") COLUMN(NAME=~"fatdiari.fact_act_inventario~") COLUMN(NAME=~"fatdiari.fact_act_conta~") COLUMN(NAME=~"fatdiari.fact_cerrada~") COLUMN(NAME=~"fatdiari.fact_referencia_fac~") COLUMN(NAME=~"fatdiari.fact_monto_abonado~") COLUMN(NAME=~"faddiari.facd_pedido_original~") COLUMN(NAME=~"faddiari.facd_linea~") COLUMN(NAME=~"faddiari.facd_producto_servicio~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_descripcion_alterna~") COLUMN(NAME=~"faddiari.facd_cubicaje~") COLUMN(NAME=~"faddiari.facd_peso~") COLUMN(NAME=~"faddiari.facd_unidad_peso~") COLUMN(NAME=~"faddiari.facd_unidad_producto~") COLUMN(NAME=~"faddiari.facd_precio_mayor~") COLUMN(NAME=~"faddiari.facd_precio_menor~") COLUMN(NAME=~"faddiari.facd_bodega~") COLUMN(NAME=~"faddiari.facd_costo_fob~") COLUMN(NAME=~"faddiari.facd_costo_cif~") COLUMN(NAME=~"faddiari.facd_precio_unidad_producto~") COLUMN(NAME=~"faddiari.facd_unidad_venta~") COLUMN(NAME=~"faddiari.facd_cantidad~") COLUMN(NAME=~"faddiari.facd_cantidad_fraccion~") COLUMN(NAME=~"faddiari.facd_monto_total~") COLUMN(NAME=~"faddiari.facd_por_descuento~") COLUMN(NAME=~"faddiari.facd_monto_final~") COLUMN(NAME=~"faddiari.facd_fecha_reg~") COLUMN(NAME=~"faddiari.facd_usuario~") COLUMN(NAME=~"faddiari.facd_supervisor~") COLUMN(NAME=~"faddiari.facd_bultos~") COLUMN(NAME=~"faddiari.facd_pais~") COLUMN(NAME=~"faddiari.facd_ubicacion~") COLUMN(NAME=~"faddiari.facd_cant_devuelta~") COLUMN(NAME=~"faddiari.facd_linea_articulo_dev~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"faaparam.fara_logo_f~") COLUMN(NAME=~"faaparam.fara_logo~") COLUMN(NAME=~"dgaperio.peri_descripcion~") COLUMN(NAME=~"inmbodeg.mbod_cantidad~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_descripcion~") COLUMN(NAME=~"inmprodu.prod_medida~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"inmbodeg.mbod_reserva~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COMPUTE(NAME=~"mbod_cantidad -  mbod_reserva  disponible,           ~~~"~~~" cambio,           ~~~"~~~" parcial~") COLUMN(NAME=~"faddiari.facd_tipo~") COLUMN(NAME=~"faddiari.facd_no_pedido~") COLUMN(NAME=~"faddiari.facd_ann~") COLUMN(NAME=~"faddiari.facd_g_financiero~") COLUMN(NAME=~"faddiari.facd_empresa~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"inamedid.medi_descripcion~") COLUMN(NAME=~"faddiari.facd_index~") COMPUTE(NAME=~"convert(numeric(10,0),(mbod_cantidad/inamedid.medi_cantidad)) entero~") COMPUTE(NAME=~"mbod_cantidad - (convert(numeric(10,0),(mbod_cantidad / inamedid.medi_cantidad)) * inamedid.medi_cantidad) fraccion~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"faddiari.facd_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"inmprodu.prod_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )    JOIN (LEFT=~"fatdiari.fact_dias_pago~"    OP =~"=~"RIGHT=~"dgaperio.peri_periodo~" )    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"inmbodeg.mbod_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"inmbodeg.mbod_empresa~" )    JOIN (LEFT=~"faddiari.facd_codigo_item~"    OP =~"=~"RIGHT=~"inmbodeg.mbod_producto~" )    JOIN (LEFT=~"faddiari.facd_bodega~"    OP =~"=~"RIGHT=~"inmbodeg.mbod_bodega~" )    JOIN (LEFT=~"faddiari.facd_ubicacion~"    OP =~"=~"RIGHT=~"inmbodeg.mbod_ubicacion~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )WHERE(    EXP1 =~"((fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_tipo~"   OP =~"=~"    EXP2 =~":tipo)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":an)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA' ) )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"tipo~" TYPE = string)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("tipo", string),("pedido", string),("an", number))  sort="facd_index A " )
