table(column=(type=char(8) updatewhereclause=yes name=fact_no_pedido dbname="fatdiari.fact_no_pedido" )
 column=(type=char(20) updatewhereclause=yes name=fact_ruc_cliente dbname="fatdiari.fact_ruc_cliente" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fatdiari.fact_a_nombre" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fatdiari.fact_fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_final dbname="fatdiari.fact_monto_final" )
 column=(type=datetime updatewhereclause=yes name=fact_vence_reserva dbname="fatdiari.fact_vence_reserva" )
 column=(type=char(41) updatewhereclause=yes name=vendedor dbname="vendedor" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fatdiari.fact_ann" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"fatdiari.fact_vence_reserva~") COMPUTE(NAME=~"vendedor = (  SELECT famvende.vend_nombre+' '+famvende.vend_apellido  FROM fadvenfa, famvende  WHERE ( famvende.vend_g_financiero = fadvenfa.vfac_g_financiero ) and  ( famvende.vend_empresa = fadvenfa.vfac_empresa ) and  ( famvende.vend_vendedor = fadvenfa.vfac_vendedor ) and  ( ( fadvenfa.vfac_g_financiero = fatdiari.fact_g_financiero ) AND  ( fadvenfa.vfac_empresa = fatdiari.fact_empresa ) AND  ( fadvenfa.vfac_no_pedido = fatdiari.fact_no_pedido ) AND  ( fadvenfa.vfac_ann = fatdiari.fact_ann ) )  )~") COLUMN(NAME=~"fatdiari.fact_ann~")WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_reserva_vence~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_vence_reserva~"   OP =~"<=~"    EXP2 =~"getdate()~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="fact_monto_final D " )
