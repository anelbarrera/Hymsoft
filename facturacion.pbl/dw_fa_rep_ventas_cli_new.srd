 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"faaparam~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_descripcion_alterna~") COLUMN(NAME=~"faddiari.facd_cantidad~") COLUMN(NAME=~"faddiari.facd_cantidad_fraccion~") COLUMN(NAME=~"faddiari.facd_precio_unidad_producto~") COLUMN(NAME=~"faddiari.facd_unidad_venta~") COLUMN(NAME=~"faddiari.facd_monto_total~") COLUMN(NAME=~"faddiari.facd_monto_final~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_tipo_venta~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"faddiari.facd_por_descuento~") COLUMN(NAME=~"faddiari.facd_costo_fob~") COLUMN(NAME=~"faddiari.facd_costo_cif~") COLUMN(NAME=~"faddiari.facd_unidad_producto~") COLUMN(NAME=~"faaparam.fara_logo_f~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"faaparam.fara_logo~") COMPUTE(NAME=~"0.00 compute_ct~") COLUMN(NAME=~"faddiari.facd_index~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"faddiari.facd_costo_total~") COMPUTE(NAME=~"0  descuento_sino~") COLUMN(NAME=~"faddiari.facd_descuento_ncr~") COLUMN(NAME=~"fatdiari.fact_descuento_ncr~") COLUMN(NAME=~"fatdiari.fact_ncr_descuento~") COLUMN(NAME=~"fatdiari.fact_tipo_movimiento~") COLUMN(NAME=~"fatdiari.fact_nota_credito~") COLUMN(NAME=~"inmprodu.prod_producto_dos~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"faddiari.facd_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"fatdiari.fact_cierre_de_metal~"   OP =~"=~"    EXP2 =~"1~" ) ) "  sort="terc_descripcion A fact_ruc_cliente A fact_fecha A fact_no_factura A fact_no_pedido A fact_ann A facd_index A " )
