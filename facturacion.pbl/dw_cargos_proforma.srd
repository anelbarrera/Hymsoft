 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fadproca~" ) COLUMN(NAME=~"fadproca.prca_g_financiero~") COLUMN(NAME=~"fadproca.prca_empresa~") COLUMN(NAME=~"fadproca.prca_no_proforma~") COLUMN(NAME=~"fadproca.prca_ann~") COLUMN(NAME=~"fadproca.prca_codigo_cargo~") COLUMN(NAME=~"fadproca.prca_monto~")WHERE(    EXP1 =~"( fadproca.prca_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadproca.prca_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadproca.prca_no_proforma~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadproca.prca_ann~"   OP =~"=~"    EXP2 =~":ann )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="fadproca" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("pedido", string),("ann", number)) )
