table(column=(type=decimal(4) updatewhereclause=yes name=fact_monto_fact_total dbname="fatdiari.fact_monto_fact_total" )
 column=(type=char(40) updatewhereclause=yes name=faacargo_carg_descripcion dbname="faacargo.carg_descripcion" )
 column=(type=decimal(4) updatewhereclause=yes name=dcar_monto dbname="fadcargo.dcar_monto" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_por_descuento dbname="fatdiari.fact_por_descuento" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_final dbname="fatdiari.fact_monto_final" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_gastos_total dbname="fatdiari.fact_gastos_total" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fadcargo~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"faacargo~" ) COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"faacargo.carg_descripcion~") COLUMN(NAME=~"fadcargo.dcar_monto~") COLUMN(NAME=~"fatdiari.fact_por_descuento~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"fatdiari.fact_gastos_total~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"fadcargo.dcar_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"fadcargo.dcar_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"fadcargo.dcar_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"fadcargo.dcar_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"fadcargo.dcar_ann~" )    JOIN (LEFT=~"faacargo.carg_g_financiero~"    OP =~"=~"RIGHT=~"fadcargo.dcar_g_financiero~" )    JOIN (LEFT=~"faacargo.carg_empresa~"    OP =~"=~"RIGHT=~"fadcargo.dcar_empresa~" )    JOIN (LEFT=~"faacargo.carg_cargo~"    OP =~"=~"RIGHT=~"fadcargo.dcar_codigo~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("pedido", string),("ann", number)) )
