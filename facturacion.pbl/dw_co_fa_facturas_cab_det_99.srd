 column=(type=char(3) updatewhereclause=yes name=fatdiari_fact_tipo dbname="fatdiari.fact_tipo" dbalias=".fact_tipo" )
 column=(type=char(20) updatewhereclause=yes name=fatdiari_fact_ruc_cliente dbname="fatdiari.fact_ruc_cliente" dbalias=".fact_ruc_cliente" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
 column=(type=char(2) updatewhereclause=yes name=fatdiari_fact_condicion_pago dbname="fatdiari.fact_condicion_pago" dbalias=".fact_condicion_pago" values="CONTADO	CO/CRÉDITO	CR/C.O.D	CD/" )
 column=(type=datetime updatewhereclause=yes name=fatdiari_fact_fecha dbname="fatdiari.fact_fecha" dbalias=".fact_fecha" initial="today" )
 column=(type=char(100) updatewhereclause=yes name=fatdiari_fact_a_nombre dbname="fatdiari.fact_a_nombre" dbalias=".fact_a_nombre" )
