table(column=(type=char(20) updatewhereclause=yes name=facd_codigo_item dbname="faddiari.facd_codigo_item" )
 column=(type=decimal(4) updatewhereclause=yes name=corriente_monto dbname="corriente_monto" initial="0.00" )
 column=(type=decimal(6) updatewhereclause=yes name=corriente_gramos dbname="corriente_gramos" initial="0.00" )
