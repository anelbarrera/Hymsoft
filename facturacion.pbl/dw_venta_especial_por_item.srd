 column=(type=decimal(2) updatewhereclause=yes name=total_gramos dbname="total_gramos" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"faddiari.facd_codigo_item~") COMPUTE(NAME=~"sum( facd_monto_final ) corriente_monto~") COMPUTE(NAME=~"sum( facd_cantidad ) corriente_gramos~") COMPUTE(NAME=~"0.00 total_monto~") COMPUTE(NAME=~"0.00 total_gramos~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"faddiari.facd_codigo_item~" )WHERE(    EXP1 =~"faddiari.facd_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_cliente~"   OP =~"=~"    EXP2 =~":tercero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"faddiari.facd_codigo_item~"   OP =~"=~"    EXP2 =~":item~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_precio_recargo~"   OP =~">=~"    EXP2 =~":precio1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_precio_recargo~"   OP =~"<=~"    EXP2 =~":precio2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~" )  GROUP(NAME=~"faddiari.facd_codigo_item~")) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"tercero~" TYPE = number)  ARG(NAME = ~"item~" TYPE = string)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime)  ARG(NAME = ~"precio1~" TYPE = number)  ARG(NAME = ~"precio2~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("tercero", number),("item", string),("fecha1", datetime),("fecha2", datetime),("precio1", number),("precio2", number)) )
