 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"dgaperio~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_tipo_venta~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_descripcion_alterna~") COLUMN(NAME=~"faddiari.facd_unidad_producto~") COLUMN(NAME=~"faddiari.facd_costo_fob~") COLUMN(NAME=~"faddiari.facd_costo_cif~") COLUMN(NAME=~"faddiari.facd_precio_unidad_producto~") COLUMN(NAME=~"faddiari.facd_unidad_venta~") COLUMN(NAME=~"faddiari.facd_cantidad~") COLUMN(NAME=~"faddiari.facd_cantidad_fraccion~") COLUMN(NAME=~"faddiari.facd_monto_total~") COLUMN(NAME=~"faddiari.facd_por_descuento~") COLUMN(NAME=~"faddiari.facd_monto_final~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"fatdiari.fact_consignado~") COLUMN(NAME=~"fatdiari.fact_despachado~") COLUMN(NAME=~"dgaperio.peri_descripcion~") COLUMN(NAME=~"fatdiari.fact_bultos_total~") COLUMN(NAME=~"fatdiari.fact_cubicaje_total~") COLUMN(NAME=~"fatdiari.fact_peso_total~") COLUMN(NAME=~"fatdiari.fact_unidad_peso~") COLUMN(NAME=~"fatdiari.fact_comentario~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"faddiari.facd_bultos~") COLUMN(NAME=~"faddiari.facd_usuario~") COLUMN(NAME=~"faddiari.facd_peso~") COLUMN(NAME=~"faddiari.facd_unidad_peso~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_a_nombre_direccion~") COLUMN(NAME=~"inmprodu.prod_foto_editada~") COLUMN(NAME=~"faddiari.facd_index~") COMPUTE(NAME=~"vendedor = (  SELECT famvende.vend_nombre + ' '+famvende.vend_apellido  FROM fadvenfa,   famvende  WHERE ( fatdiari.fact_g_financiero = fadvenfa.vfac_g_financiero ) and  ( fatdiari.fact_empresa = fadvenfa.vfac_empresa ) and  ( fatdiari.fact_tipo = fadvenfa.vfac_tipo ) and  ( fatdiari.fact_no_pedido = fadvenfa.vfac_no_pedido ) and  ( fatdiari.fact_ann = fadvenfa.vfac_ann ) and  ( fadvenfa.vfac_g_financiero = famvende.vend_g_financiero ) and  ( fadvenfa.vfac_empresa = famvende.vend_empresa ) and  ( fadvenfa.vfac_vendedor = famvende.vend_vendedor )    )~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"faddiari.facd_codigo_item~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"fatdiari.fact_cliente~" )    JOIN (LEFT=~"dgaperio.peri_periodo~"    OP =~"=~"RIGHT=~"fatdiari.fact_dias_pago~" )WHERE(    EXP1 =~"( ( fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":v_grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":v_empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_no_pedido~"   OP =~"=~"    EXP2 =~":v_pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":v_ann )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA' ) )~" ) ) ARG(NAME = ~"v_grupo~" TYPE = number)  ARG(NAME = ~"v_empresa~" TYPE = number)  ARG(NAME = ~"v_pedido~" TYPE = string)  ARG(NAME = ~"v_ann~" TYPE = number) " arguments=(("v_grupo", number),("v_empresa", number),("v_pedido", string),("v_ann", number))  sort="facd_codigo_item A faddiari_facd_index A " )
