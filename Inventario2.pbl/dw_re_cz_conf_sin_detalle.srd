 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crtconfi~" )  TABLE(NAME=~"crdconfi~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"dgmempre~" ) COLUMN(NAME=~"crtconfi.tcof_anno_oc~") COLUMN(NAME=~"crtconfi.tcof_num_prove~") COLUMN(NAME=~"crdconfi.dcof_producto~") COLUMN(NAME=~"crdconfi.dcof_unidad~") COLUMN(NAME=~"crdconfi.dcof_descripcion~") COLUMN(NAME=~"crdconfi.dcof_cantidad_total~") COLUMN(NAME=~"crdconfi.dcof_precio1~") COLUMN(NAME=~"crdconfi.dcof_precio2~") COLUMN(NAME=~"crdconfi.dcof_precio3~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"crdconfi.dcof_precio_u~") COLUMN(NAME=~"crtconfi.tcof_fecha_conf_oc~") COLUMN(NAME=~"crtconfi.tcof_fecha_llegada~") COLUMN(NAME=~"crtconfi.tcof_marca~") COLUMN(NAME=~"inamedid.medi_descripcion~") COLUMN(NAME=~"crtconfi.tcof_destino~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_telefono1~") COLUMN(NAME=~"dgmempre.empr_fax1~") COLUMN(NAME=~"dgmempre.empr_ficha~") COLUMN(NAME=~"dgmempre.empr_rollo~") COLUMN(NAME=~"dgmempre.empr_imagen~") COLUMN(NAME=~"crdconfi.dcof_cant1~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"crtconfi.tcof_comentario_add~") COLUMN(NAME=~"crtconfi.tcof_fecha_registro~") COLUMN(NAME=~"crtconfi.tcof_num_conf_oc~")    JOIN (LEFT=~"crtconfi.tcof_g_financiero~"    OP =~"=~"RIGHT=~"crdconfi.dcof_g_financiero~" )    JOIN (LEFT=~"crtconfi.tcof_empresa~"    OP =~"=~"RIGHT=~"crdconfi.dcof_empresa~" )    JOIN (LEFT=~"crtconfi.tcof_num_conf_oc~"    OP =~"=~"RIGHT=~"crdconfi.dcof_num_conf_oc~" )    JOIN (LEFT=~"crtconfi.tcof_anno_oc~"    OP =~"=~"RIGHT=~"crdconfi.dcof_anno_oc~" )    JOIN (LEFT=~"crtconfi.tcof_num_prove~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"crdconfi.dcof_unidad~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"crtconfi.tcof_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"crtconfi.tcof_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )WHERE(    EXP1 =~"( ( crtconfi.tcof_g_financiero~"   OP =~"=~"    EXP2 =~":an_g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( crtconfi.tcof_empresa~"   OP =~"=~"    EXP2 =~":an_empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( crtconfi.tcof_num_conf_oc~"   OP =~"=~"    EXP2 =~":as_num_conf_oc )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( crtconfi.tcof_anno_oc~"   OP =~"=~"    EXP2 =~":an_anno ) )~" ) ) ARG(NAME = ~"an_g_financiero~" TYPE = number)  ARG(NAME = ~"an_empresa~" TYPE = number)  ARG(NAME = ~"as_num_conf_oc~" TYPE = string)  ARG(NAME = ~"an_anno~" TYPE = number) " arguments=(("an_g_financiero", number),("an_empresa", number),("as_num_conf_oc", string),("an_anno", number)) )
