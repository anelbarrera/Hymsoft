column(band=detail id=1 alignment="0" tabsequence=32766 border="0" color="3355443" x="30" y="8" height="56" width="450" format="[general]" name=aran_arancel edit.limit=0 edit.case=any edit.focusrectangle=no edit.autoselect=no font.face="Segoe UI" font.height="-9" font.weight="400" font.family="2" font.pitch="2" font.charset="0" background.mode="0" background.color="16777215~tif(getrow()=currentrow(),16706271,if(mod(getrow(),2)=0,16777215,16514043))" )
