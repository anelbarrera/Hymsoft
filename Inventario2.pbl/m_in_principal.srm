//objectcomments Menu para los reportes de inventario
forward
global type m_in_principal from m_in_padre
end type
type m_buscar from menu within m_edicion
end type
type m_edicion from m_in_padre`m_edicion within m_in_principal
m_buscar m_buscar
end type
end forward

global type m_in_principal from m_in_padre
end type
global m_in_principal m_in_principal

on m_in_principal.create
m_in_principal=this
call super::create
end on

on m_in_principal.destroy
call super::destroy
end on

type m_archivo from m_in_padre`m_archivo within m_in_principal
end type

on m_archivo.create
call super::create
this.tag = "m_in_principal.m_archivo"
end on

on m_archivo.destroy
call super::destroy
end on

