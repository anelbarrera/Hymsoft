type m_edicion from m_in_padre`m_edicion within m_in_principal
m_buscar m_buscar
end type

on m_edicion.create
call super::create
this.tag = "m_in_principal.m_edicion"
this.visible = true
this.enabled = true
this.m_buscar=create m_buscar
this.Item[UpperBound(this.Item)+1]=this.m_buscar
end on

on m_edicion.destroy
call super::destroy
destroy(this.m_buscar)
end on

