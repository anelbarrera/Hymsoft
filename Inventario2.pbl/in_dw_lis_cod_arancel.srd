release 7;
datawindow(units=2 timer_interval=0 color=16777215 processing=0 HTMLDW=no print.documentname="" print.orientation = 2 print.margin.left = 1000 print.margin.right = 1000 print.margin.top = 1000 print.margin.bottom = 1000 print.paper.source = 0 print.paper.size = 1 print.prompt=no print.buttons=no print.preview.buttons=no )
