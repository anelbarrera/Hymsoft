table(column=(type=char(11) updatewhereclause=yes name=aran_arancel dbname="inaaranc.aran_arancel" )
 column=(type=char(30) updatewhereclause=yes name=aran_descripcion dbname="inaaranc.aran_descripcion" )
 column=(type=decimal(4) updatewhereclause=yes name=aran_porcentaje dbname="inaaranc.aran_porcentaje" )
 column=(type=char(120) updatewhereclause=yes name=inaparam_para_in_foto_chica dbname="inaparam.para_in_foto_chica" )
 column=(type=char(120) updatewhereclause=yes name=inaparam_para_in_foto_fondo dbname="inaparam.para_in_foto_fondo" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inaaranc~" )  TABLE(NAME=~"inaparam~" ) COLUMN(NAME=~"inaaranc.aran_arancel~") COLUMN(NAME=~"inaaranc.aran_descripcion~") COLUMN(NAME=~"inaaranc.aran_porcentaje~") COLUMN(NAME=~"inaparam.para_in_foto_chica~") COLUMN(NAME=~"inaparam.para_in_foto_fondo~")WHERE(    EXP1 =~"inaparam.para_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inaparam.para_empresa~"   OP =~"=~"    EXP2 =~":empresa~" ) ) ORDER(NAME=~"inaaranc.aran_arancel~" ASC=yes ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number)) )
