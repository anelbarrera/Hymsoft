 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"notascr_detalle~" )  TABLE(NAME=~"notascr_encab~" ) COLUMN(NAME=~"notascr_encab.g_financiero~") COLUMN(NAME=~"notascr_encab.empresa~") COLUMN(NAME=~"notascr_encab.documento~") COLUMN(NAME=~"notascr_encab.ann~") COLUMN(NAME=~"notascr_encab.fecha~") COLUMN(NAME=~"notascr_encab.proveedor~") COLUMN(NAME=~"notascr_encab.comentario~") COLUMN(NAME=~"notascr_encab.estado~") COLUMN(NAME=~"notascr_encab.usuario~") COLUMN(NAME=~"notascr_encab.factura~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"notascr_detalle.linea~") COLUMN(NAME=~"notascr_detalle.item~") COLUMN(NAME=~"notascr_detalle.descripcion~") COLUMN(NAME=~"notascr_detalle.cantidad~") COLUMN(NAME=~"notascr_detalle.fracion~") COLUMN(NAME=~"notascr_detalle.unidad~") COLUMN(NAME=~"notascr_detalle.precio~") COLUMN(NAME=~"notascr_detalle.porciento~") COLUMN(NAME=~"notascr_detalle.total~") COLUMN(NAME=~"notascr_detalle.comentario~") COLUMN(NAME=~"inamedid.medi_descripcion~")    JOIN (LEFT=~"notascr_encab.g_financiero~"    OP =~"=~"RIGHT=~"notascr_detalle.g_financiero~" )    JOIN (LEFT=~"notascr_encab.empresa~"    OP =~"=~"RIGHT=~"notascr_detalle.empresa~" )    JOIN (LEFT=~"notascr_encab.documento~"    OP =~"=~"RIGHT=~"notascr_detalle.documento~" )    JOIN (LEFT=~"notascr_encab.ann~"    OP =~"=~"RIGHT=~"notascr_detalle.ann~" )    JOIN (LEFT=~"notascr_detalle.unidad~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"notascr_encab.proveedor~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"notascr_encab.g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"notascr_encab.empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"notascr_encab.documento~"   OP =~"=~"    EXP2 =~":documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"notascr_encab.ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"documento~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("documento", string),("ann", number)) )
