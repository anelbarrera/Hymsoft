 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"notascr_detalle~" ) COLUMN(NAME=~"notascr_detalle.g_financiero~") COLUMN(NAME=~"notascr_detalle.empresa~") COLUMN(NAME=~"notascr_detalle.documento~") COLUMN(NAME=~"notascr_detalle.ann~") COLUMN(NAME=~"notascr_detalle.linea~") COLUMN(NAME=~"notascr_detalle.item~") COLUMN(NAME=~"notascr_detalle.descripcion~") COLUMN(NAME=~"notascr_detalle.cantidad~") COLUMN(NAME=~"notascr_detalle.fracion~") COLUMN(NAME=~"notascr_detalle.unidad~") COLUMN(NAME=~"notascr_detalle.precio~") COLUMN(NAME=~"notascr_detalle.porciento~") COLUMN(NAME=~"notascr_detalle.total~") COLUMN(NAME=~"notascr_detalle.comentario~") COLUMN(NAME=~"notascr_detalle.tipo~")WHERE(    EXP1 =~"notascr_detalle.g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"notascr_detalle.empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"notascr_detalle.documento~"   OP =~"=~"    EXP2 =~":documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"notascr_detalle.ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"documento~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="notascr_detalle" updatewhere=1 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("documento", string),("ann", number)) )
