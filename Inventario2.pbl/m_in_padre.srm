event clicked;int li_captura

select para_captura_quilate
into :li_captura
from inaparam
where para_g_financiero=:str.g_financiero
  and para_empresa=:str.empresa;

if li_captura = 0 then m_transaccines.m_ajustes.m_ajustedeexistenciasconclavesyco.visible=false
end event

