event clicked;Window				lw_child
str_kardex			str_opcion
str_in_informe		str_informe

str_opcion.opcion_menu = 'IIA'
str_opcion.titulo_ventana = '(IN) Valor del Inventario a la Fecha Actual'
str_opcion.dwinforme_1 = 'in_dw_valor_inv_actual1'

str_informe.opcion_menu = str_opcion.opcion_menu

//((OpenWithParm(w_in_info_precio,str_informe)

setpointer(hourglass!)

str_informe = Message.PowerObjectParm

If str_informe.precio = 0 Then
	messagebox('Atención','¡No se recuperó el Costo a Desplegar!',StopSign!)
	return
Else
	str_opcion.precio = str_informe.precio
End if

setpointer(arrow!)

//
//str_opcion.opcion_menu  = 'IPPB'
//str_opcion.dwinforme_1 = 'in_dw_valor_inv_actual_bod'

