on m_ajustes.create
call super::create
this.tag = "m_in_padre.m_transaccines.m_ajustes"
this.text = "&Ajustes"
this.microhelp = "Control de Ajustes al Inventario"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 134217741
