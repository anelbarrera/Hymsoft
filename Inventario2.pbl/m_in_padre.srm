this.m_impresión1=create m_impresión1
this.m_resumendeentradasanticipadasporm=create m_resumendeentradasanticipadasporm
this.m_pase=create m_pase
this.Item[UpperBound(this.Item)+1]=this.m_captura1
this.Item[UpperBound(this.Item)+1]=this.m_impresión1
