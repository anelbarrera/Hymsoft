event clicked;Integer li_actualizacion, li_captura
sqlca.autocommit = true

Select isnull(para_actualizar,1), isnull(para_captura_quilate,0)
Into   :li_actualizacion, :li_captura
From   inaparam
Where  para_g_financiero =: str.g_financiero and
       para_empresa =: str.empresa ;
	 
If li_actualizacion = 1 Then
	This.m_actualizartransacciones.Enabled = True
End If
//if li_captura = 0 then this.m_devoluciones.visible=true

if li_captura = 0 then
//	this.m_ajustes.m_ajustedeexistenciasycostospreliminar.visible=true
else 
   this.m_ajustes.m_ajustedeexistenciasycostospreliminar.visible=false
end if

if li_captura = 1 then 
	this.m_entradas.m_captura.text='&Costeo'
else
	this.m_entradas.m_captura.text='&Captura'
end if


end event

event selected;string ls_tag

//Llamado de funcion de acceso a opciones (SEGURIDAD)
ls_tag = this.Tag

if gf_ss_accesos(str.grupo,'IN','m_in_padre',ls_tag) = true then
	this.enabled = true
else
	this.enabled = false
	return
end if

end event

