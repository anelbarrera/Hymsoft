this.Item[UpperBound(this.Item)+1]=this.m_ajustedeexistenciasycostos
this.Item[UpperBound(this.Item)+1]=this.m_ajustedecostos
this.Item[UpperBound(this.Item)+1]=this.m_ajustedeprecios
this.Item[UpperBound(this.Item)+1]=this.m_ajustedeexistenciasconclavesyco
this.Item[UpperBound(this.Item)+1]=this.m_-18
