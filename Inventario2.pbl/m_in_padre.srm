event clicked;//string dos
//dos = this.tag 
//
//
//  SELECT ssmmenu.menu_cod_menu + menu_aplicacion 
//    INTO :dos  
//    FROM ssmmenu  
//   WHERE ssmmenu.menu_item = :dos   ;
//
//
//messagebox('Tag' , this.tag +' '+ dos )
sqlca.autocommit = true
int li_captura

select para_utiliza_sec_codigo
into :li_captura
from inaparam
where para_g_financiero=:str.g_financiero
  and para_empresa=:str.empresa;



if li_captura = 0 then 
	m_mantenimientos.m_mantenimientodegeneracióndecódigos.visible=false
else
	m_mantenimientos.m_mantenimientodegeneracióndecódigos.visible=true
end if 
end event

event selected;string ls_tag

//Llamado de funcion de acceso a opciones (SEGURIDAD)
ls_tag = this.Tag

if gf_ss_accesos(str.grupo,'IN','m_in_padre',ls_tag) = true then
	this.enabled = true
else
	this.enabled = false
	return
end if
int li_captura

select para_utiliza_sec_codigo
into :li_captura
from inaparam
where para_g_financiero=:str.g_financiero
  and para_empresa=:str.empresa;

if li_captura = 0 then m_mantenimientos.m_mantenimientodegeneracióndecódigos.visible=false
end event

