forward prototypes
public subroutine mf_inventarios (boolean status)
public subroutine mf_iconos_inventario (readonly boolean status)
public subroutine mf_otros_iconos_1 (readonly boolean status)
public subroutine mf_otros_iconos_2 (boolean status)
public subroutine mf_in_activa_reporte (readonly boolean status)
end prototypes

public subroutine mf_inventarios (boolean status);/* this.m_archivo.m_iniciarsesin.enabled = not status */
this.m_archivo.m_finalizarsesin.enabled = status
this.m_informes.enabled = status
this.m_catalogos.enabled = status
this.m_transaccines.enabled = status
this.m_consultas.enabled = status
this.m_mantenimientos.enabled = status
this.m_fisico.enabled = status
this.m_otros.enabled = status
this.m_listados.enabled = status

end subroutine

public subroutine mf_iconos_inventario (readonly boolean status);m_in_padre.m_archivo.m_cerrar.toolbaritemvisible = status
m_in_padre.m_archivo.m_guardar.toolbaritemvisible= status
m_in_padre.m_archivo.m_imprimir.toolbaritemvisible=status
m_in_padre.m_edicion.m_adicionar.toolbaritemvisible=status
m_in_padre.m_edicion.m_insertar.toolbaritemvisible=status
m_in_padre.m_edicion.m_eliminar.toolbaritemvisible=status
m_in_padre.m_edicion.m_primerregistro.toolbaritemvisible=status
m_in_padre.m_edicion.m_registroanterior.toolbaritemvisible=status
m_in_padre.m_edicion.m_siguienteregistro.toolbaritemvisible=status
m_in_padre.m_edicion.m_ultimoregistro.toolbaritemvisible=status
this.m_edicion.enabled = status
this.m_archivo.m_guardar.enabled = status
this.m_archivo.m_imprimir.enabled = status




end subroutine

public subroutine mf_otros_iconos_1 (readonly boolean status);this.m_ventanas.enabled = status
end subroutine

public subroutine mf_otros_iconos_2 (boolean status);this.m_ventanas.m_zoom.enabled = status
end subroutine

public subroutine mf_in_activa_reporte (readonly boolean status);m_in_padre.m_archivo.m_cerrar.toolbaritemvisible = status

m_in_padre.m_archivo.m_imprimir.toolbaritemvisible=status

m_in_padre.m_edicion.m_primerregistro.toolbaritemvisible=status
m_in_padre.m_edicion.m_registroanterior.toolbaritemvisible=status
m_in_padre.m_edicion.m_siguienteregistro.toolbaritemvisible=status
m_in_padre.m_edicion.m_ultimoregistro.toolbaritemvisible=status
this.m_edicion.enabled = status
this.m_ventanas.enabled = status
m_in_padre.m_archivo.m_imprimir.enabled = status
if not status = true then
	return
end if
this.m_archivo.m_guardar.enabled = not status
m_in_padre.m_archivo.m_guardar.toolbaritemvisible= not status
m_in_padre.m_edicion.m_adicionar.toolbaritemvisible= not status
m_in_padre.m_edicion.m_insertar.toolbaritemvisible= not status
m_in_padre.m_edicion.m_eliminar.toolbaritemvisible= not status


end subroutine

