this.toolbarbackcolor = 67108864
this.toolbarhighlightcolor = 134217741
this.toolbargradient = true
this.bitmapgradient = true
this.m_adicionar=create m_adicionar
this.m_insertar=create m_insertar
this.m_eliminar=create m_eliminar
this.m_-3=create m_-3
this.m_primerregistro=create m_primerregistro
this.m_registroanterior=create m_registroanterior
this.m_siguienteregistro=create m_siguienteregistro
this.m_ultimoregistro=create m_ultimoregistro
this.m_-4=create m_-4
this.m_filtrar=create m_filtrar
this.m_sortear=create m_sortear
this.Item[UpperBound(this.Item)+1]=this.m_adicionar
this.Item[UpperBound(this.Item)+1]=this.m_insertar
this.Item[UpperBound(this.Item)+1]=this.m_eliminar
this.Item[UpperBound(this.Item)+1]=this.m_-3
this.Item[UpperBound(this.Item)+1]=this.m_primerregistro
this.Item[UpperBound(this.Item)+1]=this.m_registroanterior
this.Item[UpperBound(this.Item)+1]=this.m_siguienteregistro
this.Item[UpperBound(this.Item)+1]=this.m_ultimoregistro
this.Item[UpperBound(this.Item)+1]=this.m_-4
this.Item[UpperBound(this.Item)+1]=this.m_filtrar
this.Item[UpperBound(this.Item)+1]=this.m_sortear
end on

on m_edicion.destroy
call super::destroy
