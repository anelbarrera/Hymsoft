event clicked;Integer 	li_actualizacion, li_captura
String	ls_titulo_kardex
sqlca.autocommit = true

Select isnull(para_actualizar,1), isnull(para_captura_quilate,0),Isnull(inaparam.para_titulo_kardex,'')
Into   :li_actualizacion, :li_captura,:ls_titulo_kardex
From   inaparam
Where  para_g_financiero =: str.g_financiero and
       para_empresa =: str.empresa ;
	 
if li_captura = 0 then 
	this.m_desglosedeproductos.visible=true
ELSE
	this.m_desglosedeproductos.visible=false
END IF

if ls_titulo_kardex <> '' then
	m_movimientodeproductoskardex.text = ls_titulo_kardex
end if

end event

