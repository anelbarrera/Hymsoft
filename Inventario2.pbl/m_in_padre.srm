this.m_ajustedeexistenciasycostos=create m_ajustedeexistenciasycostos
this.m_ajustedecostos=create m_ajustedecostos
this.m_ajustedeprecios=create m_ajustedeprecios
this.m_ajustedeexistenciasconclavesyco=create m_ajustedeexistenciasconclavesyco
this.m_-18=create m_-18
this.m_informedeajustes=create m_informedeajustes
this.m_actualizacindecostos=create m_actualizacindecostos
this.m_generaciondeajustespreliminares=create m_generaciondeajustespreliminares
this.m_generacionautomaticadeajustes=create m_generacionautomaticadeajustes
