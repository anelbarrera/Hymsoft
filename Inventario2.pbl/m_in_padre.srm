	str_opcion.dwinforme_1    = 'in_dw_valor_inv_espec2_cod'
elseif pos(upper(str.nombre_empresa),'VISION TEX') > 0 then  
	str_opcion.dwinforme_1    = 'in_dw_valor_inv_espec2_vision'
else
	str_opcion.dwinforme_1    = 'in_dw_valor_inv_espec2'
end if

