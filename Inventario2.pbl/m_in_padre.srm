type m_existenciasconcostosypreciossin from menu within m_existencias1
end type

event clicked;Window				lw_child
str_kardex			str_opcion
str_in_informe		str_informe

str_opcion.opcion_menu = 'IEPC2'
str_opcion.titulo_ventana = '(IN) Informes de Existencias con Costos y Precios'
If  pos(upper(str.nombre_empresa),'ELECTROVISION') > 0  Then
	str_opcion.dwinforme_1 = 'in_dw_info_exist_pre_cos_sg_electro'
else
	str_opcion.dwinforme_1 = 'in_dw_info_exist_pre_cos_sg'
end if

str_informe.opcion_menu = str_opcion.opcion_menu

//OpenWithParm(w_in_info_precio,str_informe)

setpointer(hourglass!)

str_informe = Message.PowerObjectParm

If str_informe.precio = 0 Then
	messagebox('Atención','¡No se recuperó el Precio a Desplegar!',StopSign!)
	return
Else
	str_opcion.precio = str_informe.precio
	str_opcion.periodo = str_informe.periodo
End if

setpointer(arrow!)

//WithParm(lw_child,str_opcion,"w_in_historico_general",str.frame,11,original!)

end event

