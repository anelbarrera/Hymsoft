 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" ) COLUMN(NAME=~"faddiari.facd_g_financiero~") COLUMN(NAME=~"faddiari.facd_empresa~") COLUMN(NAME=~"faddiari.facd_no_pedido~") COLUMN(NAME=~"faddiari.facd_pedido_original~") COLUMN(NAME=~"faddiari.facd_linea~") COLUMN(NAME=~"faddiari.facd_ann~") COLUMN(NAME=~"faddiari.facd_producto_servicio~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_descripcion_alterna~") COLUMN(NAME=~"faddiari.facd_cubicaje~") COLUMN(NAME=~"faddiari.facd_peso~") COLUMN(NAME=~"faddiari.facd_unidad_peso~") COLUMN(NAME=~"faddiari.facd_unidad_producto~") COLUMN(NAME=~"faddiari.facd_precio_mayor~") COLUMN(NAME=~"faddiari.facd_precio_menor~") COLUMN(NAME=~"faddiari.facd_bodega~") COLUMN(NAME=~"faddiari.facd_costo_fob~") COLUMN(NAME=~"faddiari.facd_costo_cif~") COLUMN(NAME=~"faddiari.facd_precio_unidad_producto~") COLUMN(NAME=~"faddiari.facd_unidad_venta~") COLUMN(NAME=~"faddiari.facd_cantidad~") COLUMN(NAME=~"faddiari.facd_cantidad_fraccion~") COLUMN(NAME=~"faddiari.facd_monto_total~") COLUMN(NAME=~"faddiari.facd_por_descuento~") COLUMN(NAME=~"faddiari.facd_monto_final~") COLUMN(NAME=~"faddiari.facd_fecha_reg~") COLUMN(NAME=~"faddiari.facd_usuario~") COLUMN(NAME=~"faddiari.facd_supervisor~") COLUMN(NAME=~"faddiari.facd_bultos~") COLUMN(NAME=~"faddiari.facd_pais~") COLUMN(NAME=~"faddiari.facd_ubicacion~") COLUMN(NAME=~"faddiari.facd_cant_devuelta~") COLUMN(NAME=~"faddiari.facd_linea_articulo_dev~")WHERE(    EXP1 =~"( faddiari.facd_g_financiero~"   OP =~"=~"    EXP2 =~":financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( faddiari.facd_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( faddiari.facd_ann~"   OP =~"=~"    EXP2 =~":anio )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( faddiari.facd_producto_servicio~"   OP =~"=~"    EXP2 =~":prod_servicio )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( faddiari.facd_no_pedido~"   OP =~"=~"    EXP2 =~":pedido_factura )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( faddiari.facd_no_pedido~"   OP =~"not like~"    EXP2 =~"'%NC%' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(faddiari.facd_tipo~"   OP =~"=~"    EXP2 =~":tipo)~" ) ) ARG(NAME = ~"financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"anio~" TYPE = number)  ARG(NAME = ~"prod_servicio~" TYPE = string)  ARG(NAME = ~"pedido_factura~" TYPE = string)  ARG(NAME = ~"tipo~" TYPE = string) " arguments=(("financiero", number),("empresa", number),("anio", number),("prod_servicio", string),("pedido_factura", string),("tipo", string)) )
