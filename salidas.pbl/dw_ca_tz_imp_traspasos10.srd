acion~") COMPUTE(NAME=~"' ' oculta_totales~") COMPUTE(NAME=~"' ' oculta_lineas~") COMPUTE(NAME=~"' ' doc_visible~") COMPUTE(NAME=~"'                                                                                                                                                                                                                                                                                                                                                                ' ccontenedor~") COLUMN(NAME=~"tzttraf0.ttra_dep_publico~") COLUMN(NAME=~"tzttraf0.ttra_empresa_deposito_publico~") COMPUTE(NAME=~"'' factura_visible~") COMPUTE(NAME=~"'                                                                                      ' no_facturas~")    JOIN (LEFT=~"tzttraf0.ttra_g_financiero~"    OP =~"=~"RIGHT=~"tzdtraf1.traf_g_financiero~" )    JOIN (LEFT=~"tzttraf0.ttra_empresa~"    OP =~"=~"RIGHT=~"tzdtraf1.traf_empresa~" )    JOIN (LEFT=~"tzttraf0.ttra_ent_sal~"    OP =~"=~"RIGHT=~"tzdtraf1.traf_ent_sal~" )    JOIN (LEFT=~"tzttraf0.ttra_ann~"    OP =~"=~"RIGHT=~"tzdtraf1.traf_ann~" )    JOIN (LEFT=~"tzttraf0.ttra_pedido~"    OP =~"=~"RIGHT=~"tzdtraf1.traf_pedido~" )    JOIN (LEFT=~"tzaparam.para_g_financiero~"    OP =~"=~"RIGHT=~"tzttraf0.ttra_g_financiero~" )    JOIN (LEFT=~"tzaparam.para_empresa~"    OP =~"=~"RIGHT=~"tzttraf0.ttra_empresa~" )    JOIN (LEFT=~"dgmempre.empr_g_financiero~"    OP =~"=~"RIGHT=~"tzttraf0.ttra_g_financiero~" )    JOIN (LEFT=~"dgmempre.empr_empresa~"    OP =~"=~"RIGHT=~"tzttraf0.ttra_empresa~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"tzdtraf1.traf_empaque_um~" )WHERE(    EXP1 =~"( tzdtraf1.traf_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( tzdtraf1.traf_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( tzdtraf1.traf_ent_sal~"   OP =~"=~"    EXP2 =~":ent_sal )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( tzdtraf1.traf_ann~"   OP =~"=~"  