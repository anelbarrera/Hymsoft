 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_estado~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_via~") COLUMN(NAME=~"fatdiari.fact_consignado~") COLUMN(NAME=~"fatdiari.fact_a_nombre_direccion~") COLUMN(NAME=~"fatdiari.fact_despachado~") COLUMN(NAME=~"fatdiari.fact_con_emb_no~") COLUMN(NAME=~"fatdiari.fact_marca~") COLUMN(NAME=~"fatdiari.fact_bultos_total~") COLUMN(NAME=~"fatdiari.fact_peso_total~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~")WHERE(    EXP1 =~"((fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero_fa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa_fa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_cliente~"   OP =~"=~"    EXP2 =~":cliente_fa)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_monto_final~"   OP =~"<>~"    EXP2 =~"0)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_no_pedido~"   OP =~"not like~"    EXP2 =~"'%NC%'))~" ) ) ARG(NAME = ~"g_financiero_fa~" TYPE = number)  ARG(NAME = ~"empresa_fa~" TYPE = number)  ARG(NAME = ~"cliente_fa~" TYPE = number) "  arguments=(("g_financiero_fa", number),("empresa_fa", number),("cliente_fa", number))  sort="fact_ann A fatdiari_fact_fecha A long ( fact_no_pedido ) A " )
