table(column=(type=char(6) update=yes updatewhereclause=yes key=yes name=asub_codigo_subgrupo dbname="crasubgr.asub_codigo_subgrupo" )
 column=(type=char(50) update=yes updatewhereclause=yes name=asub_descrip_subgrupo dbname="crasubgr.asub_descrip_subgrupo" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=asub_codigo_grupo dbname="crasubgr.asub_codigo_grupo" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=asub_cod_div dbname="crasubgr.asub_cod_div" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=asub_g_financiero dbname="crasubgr.asub_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=asub_empresa dbname="crasubgr.asub_empresa" )
 column=(type=char(11) update=yes updatewhereclause=yes name=asub_arancel dbname="crasubgr.asub_arancel" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crasubgr~" ) COLUMN(NAME=~"crasubgr.asub_codigo_subgrupo~") COLUMN(NAME=~"crasubgr.asub_descrip_subgrupo~") COLUMN(NAME=~"crasubgr.asub_codigo_grupo~") COLUMN(NAME=~"crasubgr.asub_cod_div~") COLUMN(NAME=~"crasubgr.asub_g_financiero~") COLUMN(NAME=~"crasubgr.asub_empresa~") COLUMN(NAME=~"crasubgr.asub_arancel~")WHERE(    EXP1 =~"crasubgr.asub_g_financiero~"   OP =~"=~"    EXP2 =~":g_finan~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crasubgr.asub_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crasubgr.asub_cod_div~"   OP =~"=~"    EXP2 =~":division~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"crasubgr.asub_codigo_grupo~"   OP =~"=~"    EXP2 =~":grupo~" ) ) ARG(NAME = ~"g_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"division~" TYPE = string)  ARG(NAME = ~"grupo~" TYPE = string) " update="crasubgr" updatewhere=1 updatekeyinplace=yes arguments=(("g_finan", number),("empresa", number),("division", string),("grupo", string))  sort="asub_descrip_subgrupo A asub_codigo_subgrupo A " )
