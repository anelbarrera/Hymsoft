column(band=detail id=1 alignment="2" tabsequence=20 border="0" color="8388608" x="1033" y="4" height="56" width="384" format="[general]"  name=asub_codigo_subgrupo edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
