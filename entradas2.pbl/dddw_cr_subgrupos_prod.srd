column(band=detail id=7 alignment="0" tabsequence=32766 border="0" color="8388608" x="1609" y="0" height="64" width="247" format="[general]"  name=asub_arancel visible="1~t0" edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
