//objectcomments DropDownDw que trae todas las lineas de productos,  también es utilizado para el mantenimiento de las mismas
release 7;
datawindow(units=0 timer_interval=0 color=16777215 processing=1 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no grid.lines=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=char(3) update=yes updatewhereclause=yes key=yes name=alin_codigo_linea dbname="cralinea.alin_codigo_linea" )
 column=(type=char(50) update=yes updatewhereclause=yes name=alin_descripcion_linea dbname="cralinea.alin_descripcion_linea" )
 column=(type=char(6) update=yes updatewhereclause=yes key=yes name=alin_codigo_subgrupo dbname="cralinea.alin_codigo_subgrupo" )
 column=(type=char(5) update=yes updatewhereclause=yes key=yes name=alin_codigo_grupo dbname="cralinea.alin_codigo_grupo" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=alin_codigo_div dbname="cralinea.alin_codigo_div" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=alin_g_financiero dbname="cralinea.alin_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=alin_empresa dbname="cralinea.alin_empresa" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cralinea~" ) COLUMN(NAME=~"cralinea.alin_codigo_linea~") COLUMN(NAME=~"cralinea.alin_descripcion_linea~") COLUMN(NAME=~"cralinea.alin_codigo_subgrupo~") COLUMN(NAME=~"cralinea.alin_codigo_grupo~") COLUMN(NAME=~"cralinea.alin_codigo_div~") COLUMN(NAME=~"cralinea.alin_g_financiero~") COLUMN(NAME=~"cralinea.alin_empresa~")WHERE(    EXP1 =~"cralinea.alin_g_financiero~"   OP =~"=~"    EXP2 =~":g_finan~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cralinea.alin_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cralinea.alin_codigo_div~"   OP =~"=~"    EXP2 =~":division~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cralinea.alin_codigo_grupo~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cralinea.alin_codigo_subgrupo~"   OP =~"=~"    EXP2 =~":subgrupo~" ) ) ORDER(NAME=~"cralinea.alin_descripcion_linea~" ASC=yes ) ARG(NAME = ~"g_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"division~" TYPE = string)  ARG(NAME = ~"grupo~" TYPE = string)  ARG(NAME = ~"subgrupo~" TYPE = string) " update="cralinea" updatewhere=1 updatekeyinplace=yes arguments=(("g_finan", number),("empresa", number),("division", string),("grupo", string),("subgrupo", string))  sort="alin_descripcion_linea A alin_codigo_linea A " )
text(band=header alignment="0" text="Alin Codigo Linea" border="0" color="0" x="1239" y="4" height="76" width="192"  name=t_1  font.face="Arial" font.height="-12" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=1 alignment="0" tabsequence=20 border="2" color="8388608" x="1239" y="4" height="56" width="192" format="[general]"  name=alin_codigo_linea edit.limit=0 edit.case=any edit.focusrectangle=no edit.autoselect=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=2 alignment="0" tabsequence=10 border="2" color="8388608" x="9" y="4" height="56" width="1221" format="[general]"  name=alin_descripcion_linea edit.limit=50 edit.case=any edit.focusrectangle=no edit.autoselect=yes edit.autohscroll=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="0" expression="righttrim(alin_codigo_linea) + righttrim(alin_codigo_subgrupo) +righttrim(alin_codigo_grupo)    +righttrim(alin_codigo_div)"border="0" color="8388608" x="1440" y="4" height="56" width="219" format="[general]"  name=indice visible="1~t0"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
htmltable(border="1" )
htmlgen(clientevents="1" clientvalidation="1" clientcomputedfields="1" clientformatting="0" clientscriptable="0" generatejavascript="1" )
