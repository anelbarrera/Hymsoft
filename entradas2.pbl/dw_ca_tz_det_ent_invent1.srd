mpresa~" TYPE = number)  ARG(NAME = ~"ent_sal~" TYPE = string)  ARG(NAME = ~"aplicacion~" TYPE = string)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"anio~" TYPE = number) " update="indmovim" updatewhere=0 updatekeyinplace=no arguments=(("g_financiero", number),("empresa", number),("ent_sal", string),("aplicacion", string),("pedido", string),("anio", number)) )
