table(column=(type=decimal(0) update=yes updatewhereclause=yes name=crtconfi_tcof_g_financiero dbname="tcof_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=crtconfi_tcof_empresa dbname="tcof_empresa" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tcof_num_prove dbname="tcof_num_prove" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tcof_anno_oc dbname="tcof_anno_oc" )
 column=(type=char(3) update=yes updatewhereclause=yes name=tcof_cod_tipo_pago dbname="tcof_cod_tipo_pago" )
 column=(type=char(2) update=yes updatewhereclause=yes name=tcof_cod_forma_pago dbname="tcof_cod_forma_pago" )
 column=(type=datetime update=yes updatewhereclause=yes name=tcof_fecha_conf_oc dbname="tcof_fecha_conf_oc" )
 column=(type=datetime update=yes updatewhereclause=yes name=tcof_fecha_llegada dbname="tcof_fecha_llegada" )
 column=(type=char(25) update=yes updatewhereclause=yes name=tcof_representante_prov dbname="tcof_representante_prov" )
 column=(type=long update=yes updatewhereclause=yes name=tcof_estatus_conf_oc dbname="tcof_estatus_conf_oc" values="Activo	1/Cancelado	2/" )
 column=(type=char(255) update=yes updatewhereclause=yes name=tcof_comentario_add dbname="tcof_comentario_add" )
 column=(type=char(2) update=yes updatewhereclause=yes name=tcof_tipo_costo dbname="tcof_tipo_costo" )
 column=(type=char(20) update=yes updatewhereclause=yes name=tcof_num_carta_credito dbname="tcof_num_carta_credito" )
 column=(type=char(20) update=yes updatewhereclause=yes name=crtconfi_tcof_banco dbname="tcof_banco" )
 column=(type=char(1) update=yes updatewhereclause=yes name=crtconfi_tcof_lista_empaque dbname="tcof_lista_empaque" )
 column=(type=datetime update=yes updatewhereclause=yes name=crtconfi_tcof_fecha_llegada_puerto dbname="tcof_fecha_llegada_puerto" )
 column=(type=char(15) update=yes updatewhereclause=yes name=crtconfi_tcof_numero_vapor dbname="tcof_numero_vapor" )
 column=(type=char(40) update=yes updatewhereclause=yes name=crtconfi_tcof_puerto dbname="tcof_puerto" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=crtconfi_tcof_no_bultos dbname="tcof_no_bultos" )
 column=(type=char(2) update=yes updatewhereclause=yes name=tcof_clase_compra dbname="tcof_clase_compra" )
 column=(type=char(5) update=yes updatewhereclause=yes name=tcof_codigo_viaje dbname="tcof_codigo_viaje" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tcof_tipo_conf dbname="tcof_tipo_conf" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=crtconfi_tcof_monto_total_orden dbname="tcof_monto_total_orden" )
 column=(type=char(6) update=yes updatewhereclause=yes name=tcof_tipo_compra dbname="tcof_tipo_compra" )
 column=(type=char(1) update=yes updatewhereclause=yes name=tcof_estado dbname="tcof_estado" )
 column=(type=decimal(2) updatewhereclause=yes name=cant_pase dbname="cant_pase" )
 column=(type=char(5) updatewhereclause=yes name=tcof_contenedor dbname="tcof_contenedor" )
 column=(type=char(25) update=yes updatewhereclause=yes name=tcof_num_conf_oc dbname="tcof_num_conf_oc" )
 retrieve="SELECT 
    a.tcof_g_financiero,   
    a.tcof_empresa,   
    a.tcof_num_prove,   
    a.tcof_anno_oc,   
    a.tcof_cod_tipo_pago,   
    a.tcof_cod_forma_pago,   
    a.tcof_fecha_conf_oc,   
    a.tcof_fecha_llegada,   
    a.tcof_representante_prov,   
    a.tcof_estatus_conf_oc,   
    a.tcof_comentario_add,   
    a.tcof_tipo_costo,   
    a.tcof_num_carta_credito,   
    a.tcof_banco,   
    a.tcof_lista_empaque,   
    a.tcof_fecha_llegada_puerto,   
    a.tcof_numero_vapor,   
    a.tcof_puerto,   
    a.tcof_no_bultos,   
    a.tcof_clase_compra,   
    a.tcof_codigo_viaje,   
    a.tcof_tipo_conf,   
    a.tcof_monto_total_orden,   
    a.tcof_tipo_compra,   
    a.tcof_estado,   
    0.00 AS cant_pase,   
    a.tcof_contenedor,   
    a.tcof_num_conf_oc  
FROM dbo.crtconfi a
CROSS APPLY (
    SELECT 
        MAX(CASE WHEN d.dcof_cantidad_total - d.dcof_cant_facturada >= 0 THEN 1 ELSE 0 END) AS cumple_d1,
        MAX(CASE WHEN d.dcof_cantidad_total <> (
            d.dcof_cant_facturada + 
            CASE 
                WHEN d.dcof_cant1_facturada = 0 THEN 0 
                ELSE d.dcof_cant1_facturada * m.medi_cantidad
            END
        ) THEN 1 ELSE 0 END) AS cumple_d2
    FROM dbo.crdconfi d
    LEFT JOIN dbo.inamedid m 
        ON d.dcof_cant1_facturada <> 0 
       AND m.medi_medida = d.dcof_unidad
    WHERE d.dcof_g_financiero = a.tcof_g_financiero
      AND d.dcof_empresa = a.tcof_empresa
      AND d.dcof_num_conf_oc = a.tcof_num_conf_oc
      AND d.dcof_anno_oc = a.tcof_anno_oc
) v
WHERE a.tcof_g_financiero = :g_financiero
  AND a.tcof_empresa = :empresa
  AND a.tcof_num_prove = :cod_provee
  AND v.cumple_d1 = 1
  AND v.cumple_d2 = 1;" arguments=(("g_financiero", number),("empresa", number),("cod_provee", number))  sort="tcof_fecha_conf_oc D tcof_num_conf_oc A " )
