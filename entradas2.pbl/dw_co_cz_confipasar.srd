 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crdconfi~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"inaparam~" )  TABLE(NAME=~"crtconfi~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"crdconfi.dcof_g_financiero~") COLUMN(NAME=~"crdconfi.dcof_empresa~") COLUMN(NAME=~"crdconfi.dcof_num_ren_confi~") COLUMN(NAME=~"crdconfi.dcof_producto~") COLUMN(NAME=~"crdconfi.dcof_unidad~") COLUMN(NAME=~"crdconfi.dcof_num_oc~") COLUMN(NAME=~"crdconfi.dcof_anno_oc~") COLUMN(NAME=~"crdconfi.dcof_num_ren_oc~") COLUMN(NAME=~"crdconfi.dcof_cantidad_total~") COLUMN(NAME=~"crdconfi.dcof_precio_u~") COLUMN(NAME=~"crdconfi.dcof_estatus_ren~") COLUMN(NAME=~"crdconfi.dcof_bultos~") COLUMN(NAME=~"crdconfi.dcof_peso_neto~") COLUMN(NAME=~"crdconfi.dcof_peso_bruto~") COLUMN(NAME=~"crdconfi.dcof_descripcion~") COLUMN(NAME=~"crdconfi.dcof_tipo_compra~") COLUMN(NAME=~"crdconfi.dcof_tipo_confirmacion~") COLUMN(NAME=~"crdconfi.dcof_cant_facturada~") COLUMN(NAME=~"crdconfi.dcof_cant_pendiente~") COMPUTE(NAME=~"case crdconfi.dcof_cant_pendiente when 0 then crdconfi.dcof_cantidad_total else crdconfi.dcof_cant_pendiente end pasado~") COLUMN(NAME=~"crdconfi.dcof_board~") COLUMN(NAME=~"crdconfi.dcof_color~") COLUMN(NAME=~"crdconfi.dcof_cant1~") COLUMN(NAME=~"crdconfi.dcof_existe_detalle~") COLUMN(NAME=~"crdconfi.dcof_precio1~") COLUMN(NAME=~"crdconfi.dcof_precio2~") COLUMN(NAME=~"crdconfi.dcof_precio3~") COLUMN(NAME=~"crdconfi.dcof_cant_pase~") COMPUTE(NAME=~"' 'desglose~") COLUMN(NAME=~"crdconfi.dcof_cant1_pendiente~") COLUMN(NAME=~"crdconfi.dcof_cant1_facturada~") COMPUTE(NAME=~"case crdconfi.dcof_cant1 when 0 then crdconfi.dcof_cant1 else crdconfi.dcof_cant1_pendiente end fraccion~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"inamedid.medi_descripcion~") COLUMN(NAME=~"crdconfi.dcof_cantidad_recibida~") COLUMN(NAME=~"crdconfi.dcof_cant1_recibida~") COLUMN(NAME=~"crdconfi.dcof_num_conf_oc~") COLUMN(NAME=~"crtconfi.tcof_num_prove~") COLUMN(NAME=~"inmprodu.prod_costos~") COLUMN(NAME=~"crdconfi.dcof_precio_original~")    JOIN (LEFT=~"crdconfi.dcof_unidad~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"crdconfi.dcof_g_financiero~"    OP =~"=~"RIGHT=~"inaparam.para_g_financiero~" )    JOIN (LEFT=~"crdconfi.dcof_empresa~"    OP =~"=~"RIGHT=~"inaparam.para_empresa~" )    JOIN (LEFT=~"crtconfi.tcof_g_financiero~"    OP =~"=~"RIGHT=~"crdconfi.dcof_g_financiero~" )    JOIN (LEFT=~"crtconfi.tcof_empresa~"    OP =~"=~"RIGHT=~"crdconfi.dcof_empresa~" )    JOIN (LEFT=~"crtconfi.tcof_num_conf_oc~"    OP =~"=~"RIGHT=~"crdconfi.dcof_num_conf_oc~" )    JOIN (LEFT=~"crtconfi.tcof_anno_oc~"    OP =~"=~"RIGHT=~"crdconfi.dcof_anno_oc~" )    JOIN (LEFT=~"crdconfi.dcof_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"crdconfi.dcof_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"crdconfi.dcof_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"crdconfi.dcof_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crdconfi.dcof_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crdconfi.dcof_num_conf_oc~"   OP =~"=~"    EXP2 =~":codigo_oc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crdconfi.dcof_anno_oc~"   OP =~"=~"    EXP2 =~":year_oc~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"codigo_oc~" TYPE = string)  ARG(NAME = ~"year_oc~" TYPE = number) " update="crdconfi" updatewhere=0 updatekeyinplace=no arguments=(("g_financiero", number),("empresa", number),("codigo_oc", string),("year_oc", number)) )
