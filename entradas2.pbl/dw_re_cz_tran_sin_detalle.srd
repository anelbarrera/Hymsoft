 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crtordco~" )  TABLE(NAME=~"crdordco~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"crtordco.toco_num_prove~") COLUMN(NAME=~"crtordco.toco_fecha_oc~") COLUMN(NAME=~"crtordco.toco_fecha_entrega~") COLUMN(NAME=~"crdordco.doco_id_referencia~") COLUMN(NAME=~"crdordco.doco_descripcion_ref~") COLUMN(NAME=~"crdordco.doco_unidad~") COLUMN(NAME=~"crdordco.doco_cantidad_total~") COLUMN(NAME=~"crdordco.doco_precio_unitario~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"inamedid.medi_descripcion~") COLUMN(NAME=~"crdordco.doco_precio1~") COLUMN(NAME=~"crdordco.doco_precio2~") COLUMN(NAME=~"crdordco.doco_precio3~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"crdordco.doco_cant1~") COLUMN(NAME=~"crtordco.toco_vapor~") COLUMN(NAME=~"crtordco.toco_factura_proveedor~") COLUMN(NAME=~"crtordco.toco_usuario~") COLUMN(NAME=~"crtordco.toco_fecha_modificacion~") COLUMN(NAME=~"crtordco.toco_codigo_oc~") COLUMN(NAME=~"crdordco.doco_pedido_conf~")    JOIN (LEFT=~"crdordco.doco_unidad~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~"    OUTER1 =~"crdordco.doco_unidad~" )    JOIN (LEFT=~"crtordco.toco_g_financiero~"    OP =~"=~"RIGHT=~"crdordco.doco_g_financiero~" )    JOIN (LEFT=~"crtordco.toco_empresa~"    OP =~"=~"RIGHT=~"crdordco.doco_empresa~" )    JOIN (LEFT=~"crtordco.toco_codigo_oc~"    OP =~"=~"RIGHT=~"crdordco.doco_codigo_oc~" )    JOIN (LEFT=~"crtordco.toco_num_prove~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"crtordco.toco_anno_oc~"    OP =~"=~"RIGHT=~"crdordco.doco_anno_oc~" )WHERE(    EXP1 =~"crtordco.toco_g_financiero~"   OP =~"=~"    EXP2 =~":an_g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crtordco.toco_empresa~"   OP =~"=~"    EXP2 =~":an_empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crtordco.toco_codigo_oc~"   OP =~"=~"    EXP2 =~":as_codigo_oc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crtordco.toco_anno_oc~"   OP =~"=~"    EXP2 =~":an_anno~" ) ) ARG(NAME = ~"an_g_financiero~" TYPE = number)  ARG(NAME = ~"an_empresa~" TYPE = number)  ARG(NAME = ~"as_codigo_oc~" TYPE = string)  ARG(NAME = ~"an_anno~" TYPE = number) " arguments=(("an_g_financiero", number),("an_empresa", number),("as_codigo_oc", string),("an_anno", number)) )
