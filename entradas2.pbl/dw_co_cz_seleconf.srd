 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crtconfi~" ) COLUMN(NAME=~"crtconfi.tcof_g_financiero~") COLUMN(NAME=~"crtconfi.tcof_empresa~") COLUMN(NAME=~"crtconfi.tcof_num_prove~") COLUMN(NAME=~"crtconfi.tcof_anno_oc~") COLUMN(NAME=~"crtconfi.tcof_cod_tipo_pago~") COLUMN(NAME=~"crtconfi.tcof_cod_forma_pago~") COLUMN(NAME=~"crtconfi.tcof_fecha_conf_oc~") COLUMN(NAME=~"crtconfi.tcof_fecha_llegada~") COLUMN(NAME=~"crtconfi.tcof_representante_prov~") COLUMN(NAME=~"crtconfi.tcof_estatus_conf_oc~") COLUMN(NAME=~"crtconfi.tcof_comentario_add~") COLUMN(NAME=~"crtconfi.tcof_tipo_costo~") COLUMN(NAME=~"crtconfi.tcof_num_carta_credito~") COLUMN(NAME=~"crtconfi.tcof_banco~") COLUMN(NAME=~"crtconfi.tcof_lista_empaque~") COLUMN(NAME=~"crtconfi.tcof_fecha_llegada_puerto~") COLUMN(NAME=~"crtconfi.tcof_numero_vapor~") COLUMN(NAME=~"crtconfi.tcof_puerto~") COLUMN(NAME=~"crtconfi.tcof_no_bultos~") COLUMN(NAME=~"crtconfi.tcof_clase_compra~") COLUMN(NAME=~"crtconfi.tcof_codigo_viaje~") COLUMN(NAME=~"crtconfi.tcof_tipo_conf~") COLUMN(NAME=~"crtconfi.tcof_monto_total_orden~") COLUMN(NAME=~"crtconfi.tcof_tipo_compra~") COLUMN(NAME=~"crtconfi.tcof_estado~") COMPUTE(NAME=~"0.00 cant_pase~") COLUMN(NAME=~"crtconfi.tcof_contenedor~") COLUMN(NAME=~"crtconfi.tcof_num_conf_oc~")WHERE(    EXP1 =~"crtconfi.tcof_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crtconfi.tcof_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crtconfi.tcof_num_prove~"   OP =~"=~"    EXP2 =~":proveedor~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"proveedor~" TYPE = number) " update="crtconfi" updatewhere=1 updatekeyinplace=yes arguments=(("g_financiero", number),("empresa", number),("proveedor", number)) )
