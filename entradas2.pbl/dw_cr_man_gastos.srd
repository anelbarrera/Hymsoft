 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crtordco~" ) COLUMN(NAME=~"crtordco.toco_cubicage_total~") COLUMN(NAME=~"crtordco.toco_costo_flete~") COLUMN(NAME=~"crtordco.toco_g_financiero~") COLUMN(NAME=~"crtordco.toco_empresa~") COLUMN(NAME=~"crtordco.toco_codigo_oc~") COLUMN(NAME=~"crtordco.toco_anno_oc~") COLUMN(NAME=~"crtordco.toco_num_suplemento~")WHERE(    EXP1 =~"crtordco.toco_g_financiero~"   OP =~"=~"    EXP2 =~":an_g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crtordco.toco_empresa~"   OP =~"=~"    EXP2 =~":an_empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crtordco.toco_codigo_oc~"   OP =~"=~"    EXP2 =~":as_codigo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crtordco.toco_anno_oc~"   OP =~"=~"    EXP2 =~":an_anno~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crtordco.toco_num_suplemento~"   OP =~"=~"    EXP2 =~":as_suplemento~" ) ) ARG(NAME = ~"an_g_financiero~" TYPE = number)  ARG(NAME = ~"an_empresa~" TYPE = number)  ARG(NAME = ~"as_codigo~" TYPE = string)  ARG(NAME = ~"an_anno~" TYPE = number)  ARG(NAME = ~"as_suplemento~" TYPE = string) " update="crtordco" updatewhere=1 updatekeyinplace=yes arguments=(("an_g_financiero", number),("an_empresa", number),("as_codigo", string),("an_anno", number),("as_suplemento", string)) )
