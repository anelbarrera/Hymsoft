						ma_item.item[li_m].item[li_a].item[li_b].item[li_c].enabled = false
*/			ll_idx++
			FileWrite(ll_file, menu + "~t" +ma_item.item[li_m].item[li_a].item[li_b].item[li_c].tag  + "~t" +str.aplicacion+ "~t" +ma_item.item[li_m].item[li_a].item[li_b].item[li_c].text+ "~t" + string(ll_idx) )
//						Exit
//					END IF
				NEXT			
			NEXT
				FOR ll_i = 1 TO 1
//					IF (ma_item.item[li_m].item[li_a].item[li_b].tag = str.menus[ll_i])  &
//						AND (str.ventanas[ll_i] = ls_ventana) THEN
/*						ma_item.item[li_m].item[li_a].item[li_b].visible = false
						ma_item.item[li_m].item[li_a].item[li_b].enabled = false
*/			ll_idx ++
			FileWrite(ll_file, menu + "~t" +ma_item.item[li_m].item[li_a].item[li_b].tag  + "~t" +str.aplicacion+ "~t" +ma_item.item[li_m].item[li_a].item[li_b].text + "~t" + string(ll_idx))
//						Exit
//					END IF
				NEXT			
		NEXT
				FOR ll_i = 1 TO 1
//messagebox("Herick", ma_item.item[li_m].item[li_a].tag + "~r~n" + str.menus[ll_i] + &
//							"~r~n" + str.ventanas[ll_i] + "~t" + ls_ventana + &
