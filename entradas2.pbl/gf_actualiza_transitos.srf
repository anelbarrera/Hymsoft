//objectcomments  
global type gf_actualiza_transitos from function_object
end type

forward prototypes
global function boolean gf_actualiza_transitos (string as_producto)
end prototypes

global function boolean gf_actualiza_transitos (string as_producto);string ls_error

 sqlca.autocommit = true
	UPDATE inmprodu
	SET prod_cant_transito = 0
	WHERE prod_g_financiero = :str.g_financiero and
			prod_empresa = :str.empresa and
			prod_producto = :as_producto and 
			prod_cant_transito <> 0; 
 		if sqlca.sqlcode = -1 then
			ls_error = sqlca.sqlerrtext
			rollback;
			mensaje("Aviso","Error al Actualizar las Reservas de los Productos Pendientes ",ls_error)
			sqlca.autocommit = true
			return false
		end if

 
/*Actualiza los reservados del producto, procedentes de orden de compra*/
UPDATE inmprodu  
SET 	 prod_cant_transito = convert(decimal(17,6),vi_cr_cantidad_transito.pendiente)
FROM   inmprodu,   
       vi_cr_cantidad_transito
WHERE  ( inmprodu.prod_g_financiero = vi_cr_cantidad_transito.doco_g_financiero ) AND  
       ( inmprodu.prod_empresa      = vi_cr_cantidad_transito.doco_empresa ) AND  
       ( inmprodu.prod_producto     = vi_cr_cantidad_transito.doco_id_referencia )  AND
		 ( inmprodu.prod_g_financiero = :str.g_financiero ) AND
		 ( inmprodu.prod_empresa		  = :str.empresa ) AND
		 ( inmprodu.prod_producto  	 = :as_producto);
		 
		if sqlca.sqlcode = -1 then
			ls_error = sqlca.sqlerrtext
			rollback;
			mensaje("Aviso","Error al Actualizar las Reservas de los Productos Pendientes ",ls_error)
			sqlca.autocommit = true
			return false
		end if

return true

