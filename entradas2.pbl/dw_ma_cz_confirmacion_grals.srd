 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"crtconfi~" ) COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_telefono1~") COLUMN(NAME=~"dgmterce.terc_telefono2~") COLUMN(NAME=~"dgmterce.terc_fax1~") COLUMN(NAME=~"dgmterce.terc_email~") COLUMN(NAME=~"dgmterce.terc_pais~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"crtconfi.tcof_g_financiero~") COLUMN(NAME=~"crtconfi.tcof_empresa~") COLUMN(NAME=~"crtconfi.tcof_anno_oc~") COLUMN(NAME=~"crtconfi.tcof_num_prove~") COLUMN(NAME=~"crtconfi.tcof_cod_tipo_pago~") COLUMN(NAME=~"crtconfi.tcof_cod_forma_pago~") COLUMN(NAME=~"crtconfi.tcof_fecha_conf_oc~") COLUMN(NAME=~"crtconfi.tcof_fecha_llegada~") COLUMN(NAME=~"crtconfi.tcof_representante_prov~") COLUMN(NAME=~"crtconfi.tcof_estatus_conf_oc~") COLUMN(NAME=~"crtconfi.tcof_comentario_add~") COLUMN(NAME=~"crtconfi.tcof_tipo_costo~") COLUMN(NAME=~"crtconfi.tcof_num_carta_credito~") COLUMN(NAME=~"crtconfi.tcof_banco~") COLUMN(NAME=~"crtconfi.tcof_lista_empaque~") COLUMN(NAME=~"crtconfi.tcof_fecha_llegada_puerto~") COLUMN(NAME=~"crtconfi.tcof_numero_vapor~") COLUMN(NAME=~"crtconfi.tcof_puerto~") COLUMN(NAME=~"crtconfi.tcof_no_bultos~") COLUMN(NAME=~"crtconfi.tcof_clase_compra~") COLUMN(NAME=~"crtconfi.tcof_codigo_viaje~") COLUMN(NAME=~"crtconfi.tcof_tipo_conf~") COLUMN(NAME=~"crtconfi.tcof_monto_total_orden~") COLUMN(NAME=~"crtconfi.tcof_tipo_compra~") COLUMN(NAME=~"crtconfi.tcof_marca~") COLUMN(NAME=~"crtconfi.tcof_destino~") COLUMN(NAME=~"crtconfi.tcof_actualizo_cargos~") COLUMN(NAME=~"crtconfi.tcof_estado~") COLUMN(NAME=~"crtconfi.tcof_temporada~") COLUMN(NAME=~"crtconfi.tcof_moneda~") COLUMN(NAME=~"crtconfi.tcof_cambio~") COLUMN(NAME=~"crtconfi.tcof_num_conf_oc~") COLUMN(NAME=~"crtconfi.tcof_fecha_llegada2~") COLUMN(NAME=~"crtconfi.tcof_fecha_llegada3~") COLUMN(NAME=~"crtconfi.tcof_fecha_llegada4~")    JOIN (LEFT=~"crtconfi.tcof_num_prove~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"( ( crtconfi.tcof_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( crtconfi.tcof_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( crtconfi.tcof_num_conf_oc~"   OP =~"=~"    EXP2 =~":numero_oc ) ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(crtconfi.tcof_anno_oc~"   OP =~"=~"    EXP2 =~":anno))~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"numero_oc~" TYPE = string)  ARG(NAME = ~"anno~" TYPE = number) " update="crtconfi" updatewhere=1 updatekeyinplace=yes arguments=(("g_financiero", number),("empresa", number),("numero_oc", string),("anno", number)) )
