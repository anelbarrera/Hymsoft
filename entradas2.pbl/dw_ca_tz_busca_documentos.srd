//objectcomments Datawindow de detalle de entradas de Inventario por Secuencia
release 7;
datawindow(units=0 timer_interval=0 color=12639424 processing=0 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=80 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=decimal(0) updatewhereclause=yes name=tmov_secuencia dbname="intmovim.tmov_secuencia" )
 column=(type=char(30) updatewhereclause=yes name=tmov_descripcion dbname="intmovim.tmov_descripcion" )
 column=(type=datetime updatewhereclause=yes name=tmov_fecha dbname="intmovim.tmov_fecha" initial="set to gf_fecha_serv" )
 column=(type=char(10) updatewhereclause=yes name=tmov_documento dbname="intmovim.tmov_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=tmov_terceros dbname="intmovim.tmov_terceros" )
 column=(type=char(15) updatewhereclause=yes name=tmov_documento_entrada dbname="intmovim.tmov_documento_entrada" initial="empty" )
 column=(type=char(20) updatewhereclause=yes name=tmov_documento_comercial dbname="intmovim.tmov_documento_comercial" )
 column=(type=char(2) updatewhereclause=yes name=tmov_tipo_transaccion dbname="intmovim.tmov_tipo_transaccion" )
 column=(type=decimal(0) updatewhereclause=yes name=tmov_anual dbname="intmovim.tmov_anual" )
 column=(type=char(3) updatewhereclause=yes name=tmov_concepto dbname="intmovim.tmov_concepto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"intmovim~" ) COLUMN(NAME=~"intmovim.tmov_secuencia~") COLUMN(NAME=~"intmovim.tmov_descripcion~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"intmovim.tmov_documento~") COLUMN(NAME=~"intmovim.tmov_terceros~") COLUMN(NAME=~"intmovim.tmov_documento_entrada~") COLUMN(NAME=~"intmovim.tmov_documento_comercial~") COLUMN(NAME=~"intmovim.tmov_tipo_transaccion~") COLUMN(NAME=~"intmovim.tmov_anual~") COLUMN(NAME=~"intmovim.tmov_concepto~")WHERE(    EXP1 =~"intmovim.tmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_buscar~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"intmovim.tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa_buscar~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"intmovim.tmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"intmovim.tmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~" ) ) ARG(NAME = ~"grupo_buscar~" TYPE = number)  ARG(NAME = ~"empresa_buscar~" TYPE = number) " arguments=(("grupo_buscar", number),("empresa_buscar", number))  sort="tmov_anual A tmov_fecha A tmov_documento A " )
