//objectcomments Funcion que trae el logo de la Empresa
global type gf_logo_empr_fondo_tr from function_object
end type

forward prototypes
global function string gf_logo_empr_fondo_tr ()
end prototypes

global function string gf_logo_empr_fondo_tr ();String ls_logote

  SELECT tzaparam.para_foto_grande
	 INTO :ls_logote
    FROM tzaparam  
   WHERE ( tzaparam.para_g_financiero = :str.g_financiero ) AND  
         ( tzaparam.para_empresa = :str.empresa )   ;

Return ls_logote


end function

