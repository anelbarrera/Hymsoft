 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"tzdtraf1~" ) COLUMN(NAME=~"tzdtraf1.traf_arancel~") COLUMN(NAME=~"tzdtraf1.traf_descripcion_prod~") COLUMN(NAME=~"tzdtraf1.traf_cant_bultos~") COLUMN(NAME=~"tzdtraf1.traf_descrip_bulto~") COLUMN(NAME=~"tzdtraf1.traf_empaque_um~") COLUMN(NAME=~"tzdtraf1.traf_cantidad~") COLUMN(NAME=~"tzdtraf1.traf_fraccion~") COLUMN(NAME=~"tzdtraf1.traf_peso_bruto~") COLUMN(NAME=~"tzdtraf1.traf_valor~") COLUMN(NAME=~"tzdtraf1.traf_cubicaje~") COLUMN(NAME=~"tzdtraf1.traf_g_financiero~") COLUMN(NAME=~"tzdtraf1.traf_pedido~") COLUMN(NAME=~"tzdtraf1.traf_ann~") COLUMN(NAME=~"tzdtraf1.traf_linea~") COLUMN(NAME=~"tzdtraf1.traf_empresa~") COLUMN(NAME=~"tzdtraf1.traf_ent_sal~") COLUMN(NAME=~"tzdtraf1.traf_unidad_bulto~") COLUMN(NAME=~"tzdtraf1.traf_producto~")WHERE(    EXP1 =~"( tzdtraf1.traf_g_financiero~"   OP =~"=~"    EXP2 =~":g_fiananciero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( tzdtraf1.traf_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( tzdtraf1.traf_ent_sal~"   OP =~"=~"    EXP2 =~":ent_sal )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( tzdtraf1.traf_ann~"   OP =~"=~"    EXP2 =~":anio )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( tzdtraf1.traf_pedido~"   OP =~"=~"    EXP2 =~":pedido )~" ) ) ARG(NAME = ~"g_fiananciero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"ent_sal~" TYPE = string)  ARG(NAME = ~"anio~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string) " update="tzdtraf1" updatewhere=1 updatekeyinplace=yes arguments=(("g_fiananciero", number),("empresa", number),("ent_sal", string),("anio", number),("pedido", string)) )
