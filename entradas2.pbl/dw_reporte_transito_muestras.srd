 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"muestras_entradas_transito~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"muestras_entradas_transito.mues_linea~") COLUMN(NAME=~"muestras_entradas_transito.mues_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"muestras_entradas_transito.mues_cantidad~") COLUMN(NAME=~"muestras_entradas_transito.mues_costo~") COLUMN(NAME=~"muestras_entradas_transito.mues_costo_pieza~") COLUMN(NAME=~"muestras_entradas_transito.mues_valor~") COLUMN(NAME=~"muestras_entradas_transito.mues_secuencia~") COLUMN(NAME=~"muestras_entradas_transito.mues_ann~") COLUMN(NAME=~"muestras_entradas_transito.mues_transito~") COLUMN(NAME=~"muestras_entradas_transito.mues_fecha~")    JOIN (LEFT=~"muestras_entradas_transito.mues_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"muestras_entradas_transito.mues_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"muestras_entradas_transito.mues_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"muestras_entradas_transito.mues_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"muestras_entradas_transito.mues_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"muestras_entradas_transito.mues_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"muestras_entradas_transito.mues_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number)) )
