table(column=(type=decimal(0) updatewhereclause=yes name=prov_tercero dbname="cpmprove.prov_tercero" dbalias=".prov_tercero" )
 column=(type=char(60) updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" initial="spaces" )
 column=(type=char(10) updatewhereclause=yes name=cpmprove_prov_cod_proveedor dbname="cpmprove.prov_cod_proveedor" dbalias=".prov_cod_proveedor" )
 column=(type=char(20) updatewhereclause=yes name=dgmterce_terc_identificacion dbname="dgmterce.terc_identificacion" dbalias=".terc_identificacion" initial="spaces" )
 column=(type=char(20) updatewhereclause=yes name=cpmprove_prov_mg_cuenta dbname="cpmprove.prov_mg_cuenta" dbalias=".prov_mg_cuenta" )
 column=(type=char(3) updatewhereclause=yes name=cpmprove_prov_clasificacion dbname="cpmprove.prov_clasificacion" dbalias=".prov_clasificacion" )
 column=(type=decimal(0) updatewhereclause=yes name=dgmterce_terc_tercero dbname="dgmterce.terc_tercero" dbalias=".terc_tercero" )
 column=(type=char(10) updatewhereclause=yes name=dgmterce_terc_codigo dbname="dgmterce.terc_codigo" dbalias=".terc_codigo" )
 retrieve="SELECT cpmprove.prov_tercero,   
       dgmterce.terc_descripcion,   
       cpmprove.prov_cod_proveedor,   
       dgmterce.terc_identificacion,   
       cpmprove.prov_mg_cuenta,   
       cpmprove.prov_clasificacion,   
       dgmterce.terc_tercero,   
       dgmterce.terc_codigo  
  FROM dbo.cpmprove,   
       dbo.dgmterce  
 WHERE dgmterce.terc_tercero = cpmprove.prov_tercero
   AND cpmprove.prov_g_financiero = :g_financiero
   AND cpmprove.prov_empresa = :empresa
   AND EXISTS (
       SELECT 1
         FROM dbo.crtconfi crtconfi_a,
              dbo.crdconfi
        WHERE crtconfi_a.tcof_g_financiero = cpmprove.prov_g_financiero
          AND crtconfi_a.tcof_empresa = cpmprove.prov_empresa
          AND crtconfi_a.tcof_num_prove = cpmprove.prov_tercero
          AND crdconfi.dcof_g_financiero = crtconfi_a.tcof_g_financiero
          AND crdconfi.dcof_empresa = crtconfi_a.tcof_empresa
          AND crdconfi.dcof_num_conf_oc = crtconfi_a.tcof_num_conf_oc
          AND crdconfi.dcof_anno_oc = crtconfi_a.tcof_anno_oc
          AND (crdconfi.dcof_cantidad_total - crdconfi.dcof_cant_facturada > 0)
   );" arguments=(("g_financiero", number),("empresa", number))  sort="prov_tercero A " )
