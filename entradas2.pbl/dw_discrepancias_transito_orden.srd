table(column=(type=char(10) updatewhereclause=yes name=crdordco_doco_codigo_oc dbname="crdordco.doco_codigo_oc" )
 column=(type=char(25) updatewhereclause=yes name=crdconfi_dcof_num_conf_oc dbname="crdconfi.dcof_num_conf_oc" )
 column=(type=char(20) updatewhereclause=yes name=crdordco_doco_id_referencia dbname="crdordco.doco_id_referencia" )
 column=(type=char(40) updatewhereclause=yes name=crdordco_doco_descripcion_ref dbname="crdordco.doco_descripcion_ref" )
 column=(type=char(2) updatewhereclause=yes name=crdordco_doco_unidad dbname="crdordco.doco_unidad" )
 column=(type=decimal(6) updatewhereclause=yes name=crdordco_doco_cantidad_total dbname="crdordco.doco_cantidad_total" )
 column=(type=decimal(6) updatewhereclause=yes name=crdconfi_dcof_cantidad_total dbname="crdconfi.dcof_cantidad_total" )
 column=(type=decimal(6) updatewhereclause=yes name=diferencia dbname="diferencia" )
 column=(type=decimal(2) updatewhereclause=yes name=crdordco_doco_precio_unitario dbname="crdordco.doco_precio_unitario" )
 column=(type=decimal(8) updatewhereclause=yes name=valor dbname="valor" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crdconfi~" )  TABLE(NAME=~"crdordco~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"crdordco.doco_codigo_oc~") COLUMN(NAME=~"crdconfi.dcof_num_conf_oc~") COLUMN(NAME=~"crdordco.doco_id_referencia~") COLUMN(NAME=~"crdordco.doco_descripcion_ref~") COLUMN(NAME=~"crdordco.doco_unidad~") COLUMN(NAME=~"crdordco.doco_cantidad_total~") COLUMN(NAME=~"crdconfi.dcof_cantidad_total~") COMPUTE(NAME=~"diferencia = crdordco.doco_cantidad_total - crdconfi.dcof_cantidad_total~") COLUMN(NAME=~"crdordco.doco_precio_unitario~") COMPUTE(NAME=~"valor = round((crdordco.doco_cantidad_total - crdconfi.dcof_cantidad_total) * doco_precio_unitario,2)~")    JOIN (LEFT=~"crdordco.doco_g_financiero~"    OP =~"=~"RIGHT=~"crdconfi.dcof_g_financiero~" )    JOIN (LEFT=~"crdordco.doco_empresa~"    OP =~"=~"RIGHT=~"crdconfi.dcof_empresa~" )    JOIN (LEFT=~"crdordco.doco_pedido_conf~"    OP =~"=~"RIGHT=~"crdconfi.dcof_num_conf_oc~" )    JOIN (LEFT=~"crdordco.doco_linea_conf~"    OP =~"=~"RIGHT=~"crdconfi.dcof_num_ren_confi~" )    JOIN (LEFT=~"crdordco.doco_ann_conf~"    OP =~"=~"RIGHT=~"crdconfi.dcof_anno_oc~" )    JOIN (LEFT=~"crdordco.doco_unidad~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"crdordco.doco_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"crdordco.doco_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"crdordco.doco_codigo_oc~"   OP =~"=~"    EXP2 =~":transito~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"crdordco.doco_ann_conf~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crdconfi.dcof_cantidad_total~"   OP =~"<>~"    EXP2 =~"crdordco.doco_cantidad_total~" ) ) ORDER(NAME=~"crdordco.doco_num_renglon_oc~" ASC=yes ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transito~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("transito", string),("ann", number)) )
