//objectcomments DropDownDw que trae todas los grupos, también es utilizado para el mantenimiento de las mismas
release 7;
datawindow(units=0 timer_interval=0 color=16777215 processing=1 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no grid.lines=0 )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(5) update=yes updatewhereclause=yes key=yes name=agru_codigo_grupo dbname="cragrupo.agru_codigo_grupo" )
 column=(type=char(50) update=yes updatewhereclause=yes name=agru_descripcion_grupo dbname="cragrupo.agru_descripcion_grupo" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=agru_codigo_div dbname="cragrupo.agru_codigo_div" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=agru_g_financiero dbname="cragrupo.agru_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=agru_empresa dbname="cragrupo.agru_empresa" )
 column=(type=char(11) update=yes updatewhereclause=yes name=agru_arancel_default dbname="cragrupo.agru_arancel_default" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cragrupo~" ) COLUMN(NAME=~"cragrupo.agru_codigo_grupo~") COLUMN(NAME=~"cragrupo.agru_descripcion_grupo~") COLUMN(NAME=~"cragrupo.agru_codigo_div~") COLUMN(NAME=~"cragrupo.agru_g_financiero~") COLUMN(NAME=~"cragrupo.agru_empresa~") COLUMN(NAME=~"cragrupo.agru_arancel_default~")WHERE(    EXP1 =~"cragrupo.agru_g_financiero~"   OP =~"=~"    EXP2 =~":g_finan~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cragrupo.agru_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cragrupo.agru_codigo_div~"   OP =~"=~"    EXP2 =~":division~" ) ) ORDER(NAME=~"cragrupo.agru_descripcion_grupo~" ASC=yes ) ARG(NAME = ~"g_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"division~" TYPE = string) " update="cragrupo" updatewhere=1 updatekeyinplace=yes arguments=(("g_finan", number),("empresa", number),("division", string))  sort="agru_descripcion_grupo A agru_codigo_grupo A " )
text(band=header alignment="0" text="Agru Codigo Grupo" border="0" color="0" x="1129" y="4" height="76" width="293"  name=t_1  font.face="Arial" font.height="-12" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=2 alignment="0" tabsequence=10 border="2" color="8388608" x="9" y="4" height="56" width="1111" format="[general]"  name=agru_descripcion_grupo edit.limit=50 edit.case=any edit.focusrectangle=no edit.autoselect=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
column(band=detail id=1 alignment="2" tabsequence=20 border="0" color="8388608" x="1129" y="4" height="56" width="293" format="[general]"  name=agru_codigo_grupo edit.limit=0 edit.case=any edit.autoselect=yes  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
compute(band=detail alignment="0" expression="righttrim(agru_codigo_grupo) + righttrim(agru_codigo_div)"border="0" color="0" x="1431" y="8" height="56" width="101" format=""  name=indice visible="1~t0"  font.face="Arial" font.height="-8" font.weight="400"  font.family="2" font.pitch="2" font.charset="0" background.mode="2" background.color="16777215" )
htmltable(border="1" )
