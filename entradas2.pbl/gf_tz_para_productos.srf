global type gf_tz_para_productos from function_object
end type

forward prototypes
global subroutine gf_tz_para_productos ()
end prototypes

global subroutine gf_tz_para_productos ();  // Carga Datos Iniciales para Una Linea de Detalle que sea Producto 17/04/1998
//:w_tz_fondo.str_param.anio,   
//string is_producto
//  SELECT inmprodu.prod_medida,   
//         inmprodu.prod_cubicaje,   
//         inmprodu.prod_peso,   
//         inmprodu.prod_peso_unidad_medida,
//			inmprodu.prod_empaque,
//			inmprodu.prod_empaque_um,
//			inmprodu.prod_empaque_descripcion
//    INTO :w_tz_fondo.strp.unidad,   
//         :w_tz_fondo.strp.cubicaje,   
//         :w_tz_fondo.strp.peso,   
//  			:w_tz_fondo.strp.unidadp,   
//			:w_tz_fondo.strp.empaque,
//			:w_tz_fondo.strp.emp_um,
//			:w_tz_fondo.strp.em_desc
//   FROM inmprodu  
//   WHERE ( inmprodu.prod_g_financiero = :str.g_financiero ) AND  
//         ( inmprodu.prod_empresa = :str.empresa ) AND  
//         ( inmprodu.prod_producto = :is_producto )  ;

  // Carga Datos Iniciales para Una Linea de Detalle que sea Producto 17/04/1998 			

  SELECT inmprodu.prod_medida,   
         inmprodu.prod_cubicaje,   
         inmprodu.prod_peso,   
         inmprodu.prod_peso_unidad_medida,
			inmprodu.prod_empaque,
			inmprodu.prod_empaque_um,
			inmprodu.prod_empaque_descripcion			
    INTO          
         :w_fa_fondo.strp.unidad,   
         :w_fa_fondo.strp.cubicaje,   
         :w_fa_fondo.strp.peso,   
         :w_fa_fondo.strp.unidadp,   
			:w_fa_fondo.strp.empaque,
			:w_fa_fondo.strp.emp_um,
			:w_fa_fondo.strp.em_desc			
   FROM inmprodu  
   WHERE ( inmprodu.prod_g_financiero = :str.g_financiero ) AND  
         ( inmprodu.prod_empresa = :str.empresa ) AND  
         ( inmprodu.prod_producto = ':is_producto' )  ;
			

end subroutine

