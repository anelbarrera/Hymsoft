table(column=(type=decimal(0) update=yes updatewhereclause=yes name=crdconfi_dcof_g_financiero dbname="crdconfi.dcof_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=crdconfi_dcof_empresa dbname="crdconfi.dcof_empresa" )
 column=(type=long update=yes updatewhereclause=yes name=dcof_num_ren_confi dbname="crdconfi.dcof_num_ren_confi" )
 column=(type=char(20) update=yes updatewhereclause=yes name=dcof_producto dbname="crdconfi.dcof_producto" )
 column=(type=char(2) update=yes updatewhereclause=yes name=dcof_unidad dbname="crdconfi.dcof_unidad" )
 column=(type=char(10) update=yes updatewhereclause=yes name=crdconfi_dcof_num_oc dbname="crdconfi.dcof_num_oc" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=dcof_anno_oc dbname="crdconfi.dcof_anno_oc" )
 column=(type=long update=yes updatewhereclause=yes name=dcof_num_ren_oc dbname="crdconfi.dcof_num_ren_oc" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=dcof_cantidad_total dbname="crdconfi.dcof_cantidad_total" initial=" " )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=dcof_precio_u dbname="crdconfi.dcof_precio_u" )
 column=(type=long update=yes updatewhereclause=yes name=crdconfi_dcof_estatus_ren dbname="crdconfi.dcof_estatus_ren" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=crdconfi_dcof_bultos dbname="crdconfi.dcof_bultos" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=crdconfi_dcof_peso_neto dbname="crdconfi.dcof_peso_neto" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=crdconfi_dcof_peso_bruto dbname="crdconfi.dcof_peso_bruto" )
 column=(type=char(40) update=yes updatewhereclause=yes name=dcof_descripcion dbname="crdconfi.dcof_descripcion" )
 column=(type=long update=yes updatewhereclause=yes name=crdconfi_dcof_tipo_compra dbname="crdconfi.dcof_tipo_compra" )
 column=(type=char(6) update=yes updatewhereclause=yes name=crdconfi_dcof_tipo_confirmacion dbname="crdconfi.dcof_tipo_confirmacion" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=dcof_cant_facturada dbname="crdconfi.dcof_cant_facturada" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=dcof_cant_pendiente dbname="crdconfi.dcof_cant_pendiente" initial=" " )
 column=(type=decimal(6) updatewhereclause=yes name=pasado dbname="pasado" )
 column=(type=char(15) update=yes updatewhereclause=yes name=dcof_board dbname="crdconfi.dcof_board" )
 column=(type=char(5) update=yes updatewhereclause=yes name=dcof_color dbname="crdconfi.dcof_color" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=dcof_cant1 dbname="crdconfi.dcof_cant1" )
 column=(type=long update=yes updatewhereclause=yes name=dcof_existe_detalle dbname="crdconfi.dcof_existe_detalle" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=dcof_precio1 dbname="crdconfi.dcof_precio1" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=dcof_precio2 dbname="crdconfi.dcof_precio2" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=dcof_precio3 dbname="crdconfi.dcof_precio3" )
 column=(type=decimal(6) updatewhereclause=yes name=dcof_cant_pase dbname="crdconfi.dcof_cant_pase" )
 column=(type=char(1) updatewhereclause=yes name=desglose dbname="desglose" initial="N" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=dcof_cant1_pendiente dbname="crdconfi.dcof_cant1_pendiente" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=dcof_cant1_facturada dbname="crdconfi.dcof_cant1_facturada" )
 column=(type=decimal(0) updatewhereclause=yes name=fraccion dbname="fraccion" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" )
 column=(type=char(30) updatewhereclause=yes name=inamedid_medi_descripcion dbname="inamedid.medi_descripcion" )
 column=(type=decimal(6) updatewhereclause=yes name=dcof_cantidad_recibida dbname="crdconfi.dcof_cantidad_recibida" )
 column=(type=decimal(0) updatewhereclause=yes name=dcof_cant1_recibida dbname="crdconfi.dcof_cant1_recibida" )
 column=(type=char(25) update=yes updatewhereclause=yes name=dcof_num_conf_oc dbname="crdconfi.dcof_num_conf_oc" )
 column=(type=decimal(0) updatewhereclause=yes name=tcof_num_prove dbname="crtconfi.tcof_num_prove" )
 column=(type=decimal(6) updatewhereclause=yes name=prod_costos dbname="inmprodu.prod_costos" )
 column=(type=decimal(4) updatewhereclause=yes name=dcof_precio_original dbname="crdconfi.dcof_precio_original" )
 retrieve="  SELECT crdconfi.dcof_g_financiero,   
         crdconfi.dcof_empresa,   
         crdconfi.dcof_num_ren_confi,   
         crdconfi.dcof_producto,   
         crdconfi.dcof_unidad,   
         crdconfi.dcof_num_oc,   
         crdconfi.dcof_anno_oc,   
         crdconfi.dcof_num_ren_oc,   
         crdconfi.dcof_cantidad_total,   
         crdconfi.dcof_precio_u,   
         crdconfi.dcof_estatus_ren,   
         crdconfi.dcof_bultos,   
         crdconfi.dcof_peso_neto,   
         crdconfi.dcof_peso_bruto,   
         crdconfi.dcof_descripcion,   
         crdconfi.dcof_tipo_compra,   
         crdconfi.dcof_tipo_confirmacion,   
         crdconfi.dcof_cant_facturada,   
         crdconfi.dcof_cant_pendiente,   
         case crdconfi.dcof_cant_pendiente when 0 then crdconfi.dcof_cantidad_total  else crdconfi.dcof_cant_pendiente end pasado,   
         crdconfi.dcof_board,   
         crdconfi.dcof_color,   
         crdconfi.dcof_cant1,   
         crdconfi.dcof_existe_detalle,   
         crdconfi.dcof_precio1,   
         crdconfi.dcof_precio2,   
         crdconfi.dcof_precio3,   
         crdconfi.dcof_cant_pase,   
         desglose='N',   
         crdconfi.dcof_cant1_pendiente,   
         crdconfi.dcof_cant1_facturada,   
         case crdconfi.dcof_cant1_pendiente when 0 then crdconfi.dcof_cant1 else crdconfi.dcof_cant1_pendiente end fraccion,   
         inamedid.medi_cantidad,   
         inamedid.medi_descripcion,   
         crdconfi.dcof_cantidad_recibida,   
         crdconfi.dcof_cant1_recibida,   
         crdconfi.dcof_num_conf_oc,   
         crtconfi.tcof_num_prove,   
         inmprodu.prod_costos,   
         crdconfi.dcof_precio_original  
    FROM crdconfi,   
         inamedid,   
         inaparam,   
         crtconfi,   
         inmprodu  
   WHERE ( crdconfi.dcof_unidad = inamedid.medi_medida ) and  
         ( crdconfi.dcof_g_financiero = inaparam.para_g_financiero ) and  
         ( crdconfi.dcof_empresa = inaparam.para_empresa ) and  
         ( crtconfi.tcof_g_financiero = crdconfi.dcof_g_financiero ) and  
         ( crtconfi.tcof_empresa = crdconfi.dcof_empresa ) and  
         ( crtconfi.tcof_num_conf_oc = crdconfi.dcof_num_conf_oc ) and  
         ( crtconfi.tcof_anno_oc = crdconfi.dcof_anno_oc ) and  
         ( crdconfi.dcof_g_financiero = inmprodu.prod_g_financiero ) and  
         ( crdconfi.dcof_empresa = inmprodu.prod_empresa ) and  
         ( crdconfi.dcof_producto = inmprodu.prod_producto ) and  
         ( ( crdconfi.dcof_g_financiero = :g_financiero ) AND  
         ( crdconfi.dcof_empresa = :empresa ) AND  
         ( crdconfi.dcof_num_conf_oc = :codigo_oc ) AND  
         ( crdconfi.dcof_anno_oc = :year_oc ) AND  
         ( crdconfi.dcof_cantidad_total > crdconfi.dcof_cant_facturada ) )    
" arguments=(("g_financiero", number),("empresa", number),("codigo_oc", string),("year_oc", number))  sort="dcof_num_ren_confi A " )
