 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crdconfi~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"crdconfi.dcof_g_financiero~") COLUMN(NAME=~"crdconfi.dcof_empresa~") COLUMN(NAME=~"crdconfi.dcof_num_ren_confi~") COLUMN(NAME=~"crdconfi.dcof_producto~") COLUMN(NAME=~"crdconfi.dcof_unidad~") COLUMN(NAME=~"crdconfi.dcof_num_oc~") COLUMN(NAME=~"crdconfi.dcof_anno_oc~") COLUMN(NAME=~"crdconfi.dcof_num_ren_oc~") COLUMN(NAME=~"crdconfi.dcof_cantidad_total~") COLUMN(NAME=~"crdconfi.dcof_estatus_ren~") COLUMN(NAME=~"crdconfi.dcof_bultos~") COLUMN(NAME=~"crdconfi.dcof_peso_neto~") COLUMN(NAME=~"crdconfi.dcof_peso_bruto~") COLUMN(NAME=~"crdconfi.dcof_descripcion~") COLUMN(NAME=~"crdconfi.dcof_tipo_compra~") COLUMN(NAME=~"crdconfi.dcof_tipo_confirmacion~") COLUMN(NAME=~"crdconfi.dcof_cant_facturada~") COLUMN(NAME=~"crdconfi.dcof_cant_pendiente~") COLUMN(NAME=~"crdconfi.dcof_cant1~") COLUMN(NAME=~"crdconfi.dcof_existe_detalle~") COLUMN(NAME=~"crdconfi.dcof_precio1~") COLUMN(NAME=~"crdconfi.dcof_precio2~") COLUMN(NAME=~"crdconfi.dcof_precio3~") COLUMN(NAME=~"crdconfi.dcof_board~") COLUMN(NAME=~"crdconfi.dcof_color~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_cod_clase_tam~") COLUMN(NAME=~"inmprodu.prod_definicion~") COLUMN(NAME=~"inamedid.medi_cantidad~") COMPUTE(NAME=~"'                                                  'nomcol~") COLUMN(NAME=~"crdconfi.dcof_cant_pase~") COMPUTE(NAME=~"cclibre = ''~") COMPUTE(NAME=~"0.0000 elmont, 0.0000 direct, 0.0000 flete, 0.0000 mylin, 0.0000 pventa, 0.0000 gastos, 0.0000 margen~") COLUMN(NAME=~"crdconfi.dcof_cant1_facturada~") COLUMN(NAME=~"crdconfi.dcof_precio_u~") COLUMN(NAME=~"crdconfi.dcof_fecha_despacho~") COLUMN(NAME=~"crdconfi.dcof_num_conf_oc~")    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"crdconfi.dcof_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"crdconfi.dcof_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"crdconfi.dcof_producto~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"crdconfi.dcof_unidad~" )WHERE(    EXP1 =~"(  crdconfi.dcof_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( crdconfi.dcof_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( crdconfi.dcof_num_conf_oc~"   OP =~"=~"    EXP2 =~":codigo_oc )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( crdconfi.dcof_anno_oc~"   OP =~"=~"    EXP2 =~":year_oc ) ~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"codigo_oc~" TYPE = string)  ARG(NAME = ~"year_oc~" TYPE = number) " update="crdconfi" updatewhere=1 updatekeyinplace=yes arguments=(("g_financiero", number),("empresa", number),("codigo_oc", string),("year_oc", number))  sort="dcof_num_ren_confi A " )
