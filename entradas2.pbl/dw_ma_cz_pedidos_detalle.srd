 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crdordco~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"crdordco.doco_g_financiero~") COLUMN(NAME=~"crdordco.doco_empresa~") COLUMN(NAME=~"crdordco.doco_codigo_oc~") COLUMN(NAME=~"crdordco.doco_anno_oc~") COLUMN(NAME=~"crdordco.doco_num_renglon_oc~") COLUMN(NAME=~"crdordco.doco_tipo_compra~") COLUMN(NAME=~"crdordco.doco_id_referencia~") COLUMN(NAME=~"crdordco.doco_descripcion_ref~") COLUMN(NAME=~"crdordco.doco_unidad~") COLUMN(NAME=~"crdordco.doco_cantidad_total~") COLUMN(NAME=~"crdordco.doco_estatus~") COLUMN(NAME=~"crdordco.doco_impreso~") COLUMN(NAME=~"crdordco.doco_c_costo~") COMPUTE(NAME=~"clibre = ''~") COLUMN(NAME=~"crdordco.doco_dias~") COLUMN(NAME=~"crdordco.doco_forma_pago~") COLUMN(NAME=~"crdordco.doco_justificacion~") COLUMN(NAME=~"crdordco.doco_tipo_oc~") COLUMN(NAME=~"crdordco.doco_cant_facturada~") COLUMN(NAME=~"crdordco.doco_num_suplemento~") COLUMN(NAME=~"crdordco.doco_precio_actual~") COLUMN(NAME=~"crdordco.doco_cantidad_actual~") COLUMN(NAME=~"crdordco.doco_conf_entrada~") COLUMN(NAME=~"crdordco.doco_board~") COLUMN(NAME=~"crdordco.doco_color~") COLUMN(NAME=~"crdordco.doco_cant1~") COLUMN(NAME=~"crdordco.doco_precio1~") COLUMN(NAME=~"crdordco.doco_precio2~") COLUMN(NAME=~"crdordco.doco_precio3~") COMPUTE(NAME=~"0.0000 elmont, 0.0000 direct, 0.0000 flete, 0.0000 mylin, 0.0000 pventa, 0.0000 gastos, 0.0000 margen~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"crdordco.doco_linea_conf~") COLUMN(NAME=~"crdordco.doco_precio_unitario~") COLUMN(NAME=~"crdordco.doco_bultos~") COLUMN(NAME=~"crdordco.doco_peso~") COLUMN(NAME=~"crdordco.doco_ann_conf~") COLUMN(NAME=~"crdordco.doco_pedido_conf~") COLUMN(NAME=~"crdordco.doco_precio_original~")    JOIN (LEFT=~"crdordco.doco_unidad~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"crdordco.doco_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crdordco.doco_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crdordco.doco_codigo_oc~"   OP =~"=~"    EXP2 =~":codigo_oc~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"crdordco.doco_anno_oc~"   OP =~"=~"    EXP2 =~":year_oc~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"codigo_oc~" TYPE = string)  ARG(NAME = ~"year_oc~" TYPE = number) " update="crdordco" updatewhere=1 updatekeyinplace=yes arguments=(("g_financiero", number),("empresa", number),("codigo_oc", string),("year_oc", number))  sort="doco_num_renglon_oc A " )
