detail(height=64 color="536870912" )
table(column=(type=char(3) update=yes updatewhereclause=yes key=yes name=adiv_codigo_div dbname="cradivis.adiv_codigo_div" )
 column=(type=char(50) update=yes updatewhereclause=yes name=adiv_nombre_div dbname="cradivis.adiv_nombre_div" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=adiv_g_financiero dbname="cradivis.adiv_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=adiv_empresa dbname="cradivis.adiv_empresa" )
 column=(type=long update=yes updatewhereclause=yes name=adiv_se_excluye dbname="cradivis.adiv_se_excluye" initial="0" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cradivis~" ) COLUMN(NAME=~"cradivis.adiv_codigo_div~") COLUMN(NAME=~"cradivis.adiv_nombre_div~") COLUMN(NAME=~"cradivis.adiv_g_financiero~") COLUMN(NAME=~"cradivis.adiv_empresa~") COLUMN(NAME=~"cradivis.adiv_se_excluye~")WHERE(    EXP1 =~"cradivis.adiv_g_financiero~"   OP =~"=~"    EXP2 =~":g_finan~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cradivis.adiv_empresa~"   OP =~"=~"    EXP2 =~":empresa~" ) ) ORDER(NAME=~"cradivis.adiv_nombre_div~" ASC=yes ) ARG(NAME = ~"g_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " update="cradivis" updatewhere=1 updatekeyinplace=yes arguments=(("g_finan", number),("empresa", number))  sort="adiv_nombre_div A adiv_codigo_div A " )
