global type gf_tz_hide_item from function_object
end type

forward prototypes
global subroutine gf_tz_hide_item ()
end prototypes

global subroutine gf_tz_hide_item ();If str.aplicacion <> "TZ" Then Return

m_fa_principal.m_edicin.m_insertar.visible = False
m_fa_principal.m_edicin.m_insertar.ToolBarItemVisible = False
