COMPUTE(NAME=~"'               ' bultos~") COMPUTE(NAME=~"0 linea_subt~") COLUMN(NAME=~"vi_factura1.terc_identificacion~") COLUMN(NAME=~"vi_factura1.fact_factura_de_bodega~") COLUMN(NAME=~"vi_factura1.facd_index~") COLUMN(NAME=~"vi_factura1.acta_descripcion~") COMPUTE(NAME=~"0 grupo, vi_factura1.facd_monto_final tot_por_registro~") COLUMN(NAME=~"vi_factura1.medi_abre~") COLUMN(NAME=~"vi_factura1.facd_bulto_inicio~") COLUMN(NAME=~"vi_factura1.facd_bulto_fin~") COLUMN(NAME=~"vi_factura1.prod_producto_dos~") COLUMN(NAME=~"vi_factura1.prod_gramaje~") COLUMN(NAME=~"vi_factura1.facd_precio_original~") COLUMN(NAME=~"vi_factura1.facd_precio_recargo~") COLUMN(NAME=~"vi_factura1.medi_tipo_medida~") COLUMN(NAME=~"vi_factura1.facd_g_financiero~") COLUMN(NAME=~"vi_factura1.fact_metal_pendiente~") COLUMN(NAME=~"vi_factura1.fact_factura_cierre~") COLUMN(NAME=~"vi_factura1.fact_precio_onza~") COLUMN(NAME=~"vi_factura1.fact_fix~") COLUMN(NAME=~"vi_factura1.fact_fecha_despacho~") COLUMN(NAME=~"vi_factura1.fact_pasaporte~") COLUMN(NAME=~"vi_factura1.fact_linea_aerea~") COLUMN(NAME=~"vi_factura1.fact_usuario~") COLUMN(NAME=~"vi_factura1.fact_factura_trafico~") COMPUTE(NAME=~"0 tipo_medida~") COMPUTE(NAME=~"0.00 monto_final~") COLUMN(NAME=~"vi_factura1.fact_fecha_impresion~") COLUMN(NAME=~"vi_factura1.fact_detalle_liquidacion~") COMPUTE(NAME=~"'                    ' prod_original~") COMPUTE(NAME=~"0.00 costo_total~") COLUMN(NAME=~"vi_factura1.facd_descripcion_alterna~") COMPUTE(NAME=~"case when medi_tipo_medida = 10 then 0 else facd_cantidad end cantidad~") COMPUTE(NAME=~"case when medi_tipo_medida <> 10 then 0 else facd_cantidad end cantidad_pz~") COLUMN(NAME=~"vi_factura1.empr_direccion~") COLUMN(NAME=~"vi_factura1.empr_apartado_postal~") COLUMN(NAME=~"vi_factura1.empr_telefono1~") COLUMN(NAME=~"vi_factura1.empr_fax1~") COLUMN(NAME=~"vi_factura1.empr_e_mail~") COLUMN(NAME=~"vi_factura1.empr_ficha~") COLUMN(NAME=~"vi_factura1.empr_rollo~") COLUMN(NAME=~"vi_factura1.empr_imagen~") COLUMN(NAME=~"vi_factura1.empr_dijito_verificador~")WHERE(    EXP1 =~"((vi_factura1.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_finan )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_ann~"   OP =~"=~"    EXP2 =~":an )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.fact_tipo~"   OP =~"=~"    EXP2 =~":tipo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factura1.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'))~" ) ) ARG(NAME = ~"grupo_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number)  ARG(NAME = ~"tipo~" TYPE = string) " arguments=(("grupo_finan", number),("empresa", number),("pedido", string),("an", number),("tipo", string))  sort="facd_index A " )
