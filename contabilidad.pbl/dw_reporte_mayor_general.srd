 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coddiari~" )  TABLE(NAME=~"cotdiari~" ) COLUMN(NAME=~"coddiari.ddia_monto~") COLUMN(NAME=~"coddiari.ddia_mg_cuenta~") COLUMN(NAME=~"cotdiari.diar_no_documento~") COLUMN(NAME=~"cotdiari.diar_no_referencia~") COLUMN(NAME=~"cotdiari.diar_fecha_transaccion~") COLUMN(NAME=~"cotdiari.diar_descripcion~") COLUMN(NAME=~"coddiari.ddia_naturaleza~") COLUMN(NAME=~"coddiari.ddia_g_financiero~") COLUMN(NAME=~"coddiari.ddia_empresa~") COLUMN(NAME=~"cotdiari.diar_ann~") COLUMN(NAME=~"coddiari.ddia_aplicacion_mg~") COLUMN(NAME=~"coddiari.ddia_transito~") COLUMN(NAME=~"cotdiari.diar_tipo_transaccion~") COLUMN(NAME=~"cotdiari.diar_sub_trans~") COLUMN(NAME=~"coddiari.ddia_tercero~") COLUMN(NAME=~"cotdiari.diar_nombre~") COLUMN(NAME=~"cotdiari.diar_banco_cuenta~") COLUMN(NAME=~"coddiari.ddia_linea~") COLUMN(NAME=~"coddiari.ddia_usuario_cambio_cuenta~") COLUMN(NAME=~"coddiari.ddia_fecha_cambio_cuenta~")    JOIN (LEFT=~"cotdiari.diar_g_financiero~"    OP =~"=~"RIGHT=~"coddiari.ddia_g_financiero~"    OUTER1 =~"cotdiari.diar_g_financiero~" )    JOIN (LEFT=~"cotdiari.diar_empresa~"    OP =~"=~"RIGHT=~"coddiari.ddia_empresa~"    OUTER1 =~"cotdiari.diar_empresa~" )    JOIN (LEFT=~"cotdiari.diar_aplicacion_mg~"    OP =~"=~"RIGHT=~"coddiari.ddia_aplicacion_mg~"    OUTER1 =~"cotdiari.diar_aplicacion_mg~" )    JOIN (LEFT=~"cotdiari.diar_tipo_transaccion~"    OP =~"=~"RIGHT=~"coddiari.ddia_tipo_transaccion~"    OUTER1 =~"cotdiari.diar_tipo_transaccion~" )    JOIN (LEFT=~"cotdiari.diar_sub_trans~"    OP =~"=~"RIGHT=~"coddiari.ddia_sub_trans~"    OUTER1 =~"cotdiari.diar_sub_trans~" )    JOIN (LEFT=~"cotdiari.diar_no_documento~"    OP =~"=~"RIGHT=~"coddiari.ddia_no_documento~"    OUTER1 =~"cotdiari.diar_no_documento~" )    JOIN (LEFT=~"cotdiari.diar_no_referencia~"    OP =~"=~"RIGHT=~"coddiari.ddia_no_referencia~"    OUTER1 =~"cotdiari.diar_no_referencia~" )    JOIN (LEFT=~"cotdiari.diar_banco_cuenta~"    OP =~"=~"RIGHT=~"coddiari.ddia_banco_cuenta~"    OUTER1 =~"cotdiari.diar_banco_cuenta~" )    JOIN (LEFT=~"cotdiari.diar_ann~"    OP =~"=~"RIGHT=~"coddiari.ddia_ann~"    OUTER1 =~"cotdiari.diar_ann~" )WHERE(    EXP1 =~"( ( cotdiari.diar_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cotdiari.diar_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cotdiari.diar_fecha_transaccion~"   OP =~">=~"    EXP2 =~":fecha1 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cotdiari.diar_fecha_transaccion~"   OP =~"<=~"    EXP2 =~":fecha2 ) )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("fecha1", datetime),("fecha2", datetime))  sort="diar_fecha_transaccion A cotdiari_diar_tipo_transaccion A long(diar_no_documento) A cotdiari_diar_no_referencia A coddiari_ddia_aplicacion_mg A coddiari_ddia_linea A " )
