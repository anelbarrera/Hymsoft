 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"dgmserie~" )  TABLE(NAME=~"dgmsubse~" )  TABLE(NAME=~"coddiari~" )  TABLE(NAME=~"dgmplanc~" )  TABLE(NAME=~"cotdiari~" ) COLUMN(NAME=~"dgmserie.mser_descripcion~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_direccion~") COLUMN(NAME=~"dgmempre.empr_telefono1~") COLUMN(NAME=~"dgmempre.empr_telefono2~") COLUMN(NAME=~"dgmempre.empr_fax1~") COLUMN(NAME=~"dgmempre.empr_e_mail~") COLUMN(NAME=~"dgmempre.empr_logo_t~") COLUMN(NAME=~"coddiari.ddia_linea~") COLUMN(NAME=~"coddiari.ddia_mg_cuenta~") COLUMN(NAME=~"coddiari.ddia_monto~") COLUMN(NAME=~"coddiari.ddia_naturaleza~") COLUMN(NAME=~"dgmplanc.mg_descripcion~") COLUMN(NAME=~"cotdiari.diar_no_documento~") COLUMN(NAME=~"cotdiari.diar_no_referencia~") COLUMN(NAME=~"cotdiari.diar_ann~") COLUMN(NAME=~"cotdiari.diar_fecha_transaccion~") COLUMN(NAME=~"cotdiari.diar_descripcion~") COLUMN(NAME=~"cotdiari.diar_id~") COLUMN(NAME=~"cotdiari.diar_monto~") COLUMN(NAME=~"cotdiari.diar_nombre~") COLUMN(NAME=~"cotdiari.diar_aplicacion_mg~")    JOIN (LEFT=~"dgmplanc.mg_g_financiero~"    OP =~"=~"RIGHT=~"coddiari.ddia_g_financiero~" )    JOIN (LEFT=~"dgmplanc.mg_empresa~"    OP =~"=~"RIGHT=~"coddiari.ddia_empresa~" )    JOIN (LEFT=~"dgmplanc.mg_cuenta~"    OP =~"=~"RIGHT=~"coddiari.ddia_mg_cuenta~" )    JOIN (LEFT=~"cotdiari.diar_g_financiero~"    OP =~"=~"RIGHT=~"coddiari.ddia_g_financiero~" )    JOIN (LEFT=~"cotdiari.diar_empresa~"    OP =~"=~"RIGHT=~"coddiari.ddia_empresa~" )    JOIN (LEFT=~"cotdiari.diar_aplicacion_mg~"    OP =~"=~"RIGHT=~"coddiari.ddia_aplicacion_mg~" )    JOIN (LEFT=~"cotdiari.diar_tipo_transaccion~"    OP =~"=~"RIGHT=~"coddiari.ddia_tipo_transaccion~" )    JOIN (LEFT=~"cotdiari.diar_sub_trans~"    OP =~"=~"RIGHT=~"coddiari.ddia_sub_trans~" )    JOIN (LEFT=~"cotdiari.diar_no_documento~"    OP =~"=~"RIGHT=~"coddiari.ddia_no_documento~" )    JOIN (LEFT=~"cotdiari.diar_no_referencia~"    OP =~"=~"RIGHT=~"coddiari.ddia_no_referencia~" )    JOIN (LEFT=~"cotdiari.diar_banco_cuenta~"    OP =~"=~"RIGHT=~"coddiari.ddia_banco_cuenta~" )    JOIN (LEFT=~"cotdiari.diar_ann~"    OP =~"=~"RIGHT=~"coddiari.ddia_ann~" )    JOIN (LEFT=~"cotdiari.diar_g_financiero~"    OP =~"=~"RIGHT=~"dgmserie.mser_g_financiero~" )    JOIN (LEFT=~"cotdiari.diar_empresa~"    OP =~"=~"RIGHT=~"dgmserie.mser_empresa~" )    JOIN (LEFT=~"cotdiari.diar_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmserie.mser_tipo_transaccion~" )    JOIN (LEFT=~"cotdiari.diar_g_financiero~"    OP =~"=~"RIGHT=~"dgmsubse.subs_g_financiero~" )    JOIN (LEFT=~"cotdiari.diar_empresa~"    OP =~"=~"RIGHT=~"dgmsubse.subs_empresa~" )    JOIN (LEFT=~"cotdiari.diar_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmsubse.subs_transaccion~" )    JOIN (LEFT=~"cotdiari.diar_sub_trans~"    OP =~"=~"RIGHT=~"dgmsubse.subs_sub_trans~" )    JOIN (LEFT=~"cotdiari.diar_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"cotdiari.diar_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )WHERE(    EXP1 =~"coddiari.ddia_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_aplicacion_mg~"   OP =~"=~"    EXP2 =~":app~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_tipo_transaccion~"   OP =~"=~"    EXP2 =~":transaccion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_no_documento~"   OP =~"=~"    EXP2 =~":docu~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_ann~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cotdiari.diar_no_referencia~"   OP =~"=~"    EXP2 =~":referencia~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"docu~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"app~" TYPE = string)  ARG(NAME = ~"referencia~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("transaccion", string),("docu", string),("ann", number),("app", string),("referencia", string)) )
