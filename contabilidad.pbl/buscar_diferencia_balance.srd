 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"comayor~" )  TABLE(NAME=~"dganivec~" )  TABLE(NAME=~"dgmplanc~" ) COLUMN(NAME=~"comayor.mayo_ann~") COLUMN(NAME=~"comayor.mayo_cuenta~") COLUMN(NAME=~"dgmplanc.mg_descripcion~") COLUMN(NAME=~"dgmplanc.mg_nivel~") COLUMN(NAME=~"dganivec.nive_cada_nivel~") COLUMN(NAME=~"dgmplanc.mg_tipo_cuenta~") COMPUTE(NAME=~"case :mes when 1 then mayo_ene_inicial when 2 then mayo_feb_inicial when 3 then mayo_mar_inicial when 4 then mayo_abr_inicial when 5 then mayo_may_inicial when 6 then mayo_jun_inicial when 7 then mayo_jul_inicial when 8 then mayo_ago_inicial when 9 then mayo_sep_inicial when 10 then mayo_oct_inicial when 11 then mayo_nov_inicial when 12 then mayo_dic_inicial end saldo_inicial~") COMPUTE(NAME=~"case :mes when 1 then mayo_ene_db when 2 then mayo_feb_db when 3 then mayo_mar_db when 4 then mayo_abr_db when 5 then mayo_may_db when 6 then mayo_jun_db when 7 then mayo_jul_db when 8 then mayo_ago_db when 9 then mayo_sep_db when 10 then mayo_oct_db when 11 then mayo_nov_db when 12 then mayo_dic_db end debito~") COMPUTE(NAME=~"case :mes when 1 then mayo_ene_cr when 2 then mayo_feb_cr when 3 then mayo_mar_cr when 4 then mayo_abr_cr when 5 then mayo_may_cr when 6 then mayo_jun_cr when 7 then mayo_jul_cr when 8 then mayo_ago_cr when 9 then mayo_sep_cr when 10 then mayo_oct_cr when 11 then mayo_nov_cr when 12 then mayo_dic_cr end credito~")    JOIN (LEFT=~"comayor.mayo_g_financiero~"    OP =~"=~"RIGHT=~"dgmplanc.mg_g_financiero~" )    JOIN (LEFT=~"comayor.mayo_empresa~"    OP =~"=~"RIGHT=~"dgmplanc.mg_empresa~" )    JOIN (LEFT=~"comayor.mayo_cuenta~"    OP =~"=~"RIGHT=~"dgmplanc.mg_cuenta~" )    JOIN (LEFT=~"dgmplanc.mg_g_financiero~"    OP =~"=~"RIGHT=~"dganivec.nive_g_financiero~" )    JOIN (LEFT=~"dgmplanc.mg_empresa~"    OP =~"=~"RIGHT=~"dganivec.nive_empresa~" )    JOIN (LEFT=~"dgmplanc.mg_nivel~"    OP =~"=~"RIGHT=~"dganivec.nive_no_nivel~" )WHERE(    EXP1 =~"comayor.mayo_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"comayor.mayo_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"comayor.mayo_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"mes~" TYPE = number) " filter="mid( mayo_cuenta,1,3)  = '110'" arguments=(("grupo", number),("empresa", number),("ann", number),("mes", number)) )
