table(column=(type=decimal(2) updatewhereclause=yes name=coddiari_ddia_monto dbname="coddiari.ddia_monto" )
 column=(type=char(20) updatewhereclause=yes name=ddia_mg_cuenta dbname="coddiari.ddia_mg_cuenta" )
 column=(type=char(20) updatewhereclause=yes name=diar_no_documento dbname="cotdiari.diar_no_documento" )
 column=(type=char(75) updatewhereclause=yes name=dgmplanc_mg_descripcion dbname="dgmplanc.mg_descripcion" )
 column=(type=datetime updatewhereclause=yes name=diar_fecha_transaccion dbname="cotdiari.diar_fecha_transaccion" )
 column=(type=char(32766) updatewhereclause=yes name=cotdiari_diar_descripcion dbname="cotdiari.diar_descripcion" )
 column=(type=char(1) updatewhereclause=yes name=coddiari_ddia_naturaleza dbname="coddiari.ddia_naturaleza" )
 column=(type=decimal(0) updatewhereclause=yes name=coddiari_ddia_g_financiero dbname="coddiari.ddia_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=coddiari_ddia_empresa dbname="coddiari.ddia_empresa" )
 column=(type=decimal(0) updatewhereclause=yes name=cotdiari_diar_ann dbname="cotdiari.diar_ann" )
 column=(type=char(2) updatewhereclause=yes name=coddiari_ddia_aplicacion_mg dbname="coddiari.ddia_aplicacion_mg" )
 column=(type=char(20) updatewhereclause=yes name=coddiari_ddia_transito dbname="coddiari.ddia_transito" )
 column=(type=char(2) updatewhereclause=yes name=cotdiari_diar_tipo_transaccion dbname="cotdiari.diar_tipo_transaccion" )
 column=(type=char(3) updatewhereclause=yes name=cotdiari_diar_sub_trans dbname="cotdiari.diar_sub_trans" )
 column=(type=decimal(0) updatewhereclause=yes name=coddiari_ddia_tercero dbname="coddiari.ddia_tercero" )
 column=(type=char(50) updatewhereclause=yes name=cotdiari_diar_nombre dbname="cotdiari.diar_nombre" )
 column=(type=char(10) updatewhereclause=yes name=cotdiari_diar_banco_cuenta dbname="cotdiari.diar_banco_cuenta" )
 column=(type=char(10) updatewhereclause=yes name=cotdiari_diar_no_referencia dbname="cotdiari.diar_no_referencia" )
 column=(type=char(1) updatewhereclause=yes name=mg_naturaleza dbname="dgmplanc.mg_naturaleza" )
 column=(type=long updatewhereclause=yes name=ok dbname="ok" values="	1/	0" )
 retrieve="  SELECT coddiari.ddia_monto,   
         coddiari.ddia_mg_cuenta,   
         cotdiari.diar_no_documento,   
         dgmplanc.mg_descripcion,   
         cotdiari.diar_fecha_transaccion,   
         cotdiari.diar_descripcion,   
         coddiari.ddia_naturaleza,   
         coddiari.ddia_g_financiero,   
         coddiari.ddia_empresa,   
         cotdiari.diar_ann,   
         coddiari.ddia_aplicacion_mg,   
         coddiari.ddia_transito,   
         cotdiari.diar_tipo_transaccion,   
         cotdiari.diar_sub_trans,   
         coddiari.ddia_tercero,   
         cotdiari.diar_nombre,   
         cotdiari.diar_banco_cuenta,   
         cotdiari.diar_no_referencia,   
         dgmplanc.mg_naturaleza,   
         0 as ok  
    FROM coddiari,   
         cotdiari,   
         dgmplanc  
   WHERE ( coddiari.ddia_g_financiero = cotdiari.diar_g_financiero ) and  
         ( coddiari.ddia_empresa = cotdiari.diar_empresa ) and  
         ( coddiari.ddia_aplicacion_mg = cotdiari.diar_aplicacion_mg ) and  
         ( coddiari.ddia_banco_cuenta = cotdiari.diar_banco_cuenta ) and  
         ( coddiari.ddia_no_documento = cotdiari.diar_no_documento ) and  
         ( coddiari.ddia_no_referencia = cotdiari.diar_no_referencia ) and  
         ( coddiari.ddia_ann = cotdiari.diar_ann ) and  
         ( coddiari.ddia_tipo_transaccion = cotdiari.diar_tipo_transaccion ) and  
         ( coddiari.ddia_sub_trans = cotdiari.diar_sub_trans ) and  
         ( dgmplanc.mg_g_financiero = coddiari.ddia_g_financiero ) and  
         ( dgmplanc.mg_empresa = coddiari.ddia_empresa ) and  
         ( dgmplanc.mg_cuenta = coddiari.ddia_mg_cuenta ) and  
         ( ( coddiari.ddia_g_financiero = :grupo ) AND  
         ( coddiari.ddia_empresa = :empresa ) AND  
         ( substring(coddiari.ddia_mg_cuenta,1,20) >= substring(:cuenta1,1,20) ) AND  
         ( substring(coddiari.ddia_mg_cuenta,1,20) <= substring(:cuenta2,1,20) ) AND  
         ( cotdiari.diar_fecha_transaccion >= :fecha1 ) AND  
         ( cotdiari.diar_fecha_transaccion <= :fecha2 ) )    
" arguments=(("grupo", number),("empresa", number),("cuenta1", string),("cuenta2", string),("fecha1", datetime),("fecha2", datetime))  sort="ddia_mg_cuenta A diar_fecha_transaccion A long(diar_no_documento) A " )
