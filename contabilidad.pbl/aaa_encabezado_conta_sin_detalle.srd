 column=(type=decimal(2) updatewhereclause=yes name=cotdiari_diar_monto dbname="cotdiari.diar_monto" dbalias=".diar_monto" )
 column=(type=char(20) updatewhereclause=yes name=coddiari_ddia_no_documento dbname="coddiari.ddia_no_documento" dbalias=".ddia_no_documento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coddiari~" )  TABLE(NAME=~"cotdiari~" ) COLUMN(NAME=~"cotdiari.diar_aplicacion_mg~") COLUMN(NAME=~"cotdiari.diar_tipo_transaccion~") COLUMN(NAME=~"cotdiari.diar_no_documento~") COLUMN(NAME=~"cotdiari.diar_no_referencia~") COLUMN(NAME=~"cotdiari.diar_banco_cuenta~") COLUMN(NAME=~"cotdiari.diar_fecha_transaccion~") COLUMN(NAME=~"cotdiari.diar_descripcion~") COLUMN(NAME=~"cotdiari.diar_monto~") COLUMN(NAME=~"coddiari.ddia_no_documento~")    JOIN (LEFT=~"cotdiari.diar_g_financiero~"    OP =~"=~"RIGHT=~"coddiari.ddia_g_financiero~"    OUTER1 =~"cotdiari.diar_g_financiero~" )    JOIN (LEFT=~"cotdiari.diar_empresa~"    OP =~"=~"RIGHT=~"coddiari.ddia_empresa~"    OUTER1 =~"cotdiari.diar_empresa~" )    JOIN (LEFT=~"cotdiari.diar_aplicacion_mg~"    OP =~"=~"RIGHT=~"coddiari.ddia_aplicacion_mg~"    OUTER1 =~"cotdiari.diar_aplicacion_mg~" )    JOIN (LEFT=~"cotdiari.diar_tipo_transaccion~"    OP =~"=~"RIGHT=~"coddiari.ddia_tipo_transaccion~"    OUTER1 =~"cotdiari.diar_tipo_transaccion~" )    JOIN (LEFT=~"cotdiari.diar_sub_trans~"    OP =~"=~"RIGHT=~"coddiari.ddia_sub_trans~"    OUTER1 =~"cotdiari.diar_sub_trans~" )    JOIN (LEFT=~"cotdiari.diar_no_documento~"    OP =~"=~"RIGHT=~"coddiari.ddia_no_documento~"    OUTER1 =~"cotdiari.diar_no_documento~" )    JOIN (LEFT=~"cotdiari.diar_no_referencia~"    OP =~"=~"RIGHT=~"coddiari.ddia_no_referencia~"    OUTER1 =~"cotdiari.diar_no_referencia~" )    JOIN (LEFT=~"cotdiari.diar_banco_cuenta~"    OP =~"=~"RIGHT=~"coddiari.ddia_banco_cuenta~"    OUTER1 =~"cotdiari.diar_banco_cuenta~" )    JOIN (LEFT=~"cotdiari.diar_ann~"    OP =~"=~"RIGHT=~"coddiari.ddia_ann~"    OUTER1 =~"cotdiari.diar_ann~" )WHERE(    EXP1 =~"cotdiari.diar_empresa~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cotdiari.diar_monto~"   OP =~"<>~"    EXP2 =~"0~" ) ) ARG(NAME = ~"grupo~" TYPE = number) " filter=" cotdiari_diar_monto  <> 0 and isnull( coddiari_ddia_no_documento )"arguments=(("grupo", number))  sort="coddiari_ddia_no_documento A cotdiari_diar_fecha_transaccion A " )
