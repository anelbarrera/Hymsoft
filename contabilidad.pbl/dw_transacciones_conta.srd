 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cotdiari~" ) COLUMN(NAME=~"cotdiari.diar_g_financiero~") COLUMN(NAME=~"cotdiari.diar_empresa~") COLUMN(NAME=~"cotdiari.diar_aplicacion_mg~") COLUMN(NAME=~"cotdiari.diar_tipo_transaccion~") COLUMN(NAME=~"cotdiari.diar_sub_trans~") COLUMN(NAME=~"cotdiari.diar_no_documento~") COLUMN(NAME=~"cotdiari.diar_no_referencia~") COLUMN(NAME=~"cotdiari.diar_ann~") COLUMN(NAME=~"cotdiari.diar_fecha_transaccion~") COMPUTE(NAME=~"0.00 saldo~") COLUMN(NAME=~"cotdiari.diar_descripcion~") COLUMN(NAME=~"cotdiari.diar_id~") COLUMN(NAME=~"cotdiari.diar_estado~") COLUMN(NAME=~"cotdiari.diar_monto~") COLUMN(NAME=~"cotdiari.diar_nombre~") COLUMN(NAME=~"cotdiari.diar_impreso~") COLUMN(NAME=~"cotdiari.diar_banco_cuenta~") COLUMN(NAME=~"cotdiari.diar_comentario~")WHERE(    EXP1 =~"cotdiari.diar_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_aplicacion_mg~"   OP =~"=~"    EXP2 =~"'CO'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_tipo_transaccion~"   OP =~"=~"    EXP2 =~":transaccion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_no_documento~"   OP =~"=~"    EXP2 =~":documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_ann~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cotdiari.diar_no_referencia~"   OP =~"=~"    EXP2 =~":referencia~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"documento~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"referencia~" TYPE = string) " update="cotdiari" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("transaccion", string),("documento", string),("ann", number),("referencia", string)) )
