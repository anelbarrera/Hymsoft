table(column=(type=decimal(0) update=yes updatewhereclause=yes name=mg_g_financiero dbname="dgmplanc.mg_g_financiero" dbalias=".mg_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=mg_empresa dbname="dgmplanc.mg_empresa" dbalias=".mg_empresa" )
 column=(type=char(20) update=yes updatewhereclause=yes name=mg_cuenta dbname="dgmplanc.mg_cuenta" dbalias=".mg_cuenta" )
 column=(type=char(75) update=yes updatewhereclause=yes name=mg_descripcion dbname="dgmplanc.mg_descripcion" dbalias=".mg_descripcion" )
 column=(type=char(1) update=yes updatewhereclause=yes name=mg_naturaleza dbname="dgmplanc.mg_naturaleza" dbalias=".mg_naturaleza" )
 column=(type=decimal(0) updatewhereclause=yes name=mg_nivel dbname="dgmplanc.mg_nivel" dbalias=".mg_nivel" )
 column=(type=char(1) updatewhereclause=yes name=mg_tipo_cuenta dbname="dgmplanc.mg_tipo_cuenta" dbalias=".mg_tipo_cuenta" )
 column=(type=char(1) updatewhereclause=yes name=ingles_1 dbname="ingles" )
 column=(type=char(30) updatewhereclause=yes name=coasgrup_asgr_descrip_subgrupo dbname="coasgrup.asgr_descrip_subgrupo" dbalias=".asgr_descrip_subgrupo" )
 column=(type=char(30) updatewhereclause=yes name=coagrupo_agru_descrip_grupo dbname="coagrupo.agru_descrip_grupo" dbalias=".agru_descrip_grupo" )
 column=(type=char(2) updatewhereclause=yes name=dgmplanc_mg_cod_grupo dbname="dgmplanc.mg_cod_grupo" dbalias=".mg_cod_grupo" )
 column=(type=char(4) updatewhereclause=yes name=dgmplanc_mg_cod_subgrupo dbname="dgmplanc.mg_cod_subgrupo" dbalias=".mg_cod_subgrupo" )
 retrieve="SELECT  dgmplanc.mg_g_financiero ,
           dgmplanc.mg_empresa ,
           dgmplanc.mg_cuenta ,
           dgmplanc.mg_descripcion ,
           dgmplanc.mg_naturaleza ,
           dgmplanc.mg_nivel ,
			  dgmplanc.mg_tipo_cuenta, 
           ' ' ingles,
           coasgrup.asgr_descrip_subgrupo ,
           coagrupo.agru_descrip_grupo ,
           dgmplanc.mg_cod_grupo ,
           dgmplanc.mg_cod_subgrupo     
        FROM dgmplanc ,
           comparam ,
           coagrupo ,
           coasgrup     
        WHERE ( comparam.para_g_financiero = dgmplanc.mg_g_financiero) and
          ( comparam.para_empresa = dgmplanc.mg_empresa) and
          ( coagrupo.agru_g_financiero = dgmplanc.mg_g_financiero) and 
         ( coagrupo.agru_empresa = dgmplanc.mg_empresa) and  
        ( coagrupo.agru_cod_grupo = dgmplanc.mg_cod_grupo) and
          ( coasgrup.asgr_g_financiero = dgmplanc.mg_g_financiero) and  
        ( coasgrup.asgr_empresa = dgmplanc.mg_empresa) and    
      ( coasgrup.asgr_cod_grupo = dgmplanc.mg_cod_grupo) and 
         ( coasgrup.asgr_cod_subgrupo = dgmplanc.mg_cod_subgrupo) and  
        ( ( dgmplanc.mg_g_financiero = :grupo ) and    
      ( dgmplanc.mg_empresa = :empresa ))     
        ORDER BY dgmplanc.mg_cuenta          ASC  " arguments=(("grupo", number),("empresa", number))  sort="dgmplanc_mg_cod_grupo A dgmplanc_mg_cod_subgrupo A mg_cuenta A " )
