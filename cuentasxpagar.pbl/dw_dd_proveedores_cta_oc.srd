table(column=(type=decimal(0) update=yes updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" dbalias=".terc_tercero" )
 column=(type=char(60) update=yes updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
 column=(type=char(154) updatewhereclause=yes name=descrip dbname="descrip" )
 column=(type=char(20) update=yes updatewhereclause=yes name=terc_identificacion dbname="terc_identificacion" )
 column=(type=char(150) updatewhereclause=yes name=terc_direccion dbname="terc_direccion" )
 column=(type=char(10) updatewhereclause=yes name=cpmprove_prov_cod_proveedor dbname="prov_cod_proveedor" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"cpmprove~" )  TABLE(NAME=~"orden~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COMPUTE(NAME=~"dgmterce.terc_descripcion+~~~"                                                                                    ~~~"+convert(varchar(10),dgmterce.terc_tercero) descrip~") COMPUTE(NAME=~"max(terc_identificacion) terc_identificacion~") COMPUTE(NAME=~"max(terc_direccion) terc_direccion~") COMPUTE(NAME=~"max(prov_cod_proveedor) prov_cod_proveedor~")    JOIN (LEFT=~"cpmprove.prov_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"cpmprove.prov_g_financiero~"    OP =~"=~"RIGHT=~"orden.enca_g_financiero~" )    JOIN (LEFT=~"cpmprove.prov_empresa~"    OP =~"=~"RIGHT=~"orden.enca_empresa~" )    JOIN (LEFT=~"cpmprove.prov_tercero~"    OP =~"=~"RIGHT=~"orden.enca_proveedor~" )WHERE(    EXP1 =~"( cpmprove.prov_g_financiero~"   OP =~"=~"    EXP2 =~":clie_grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cpmprove.prov_empresa~"   OP =~"=~"    EXP2 =~":clie_empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cpmprove.prov_estado~"   OP =~"=~"    EXP2 =~"'A'~" )  GROUP(NAME=~"dgmterce.terc_tercero~") GROUP(NAME=~"dgmterce.terc_descripcion~")) ARG(NAME = ~"clie_grupo~" TYPE = number)  ARG(NAME = ~"clie_empresa~" TYPE = number) " arguments=(("clie_grupo", number),("clie_empresa", number))  sort="descrip A " )
