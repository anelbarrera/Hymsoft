table(column=(type=char(30) updatewhereclause=yes name=dgmserie_mser_descripcion dbname="dgmserie.mser_descripcion" dbalias=".mser_descripcion" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" initial="spaces" )
 column=(type=char(2) updatewhereclause=yes name=dgmserie_mser_tipo_transaccion dbname="dgmserie.mser_tipo_transaccion" dbalias=".mser_tipo_transaccion" )
 column=(type=decimal(0) updatewhereclause=yes name=dgmterce_terc_tercero dbname="dgmterce.terc_tercero" dbalias=".terc_tercero" initial="0" )
 column=(type=decimal(0) updatewhereclause=yes name=dgmserie_mser_secuencia dbname="dgmserie.mser_secuencia" dbalias=".mser_secuencia" )
 column=(type=decimal(0) updatewhereclause=yes name=dgmserie_mser_anno dbname="dgmserie.mser_anno" dbalias=".mser_anno" )
 column=(type=char(20) updatewhereclause=yes name=dgmterce_terc_identificacion dbname="dgmterce.terc_identificacion" dbalias=".terc_identificacion" initial="spaces" )
