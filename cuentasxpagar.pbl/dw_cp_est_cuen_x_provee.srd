 column=(type=decimal(0) updatewhereclause=yes name=cptmovim_movi_empresa dbname="cptmovim.movi_empresa" dbalias=".movi_empresa" )
 column=(type=char(2) updatewhereclause=yes name=cptmovim_movi_tipo_transaccion dbname="cptmovim.movi_tipo_transaccion" dbalias=".movi_tipo_transaccion" )
 column=(type=char(3) updatewhereclause=yes name=cptmovim_movi_sub_transaccion dbname="cptmovim.movi_sub_transaccion" dbalias=".movi_sub_transaccion" )
 column=(type=char(20) updatewhereclause=yes name=cptmovim_movi_documento dbname="cptmovim.movi_documento" dbalias=".movi_documento" )
 column=(type=char(8) updatewhereclause=yes name=cptmovim_movi_referencia dbname="cptmovim.movi_referencia" dbalias=".movi_referencia" )
 column=(type=char(2) updatewhereclause=yes name=cptmovim_movi_aplicacion dbname="cptmovim.movi_aplicacion" dbalias=".movi_aplicacion" )
 column=(type=decimal(0) updatewhereclause=yes name=cptmovim_movi_anno dbname="cptmovim.movi_anno" dbalias=".movi_anno" )
 column=(type=decimal(0) updatewhereclause=yes name=cptmovim_movi_tercero dbname="cptmovim.movi_tercero" dbalias=".movi_tercero" )
 column=(type=char(20) updatewhereclause=yes name=cptmovim_movi_ruc_tercero dbname="cptmovim.movi_ruc_tercero" dbalias=".movi_ruc_tercero" )
 column=(type=datetime updatewhereclause=yes name=cptmovim_movi_fecha_tran dbname="cptmovim.movi_fecha_tran" dbalias=".movi_fecha_tran" )
 column=(type=datetime updatewhereclause=yes name=cptmovim_movi_fecha_reg dbname="cptmovim.movi_fecha_reg" dbalias=".movi_fecha_reg" )
 column=(type=char(2) updatewhereclause=yes name=cptmovim_movi_estado dbname="cptmovim.movi_estado" dbalias=".movi_estado" )
 column=(type=datetime updatewhereclause=yes name=cptmovim_movi_fecha_vence dbname="cptmovim.movi_fecha_vence" dbalias=".movi_fecha_vence" )
 column=(type=datetime updatewhereclause=yes name=cptmovim_movi_fecha_cancelado dbname="cptmovim.movi_fecha_cancelado" dbalias=".movi_fecha_cancelado" )
 column=(type=char(250) updatewhereclause=yes name=cptmovim_movi_comentario dbname="cptmovim.movi_comentario" dbalias=".movi_comentario" )
 column=(type=decimal(0) updatewhereclause=yes name=cpmprove_prov_tercero dbname="cpmprove.prov_tercero" dbalias=".prov_tercero" )
 column=(type=decimal(4) updatewhereclause=yes name=cpmprove_prov_limite_credito dbname="cpmprove.prov_limite_credito" dbalias=".prov_limite_credito" )
 column=(type=decimal(0) updatewhereclause=yes name=saldo_mesantes dbname="cpmprove.prov_saldo_moroso" dbalias=".prov_saldo_moroso" )
 column=(type=char(1) updatewhereclause=yes name=cptmovim_movi_naturaleza dbname="cptmovim.movi_naturaleza" dbalias=".movi_naturaleza" )
 column=(type=decimal(4) updatewhereclause=yes name=cptmovim_movi_monto dbname="movi_monto" )
 column=(type=decimal(0) updatewhereclause=yes name=cpmparam_para_g_financiero dbname="cpmparam.para_g_financiero" dbalias=".para_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=cpmparam_para_empresa dbname="cpmparam.para_empresa" dbalias=".para_empresa" )
 column=(type=char(250) updatewhereclause=yes name=cpmparam_para_msj_aldia dbname="cpmparam.para_msj_aldia" dbalias=".para_msj_aldia" )
 column=(type=char(250) updatewhereclause=yes name=cpmparam_para_msj_mora dbname="cpmparam.para_msj_mora" dbalias=".para_msj_mora" )
 column=(type=char(120) updatewhereclause=yes name=cpmparam_para_empre_logo dbname="cpmparam.para_empre_logo" dbalias=".para_empre_logo" )
 column=(type=char(120) updatewhereclause=yes name=cpmparam_para_empre_fondo dbname="cpmparam.para_empre_fondo" dbalias=".para_empre_fondo" )
 column=(type=decimal(4) updatewhereclause=yes name=saldo_inicio dbname="saldo_inicio" )
 retrieve="  SELECT dgmserie.mser_descripcion,   
         dgmterce.terc_descripcion,   
         dgmserie.mser_tipo_transaccion,   
         dgmterce.terc_tercero,   
         dgmserie.mser_secuencia,   
         dgmserie.mser_anno,   
         dgmterce.terc_identificacion,   
			cptmovim.movi_g_financiero,
			cptmovim.movi_empresa,
         cptmovim.movi_tipo_transaccion,   
         cptmovim.movi_sub_transaccion,   
         cptmovim.movi_documento,
			cptmovim.movi_referencia,
			cptmovim.movi_aplicacion,         
         cptmovim.movi_anno,   
         cptmovim.movi_tercero,   
         cptmovim.movi_ruc_tercero,   
         cptmovim.movi_fecha_tran,   
         cptmovim.movi_fecha_reg,   
         cptmovim.movi_estado,   
         cptmovim.movi_fecha_vence,   
         cptmovim.movi_fecha_cancelado,   
         cptmovim.movi_comentario,   
         cpmprove.prov_tercero,   
         cpmprove.prov_limite_credito,   
         cpmprove.prov_saldo_moroso,   
         cptmovim.movi_naturaleza,   
         movi_monto = cptmovim.movi_monto_final,   
         cpmparam.para_g_financiero,   
         cpmparam.para_empresa,   
         cpmparam.para_msj_aldia,   
         cpmparam.para_msj_mora,   
         cpmparam.para_empre_logo,   
         cpmparam.para_empre_fondo,
			 (select sum((case cpt.movi_naturaleza when 'D' then ((-1) * abs(isnull(cpt.movi_monto_final,0))) else abs(isnull(cpt.movi_monto_final,0)) end)) from cptmovim cpt where cptmovim.movi_g_financiero = cpt.movi_g_financiero and
         cptmovim.movi_empresa = cpt.movi_empresa and cptmovim.movi_tercero = cpt.movi_tercero and
         cpt.movi_fecha_tran < :fecha1 ) saldo_inicio
    FROM dgmterce,   
         dgmserie,   
         cpmprove,   
         cptmovim,   
         cpmparam  
   WHERE ( cpmprove.prov_tercero = dgmterce.terc_tercero ) and  
         ( cpmprove.prov_tercero = cptmovim.movi_tercero ) and  
         ( cptmovim.movi_g_financiero = cpmparam.para_g_financiero ) and  
         ( cptmovim.movi_empresa = cpmparam.para_empresa ) and  
         ( cptmovim.movi_g_financiero = dgmserie.mser_g_financiero ) and  
         ( cptmovim.movi_empresa = dgmserie.mser_empresa ) and  
			 ( cptmovim.movi_tipo_transaccion = dgmserie.mser_tipo_transaccion) and  
         ( cptmovim.movi_g_financiero = cpmprove.prov_g_financiero ) and  
         ( cptmovim.movi_empresa = cpmprove.prov_empresa ) and  
         ( cptmovim.movi_g_financiero = :gfinanciero ) AND  
         ( cptmovim.movi_empresa = :empresa ) AND  
         ( cptmovim.movi_fecha_tran >= :fecha1 ) AND  
         ( cptmovim.movi_fecha_tran < dateadd(dd,1,:fecha2) ) AND  
         (cpmprove.prov_tercero = :desdecliente)    
" filter=" cptmovim_movi_tipo_transaccion + cptmovim_movi_sub_transaccion  <> 'NC9'"arguments=(("gfinanciero", number),("empresa", number),("fecha1", date),("fecha2", date),("desdecliente", number))  sort="cptmovim_movi_tercero A cptmovim_movi_fecha_tran A cptmovim_movi_documento A cptmovim_movi_referencia A cptmovim_movi_anno A " )
