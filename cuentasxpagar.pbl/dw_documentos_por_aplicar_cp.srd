 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cptmovim~" )  TABLE(NAME=~"dgmsubse~" ) COLUMN(NAME=~"cptmovim.movi_g_financiero~") COLUMN(NAME=~"cptmovim.movi_empresa~") COLUMN(NAME=~"cptmovim.movi_aplicacion~") COLUMN(NAME=~"cptmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cptmovim.movi_anno~") COLUMN(NAME=~"cptmovim.movi_sub_transaccion~") COLUMN(NAME=~"cptmovim.movi_tercero~") COLUMN(NAME=~"cptmovim.movi_ruc_tercero~") COLUMN(NAME=~"cptmovim.movi_referencia~") COLUMN(NAME=~"cptmovim.movi_fecha_tran~") COLUMN(NAME=~"cptmovim.movi_saldo~") COLUMN(NAME=~"cptmovim.movi_fecha_vence~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"cptmovim.movi_monto_aplicado~") COLUMN(NAME=~"cptmovim.movi_fecha_reg~") COMPUTE(NAME=~"0.00 monto_aplica~") COLUMN(NAME=~"cptmovim.movi_documento~") COMPUTE(NAME=~"0 aplicar~") COMPUTE(NAME=~"movi_monto = movi_monto_final~")    JOIN (LEFT=~"cptmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"dgmsubse.subs_g_financiero~" )    JOIN (LEFT=~"cptmovim.movi_empresa~"    OP =~"=~"RIGHT=~"dgmsubse.subs_empresa~" )    JOIN (LEFT=~"cptmovim.movi_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmsubse.subs_transaccion~" )    JOIN (LEFT=~"cptmovim.movi_sub_transaccion~"    OP =~"=~"RIGHT=~"dgmsubse.subs_sub_trans~" )WHERE(    EXP1 =~"( cptmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_tercero~"   OP =~"=~"    EXP2 =~":proveedor )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_naturaleza~"   OP =~"=~"    EXP2 =~"'C')~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_saldo~"   OP =~">~"    EXP2 =~"0 )~" ) ) ORDER(NAME=~"cptmovim.movi_fecha_tran~" ASC=yes )  ORDER(NAME=~"cptmovim.movi_tipo_transaccion~" ASC=yes ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"proveedor~" TYPE = number) " update="cptmovim" updatewhere=0 updatekeyinplace=yes arguments=(("g_financiero", number),("empresa", number),("proveedor", number))  sort="movi_fecha_tran A cptmovim_movi_fecha_reg A " )
