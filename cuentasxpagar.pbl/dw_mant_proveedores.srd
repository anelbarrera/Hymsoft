 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cpmprove~" )  TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_tipo_persona~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"dgmterce.terc_telefono1~") COLUMN(NAME=~"dgmterce.terc_telefono2~") COLUMN(NAME=~"dgmterce.terc_fax1~") COLUMN(NAME=~"dgmterce.terc_fax2~") COLUMN(NAME=~"dgmterce.terc_email~") COLUMN(NAME=~"dgmterce.terc_apartado_postal~") COLUMN(NAME=~"dgmterce.terc_pais~") COLUMN(NAME=~"dgmterce.terc_clasificacion~") COLUMN(NAME=~"dgmterce.terc_clave_tercero~") COLUMN(NAME=~"dgmterce.terc_tipop~") COLUMN(NAME=~"dgmterce.terc_region~") COLUMN(NAME=~"dgmterce.terc_digito_verificador~") COLUMN(NAME=~"cpmprove.prov_mg_cuenta~") COLUMN(NAME=~"cpmprove.prov_cod_proveedor~") COLUMN(NAME=~"cpmprove.prov_contacto~") COLUMN(NAME=~"cpmprove.prov_contacto_cargo~") COLUMN(NAME=~"cpmprove.prov_contacto_telefono~") COLUMN(NAME=~"cpmprove.prov_comentario~") COLUMN(NAME=~"cpmprove.prov_estado~") COLUMN(NAME=~"cpmprove.prov_g_financiero~") COLUMN(NAME=~"cpmprove.prov_empresa~") COLUMN(NAME=~"cpmprove.prov_clasificacion~")    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"cpmprove.prov_tercero~" )WHERE(    EXP1 =~"cpmprove.prov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cpmprove.prov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cpmprove.prov_tercero~"   OP =~"=~"    EXP2 =~":tercero~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"tercero~" TYPE = number) " update="dgmterce" updatewhere=0 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("tercero", number)) )
