 column=(type=char(8) updatewhereclause=yes name=movi_referencia dbname="cptmovim.movi_referencia" dbalias=".movi_referencia" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"cptmovim~" )  TABLE(NAME=~"cpmprove~" )  TABLE(NAME=~"dgmserie~" ) COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"cpmprove.prov_cod_proveedor~") COLUMN(NAME=~"cptmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cptmovim.movi_sub_transaccion~") COLUMN(NAME=~"cptmovim.movi_anno~") COLUMN(NAME=~"cptmovim.movi_tercero~") COLUMN(NAME=~"cptmovim.movi_fecha_tran~") COLUMN(NAME=~"cptmovim.movi_aplicacion~") COLUMN(NAME=~"dgmserie.mser_descripcion~") COLUMN(NAME=~"cptmovim.movi_documento~") COMPUTE(NAME=~"movi_monto = cptmovim.movi_monto_final~") COLUMN(NAME=~"cptmovim.movi_referencia~")    JOIN (LEFT=~"cpmprove.prov_g_financiero~"    OP =~"=~"RIGHT=~"cptmovim.movi_g_financiero~" )    JOIN (LEFT=~"cpmprove.prov_empresa~"    OP =~"=~"RIGHT=~"cptmovim.movi_empresa~" )    JOIN (LEFT=~"cpmprove.prov_tercero~"    OP =~"=~"RIGHT=~"cptmovim.movi_tercero~" )    JOIN (LEFT=~"cpmprove.prov_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"cptmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"dgmserie.mser_g_financiero~" )    JOIN (LEFT=~"cptmovim.movi_empresa~"    OP =~"=~"RIGHT=~"dgmserie.mser_empresa~" )    JOIN (LEFT=~"cptmovim.movi_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmserie.mser_tipo_transaccion~" )WHERE(    EXP1 =~"( cptmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_fecha_tran~"   OP =~">=~"    EXP2 =~":fecha_inicio )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_fecha_tran~"   OP =~"<~"    EXP2 =~"dateadd(dd,1,:fecha_final) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cptmovim.movi_estado~"   OP =~"=~"    EXP2 =~"'IM'~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha_inicio~" TYPE = datetime)  ARG(NAME = ~"fecha_final~" TYPE = datetime) " arguments=(("g_financiero", number),("empresa", number),("fecha_inicio", datetime),("fecha_final", datetime))  sort="movi_tipo_transaccion A movi_fecha_tran A long(movi_documento) A " )
