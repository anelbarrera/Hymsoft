table(column=(type=char(20) updatewhereclause=yes name=dgmterce_terc_identificacion dbname="dgmterce.terc_identificacion" dbalias=".terc_identificacion" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
