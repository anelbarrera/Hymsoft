 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaregio~" )  TABLE(NAME=~"cpatempa~" )  TABLE(NAME=~"cpmparam~" )  TABLE(NAME=~"cpaantig~" )  TABLE(NAME=~"cpmprove~" ) COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgaregio.regi_descripcion~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"cpatempa.tmpa_g_financiero~") COLUMN(NAME=~"cpatempa.tmpa_empresa~") COLUMN(NAME=~"cpatempa.tmpa_tercero~") COLUMN(NAME=~"cpatempa.tmpa_ruc_tercero~") COLUMN(NAME=~"cpatempa.tmpa_maxdias~") COLUMN(NAME=~"cpatempa.tmpa_monto~") COLUMN(NAME=~"cpatempa.tmpa_descantig~") COLUMN(NAME=~"cpmparam.para_empre_logo~") COLUMN(NAME=~"cpmparam.para_empre_fondo~") COLUMN(NAME=~"cpaantig.cpan_diaini~") COLUMN(NAME=~"cpaantig.cpan_diafin~") COLUMN(NAME=~"cpmprove.prov_cod_proveedor~")    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"dgaregio.regi_codigo_region~"    OP =~"=~"RIGHT=~"dgmterce.terc_region~" )    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgmterce.terc_pais~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"cpatempa.tmpa_tercero~" )    JOIN (LEFT=~"cpatempa.tmpa_g_financiero~"    OP =~"=~"RIGHT=~"cpmparam.para_g_financiero~" )    JOIN (LEFT=~"cpmparam.para_empresa~"    OP =~"=~"RIGHT=~"cpatempa.tmpa_empresa~" )    JOIN (LEFT=~"cpaantig.cpan_g_financiero~"    OP =~"=~"RIGHT=~"cpatempa.tmpa_g_financiero~" )    JOIN (LEFT=~"cpaantig.cpan_empresa~"    OP =~"=~"RIGHT=~"cpatempa.tmpa_empresa~" )    JOIN (LEFT=~"cpatempa.tmpa_g_financiero~"    OP =~"=~"RIGHT=~"cpmprove.prov_g_financiero~" )    JOIN (LEFT=~"cpatempa.tmpa_empresa~"    OP =~"=~"RIGHT=~"cpmprove.prov_empresa~" )    JOIN (LEFT=~"cpatempa.tmpa_tercero~"    OP =~"=~"RIGHT=~"cpmprove.prov_tercero~" )WHERE(    EXP1 =~"cpatempa.tmpa_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cpatempa.tmpa_empresa~"   OP =~"=~"    EXP2 =~":empresa~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="terc_descripcion A long(prov_cod_proveedor) A " )
