 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cptmovim~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaregio~" )  TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"dgmserie~" )  TABLE(NAME=~"dgmsubse~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"coddiari~" )  TABLE(NAME=~"dgmplanc~" ) COLUMN(NAME=~"cptmovim.movi_anno~") COLUMN(NAME=~"cptmovim.movi_referencia~") COLUMN(NAME=~"cptmovim.movi_fecha_tran~") COLUMN(NAME=~"cptmovim.movi_monto~") COLUMN(NAME=~"dgmserie.mser_descripcion~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"dgaregio.regi_descripcion~") COLUMN(NAME=~"cptmovim.movi_a_nombre~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"dgmterce.terc_telefono1~") COLUMN(NAME=~"dgmterce.terc_telefono2~") COLUMN(NAME=~"dgmterce.terc_fax1~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_direccion~") COLUMN(NAME=~"dgmempre.empr_telefono1~") COLUMN(NAME=~"dgmempre.empr_telefono2~") COLUMN(NAME=~"dgmempre.empr_fax1~") COLUMN(NAME=~"dgmempre.empr_e_mail~") COLUMN(NAME=~"dgmempre.empr_logo_t~") COLUMN(NAME=~"cptmovim.movi_tercero~") COLUMN(NAME=~"cptmovim.movi_ruc_tercero~") COLUMN(NAME=~"cptmovim.movi_comentario~") COLUMN(NAME=~"coddiari.ddia_linea~") COLUMN(NAME=~"coddiari.ddia_mg_cuenta~") COLUMN(NAME=~"coddiari.ddia_monto~") COLUMN(NAME=~"coddiari.ddia_naturaleza~") COLUMN(NAME=~"dgmplanc.mg_descripcion~") COLUMN(NAME=~"cptmovim.movi_sub_transaccion~") COLUMN(NAME=~"cptmovim.movi_documento~") COLUMN(NAME=~"cptmovim.movi_paga_itbm~") COLUMN(NAME=~"cptmovim.movi_monto_final~") COLUMN(NAME=~"cptmovim.movi_itbm~")    JOIN (LEFT=~"dgmsubse.subs_g_financiero~"    OP =~"=~"RIGHT=~"cptmovim.movi_g_financiero~" )    JOIN (LEFT=~"dgmsubse.subs_empresa~"    OP =~"=~"RIGHT=~"cptmovim.movi_empresa~" )    JOIN (LEFT=~"dgmsubse.subs_transaccion~"    OP =~"=~"RIGHT=~"cptmovim.movi_tipo_transaccion~" )    JOIN (LEFT=~"dgmsubse.subs_sub_trans~"    OP =~"=~"RIGHT=~"cptmovim.movi_sub_transaccion~" )    JOIN (LEFT=~"dgmterce.terc_region~"    OP =~"=~"RIGHT=~"dgaregio.regi_codigo_region~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgaregio.regi_pais~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"cptmovim.movi_tercero~" )    JOIN (LEFT=~"cptmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"cptmovim.movi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"cptmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"dgmserie.mser_g_financiero~" )    JOIN (LEFT=~"cptmovim.movi_empresa~"    OP =~"=~"RIGHT=~"dgmserie.mser_empresa~" )    JOIN (LEFT=~"cptmovim.movi_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmserie.mser_tipo_transaccion~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"dgmplanc.mg_g_financiero~"    OP =~"=~"RIGHT=~"coddiari.ddia_g_financiero~" )    JOIN (LEFT=~"dgmplanc.mg_empresa~"    OP =~"=~"RIGHT=~"coddiari.ddia_empresa~" )    JOIN (LEFT=~"dgmplanc.mg_cuenta~"    OP =~"=~"RIGHT=~"coddiari.ddia_mg_cuenta~" )    JOIN (LEFT=~"cptmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"coddiari.ddia_g_financiero~" )    JOIN (LEFT=~"cptmovim.movi_empresa~"    OP =~"=~"RIGHT=~"coddiari.ddia_empresa~" )    JOIN (LEFT=~"cptmovim.movi_tipo_transaccion~"    OP =~"=~"RIGHT=~"coddiari.ddia_tipo_transaccion~" )    JOIN (LEFT=~"cptmovim.movi_sub_transaccion~"    OP =~"=~"RIGHT=~"coddiari.ddia_sub_trans~" )    JOIN (LEFT=~"cptmovim.movi_documento~"    OP =~"=~"RIGHT=~"coddiari.ddia_no_documento~" )    JOIN (LEFT=~"cptmovim.movi_referencia~"    OP =~"=~"RIGHT=~"coddiari.ddia_no_referencia~" )    JOIN (LEFT=~"cptmovim.movi_anno~"    OP =~"=~"RIGHT=~"coddiari.ddia_ann~" )WHERE(    EXP1 =~"cptmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cptmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cptmovim.movi_aplicacion~"   OP =~"=~"    EXP2 =~"'CP'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cptmovim.movi_tipo_transaccion~"   OP =~"=~"    EXP2 =~":transaccion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cptmovim.movi_documento~"   OP =~"=~"    EXP2 =~":docu~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cptmovim.movi_anno~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cptmovim.movi_tipo_transaccion+cptmovim.movi_sub_transaccion~"   OP =~"<>~"    EXP2 =~"'NC9'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"coddiari.ddia_aplicacion_mg~"   OP =~"=~"    EXP2 =~"'CP'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cptmovim.movi_referencia~"   OP =~"=~"    EXP2 =~":referencia~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"docu~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"referencia~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("transaccion", string),("docu", string),("ann", number),("referencia", string)) )
