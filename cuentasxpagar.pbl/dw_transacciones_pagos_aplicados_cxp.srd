table(column=(type=char(2) updatewhereclause=yes name=movi_tipo_transaccion dbname="cptmovim.movi_tipo_transaccion" )
 column=(type=char(20) updatewhereclause=yes name=movi_documento dbname="cptmovim.movi_documento" )
 column=(type=decimal(0) updatewhereclause=yes name=movi_anno dbname="cptmovim.movi_anno" )
 column=(type=char(8) updatewhereclause=yes name=movi_referencia dbname="cptmovim.movi_referencia" )
 column=(type=datetime updatewhereclause=yes name=movi_fecha_tran dbname="cptmovim.movi_fecha_tran" )
 column=(type=decimal(4) updatewhereclause=yes name=movi_monto dbname="cptmovim.movi_monto" )
 column=(type=decimal(4) updatewhereclause=yes name=movi_saldo dbname="cptmovim.movi_saldo" )
 column=(type=decimal(2) updatewhereclause=yes name=movi_monto_aplicado dbname="cptmovim.movi_monto_aplicado" )
 column=(type=char(30) updatewhereclause=yes name=dgmserie_mser_descripcion dbname="dgmserie.mser_descripcion" )
 column=(type=char(3) updatewhereclause=yes name=movi_sub_transaccion dbname="cptmovim.movi_sub_transaccion" )
 column=(type=char(2) updatewhereclause=yes name=movi_aplicacion dbname="cptmovim.movi_aplicacion" )
 column=(type=char(15) updatewhereclause=yes name=movi_referencia_banco dbname="cptmovim.movi_referencia_banco" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cptmovim~" )  TABLE(NAME=~"dgmserie~" ) COLUMN(NAME=~"cptmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cptmovim.movi_documento~") COLUMN(NAME=~"cptmovim.movi_anno~") COLUMN(NAME=~"cptmovim.movi_referencia~") COLUMN(NAME=~"cptmovim.movi_fecha_tran~") COLUMN(NAME=~"cptmovim.movi_monto~") COLUMN(NAME=~"cptmovim.movi_saldo~") COLUMN(NAME=~"cptmovim.movi_monto_aplicado~") COLUMN(NAME=~"dgmserie.mser_descripcion~") COLUMN(NAME=~"cptmovim.movi_sub_transaccion~") COLUMN(NAME=~"cptmovim.movi_aplicacion~") COLUMN(NAME=~"cptmovim.movi_referencia_banco~")    JOIN (LEFT=~"cptmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"dgmserie.mser_g_financiero~" )    JOIN (LEFT=~"cptmovim.movi_empresa~"    OP =~"=~"RIGHT=~"dgmserie.mser_empresa~" )    JOIN (LEFT=~"cptmovim.movi_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmserie.mser_tipo_transaccion~" )WHERE(    EXP1 =~"cptmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cptmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cptmovim.movi_tercero~"   OP =~"=~"    EXP2 =~":cliente~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cptmovim.movi_fecha_tran~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cptmovim.movi_fecha_tran~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cptmovim.movi_naturaleza~"   OP =~"=~"    EXP2 =~"'D'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"cliente~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("cliente", number),("fecha1", datetime),("fecha2", datetime))  sort="movi_fecha_tran A movi_documento A " )
