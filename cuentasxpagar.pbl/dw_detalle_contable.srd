 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coddiari~" ) COLUMN(NAME=~"coddiari.ddia_g_financiero~") COLUMN(NAME=~"coddiari.ddia_empresa~") COLUMN(NAME=~"coddiari.ddia_aplicacion_mg~") COLUMN(NAME=~"coddiari.ddia_tipo_transaccion~") COLUMN(NAME=~"coddiari.ddia_sub_trans~") COLUMN(NAME=~"coddiari.ddia_no_documento~") COLUMN(NAME=~"coddiari.ddia_no_referencia~") COLUMN(NAME=~"coddiari.ddia_linea~") COLUMN(NAME=~"coddiari.ddia_mg_cuenta~") COLUMN(NAME=~"coddiari.ddia_monto~") COLUMN(NAME=~"coddiari.ddia_naturaleza~") COLUMN(NAME=~"coddiari.ddia_id~") COLUMN(NAME=~"coddiari.ddia_fecha~") COLUMN(NAME=~"coddiari.ddia_tercero~") COLUMN(NAME=~"coddiari.ddia_centro_costo~") COLUMN(NAME=~"coddiari.ddia_documento_anexo~") COLUMN(NAME=~"coddiari.ddia_tipo~") COLUMN(NAME=~"coddiari.ddia_transito~") COLUMN(NAME=~"coddiari.ddia_cargado_a~") COLUMN(NAME=~"coddiari.ddia_class~") COLUMN(NAME=~"coddiari.ddia_comentario_detalle~") COMPUTE(NAME=~"0.00 monto_debito~") COMPUTE(NAME=~"0.00 monto_credito~") COLUMN(NAME=~"coddiari.ddia_ann~") COMPUTE(NAME=~"'                    ' cuenta~") COLUMN(NAME=~"coddiari.ddia_codigo_cte_prov~") COLUMN(NAME=~"coddiari.ddia_banco_cuenta~")WHERE(    EXP1 =~"coddiari.ddia_g_financiero~"   OP =~"=~"    EXP2 =~":conta_grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_empresa~"   OP =~"=~"    EXP2 =~":conta_empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_aplicacion_mg~"   OP =~"=~"    EXP2 =~":conta_aplicacion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_tipo_transaccion~"   OP =~"=~"    EXP2 =~":conta_tipo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_no_documento~"   OP =~"=~"    EXP2 =~":conta_documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_no_referencia~"   OP =~"=~"    EXP2 =~":conta_referencia~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"coddiari.ddia_ann~"   OP =~"=~"    EXP2 =~":conta_ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"coddiari.ddia_banco_cuenta~"   OP =~"=~"    EXP2 =~":banco_cuenta~" ) ) ARG(NAME = ~"conta_grupo~" TYPE = number)  ARG(NAME = ~"conta_empresa~" TYPE = number)  ARG(NAME = ~"conta_aplicacion~" TYPE = string)  ARG(NAME = ~"conta_tipo~" TYPE = string)  ARG(NAME = ~"conta_documento~" TYPE = string)  ARG(NAME = ~"conta_referencia~" TYPE = string)  ARG(NAME = ~"conta_ann~" TYPE = number)  ARG(NAME = ~"banco_cuenta~" TYPE = string) " update="coddiari" updatewhere=1 updatekeyinplace=yes arguments=(("conta_grupo", number),("conta_empresa", number),("conta_aplicacion", string),("conta_tipo", string),("conta_documento", string),("conta_referencia", string),("conta_ann", number),("banco_cuenta", string)) )
