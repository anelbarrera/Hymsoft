 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"dgmplanc~" )  TABLE(NAME=~"cpmprove~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"dgmplanc.mg_descripcion~") COLUMN(NAME=~"dgmterce.terc_tipop~") COLUMN(NAME=~"cpmprove.prov_g_financiero~") COLUMN(NAME=~"cpmprove.prov_empresa~") COLUMN(NAME=~"cpmprove.prov_tercero~") COLUMN(NAME=~"cpmprove.prov_mg_cuenta~") COLUMN(NAME=~"dgmterce.terc_codigo~") COLUMN(NAME=~"cpmprove.prov_cod_proveedor~") COLUMN(NAME=~"cpmprove.prov_clasificacion~")    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"cpmprove.prov_tercero~" )    JOIN (LEFT=~"cpmprove.prov_g_financiero~"    OP =~"=~"RIGHT=~"dgmplanc.mg_g_financiero~" )    JOIN (LEFT=~"cpmprove.prov_empresa~"    OP =~"=~"RIGHT=~"dgmplanc.mg_empresa~" )    JOIN (LEFT=~"cpmprove.prov_mg_cuenta~"    OP =~"=~"RIGHT=~"dgmplanc.mg_cuenta~" )WHERE(    EXP1 =~"cpmprove.prov_g_financiero~"   OP =~"=~"    EXP2 =~":an_g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cpmprove.prov_empresa~"   OP =~"=~"    EXP2 =~":an_empresa~" ) ) ARG(NAME = ~"an_g_financiero~" TYPE = number)  ARG(NAME = ~"an_empresa~" TYPE = number) " arguments=(("an_g_financiero", number),("an_empresa", number))  sort="compute_1 A " )
