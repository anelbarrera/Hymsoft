 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"cpmprove~" )  TABLE(NAME=~"cptmovim~" )  TABLE(NAME=~"cpmparam~" )  TABLE(NAME=~"dgagrupf~" )  TABLE(NAME=~"cpatipro~" ) COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"cptmovim.movi_sub_transaccion~") COLUMN(NAME=~"cptmovim.movi_anno~") COLUMN(NAME=~"cptmovim.movi_tercero~") COLUMN(NAME=~"cptmovim.movi_fecha_tran~") COLUMN(NAME=~"cptmovim.movi_naturaleza~") COLUMN(NAME=~"cptmovim.movi_monto~") COLUMN(NAME=~"cpmparam.para_g_financiero~") COLUMN(NAME=~"cpmparam.para_empresa~") COLUMN(NAME=~"cpmparam.para_msj_aldia~") COLUMN(NAME=~"cpmparam.para_msj_mora~") COLUMN(NAME=~"cpmparam.para_empre_logo~") COLUMN(NAME=~"cpmparam.para_empre_fondo~") COLUMN(NAME=~"cpmprove.prov_mg_cuenta~") COLUMN(NAME=~"dgmterce.terc_codigo~") COLUMN(NAME=~"cpmprove.prov_cod_proveedor~") COLUMN(NAME=~"dgagrupf.grup_descripcion~") COLUMN(NAME=~"cpmprove.prov_tercero~") COLUMN(NAME=~"cptmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cptmovim.movi_documento~") COLUMN(NAME=~"cptmovim.movi_g_financiero~") COLUMN(NAME=~"cptmovim.movi_empresa~") COLUMN(NAME=~"cptmovim.movi_aplicacion~") COLUMN(NAME=~"cptmovim.movi_referencia~") COLUMN(NAME=~"cptmovim.movi_ruc_tercero~") COLUMN(NAME=~"cpatipro.tpro_descripcion~")    JOIN (LEFT=~"cpmprove.prov_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"cpmprove.prov_tercero~"    OP =~"=~"RIGHT=~"cptmovim.movi_tercero~" )    JOIN (LEFT=~"cptmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"cpmparam.para_g_financiero~" )    JOIN (LEFT=~"cptmovim.movi_empresa~"    OP =~"=~"RIGHT=~"cpmparam.para_empresa~" )    JOIN (LEFT=~"cptmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"cpmprove.prov_g_financiero~" )    JOIN (LEFT=~"cptmovim.movi_empresa~"    OP =~"=~"RIGHT=~"cpmprove.prov_empresa~" )    JOIN (LEFT=~"cptmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"dgagrupf.grup_g_financiero~" )    JOIN (LEFT=~"cpmparam.para_g_financiero~"    OP =~"=~"RIGHT=~"dgagrupf.grup_g_financiero~" )    JOIN (LEFT=~"cpmprove.prov_g_financiero~"    OP =~"=~"RIGHT=~"cpatipro.tpro_g_financiero~" )    JOIN (LEFT=~"cpmprove.prov_empresa~"    OP =~"=~"RIGHT=~"cpatipro.tpro_empresa~" )    JOIN (LEFT=~"cpmprove.prov_clasificacion~"    OP =~"=~"RIGHT=~"cpatipro.tpro_clasificacion~" )WHERE(    EXP1 =~"( cptmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":gfinanciero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_fecha_tran~"   OP =~"<~"    EXP2 =~"dateadd(dd,1,:fecha1 ))~" ) ) ORDER(NAME=~"cpmprove.prov_cod_proveedor~" ASC=yes )  ORDER(NAME=~"dgmterce.terc_descripcion~" ASC=yes ) ARG(NAME = ~"gfinanciero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = date) " arguments=(("gfinanciero", number),("empresa", number),("fecha1", date))  sort="cpatipro_tpro_descripcion A dgmterce_terc_descripcion A cptmovim_movi_tercero A cptmovim_movi_fecha_tran A cptmovim_movi_tipo_transaccion A cptmovim_movi_sub_transaccion A cptmovim_movi_anno A " )
