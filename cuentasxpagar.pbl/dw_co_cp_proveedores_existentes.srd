gmterce.terc_tercero~"    OP =~"=~"RIGHT=~"cpmprove.prov_tercero~" )WHERE(    EXP1 =~"cpmprove.prov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cpmprove.prov_empresa~"   OP =~"=~"    EXP2 =~":empresa~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="cpmprove_prov_tercero A dgmterce_terc_descripcion A " )
