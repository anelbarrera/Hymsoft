//if isnull(ld_saldo_d) then	ld_saldo_d = 0
//if isnull(ld_saldo_c) then	ld_saldo_c = 0
//if isnull(ldec_saldo_inicial) then ldec_saldo_inicial = 0

//ld_saldo_total = ld_saldo_c - ld_saldo_d
if isnull(ldec_saldo_inicial) then ldec_saldo_inicial = 0 
if isnull(ld_saldo_total) then ld_saldo_total = 0
ld_saldo_total =  (ldec_saldo_inicial) + ld_saldo_total 

return ld_saldo_total

end function

