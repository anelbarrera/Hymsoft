table(column=(type=decimal(0) updatewhereclause=yes key=yes name=btdi_g_financiero dbname="batdiari.btdi_g_financiero" dbalias=".btdi_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=btdi_empresa dbname="batdiari.btdi_empresa" dbalias=".btdi_empresa" )
 column=(type=char(2) updatewhereclause=yes key=yes name=btdi_tipo_transaccion dbname="batdiari.btdi_tipo_transaccion" dbalias=".btdi_tipo_transaccion" )
 column=(type=char(3) updatewhereclause=yes key=yes name=btdi_sub_transaccion dbname="batdiari.btdi_sub_transaccion" dbalias=".btdi_sub_transaccion" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=btdi_banco dbname="batdiari.btdi_banco" dbalias=".btdi_banco" )
 column=(type=char(40) updatewhereclause=yes key=yes name=btdi_no_cuenta dbname="batdiari.btdi_no_cuenta" dbalias=".btdi_no_cuenta" )
 column=(type=char(8) updatewhereclause=yes key=yes name=btdi_documento dbname="batdiari.btdi_documento" dbalias=".btdi_documento" )
 column=(type=char(15) updatewhereclause=yes key=yes name=btdi_referencia dbname="batdiari.btdi_referencia" dbalias=".btdi_referencia" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=btdi_ann dbname="batdiari.btdi_ann" dbalias=".btdi_ann" )
 column=(type=datetime updatewhereclause=yes name=btdi_fecha_tran dbname="batdiari.btdi_fecha_tran" dbalias=".btdi_fecha_tran" )
 column=(type=char(60) updatewhereclause=yes name=btdi_a_nombre_de dbname="batdiari.btdi_a_nombre_de" dbalias=".btdi_a_nombre_de" )
 column=(type=char(2) updatewhereclause=yes name=btdi_aplica_origen dbname="batdiari.btdi_aplica_origen" dbalias=".btdi_aplica_origen" )
 column=(type=char(1) update=yes updatewhereclause=yes name=btdi_conciliacion dbname="batdiari.btdi_conciliacion" dbalias=".btdi_conciliacion" values="	C/	P" )
 column=(type=decimal(2) updatewhereclause=yes name=btdi_monto dbname="batdiari.btdi_monto" dbalias=".btdi_monto" )
 column=(type=char(250) updatewhereclause=yes name=btdi_comentario dbname="batdiari.btdi_comentario" dbalias=".btdi_comentario" )
 column=(type=char(1) updatewhereclause=yes name=btdi_naturaleza dbname="batdiari.btdi_naturaleza" dbalias=".btdi_naturaleza" )
 retrieve="  SELECT batdiari.btdi_g_financiero ,           batdiari.btdi_empresa ,       
  batdiari.btdi_transaccion btdi_tipo_transaccion ,         
  batdiari.btdi_sub_trans btdi_sub_transaccion ,         
  batdiari.btdi_banco ,          
  batdiari.btdi_no_cuenta ,         
  batdiari.btdi_no_documento btdi_documento,        
  batdiari.btdi_referencia ,        
  batdiari.btdi_ano btdi_ann ,          
  batdiari.btdi_fecha_trans btdi_fecha_tran ,     
  batdiari.btdi_a_nombre_de ,      
  batdiari.btdi_aplica_origen ,       
  batdiari.btdi_conciliacion ,           batdiari.btdi_monto ,  
  batdiari.btdi_coment1 btdi_comentario,
  batdiari.btdi_naturaleza      
FROM batdiari      
WHERE ( batdiari.btdi_g_financiero = :grupo ) And          
( batdiari.btdi_empresa = :empresa ) And          
( batdiari.btdi_banco = :banco ) And          
( batdiari.btdi_no_cuenta = :cuenta ) And          
( batdiari.btdi_fecha_trans < dateadd(dd,1,:fecha) ) and          
( batdiari.btdi_sub_trans in ('DE','SD') ) and          
( batdiari.btdi_conciliacion in ('C','P') )   " update="batdiari" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("banco", number),("cuenta", string),("fecha", datetime))  sort="btdi_documento A " )
