 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"batdiari~" ) COLUMN(NAME=~"batdiari.btdi_documento~") COLUMN(NAME=~"batdiari.btdi_referencia~") COLUMN(NAME=~"batdiari.btdi_fecha_tran~") COLUMN(NAME=~"batdiari.btdi_fecha_habilita_deposito~") COLUMN(NAME=~"batdiari.btdi_monto~")WHERE(    EXP1 =~"batdiari.btdi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'DE'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_banco~"   OP =~"=~"    EXP2 =~":banco~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_no_cuenta~"   OP =~"=~"    EXP2 =~":cuenta~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_fecha_habilita_deposito~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_fecha_habilita_deposito~"   OP =~"<=~"    EXP2 =~":fecha2~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"banco~" TYPE = number)  ARG(NAME = ~"cuenta~" TYPE = string)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("banco", number),("cuenta", string),("fecha1", datetime),("fecha2", datetime)) )
