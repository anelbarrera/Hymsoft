table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=bapa_g_financiero dbname="bapagos.bapa_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=bapa_empresa dbname="bapagos.bapa_empresa" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=bapa_secuencia dbname="bapagos.bapa_secuencia" )
 column=(type=char(2) update=yes updatewhereclause=yes name=bapa_concepto_pago dbname="bapagos.bapa_concepto_pago" )
 column=(type=char(20) update=yes updatewhereclause=yes name=bapa_ruc dbname="bapagos.bapa_ruc" )
 column=(type=char(2) update=yes updatewhereclause=yes name=bapa_digito_verificador dbname="bapagos.bapa_digito_verificador" )
 column=(type=char(1) update=yes updatewhereclause=yes name=bapa_tipo_persona dbname="bapagos.bapa_tipo_persona" )
 column=(type=char(60) update=yes updatewhereclause=yes name=bapa_a_nombre_de dbname="bapagos.bapa_a_nombre_de" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=bapa_monto_factura dbname="bapagos.bapa_monto_factura" )
 column=(type=char(20) update=yes updatewhereclause=yes name=bapa_numero_factura dbname="bapagos.bapa_numero_factura" )
 column=(type=datetime update=yes updatewhereclause=yes name=bapa_fecha_factura dbname="bapagos.bapa_fecha_factura" )
 column=(type=datetime update=yes updatewhereclause=yes name=bapa_fecha_orden dbname="bapagos.bapa_fecha_orden" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=bapa_monto_agrupado dbname="bapagos.bapa_monto_agrupado" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=bapa_itbm dbname="bapagos.bapa_itbm" )
 column=(type=long update=yes updatewhereclause=yes name=bapa_cantidad_registros dbname="bapagos.bapa_cantidad_registros" )
 retrieve="  SELECT bapagos.bapa_g_financiero,   
         bapagos.bapa_empresa,   
         bapagos.bapa_secuencia,   
         bapagos.bapa_concepto_pago,   
         bapagos.bapa_ruc,   
         bapagos.bapa_digito_verificador,   
         bapagos.bapa_tipo_persona,   
         bapagos.bapa_a_nombre_de,   
         bapagos.bapa_monto_factura,   
         bapagos.bapa_numero_factura,   
         bapagos.bapa_fecha_factura,   
         bapagos.bapa_fecha_orden,   
         bapagos.bapa_monto_agrupado,   
         bapagos.bapa_itbm,   
         bapagos.bapa_cantidad_registros  
    FROM bapagos  
   WHERE ( bapagos.bapa_g_financiero = :finan ) AND  
         ( bapagos.bapa_empresa = :empr ) AND  
         ( bapagos.bapa_monto_agrupado >= 50 ) AND 
			( bapagos.bapa_concepto_pago not in ('','00'))
   UNION   
  SELECT max(bapagos.bapa_g_financiero),   
         max(bapagos.bapa_empresa),   
         max(bapagos.bapa_secuencia),   
         max(bapagos.bapa_concepto_pago),   
         bapagos.bapa_ruc,   
         bapagos.bapa_digito_verificador,   
         max(bapagos.bapa_tipo_persona),   
         max(bapagos.bapa_a_nombre_de),   
         max(bapagos.bapa_monto_factura),   
         max(bapagos.bapa_numero_factura),   
         max(bapagos.bapa_fecha_factura),   
         max(bapagos.bapa_fecha_orden),   
			sum(bapagos.bapa_monto_agrupado) monto_agrupado,   
         sum(bapagos.bapa_itbm),
         sum(1) cantidad_registros  
    FROM bapagos  
   WHERE ( bapagos.bapa_g_financiero = :finan ) AND  
         ( bapagos.bapa_empresa = :empr ) AND  
         ( bapagos.bapa_monto_agrupado < 50 ) AND 
			( bapagos.bapa_concepto_pago not in ('','00'))
group by bapagos.bapa_ruc,   
         bapagos.bapa_digito_verificador
" update="bapagos" updatewhere=0 updatekeyinplace=no arguments=(("finan", number),("empr", number))  sort="bapa_concepto_pago A " )
