JOIN (LEFT=~"batdiari.btdi_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmserie.mser_tipo_transaccion~" )    JOIN (LEFT=~"batdiari.btdi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"batdiari.btdi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"batdiari.btdi_banco~"    OP =~"=~"RIGHT=~"bancos.banc_codigo~" )    JOIN (LEFT=~"batdiari.btdi_g_financiero~"    OP =~"=~"RIGHT=~"coddiari.ddia_g_financiero~" )    JOIN (LEFT=~"batdiari.btdi_empresa~"    OP =~"=~"RIGHT=~"coddiari.ddia_empresa~" )    JOIN (LEFT=~"batdiari.btdi_tipo_transaccion~"    OP =~"=~"RIGHT=~"coddiari.ddia_tipo_transaccion~" )    JOIN (LEFT=~"batdiari.btdi_sub_transaccion~"    OP =~"=~"RIGHT=~"coddiari.ddia_sub_trans~" )    JOIN (LEFT=~"batdiari.btdi_documento~"    OP =~"=~"RIGHT=~"coddiari.ddia_no_documento~" )    JOIN (LEFT=~"batdiari.btdi_ann~"    OP =~"=~"RIGHT=~"coddiari.ddia_ann~" )    JOIN (LEFT=~"bamcuent.cuen_banco~"    OP =~"=~"RIGHT=~"bancos.banc_codigo~" )    JOIN (LEFT=~"bamcuent.cuen_g_financiero~"    OP =~"=~"RIGHT=~"batdiari.btdi_g_financiero~" )    JOIN (LEFT=~"bamcuent.cuen_empresa~"    OP =~"=~"RIGHT=~"batdiari.btdi_empresa~" )    JOIN (LEFT=~"bamcuent.cuen_no_cuenta~"    OP =~"=~"RIGHT=~"batdiari.btdi_no_cuenta~" )    JOIN (LEFT=~"bamcuent.cuen_banco~"    OP =~"=~"RIGHT=~"batdiari.btdi_banco~" )    JOIN (LEFT=~"batdiari.btdi_referencia~"    OP =~"=~"RIGHT=~"coddiari.ddia_no_referencia~" )    JOIN (LEFT=~"dgmplanc.mg_g_financiero~"    OP =~"=~"RIGHT=~"coddiari.ddia_g_financiero~" )    JOIN (LEFT=~"dgmplanc.mg_empresa~"    OP =~"=~"RIGHT=~"coddiari.ddia_empresa~" )    JOIN (LEFT=~"dgmplanc.mg_cuenta~"    OP =~"=~"RIGHT=~"coddiari.ddia_mg_cuenta~" )    JOIN (LEFT=~"dgmplanc.mg_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"dgmplanc.mg_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )WHERE(    EXP1 =~"batdiari.btdi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_tipo_transaccion~"   OP =~"=~"    EXP2 =~":transaccion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_sub_transaccion~"   OP =~"=~"    EXP2 =~":subtran~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_banco~"   OP =~"=~"    EXP2 =~":banco~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_no_cuenta~"   OP =~"=~"    EXP2 =~":cuenta~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"batdiari.btdi_documento~"   OP =~"=~"    EXP2 =~":docu~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"batdiari.btdi_ann~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"coddiari.ddia_aplicacion_mg~"   OP =~"=~"    EXP2 =~"'BA'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"convert(varchar(2), bancos.banc_codigo)+'-'+convert(varchar(4),bamcuent.cuen_id)~"   OP =~"=~"    EXP2 =~"coddiari.ddia_banco_cuenta~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"subtran~" TYPE = string)  ARG(NAME = ~"banco~" TYPE = number)  ARG(NAME = ~"cuenta~" TYPE = string)  ARG(NAME = ~"docu~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("transaccion", string),("subtran", string),("banco", number),("cuenta", string),("docu", string),("ann", number)) )
