detail(height=84 color="536870912" )
table(column=(type=char(2) updatewhereclause=yes name=bampgoter_bamp_concepto_pago dbname="bampgoter.bamp_concepto_pago" )
 column=(type=char(20) updatewhereclause=yes name=bampgoter_bamp_ruc dbname="bampgoter.bamp_ruc" )
 column=(type=char(2) updatewhereclause=yes name=bampgoter_bamp_digito dbname="bampgoter.bamp_digito" )
 column=(type=char(1) updatewhereclause=yes name=tipo_persona1 dbname="tipo_persona1" )
 column=(type=char(60) updatewhereclause=yes name=a_nombre_de dbname="a_nombre_de" )
 column=(type=decimal(2) updatewhereclause=yes name=monto_factura dbname="monto_factura" )
 column=(type=char(20) updatewhereclause=yes name=numero_factura dbname="numero_factura" )
 column=(type=datetime updatewhereclause=yes name=fecha_factura dbname="fecha_factura" )
 column=(type=datetime updatewhereclause=yes name=fecha_orden dbname="fecha_orden" )
 column=(type=decimal(2) updatewhereclause=yes name=monto_agrupado dbname="monto_agrupado" )
 column=(type=decimal(2) updatewhereclause=yes name=itbm_agrupado dbname="itbm_agrupado" )
 column=(type=long updatewhereclause=yes name=cantidad_registros dbname="cantidad_registros" )
 retrieve="  SELECT bampgoter.bamp_concepto_pago,   
         bampgoter.bamp_ruc,   
         bampgoter.bamp_digito,  
         max(bampgoter.bamp_tipo_persona) tipo_persona1,   
         max(bampgoter.bamp_a_nombre_de) a_nombre_de,   
         max(bampgoter.bamp_monto_factura) monto_factura,   
         max(bampgoter.bamp_numero_factura) numero_factura,   
         max(bampgoter.bamp_fecha_factura) fecha_factura,   
			max(bamp_fecha_transaccion) fecha_orden,
         sum(convert(numeric(13,2),bampgoter.bamp_monto_factura)) monto_agrupado,   
         sum(convert(numeric(13,2),bampgoter.bamp_itbm)) itbm_agrupado,   
         sum(1) cantidad_registros  
    FROM bampgoter  
   WHERE ( bampgoter.bamp_g_financiero = :finan ) AND  
         ( bampgoter.bamp_empresa = :empr ) AND  
         ( datepart(mm,bampgoter.bamp_fecha_transaccion) = :mes ) AND  
         ( datepart(yy,bampgoter.bamp_fecha_transaccion) = :ann ) AND 
         ( bampgoter.bamp_concepto_pago not in ('00','') ) AND  
         ( bampgoter.bamp_estado = 'A' ) AND  
         ( bampgoter.bamp_transaccion not in ('OP') )   
GROUP BY bampgoter.bamp_concepto_pago,   
         bampgoter.bamp_ruc,   
         bampgoter.bamp_digito  
" arguments=(("finan", number),("empr", number),("mes", number),("ann", number))  sort="bampgoter_bamp_concepto_pago A " )
