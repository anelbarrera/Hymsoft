 retrieve="SELECT  bamsaldo.sald_grupo_financiero sald_g_financiero ,
           bamsaldo.sald_empresa ,
           bamsaldo.sald_banco ,
           bamsaldo.sald_cuenta ,
           bamsaldo.sald_fecha_ini_periodo ,
           bamsaldo.sald_fecha_fin_periodo ,
           bamsaldo.sald_monto_lib_ini ,
           bancos.banc_descripcion ,
           bamcuent.cuen_no_cuenta,
			  bamsaldo.sald_cheq_girados,
			  bamsaldo.sald_depo_lib,
			  bamsaldo.sald_ajustes_db,
			  bamsaldo.sald_ajustes_cr,
			  bamsaldo.sald_nota_cr_lib,
				bamsaldo.sald_nota_db_lib,
				bamsaldo.sald_transf_cr_lib,
				bamsaldo.sald_transf_db_lib,
				bamsaldo.sald_monto_ban_ini,
				bamsaldo.sald_depo_transito,
				bamsaldo.sald_cheq_circula,
				bamsaldo.sald_nota_cr_trans,
				bamsaldo.sald_nota_db_trans,
				bamsaldo.sald_fecha_lib,
				bamsaldo.sald_fecha_ban,
				bamsaldo.sald_fecha_ult_concilia sald_fecha_conciliacion
        FROM bamsaldo ,
           bamcuent ,
			   bancos     
        WHERE ( bamcuent.cuen_g_financiero = bamsaldo.sald_grupo_financiero ) and   
       ( bamcuent.cuen_empresa = bamsaldo.sald_empresa ) and   
       ( bamcuent.cuen_no_cuenta = bamsaldo.sald_cuenta ) and  
        ( bamcuent.cuen_banco = bamsaldo.sald_banco ) and    
      ( bancos.banc_codigo = bamcuent.cuen_banco ) and    
      ( (  bamsaldo.sald_grupo_financiero = :g_financiero  ) and  
        (  bamsaldo.sald_empresa = :empresa  ) and   
       (  bamsaldo.sald_banco = :banco  ) and  
        (  bamsaldo.sald_cuenta = :no_cuenta  ) and  
        (  bamsaldo.sald_fecha_ini_periodo >= :fecha_ini  ) and     
     (  bamsaldo.sald_fecha_fin_periodo <= :fecha_fin ) )" arguments=(("g_financiero", number),("empresa", number),("banco", number),("no_cuenta", string),("fecha_ini", datetime),("fecha_fin", datetime)) )
