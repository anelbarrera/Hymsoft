table(column=(type=char(2) updatewhereclause=yes name=bampgoter_bamp_concepto_pago dbname="bampgoter.bamp_concepto_pago" dbalias=".bamp_concepto_pago" )
 column=(type=char(20) updatewhereclause=yes name=bampgoter_bamp_ruc dbname="bampgoter.bamp_ruc" dbalias=".bamp_ruc" )
 column=(type=char(2) updatewhereclause=yes name=bampgoter_bamp_digito dbname="bampgoter.bamp_digito" dbalias=".bamp_digito" )
 column=(type=char(1) updatewhereclause=yes name=bamp_tipo_persona dbname="bampgoter.bamp_tipo_persona" dbalias=".bamp_tipo_persona" )
 column=(type=char(60) updatewhereclause=yes name=bamp_a_nombre_de dbname="bampgoter.bamp_a_nombre_de" dbalias=".bamp_a_nombre_de" )
 column=(type=decimal(2) updatewhereclause=yes name=bamp_monto_factura dbname="bampgoter.bamp_monto_factura" dbalias=".bamp_monto_factura" )
 column=(type=char(20) updatewhereclause=yes name=bamp_numero_factura dbname="bampgoter.bamp_numero_factura" dbalias=".bamp_numero_factura" )
 column=(type=datetime updatewhereclause=yes name=bamp_fecha_factura dbname="bampgoter.bamp_fecha_factura" dbalias=".bamp_fecha_factura" )
 column=(type=datetime updatewhereclause=yes name=bamp_fecha_transaccion dbname="bampgoter.bamp_fecha_transaccion" dbalias=".bamp_fecha_transaccion" )
 column=(type=decimal(2) updatewhereclause=yes name=bamp_monto_factura dbname="bampgoter.bamp_monto_factura" dbalias=".bamp_monto_factura" )
 retrieve="  SELECT bampgoter.bamp_concepto_pago,   
         bampgoter.bamp_ruc,   
         bampgoter.bamp_digito,  
         bampgoter.bamp_tipo_persona,   
         bampgoter.bamp_a_nombre_de,   
         bampgoter.bamp_monto_factura,   
         bampgoter.bamp_numero_factura,   
         bampgoter.bamp_fecha_factura,   
			bamp_fecha_transaccion,
         bampgoter.bamp_monto_factura
    FROM bampgoter  
   WHERE ( bampgoter.bamp_g_financiero = :finan ) AND  
         ( bampgoter.bamp_empresa = :empr ) AND  
         ( datepart(mm,bampgoter.bamp_fecha_transaccion) = :mes ) AND  
         ( datepart(yy,bampgoter.bamp_fecha_transaccion) = :ann ) AND 
          ( bampgoter.bamp_concepto_pago is not null ) AND  
         ( bampgoter.bamp_estado = 'A' ) AND  
         ( bampgoter.bamp_transaccion not in ('OP') )" arguments=(("finan", number),("empr", number),("mes", number),("ann", number))  sort="bampgoter_bamp_ruc A bampgoter_bamp_digito A bamp_numero_factura A " )
