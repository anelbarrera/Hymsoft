 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"batdiari~" ) COMPUTE(NAME=~"0.00 saldo~") COLUMN(NAME=~"batdiari.btdi_g_financiero~") COLUMN(NAME=~"batdiari.btdi_empresa~") COLUMN(NAME=~"batdiari.btdi_tipo_transaccion~") COLUMN(NAME=~"batdiari.btdi_sub_transaccion~") COLUMN(NAME=~"batdiari.btdi_banco~") COLUMN(NAME=~"batdiari.btdi_no_cuenta~") COLUMN(NAME=~"batdiari.btdi_documento~") COLUMN(NAME=~"batdiari.btdi_ann~") COLUMN(NAME=~"batdiari.btdi_aplicacion~") COLUMN(NAME=~"batdiari.btdi_fecha_tran~") COLUMN(NAME=~"batdiari.btdi_tercero~") COLUMN(NAME=~"batdiari.btdi_a_nombre_de~") COLUMN(NAME=~"batdiari.btdi_comentario~") COLUMN(NAME=~"batdiari.btdi_estado~") COLUMN(NAME=~"batdiari.btdi_fecha_imprime~") COLUMN(NAME=~"batdiari.btdi_monto~") COLUMN(NAME=~"batdiari.btdi_aplica_origen~") COLUMN(NAME=~"batdiari.btdi_conciliacion~") COLUMN(NAME=~"batdiari.btdi_referencia~") COLUMN(NAME=~"batdiari.btdi_ruc~") COLUMN(NAME=~"batdiari.btdi_digito_verificador~") COLUMN(NAME=~"batdiari.btdi_naturaleza~") COLUMN(NAME=~"batdiari.btdi_cuenta~") COLUMN(NAME=~"batdiari.btdi_impreso~") COMPUTE(NAME=~"'               ' cuenta~") COMPUTE(NAME=~"'               ' cuenta_pro~") COMPUTE(NAME=~"'               ' cuenta_cli~") COLUMN(NAME=~"batdiari.btdi_historico~") COLUMN(NAME=~"batdiari.btdi_fecha_habilita_deposito~") COLUMN(NAME=~"batdiari.btdi_id_usuario_registra~") COLUMN(NAME=~"batdiari.btdi_comentario2~")WHERE(    EXP1 =~"batdiari.btdi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_aplicacion~"   OP =~"=~"    EXP2 =~"'BA'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_tipo_transaccion~"   OP =~"=~"    EXP2 =~":transaccion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_documento~"   OP =~"=~"    EXP2 =~":documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_ann~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"batdiari.btdi_tipo_transaccion+batdiari.btdi_sub_transaccion~"   OP =~"<>~"    EXP2 =~"'SISI'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_banco~"   OP =~"=~"    EXP2 =~":banco~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"batdiari.btdi_no_cuenta~"   OP =~"=~"    EXP2 =~":cuenta~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"batdiari.btdi_referencia~"   OP =~"=~"    EXP2 =~":referencia~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"documento~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"banco~" TYPE = number)  ARG(NAME = ~"cuenta~" TYPE = string)  ARG(NAME = ~"referencia~" TYPE = string) " update="batdiari" updatewhere=1 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("transaccion", string),("documento", string),("ann", number),("banco", number),("cuenta", string),("referencia", string)) )
