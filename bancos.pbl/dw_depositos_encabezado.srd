 column=(type=char(100) updatewhereclause=yes name=slip_motivo_eliminacion dbname="cctslips.slip_motivo_eliminacion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cctslips~" ) COLUMN(NAME=~"cctslips.slip_g_financiero~") COLUMN(NAME=~"cctslips.slip_empresa~") COLUMN(NAME=~"cctslips.slip_documento~") COLUMN(NAME=~"cctslips.slip_referencia~") COLUMN(NAME=~"cctslips.slip_ann~") COLUMN(NAME=~"cctslips.slip_banco~") COLUMN(NAME=~"cctslips.slip_cuenta~") COLUMN(NAME=~"cctslips.slip_fecha~") COLUMN(NAME=~"cctslips.slip_estado~") COLUMN(NAME=~"cctslips.slip_id~") COLUMN(NAME=~"cctslips.slip_fecha_registro~") COLUMN(NAME=~"cctslips.slip_observacion~") COLUMN(NAME=~"cctslips.slip_monto~") COLUMN(NAME=~"cctslips.slip_secuencia_banco_cuenta~") COMPUTE(NAME=~"fecha = getdate()~") COMPUTE(NAME=~"filtrar = 0~") COLUMN(NAME=~"cctslips.slip_fecha_eliminado~") COLUMN(NAME=~"cctslips.slip_usuario_eliminado~") COLUMN(NAME=~"cctslips.slip_motivo_eliminacion~")WHERE(    EXP1 =~"cctslips.slip_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctslips.slip_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctslips.slip_documento~"   OP =~"=~"    EXP2 =~":documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctslips.slip_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"documento~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " update="cctslips" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("documento", number),("ann", number)) )
