 column=(type=char(250) update=yes updatewhereclause=yes name=slip_observacion dbname="cctslips.slip_observacion" initial="SLIP DE DEPOSITO" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=slip_monto dbname="cctslips.slip_monto" )
