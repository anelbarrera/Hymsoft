table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=slip_g_financiero dbname="cctslips.slip_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=slip_empresa dbname="cctslips.slip_empresa" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=slip_documento dbname="cctslips.slip_documento" )
 column=(type=char(15) update=yes updatewhereclause=yes key=yes name=slip_referencia dbname="cctslips.slip_referencia" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=slip_ann dbname="cctslips.slip_ann" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=slip_banco dbname="cctslips.slip_banco" )
