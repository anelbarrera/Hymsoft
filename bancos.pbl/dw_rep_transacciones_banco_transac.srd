 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"batdiari~" )  TABLE(NAME=~"dgmsubse~" )  TABLE(NAME=~"bancos~" )  TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"dgmserie~" ) COLUMN(NAME=~"batdiari.btdi_g_financiero~") COLUMN(NAME=~"batdiari.btdi_empresa~") COLUMN(NAME=~"batdiari.btdi_sub_transaccion~") COLUMN(NAME=~"batdiari.btdi_banco~") COLUMN(NAME=~"batdiari.btdi_no_cuenta~") COLUMN(NAME=~"batdiari.btdi_documento~") COLUMN(NAME=~"batdiari.btdi_referencia~") COLUMN(NAME=~"batdiari.btdi_ann~") COLUMN(NAME=~"batdiari.btdi_fecha_tran~") COLUMN(NAME=~"batdiari.btdi_tercero~") COLUMN(NAME=~"batdiari.btdi_a_nombre_de~") COLUMN(NAME=~"batdiari.btdi_naturaleza~") COLUMN(NAME=~"batdiari.btdi_comentario~") COLUMN(NAME=~"batdiari.btdi_monto~") COLUMN(NAME=~"batdiari.btdi_aplica_origen~") COLUMN(NAME=~"batdiari.btdi_cuenta~") COLUMN(NAME=~"batdiari.btdi_historico~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"bancos.banc_descripcion~") COMPUTE(NAME=~" btdi_monto as debito~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"batdiari.btdi_tipo_transaccion~") COLUMN(NAME=~"dgmserie.mser_descripcion~")    JOIN (LEFT=~"dgmsubse.subs_g_financiero~"    OP =~"=~"RIGHT=~"batdiari.btdi_g_financiero~" )    JOIN (LEFT=~"dgmsubse.subs_empresa~"    OP =~"=~"RIGHT=~"batdiari.btdi_empresa~" )    JOIN (LEFT=~"dgmsubse.subs_transaccion~"    OP =~"=~"RIGHT=~"batdiari.btdi_tipo_transaccion~" )    JOIN (LEFT=~"dgmsubse.subs_sub_trans~"    OP =~"=~"RIGHT=~"batdiari.btdi_sub_transaccion~" )    JOIN (LEFT=~"batdiari.btdi_banco~"    OP =~"=~"RIGHT=~"bancos.banc_codigo~" )    JOIN (LEFT=~"batdiari.btdi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"batdiari.btdi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"batdiari.btdi_g_financiero~"    OP =~"=~"RIGHT=~"dgmserie.mser_g_financiero~" )    JOIN (LEFT=~"batdiari.btdi_empresa~"    OP =~"=~"RIGHT=~"dgmserie.mser_empresa~" )    JOIN (LEFT=~"batdiari.btdi_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmserie.mser_tipo_transaccion~" )WHERE(    EXP1 =~"batdiari.btdi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_banco~"   OP =~"=~"    EXP2 =~":banco~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_no_cuenta~"   OP =~"=~"    EXP2 =~":cuenta~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_fecha_tran~"   OP =~">=~"    EXP2 =~":desde~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_fecha_tran~"   OP =~"<=~"    EXP2 =~":hasta~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"banco~" TYPE = number)  ARG(NAME = ~"cuenta~" TYPE = string)  ARG(NAME = ~"desde~" TYPE = datetime)  ARG(NAME = ~"hasta~" TYPE = datetime) " arguments=(("grupo", number),("empresa", number),("banco", number),("cuenta", string),("desde", datetime),("hasta", datetime))  sort="btdi_fecha_tran A btdi_documento A " )
