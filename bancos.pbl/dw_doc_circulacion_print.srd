 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bamcuent~" )  TABLE(NAME=~"dgmserie~" )  TABLE(NAME=~"bancos~" )  TABLE(NAME=~"badsaldo~" ) COLUMN(NAME=~"dgmserie.mser_movimiento~") COLUMN(NAME=~"dgmserie.mser_descripcion~") COLUMN(NAME=~"bancos.banc_descripcion~") COLUMN(NAME=~"bamcuent.cuen_no_cuenta~") COLUMN(NAME=~"badsaldo.bdsa_g_financiero~") COLUMN(NAME=~"badsaldo.bdsa_empresa~") COLUMN(NAME=~"badsaldo.bdsa_tipo_transaccion~") COLUMN(NAME=~"badsaldo.bdsa_banco~") COLUMN(NAME=~"badsaldo.bdsa_no_cuenta~") COLUMN(NAME=~"badsaldo.bdsa_documento~") COLUMN(NAME=~"badsaldo.bdsa_referencia~") COLUMN(NAME=~"badsaldo.bdsa_a_nombre_de~") COLUMN(NAME=~"badsaldo.bdsa_monto~") COLUMN(NAME=~"badsaldo.bdsa_fecha_tran~") COLUMN(NAME=~"badsaldo.bdsa_circulacion~")    JOIN (LEFT=~"badsaldo.bdsa_g_financiero~"    OP =~"=~"RIGHT=~"dgmserie.mser_g_financiero~" )    JOIN (LEFT=~"badsaldo.bdsa_empresa~"    OP =~"=~"RIGHT=~"dgmserie.mser_empresa~" )    JOIN (LEFT=~"badsaldo.bdsa_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmserie.mser_tipo_transaccion~" )    JOIN (LEFT=~"badsaldo.bdsa_banco~"    OP =~"=~"RIGHT=~"bancos.banc_codigo~" )    JOIN (LEFT=~"badsaldo.bdsa_g_financiero~"    OP =~"=~"RIGHT=~"bamcuent.cuen_g_financiero~" )    JOIN (LEFT=~"badsaldo.bdsa_empresa~"    OP =~"=~"RIGHT=~"bamcuent.cuen_empresa~" )    JOIN (LEFT=~"badsaldo.bdsa_banco~"    OP =~"=~"RIGHT=~"bamcuent.cuen_banco~" )    JOIN (LEFT=~"badsaldo.bdsa_no_cuenta~"    OP =~"=~"RIGHT=~"bamcuent.cuen_no_cuenta~" )WHERE(    EXP1 =~"badsaldo.bdsa_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"badsaldo.bdsa_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"badsaldo.bdsa_banco~"   OP =~"=~"    EXP2 =~":banco~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"badsaldo.bdsa_no_cuenta~"   OP =~"=~"    EXP2 =~":no_cuenta~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"badsaldo.bdsa_fecha_fin_periodo~"   OP =~"=~"    EXP2 =~":fecha_fin~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"badsaldo.bdsa_circulacion~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"banco~" TYPE = number)  ARG(NAME = ~"no_cuenta~" TYPE = string)  ARG(NAME = ~"fecha_fin~" TYPE = datetime) " arguments=(("g_financiero", number),("empresa", number),("banco", number),("no_cuenta", string),("fecha_fin", datetime))  sort="dgmserie_mser_descripcion A badsaldo_bdsa_fecha_tran A badsaldo_bdsa_documento A " )
