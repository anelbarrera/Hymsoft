~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"batdiari.btdi_banco~"    OP =~"=~"RIGHT=~"bancos.banc_codigo~" )WHERE(    EXP1 =~"batdiari.btdi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_tipo_transaccion~"   OP =~"=~"    EXP2 =~":transaccion~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_sub_transaccion~"   OP =~"=~"    EXP2 =~":subtran~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_banco~"   OP =~"=~"    EXP2 =~":banco~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"batdiari.btdi_no_cuenta~"   OP =~"=~"    EXP2 =~":cuenta~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"batdiari.btdi_documento~"   OP =~"=~"    EXP2 =~":docu~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"batdiari.btdi_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"subtran~" TYPE = string)  ARG(NAME = ~"banco~" TYPE = number)  ARG(NAME = ~"cuenta~" TYPE = string)  ARG(NAME = ~"docu~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("transaccion", string),("subtran", string),("banco", number),("cuenta", string),("docu", string),("ann", number)) )
