detail(height=88 color="536870912" )
table(column=(type=char(1) updatewhereclause=yes name=tipo_registro dbname="tipo_registro" )
 column=(type=char(1) updatewhereclause=yes name=periodo_informado dbname="periodo_informado" )
 column=(type=char(2) updatewhereclause=yes name=tipo_persona dbname="tipo_persona" )
 column=(type=char(22) updatewhereclause=yes name=ruc dbname="ruc" )
 column=(type=char(5) updatewhereclause=yes name=empr_dijito_verificador dbname="dgmempre.empr_dijito_verificador" )
 column=(type=char(100) updatewhereclause=yes name=empr_razon_social dbname="dgmempre.empr_razon_social" )
 column=(type=char(1) updatewhereclause=yes name=total_registros dbname="total_registros" )
 column=(type=char(1) updatewhereclause=yes name=monto_total dbname="monto_total" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmempre~" ) COMPUTE(NAME=~"'1' tipo_registro~") COMPUTE(NAME=~"char(6) periodo_informado~") COMPUTE(NAME=~"'20' tipo_persona~") COMPUTE(NAME=~"rtrim(ltrim(convert(char(6),dgmempre.empr_ficha)))+'-'+rtrim(ltrim(convert(char(8),dgmempre.empr_rollo)))+'-'+rtrim(ltrim(convert(char(6),dgmempre.empr_imagen))) ruc~") COLUMN(NAME=~"dgmempre.empr_dijito_verificador~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COMPUTE(NAME=~"'' total_registros~") COMPUTE(NAME=~"'' monto_total~")WHERE(    EXP1 =~"dgmempre.empr_g_financiero~"   OP =~"=~"    EXP2 =~":finan~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"dgmempre.empr_empresa~"   OP =~"=~"    EXP2 =~":empre~" ) ) ARG(NAME = ~"finan~" TYPE = number)  ARG(NAME = ~"empre~" TYPE = number) " arguments=(("finan", number),("empre", number)) )
