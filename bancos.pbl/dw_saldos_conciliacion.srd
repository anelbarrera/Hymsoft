 column=(type=char(60) updatewhereclause=yes name=batdiari_btdi_a_nombre_de dbname="batdiari.btdi_a_nombre_de" dbalias=".btdi_a_nombre_de" )
 column=(type=decimal(2) updatewhereclause=yes name=btdi_monto dbname="batdiari.btdi_monto" dbalias=".btdi_monto" )
 column=(type=char(1) updatewhereclause=yes name=dgmserie_mser_movimiento dbname="dgmserie.mser_movimiento" dbalias=".mser_movimiento" )
 column=(type=char(1) updatewhereclause=yes name=batdiari_btdi_estado dbname="batdiari.btdi_estado" dbalias=".btdi_estado" )
 column=(type=char(30) updatewhereclause=yes name=dgmserie_mser_descripcion dbname="dgmserie.mser_descripcion" dbalias=".mser_descripcion" )
 column=(type=char(41) updatewhereclause=yes name=bancos_banc_descripcion dbname="bancos.banc_descripcion" dbalias=".banc_descripcion" )
 column=(type=char(40) updatewhereclause=yes name=bamcuent_cuen_no_cuenta dbname="bamcuent.cuen_no_cuenta" dbalias=".cuen_no_cuenta" )
 column=(type=char(8) updatewhereclause=yes name=batdiari_btdi_documento dbname="batdiari.btdi_documento" dbalias=".btdi_documento" )
 column=(type=datetime updatewhereclause=yes name=batdiari_btdi_fecha_reg dbname="batdiari.btdi_fecha_reg" dbalias=".btdi_fecha_reg" )
 column=(type=char(1) updatewhereclause=yes name=batdiari_btdi_conciliacion dbname="batdiari.btdi_conciliacion" dbalias=".btdi_conciliacion" )
 column=(type=char(1) updatewhereclause=yes name=btdi_naturaleza dbname="batdiari.btdi_naturaleza" dbalias=".btdi_naturaleza" )
 retrieve="SELECT  batdiari.btdi_g_financiero ,
           batdiari.btdi_empresa ,
           batdiari.btdi_transaccion btdi_tipo_transaccion ,
           batdiari.btdi_banco ,
           batdiari.btdi_aplicacion ,
           batdiari.btdi_no_cuenta ,
           batdiari.btdi_fecha_trans btdi_fecha_tran ,
           batdiari.btdi_a_nombre_de ,
           batdiari.btdi_monto ,
           dgmserie.mser_movimiento ,
           batdiari.btdi_estado ,
           dgmserie.mser_descripcion ,
           bancos.banc_descripcion ,
           bamcuent.cuen_no_cuenta ,
           batdiari.btdi_no_documento btdi_documento ,
           batdiari.btdi_fecha_reg ,
           batdiari.btdi_conciliacion ,
				batdiari.btdi_naturaleza    
        FROM batdiari ,
           bamcuent ,
           dgmserie ,
           bancos     
        WHERE ( dgmserie.mser_g_financiero = batdiari.btdi_g_financiero) and 
         ( dgmserie.mser_empresa = batdiari.btdi_empresa) and  
        ( dgmserie.mser_tipo_transaccion = batdiari.btdi_transaccion) and    
      ( bamcuent.cuen_g_financiero = batdiari.btdi_g_financiero ) and   
       ( bamcuent.cuen_empresa = batdiari.btdi_empresa ) and   
       ( bamcuent.cuen_no_cuenta = batdiari.btdi_no_cuenta ) and  
        ( bamcuent.cuen_banco = batdiari.btdi_banco ) and    
      ( bancos.banc_codigo = bamcuent.cuen_banco ) and    
      ( (  batdiari.btdi_g_financiero = :g_financiero  ) and  
        (  batdiari.btdi_empresa = :empresa  ) and   
       (  batdiari.btdi_banco = :banco  ) and  
        (  batdiari.btdi_no_cuenta = :no_cuenta  ) and  
        (  batdiari.btdi_fecha_trans >= :fecha_ini  ) and     
     (  batdiari.btdi_fecha_trans < dateadd(dd,1,:fecha_fin) ) and    
       ( batdiari.btdi_transaccion not in ( 'SI' ) ) )  " arguments=(("g_financiero", number),("empresa", number),("banco", number),("no_cuenta", string),("fecha_ini", datetime),("fecha_fin", datetime))  sort="btdi_tipo_transaccion A " )
