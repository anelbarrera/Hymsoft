table(column=(type=decimal(0) updatewhereclause=yes name=batdiari_btdi_g_financiero dbname="batdiari.btdi_g_financiero" dbalias=".btdi_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=batdiari_btdi_empresa dbname="batdiari.btdi_empresa" dbalias=".btdi_empresa" )
 column=(type=char(2) updatewhereclause=yes name=btdi_tipo_transaccion dbname="batdiari.btdi_tipo_transaccion" dbalias=".btdi_tipo_transaccion" )
