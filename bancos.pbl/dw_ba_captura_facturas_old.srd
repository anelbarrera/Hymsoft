 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bampgoter~" ) COLUMN(NAME=~"bampgoter.bamp_ruc~") COLUMN(NAME=~"bampgoter.bamp_digito~") COLUMN(NAME=~"bampgoter.bamp_tipo_persona~") COLUMN(NAME=~"bampgoter.bamp_a_nombre_de~") COLUMN(NAME=~"bampgoter.bamp_concepto_pago~") COLUMN(NAME=~"bampgoter.bamp_numero_factura~") COLUMN(NAME=~"bampgoter.bamp_fecha_factura~") COLUMN(NAME=~"bampgoter.bamp_monto_factura~") COLUMN(NAME=~"bampgoter.bamp_g_financiero~") COLUMN(NAME=~"bampgoter.bamp_empresa~") COLUMN(NAME=~"bampgoter.bamp_transaccion~") COLUMN(NAME=~"bampgoter.bamp_sub_trans~") COLUMN(NAME=~"bampgoter.bamp_banco~") COLUMN(NAME=~"bampgoter.bamp_no_cuenta~") COLUMN(NAME=~"bampgoter.bamp_no_documento~") COLUMN(NAME=~"bampgoter.bamp_ano~") COLUMN(NAME=~"bampgoter.bamp_aplicacion~") COLUMN(NAME=~"bampgoter.bamp_fecha_reg~") COLUMN(NAME=~"bampgoter.bamp_trans_asociada~") COLUMN(NAME=~"bampgoter.bamp_subtrans_asociada~") COLUMN(NAME=~"bampgoter.bamp_tercero~") COLUMN(NAME=~"bampgoter.bamp_secuencia~") COLUMN(NAME=~"bampgoter.bamp_estado~") COLUMN(NAME=~"bampgoter.bamp_fecha_transaccion~") COLUMN(NAME=~"bampgoter.bamp_tipo_compra~") COLUMN(NAME=~"bampgoter.bamp_itbm~") COLUMN(NAME=~"bampgoter.bamp_monto_total~")WHERE(    EXP1 =~"( bampgoter.bamp_g_financiero~"   OP =~"=~"    EXP2 =~":finan )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( bampgoter.bamp_empresa~"   OP =~"=~"    EXP2 =~":empr )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( bampgoter.bamp_transaccion~"   OP =~"=~"    EXP2 =~":transac )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( bampgoter.bamp_sub_trans~"   OP =~"=~"    EXP2 =~":subtran )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( bampgoter.bamp_banco~"   OP =~"=~"    EXP2 =~":banco )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( bampgoter.bamp_no_cuenta~"   OP =~"=~"    EXP2 =~":cta_bancaria )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( bampgoter.bamp_no_documento~"   OP =~"=~"    EXP2 =~":docto )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( bampgoter.bamp_ano~"   OP =~"=~"    EXP2 =~":ann )~" ) ) ARG(NAME = ~"finan~" TYPE = number)  ARG(NAME = ~"empr~" TYPE = number)  ARG(NAME = ~"transac~" TYPE = string)  ARG(NAME = ~"subtran~" TYPE = string)  ARG(NAME = ~"banco~" TYPE = number)  ARG(NAME = ~"cta_bancaria~" TYPE = string)  ARG(NAME = ~"docto~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="bampgoter" updatewhere=1 updatekeyinplace=yes arguments=(("finan", number),("empr", number),("transac", string),("subtran", string),("banco", number),("cta_bancaria", string),("docto", string),("ann", number)) )
