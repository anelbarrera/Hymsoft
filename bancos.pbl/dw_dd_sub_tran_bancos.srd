 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmsubse~" )  TABLE(NAME=~"dgmserie~" )  TABLE(NAME=~"dgmserdr~" ) COLUMN(NAME=~"dgmsubse.subs_transaccion~") COLUMN(NAME=~"dgmsubse.subs_sub_trans~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"dgmserie.mser_descripcion~") COMPUTE(NAME=~"dgmserie.mser_descripcion + ' / ' + dgmsubse.subs_descripcion descri~")    JOIN (LEFT=~"dgmserie.mser_g_financiero~"    OP =~"=~"RIGHT=~"dgmsubse.subs_g_financiero~" )    JOIN (LEFT=~"dgmserie.mser_empresa~"    OP =~"=~"RIGHT=~"dgmsubse.subs_empresa~" )    JOIN (LEFT=~"dgmserie.mser_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmsubse.subs_transaccion~" )    JOIN (LEFT=~"dgmserdr.serd_g_financiero~"    OP =~"=~"RIGHT=~"dgmsubse.subs_g_financiero~" )    JOIN (LEFT=~"dgmserdr.serd_empresa~"    OP =~"=~"RIGHT=~"dgmsubse.subs_empresa~" )    JOIN (LEFT=~"dgmserdr.serd_transaccion~"    OP =~"=~"RIGHT=~"dgmsubse.subs_transaccion~" )    JOIN (LEFT=~"dgmserdr.serd_sub_trans~"    OP =~"=~"RIGHT=~"dgmsubse.subs_sub_trans~" )WHERE(    EXP1 =~"dgmsubse.subs_g_financiero~"   OP =~"=~"    EXP2 =~":stran_grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"dgmsubse.subs_empresa~"   OP =~"=~"    EXP2 =~":stran_empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmsubse.subs_transaccion+dgmsubse.subs_sub_trans~"   OP =~"<>~"    EXP2 =~"'SISI-'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmserdr.serd_aplicacion~"   OP =~"=~"    EXP2 =~"'BA'~" ) ) ARG(NAME = ~"stran_grupo~" TYPE = number)  ARG(NAME = ~"stran_empresa~" TYPE = number) " arguments=(("stran_grupo", number),("stran_empresa", number)) )
