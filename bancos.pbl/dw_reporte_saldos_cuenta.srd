 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"bamcuent~" )  TABLE(NAME=~"bancos~" ) COLUMN(NAME=~"bancos.banc_descripcion~") COLUMN(NAME=~"bamcuent.cuen_no_cuenta~") COMPUTE(NAME=~"0.00 saldo~") COLUMN(NAME=~"bamcuent.cuen_banco~") COMPUTE(NAME=~"0.00 saldo_5~") COMPUTE(NAME=~"0.00 saldo_4~") COMPUTE(NAME=~"0.00 saldo_3~") COMPUTE(NAME=~"0.00 saldo_2~") COMPUTE(NAME=~"0.00 saldo_1~") COMPUTE(NAME=~"0.00 saldo_inicial~") COMPUTE(NAME=~"0.00 saldo_actual~") COMPUTE(NAME=~"0.00 depositos~") COMPUTE(NAME=~"0.00 cheques~") COMPUTE(NAME=~"0.00 ndebito~") COMPUTE(NAME=~"0.00 ncredito~") COMPUTE(NAME=~"0.00 disponible~") COMPUTE(NAME=~"0.00 saldo_6~") COMPUTE(NAME=~"'' saldo_f1~") COMPUTE(NAME=~"'' saldo_f2~") COMPUTE(NAME=~"'' saldo_f3~") COMPUTE(NAME=~"'' saldo_f4~") COMPUTE(NAME=~"'' saldo_f5~") COMPUTE(NAME=~"'' saldo_f6~")    JOIN (LEFT=~"bancos.banc_codigo~"    OP =~"=~"RIGHT=~"bamcuent.cuen_banco~" )WHERE(    EXP1 =~"bamcuent.cuen_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"bamcuent.cuen_empresa~"   OP =~"=~"    EXP2 =~":empresa~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="bancos_banc_descripcion A " )
