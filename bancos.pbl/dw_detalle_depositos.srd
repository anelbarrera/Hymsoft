table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=dslip_g_financiero dbname="ccdslips.dslip_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=dslip_empresa dbname="ccdslips.dslip_empresa" )
