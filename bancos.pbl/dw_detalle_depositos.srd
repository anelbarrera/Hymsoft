 column=(type=datetime update=yes updatewhereclause=yes name=dslip_fecha dbname="ccdslips.dslip_fecha" )
 column=(type=char(100) updatewhereclause=yes name=empresa dbname="empresa" )
 column=(type=long updatewhereclause=yes name=aplicado dbname="aplicado" values="	1/	0" )
 column=(type=decimal(2) update=yes updatewhereclause=yes name=dslip_monto_original dbname="ccdslips.dslip_monto_original" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ccdslips~" ) COLUMN(NAME=~"ccdslips.dslip_g_financiero~") COLUMN(NAME=~"ccdslips.dslip_empresa~") COLUMN(NAME=~"ccdslips.dslip_documento~") COLUMN(NAME=~"ccdslips.dslip_referencia~") COLUMN(NAME=~"ccdslips.dslip_ann~") COLUMN(NAME=~"ccdslips.dslip_empresa_ori~") COLUMN(NAME=~"ccdslips.dslip_aplicacion_ori~") COLUMN(NAME=~"ccdslips.dslip_transaccion_ori~") COLUMN(NAME=~"ccdslips.dslip_sub_transaccion_ori~") COLUMN(NAME=~"ccdslips.dslip_documento_ori~") COLUMN(NAME=~"ccdslips.dslip_referencia_ori~") COLUMN(NAME=~"ccdslips.dslip_ann_ori~") COLUMN(NAME=~"ccdslips.dslip_monto~") COLUMN(NAME=~"ccdslips.dslip_fecha~") COMPUTE(NAME=~"empresa= (select e.empr_razon_social from dgmempre e where e.empr_empresa = ccdslips.dslip_empresa_ori )~") COMPUTE(NAME=~"aplicado = 0~") COLUMN(NAME=~"ccdslips.dslip_monto_original~")WHERE(    EXP1 =~"ccdslips.dslip_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdslips.dslip_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdslips.dslip_documento~"   OP =~"=~"    EXP2 =~":documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdslips.dslip_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"documento~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " update="ccdslips" updatewhere=1 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("documento", number),("ann", number)) )
