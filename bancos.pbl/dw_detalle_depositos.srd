 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=dslip_documento_ori dbname="ccdslips.dslip_documento_ori" )
 column=(type=char(15) update=yes updatewhereclause=yes key=yes name=dslip_referencia_ori dbname="ccdslips.dslip_referencia_ori" )
