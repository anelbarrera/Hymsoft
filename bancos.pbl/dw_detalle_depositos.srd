 column=(type=char(15) update=yes updatewhereclause=yes key=yes name=dslip_referencia dbname="ccdslips.dslip_referencia" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=dslip_ann dbname="ccdslips.dslip_ann" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=dslip_empresa_ori dbname="ccdslips.dslip_empresa_ori" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=dslip_aplicacion_ori dbname="ccdslips.dslip_aplicacion_ori" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=dslip_transaccion_ori dbname="ccdslips.dslip_transaccion_ori" )
