 column=(type=char(100) updatewhereclause=yes name=usuarios_usua_nombre dbname="usuarios.usua_nombre" dbalias=".usua_nombre" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"ccdslips~" )  TABLE(NAME=~"cctslips~" )  TABLE(NAME=~"bancos~" )  TABLE(NAME=~"dgmsubse~" )  TABLE(NAME=~"usuarios~" ) COLUMN(NAME=~"cctslips.slip_documento~") COLUMN(NAME=~"cctslips.slip_referencia~") COLUMN(NAME=~"cctslips.slip_fecha~") COLUMN(NAME=~"bancos.banc_descripcion~") COLUMN(NAME=~"cctslips.slip_cuenta~") COLUMN(NAME=~"cctslips.slip_observacion~") COLUMN(NAME=~"cctslips.slip_monto~") COMPUTE(NAME=~"empresa= (select e.empr_razon_social from dgmempre e where e.empr_empresa = ccdslips.dslip_empresa_ori )~") COLUMN(NAME=~"ccdslips.dslip_transaccion_ori~") COLUMN(NAME=~"ccdslips.dslip_documento_ori~") COLUMN(NAME=~"ccdslips.dslip_referencia_ori~") COLUMN(NAME=~"ccdslips.dslip_monto~") COLUMN(NAME=~"ccdslips.dslip_fecha~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"usuarios.usua_nombre~")    JOIN (LEFT=~"cctslips.slip_g_financiero~"    OP =~"=~"RIGHT=~"ccdslips.dslip_g_financiero~" )    JOIN (LEFT=~"cctslips.slip_empresa~"    OP =~"=~"RIGHT=~"ccdslips.dslip_empresa~" )    JOIN (LEFT=~"cctslips.slip_documento~"    OP =~"=~"RIGHT=~"ccdslips.dslip_documento~" )    JOIN (LEFT=~"cctslips.slip_referencia~"    OP =~"=~"RIGHT=~"ccdslips.dslip_referencia~" )    JOIN (LEFT=~"cctslips.slip_ann~"    OP =~"=~"RIGHT=~"ccdslips.dslip_ann~" )    JOIN (LEFT=~"cctslips.slip_banco~"    OP =~"=~"RIGHT=~"bancos.banc_codigo~" )    JOIN (LEFT=~"ccdslips.dslip_g_financiero~"    OP =~"=~"RIGHT=~"dgmsubse.subs_g_financiero~" )    JOIN (LEFT=~"ccdslips.dslip_empresa_ori~"    OP =~"=~"RIGHT=~"dgmsubse.subs_empresa~" )    JOIN (LEFT=~"ccdslips.dslip_transaccion_ori~"    OP =~"=~"RIGHT=~"dgmsubse.subs_transaccion~" )    JOIN (LEFT=~"ccdslips.dslip_sub_transaccion_ori~"    OP =~"=~"RIGHT=~"dgmsubse.subs_sub_trans~" )    JOIN (LEFT=~"cctslips.slip_id~"    OP =~"=~"RIGHT=~"usuarios.usua_id~" )WHERE(    EXP1 =~"ccdslips.dslip_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdslips.dslip_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdslips.dslip_documento~"   OP =~"=~"    EXP2 =~":documento~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"ccdslips.dslip_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"documento~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("documento", number),("ann", number)) )
