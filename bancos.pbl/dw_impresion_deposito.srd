 column=(type=char(100) updatewhereclause=yes name=empresa dbname="empresa" )
 column=(type=char(2) updatewhereclause=yes name=ccdslips_dslip_transaccion_ori dbname="ccdslips.dslip_transaccion_ori" dbalias=".dslip_transaccion_ori" )
