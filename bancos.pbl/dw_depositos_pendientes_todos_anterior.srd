table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=movi_g_financiero dbname="cctmovim.movi_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=movi_empresa dbname="cctmovim.movi_empresa" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=movi_aplicacion dbname="cctmovim.movi_aplicacion" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=movi_tipo_transaccion dbname="cctmovim.movi_tipo_transaccion" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=movi_sub_transaccion dbname="cctmovim.movi_sub_transaccion" )
 column=(type=char(8) update=yes updatewhereclause=yes key=yes name=movi_documento dbname="cctmovim.movi_documento" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=movi_anno dbname="cctmovim.movi_anno" )
 column=(type=char(15) updatewhereclause=yes key=yes name=movi_referencia dbname="cctmovim.movi_referencia" )
 column=(type=char(10) updatewhereclause=yes key=yes name=movi_sucursal dbname="cctmovim.movi_sucursal" )
 column=(type=datetime updatewhereclause=yes name=movi_fecha_tran dbname="cctmovim.movi_fecha_tran" )
 column=(type=decimal(2) updatewhereclause=yes name=movi_monto dbname="cctmovim.movi_monto" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=movi_cant_depositada dbname="cctmovim.movi_cant_depositada" )
 column=(type=char(100) updatewhereclause=yes name=empresa dbname="empresa" )
 column=(type=decimal(4) updatewhereclause=yes name=por_depositar dbname="por_depositar" )
 column=(type=long updatewhereclause=yes name=aplicar dbname="aplicar" initial="0" values="	1/	0" )
 column=(type=decimal(2) updatewhereclause=yes name=movi_efectivo dbname="cctmovim.movi_efectivo" )
 column=(type=decimal(2) updatewhereclause=yes name=movi_cheque dbname="cctmovim.movi_cheque" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cctmovim~" ) COLUMN(NAME=~"cctmovim.movi_g_financiero~") COLUMN(NAME=~"cctmovim.movi_empresa~") COLUMN(NAME=~"cctmovim.movi_aplicacion~") COLUMN(NAME=~"cctmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cctmovim.movi_sub_transaccion~") COLUMN(NAME=~"cctmovim.movi_documento~") COLUMN(NAME=~"cctmovim.movi_anno~") COLUMN(NAME=~"cctmovim.movi_referencia~") COLUMN(NAME=~"cctmovim.movi_sucursal~") COLUMN(NAME=~"cctmovim.movi_fecha_tran~") COLUMN(NAME=~"cctmovim.movi_monto~") COLUMN(NAME=~"cctmovim.movi_cant_depositada~") COMPUTE(NAME=~"empresa= (select e.empr_razon_social from dgmempre e where e.empr_empresa = cctmovim.movi_empresa )~") COMPUTE(NAME=~"por_depositar = movi_monto - movi_cant_depositada~") COMPUTE(NAME=~"aplicar = 0~") COLUMN(NAME=~"cctmovim.movi_efectivo~") COLUMN(NAME=~"cctmovim.movi_cheque~")WHERE(    EXP1 =~"cctmovim.movi_tipo_transaccion~"   OP =~"in~"    EXP2 =~"('RC','FC')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctmovim.movi_estado~"   OP =~"=~"    EXP2 =~"'IM'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_sucursal~"   OP =~"=~"    EXP2 =~":sucursal~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctmovim.movi_fecha_tran~"   OP =~">=~"    EXP2 =~"'01/01/2020'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(cctmovim.movi_efectivo~"   OP =~"<>~"    EXP2 =~"0~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"cctmovim.movi_cheque~"   OP =~"<>~"    EXP2 =~"0)~" ) ) ARG(NAME = ~"sucursal~" TYPE = string) " update="cctmovim" updatewhere=1 updatekeyinplace=yes arguments=(("sucursal", string))  sort="empresa A movi_cheque A movi_efectivo A movi_fecha_tran A " )
