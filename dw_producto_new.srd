retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" ) TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"inmprodu.prod_g_financiero~") COLUMN(NAME=~"inmprodu.prod_empresa~") COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_owner~") COLUMN(NAME=~"inmprodu.prod_producto_dos~") COLUMN(NAME=~"inmprodu.prod_barra~") COLUMN(NAME=~"inmprodu.prod_descripcion_dos~") COLUMN(NAME=~"inmprodu.prod_division~") COLUMN(NAME=~"inmprodu.prod_grupo~") COLUMN(NAME=~"inmprodu.prod_sub_grupo~") COLUMN(NAME=~"inmprodu.prod_clase~") COLUMN(NAME=~"inmprodu.prod_num_producto~") COLUMN(NAME=~"inmprodu.prod_num_tipo~") COLUMN(NAME=~"inmprodu.prod_compuesto~") COLUMN(NAME=~"inmprodu.prod_marca~") COLUMN(NAME=~"inmprodu.prod_medida~") COLUMN(NAME=~"inmprodu.prod_color~") COLUMN(NAME=~"inmprodu.prod_cod_clase_tam~") COLUMN(NAME=~"inmprodu.prod_costo_fob~") COLUMN(NAME=~"inmprodu.prod_arancel~") COLUMN(NAME=~"inmprodu.prod_status~") COLUMN(NAME=~"inmprodu.prod_estatus_ref~") COLUMN(NAME=~"inmprodu.prod_foto_dir~") COLUMN(NAME=~"inmprodu.prod_peso~") COLUMN(NAME=~"inmprodu.prod_cubicaje~") COLUMN(NAME=~"inmprodu.prod_pais~") COLUMN(NAME=~"inmprodu.prod_precio1~") COLUMN(NAME=~"inmprodu.prod_precio2~") COLUMN(NAME=~"inmprodu.prod_precio3~") COLUMN(NAME=~"inmprodu.prod_precio4~") COLUMN(NAME=~"inmprodu.prod_precio5~") COLUMN(NAME=~"inmprodu.prod_observacion~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COLUMN(NAME=~"inmprodu.prod_peso_descripcion~") COLUMN(NAME=~"inmprodu.prod_empaque_descripcion~") COLUMN(NAME=~"inmprodu.prod_peso_unidad_medida~") COLUMN(NAME=~"inmprodu.prod_id_usuario~") COLUMN(NAME=~"inmprodu.prod_punto_minimo~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COLUMN(NAME=~"inmprodu.prod_tercero~") COMPUTE(NAME=~"0 copiar~") COLUMN(NAME=~"inmprodu.prod_descuento_siono~") COLUMN(NAME=~"inmprodu.prod_descuento_maximo~") COLUMN(NAME=~"inmprodu.prod_descuento~") COLUMN(NAME=~"inmprodu.prod_kilates~") COLUMN(NAME=~"inmprodu.prod_costo_promedio~") COLUMN(NAME=~"inmprodu.prod_producto_referencia~") COLUMN(NAME=~"inmprodu.prod_cod_brillante1~") COLUMN(NAME=~"inmprodu.prod_cod_brillante2~") COLUMN(NAME=~"inmprodu.prod_cod_brillante3~") COLUMN(NAME=~"inmprodu.prod_cod_brillante4~") COLUMN(NAME=~"inmprodu.prod_peso_brillante1~") COLUMN(NAME=~"inmprodu.prod_peso_brillante2~") COLUMN(NAME=~"inmprodu.prod_peso_brillante3~") COLUMN(NAME=~"inmprodu.prod_peso_brillante4~") COLUMN(NAME=~"inmprodu.prod_peso_neto~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_doc~") COLUMN(NAME=~"inmprodu.prod_alto~") COLUMN(NAME=~"inmprodu.prod_ancho~") COLUMN(NAME=~"inmprodu.prod_largo~") COMPUTE(NAME=~"inmprodu.prod_cubicaje * inmprodu.prod_empaque cubicaje~") COMPUTE(NAME=~"inmprodu.prod_peso * inmprodu.prod_empaque peso~") COLUMN(NAME=~"inmprodu.prod_cantidad_limite~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_metros_cubicos~") COLUMN(NAME=~"inmprodu.prod_punto_maximo~") COLUMN(NAME=~"inmprodu.prod_cant_a_pedir~") COMPUTE(NAME=~"datediff(month, prod_entrada_fecha, getdate()) mes~") COMPUTE(NAME=~"case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_reserva_total/inamedid.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_reserva_total/inamedid.medi_cantidad)) end reserva~") COMPUTE(NAME=~"case medi_tipo_medida when 10 then convert(numeric(11,0),((inmprodu.prod_existencia_total - prod_reserva_total) /inamedid.medi_cantidad)) else convert(numeric(11,3),((inmprodu.prod_existencia_total - prod_reserva_total) /inamedid.medi_cantidad)) end disponible~") COMPUTE(NAME=~"case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_existencia_total/inamedid.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_existencia_total/inamedid.medi_cantidad)) end entero~") COMPUTE(NAME=~"costo_fob = ' '~") COMPUTE(NAME=~"costo_cif = ' '~") COMPUTE(NAME=~"costo_promedio = ' '~") COMPUTE(NAME=~"ver_en_letras = 0~") COMPUTE(NAME=~"armar_descripcion = 0~") COLUMN(NAME=~"inmprodu.prod_itbm_local~") COLUMN(NAME=~"inmprodu.prod_orden_compra~") COLUMN(NAME=~"inmprodu.prod_cantidad_oc~") COLUMN(NAME=~"inmprodu.prod_costo_oc~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_costo_cif~") COLUMN(NAME=~"inmprodu.prod_sku~") COLUMN(NAME=~"inmprodu.prod_foto_catalogo~") COLUMN(NAME=~"inmprodu.prod_gramaje~") COLUMN(NAME=~"inmprodu.prod_nivel1~") COLUMN(NAME=~"inmprodu.prod_nivel2~") COLUMN(NAME=~"inmprodu.prod_nivel3~") COLUMN(NAME=~"inmprodu.prod_nivel4~") COLUMN(NAME=~"inmprodu.prod_nivel5~") COLUMN(NAME=~"inmprodu.prod_foto_editada~") COLUMN(NAME=~"inmprodu.prod_contrato~") COLUMN(NAME=~"inmprodu.prod_gramaje_tela~") JOIN (LEFT=~"inmprodu.prod_medida~" OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE( EXP1 =~"( inmprodu.prod_g_financiero~" OP =~"=~" EXP2 =~":grupo )~" LOGIC =~"and~" ) WHERE( EXP1 =~"( inmprodu.prod_empresa~" OP =~"=~" EXP2 =~":empresa )~" LOGIC =~"and~" ) WHERE( EXP1 =~"( inmprodu.prod_producto~" OP =~"=~" EXP2 =~":producto )~" ) ) ARG(NAME = ~"grupo~" TYPE = number) ARG(NAME = ~"empresa~" TYPE = number) ARG(NAME = ~"producto~" TYPE = string) " update="inmprodu" updatewhere=0 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("producto", string)) )
