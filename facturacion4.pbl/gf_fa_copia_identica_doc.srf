							getdate(),
							fatdiari.fact_fecha_modificacion,   
							fatdiari.fact_dias_pago,   
							fatdiari.fact_consignado,   
							fatdiari.fact_a_nombre,   
							fatdiari.fact_a_nombre_direccion,   
