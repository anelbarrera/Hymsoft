		else	//Inserta de Factura a Proformas
			if ll_sw = 4 then
				//No calcula la fecha proxima, ya que la copia se hace con la fecha original de la factura	
				//Encabezado de Facturas para Proformas
			  INSERT INTO fatprofo  
						( prof_g_financiero,   
						  prof_empresa,   
						  prof_tipo,   
						  prof_no_proforma,   
						  prof_ann,   
						  prof_cliente,   
						  prof_ruc_cliente,   
