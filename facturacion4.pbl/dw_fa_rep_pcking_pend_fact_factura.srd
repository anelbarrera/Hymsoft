 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaregio~" )  TABLE(NAME=~"vi_factuapasar~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_icono~") COLUMN(NAME=~"dgmempre.empr_logo_f~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"dgaregio.regi_descripcion~") COLUMN(NAME=~"vi_factuapasar.fact_g_financiero~") COLUMN(NAME=~"vi_factuapasar.fact_empresa~") COLUMN(NAME=~"vi_factuapasar.fact_tipo~") COLUMN(NAME=~"vi_factuapasar.fact_no_pedido~") COLUMN(NAME=~"vi_factuapasar.fact_ann~") COLUMN(NAME=~"vi_factuapasar.fact_no_factura~") COLUMN(NAME=~"vi_factuapasar.fact_cliente~") COLUMN(NAME=~"vi_factuapasar.fact_ruc_cliente~") COLUMN(NAME=~"vi_factuapasar.fact_fecha~") COLUMN(NAME=~"vi_factuapasar.fact_monto_final~") COLUMN(NAME=~"vi_factuapasar.fact_a_nombre~") COLUMN(NAME=~"vi_factuapasar.fact_condicion_pago~") COLUMN(NAME=~"vi_factuapasar.fact_bultos_total~") COLUMN(NAME=~"vi_factuapasar.fact_cubicaje_total~") COLUMN(NAME=~"vi_factuapasar.vend_nombre~") COLUMN(NAME=~"vi_factuapasar.fact_se_despacho~") COLUMN(NAME=~"vi_factuapasar.fact_marca~")    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgaregio.regi_pais~" )    JOIN (LEFT=~"dgmterce.terc_region~"    OP =~"=~"RIGHT=~"dgaregio.regi_codigo_region~" )    JOIN (LEFT=~"dgmempre.empr_g_financiero~"    OP =~"=~"RIGHT=~"vi_factuapasar.fact_g_financiero~" )    JOIN (LEFT=~"dgmempre.empr_empresa~"    OP =~"=~"RIGHT=~"vi_factuapasar.fact_empresa~" )    JOIN (LEFT=~"vi_factuapasar.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"((vi_factuapasar.fact_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factuapasar.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa ) ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factuapasar.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_factuapasar.fact_fecha~"   OP =~"<~"    EXP2 =~"dateadd(dd,1,:fecha_h)))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"vi_factuapasar.fact_no_pedido~"   OP =~"not like~"    EXP2 =~"~~~"%NC%~~~"~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha~" TYPE = date)  ARG(NAME = ~"fecha_h~" TYPE = date) " arguments=(("g_financiero", number),("empresa", number),("fecha", date),("fecha_h", date))  sort="dias_pendientes D " )
