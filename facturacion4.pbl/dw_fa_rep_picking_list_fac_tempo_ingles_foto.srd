 retrieve="  SELECT dgmempre.empr_direccion,   
         dgmempre.empr_apartado_postal,   
         dgmempre.empr_telefono1,   
         dgmempre.empr_telefono2,   
         dgmempre.empr_fax1,   
         dgmempre.empr_fax2,   
         dgmempre.empr_e_mail,   
         inmprodu.prod_marca,   
         inmprodu.prod_pais,   
         dgmempre.empr_ficha,   
         dgmempre.empr_rollo,   
         dgmempre.empr_imagen,   
         dgmempre.empr_dijito_verificador,   
         fatdiari.fact_empresa,   
         fatdiari.fact_cliente,   
         fatdiari.fact_ruc_cliente,   
         fatdiari.fact_condicion_pago,   
         fatdiari.fact_tipo_venta,   
         fatdiari.fact_tipo_movimiento,   
         fatdiari.fact_no_traspaso,   
         fatdiari.fact_fecha,   
         fatdiari.fact_fecha_creacion,   
         fatdiari.fact_fecha_modificacion,   
         fatdiari.fact_dias_pago,   
         fatdiari.fact_fecha_fin_plazo,   
         fatdiari.fact_fecha_cancelado,   
         fatdiari.fact_consignado,   
         fatdiari.fact_a_nombre,   
         fatdiari.fact_a_nombre_direccion,   
         fatdiari.fact_despachado,   
         fatdiari.fact_via,   
         fatdiari.fact_con_emb_no,   
         fatdiari.fact_marca,   
         fatdiari.fact_bultos_total,   
         fatdiari.fact_cubicaje_total,   
         fatdiari.fact_peso_total,   
         fatdiari.fact_unidad_peso,   
         fatdiari.fact_gastos_total,   
         fatdiari.fact_monto_fact_total,   
         fatdiari.fact_descuento_subt_deta,   
         fatdiari.fact_por_descuento,   
         fatdiari.fact_supervisor,   
         fatdiari.fact_monto_final,   
         fatdiari.fact_comentario,   
         fatdiari.fact_estado,   
         fatdiari.fact_act_cliente,   
         fatdiari.fact_act_inventario,   
         fatdiari.fact_act_conta,   
         fatdiari.fact_cerrada,   
         fatdiari.fact_referencia_fac,   
         fatdiari.fact_monto_abonado,   
         faddiari.facd_pedido_original,   
         faddiari.facd_linea,   
         faddiari.facd_producto_servicio,   
         faddiari.facd_codigo_item,   
         faddiari.facd_descripcion_alterna,   
         faddiari.facd_cubicaje,   
         faddiari.facd_peso,   
         faddiari.facd_unidad_peso,   
         faddiari.facd_unidad_producto,   
         faddiari.facd_precio_mayor,   
         faddiari.facd_precio_menor,   
         faddiari.facd_bodega,   
         faddiari.facd_costo_fob,   
         faddiari.facd_costo_cif,   
         faddiari.facd_precio_unidad_producto,   
         faddiari.facd_unidad_venta,   
         faddiari.facd_cantidad,   
         faddiari.facd_cantidad_fraccion,   
         faddiari.facd_monto_total,   
         faddiari.facd_por_descuento,   
         faddiari.facd_monto_final,   
         faddiari.facd_fecha_reg,   
         faddiari.facd_usuario,   
         faddiari.facd_supervisor,   
         faddiari.facd_bultos,   
         faddiari.facd_pais,   
         faddiari.facd_ubicacion,   
         faddiari.facd_cant_devuelta,   
         faddiari.facd_linea_articulo_dev,   
         dgapais.pais_descripcion,   
         fatdiari.fact_g_financiero,   
         faaparam.fara_logo_f,   
         faaparam.fara_logo,   
         dgaperio.peri_descripcion,   
         inmprodu.prod_empaque,   
         inmprodu.prod_empaque_descripcion,   
         inmprodu.prod_medida,   
         inamedid.medi_cantidad,   
         inmprodu.prod_empaque_um,   
         faddiari.facd_tipo,   
         faddiari.facd_no_pedido,   
         faddiari.facd_ann,   
         faddiari.facd_g_financiero,   
         faddiari.facd_empresa,   
         fatdiari.fact_no_pedido,   
         fatdiari.fact_tipo,   
         fatdiari.fact_ann,   
         fatdiari.fact_no_factura,   
         faddiari.facd_index,   
         convert(numeric(15,0),( inmprodu.prod_existencia_total /inamedid.medi_cantidad)) entero,   
         convert(numeric(15,0),(( inmprodu.prod_existencia_total - inmprodu.prod_reserva_total )/inamedid.medi_cantidad)) dis_entero,   
         (inmprodu.prod_existencia_total - inmprodu.prod_reserva_total ) - (convert(numeric(15,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total ) / inamedid.medi_cantidad)) * inamedid.medi_cantidad) dis_fraccion,   
         inmprodu.prod_existencia_total - (convert(numeric(15,0),( inmprodu.prod_existencia_total / inamedid.medi_cantidad)) * inamedid.medi_cantidad) fraccion,   
         inmprodu.prod_existencia_total - inmprodu.prod_reserva_total disponible,    
         cramarca.amar_nombre_marca,   
         cracolor.acol_nombre_color,   
         cratallas.talla_descripcion,   
         inmprodu.prod_peso,   
         inmprodu.prod_cubicaje,   
         faddiari.facd_bulto_inicio,   
         faddiari.facd_bulto_fin,   
         cratipos.atip_descripcion_tipo,   
         inmprodu.prod_cod_alternativo,   
         inmprodu.prod_barra,   
         inmprodu.prod_descripcion_dos,   
         inmprodu.prod_observacion,  
		inmprodu.prod_foto_dir, 
         cramaterial.mat_compo  
    FROM inmprodu LEFT OUTER JOIN dgapais ON inmprodu.prod_pais = dgapais.pais_pais LEFT OUTER JOIN inamedid ON inmprodu.prod_medida = inamedid.medi_medida LEFT OUTER JOIN cracolor ON inmprodu.prod_g_financiero = cracolor.acol_g_financiero AND inmprodu.prod_empresa = cracolor.acol_empresa AND inmprodu.prod_color = cracolor.acol_num_color LEFT OUTER JOIN cramarca ON inmprodu.prod_g_financiero = cramarca.amar_g_financiero AND inmprodu.prod_empresa = cramarca.amar_empresa AND inmprodu.prod_marca = cramarca.amar_num_marca LEFT OUTER JOIN cratallas ON inmprodu.prod_g_financiero = cratallas.talla_g_financiero AND inmprodu.prod_empresa = cratallas.talla_empresa AND inmprodu.prod_cod_clase_tam = cratallas.talla_codigo LEFT OUTER JOIN cratipos ON inmprodu.prod_g_financiero = cratipos.atip_g_financiero AND inmprodu.prod_empresa = cratipos.atip_empresa AND inmprodu.prod_num_tipo = cratipos.atip_num_tipo LEFT OUTER JOIN cramaterial ON inmprodu.prod_g_financiero = cramaterial.mat_g_financiero AND inmprodu.prod_empresa = cramaterial.mat_empresa AND inmprodu.prod_material = cramaterial.mat_cod_material,   
         fatdiari,   
         faddiari,   
         dgmempre,   
         faaparam,   
         dgaperio  
   WHERE ( fatdiari.fact_g_financiero = faddiari.facd_g_financiero ) and  
         ( fatdiari.fact_empresa = faddiari.facd_empresa ) and  
         ( fatdiari.fact_tipo = faddiari.facd_tipo ) and  
         ( fatdiari.fact_no_pedido = faddiari.facd_no_pedido ) and  
         ( fatdiari.fact_ann = faddiari.facd_ann ) and  
         ( faddiari.facd_g_financiero = inmprodu.prod_g_financiero ) and  
         ( faddiari.facd_empresa = inmprodu.prod_empresa ) and  
         ( faddiari.facd_codigo_item = inmprodu.prod_producto ) and  
         ( fatdiari.fact_g_financiero = dgmempre.empr_g_financiero ) and  
         ( fatdiari.fact_empresa = dgmempre.empr_empresa ) and  
         ( fatdiari.fact_g_financiero = faaparam.fara_g_financiero ) and  
         ( fatdiari.fact_empresa = faaparam.fara_empresa ) and  
         ( fatdiari.fact_dias_pago = dgaperio.peri_periodo ) and  
         ( fatdiari.fact_g_financiero = :grupo) AND  
         ( fatdiari.fact_empresa = :empresa) AND  
         ( fatdiari.fact_tipo = :tipo) AND  
         ( fatdiari.fact_no_pedido = :pedido) AND  
         ( fatdiari.fact_ann = :an) AND  
         ( dgaperio.peri_aplicacion = 'FA' )    
" arguments=(("grupo", number),("empresa", number),("tipo", string),("pedido", string),("an", number))  sort="facd_bulto_inicio A facd_index A " )
