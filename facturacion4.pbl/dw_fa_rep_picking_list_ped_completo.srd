cio_unidad_producto~") COLUMN(NAME=~"fadpedid.dped_unidad_venta~") COLUMN(NAME=~"fadpedid.dped_cantidad~") COLUMN(NAME=~"fadpedid.dped_fraccion~") COLUMN(NAME=~"fadpedid.dped_monto_total~") COLUMN(NAME=~"fadpedid.dped_por_descuento~") COLUMN(NAME=~"fadpedid.dped_monto_final~") COLUMN(NAME=~"fadpedid.dped_fecha_reg~") COLUMN(NAME=~"fadpedid.dped_usuario~") COLUMN(NAME=~"fadpedid.dped_supervisor~") COLUMN(NAME=~"fadpedid.dped_bultos~") COLUMN(NAME=~"fadpedid.dped_ubicacion~") COLUMN(NAME=~"fadpedid.dped_pasada~") COLUMN(NAME=~"fatpedid.pedi_empresa~") COLUMN(NAME=~"fatpedid.pedi_tipo~") COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_ann~") COLUMN(NAME=~"fatpedid.pedi_cliente~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~") COLUMN(NAME=~"fatpedid.pedi_condicion_pago~") COLUMN(NAME=~"fatpedid.pedi_tipo_venta~") COLUMN(NAME=~"fatpedid.pedi_tipo_movimiento~") COLUMN(NAME=~"fatpedid.pedi_no_traspaso~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_fecha_creacion~") COLUMN(NAME=~"fatpedid.pedi_fecha_modificacion~") COLUMN(NAME=~"fatpedid.pedi_dias_pago~") COLUMN(NAME=~"fatpedid.pedi_consignado~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fatpedid.pedi_a_nombre_direccion~") COLUMN(NAME=~"fatpedid.pedi_despachado~") COLUMN(NAME=~"fatpedid.pedi_via~") COLUMN(NAME=~"fatpedid.pedi_con_emb_no~") COLUMN(NAME=~"fatpedid.pedi_marca~") COLUMN(NAME=~"fatpedid.pedi_bultos_total~") COLUMN(NAME=~"fatpedid.pedi_cubicaje_total~") COLUMN(NAME=~"fatpedid.pedi_peso_total~") COLUMN(NAME=~"fatpedid.pedi_gastos_total~") COLUMN(NAME=~"fatpedid.pedi_monto_total~") COLUMN(NAME=~"fatpedid.pedi_descu_subt_deta~") COLUMN(NAME=~"fatpedid.pedi_por_descuento~") COLUMN(NAME=~"fatpedid.pedi_supervisor~") COLUMN(NAME=~"fatpedid.pedi_monto_final~") COLUMN(NAME=~"fatpedid.pedi_comentario~") COLUMN(NAME=~"fatpedid.pedi_estado~") COLUMN(NAME=~"fatpedid.pedi_g_financiero~") COLUMN(NAME=~"fatpedid.pedi_unidad_peso~") COLUMN(NAME=~"fadpedid.dped_index~") COMPUTE(NAME=~"convert(numeric(15,0),( inmprodu.prod_existencia_total/inamedid.medi_cantidad)) entero~") COMPUTE(NAME=~"inmprodu.prod_existencia_total - (convert(numeric(15,0),(inmprodu.prod_existencia_total / inamedid.medi_cantidad)) * inamedid.medi_cantidad) fraccion~") COMPUTE(NAME=~"convert(numeric(15,0),((inmprodu.prod_existencia_total -  inmprodu.prod_reserva_total )/inamedid.medi_cantidad)) dis_entero~") COMPUTE(NAME=~"(inmprodu.prod_existencia_total - inmprodu.prod_reserva_total ) - (convert(numeric(15,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) / inamedid.medi_cantidad)) * inamedid.medi_cantidad) dis_fraccion~") COMPUTE(NAME=~"0 disponible_fraccion~") COMPUTE(NAME=~"~~~"~~~" cambio, ~~~"~~~" parcial~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COMPUTE(NAME=~"0 disponible~") COMPUTE(NAME=~"0 disponible_real~") COMPUTE(NAME=~"0 disponible_fraccion_real~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_doc~") COLUMN(NAME=~"inmprodu.prod_barra~") COLUMN(NAME=~"cracltam.acta_descripcion~") COLUMN(NAME=~"inmprodu.prod_observacion~") COLUMN(NAME=~"cramarca.amar_nombre_marca~") COLUMN(NAME=~"inmprodu.prod_arancel~") COLUMN(NAME=~"cratipos.atip_descripcion_tipo~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"cratallas.talla_descripcion~") COLUMN(NAME=~"cramaterial.mat_compo~") COMPUTE(NAME=~"0 bad_composition~") COLUMN(NAME=~"craratio.ratio_descripcion~")    JOIN (LEFT=~"cracltam.acta_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~"    OUTER2 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cracltam.acta_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~"    OUTER2 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cracltam.acta_cod_clase_tam~"    OP =~"=~"RIGHT=~"inmprodu.prod_cod_clase_tam~"    OUTER2 =~"inmprodu.prod_cod_clase_tam~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cratallas.talla_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cratallas.talla_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_cod_clase_tam~"    OP =~"=~"RIGHT=~"cratallas.talla_codigo~"    OUTER1 =~"inmprodu.prod_cod_clase_tam~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"craratio.ratio_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"craratio.ratio_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_ratio~"    OP =~"=~"RIGHT=~"craratio.ratio_codigo~"    OUTER1 =~"inmprodu.prod_ratio~" )   JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"fadpedid.dped_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"fadpedid.dped_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_no_pedido~"    OP =~"=~"RIGHT=~"fadpedid.dped_no_pedido~" )    JOIN (LEFT=~"fatpedid.pedi_ann~"    OP =~"=~"RIGHT=~"fadpedid.dped_ann~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"fadpedid.dped_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"fadpedid.dped_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"fadpedid.dped_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_dias_pago~"    OP =~"=~"RIGHT=~"dgaperio.peri_periodo~" )    JOIN (LEFT=~"cramarca.amar_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cramarca.amar_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cramarca.amar_num_marca~"    OP =~"=~"RIGHT=~"inmprodu.prod_marca~" )    JOIN (LEFT=~"cratipos.atip_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cratipos.atip_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cratipos.atip_num_tipo~"    OP =~"=~"RIGHT=~"inmprodu.prod_num_tipo~" )    JOIN (LEFT=~"dgapais.pais_pais~"    OP =~"=~"RIGHT=~"inmprodu.prod_pais~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cramaterial.mat_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cramaterial.mat_empresa~" )    JOIN (LEFT=~"inmprodu.prod_material~"    OP =~"=~"RIGHT=~"cramaterial.mat_cod_material~" ) WHERE(    EXP1 =~"((fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_ann~"   OP =~"=~"    EXP2 =~":an )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA' ) ~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(fadpedid.dped_pasada~"   OP =~"<~"    EXP2 =~"fadpedid.dped_cantidad * inamedid.medi_cantidad + fadpedid.dped_fraccion ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fadpedid.dped_reserva_origen~"   OP =~"=~"    EXP2 =~"'E'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("pedido", string),("an", number))  sort="dped_index A " )
