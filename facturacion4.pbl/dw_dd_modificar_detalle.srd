//objectcomments Para modificar el Detalle de una Factura
release 7;
datawindow(units=0 timer_interval=0 color=79416533 processing=0 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=64 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=64 color="536870912" )
table(column=(type=char(8) updatewhereclause=yes name=fact_no_pedido dbname="fatdiari.fact_no_pedido" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fatdiari.fact_fecha" initial="today" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_factura dbname="fatdiari.fact_no_factura" )
 column=(type=char(3) updatewhereclause=yes name=fact_tipo dbname="fatdiari.fact_tipo" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fatdiari.fact_ann" )
 column=(type=char(1) updatewhereclause=yes name=fatdiari_fact_estado dbname="fatdiari.fact_estado" )
 column=(type=char(2) updatewhereclause=yes name=fact_condicion_pago dbname="fatdiari.fact_condicion_pago" )
 column=(type=char(20) updatewhereclause=yes name=fact_ruc_cliente dbname="fatdiari.fact_ruc_cliente" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fatdiari.fact_a_nombre" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre_direccion dbname="fatdiari.fact_a_nombre_direccion" )
 column=(type=char(100) updatewhereclause=yes name=fact_despachado dbname="fatdiari.fact_despachado" )
 column=(type=char(100) updatewhereclause=yes name=fact_consignado dbname="fatdiari.fact_consignado" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_no_traspaso dbname="fatdiari.fact_no_traspaso" )
 column=(type=char(250) updatewhereclause=yes name=fact_comentario dbname="fatdiari.fact_comentario" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_estado~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_a_nombre_direccion~") COLUMN(NAME=~"fatdiari.fact_despachado~") COLUMN(NAME=~"fatdiari.fact_consignado~") COLUMN(NAME=~"fatdiari.fact_no_traspaso~") COLUMN(NAME=~"fatdiari.fact_comentario~")WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_ped_key~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa_ped_key~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_no_pedido~"   OP =~"not like~"    EXP2 =~"'%NC%'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":anno~" ) ) ARG(NAME = ~"grupo_ped_key~" TYPE = number)  ARG(NAME = ~"empresa_ped_key~" TYPE = number)  ARG(NAME = ~"anno~" TYPE = number) " retrieve.asneeded=yes arguments=(("grupo_ped_key", number),("empresa_ped_key", number),("anno", number))  sort="real(fact_no_pedido) A fact_no_factura A fact_ann A fact_fecha A " )
