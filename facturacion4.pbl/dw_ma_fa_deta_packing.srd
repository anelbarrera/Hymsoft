 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fadempaq~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"fadempaq.empa_bulto_inicio~") COLUMN(NAME=~"fadempaq.empa_bulto_fin~") COLUMN(NAME=~"fadempaq.empa_bultos~") COLUMN(NAME=~"fadempaq.empa_codigo_producto~") COLUMN(NAME=~"fadempaq.empa_cubicaje~") COLUMN(NAME=~"fadempaq.empa_peso~") COMPUTE(NAME=~"0 empa_canti~") COMPUTE(NAME=~"0 empa_fraccion~") COLUMN(NAME=~"fadempaq.empa_cantidad~") COLUMN(NAME=~"fadempaq.empa_bodega~") COLUMN(NAME=~"fadempaq.empa_ubicacion~") COLUMN(NAME=~"fadempaq.empa_g_financiero~") COLUMN(NAME=~"fadempaq.empa_empresa~") COLUMN(NAME=~"fadempaq.empa_lista_empaque~") COLUMN(NAME=~"fadempaq.empa_ann~") COLUMN(NAME=~"fadempaq.empa_linea~") COLUMN(NAME=~"fadempaq.empa_unidad~") COLUMN(NAME=~"fadempaq.empa_linea_original~") COLUMN(NAME=~"fadempaq.empa_unidad_peso~") COLUMN(NAME=~"fadempaq.empa_largo~") COLUMN(NAME=~"fadempaq.empa_alto~") COLUMN(NAME=~"fadempaq.empa_ancho~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"fadempaq.empa_unidad_cubicaje~") COLUMN(NAME=~"fadempaq.empa_uni_cubic_compuesto~") COMPUTE(NAME=~"0 validado~") COLUMN(NAME=~"fadempaq.empa_index~") COMPUTE(NAME=~"0 desglose~") COMPUTE(NAME=~"0 eliminar~") COLUMN(NAME=~"fadempaq.empa_maquina~") COLUMN(NAME=~"fadempaq.empa_usuario~") COLUMN(NAME=~"fadempaq.empa_autorizado_por~") COLUMN(NAME=~"fadempaq.empa_cantidad_superior~")    JOIN (LEFT=~"fadempaq.empa_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"fadempaq.empa_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"fadempaq.empa_codigo_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"fadempaq.empa_g_financiero~"   OP =~"=~"    EXP2 =~":deta_grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fadempaq.empa_empresa~"   OP =~"=~"    EXP2 =~":deta_empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fadempaq.empa_lista_empaque~"   OP =~"=~"    EXP2 =~":deta_lista~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fadempaq.empa_ann~"   OP =~"=~"    EXP2 =~":deta_ann~" ) ) ARG(NAME = ~"deta_grupo~" TYPE = number)  ARG(NAME = ~"deta_empresa~" TYPE = number)  ARG(NAME = ~"deta_lista~" TYPE = string)  ARG(NAME = ~"deta_ann~" TYPE = number) " update="fadempaq" updatewhere=0 updatekeyinplace=no arguments=(("deta_grupo", number),("deta_empresa", number),("deta_lista", string),("deta_ann", number))  sort="index A " )
