table(column=(type=datetime updatewhereclause=yes name=fatpedid_pedi_fecha dbname="fatpedid.pedi_fecha" dbalias=".pedi_fecha" )
 column=(type=char(8) updatewhereclause=yes name=fatpedid_pedi_no_pedido dbname="fatpedid.pedi_no_pedido" dbalias=".pedi_no_pedido" )
 column=(type=char(2) updatewhereclause=yes name=fatpedid_pedi_condicion_pago dbname="fatpedid.pedi_condicion_pago" dbalias=".pedi_condicion_pago" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_a_nombre dbname="fatpedid.pedi_a_nombre" dbalias=".pedi_a_nombre" )
 column=(type=char(250) updatewhereclause=yes name=fatpedid_pedi_a_nombre_direccion dbname="fatpedid.pedi_a_nombre_direccion" dbalias=".pedi_a_nombre_direccion" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_despachado dbname="fatpedid.pedi_despachado" dbalias=".pedi_despachado" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_cliente dbname="fatpedid.pedi_cliente" dbalias=".pedi_cliente" )
 column=(type=char(1) updatewhereclause=yes name=fatpedid_pedi_estado dbname="fatpedid.pedi_estado" dbalias=".pedi_estado" )
 column=(type=char(2) updatewhereclause=yes name=dgaperio_peri_aplicacion dbname="dgaperio.peri_aplicacion" dbalias=".peri_aplicacion" )
 column=(type=char(40) updatewhereclause=yes name=dgaperio_peri_descripcion dbname="dgaperio.peri_descripcion" dbalias=".peri_descripcion" )
 column=(type=char(25) updatewhereclause=yes name=ssmusuar_usua_nombre dbname="ssmusuar.usua_nombre" dbalias=".usua_nombre" )
 column=(type=char(25) updatewhereclause=yes name=ssmusuar_usua_apellido dbname="ssmusuar.usua_apellido" dbalias=".usua_apellido" )
 column=(type=char(20) updatewhereclause=yes name=fatpedid_pedi_ruc_cliente dbname="fatpedid.pedi_ruc_cliente" dbalias=".pedi_ruc_cliente" )
 column=(type=char(64) updatewhereclause=yes name=nombre_vendedor dbname="nombre_vendedor" )
 column=(type=char(64) updatewhereclause=yes name=apellido_vendedor dbname="apellido_vendedor" )
 column=(type=decimal(0) updatewhereclause=yes name=vped_vendedor dbname="fadvenpe.vped_vendedor" dbalias=".vped_vendedor" )
 column=(type=char(10) updatewhereclause=yes name=pedi_secuencia_diaria dbname="fatpedid.pedi_secuencia_diaria" dbalias=".pedi_secuencia_diaria" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatpedid~" )  TABLE(NAME=~"dgaperio~" )  TABLE(NAME=~"ssmusuar~" )  TABLE(NAME=~"fadvenpe~" ) COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_condicion_pago~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fatpedid.pedi_a_nombre_direccion~") COLUMN(NAME=~"fatpedid.pedi_despachado~") COLUMN(NAME=~"fatpedid.pedi_cliente~") COLUMN(NAME=~"fatpedid.pedi_estado~") COLUMN(NAME=~"dgaperio.peri_aplicacion~") COLUMN(NAME=~"dgaperio.peri_descripcion~") COLUMN(NAME=~"ssmusuar.usua_nombre~") COLUMN(NAME=~"ssmusuar.usua_apellido~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~") COMPUTE(NAME=~"'                                                                ' nombre_vendedor~") COMPUTE(NAME=~"'                                                                ' apellido_vendedor~") COLUMN(NAME=~"fadvenpe.vped_vendedor~") COLUMN(NAME=~"fatpedid.pedi_secuencia_diaria~")    JOIN (LEFT=~"fatpedid.pedi_usuario~"    OP =~"=~"RIGHT=~"ssmusuar.usua_id~"    OUTER1 =~"fatpedid.pedi_usuario~" )    JOIN (LEFT=~"fatpedid.pedi_dias_pago~"    OP =~"=~"RIGHT=~"dgaperio.peri_periodo~"    OUTER1 =~"fatpedid.pedi_dias_pago~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"fadvenpe.vped_g_financiero~"    OUTER1 =~"fatpedid.pedi_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"fadvenpe.vped_empresa~"    OUTER1 =~"fatpedid.pedi_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_no_pedido~"    OP =~"=~"RIGHT=~"fadvenpe.vped_no_pedido~"    OUTER1 =~"fatpedid.pedi_no_pedido~" )    JOIN (LEFT=~"fatpedid.pedi_ann~"    OP =~"=~"RIGHT=~"fadvenpe.vped_ann~"    OUTER1 =~"fatpedid.pedi_ann~" )WHERE(    EXP1 =~"fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_no_pedido~"   OP =~"=~"    EXP2 =~":no_pedido~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_ann~"   OP =~"=~"    EXP2 =~":ann_pedido~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"no_pedido~" TYPE = string)  ARG(NAME = ~"ann_pedido~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("no_pedido", string),("ann_pedido", number)) )
