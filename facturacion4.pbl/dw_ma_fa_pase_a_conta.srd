table(column=(type=decimal(0) updatewhereclause=yes key=yes name=fact_g_financiero dbname="fatdiari.fact_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=fact_empresa dbname="fatdiari.fact_empresa" )
 column=(type=char(3) updatewhereclause=yes key=yes name=fact_tipo dbname="fatdiari.fact_tipo" )
 column=(type=char(8) updatewhereclause=yes key=yes name=fact_no_pedido dbname="fatdiari.fact_no_pedido" )
 column=(type=decimal(0) updatewhereclause=yes key=yes name=fact_ann dbname="fatdiari.fact_ann" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_factura dbname="fatdiari.fact_no_factura" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_cliente dbname="fatdiari.fact_cliente" )
 column=(type=char(20) updatewhereclause=yes name=fact_ruc_cliente dbname="fatdiari.fact_ruc_cliente" )
 column=(type=char(2) updatewhereclause=yes name=fact_condicion_pago dbname="fatdiari.fact_condicion_pago" values="CONTADO	CO/CRÉDITO	CR/C.O.D	CD/" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_tipo_venta dbname="fatdiari.fact_tipo_venta" )
 column=(type=char(1) updatewhereclause=yes name=fact_tipo_movimiento dbname="fatdiari.fact_tipo_movimiento" values="OTROS	O/TRASPASO	T/SALIDA	S/" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fatdiari.fact_fecha" initial="today" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fatdiari.fact_a_nombre" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_final dbname="fatdiari.fact_monto_final" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=fact_act_conta dbname="fatdiari.fact_act_conta" )
 column=(type=char(116) updatewhereclause=yes name=nombre dbname="nombre" )
 column=(type=datetime update=yes updatewhereclause=yes name=fact_fecha_act_conta dbname="fatdiari.fact_fecha_act_conta" )
 column=(type=char(19) updatewhereclause=yes name=numero dbname="numero" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_gastos_total dbname="fatdiari.fact_gastos_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_fact_total dbname="fatdiari.fact_monto_fact_total" initial="0" )
 column=(type=char(20) updatewhereclause=yes name=clie_mg_cuenta dbname="ccmclien.clie_mg_cuenta" )
 column=(type=decimal(0) updatewhereclause=yes name=terc_pais dbname="dgmterce.terc_pais" )
 column=(type=decimal(0) updatewhereclause=yes name=terc_region dbname="dgmterce.terc_region" )
 column=(type=char(30) updatewhereclause=yes name=vent_descripcion dbname="faaventa.vent_descripcion" )
 column=(type=char(60) updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" initial="spaces" )
 column=(type=char(75) updatewhereclause=yes name=mg_descripcion dbname="dgmplanc.mg_descripcion" )
 column=(type=char(1) updatewhereclause=yes name=fact_descuento_subt_deta dbname="fatdiari.fact_descuento_subt_deta" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_por_descuento dbname="fatdiari.fact_por_descuento" initial="0" )
 column=(type=char(7) updatewhereclause=yes name=tipo dbname="fatdiari.tipo" )
 column=(type=char(8) updatewhereclause=yes name=movimiento dbname="fatdiari.movimiento" )
 column=(type=long updatewhereclause=yes name=devolucion dbname="fatdiari.devolucion" )
 column=(type=char(3) update=yes updatewhereclause=yes name=fact_descartada_por dbname="fatdiari.fact_descartada_por" )
 column=(type=datetime update=yes updatewhereclause=yes name=fact_fecha_descarte dbname="fatdiari.fact_fecha_descarte" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_descuento_ncr dbname="fatdiari.fact_descuento_ncr" )
 column=(type=long updatewhereclause=yes name=fact_ncr_descuento dbname="fatdiari.fact_ncr_descuento" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"ccmclien~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"faaventa~" )  TABLE(NAME=~"dgmplanc~" ) COLUMN(NAME=~"fatdiari.fact_g_financiero~") COLUMN(NAME=~"fatdiari.fact_empresa~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_tipo_venta~") COLUMN(NAME=~"fatdiari.fact_tipo_movimiento~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"fatdiari.fact_act_conta~") COMPUTE(NAME=~"fatdiari.fact_a_nombre+~~~" Cod. ~~~"+str(fatdiari.fact_cliente) nombre~") COLUMN(NAME=~"fatdiari.fact_fecha_act_conta~") COMPUTE(NAME=~"fatdiari.fact_no_factura+~~~" / ~~~"+fatdiari.fact_no_pedido numero~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"ccmclien.clie_mg_cuenta~") COLUMN(NAME=~"dgmterce.terc_pais~") COLUMN(NAME=~"dgmterce.terc_region~") COLUMN(NAME=~"faaventa.vent_descripcion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmplanc.mg_descripcion~") COLUMN(NAME=~"fatdiari.fact_descuento_subt_deta~") COLUMN(NAME=~"fatdiari.fact_por_descuento~") COMPUTE(NAME=~"~~~"       ~~~" tipo~") COMPUTE(NAME=~"~~~"        ~~~" movimiento~") COMPUTE(NAME=~"0 devolucion~") COLUMN(NAME=~"fatdiari.fact_descartada_por~") COLUMN(NAME=~"fatdiari.fact_fecha_descarte~") COLUMN(NAME=~"fatdiari.fact_descuento_ncr~") COLUMN(NAME=~"fatdiari.fact_ncr_descuento~")    JOIN (LEFT=~"fatdiari.fact_tipo_venta~"    OP =~"=~"RIGHT=~"faaventa.vent_venta~"    OUTER1 =~"fatdiari.fact_tipo_venta~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"ccmclien.clie_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"ccmclien.clie_empresa~" )    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"ccmclien.clie_tercero~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"ccmclien.clie_g_financiero~"    OP =~"=~"RIGHT=~"dgmplanc.mg_g_financiero~" )    JOIN (LEFT=~"ccmclien.clie_empresa~"    OP =~"=~"RIGHT=~"dgmplanc.mg_empresa~" )    JOIN (LEFT=~"ccmclien.clie_mg_cuenta~"    OP =~"=~"RIGHT=~"dgmplanc.mg_cuenta~" )WHERE(    EXP1 =~"( ( fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_act_conta~"   OP =~"=~"    EXP2 =~"0 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_monto_fact_total~"   OP =~"<>~"    EXP2 =~"0 )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_monto_final~"   OP =~"<>~"    EXP2 =~"0 ) )~" ) ) " update="fatdiari" updatewhere=0 updatekeyinplace=no  sort="fact_fecha A " )
