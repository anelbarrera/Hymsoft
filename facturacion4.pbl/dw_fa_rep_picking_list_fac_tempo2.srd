erio.peri_descripcion~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_descripcion~") COLUMN(NAME=~"inmprodu.prod_medida~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COLUMN(NAME=~"faddiari.facd_tipo~") COLUMN(NAME=~"faddiari.facd_no_pedido~") COLUMN(NAME=~"faddiari.facd_ann~") COLUMN(NAME=~"faddiari.facd_g_financiero~") COLUMN(NAME=~"faddiari.facd_empresa~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"faddiari.facd_index~") COMPUTE(NAME=~"convert(numeric(15,0),( inmprodu.prod_existencia_total /inamedid.medi_cantidad)) entero~") COMPUTE(NAME=~"convert(numeric(15,0),(( inmprodu.prod_existencia_total - inmprodu.prod_reserva_total )/inamedid.medi_cantidad)) dis_entero~") COMPUTE(NAME=~"(inmprodu.prod_existencia_total - inmprodu.prod_reserva_total ) - (convert(numeric(15,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total ) / inamedid.medi_cantidad)) * inamedid.medi_cantidad) dis_fraccion~") COMPUTE(NAME=~"inmprodu.prod_existencia_total - (convert(numeric(15,0),( inmprodu.prod_existencia_total / inamedid.medi_cantidad)) * inamedid.medi_cantidad) fraccion~") COMPUTE(NAME=~"inmprodu.prod_existencia_total - inmprodu.prod_reserva_total disponible~") COLUMN(NAME=~"crataman.atam_descripcion_tam~") COLUMN(NAME=~"cramarca.amar_nombre_marca~") COLUMN(NAME=~"cracolor.acol_nombre_color~") COLUMN(NAME=~"cracltam.acta_descripcion~") COLUMN(NAME=~"inmprodu.prod_peso~") COLUMN(NAME=~"inmprodu.prod_cubicaje~") COLUMN(NAME=~"faddiari.facd_bulto_inicio~") COLUMN(NAME=~"faddiari.facd_bulto_fin~") COLUMN(NAME=~"cratipos.atip_descripcion_tipo~") COLUMN(NAME=~"inmprodu.prod_cod_alternativo~") COLUMN(NAME=~"inmprodu.prod_barra~") COLUMN(NAME=~"inmprodu.prod_descripcion_dos~") COLUMN(NAME=~"cramaterial.mat_compo~")    JOIN (LEFT=~"inmprodu.prod_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~"    OUTER1 =~"inmprodu.prod_pais~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~"    OUTER1 =~"inmprodu.prod_medida~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cracolor.acol_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cracolor.acol_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_color~"    OP =~"=~"RIGHT=~"cracolor.acol_num_color~"    OUTER1 =~"inmprodu.prod_color~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cramarca.amar_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cramarca.amar_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_marca~"    OP =~"=~"RIGHT=~"cramarca.amar_num_marca~"    OUTER1 =~"inmprodu.prod_marca~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cracltam.acta_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cracltam.acta_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_cod_clase_tam~"    OP =~"=~"RIGHT=~"cracltam.acta_cod_clase_tam~"    OUTER1 =~"inmprodu.prod_cod_clase_tam~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cratipos.atip_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cratipos.atip_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_num_tipo~"    OP =~"=~"RIGHT=~"cratipos.atip_num_tipo~"    OUTER1 =~"inmprodu.prod_num_tipo~" )    JOIN (LEFT=~"cracltam.acta_g_financiero~"    OP =~"=~"RIGHT=~"crataman.atam_g_financiero~"    OUTER1 =~"cracltam.acta_g_financiero~" )    JOIN (LEFT=~"cracltam.acta_empresa~"    OP =~"=~"RIGHT=~"crataman.atam_empresa~"    OUTER1 =~"cracltam.acta_empresa~" )    JOIN (LEFT=~"cracltam.acta_cod_clase_tam~"    OP =~"=~"RIGHT=~"crataman.atam_cod_clase_tam~"    OUTER1 =~"cracltam.acta_cod_clase_tam~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"faddiari.facd_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )    JOIN (LEFT=~"fatdiari.fact_dias_pago~"    OP =~"=~"RIGHT=~"dgaperio.peri_periodo~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cramaterial.mat_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cramaterial.mat_empresa~" )    JOIN (LEFT=~"inmprodu.prod_material~"    OP =~"=~"RIGHT=~"cramaterial.mat_cod_material~" )WHERE(    EXP1 =~"( fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_tipo~"   OP =~"=~"    EXP2 =~":tipo)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_no_pedido~"   OP =~"=~"    EXP2 =~":pedido)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":an)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA' )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"tipo~" TYPE = string)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("tipo", string),("pedido", string),("an", number))  sort="facd_bulto_inicio A facd_index A " )
