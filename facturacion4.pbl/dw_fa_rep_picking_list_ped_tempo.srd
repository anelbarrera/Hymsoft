ped_ubicacion~") COLUMN(NAME=~"fadpedid.dped_pasada~") COLUMN(NAME=~"fatpedid.pedi_empresa~") COLUMN(NAME=~"fatpedid.pedi_tipo~") COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_ann~") COLUMN(NAME=~"fatpedid.pedi_cliente~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~") COLUMN(NAME=~"fatpedid.pedi_condicion_pago~") COLUMN(NAME=~"fatpedid.pedi_tipo_venta~") COLUMN(NAME=~"fatpedid.pedi_tipo_movimiento~") COLUMN(NAME=~"fatpedid.pedi_no_traspaso~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_fecha_creacion~") COLUMN(NAME=~"fatpedid.pedi_fecha_modificacion~") COLUMN(NAME=~"fatpedid.pedi_dias_pago~") COLUMN(NAME=~"fatpedid.pedi_consignado~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fatpedid.pedi_a_nombre_direccion~") COLUMN(NAME=~"fatpedid.pedi_despachado~") COLUMN(NAME=~"fatpedid.pedi_via~") COLUMN(NAME=~"fatpedid.pedi_con_emb_no~") COLUMN(NAME=~"fatpedid.pedi_marca~") COLUMN(NAME=~"fatpedid.pedi_bultos_total~") COLUMN(NAME=~"fatpedid.pedi_cubicaje_total~") COLUMN(NAME=~"fatpedid.pedi_peso_total~") COLUMN(NAME=~"fatpedid.pedi_gastos_total~") COLUMN(NAME=~"fatpedid.pedi_monto_total~") COLUMN(NAME=~"fatpedid.pedi_descu_subt_deta~") COLUMN(NAME=~"fatpedid.pedi_por_descuento~") COLUMN(NAME=~"fatpedid.pedi_supervisor~") COLUMN(NAME=~"fatpedid.pedi_monto_final~") COLUMN(NAME=~"fatpedid.pedi_comentario~") COLUMN(NAME=~"fatpedid.pedi_estado~") COLUMN(NAME=~"fatpedid.pedi_g_financiero~") COLUMN(NAME=~"fatpedid.pedi_unidad_peso~") COLUMN(NAME=~"fadpedid.dped_index~") COMPUTE(NAME=~"0 disponible_fraccion~") COMPUTE(NAME=~"~~~"~~~" cambio, ~~~"~~~" parcial~") COMPUTE(NAME=~"0 disponible~") COMPUTE(NAME=~"0 disponible_real~") COMPUTE(NAME=~"0 disponible_fraccion_real~") COMPUTE(NAME=~"0 bad_composition~") COMPUTE(NAME=~"prod_empaque = ( select max(prod_empaque) from inmprodu where  fadpedid.dped_g_financiero = inmprodu.prod_g_financiero and inmprodu.prod_empresa = fadpedid.dped_empresa and  fadpedid.dped_empresa in (:empresa,8) and  fadpedid.dped_codigo_item = inmprodu.prod_producto  )~") COMPUTE(NAME=~"prod_empaque_um = ( select max(prod_empaque_um) from inmprodu where  fadpedid.dped_g_financiero = inmprodu.prod_g_financiero and inmprodu.prod_empresa = fadpedid.dped_empresa  and  fadpedid.dped_empresa in (:empresa, 8) and  fadpedid.dped_codigo_item = inmprodu.prod_producto  )~") COMPUTE(NAME=~"prod_ultima_entrada_sec = ( select max(prod_ultima_entrada_sec) from inmprodu where  fadpedid.dped_g_financiero = inmprodu.prod_g_financiero and inmprodu.prod_empresa = fadpedid.dped_empresa  and  fadpedid.dped_empresa in (:empresa) and  fadpedid.dped_codigo_item = inmprodu.prod_producto  )~") COMPUTE(NAME=~"prod_sencamer = ( select max(prod_sencamer) from inmprodu where  fadpedid.dped_g_financiero = inmprodu.prod_g_financiero and inmprodu.prod_empresa = fadpedid.dped_empresa and  fadpedid.dped_empresa in (:empresa, 8) and  fadpedid.dped_codigo_item = inmprodu.prod_producto  )~") COMPUTE(NAME=~"existencia_total = ( select sum(prod_existencia_total) from inmprodu where  fadpedid.dped_g_financiero = inmprodu.prod_g_financiero and inmprodu.prod_empresa = fadpedid.dped_empresa  and  fadpedid.dped_empresa in (:empresa, 8) and  fadpedid.dped_codigo_item = inmprodu.prod_producto  )~") COMPUTE(NAME=~"prod_ultima_entrada_sec_bg = ( select max(prod_ultima_entrada_sec) from inmprodu where  fadpedid.dped_g_financiero = inmprodu.prod_g_financiero and inmprodu.prod_empresa = fadpedid.dped_empresa  and  fadpedid.dped_empresa = inmprodu.prod_empresa  and  fadpedid.dped_codigo_item = inmprodu.prod_producto  )~") COMPUTE(NAME=~"prod_peso = ( select max(prod_peso) from inmprodu where  fadpedid.dped_g_financiero = inmprodu.prod_g_financiero and inmprodu.prod_empresa = fadpedid.dped_empresa and  fadpedid.dped_empresa in (:empresa,8) and  fadpedid.dped_codigo_item = inmprodu.prod_producto  )~") COMPUTE(NAME=~"prod_cubicaje = ( select max(prod_cubicaje) from inmprodu where  fadpedid.dped_g_financiero = inmprodu.prod_g_financiero and inmprodu.prod_empresa = fadpedid.dped_empresa and  fadpedid.dped_empresa in (:empresa,8) and  fadpedid.dped_codigo_item = inmprodu.prod_producto  )~")    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"fadpedid.dped_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"fadpedid.dped_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_no_pedido~"    OP =~"=~"RIGHT=~"fadpedid.dped_no_pedido~" )    JOIN (LEFT=~"fatpedid.pedi_ann~"    OP =~"=~"RIGHT=~"fadpedid.dped_ann~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_dias_pago~"    OP =~"=~"RIGHT=~"dgaperio.peri_periodo~" )    JOIN (LEFT=~"fadpedid.dped_unidad_producto~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"((fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_ann~"   OP =~"=~"    EXP2 =~":an )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA' ) ~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(fadpedid.dped_pasada~"   OP =~"<~"    EXP2 =~"fadpedid.dped_cantidad * inamedid.medi_cantidad + fadpedid.dped_fraccion ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fadpedid.dped_reserva_origen~"   OP =~"=~"    EXP2 =~"'E'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("pedido", string),("an", number))  sort="dped_index A " )
