//objectcomments Data Windows para el reporte de los Packing List pendientes de Factura
release 7;
datawindow(units=0 timer_interval=60000 color=1090519039 processing=0 HTMLDW=no print.documentname="" print.orientation = 2 print.margin.left = 110 print.margin.right = 55 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 1 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=740 color="536870912" )
summary(height=128 color="-1" )
footer(height=80 color="-1" )
detail(height=76 color="-1"  height.autosize=yes)
table(column=(type=decimal(0) updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" initial="0" )
 column=(type=char(20) updatewhereclause=yes name=terc_identificacion dbname="dgmterce.terc_identificacion" initial="spaces" )
 column=(type=char(60) updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" initial="spaces" )
 column=(type=char(100) updatewhereclause=yes name=dgmempre_empr_razon_social dbname="dgmempre.empr_razon_social" )
 column=(type=char(255) updatewhereclause=yes name=dgmempre_empr_icono dbname="dgmempre.empr_icono" )
 column=(type=char(120) updatewhereclause=yes name=dgmempre_empr_logo_f dbname="dgmempre.empr_logo_f" )
 column=(type=char(100) updatewhereclause=yes name=dgapais_pais_descripcion dbname="dgapais.pais_descripcion" )
 column=(type=char(100) updatewhereclause=yes name=dgaregio_regi_descripcion dbname="dgaregio.regi_descripcion" )
 column=(type=char(8) updatewhereclause=yes name=fatpedid_pedi_no_pedido dbname="fatpedid.pedi_no_pedido" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_ann dbname="fatpedid.pedi_ann" )
 column=(type=datetime updatewhereclause=yes name=fatpedid_pedi_fecha dbname="fatpedid.pedi_fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_monto_final dbname="fatpedid.pedi_monto_final" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_a_nombre dbname="fatpedid.pedi_a_nombre" )
 column=(type=char(2) updatewhereclause=yes name=fatpedid_pedi_condicion_pago dbname="fatpedid.pedi_condicion_pago" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_marca dbname="fatpedid.pedi_marca" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_despachado dbname="fatpedid.pedi_despachado" )
 column=(type=datetime updatewhereclause=yes name=pedi_fecha_creacion dbname="fatpedid.pedi_fecha_creacion" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaregio~" )  TABLE(NAME=~"fatpedid~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_icono~") COLUMN(NAME=~"dgmempre.empr_logo_f~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"dgaregio.regi_descripcion~") COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_ann~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_monto_final~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fatpedid.pedi_condicion_pago~") COLUMN(NAME=~"fatpedid.pedi_marca~") COLUMN(NAME=~"fatpedid.pedi_despachado~") COLUMN(NAME=~"fatpedid.pedi_fecha_creacion~")    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgaregio.regi_pais~" )    JOIN (LEFT=~"dgmterce.terc_region~"    OP =~"=~"RIGHT=~"dgaregio.regi_codigo_region~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"( ( fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa ) )~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("g_financiero", number),("empresa", number))  sort="dias_pendientes D fatpedid_pedi_no_pedido A fatpedid_pedi_ann A " )
