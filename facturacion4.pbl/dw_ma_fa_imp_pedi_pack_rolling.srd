 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatpedid~" )  TABLE(NAME=~"fadpedid~" )  TABLE(NAME=~"faaparam~" )  TABLE(NAME=~"fadempaq~" )  TABLE(NAME=~"fatempaq~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_a~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"dgaperio~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_b~" ) COLUMN(NAME=~"faaparam.fara_logo_f~") COLUMN(NAME=~"faaparam.fara_logo~") COLUMN(NAME=~"faaparam.fara_logo_apli~") COLUMN(NAME=~"fadpedid.dped_bodega~") COLUMN(NAME=~"fadpedid.dped_ubicacion~") COLUMN(NAME=~"fadpedid.dped_codigo_item~") COLUMN(NAME=~"fadpedid.dped_descripcion_alterna~") COLUMN(NAME=~"fadpedid.dped_cantidad~") COLUMN(NAME=~"fadpedid.dped_fraccion~") COLUMN(NAME=~"fadpedid.dped_cant_asignada~") COLUMN(NAME=~"fadpedid.dped_unidad_producto~") COLUMN(NAME=~"fadpedid.dped_unidad_venta~") COLUMN(NAME=~"fadempaq.empa_cantidad~") COLUMN(NAME=~"fadpedid.dped_linea~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatpedid.pedi_cliente~") COLUMN(NAME=~"fadempaq.empa_bulto_inicio~") COLUMN(NAME=~"fadempaq.empa_bulto_fin~") COLUMN(NAME=~"fadempaq.empa_peso~") COLUMN(NAME=~"fadempaq.empa_unidad_peso~") COLUMN(NAME=~"fadempaq.empa_cubicaje~") COLUMN(NAME=~"fadempaq.empa_unidad_cubicaje~") COLUMN(NAME=~"fatempaq.enca_autorizado_por~") COLUMN(NAME=~"fatempaq.enca_recolector~") COLUMN(NAME=~"fatempaq.enca_ann~") COLUMN(NAME=~"dgmterce.terc_direccion~") COLUMN(NAME=~"fatpedid.pedi_consignado~") COLUMN(NAME=~"fatpedid.pedi_marca~") COLUMN(NAME=~"inamedid_a.medi_descripcion~") COLUMN(NAME=~"fadpedid.dped_costo_cif~") COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatempaq.enca_empacador~") COLUMN(NAME=~"fatempaq.enca_despachador~") COLUMN(NAME=~"fatempaq.enca_supervisor~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~") COLUMN(NAME=~"fatpedid.pedi_a_nombre_direccion~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_despachado~") COLUMN(NAME=~"fatpedid.pedi_condicion_pago~") COLUMN(NAME=~"inmprodu.prod_medida~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COLUMN(NAME=~"fadpedid.dped_bultos~") COLUMN(NAME=~"dgaperio.peri_descripcion~") COLUMN(NAME=~"fatempaq.enca_observacion~") COLUMN(NAME=~"fatempaq.enca_lista_empaque~") COMPUTE(NAME=~"convert(numeric(15,0),( fadempaq.empa_cantidad /inamedid_b.medi_cantidad)) emp_entero~") COMPUTE(NAME=~"fadempaq.empa_cantidad  - (convert(numeric(15,0),( fadempaq.empa_cantidad / inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) emp_fraccion~") COMPUTE(NAME=~"~~~"                                        ~~~"aprobado,~~~"                                        ~~~"recolectado, ~~~"              ~~~" asignado, ~~~"              ~~~"  noasignado, ~~~"            ~~~"cantidad~") COLUMN(NAME=~"fatpedid.pedi_bultos_total~") COMPUTE(NAME=~"inmprodu.prod_existencia_total - (convert(numeric(15,0),(inmprodu.prod_existencia_total  / inamedid_a.medi_cantidad)) * inamedid_a.medi_cantidad) fraccion~") COMPUTE(NAME=~"convert(numeric(15,0),(inmprodu.prod_existencia_total /inamedid_a.medi_cantidad)) entero~") COMPUTE(NAME=~"convert(numeric(15,0),((inmprodu.prod_existencia_total  -  inmprodu.prod_reserva_total )/inamedid_a.medi_cantidad)) dis_entero~") COMPUTE(NAME=~"(inmprodu.prod_existencia_total  - inmprodu.prod_reserva_total ) - (convert(numeric(15,0),(( inmprodu.prod_existencia_total - inmprodu.prod_reserva_total ) / inamedid_a.medi_cantidad)) * inamedid_a.medi_cantidad) dis_fraccion~") COLUMN(NAME=~"fatempaq.enca_bultos_total~") COLUMN(NAME=~"fadempaq.empa_bultos~") COLUMN(NAME=~"inmprodu.prod_sencamer~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COLUMN(NAME=~"fadempaq.empa_maquina~") COLUMN(NAME=~"fadempaq.empa_usuario~") COLUMN(NAME=~"fadempaq.empa_autorizado_por~") COMPUTE(NAME=~"preparado_por = '                                                 '~") COLUMN(NAME=~"inamedid_b.medi_cantidad~") COLUMN(NAME=~"fadpedid.dped_index~") COLUMN(NAME=~"fadempaq.empa_empaque_cambiado~") COLUMN(NAME=~"fadempaq.empa_index~")    JOIN (LEFT=~"fadpedid.dped_g_financiero~"    OP =~"=~"RIGHT=~"fatpedid.pedi_g_financiero~" )    JOIN (LEFT=~"fadpedid.dped_empresa~"    OP =~"=~"RIGHT=~"fatpedid.pedi_empresa~" )    JOIN (LEFT=~"fadpedid.dped_no_pedido~"    OP =~"=~"RIGHT=~"fatpedid.pedi_no_pedido~" )    JOIN (LEFT=~"fadpedid.dped_ann~"    OP =~"=~"RIGHT=~"fatpedid.pedi_ann~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )    JOIN (LEFT=~"fatempaq.enca_g_financiero~"    OP =~"=~"RIGHT=~"fadempaq.empa_g_financiero~" )    JOIN (LEFT=~"fatempaq.enca_empresa~"    OP =~"=~"RIGHT=~"fadempaq.empa_empresa~" )    JOIN (LEFT=~"fatempaq.enca_lista_empaque~"    OP =~"=~"RIGHT=~"fadempaq.empa_lista_empaque~" )    JOIN (LEFT=~"fatempaq.enca_ann~"    OP =~"=~"RIGHT=~"fadempaq.empa_ann~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"fatempaq.enca_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"fatempaq.enca_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_no_pedido~"    OP =~"=~"RIGHT=~"fatempaq.enca_no_pedido~" )    JOIN (LEFT=~"fatpedid.pedi_ann~"    OP =~"=~"RIGHT=~"fatempaq.enca_ann_pedido~" )    JOIN (LEFT=~"fatpedid.pedi_tipo~"    OP =~"=~"RIGHT=~"fatempaq.enca_tipo~" )    JOIN (LEFT=~"fadpedid.dped_linea~"    OP =~"=~"RIGHT=~"fadempaq.empa_linea_original~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"fatpedid.pedi_cliente~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid_a.medi_medida~" )    JOIN (LEFT=~"fadempaq.empa_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"fadempaq.empa_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"fadempaq.empa_codigo_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"fatpedid.pedi_dias_pago~"    OP =~"=~"RIGHT=~"dgaperio.peri_periodo~" )    JOIN (LEFT=~"fadempaq.empa_unidad~"    OP =~"=~"RIGHT=~"inamedid_b.medi_medida~" )WHERE(    EXP1 =~"( ( fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatpedid.pedi_no_pedido~"   OP =~"=~"    EXP2 =~":no_pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatpedid.pedi_ann~"   OP =~"=~"    EXP2 =~":no_ped_anno )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatempaq.enca_lista_empaque~"   OP =~"=~"    EXP2 =~":list_emp )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatempaq.enca_fuente~"   OP =~"=~"    EXP2 =~"~~~"PE~~~" ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"no_pedido~" TYPE = string)  ARG(NAME = ~"no_ped_anno~" TYPE = number)  ARG(NAME = ~"list_emp~" TYPE = string) " arguments=(("g_financiero", number),("empresa", number),("no_pedido", string),("no_ped_anno", number),("list_emp", string))  sort="empa_index A fadempaq_empa_bulto_inicio A fadempaq_empa_bulto_fin A " )
