//objectcomments Popup menu for uo_outlookbar
forward
global type m_outlookbar_menu from menu
end type
type m_outlook from menu within m_outlookbar_menu
end type
type m_largeicons from menu within m_outlook
end type
type m_smallicons from menu within m_outlook
end type
type m_1 from menu within m_outlook
end type
type m_addnewgroup from menu within m_outlook
end type
type m_removegroup from menu within m_outlook
end type
type m_renamegroup from menu within m_outlook
end type
type m_outlook from menu within m_outlookbar_menu
m_largeicons m_largeicons
m_smallicons m_smallicons
m_1 m_1
m_addnewgroup m_addnewgroup
m_removegroup m_removegroup
m_renamegroup m_renamegroup
end type
end forward

global type m_outlookbar_menu from menu
m_outlook m_outlook
end type
global m_outlookbar_menu m_outlookbar_menu

type variables
uo_outlookbar ivo_Parent
end variables

on m_outlookbar_menu.create
m_outlookbar_menu=this
this.m_outlook=create m_outlook
this.Item[]={this.m_outlook}
end on

on m_outlookbar_menu.destroy
destroy(this.m_outlook)
end on

type m_outlook from menu within m_outlookbar_menu
m_largeicons m_largeicons
m_smallicons m_smallicons
m_1 m_1
m_addnewgroup m_addnewgroup
m_removegroup m_removegroup
m_renamegroup m_renamegroup
end type

on m_outlook.create
this.Text="outlook"
this.m_largeicons=create m_largeicons
this.m_smallicons=create m_smallicons
this.m_1=create m_1
this.m_addnewgroup=create m_addnewgroup
this.m_removegroup=create m_removegroup
this.m_renamegroup=create m_renamegroup
this.Item[]={this.m_largeicons, &
this.m_smallicons, &
this.m_1, &
this.m_addnewgroup, &
this.m_removegroup, &
this.m_renamegroup}
end on

on m_outlook.destroy
destroy(this.m_largeicons)
destroy(this.m_smallicons)
destroy(this.m_1)
destroy(this.m_addnewgroup)
destroy(this.m_removegroup)
destroy(this.m_renamegroup)
end on

type m_largeicons from menu within m_outlook
end type

on m_largeicons.create
this.Text="&Large Icons"
end on

event clicked;IF (IsValid(ivo_Parent)) THEN ivo_Parent.of_LargeIcons()

end event

type m_smallicons from menu within m_outlook
end type

on m_smallicons.create
this.Text="&Small Icons"
end on

event clicked;IF (IsValid(ivo_Parent)) THEN ivo_Parent.of_SmallIcons()

end event

type m_1 from menu within m_outlook
end type

on m_1.create
this.Text="-"
this.Visible=false
end on

type m_addnewgroup from menu within m_outlook
end type

on m_addnewgroup.create
this.Text="&Add New Group"
this.Visible=false
end on

type m_removegroup from menu within m_outlook
end type

on m_removegroup.create
this.Text="R&emove Group"
this.Visible=false
end on

type m_renamegroup from menu within m_outlook
end type

on m_renamegroup.create
this.Text="&Rename Group"
this.Visible=false
end on

