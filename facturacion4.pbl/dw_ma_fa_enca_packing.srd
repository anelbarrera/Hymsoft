 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatempaq~" ) COLUMN(NAME=~"fatempaq.enca_g_financiero~") COLUMN(NAME=~"fatempaq.enca_empresa~") COLUMN(NAME=~"fatempaq.enca_lista_empaque~") COLUMN(NAME=~"fatempaq.enca_ann~") COLUMN(NAME=~"fatempaq.enca_fuente~") COLUMN(NAME=~"fatempaq.enca_no_pedido~") COLUMN(NAME=~"fatempaq.enca_ann_pedido~") COLUMN(NAME=~"fatempaq.enca_tipo~") COLUMN(NAME=~"fatempaq.enca_no_factura~") COLUMN(NAME=~"fatempaq.enca_fecha_inicio~") COLUMN(NAME=~"fatempaq.enca_autorizado_por~") COLUMN(NAME=~"fatempaq.enca_supervisor~") COLUMN(NAME=~"fatempaq.enca_recolector~") COLUMN(NAME=~"fatempaq.enca_empacador~") COLUMN(NAME=~"fatempaq.enca_despachador~") COLUMN(NAME=~"fatempaq.enca_fecha_recolectado~") COLUMN(NAME=~"fatempaq.enca_fecha_empacado~") COLUMN(NAME=~"fatempaq.enca_fecha_despachado~") COLUMN(NAME=~"fatempaq.enca_recolectado~") COLUMN(NAME=~"fatempaq.enca_empacado~") COLUMN(NAME=~"fatempaq.enca_despachado~") COLUMN(NAME=~"fatempaq.enca_observacion~") COLUMN(NAME=~"fatempaq.enca_pasado~") COMPUTE(NAME=~"'                                                                                                           ' cliente~") COLUMN(NAME=~"fatempaq.enca_sello~") COLUMN(NAME=~"fatempaq.enca_contenedor~") COLUMN(NAME=~"fatempaq.enca_transporte~") COLUMN(NAME=~"fatempaq.enca_bultos_total~") COLUMN(NAME=~"fatempaq.enca_pase_fact~")WHERE(    EXP1 =~"( fatempaq.enca_g_financiero~"   OP =~"=~"    EXP2 =~":enca_grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatempaq.enca_empresa~"   OP =~"=~"    EXP2 =~":enca_empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatempaq.enca_lista_empaque~"   OP =~"=~"    EXP2 =~":enca_no_pack )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatempaq.enca_ann~"   OP =~"=~"    EXP2 =~":enca_ann )~" ) ) ARG(NAME = ~"enca_grupo~" TYPE = number)  ARG(NAME = ~"enca_empresa~" TYPE = number)  ARG(NAME = ~"enca_no_pack~" TYPE = string)  ARG(NAME = ~"enca_ann~" TYPE = number) " update="fatempaq" updatewhere=1 updatekeyinplace=no arguments=(("enca_grupo", number),("enca_empresa", number),("enca_no_pack", string),("enca_ann", number)) )
