//objectcomments Convierte a la Unidad que se Solicite
global type gf_fa_convertuni2 from function_object
end type

forward prototypes
global subroutine gf_fa_convertuni2 (readonly string as_med, readonly long al_fracciones, ref long al_cantidad, ref long al_fraccion)
end prototypes

global subroutine gf_fa_convertuni2 (readonly string as_med, readonly long al_fracciones, ref long al_cantidad, ref long al_fraccion);/*Esta Función Convierte de Unidad Minima a la Unidad que se Quiere*/
Double ld_total,ld_ucom
long   ll_mconvera,ll_frac

 
/*Extrae la Unidad comun "Pedo/Unidades/etc "*/
ld_ucom = gf_medi_prod(as_med)


/*Retorna el Factor de Converción a unidades minimas*/
ll_mconvera = gf_unidad_venta(as_med, ld_ucom)

/*Cambio realizado el 20/01/2000 por hgn
Si la unidad de conversión es un decimal que no aplique*/

//if int(ld_mconvera) <> ld_mconvera then return
/* Fin del cambio                      */

If ll_mconvera <= 0 Then ll_mconvera = 1

ld_total = ( al_fracciones / ll_mconvera) 

ll_frac = (Mod(al_fracciones, ll_mconvera))

al_cantidad = Long(ld_total)
al_fraccion = ll_frac
end subroutine

