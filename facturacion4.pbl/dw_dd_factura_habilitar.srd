//objectcomments Para habilitar la factura
release 7;
datawindow(units=0 timer_interval=0 color=79416533 processing=0 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=64 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=60 color="536870912" )
table(column=(type=char(8) updatewhereclause=yes name=fact_no_pedido dbname="fatdiari.fact_no_pedido" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fatdiari.fact_fecha" initial="today" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_factura dbname="fatdiari.fact_no_factura" )
 column=(type=char(3) updatewhereclause=yes name=fact_tipo dbname="fatdiari.fact_tipo" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_ann dbname="fatdiari.fact_ann" )
 column=(type=char(1) updatewhereclause=yes name=fatdiari_fact_estado dbname="fatdiari.fact_estado" )
 column=(type=char(2) updatewhereclause=yes name=fact_condicion_pago dbname="fatdiari.fact_condicion_pago" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_estado~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~")    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_fac_key~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa_fac_key~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'I'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_no_pedido~"   OP =~"not like~"    EXP2 =~"'%NC%'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_act_conta~"   OP =~"<>~"    EXP2 =~"1~" ) ) ARG(NAME = ~"grupo_fac_key~" TYPE = number)  ARG(NAME = ~"empresa_fac_key~" TYPE = number) " retrieve.asneeded=yes arguments=(("grupo_fac_key", number),("empresa_fac_key", number))  sort="fact_no_factura A real(fact_no_pedido) A fact_ann A fact_fecha A " )
