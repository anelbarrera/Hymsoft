 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"faaparam~" )  TABLE(NAME=~"dgaperio~" )  TABLE(NAME=~"inmbodeg~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"fadpedid~" )  TABLE(NAME=~"fatpedid~" )  TABLE(NAME=~"cracolor~" )  TABLE(NAME=~"craespec~" )  TABLE(NAME=~"cramarca~" )  TABLE(NAME=~"crataman~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"cracltam~" ) COLUMN(NAME=~"dgmempre.empr_direccion~") COLUMN(NAME=~"dgmempre.empr_apartado_postal~") COLUMN(NAME=~"dgmempre.empr_telefono1~") COLUMN(NAME=~"dgmempre.empr_telefono2~") COLUMN(NAME=~"dgmempre.empr_fax1~") COLUMN(NAME=~"dgmempre.empr_fax2~") COLUMN(NAME=~"dgmempre.empr_e_mail~") COLUMN(NAME=~"inmprodu.prod_marca~") COLUMN(NAME=~"inmprodu.prod_pais~") COLUMN(NAME=~"dgmempre.empr_ficha~") COLUMN(NAME=~"dgmempre.empr_rollo~") COLUMN(NAME=~"dgmempre.empr_imagen~") COLUMN(NAME=~"dgmempre.empr_dijito_verificador~") COLUMN(NAME=~"faaparam.fara_logo_f~") COLUMN(NAME=~"faaparam.fara_logo~") COLUMN(NAME=~"dgaperio.peri_descripcion~") COLUMN(NAME=~"inmbodeg.mbod_cantidad~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_descripcion~") COLUMN(NAME=~"inmprodu.prod_medida~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"inmbodeg.mbod_reserva~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COLUMN(NAME=~"fadpedid.dped_g_financiero~") COLUMN(NAME=~"fadpedid.dped_empresa~") COLUMN(NAME=~"fadpedid.dped_no_pedido~") COLUMN(NAME=~"fadpedid.dped_ann~") COLUMN(NAME=~"fadpedid.dped_linea~") COLUMN(NAME=~"fadpedid.dped_producto_servicio~") COLUMN(NAME=~"fadpedid.dped_codigo_item~") COLUMN(NAME=~"fadpedid.dped_descripcion_alterna~") COLUMN(NAME=~"fadpedid.dped_cubicaje~") COLUMN(NAME=~"fadpedid.dped_peso~") COLUMN(NAME=~"fadpedid.dped_unidad_peso~") COLUMN(NAME=~"fadpedid.dped_unidad_producto~") COLUMN(NAME=~"fadpedid.dped_precio_mayor~") COLUMN(NAME=~"fadpedid.dped_precio_menor~") COLUMN(NAME=~"fadpedid.dped_bodega~") COLUMN(NAME=~"fadpedid.dped_costo_fob~") COLUMN(NAME=~"fadpedid.dped_costo_cif~") COLUMN(NAME=~"fadpedid.dped_precio_unidad_producto~") COLUMN(NAME=~"fadpedid.dped_unidad_venta~") COLUMN(NAME=~"fadpedid.dped_cantidad~") COLUMN(NAME=~"fadpedid.dped_fraccion~") COLUMN(NAME=~"fadpedid.dped_monto_total~") COLUMN(NAME=~"fadpedid.dped_por_descuento~") COLUMN(NAME=~"fadpedid.dped_monto_final~") COLUMN(NAME=~"fadpedid.dped_fecha_reg~") COLUMN(NAME=~"fadpedid.dped_usuario~") COLUMN(NAME=~"fadpedid.dped_supervisor~") COLUMN(NAME=~"fadpedid.dped_bultos~") COLUMN(NAME=~"fadpedid.dped_ubicacion~") COLUMN(NAME=~"fadpedid.dped_pasada~") COLUMN(NAME=~"fatpedid.pedi_empresa~") COLUMN(NAME=~"fatpedid.pedi_tipo~") COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_ann~") COLUMN(NAME=~"fatpedid.pedi_cliente~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~") COLUMN(NAME=~"fatpedid.pedi_condicion_pago~") COLUMN(NAME=~"fatpedid.pedi_tipo_venta~") COLUMN(NAME=~"fatpedid.pedi_tipo_movimiento~") COLUMN(NAME=~"fatpedid.pedi_no_traspaso~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_fecha_creacion~") COLUMN(NAME=~"fatpedid.pedi_fecha_modificacion~") COLUMN(NAME=~"fatpedid.pedi_dias_pago~") COLUMN(NAME=~"fatpedid.pedi_consignado~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fatpedid.pedi_a_nombre_direccion~") COLUMN(NAME=~"fatpedid.pedi_despachado~") COLUMN(NAME=~"fatpedid.pedi_via~") COLUMN(NAME=~"fatpedid.pedi_con_emb_no~") COLUMN(NAME=~"fatpedid.pedi_marca~") COLUMN(NAME=~"fatpedid.pedi_bultos_total~") COLUMN(NAME=~"fatpedid.pedi_cubicaje_total~") COLUMN(NAME=~"fatpedid.pedi_peso_total~") COLUMN(NAME=~"fatpedid.pedi_gastos_total~") COLUMN(NAME=~"fatpedid.pedi_monto_total~") COLUMN(NAME=~"fatpedid.pedi_descu_subt_deta~") COLUMN(NAME=~"fatpedid.pedi_por_descuento~") COLUMN(NAME=~"fatpedid.pedi_supervisor~") COLUMN(NAME=~"fatpedid.pedi_monto_final~") COLUMN(NAME=~"fatpedid.pedi_comentario~") COLUMN(NAME=~"fatpedid.pedi_estado~") COLUMN(NAME=~"fatpedid.pedi_g_financiero~") COLUMN(NAME=~"fatpedid.pedi_unidad_peso~") COMPUTE(NAME=~"inmbodeg.mbod_cantidad - inmbodeg.mbod_reserva disponible, ~~~"~~~" cambio, ~~~"~~~" parcial~") COLUMN(NAME=~"fadpedid.dped_index~") COMPUTE(NAME=~"convert(numeric(15,0),(mbod_cantidad/inamedid.medi_cantidad)) entero~") COMPUTE(NAME=~"mbod_cantidad - (convert(numeric(15,0),(mbod_cantidad / inamedid.medi_cantidad)) * inamedid.medi_cantidad) fraccion~") COMPUTE(NAME=~"convert(numeric(15,0),((mbod_cantidad -  mbod_reserva)/inamedid.medi_cantidad)) dis_entero~") COMPUTE(NAME=~"(mbod_cantidad - mbod_reserva) - (convert(numeric(15,0),((mbod_cantidad - mbod_reserva) / inamedid.medi_cantidad)) * inamedid.medi_cantidad) dis_fraccion~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"cramarca.amar_nombre_marca~") COLUMN(NAME=~"craespec.aesp_descripcion_espec~") COLUMN(NAME=~"cracolor.acol_nombre_color~") COLUMN(NAME=~"crataman.atam_descripcion_tam~") COLUMN(NAME=~"cracltam.acta_descripcion~") COLUMN(NAME=~"inmprodu.prod_peso~") COLUMN(NAME=~"inmprodu.prod_cubicaje~") COLUMN(NAME=~"fadpedid.dped_bulto_inicio~") COLUMN(NAME=~"fadpedid.dped_bulto_fin~") COLUMN(NAME=~"inmprodu.prod_cod_alternativo~")    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cracolor.acol_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cracolor.acol_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_color~"    OP =~"=~"RIGHT=~"cracolor.acol_num_color~"    OUTER1 =~"inmprodu.prod_color~" )    JOIN (LEFT=~"inmprodu.prod_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~"    OUTER1 =~"inmprodu.prod_pais~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cramarca.amar_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cramarca.amar_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_marca~"    OP =~"=~"RIGHT=~"cramarca.amar_num_marca~"    OUTER1 =~"inmprodu.prod_marca~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"craespec.aesp_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"craespec.aesp_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_compuesto~"    OP =~"=~"RIGHT=~"craespec.aesp_num_especificacion~"    OUTER1 =~"inmprodu.prod_compuesto~" )    JOIN (LEFT=~"cracltam.acta_g_financiero~"    OP =~"=~"RIGHT=~"crataman.atam_g_financiero~"    OUTER1 =~"cracltam.acta_g_financiero~" )    JOIN (LEFT=~"cracltam.acta_empresa~"    OP =~"=~"RIGHT=~"crataman.atam_empresa~"    OUTER1 =~"cracltam.acta_empresa~" )    JOIN (LEFT=~"cracltam.acta_cod_clase_tam~"    OP =~"=~"RIGHT=~"crataman.atam_cod_clase_tam~"    OUTER1 =~"cracltam.acta_cod_clase_tam~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cracltam.acta_g_financiero~"    OUTER1 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cracltam.acta_empresa~"    OUTER1 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmprodu.prod_cod_clase_tam~"    OP =~"=~"RIGHT=~"cracltam.acta_cod_clase_tam~"    OUTER1 =~"inmprodu.prod_cod_clase_tam~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"fadpedid.dped_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"fadpedid.dped_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_no_pedido~"    OP =~"=~"RIGHT=~"fadpedid.dped_no_pedido~" )    JOIN (LEFT=~"fatpedid.pedi_ann~"    OP =~"=~"RIGHT=~"fadpedid.dped_ann~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"fadpedid.dped_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"fadpedid.dped_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"fadpedid.dped_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"fadpedid.dped_g_financiero~"    OP =~"=~"RIGHT=~"inmbodeg.mbod_g_financiero~" )    JOIN (LEFT=~"fadpedid.dped_empresa~"    OP =~"=~"RIGHT=~"inmbodeg.mbod_empresa~" )    JOIN (LEFT=~"fadpedid.dped_bodega~"    OP =~"=~"RIGHT=~"inmbodeg.mbod_bodega~" )    JOIN (LEFT=~"fadpedid.dped_ubicacion~"    OP =~"=~"RIGHT=~"inmbodeg.mbod_ubicacion~" )    JOIN (LEFT=~"fadpedid.dped_codigo_item~"    OP =~"=~"RIGHT=~"inmbodeg.mbod_producto~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_dias_pago~"    OP =~"=~"RIGHT=~"dgaperio.peri_periodo~" )WHERE(    EXP1 =~"((fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_ann~"   OP =~"=~"    EXP2 =~":an )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA' ) )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("pedido", string),("an", number))  sort="dped_bulto_inicio A dped_index A " )
