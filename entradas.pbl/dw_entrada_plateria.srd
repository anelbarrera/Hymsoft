 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"entrada_plateria~" ) COLUMN(NAME=~"entrada_plateria.grupo~") COLUMN(NAME=~"entrada_plateria.empresa~") COLUMN(NAME=~"entrada_plateria.registro~") COLUMN(NAME=~"entrada_plateria.fecha~") COLUMN(NAME=~"entrada_plateria.tipo_plateria~") COLUMN(NAME=~"entrada_plateria.valor_compra~") COLUMN(NAME=~"entrada_plateria.cantidad_gramos~") COLUMN(NAME=~"entrada_plateria.precio~") COLUMN(NAME=~"entrada_plateria.promedio~") COLUMN(NAME=~"entrada_plateria.usuario~") COLUMN(NAME=~"entrada_plateria.proveedor~") COLUMN(NAME=~"entrada_plateria.ann~") COMPUTE(NAME=~"0.00 tot_gramos~") COMPUTE(NAME=~"0.00 tot_valor~")WHERE(    EXP1 =~"entrada_plateria.grupo~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"entrada_plateria.empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"entrada_plateria.registro~"   OP =~"=~"    EXP2 =~":registro~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"entrada_plateria.ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"registro~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " update="entrada_plateria" updatewhere=1 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("registro", number),("ann", number)) )
