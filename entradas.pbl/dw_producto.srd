inmprodu.prod_cantidad_limite ,
inmprodu.prod_empaque ,
inmprodu.prod_metros_cubicos ,
inmprodu.prod_punto_maximo ,
inmprodu.prod_cant_a_pedir ,
datediff(month, prod_entrada_fecha, getdate()) mes,
case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_reserva_total/inamedid.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_reserva_total/inamedid.medi_cantidad)) end reserva,
case medi_tipo_medida when 10 then convert(numeric(11,0),((inmprodu.prod_existencia_total - prod_reserva_total) /inamedid.medi_cantidad)) else convert(numeric(11,3),((inmprodu.prod_existencia_total - prod_reserva_total) /inamedid.medi_cantidad)) end disponible,
case medi_tipo_medida when 10 then convert(numeric(11,0),(inmprodu.prod_existencia_total/inamedid.medi_cantidad)) else convert(numeric(11,3),(inmprodu.prod_existencia_total/inamedid.medi_cantidad)) end entero,
costo_fob = '                    ',
costo_cif = '                    ',
costo_promedio = '                    ',
ver_en_letras = 0,
armar_descripcion = 0,
inmprodu.prod_itbm_local ,
inmprodu.prod_orden_compra ,
inmprodu.prod_cantidad_oc ,
inmprodu.prod_costo_oc ,
inmprodu.prod_descripcion ,
inmprodu.prod_costo_cif ,
inmprodu.prod_sku ,
inmprodu.prod_foto_catalogo ,
inmprodu.prod_gramaje ,
inmprodu.prod_nivel1 ,
inmprodu.prod_nivel2 ,
inmprodu.prod_nivel3 ,
inmprodu.prod_nivel4 ,
inmprodu.prod_nivel5 ,
inmprodu.prod_foto_editada ,
inmprodu.prod_contrato ,
inmprodu.prod_gramaje_tela,
inmprodu.prod_sexo,
inmprodu.prod_desc_item,
inmprodu.prod_material,
inmprodu.prod_mat_descripcion
FROM inmprodu,
inamedid
WHERE ( inmprodu.prod_medida = inamedid.medi_medida ) and
( inmprodu.prod_g_financiero = :grupo ) and
( inmprodu.prod_empresa = :empresa ) and
( inmprodu.prod_producto = :producto )   " update="inmprodu" updatewhere=0 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("producto", string)) )
