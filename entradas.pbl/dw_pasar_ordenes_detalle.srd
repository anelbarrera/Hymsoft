 column=(type=decimal(0) updatewhereclause=yes name=pendiente dbname="pendiente" )
 column=(type=decimal(0) updatewhereclause=yes name=deta_linea dbname="orden_detalle.deta_linea" )
 column=(type=char(20) updatewhereclause=yes name=deta_referencia dbname="orden_detalle.deta_referencia" )
