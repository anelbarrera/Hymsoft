 column=(type=decimal(0) updatewhereclause=yes name=deta_cantidad dbname="orden_detalle.deta_cantidad" )
 column=(type=char(200) updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" )
 column=(type=decimal(4) updatewhereclause=yes name=deta_costo dbname="orden_detalle.deta_costo" )
 column=(type=char(15) updatewhereclause=yes name=deta_secuencia dbname="orden_detalle.deta_secuencia" )
 column=(type=decimal(0) updatewhereclause=yes name=deta_ann dbname="orden_detalle.deta_ann" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"orden_detalle~" )  TABLE(NAME=~"inmprodu~" ) COMPUTE(NAME=~"convert(numeric(10,0),( orden_detalle.deta_pasada / inamedid.medi_cantidad)) pasada~") COMPUTE(NAME=~"pasar = 0~") COMPUTE(NAME=~"convert(numeric(10,0), (( orden_detalle.deta_cantidad * inamedid.medi_cantidad - orden_detalle.deta_pasada ) / inamedid.medi_cantidad) )  por_pasar~") COMPUTE(NAME=~"convert(numeric(10,0), (( orden_detalle.deta_cantidad * inamedid.medi_cantidad ) - orden_detalle.deta_pasada  / inamedid.medi_cantidad))  pendiente~") COLUMN(NAME=~"orden_detalle.deta_linea~") COLUMN(NAME=~"orden_detalle.deta_referencia~") COLUMN(NAME=~"orden_detalle.deta_unidad~") COLUMN(NAME=~"orden_detalle.deta_cantidad~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"orden_detalle.deta_costo~") COLUMN(NAME=~"orden_detalle.deta_secuencia~") COLUMN(NAME=~"orden_detalle.deta_ann~")    JOIN (LEFT=~"orden_detalle.deta_unidad~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"orden_detalle.deta_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"orden_detalle.deta_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"orden_detalle.deta_referencia~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"orden_detalle.deta_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"orden_detalle.deta_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"orden_detalle.deta_secuencia~"   OP =~"=~"    EXP2 =~":prof~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"orden_detalle.deta_ann~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"convert(numeric(10,0), (( orden_detalle.deta_cantidad * inamedid.medi_cantidad ) - orden_detalle.deta_pasada) / inamedid.medi_cantidad)~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"prof~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("prof", string),("ann", number))  sort="deta_linea A " )
