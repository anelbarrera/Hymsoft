 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"intmovim~" ) COLUMN(NAME=~"intmovim.tmov_g_financiero~") COLUMN(NAME=~"intmovim.tmov_empresa~") COLUMN(NAME=~"intmovim.tmov_aplicacion~") COLUMN(NAME=~"intmovim.tmov_tipo_transaccion~") COLUMN(NAME=~"intmovim.tmov_secuencia~") COLUMN(NAME=~"intmovim.tmov_concepto~") COLUMN(NAME=~"intmovim.tmov_anual~") COLUMN(NAME=~"intmovim.tmov_descripcion~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"intmovim.tmov_autoriza~") COLUMN(NAME=~"intmovim.tmov_documento~") COLUMN(NAME=~"intmovim.tmov_fecha_registro~") COLUMN(NAME=~"intmovim.tmov_terceros~") COLUMN(NAME=~"intmovim.tmov_comentario~") COLUMN(NAME=~"intmovim.tmov_tipo_costo~") COLUMN(NAME=~"intmovim.tmov_id~") COLUMN(NAME=~"intmovim.tmov_tipo~") COLUMN(NAME=~"intmovim.tmov_estado~") COLUMN(NAME=~"intmovim.tmov_anulado~") COLUMN(NAME=~"intmovim.tmov_total_cargos~") COLUMN(NAME=~"intmovim.tmov_fecha_actualizacion~") COLUMN(NAME=~"intmovim.tmov_documento_entrada~") COLUMN(NAME=~"intmovim.tmov_estado_costo~") COLUMN(NAME=~"intmovim.tmov_forma_costeo~") COLUMN(NAME=~"intmovim.tmov_tipo_trafico~") COLUMN(NAME=~"intmovim.tmov_documento_comercial~") COLUMN(NAME=~"intmovim.tmov_fecha_cierre_mensual~") COLUMN(NAME=~"intmovim.tmov_cuenta~") COLUMN(NAME=~"intmovim.tmov_nombre_tercero~") COLUMN(NAME=~"intmovim.tmov_tipo_gasto~") COLUMN(NAME=~"intmovim.tmov_estado_entrada~") COLUMN(NAME=~"intmovim.tmov_descuento~") COLUMN(NAME=~"intmovim.tmov_total_cargos_final~") COLUMN(NAME=~"intmovim.tmov_ruta_factura~")WHERE(    EXP1 =~"intmovim.tmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_anual~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " update="intmovim" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number)) )
