 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"entrada_plateria~" ) COLUMN(NAME=~"entrada_plateria.tipo_plateria~") COLUMN(NAME=~"entrada_plateria.registro~") COLUMN(NAME=~"entrada_plateria.fecha~") COLUMN(NAME=~"entrada_plateria.proveedor~") COLUMN(NAME=~"entrada_plateria.cantidad_gramos~") COLUMN(NAME=~"entrada_plateria.valor_compra~") COLUMN(NAME=~"entrada_plateria.promedio~")WHERE(    EXP1 =~"entrada_plateria.grupo~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"entrada_plateria.empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"entrada_plateria.ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("ann", number))  sort="fecha A tipo_plateria A registro A " )
