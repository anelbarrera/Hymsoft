 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"transito~" ) COLUMN(NAME=~"transito.enca_g_financiero~") COLUMN(NAME=~"transito.enca_empresa~") COLUMN(NAME=~"transito.enca_secuencia~") COLUMN(NAME=~"transito.enca_ann~") COLUMN(NAME=~"transito.enca_proveedor~") COLUMN(NAME=~"transito.enca_fecha~") COLUMN(NAME=~"transito.enca_fecha_despacho~") COLUMN(NAME=~"transito.enca_fecha_llegada~") COLUMN(NAME=~"transito.enca_comentario~") COLUMN(NAME=~"transito.enca_usuario~") COLUMN(NAME=~"transito.enca_costo_total~") COLUMN(NAME=~"transito.enca_tipo~") COLUMN(NAME=~"transito.enca_documento~") COLUMN(NAME=~"transito.enca_estado~") COLUMN(NAME=~"transito.enca_cliente~")WHERE(    EXP1 =~"transito.enca_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"transito.enca_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"transito.enca_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"transito.enca_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="transito" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("secuencia", string),("ann", number)) )
