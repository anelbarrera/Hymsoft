 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"indmovim~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"indmovim.dmov_g_financiero~") COLUMN(NAME=~"indmovim.dmov_empresa~") COLUMN(NAME=~"indmovim.dmov_aplicacion~") COLUMN(NAME=~"indmovim.dmov_tipo_transaccion~") COLUMN(NAME=~"indmovim.dmov_concepto~") COLUMN(NAME=~"indmovim.dmov_secuencia~") COLUMN(NAME=~"indmovim.dmov_anual~") COLUMN(NAME=~"indmovim.dmov_linea~") COLUMN(NAME=~"indmovim.dmov_documento~") COLUMN(NAME=~"indmovim.dmov_bodega~") COLUMN(NAME=~"indmovim.dmov_ubicacion~") COLUMN(NAME=~"indmovim.dmov_producto~") COLUMN(NAME=~"indmovim.dmov_cantidad~") COLUMN(NAME=~"indmovim.dmov_cant1~") COLUMN(NAME=~"indmovim.dmov_unidad_medida~") COLUMN(NAME=~"indmovim.dmov_cubicaje~") COLUMN(NAME=~"indmovim.dmov_peso~") COLUMN(NAME=~"indmovim.dmov_bulto~") COLUMN(NAME=~"indmovim.dmov_id~") COLUMN(NAME=~"indmovim.dmov_costo_fob~") COLUMN(NAME=~"indmovim.dmov_costo~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COLUMN(NAME=~"inamedid.medi_tipo_medida~") COLUMN(NAME=~"indmovim.dmov_monto_final~") COLUMN(NAME=~"indmovim.dmov_costo_cif~") COLUMN(NAME=~"indmovim.dmov_modelo~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"indmovim.dmov_orden_compra~") COLUMN(NAME=~"indmovim.dmov_ann_orden~") COLUMN(NAME=~"indmovim.dmov_linea_orden~") COMPUTE(NAME=~"1 imprimir~") COLUMN(NAME=~"indmovim.dmov_transito~") COLUMN(NAME=~"indmovim.dmov_ann_transito~") COLUMN(NAME=~"indmovim.dmov_linea_transito~") COLUMN(NAME=~"indmovim.dmov_lote~") COLUMN(NAME=~"indmovim.dmov_fecha_elaboracion~") COLUMN(NAME=~"indmovim.dmov_fecha_expiracion~")    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"indmovim.dmov_producto~" )WHERE(    EXP1 =~"indmovim.dmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"indmovim.dmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"indmovim.dmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"indmovim.dmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_anual~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " update="indmovim" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number))  sort="dmov_linea A " )
