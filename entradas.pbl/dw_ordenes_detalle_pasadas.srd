table(column=(type=decimal(2) updatewhereclause=yes name=pasada dbname="pasada" )
 column=(type=long updatewhereclause=yes name=pasar dbname="pasar" values="	1/	0" )
 column=(type=decimal(6) updatewhereclause=yes name=dmov_cantidad dbname="indmovim.dmov_cantidad" )
 column=(type=decimal(2) updatewhereclause=yes name=pendiente dbname="pendiente" )
 column=(type=decimal(0) updatewhereclause=yes name=dmov_linea dbname="indmovim.dmov_linea" )
 column=(type=char(20) updatewhereclause=yes name=dmov_producto dbname="indmovim.dmov_producto" )
 column=(type=char(2) updatewhereclause=yes name=dmov_unidad_medida dbname="indmovim.dmov_unidad_medida" )
 column=(type=decimal(2) updatewhereclause=yes name=por_pasar dbname="por_pasar" )
 column=(type=char(200) updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" )
 column=(type=decimal(8) updatewhereclause=yes name=dmov_costo_fob dbname="indmovim.dmov_costo_fob" )
 column=(type=char(15) updatewhereclause=yes name=dmov_orden_compra dbname="indmovim.dmov_orden_compra" )
 column=(type=decimal(0) updatewhereclause=yes name=dmov_ann_orden dbname="indmovim.dmov_ann_orden" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"indmovim~" ) COMPUTE(NAME=~"0.00 pasada~") COMPUTE(NAME=~"pasar = 0~") COLUMN(NAME=~"indmovim.dmov_cantidad~") COMPUTE(NAME=~"0.00  pendiente~") COLUMN(NAME=~"indmovim.dmov_linea~") COLUMN(NAME=~"indmovim.dmov_producto~") COLUMN(NAME=~"indmovim.dmov_unidad_medida~") COMPUTE(NAME=~"0.00  por_pasar~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"indmovim.dmov_costo_fob~") COLUMN(NAME=~"indmovim.dmov_orden_compra~") COLUMN(NAME=~"indmovim.dmov_ann_orden~")    JOIN (LEFT=~"indmovim.dmov_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"indmovim.dmov_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"indmovim.dmov_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"indmovim.dmov_unidad_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )) "  sort="dmov_orden_compra A dmov_ann_orden A dmov_linea A " )
