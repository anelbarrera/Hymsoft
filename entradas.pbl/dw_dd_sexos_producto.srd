table(column=(type=char(5) updatewhereclause=yes name=sex_codigo dbname="crasexo.sex_codigo" )
 column=(type=char(50) updatewhereclause=yes name=sex_desc_eng dbname="crasexo.sex_desc_eng" )
 column=(type=char(50) updatewhereclause=yes name=sex_desc_spa dbname="crasexo.sex_desc_spa" )
 column=(type=char(5) updatewhereclause=yes name=tipse_codigo_tipo dbname="cratipoxsexo.tipse_codigo_tipo" )
 column=(type=char(122) updatewhereclause=yes name=descrip dbname="descrip" )
 column=(type=char(30) updatewhereclause=yes name=sex_descrip_eng dbname="crasexo.sex_descrip_eng" )
 column=(type=char(30) updatewhereclause=yes name=sex_descrip_spa dbname="crasexo.sex_descrip_spa" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crasexo~" )  TABLE(NAME=~"cratipoxsexo~" )  TABLE(NAME=~"cratipoprod~" ) COLUMN(NAME=~"crasexo.sex_codigo~") COLUMN(NAME=~"crasexo.sex_desc_eng~") COLUMN(NAME=~"crasexo.sex_desc_spa~") COLUMN(NAME=~"cratipoxsexo.tipse_codigo_tipo~") COMPUTE(NAME=~"crasexo.sex_desc_eng + ~~~"                                                              ~~~" + tipse_codigo_tipo + tipse_codigo_sexo descrip~") COLUMN(NAME=~"crasexo.sex_descrip_eng~") COLUMN(NAME=~"crasexo.sex_descrip_spa~")    JOIN (LEFT=~"crasexo.sex_g_financiero~"    OP =~"=~"RIGHT=~"cratipoxsexo.tipse_g_financiero~" )    JOIN (LEFT=~"crasexo.sex_empresa~"    OP =~"=~"RIGHT=~"cratipoxsexo.tipse_empresa~" )    JOIN (LEFT=~"crasexo.sex_codigo~"    OP =~"=~"RIGHT=~"cratipoxsexo.tipse_codigo_sexo~" )    JOIN (LEFT=~"cratipoxsexo.tipse_g_financiero~"    OP =~"=~"RIGHT=~"cratipoprod.tprod_g_financiero~" )    JOIN (LEFT=~"cratipoxsexo.tipse_empresa~"    OP =~"=~"RIGHT=~"cratipoprod.tprod_empresa~" )    JOIN (LEFT=~"cratipoxsexo.tipse_codigo_tipo~"    OP =~"=~"RIGHT=~"cratipoprod.tprod_codigo~" )WHERE(    EXP1 =~"( ( cratipoxsexo.tipse_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cratipoxsexo.tipse_empresa~"   OP =~"=~"    EXP2 =~":empresa ) )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number)) )
