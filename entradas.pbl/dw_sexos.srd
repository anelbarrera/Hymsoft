 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"crasexo~" ) COLUMN(NAME=~"crasexo.sex_g_financiero~") COLUMN(NAME=~"crasexo.sex_empresa~") COLUMN(NAME=~"crasexo.sex_codigo~") COLUMN(NAME=~"crasexo.sex_desc_eng~") COLUMN(NAME=~"crasexo.sex_desc_spa~") COLUMN(NAME=~"crasexo.sex_orden~") COLUMN(NAME=~"crasexo.sex_foto~") COLUMN(NAME=~"crasexo.sex_descrip_eng~") COLUMN(NAME=~"crasexo.sex_descrip_spa~")WHERE(    EXP1 =~"crasexo.sex_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"crasexo.sex_empresa~"   OP =~"=~"    EXP2 =~":empresa~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " update="crasexo" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number))  sort="sex_orden A " )
