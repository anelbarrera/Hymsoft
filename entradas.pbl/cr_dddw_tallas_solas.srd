 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"cratallas~" ) COLUMN(NAME=~"cratallas.talla_codigo~") COLUMN(NAME=~"cratallas.talla_descripcion~")WHERE(    EXP1 =~"cratallas.talla_g_financiero~"   OP =~"=~"    EXP2 =~":g_finan~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cratallas.talla_empresa~"   OP =~"=~"    EXP2 =~":empresa~" ) ) ORDER(NAME=~"cratallas.talla_descripcion~" ASC=yes ) ARG(NAME = ~"g_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("g_finan", number),("empresa", number)) )
