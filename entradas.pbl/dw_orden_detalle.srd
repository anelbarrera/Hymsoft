table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=dcof_g_financiero dbname="crdconfi.dcof_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=dcof_empresa dbname="crdconfi.dcof_empresa" )
 column=(type=long update=yes updatewhereclause=yes key=yes name=dcof_num_ren_confi dbname="crdconfi.dcof_num_ren_confi" )
 column=(type=char(20) update=yes updatewhereclause=yes name=dcof_producto dbname="crdconfi.dcof_producto" )
 column=(type=char(2) update=yes updatewhereclause=yes name=dcof_unidad dbname="crdconfi.dcof_unidad" )
 column=(type=char(10) update=yes updatewhereclause=yes name=dcof_num_oc dbname="crdconfi.dcof_num_oc" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=dcof_anno_oc dbname="crdconfi.dcof_anno_oc" )
 column=(type=long update=yes updatewhereclause=yes name=crdconfi_dcof_num_ren_oc dbname="crdconfi.dcof_num_ren_oc" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=dcof_cantidad_total dbname="crdconfi.dcof_cantidad_total" initial="0.00" )
 column=(type=long update=yes updatewhereclause=yes name=crdconfi_dcof_estatus_ren dbname="crdconfi.dcof_estatus_ren" initial="1" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=dcof_bultos dbname="crdconfi.dcof_bultos" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=dcof_peso_neto dbname="crdconfi.dcof_peso_neto" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=crdconfi_dcof_peso_bruto dbname="crdconfi.dcof_peso_bruto" )
 column=(type=char(40) update=yes updatewhereclause=yes name=crdconfi_dcof_descripcion dbname="crdconfi.dcof_descripcion" )
 column=(type=long update=yes updatewhereclause=yes name=crdconfi_dcof_tipo_compra dbname="crdconfi.dcof_tipo_compra" initial="3" )
 column=(type=char(6) updatewhereclause=yes name=crdconfi_dcof_tipo_confirmacion dbname="crdconfi.dcof_tipo_confirmacion" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=dcof_cant_facturada dbname="crdconfi.dcof_cant_facturada" initial="0.00" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=crdconfi_dcof_cant_pendiente dbname="crdconfi.dcof_cant_pendiente" initial="0.00" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=dcof_cant1 dbname="crdconfi.dcof_cant1" )
 column=(type=long update=yes updatewhereclause=yes name=crdconfi_dcof_existe_detalle dbname="crdconfi.dcof_existe_detalle" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=dcof_precio1 dbname="crdconfi.dcof_precio1" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=crdconfi_dcof_precio2 dbname="crdconfi.dcof_precio2" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=crdconfi_dcof_precio3 dbname="crdconfi.dcof_precio3" )
 column=(type=char(15) update=yes updatewhereclause=yes name=crdconfi_dcof_board dbname="crdconfi.dcof_board" initial=" " )
 column=(type=char(5) update=yes updatewhereclause=yes name=crdconfi_dcof_color dbname="crdconfi.dcof_color" initial=" " )
 column=(type=char(100) updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" )
 column=(type=char(5) updatewhereclause=yes name=inmprodu_prod_cod_clase_tam dbname="inmprodu.prod_cod_clase_tam" )
 column=(type=long updatewhereclause=yes name=inmprodu_prod_definicion dbname="inmprodu.prod_definicion" )
 column=(type=decimal(8) updatewhereclause=yes name=inamedid_medi_cantidad dbname="inamedid.medi_cantidad" )
 column=(type=char(50) updatewhereclause=yes name=nomcol dbname="nomcol" )
 column=(type=decimal(6) update=yes updatewhereclause=yes name=crdconfi_dcof_cant_pase dbname="crdconfi.dcof_cant_pase" )
 column=(type=char(1) updatewhereclause=yes name=cclibre dbname="cclibre" )
 column=(type=decimal(4) updatewhereclause=yes name=elmont dbname="elmont" )
 column=(type=decimal(4) updatewhereclause=yes name=direct dbname="direct" )
 column=(type=decimal(4) updatewhereclause=yes name=flete dbname="flete" )
 column=(type=decimal(4) updatewhereclause=yes name=mylin dbname="mylin" )
 column=(type=decimal(4) updatewhereclause=yes name=pventa dbname="pventa" )
 column=(type=decimal(4) updatewhereclause=yes name=gastos dbname="gastos" )
 column=(type=decimal(4) updatewhereclause=yes name=margen dbname="margen" )
 column=(type=decimal(2) updatewhereclause=yes name=pagos dbname="pagos" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=dcof_cant1_facturada dbname="crdconfi.dcof_cant1_facturada" initial=" " )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=dcof_precio_u dbname="crdconfi.dcof_precio_u" validation="number(gettext()) > 0" )
 column=(type=datetime update=yes updatewhereclause=yes name=crdconfi_dcof_fecha_despacho dbname="crdconfi.dcof_fecha_despacho" initial=" " )
 column=(type=char(25) update=yes updatewhereclause=yes key=yes name=dcof_num_conf_oc dbname="crdconfi.dcof_num_conf_oc" )
 retrieve="  SELECT crdconfi.dcof_g_financiero,   
         crdconfi.dcof_empresa,   
         crdconfi.dcof_num_ren_confi,   
         crdconfi.dcof_producto,   
         crdconfi.dcof_unidad,   
         crdconfi.dcof_num_oc,   
         crdconfi.dcof_anno_oc,   
         crdconfi.dcof_num_ren_oc,   
         crdconfi.dcof_cantidad_total,   
         crdconfi.dcof_estatus_ren,   
         crdconfi.dcof_bultos,   
         crdconfi.dcof_peso_neto,   
         crdconfi.dcof_peso_bruto,   
         crdconfi.dcof_descripcion,   
         crdconfi.dcof_tipo_compra,   
         crdconfi.dcof_tipo_confirmacion,   
         crdconfi.dcof_cant_facturada,   
         crdconfi.dcof_cant_pendiente,   
         crdconfi.dcof_cant1,   
         crdconfi.dcof_existe_detalle,   
         crdconfi.dcof_precio1,   
         crdconfi.dcof_precio2,   
         crdconfi.dcof_precio3,   
         crdconfi.dcof_board,   
         crdconfi.dcof_color,   
         inmprodu.prod_descripcion,   
         inmprodu.prod_cod_clase_tam,   
         inmprodu.prod_definicion,   
         inamedid.medi_cantidad,   
         '                                                  'nomcol,   
         crdconfi.dcof_cant_pase,   
         cclibre = '',   
         0.0000 elmont, 0.0000 direct, 0.0000 flete, 0.0000 mylin, 0.0000 pventa, 0.0000 gastos, 0.0000 margen,  
			0.00 pagos, 
         crdconfi.dcof_cant1_facturada,   
         crdconfi.dcof_precio_u,   
         crdconfi.dcof_fecha_despacho,   
         crdconfi.dcof_num_conf_oc  
    FROM crdconfi,   
         inmprodu,   
         inamedid  
   WHERE ( inmprodu.prod_g_financiero = crdconfi.dcof_g_financiero ) and  
         ( inmprodu.prod_empresa = crdconfi.dcof_empresa ) and  
         ( inmprodu.prod_producto = crdconfi.dcof_producto ) and  
         ( inamedid.medi_medida = crdconfi.dcof_unidad ) and  
         (  crdconfi.dcof_g_financiero = :grupo ) AND  
         ( crdconfi.dcof_empresa = :empresa ) AND  
         ( crdconfi.dcof_num_conf_oc = :secuencia ) AND  
         ( crdconfi.dcof_anno_oc = :ann )     
" update="crdconfi" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("secuencia", string),("ann", number)) )
