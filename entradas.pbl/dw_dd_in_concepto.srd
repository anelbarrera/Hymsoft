 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"dgmsubse~" )  TABLE(NAME=~"dgmserdr~" ) COLUMN(NAME=~"dgmsubse.subs_sub_trans~") COLUMN(NAME=~"dgmsubse.subs_descripcion~")    JOIN (LEFT=~"dgmserdr.serd_g_financiero~"    OP =~"=~"RIGHT=~"dgmsubse.subs_g_financiero~" )    JOIN (LEFT=~"dgmserdr.serd_empresa~"    OP =~"=~"RIGHT=~"dgmsubse.subs_empresa~" )    JOIN (LEFT=~"dgmserdr.serd_transaccion~"    OP =~"=~"RIGHT=~"dgmsubse.subs_transaccion~" )    JOIN (LEFT=~"dgmserdr.serd_sub_trans~"    OP =~"=~"RIGHT=~"dgmsubse.subs_sub_trans~" )WHERE(    EXP1 =~"dgmserdr.serd_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_conce~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmserdr.serd_empresa~"   OP =~"=~"    EXP2 =~":empresa_conce~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmserdr.serd_aplicacion~"   OP =~"=~"    EXP2 =~":aplicacion_conce~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmserdr.serd_transaccion~"   OP =~"=~"    EXP2 =~":transaccion~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmserdr.serd_sub_trans~"   OP =~"<>~"    EXP2 =~"'SAE'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmserdr.serd_sub_trans~"   OP =~"<>~"    EXP2 =~"'SAS'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmserdr.serd_sub_trans~"   OP =~"<>~"    EXP2 =~"'SAT'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"dgmserdr.serd_sub_trans~"   OP =~"<>~"    EXP2 =~"'SAA'~" ) ) ARG(NAME = ~"grupo_conce~" TYPE = number)  ARG(NAME = ~"empresa_conce~" TYPE = number)  ARG(NAME = ~"aplicacion_conce~" TYPE = string)  ARG(NAME = ~"transaccion~" TYPE = string) " arguments=(("grupo_conce", number),("empresa_conce", number),("aplicacion_conce", string),("transaccion", string)) )
