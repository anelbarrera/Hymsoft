table(column=(type=char(5) updatewhereclause=yes name=prod_marca dbname="inmprodu.prod_marca" dbalias=".prod_marca" )
 column=(type=char(44) updatewhereclause=yes name=car_descripcion dbname="car_descripcion" )
 column=(type=char(15) updatewhereclause=yes name=bultos dbname="bultos" )
 column=(type=long updatewhereclause=yes name=linea_subt dbname="linea_subt" )
 column=(type=char(20) updatewhereclause=yes name=dgmterce_terc_identificacion dbname="dgmterce.terc_identificacion" dbalias=".terc_identificacion" )
 column=(type=long updatewhereclause=yes name=grupo dbname="grupo" )
 column=(type=char(10) updatewhereclause=yes name=medi_abre dbname="inamedid.medi_abre" dbalias=".medi_abre" )
 column=(type=char(20) updatewhereclause=yes name=prod_producto_dos dbname="inmprodu.prod_producto_dos" dbalias=".prod_producto_dos" )
 column=(type=decimal(2) updatewhereclause=yes name=tot_por_registro dbname="indmovim.tot_por_registro" dbalias=".tot_por_registro" )
 column=(type=long updatewhereclause=yes name=tipo_medida dbname="tipo_medida" )
 column=(type=decimal(2) updatewhereclause=yes name=monto_final dbname="monto_final" )
 column=(type=char(20) updatewhereclause=yes name=prod_original dbname="prod_original" )
 column=(type=decimal(2) updatewhereclause=yes name=costo_total dbname="costo_total" )
 column=(type=decimal(6) updatewhereclause=yes name=cantidad dbname="cantidad" )
 column=(type=decimal(6) updatewhereclause=yes name=cantidad_pz dbname="cantidad_pz" )
 column=(type=decimal(0) updatewhereclause=yes name=indmovim_dmov_linea dbname="indmovim.dmov_linea" dbalias=".dmov_linea" )
 column=(type=char(20) updatewhereclause=yes name=dmov_producto dbname="indmovim.dmov_producto" dbalias=".dmov_producto" )
 column=(type=decimal(6) updatewhereclause=yes name=dmov_bulto dbname="indmovim.dmov_bulto" dbalias=".dmov_bulto" )
 column=(type=char(255) updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" dbalias=".prod_descripcion" )
 column=(type=decimal(8) updatewhereclause=yes name=dmov_costo_fob dbname="indmovim.dmov_costo_fob" dbalias=".dmov_costo_fob" )
 column=(type=decimal(2) updatewhereclause=yes name=dmov_monto_final dbname="indmovim.dmov_monto_final" dbalias=".dmov_monto_final" )
 column=(type=datetime updatewhereclause=yes name=tmov_fecha dbname="intmovim.tmov_fecha" dbalias=".tmov_fecha" )
 column=(type=char(18) updatewhereclause=yes name=tmov_documento dbname="intmovim.tmov_documento" dbalias=".tmov_documento" )
 column=(type=char(15) updatewhereclause=yes name=tmov_documento_entrada dbname="intmovim.tmov_documento_entrada" dbalias=".tmov_documento_entrada" )
 column=(type=decimal(6) updatewhereclause=yes name=dmov_peso dbname="indmovim.dmov_peso" dbalias=".dmov_peso" )
 column=(type=decimal(4) updatewhereclause=yes name=dmov_cubicaje dbname="indmovim.dmov_cubicaje" dbalias=".dmov_cubicaje" )
 column=(type=decimal(0) updatewhereclause=yes name=tmov_secuencia dbname="intmovim.tmov_secuencia" dbalias=".tmov_secuencia" )
 column=(type=char(200) updatewhereclause=yes name=tmov_comentario dbname="intmovim.tmov_comentario" dbalias=".tmov_comentario" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"indmovim~" )  TABLE(NAME=~"intmovim~" ) COLUMN(NAME=~"inmprodu.prod_marca~") COMPUTE(NAME=~"'                                            ' car_descripcion~") COMPUTE(NAME=~"'               ' bultos~") COMPUTE(NAME=~"0 linea_subt~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COMPUTE(NAME=~"0 grupo~") COLUMN(NAME=~"inamedid.medi_abre~") COLUMN(NAME=~"inmprodu.prod_producto_dos~") COMPUTE(NAME=~"dmov_monto_final tot_por_registro~") COMPUTE(NAME=~"0 tipo_medida~") COMPUTE(NAME=~"0.00 monto_final~") COMPUTE(NAME=~"'                    ' prod_original~") COMPUTE(NAME=~"0.00 costo_total~") COMPUTE(NAME=~"case when medi_tipo_medida = 10 then 0 else dmov_cantidad end cantidad~") COMPUTE(NAME=~"case when medi_tipo_medida <> 10 then 0 else dmov_cantidad end cantidad_pz~") COLUMN(NAME=~"indmovim.dmov_linea~") COLUMN(NAME=~"indmovim.dmov_producto~") COLUMN(NAME=~"indmovim.dmov_bulto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"indmovim.dmov_costo_fob~") COLUMN(NAME=~"indmovim.dmov_monto_final~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"intmovim.tmov_documento~") COLUMN(NAME=~"intmovim.tmov_documento_entrada~") COLUMN(NAME=~"indmovim.dmov_peso~") COLUMN(NAME=~"indmovim.dmov_cubicaje~") COLUMN(NAME=~"intmovim.tmov_secuencia~") COLUMN(NAME=~"intmovim.tmov_comentario~")    JOIN (LEFT=~"intmovim.tmov_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"intmovim.tmov_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"intmovim.tmov_aplicacion~"    OP =~"=~"RIGHT=~"indmovim.dmov_aplicacion~" )    JOIN (LEFT=~"intmovim.tmov_tipo_transaccion~"    OP =~"=~"RIGHT=~"indmovim.dmov_tipo_transaccion~" )    JOIN (LEFT=~"intmovim.tmov_secuencia~"    OP =~"=~"RIGHT=~"indmovim.dmov_secuencia~" )    JOIN (LEFT=~"intmovim.tmov_anual~"    OP =~"=~"RIGHT=~"indmovim.dmov_anual~" )    JOIN (LEFT=~"intmovim.tmov_concepto~"    OP =~"=~"RIGHT=~"indmovim.dmov_concepto~" )    JOIN (LEFT=~"intmovim.tmov_terceros~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"indmovim.dmov_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"indmovim.dmov_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"indmovim.dmov_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"indmovim.dmov_unidad_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )WHERE(    EXP1 =~"((tmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_finan )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(tmov_secuencia~"   OP =~"=~"    EXP2 =~":secuencia )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(tmov_anual~"   OP =~"=~"    EXP2 =~":an )~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(tmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(tmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN'))~" ) ) ARG(NAME = ~"grupo_finan~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo_finan", number),("empresa", number),("secuencia", number),("an", number))  sort="indmovim_dmov_linea A " )
