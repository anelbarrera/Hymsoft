 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cptmovim~" ) COLUMN(NAME=~"cptmovim.movi_g_financiero~") COLUMN(NAME=~"cptmovim.movi_empresa~") COLUMN(NAME=~"cptmovim.movi_aplicacion~") COLUMN(NAME=~"cptmovim.movi_tipo_transaccion~") COLUMN(NAME=~"cptmovim.movi_sub_transaccion~") COLUMN(NAME=~"cptmovim.movi_documento~") COLUMN(NAME=~"cptmovim.movi_anno~") COLUMN(NAME=~"cptmovim.movi_referencia~") COLUMN(NAME=~"cptmovim.movi_ruc_tercero~") COLUMN(NAME=~"cptmovim.movi_monto~") COLUMN(NAME=~"cptmovim.movi_fecha_tran~") COLUMN(NAME=~"cptmovim.movi_naturaleza~") COLUMN(NAME=~"cptmovim.movi_a_nombre~") COLUMN(NAME=~"cptmovim.movi_monto_final~") COLUMN(NAME=~"cptmovim.movi_itbm~") COLUMN(NAME=~"cptmovim.movi_usuario~")WHERE(    EXP1 =~"( cptmovim.movi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_aplicacion~"   OP =~"=~"    EXP2 =~"'CP' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'FF' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_sub_transaccion~"   OP =~"=~"    EXP2 =~"'FF' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_documento~"   OP =~"=~"    EXP2 =~":documento )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_anno~"   OP =~"=~"    EXP2 =~":ann )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( cptmovim.movi_referencia~"   OP =~"=~"    EXP2 =~":referencia )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"documento~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"referencia~" TYPE = string) " update="cptmovim" updatewhere=1 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("documento", string),("ann", number),("referencia", string)) )
