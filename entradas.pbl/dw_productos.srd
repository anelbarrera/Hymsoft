 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"productos~" ) COLUMN(NAME=~"productos.prod_g_financiero~") COLUMN(NAME=~"productos.prod_empresa~") COLUMN(NAME=~"productos.prod_producto~") COLUMN(NAME=~"productos.prod_descripcion~") COLUMN(NAME=~"productos.prod_empaque~") COLUMN(NAME=~"productos.prod_unidad_empaque~") COLUMN(NAME=~"productos.prod_unidad~") COLUMN(NAME=~"productos.prod_peso~") COLUMN(NAME=~"productos.prod_cubicaje~") COLUMN(NAME=~"productos.prod_proveedor~") COLUMN(NAME=~"productos.prod_costo~") COLUMN(NAME=~"productos.prod_precio~") COLUMN(NAME=~"productos.prod_cantidad~") COLUMN(NAME=~"productos.prod_oc~") COLUMN(NAME=~"productos.prod_peso_bruto~") COLUMN(NAME=~"productos.prod_ancho~") COLUMN(NAME=~"productos.prod_alto~") COLUMN(NAME=~"productos.prod_largo~") COLUMN(NAME=~"productos.prod_tamano~") COLUMN(NAME=~"productos.prod_material~") COLUMN(NAME=~"productos.prod_barra~") COLUMN(NAME=~"productos.prod_foto_dir~")WHERE(    EXP1 =~"productos.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"productos.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " update="productos" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number)) )
