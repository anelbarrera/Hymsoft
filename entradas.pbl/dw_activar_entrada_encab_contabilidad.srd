 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cotdiari~" ) COLUMN(NAME=~"cotdiari.diar_tipo_transaccion~") COLUMN(NAME=~"cotdiari.diar_no_documento~") COLUMN(NAME=~"cotdiari.diar_ann~") COLUMN(NAME=~"cotdiari.diar_no_referencia~") COLUMN(NAME=~"cotdiari.diar_fecha_transaccion~") COLUMN(NAME=~"cotdiari.diar_descripcion~") COLUMN(NAME=~"cotdiari.diar_monto~") COLUMN(NAME=~"cotdiari.diar_g_financiero~") COLUMN(NAME=~"cotdiari.diar_empresa~") COLUMN(NAME=~"cotdiari.diar_aplicacion_mg~") COLUMN(NAME=~"cotdiari.diar_sub_trans~") COLUMN(NAME=~"cotdiari.diar_banco_cuenta~") COLUMN(NAME=~"cotdiari.diar_id~") COLUMN(NAME=~"cotdiari.diar_fecha_creacion~") COLUMN(NAME=~"cotdiari.diar_estado~") COLUMN(NAME=~"cotdiari.diar_balance~") COLUMN(NAME=~"cotdiari.diar_modificado~") COLUMN(NAME=~"cotdiari.diar_cerrado~") COLUMN(NAME=~"cotdiari.diar_cierre_mensual~") COLUMN(NAME=~"cotdiari.diar_banco~") COLUMN(NAME=~"cotdiari.diar_documento_a~") COLUMN(NAME=~"cotdiari.diar_nombre~") COLUMN(NAME=~"cotdiari.diar_impreso~")WHERE(    EXP1 =~"cotdiari.diar_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_aplicacion_mg~"   OP =~"in~"    EXP2 =~"('IN','CP')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_no_documento~"   OP =~"=~"    EXP2 =~":factura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_ann~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cotdiari.diar_no_referencia~"   OP =~"=~"    EXP2 =~":referencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cotdiari.diar_tipo_transaccion~"   OP =~"in~"    EXP2 =~"('FF','EN')~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"factura~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"referencia~" TYPE = string) " update="cotdiari" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("factura", string),("ann", number),("referencia", string)) )
