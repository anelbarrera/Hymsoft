//		filewrite(ll_archivo,'^MMT')			
//		filewrite(ll_archivo,'^PW719')
//		filewrite(ll_archivo,'^LL0200')
//		filewrite(ll_archivo,'^LS0')	
//		
//		ls_barra = as_item
//		
//		//Codigo de Barra
//		filewrite(ll_archivo,'^BY4,3,80^FT165,155^BCN,,N,N')
//		filewrite(ll_archivo,'^FD>:'+as_item+'^FS')		
//		//Codigo del Producto
//		filewrite(ll_archivo,'^FT286,183^A0N,31,33^FH\^FD'+as_item+'^FS')
//		//Descripcion
//		filewrite(ll_archivo,'^FT44,50^A0N,28,28^FH\^FD'+as_descripcion+'^FS')	
//		//Precio
//		filewrite(ll_archivo,'^FT591,119^A0N,31,31^FH\^FD$'+string(ad_precio)+'^FS')	
//		//Nombre de la empresa
//		filewrite(ll_archivo,'^FO15,154^GB135,31,31^FS')
//		filewrite(ll_archivo,'^FT15,178^A0N,25,28^FR^FH\^FDCOREMUSA^FS')
