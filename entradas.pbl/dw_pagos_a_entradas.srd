 column=(type=char(250) updatewhereclause=yes name=dgmsubse_subs_descripcion dbname="dgmsubse.subs_descripcion" )
 column=(type=char(20) updatewhereclause=yes name=cpdrefac_refa_documento dbname="cpdrefac.refa_documento" )
 column=(type=char(15) updatewhereclause=yes name=cpdrefac_refa_referencia dbname="cpdrefac.refa_referencia" )
 column=(type=decimal(2) updatewhereclause=yes name=cpdrefac_refa_monto_pagado dbname="cpdrefac.refa_monto_pagado" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cpdrefac~" )  TABLE(NAME=~"dgmsubse~" ) COLUMN(NAME=~"cpdrefac.refa_fecha_recibo~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"cpdrefac.refa_documento~") COLUMN(NAME=~"cpdrefac.refa_referencia~") COLUMN(NAME=~"cpdrefac.refa_monto_pagado~")    JOIN (LEFT=~"cpdrefac.refa_g_financiero~"    OP =~"=~"RIGHT=~"dgmsubse.subs_g_financiero~" )    JOIN (LEFT=~"cpdrefac.refa_empresa~"    OP =~"=~"RIGHT=~"dgmsubse.subs_empresa~" )    JOIN (LEFT=~"cpdrefac.refa_tipo_transaccion~"    OP =~"=~"RIGHT=~"dgmsubse.subs_transaccion~" )    JOIN (LEFT=~"cpdrefac.refa_sub_transaccion~"    OP =~"=~"RIGHT=~"dgmsubse.subs_sub_trans~" )WHERE(    EXP1 =~"cpdrefac.refa_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cpdrefac.refa_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cpdrefac.refa_tercero~"   OP =~"=~"    EXP2 =~":proveedor~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cpdrefac.refa_documento_ori~"   OP =~"=~"    EXP2 =~":oc~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cpdrefac.refa_ann_ori~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"proveedor~" TYPE = number)  ARG(NAME = ~"oc~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("proveedor", number),("oc", string),("ann", number)) )
