 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inagasto~" )  TABLE(NAME=~"indgasto~" ) COMPUTE(NAME=~"sum(gast_valor) valor~") COMPUTE(NAME=~"max(inag_cuenta) cuenta~")    JOIN (LEFT=~"indgasto.gast_g_financiero~"    OP =~"=~"RIGHT=~"inagasto.inag_g_financiero~" )    JOIN (LEFT=~"indgasto.gast_empresa~"    OP =~"=~"RIGHT=~"inagasto.inag_empresa~" )    JOIN (LEFT=~"indgasto.gast_codigo_gasto~"    OP =~"=~"RIGHT=~"inagasto.inag_cod~" )WHERE(    EXP1 =~"indgasto.gast_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indgasto.gast_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indgasto.gast_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indgasto.gast_transaccion~"   OP =~"=~"    EXP2 =~"'EN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indgasto.gast_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indgasto.gast_ann~"   OP =~"=~"    EXP2 =~":ann~" )  GROUP(NAME=~"indgasto.gast_secuencia~") GROUP(NAME=~"indgasto.gast_ann~") GROUP(NAME=~"indgasto.gast_codigo_gasto~")) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number)) )
