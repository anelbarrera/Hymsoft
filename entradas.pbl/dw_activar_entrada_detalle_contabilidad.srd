 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coddiari~" ) COLUMN(NAME=~"coddiari.ddia_tipo_transaccion~") COLUMN(NAME=~"coddiari.ddia_no_documento~") COLUMN(NAME=~"coddiari.ddia_no_referencia~") COLUMN(NAME=~"coddiari.ddia_banco_cuenta~") COLUMN(NAME=~"coddiari.ddia_ann~") COLUMN(NAME=~"coddiari.ddia_linea~") COLUMN(NAME=~"coddiari.ddia_mg_cuenta~") COLUMN(NAME=~"coddiari.ddia_monto~") COLUMN(NAME=~"coddiari.ddia_g_financiero~") COLUMN(NAME=~"coddiari.ddia_empresa~") COLUMN(NAME=~"coddiari.ddia_aplicacion_mg~") COLUMN(NAME=~"coddiari.ddia_sub_trans~") COLUMN(NAME=~"coddiari.ddia_naturaleza~") COLUMN(NAME=~"coddiari.ddia_id~") COLUMN(NAME=~"coddiari.ddia_fecha~") COLUMN(NAME=~"coddiari.ddia_tercero~") COLUMN(NAME=~"coddiari.ddia_centro_costo~") COLUMN(NAME=~"coddiari.ddia_documento_anexo~") COLUMN(NAME=~"coddiari.ddia_tipo~") COLUMN(NAME=~"coddiari.ddia_transito~") COLUMN(NAME=~"coddiari.ddia_cargado_a~") COLUMN(NAME=~"coddiari.ddia_class~") COLUMN(NAME=~"coddiari.ddia_comentario_detalle~") COLUMN(NAME=~"coddiari.ddia_codigo_cte_prov~") COMPUTE(NAME=~"case when ddia_naturaleza = 'D' then ddia_monto else 0 end debito~") COMPUTE(NAME=~"case when ddia_naturaleza = 'C' then ddia_monto else 0 end credito~")WHERE(    EXP1 =~"coddiari.ddia_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_aplicacion_mg~"   OP =~"in~"    EXP2 =~"('IN','CP')~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_no_documento~"   OP =~"=~"    EXP2 =~":factura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_ann~"   OP =~"=~"    EXP2 =~":ann~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"coddiari.ddia_no_referencia~"   OP =~"=~"    EXP2 =~":referencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_tipo_transaccion~"   OP =~"in~"    EXP2 =~"('EN','FF')~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"factura~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number)  ARG(NAME = ~"referencia~" TYPE = string) " update="coddiari" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("factura", string),("ann", number),("referencia", string))  sort="ddia_sub_trans A ddia_linea A " )
