 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cragrupo~" )  TABLE(NAME=~"cradivis~" ) COLUMN(NAME=~"cragrupo.agru_codigo_grupo~") COLUMN(NAME=~"cragrupo.agru_descripcion_grupo~") COLUMN(NAME=~"cragrupo.agru_codigo_div~") COLUMN(NAME=~"cragrupo.agru_arancel_default~") COLUMN(NAME=~"cradivis.adiv_nombre_div~")    JOIN (LEFT=~"cradivis.adiv_g_financiero~"    OP =~"=~"RIGHT=~"cragrupo.agru_g_financiero~" )    JOIN (LEFT=~"cradivis.adiv_empresa~"    OP =~"=~"RIGHT=~"cragrupo.agru_empresa~" )    JOIN (LEFT=~"cradivis.adiv_codigo_div~"    OP =~"=~"RIGHT=~"cragrupo.agru_codigo_div~" )WHERE(    EXP1 =~"cragrupo.agru_g_financiero~"   OP =~"=~"    EXP2 =~":grupo ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cragrupo.agru_empresa~"   OP =~"=~"    EXP2 =~":empresa ~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number) " arguments=(("grupo", number),("empresa", number))  sort="agru_descripcion_grupo A " )
