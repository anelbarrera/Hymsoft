 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"orden~" )  TABLE(NAME=~"orden_detalle~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"inamedid~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"orden.enca_secuencia~") COLUMN(NAME=~"orden.enca_ann~") COLUMN(NAME=~"orden.enca_proveedor~") COLUMN(NAME=~"orden.enca_fecha~") COLUMN(NAME=~"orden.enca_fecha_despacho~") COLUMN(NAME=~"orden.enca_fecha_llegada~") COLUMN(NAME=~"orden.enca_comentario~") COLUMN(NAME=~"orden.enca_usuario~") COLUMN(NAME=~"orden.enca_costo_total~") COLUMN(NAME=~"orden_detalle.deta_linea~") COLUMN(NAME=~"orden_detalle.deta_referencia~") COLUMN(NAME=~"orden_detalle.deta_unidad~") COLUMN(NAME=~"orden_detalle.deta_costo~") COLUMN(NAME=~"orden_detalle.deta_cantidad~") COLUMN(NAME=~"orden_detalle.deta_bultos~") COLUMN(NAME=~"orden_detalle.deta_comentario~") COLUMN(NAME=~"orden_detalle.deta_peso~") COLUMN(NAME=~"orden_detalle.deta_cubicaje~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"inamedid.medi_descripcion~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"orden.enca_comprador~")    JOIN (LEFT=~"orden_detalle.deta_g_financiero~"    OP =~"=~"RIGHT=~"orden.enca_g_financiero~" )    JOIN (LEFT=~"orden_detalle.deta_empresa~"    OP =~"=~"RIGHT=~"orden.enca_empresa~" )    JOIN (LEFT=~"orden_detalle.deta_secuencia~"    OP =~"=~"RIGHT=~"orden.enca_secuencia~" )    JOIN (LEFT=~"orden_detalle.deta_ann~"    OP =~"=~"RIGHT=~"orden.enca_ann~" )    JOIN (LEFT=~"orden.enca_proveedor~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid.medi_medida~" )    JOIN (LEFT=~"orden_detalle.deta_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"orden_detalle.deta_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"orden_detalle.deta_referencia~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"orden.enca_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"orden.enca_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"orden.enca_fecha~"   OP =~">=~"    EXP2 =~":desde~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"orden.enca_fecha~"   OP =~"<=~"    EXP2 =~":hasta~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"desde~" TYPE = date)  ARG(NAME = ~"hasta~" TYPE = date) " arguments=(("grupo", number),("empresa", number),("desde", date),("hasta", date))  sort="orden_enca_secuencia A " )
