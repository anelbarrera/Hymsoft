 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"indmovim~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_a~" )  TABLE(NAME=~"intmovim~" )  TABLE(NAME=~"inaparam~" )  TABLE(NAME=~"dgmsubse~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_b~" ) COLUMN(NAME=~"indmovim.dmov_g_financiero~") COLUMN(NAME=~"indmovim.dmov_empresa~") COLUMN(NAME=~"indmovim.dmov_aplicacion~") COLUMN(NAME=~"indmovim.dmov_tipo_transaccion~") COLUMN(NAME=~"indmovim.dmov_secuencia~") COLUMN(NAME=~"indmovim.dmov_documento~") COLUMN(NAME=~"indmovim.dmov_linea~") COLUMN(NAME=~"indmovim.dmov_bodega~") COLUMN(NAME=~"indmovim.dmov_ubicacion~") COLUMN(NAME=~"indmovim.dmov_producto~") COLUMN(NAME=~"indmovim.dmov_cantidad~") COLUMN(NAME=~"indmovim.dmov_cant1~") COLUMN(NAME=~"indmovim.dmov_unidad_medida~") COLUMN(NAME=~"indmovim.dmov_costo~") COLUMN(NAME=~"indmovim.dmov_precio~") COLUMN(NAME=~"indmovim.dmov_cubicaje~") COLUMN(NAME=~"indmovim.dmov_peso~") COLUMN(NAME=~"indmovim.dmov_bulto~") COLUMN(NAME=~"indmovim.dmov_costo_cif~") COLUMN(NAME=~"indmovim.dmov_cargos~") COLUMN(NAME=~"indmovim.dmov_precio_ent~") COLUMN(NAME=~"indmovim.dmov_id~") COLUMN(NAME=~"indmovim.dmov_bodega_destino~") COLUMN(NAME=~"indmovim.dmov_ubicacion_destino~") COLUMN(NAME=~"indmovim.dmov_anual~") COLUMN(NAME=~"indmovim.dmov_fabricante~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"intmovim.tmov_descripcion~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"intmovim.tmov_tipo_costo~") COLUMN(NAME=~"inamedid_a.medi_cantidad~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COLUMN(NAME=~"inaparam.para_in_foto_chica~") COLUMN(NAME=~"inaparam.para_in_foto_fondo~") COLUMN(NAME=~"dgmsubse.subs_descripcion~") COLUMN(NAME=~"inamedid_b.medi_cantidad~") COLUMN(NAME=~"inamedid_b.medi_descripcion~") COLUMN(NAME=~"inaparam.para_porc_precio1~") COLUMN(NAME=~"inaparam.para_incremento_fob1~") COLUMN(NAME=~"inaparam.para_incremento_fob2~") COMPUTE(NAME=~"cantidad = indmovim.dmov_cantidad + (indmovim.dmov_cant1/inamedid_b.medi_cantidad)~") COLUMN(NAME=~"inmprodu.prod_costo_fob~") COLUMN(NAME=~"inmprodu.prod_otros_gastos~") COLUMN(NAME=~"inmprodu.prod_costo_cif~") COLUMN(NAME=~"inmprodu.prod_costo_unitario~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_doc~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_can~") COLUMN(NAME=~"inmprodu.prod_entrada_fecha~") COLUMN(NAME=~"inmprodu.prod_g_financiero~") COLUMN(NAME=~"inmprodu.prod_empresa~") COLUMN(NAME=~"inmprodu.prod_producto~") COMPUTE(NAME=~"costo_promedio_calculado=0.0000~") COLUMN(NAME=~"intmovim.tmov_estado~") COLUMN(NAME=~"indmovim.dmov_concepto~") COLUMN(NAME=~"intmovim.tmov_estado_costo~") COLUMN(NAME=~"inaparam.para_porc_precio2~") COLUMN(NAME=~"inaparam.para_porc_precio3~") COLUMN(NAME=~"inaparam.para_porc_precio4~") COLUMN(NAME=~"inaparam.para_porc_precio5~") COLUMN(NAME=~"inaparam.para_porc_precio6~") COLUMN(NAME=~"indmovim.dmov_costo_fob~")    JOIN (LEFT=~"indmovim.dmov_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"intmovim.tmov_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"intmovim.tmov_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"intmovim.tmov_aplicacion~"    OP =~"=~"RIGHT=~"indmovim.dmov_aplicacion~" )    JOIN (LEFT=~"intmovim.tmov_tipo_transaccion~"    OP =~"=~"RIGHT=~"indmovim.dmov_tipo_transaccion~" )    JOIN (LEFT=~"inaparam.para_g_financiero~"    OP =~"=~"RIGHT=~"intmovim.tmov_g_financiero~" )    JOIN (LEFT=~"inaparam.para_empresa~"    OP =~"=~"RIGHT=~"intmovim.tmov_empresa~" )    JOIN (LEFT=~"dgmsubse.subs_g_financiero~"    OP =~"=~"RIGHT=~"intmovim.tmov_g_financiero~" )    JOIN (LEFT=~"dgmsubse.subs_empresa~"    OP =~"=~"RIGHT=~"intmovim.tmov_empresa~" )    JOIN (LEFT=~"dgmsubse.subs_transaccion~"    OP =~"=~"RIGHT=~"intmovim.tmov_tipo_transaccion~" )    JOIN (LEFT=~"dgmsubse.subs_sub_trans~"    OP =~"=~"RIGHT=~"intmovim.tmov_concepto~" )    JOIN (LEFT=~"intmovim.tmov_secuencia~"    OP =~"=~"RIGHT=~"indmovim.dmov_secuencia~" )    JOIN (LEFT=~"inamedid_a.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_empaque_um~" )    JOIN (LEFT=~"indmovim.dmov_unidad_medida~"    OP =~"=~"RIGHT=~"inamedid_b.medi_medida~" )    JOIN (LEFT=~"intmovim.tmov_concepto~"    OP =~"=~"RIGHT=~"indmovim.dmov_concepto~" )    JOIN (LEFT=~"intmovim.tmov_anual~"    OP =~"=~"RIGHT=~"indmovim.dmov_anual~" )    JOIN (LEFT=~"indmovim.dmov_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"indmovim.dmov_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )WHERE(    EXP1 =~"( ( indmovim.dmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( indmovim.dmov_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( indmovim.dmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~":transaccion )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( indmovim.dmov_anual~"   OP =~"=~"    EXP2 =~":anio ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"indmovim.dmov_secuencia~"   OP =~"=~"    EXP2 =~"2543~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"transaccion~" TYPE = string)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"anio~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("transaccion", string),("secuencia", number),("anio", number)) )
