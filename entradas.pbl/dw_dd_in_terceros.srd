 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_telefono1~") COLUMN(NAME=~"dgmterce.terc_email~") COLUMN(NAME=~"dgmterce.terc_identificacion~")WHERE(    EXP1 =~"dgmterce.terc_tipo~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~":tipo_tercero~"   OP =~"=~"    EXP2 =~"'C'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"dgmterce.terc_tipoa~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~":tipo_tercero~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"dgmterce.terc_tipop~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~":tipo_tercero~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ORDER(NAME=~"dgmterce.terc_descripcion~" ASC=yes ) ARG(NAME = ~"tipo_tercero~" TYPE = string) " update="dgmterce" updatewhere=1 updatekeyinplace=no arguments=(("tipo_tercero", string)) )
