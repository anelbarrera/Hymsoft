 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"indgasto~" ) COLUMN(NAME=~"indgasto.gast_g_financiero~") COLUMN(NAME=~"indgasto.gast_empresa~") COLUMN(NAME=~"indgasto.gast_aplicacion~") COLUMN(NAME=~"indgasto.gast_transaccion~") COLUMN(NAME=~"indgasto.gast_concepto~") COLUMN(NAME=~"indgasto.gast_secuencia~") COLUMN(NAME=~"indgasto.gast_linea~") COLUMN(NAME=~"indgasto.gast_ann~") COLUMN(NAME=~"indgasto.gast_descripcion~") COLUMN(NAME=~"indgasto.gast_valor~") COLUMN(NAME=~"indgasto.gast_anulado~") COLUMN(NAME=~"indgasto.gast_tipo~") COLUMN(NAME=~"indgasto.gast_cta_contable~") COLUMN(NAME=~"indgasto.gast_codigo_gasto~") COLUMN(NAME=~"indgasto.gast_costea~")WHERE(    EXP1 =~"indgasto.gast_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indgasto.gast_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indgasto.gast_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indgasto.gast_transaccion~"   OP =~"=~"    EXP2 =~"'EN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indgasto.gast_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indgasto.gast_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " update="indgasto" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number)) )
