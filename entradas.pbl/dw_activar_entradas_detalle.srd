 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"indmovim~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"indmovim.dmov_g_financiero~") COLUMN(NAME=~"indmovim.dmov_empresa~") COLUMN(NAME=~"indmovim.dmov_aplicacion~") COLUMN(NAME=~"indmovim.dmov_tipo_transaccion~") COLUMN(NAME=~"indmovim.dmov_concepto~") COLUMN(NAME=~"indmovim.dmov_secuencia~") COLUMN(NAME=~"indmovim.dmov_anual~") COLUMN(NAME=~"indmovim.dmov_linea~") COLUMN(NAME=~"indmovim.dmov_documento~") COLUMN(NAME=~"indmovim.dmov_bodega~") COLUMN(NAME=~"indmovim.dmov_producto~") COLUMN(NAME=~"inmprodu.prod_cod_alternativo~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"indmovim.dmov_cantidad~") COLUMN(NAME=~"indmovim.dmov_costo_promedio~") COLUMN(NAME=~"indmovim.dmov_monto_final~")    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"inmprodu.prod_producto~"    OP =~"=~"RIGHT=~"indmovim.dmov_producto~" )WHERE(    EXP1 =~"( ( indmovim.dmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( indmovim.dmov_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( indmovim.dmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( indmovim.dmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( indmovim.dmov_secuencia~"   OP =~"=~"    EXP2 =~":secuencia )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( indmovim.dmov_anual~"   OP =~"=~"    EXP2 =~":ann ) )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " update="indmovim" updatewhere=0 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number)) )
