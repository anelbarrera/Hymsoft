 column=(type=datetime update=yes updatewhereclause=yes name=crtconfi_tcof_fecha_llegada3 dbname="crtconfi.tcof_fecha_llegada3" dbalias=".tcof_fecha_llegada3" initial=" " )
 column=(type=datetime update=yes updatewhereclause=yes name=crtconfi_tcof_fecha_llegada4 dbname="crtconfi.tcof_fecha_llegada4" dbalias=".tcof_fecha_llegada4" initial=" " )
 column=(type=char(3) update=yes updatewhereclause=yes name=tcof_usuario dbname="crtconfi.tcof_usuario" dbalias=".tcof_usuario" )
 retrieve=" SELECT dgmterce.terc_descripcion,   
         dgmterce.terc_telefono1,   
         dgmterce.terc_telefono2,   
         dgmterce.terc_fax1,   
         dgmterce.terc_email,   
         dgmterce.terc_pais,   
         dgmterce.terc_direccion,   
         crtconfi.tcof_g_financiero,   
         crtconfi.tcof_empresa,   
         crtconfi.tcof_anno_oc,   
         crtconfi.tcof_num_prove,   
         crtconfi.tcof_cod_tipo_pago,   
         crtconfi.tcof_cod_forma_pago,   
         crtconfi.tcof_fecha_conf_oc,   
         crtconfi.tcof_fecha_llegada,   
         crtconfi.tcof_representante_prov,   
         crtconfi.tcof_estatus_conf_oc,   
         crtconfi.tcof_comentario_add,   
         crtconfi.tcof_tipo_costo,   
         crtconfi.tcof_num_carta_credito,   
         crtconfi.tcof_banco,   
         crtconfi.tcof_lista_empaque,   
         crtconfi.tcof_fecha_llegada_puerto,   
         crtconfi.tcof_numero_vapor,   
         crtconfi.tcof_puerto,   
         crtconfi.tcof_no_bultos,   
         crtconfi.tcof_clase_compra,   
         crtconfi.tcof_codigo_viaje,   
         crtconfi.tcof_tipo_conf,   
         crtconfi.tcof_monto_total_orden,   
         crtconfi.tcof_tipo_compra,   
         crtconfi.tcof_marca,   
         crtconfi.tcof_destino,   
         crtconfi.tcof_actualizo_cargos,   
         crtconfi.tcof_estado,   
         crtconfi.tcof_temporada,   
         crtconfi.tcof_moneda,   
         crtconfi.tcof_cambio,   
         crtconfi.tcof_num_conf_oc,   
         crtconfi.tcof_fecha_llegada2,   
         crtconfi.tcof_fecha_llegada3,   
         crtconfi.tcof_fecha_llegada4,
			crtconfi.tcof_usuario
			
    FROM dgmterce,   
         crtconfi  
   WHERE ( crtconfi.tcof_num_prove = dgmterce.terc_tercero ) and  
         ( ( crtconfi.tcof_g_financiero = :grupo ) AND  
         ( crtconfi.tcof_empresa = :empresa ) AND  
         ( crtconfi.tcof_num_conf_oc = :secuencia )  AND  
         (crtconfi.tcof_anno_oc = :ann))    

  " update="crtconfi" updatewhere=1 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("secuencia", string),("ann", number)) )
