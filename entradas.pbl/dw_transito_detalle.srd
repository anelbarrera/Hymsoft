 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"transito_detalle~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"transito_detalle.deta_g_financiero~") COLUMN(NAME=~"transito_detalle.deta_empresa~") COLUMN(NAME=~"transito_detalle.deta_secuencia~") COLUMN(NAME=~"transito_detalle.deta_ann~") COLUMN(NAME=~"transito_detalle.deta_linea~") COLUMN(NAME=~"transito_detalle.deta_referencia~") COLUMN(NAME=~"transito_detalle.deta_unidad~") COLUMN(NAME=~"transito_detalle.deta_costo~") COLUMN(NAME=~"transito_detalle.deta_cantidad~") COLUMN(NAME=~"transito_detalle.deta_bultos~") COLUMN(NAME=~"transito_detalle.deta_comentario~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"transito_detalle.deta_peso~") COLUMN(NAME=~"transito_detalle.deta_cubicaje~")    JOIN (LEFT=~"transito_detalle.deta_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"transito_detalle.deta_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"transito_detalle.deta_referencia~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"transito_detalle.deta_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"transito_detalle.deta_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"transito_detalle.deta_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"transito_detalle.deta_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="transito_detalle" updatewhere=0 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("secuencia", string),("ann", number))  sort="deta_linea A " )
