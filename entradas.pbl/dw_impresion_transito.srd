table(column=(type=char(15) updatewhereclause=yes name=transito_enca_secuencia dbname="transito.enca_secuencia" )
 column=(type=decimal(0) updatewhereclause=yes name=transito_enca_ann dbname="transito.enca_ann" )
 column=(type=decimal(0) updatewhereclause=yes name=transito_enca_proveedor dbname="transito.enca_proveedor" )
 column=(type=datetime updatewhereclause=yes name=transito_enca_fecha dbname="transito.enca_fecha" )
 column=(type=datetime updatewhereclause=yes name=transito_enca_fecha_despacho dbname="transito.enca_fecha_despacho" )
 column=(type=datetime updatewhereclause=yes name=transito_enca_fecha_llegada dbname="transito.enca_fecha_llegada" )
 column=(type=char(255) updatewhereclause=yes name=transito_enca_comentario dbname="transito.enca_comentario" )
 column=(type=char(3) updatewhereclause=yes name=transito_enca_usuario dbname="transito.enca_usuario" )
 column=(type=decimal(4) updatewhereclause=yes name=transito_enca_costo_total dbname="transito.enca_costo_total" )
 column=(type=decimal(0) updatewhereclause=yes name=transito_detalle_deta_linea dbname="transito_detalle.deta_linea" )
 column=(type=char(20) updatewhereclause=yes name=transito_detalle_deta_referencia dbname="transito_detalle.deta_referencia" )
 column=(type=char(2) updatewhereclause=yes name=transito_detalle_deta_unidad dbname="transito_detalle.deta_unidad" )
 column=(type=decimal(4) updatewhereclause=yes name=transito_detalle_deta_costo dbname="transito_detalle.deta_costo" )
 column=(type=decimal(0) updatewhereclause=yes name=transito_detalle_deta_cantidad dbname="transito_detalle.deta_cantidad" )
 column=(type=decimal(0) updatewhereclause=yes name=transito_detalle_deta_bultos dbname="transito_detalle.deta_bultos" )
 column=(type=char(255) updatewhereclause=yes name=transito_detalle_deta_comentario dbname="transito_detalle.deta_comentario" )
 column=(type=char(20) updatewhereclause=yes name=unidades_medi_descripcion dbname="unidades.medi_descripcion" )
 column=(type=decimal(4) updatewhereclause=yes name=transito_detalle_deta_peso dbname="transito_detalle.deta_peso" )
 column=(type=decimal(4) updatewhereclause=yes name=transito_detalle_deta_cubicaje dbname="transito_detalle.deta_cubicaje" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" )
 column=(type=char(150) updatewhereclause=yes name=dgmterce_terc_direccion dbname="dgmterce.terc_direccion" )
 column=(type=char(65) updatewhereclause=yes name=productos_prod_descripcion dbname="prod_descripcion" )
 column=(type=char(20) updatewhereclause=yes name=transito_enca_documento dbname="transito.enca_documento" )
 column=(type=char(60) updatewhereclause=yes name=cliente dbname="cliente" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"transito~" )  TABLE(NAME=~"transito_detalle~" )  TABLE(NAME=~"unidades~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"transito.enca_secuencia~") COLUMN(NAME=~"transito.enca_ann~") COLUMN(NAME=~"transito.enca_proveedor~") COLUMN(NAME=~"transito.enca_fecha~") COLUMN(NAME=~"transito.enca_fecha_despacho~") COLUMN(NAME=~"transito.enca_fecha_llegada~") COLUMN(NAME=~"transito.enca_comentario~") COLUMN(NAME=~"transito.enca_usuario~") COLUMN(NAME=~"transito.enca_costo_total~") COLUMN(NAME=~"transito_detalle.deta_linea~") COLUMN(NAME=~"transito_detalle.deta_referencia~") COLUMN(NAME=~"transito_detalle.deta_unidad~") COLUMN(NAME=~"transito_detalle.deta_costo~") COLUMN(NAME=~"transito_detalle.deta_cantidad~") COLUMN(NAME=~"transito_detalle.deta_bultos~") COLUMN(NAME=~"transito_detalle.deta_comentario~") COLUMN(NAME=~"unidades.medi_descripcion~") COLUMN(NAME=~"transito_detalle.deta_peso~") COLUMN(NAME=~"transito_detalle.deta_cubicaje~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_direccion~") COMPUTE(NAME=~"prod_descripcion = inmprodu.prod_descripcion~") COLUMN(NAME=~"transito.enca_documento~") COMPUTE(NAME=~"cliente = (select max(terc_descripcion) from dgmterce where terc_tercero = transito.enca_cliente and transito.enca_cliente <> 0)~")    JOIN (LEFT=~"transito_detalle.deta_g_financiero~"    OP =~"=~"RIGHT=~"transito.enca_g_financiero~" )    JOIN (LEFT=~"transito_detalle.deta_empresa~"    OP =~"=~"RIGHT=~"transito.enca_empresa~" )    JOIN (LEFT=~"transito_detalle.deta_secuencia~"    OP =~"=~"RIGHT=~"transito.enca_secuencia~" )    JOIN (LEFT=~"transito_detalle.deta_ann~"    OP =~"=~"RIGHT=~"transito.enca_ann~" )    JOIN (LEFT=~"transito.enca_proveedor~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"unidades.medi_unidad~" )    JOIN (LEFT=~"transito_detalle.deta_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"transito_detalle.deta_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"transito_detalle.deta_referencia~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"transito.enca_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"transito.enca_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"transito.enca_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"transito.enca_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("secuencia", string),("ann", number)) )
