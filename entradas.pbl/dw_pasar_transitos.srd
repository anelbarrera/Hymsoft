 column=(type=long updatewhereclause=yes name=pasada dbname="pasada" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"transito~" )  TABLE(NAME=~"dgmterce~" ) COMPUTE(NAME=~"pasar = 0~") COLUMN(NAME=~"transito.enca_g_financiero~") COLUMN(NAME=~"transito.enca_empresa~") COLUMN(NAME=~"transito.enca_secuencia~") COLUMN(NAME=~"transito.enca_ann~") COLUMN(NAME=~"transito.enca_fecha~") COLUMN(NAME=~"transito.enca_comentario~") COLUMN(NAME=~"transito.enca_documento~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"transito.enca_costo_total~") COMPUTE(NAME=~"pasada = 0~")    JOIN (LEFT=~"transito.enca_proveedor~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"transito.enca_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"transito.enca_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"transito.enca_proveedor~"   OP =~"=~"    EXP2 =~":proveedor~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"transito.enca_estado~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"proveedor~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("proveedor", number))  sort="enca_fecha A " )
