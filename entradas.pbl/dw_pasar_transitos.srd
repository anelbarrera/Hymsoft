table(column=(type=long updatewhereclause=yes name=pasar dbname="pasar" initial="0" values="	1/	0" )
 column=(type=decimal(0) updatewhereclause=yes name=enca_g_financiero dbname="transito.enca_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=enca_empresa dbname="transito.enca_empresa" )
 column=(type=char(15) updatewhereclause=yes name=enca_secuencia dbname="transito.enca_secuencia" )
 column=(type=decimal(0) updatewhereclause=yes name=enca_ann dbname="transito.enca_ann" )
