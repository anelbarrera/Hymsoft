table(column=(type=char(8) updatewhereclause=yes name=fatdiari_fact_no_pedido dbname="fatdiari.fact_no_pedido" dbalias=".fact_no_pedido" )
 column=(type=char(100) updatewhereclause=yes name=nombre dbname="nombre" )
 column=(type=datetime updatewhereclause=yes name=fecha dbname="fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=monto dbname="monto" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"indmovim~" )  TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fatdiari.fact_no_pedido~") COMPUTE(NAME=~"nombre = max(fact_a_nombre)~") COMPUTE(NAME=~"fecha = max(fact_fecha)~") COMPUTE(NAME=~"monto = max(fact_monto_final)~")    JOIN (LEFT=~"indmovim.dmov_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"indmovim.dmov_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"indmovim.dmov_producto~"    OP =~"=~"RIGHT=~"faddiari.facd_codigo_item~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"faddiari.facd_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"faddiari.facd_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"faddiari.facd_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"faddiari.facd_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"faddiari.facd_ann~" )WHERE(    EXP1 =~"indmovim.dmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_secuencia~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_anual~"   OP =~"=~"    EXP2 =~":ann~" )  GROUP(NAME=~"fatdiari.fact_no_pedido~")) ORDER(NAME=~"fatdiari.fact_no_pedido~" ASC=yes ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number)) )
