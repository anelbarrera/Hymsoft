 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"intmovim~" )  TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"intmovim.tmov_g_financiero~") COLUMN(NAME=~"intmovim.tmov_empresa~") COLUMN(NAME=~"intmovim.tmov_aplicacion~") COLUMN(NAME=~"intmovim.tmov_tipo_transaccion~") COLUMN(NAME=~"intmovim.tmov_concepto~") COLUMN(NAME=~"intmovim.tmov_secuencia~") COLUMN(NAME=~"intmovim.tmov_anual~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"intmovim.tmov_documento~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"intmovim.tmov_comentario~") COLUMN(NAME=~"intmovim.tmov_id~") COLUMN(NAME=~"intmovim.tmov_estado~")    JOIN (LEFT=~"intmovim.tmov_terceros~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"( ( intmovim.tmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( intmovim.tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( intmovim.tmov_aplicacion~"   OP =~"=~"    EXP2 =~"'IN' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( intmovim.tmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN' )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( intmovim.tmov_secuencia~"   OP =~"=~"    EXP2 =~":secuencia )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( intmovim.tmov_anual~"   OP =~"=~"    EXP2 =~":ann ) )~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = number)  ARG(NAME = ~"ann~" TYPE = number) " update="intmovim" updatewhere=0 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("secuencia", number),("ann", number)) )
