ro~") COLUMN(NAME=~"indmovim.dmov_descuento~") COLUMN(NAME=~"indmovim.dmov_itbm~") COLUMN(NAME=~"indmovim.dmov_precio_descuento~") COLUMN(NAME=~"indmovim.dmov_descuento_ncr~") COLUMN(NAME=~"indmovim.dmov_monto_final~") COLUMN(NAME=~"indmovim.dmov_costo_promedio~")    JOIN (LEFT=~"intmovim.tmov_g_financiero~"    OP =~"=~"RIGHT=~"indmovim.dmov_g_financiero~" )    JOIN (LEFT=~"intmovim.tmov_empresa~"    OP =~"=~"RIGHT=~"indmovim.dmov_empresa~" )    JOIN (LEFT=~"intmovim.tmov_aplicacion~"    OP =~"=~"RIGHT=~"indmovim.dmov_aplicacion~" )    JOIN (LEFT=~"intmovim.tmov_tipo_transaccion~"    OP =~"=~"RIGHT=~"indmovim.dmov_tipo_transaccion~" )    JOIN (LEFT=~"intmovim.tmov_secuencia~"    OP =~"=~"RIGHT=~"indmovim.dmov_secuencia~" )    JOIN (LEFT=~"intmovim.tmov_anual~"    OP =~"=~"RIGHT=~"indmovim.dmov_anual~" )    JOIN (LEFT=~"intmovim.tmov_concepto~"    OP =~"=~"RIGHT=~"indmovim.dmov_concepto~" )WHERE(    EXP1 =~"indmovim.dmov_empresa~"   OP =~"=~"    EXP2 =~"2~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_fecha~"   OP =~">=~"    EXP2 =~"'01/20/2011'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_secuencia~"   OP =~">~"    EXP2 =~"19938~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"indmovim.dmov_producto~"   OP =~"in~"    EXP2 =~"('PLATERIA','ART.PLATA')~" ) ) " update="indmovim" updatewhere=0 updatekeyinplace=no )
