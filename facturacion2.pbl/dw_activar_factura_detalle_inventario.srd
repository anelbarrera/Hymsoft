 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"indmovim~" ) COLUMN(NAME=~"indmovim.dmov_tipo_transaccion~") COLUMN(NAME=~"indmovim.dmov_secuencia~") COLUMN(NAME=~"indmovim.dmov_anual~") COLUMN(NAME=~"indmovim.dmov_documento~") COLUMN(NAME=~"indmovim.dmov_producto~") COLUMN(NAME=~"indmovim.dmov_cantidad~") COLUMN(NAME=~"indmovim.dmov_cant1~") COLUMN(NAME=~"indmovim.dmov_unidad_medida~") COLUMN(NAME=~"indmovim.dmov_modelo~") COLUMN(NAME=~"indmovim.dmov_g_financiero~") COLUMN(NAME=~"indmovim.dmov_empresa~") COLUMN(NAME=~"indmovim.dmov_aplicacion~") COLUMN(NAME=~"indmovim.dmov_concepto~") COLUMN(NAME=~"indmovim.dmov_linea~") COLUMN(NAME=~"indmovim.dmov_linea_referencia~") COLUMN(NAME=~"indmovim.dmov_ubicacion~") COLUMN(NAME=~"indmovim.dmov_bodega~") COLUMN(NAME=~"indmovim.dmov_precio~") COMPUTE(NAME=~"dmov_monto_final = dmov_precio * dmov_cantidad~") COLUMN(NAME=~"indmovim.dmov_costo~") COLUMN(NAME=~"indmovim.dmov_cubicaje~") COLUMN(NAME=~"indmovim.dmov_peso~") COLUMN(NAME=~"indmovim.dmov_bulto~") COLUMN(NAME=~"indmovim.dmov_costo_cif~") COLUMN(NAME=~"indmovim.dmov_cargos~") COLUMN(NAME=~"indmovim.dmov_precio_ent~") COLUMN(NAME=~"indmovim.dmov_id~") COLUMN(NAME=~"indmovim.dmov_bodega_destino~") COLUMN(NAME=~"indmovim.dmov_ubicacion_destino~") COLUMN(NAME=~"indmovim.dmov_fabricante~") COLUMN(NAME=~"indmovim.dmov_anulado~") COLUMN(NAME=~"indmovim.dmov_id_precio~") COLUMN(NAME=~"indmovim.dmov_fecha_agotado~") COLUMN(NAME=~"indmovim.dmov_existe_detalle~") COLUMN(NAME=~"indmovim.dmov_num_orden~") COLUMN(NAME=~"indmovim.dmov_comentarios~") COLUMN(NAME=~"indmovim.dmov_clave~") COLUMN(NAME=~"indmovim.dmov_costo_fob~") COLUMN(NAME=~"indmovim.dmov_precio1~") COLUMN(NAME=~"indmovim.dmov_precio2~") COLUMN(NAME=~"indmovim.dmov_precio3~") COLUMN(NAME=~"indmovim.dmov_secuencia_ea~") COLUMN(NAME=~"indmovim.dmov_terceros_ea~") COLUMN(NAME=~"indmovim.dmov_numpo_ea~") COLUMN(NAME=~"indmovim.dmov_board~") COLUMN(NAME=~"indmovim.dmov_color~") COLUMN(NAME=~"indmovim.dmov_porcentaje_gasto~") COLUMN(NAME=~"indmovim.dmov_lote~") COLUMN(NAME=~"indmovim.dmov_fecha_registro~") COLUMN(NAME=~"indmovim.dmov_descuento~") COLUMN(NAME=~"indmovim.dmov_itbm~") COLUMN(NAME=~"indmovim.dmov_precio_descuento~") COLUMN(NAME=~"indmovim.dmov_descuento_ncr~") COLUMN(NAME=~"indmovim.dmov_costo_promedio~")WHERE(    EXP1 =~"indmovim.dmov_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_aplicacion~"   OP =~"=~"    EXP2 =~"'FA'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_documento~"   OP =~"=~"    EXP2 =~":factura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"indmovim.dmov_anual~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"factura~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="indmovim" updatewhere=0 updatekeyinplace=yes arguments=(("grupo", number),("empresa", number),("factura", string),("ann", number))  sort="dmov_linea A " )
