 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"vi_pediapasar~" )  TABLE(NAME=~"fatpedid~" ) COLUMN(NAME=~"fatpedid.pedi_g_financiero~") COLUMN(NAME=~"fatpedid.pedi_empresa~") COLUMN(NAME=~"fatpedid.pedi_tipo~") COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_ann~") COLUMN(NAME=~"fatpedid.pedi_cliente~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~") COLUMN(NAME=~"fatpedid.pedi_condicion_pago~") COLUMN(NAME=~"fatpedid.pedi_tipo_venta~") COLUMN(NAME=~"fatpedid.pedi_tipo_movimiento~") COLUMN(NAME=~"fatpedid.pedi_no_traspaso~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_fecha_creacion~") COLUMN(NAME=~"fatpedid.pedi_fecha_modificacion~") COLUMN(NAME=~"fatpedid.pedi_dias_pago~") COLUMN(NAME=~"fatpedid.pedi_consignado~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fatpedid.pedi_a_nombre_direccion~") COLUMN(NAME=~"fatpedid.pedi_despachado~") COLUMN(NAME=~"fatpedid.pedi_via~") COLUMN(NAME=~"fatpedid.pedi_con_emb_no~") COLUMN(NAME=~"fatpedid.pedi_marca~") COLUMN(NAME=~"fatpedid.pedi_bultos_total~") COLUMN(NAME=~"fatpedid.pedi_cubicaje_total~") COLUMN(NAME=~"fatpedid.pedi_peso_total~") COLUMN(NAME=~"fatpedid.pedi_unidad_peso~") COLUMN(NAME=~"fatpedid.pedi_gastos_total~") COLUMN(NAME=~"fatpedid.pedi_monto_total~") COLUMN(NAME=~"fatpedid.pedi_descu_subt_deta~") COLUMN(NAME=~"fatpedid.pedi_por_descuento~") COLUMN(NAME=~"fatpedid.pedi_supervisor~") COLUMN(NAME=~"fatpedid.pedi_monto_final~") COLUMN(NAME=~"fatpedid.pedi_comentario~") COLUMN(NAME=~"fatpedid.pedi_estado~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatpedid.pedi_autorizacion~") COLUMN(NAME=~"fatpedid.pedi_restaurado_por~") COLUMN(NAME=~"fatpedid.pedi_factura_de_bodega~") COLUMN(NAME=~"fatpedid.pedi_cuatro_decimales~") COLUMN(NAME=~"fatpedid.pedi_usuario~") COLUMN(NAME=~"fatpedid.pedi_precio_a_utilizar~") COLUMN(NAME=~"fatpedid.pedi_costos_total~")    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"vi_pediapasar.pedi_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"vi_pediapasar.pedi_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_no_pedido~"    OP =~"=~"RIGHT=~"vi_pediapasar.pedi_no_pedido~" )    JOIN (LEFT=~"fatpedid.pedi_ann~"    OP =~"=~"RIGHT=~"vi_pediapasar.pedi_ann~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"fatpedid.pedi_cliente~" )WHERE(    EXP1 =~"( ( fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatpedid.pedi_cliente~"   OP =~"=~"    EXP2 =~":cliente ) ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_estado~"   OP =~"<>~"    EXP2 =~"'P'))~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"cliente~" TYPE = number) " retrieve.asneeded=yes arguments=(("g_financiero", number),("empresa", number),("cliente", number))  sort="fatpedid_pedi_no_pedido A fatpedid_pedi_ann A " )
