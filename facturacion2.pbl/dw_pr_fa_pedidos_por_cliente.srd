 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"fatpedid~" ) COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmempre.empr_ficha~") COLUMN(NAME=~"dgmempre.empr_rollo~") COLUMN(NAME=~"dgmempre.empr_imagen~") COLUMN(NAME=~"dgmempre.empr_direccion~") COLUMN(NAME=~"dgmempre.empr_apartado_postal~") COLUMN(NAME=~"dgmempre.empr_telefono1~") COLUMN(NAME=~"dgmempre.empr_telefono2~") COLUMN(NAME=~"dgmempre.empr_fax1~") COLUMN(NAME=~"dgmempre.empr_fax2~") COLUMN(NAME=~"dgmempre.empr_dijito_verificador~") COLUMN(NAME=~"dgmempre.empr_e_mail~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COMPUTE(NAME=~"'                                                             ' cond_de_pago~") COLUMN(NAME=~"fatpedid.pedi_tipo~") COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_ann~") COLUMN(NAME=~"fatpedid.pedi_cliente~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~") COLUMN(NAME=~"fatpedid.pedi_condicion_pago~") COLUMN(NAME=~"fatpedid.pedi_tipo_venta~") COLUMN(NAME=~"fatpedid.pedi_tipo_movimiento~") COLUMN(NAME=~"fatpedid.pedi_no_traspaso~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_dias_pago~") COLUMN(NAME=~"fatpedid.pedi_consignado~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fatpedid.pedi_a_nombre_direccion~") COLUMN(NAME=~"fatpedid.pedi_despachado~") COLUMN(NAME=~"fatpedid.pedi_via~") COLUMN(NAME=~"fatpedid.pedi_con_emb_no~") COLUMN(NAME=~"fatpedid.pedi_marca~") COLUMN(NAME=~"fatpedid.pedi_bultos_total~") COLUMN(NAME=~"fatpedid.pedi_peso_total~") COLUMN(NAME=~"fatpedid.pedi_unidad_peso~") COLUMN(NAME=~"fatpedid.pedi_gastos_total~") COLUMN(NAME=~"fatpedid.pedi_monto_total~") COLUMN(NAME=~"fatpedid.pedi_monto_final~") COLUMN(NAME=~"fatpedid.pedi_comentario~") COLUMN(NAME=~"fatpedid.pedi_estado~") COMPUTE(NAME=~"' ' fact_incluir~")    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"((fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero_fa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa_fa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_cliente~"   OP =~"=~"    EXP2 =~":cliente_fa))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_pasado_a_empresa~"   OP =~"=~"    EXP2 =~"null~"    LOGIC =~"or~" ) WHERE(    EXP1 =~"fatpedid.pedi_pasado_a_empresa~"   OP =~"=~"    EXP2 =~"0)~" ) ) ARG(NAME = ~"g_financiero_fa~" TYPE = number)  ARG(NAME = ~"empresa_fa~" TYPE = number)  ARG(NAME = ~"cliente_fa~" TYPE = number) " retrieve.asneeded=yes arguments=(("g_financiero_fa", number),("empresa_fa", number),("cliente_fa", number)) )
