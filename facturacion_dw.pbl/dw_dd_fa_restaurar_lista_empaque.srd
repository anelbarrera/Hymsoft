 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatempaq~" ) COLUMN(NAME=~"fatempaq.enca_lista_empaque~") COLUMN(NAME=~"fatempaq.enca_ann~") COLUMN(NAME=~"fatempaq.enca_tipo~") COLUMN(NAME=~"fatempaq.enca_no_pedido~") COLUMN(NAME=~"fatempaq.enca_fecha_inicio~") COLUMN(NAME=~"fatempaq.enca_ann_pedido~") COLUMN(NAME=~"fatempaq.enca_fuente~")WHERE(    EXP1 =~"fatempaq.enca_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatempaq.enca_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatempaq.enca_pasado~"   OP =~"=~"    EXP2 =~"'S'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatempaq.enca_fecha_inicio~"   OP =~">=~"    EXP2 =~":desde~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatempaq.enca_fecha_inicio~"   OP =~"<~"    EXP2 =~":hasta~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"desde~" TYPE = date)  ARG(NAME = ~"hasta~" TYPE = date) " arguments=(("grupo", number),("empresa", number),("desde", date),("hasta", date)) )
