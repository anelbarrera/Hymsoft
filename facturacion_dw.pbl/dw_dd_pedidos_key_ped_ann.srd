 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"fatpedid~" ) COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatpedid.pedi_tipo~") COLUMN(NAME=~"fatpedid.pedi_ann~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_estado~")    JOIN (LEFT=~"fatpedid.pedi_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_ped_key~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa_ped_key~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_ann~"   OP =~"=~"    EXP2 =~":empresa_ann~" ) ) ARG(NAME = ~"grupo_ped_key~" TYPE = number)  ARG(NAME = ~"empresa_ped_key~" TYPE = number)  ARG(NAME = ~"empresa_ann~" TYPE = number) " retrieve.asneeded=yes arguments=(("grupo_ped_key", number),("empresa_ped_key", number),("empresa_ann", number))  sort="pedi_no_pedido A " )
