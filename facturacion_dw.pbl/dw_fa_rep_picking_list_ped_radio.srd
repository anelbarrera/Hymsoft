otal/inamedid.medi_cantidad)) entero~") COMPUTE(NAME=~"inmprodu.prod_existencia_total - (convert(numeric(15,0),(inmprodu.prod_existencia_total / inamedid.medi_cantidad)) * inamedid.medi_cantidad) fraccion~") COMPUTE(NAME=~"convert(numeric(15,0),((inmprodu.prod_existencia_total -  inmprodu.prod_reserva_total )/inamedid.medi_cantidad)) dis_entero~") COMPUTE(NAME=~"(inmprodu.prod_existencia_total - inmprodu.prod_reserva_total ) - (convert(numeric(15,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) / inamedid.medi_cantidad)) * inamedid.medi_cantidad) dis_fraccion~") COMPUTE(NAME=~"0 disponible_fraccion~") COMPUTE(NAME=~"~~~"~~~" cambio, ~~~"~~~" parcial~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COMPUTE(NAME=~"0 disponible~") COMPUTE(NAME=~"0 disponible_real~") COMPUTE(NAME=~"0 disponible_fraccion_real~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_doc~") COLUMN(NAME=~"inmprodu.prod_barra~") COLUMN(NAME=~"cracltam.acta_descripcion~") COLUMN(NAME=~"inmprodu.prod_observacion~") COLUMN(NAME=~"cramarca.amar_nombre_marca~") COLUMN(NAME=~"inmprodu.prod_arancel~") COLUMN(NAME=~"cratipos.atip_descripcion_tipo~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"cramaterial.mat_compo~")    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"fadpedid.dped_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"fadpedid.dped_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_no_pedido~"    OP =~"=~"RIGHT=~"fadpedid.dped_no_pedido~" )    JOIN (LEFT=~"fatpedid.pedi_ann~"    OP =~"=~"RIGHT=~"fadpedid.dped_ann~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"fadpedid.dped_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"fadpedid.dped_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"fadpedid.dped_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_dias_pago~"    OP =~"=~"RIGHT=~"dgaperio.peri_periodo~" )    JOIN (LEFT=~"cracltam.acta_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cracltam.acta_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cracltam.acta_cod_clase_tam~"    OP =~"=~"RIGHT=~"inmprodu.prod_cod_clase_tam~" )    JOIN (LEFT=~"cramarca.amar_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cramarca.amar_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cramarca.amar_num_marca~"    OP =~"=~"RIGHT=~"inmprodu.prod_marca~" )    JOIN (LEFT=~"cratipos.atip_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cratipos.atip_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cratipos.atip_num_tipo~"    OP =~"=~"RIGHT=~"inmprodu.prod_num_tipo~" )    JOIN (LEFT=~"dgapais.pais_pais~"    OP =~"=~"RIGHT=~"inmprodu.prod_pais~" )    JOIN (LEFT=~"inmprodu.prod_g_financiero~"    OP =~"=~"RIGHT=~"cramaterial.mat_g_financiero~" )    JOIN (LEFT=~"inmprodu.prod_empresa~"    OP =~"=~"RIGHT=~"cramaterial.mat_empresa~" )    JOIN (LEFT=~"inmprodu.prod_material~"    OP =~"=~"RIGHT=~"cramaterial.mat_cod_material~" )WHERE(    EXP1 =~"((fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatpedid.pedi_ann~"   OP =~"=~"    EXP2 =~":an )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( dgaperio.peri_aplicacion~"   OP =~"=~"    EXP2 =~"'FA' ) ~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"(fadpedid.dped_pasada~"   OP =~"<~"    EXP2 =~"fadpedid.dped_cantidad * inamedid.medi_cantidad + fadpedid.dped_fraccion ))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fadpedid.dped_reserva_origen~"   OP =~"=~"    EXP2 =~"'E'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"an~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("pedido", string),("an", number))  sort="dped_index A " )
