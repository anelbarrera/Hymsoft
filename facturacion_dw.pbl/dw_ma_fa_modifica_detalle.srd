 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faddiari~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"faddiari.facd_index~") COLUMN(NAME=~"faddiari.facd_codigo_item~") COLUMN(NAME=~"faddiari.facd_descripcion_alterna~") COLUMN(NAME=~"faddiari.facd_peso~") COLUMN(NAME=~"faddiari.facd_cubicaje~") COLUMN(NAME=~"faddiari.facd_bultos~") COLUMN(NAME=~"faddiari.facd_bulto_inicio~") COLUMN(NAME=~"faddiari.facd_bulto_fin~") COLUMN(NAME=~"faddiari.facd_g_financiero~") COLUMN(NAME=~"faddiari.facd_empresa~") COLUMN(NAME=~"faddiari.facd_tipo~") COLUMN(NAME=~"faddiari.facd_no_pedido~") COLUMN(NAME=~"faddiari.facd_linea~") COLUMN(NAME=~"faddiari.facd_ann~") COLUMN(NAME=~"faddiari.facd_cantidad~") COLUMN(NAME=~"faddiari.facd_cantidad_fraccion~") COLUMN(NAME=~"faddiari.facd_unidad_venta~") COLUMN(NAME=~"inmprodu.prod_descripcion_cuba~") COLUMN(NAME=~"inmprodu.prod_contrato_regalias~") COLUMN(NAME=~"inmprodu.prod_cod_alternativo~")    JOIN (LEFT=~"faddiari.facd_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"faddiari.facd_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"faddiari.facd_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"faddiari.facd_g_financiero~"   OP =~"=~"    EXP2 =~":modi_grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_empresa~"   OP =~"=~"    EXP2 =~":modi_empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_tipo~"   OP =~"=~"    EXP2 =~":modi_tipo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_no_pedido~"   OP =~"=~"    EXP2 =~":modi_pedido~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"faddiari.facd_ann~"   OP =~"=~"    EXP2 =~":modi_ann~" ) ) ARG(NAME = ~"modi_grupo~" TYPE = number)  ARG(NAME = ~"modi_empresa~" TYPE = number)  ARG(NAME = ~"modi_tipo~" TYPE = string)  ARG(NAME = ~"modi_pedido~" TYPE = string)  ARG(NAME = ~"modi_ann~" TYPE = number) " update="faddiari" updatewhere=1 updatekeyinplace=yes arguments=(("modi_grupo", number),("modi_empresa", number),("modi_tipo", string),("modi_pedido", string),("modi_ann", number))  sort="facd_index A " )
