//objectcomments D.W. que muestra la información de la mercancía agotada por fecha sin considerar pedidos reservados
release 7;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 HTMLDW=no print.documentname="" print.orientation = 2 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 1 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=832 color="536870912" )
summary(height=148 color="536870912" )
footer(height=80 color="536870912" )
detail(height=80 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=inmprodu_prod_producto dbname="inmprodu.prod_producto" initial="empty" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" initial="empty" )
 column=(type=datetime updatewhereclause=yes name=inmprodu_prod_entrada_fecha dbname="inmprodu.prod_entrada_fecha" )
 column=(type=decimal(0) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_can dbname="inmprodu.prod_ultima_entrada_can" initial="0" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_doc dbname="inmprodu.prod_ultima_entrada_doc" initial="empty" )
 column=(type=char(5) updatewhereclause=yes name=inmprodu_prod_grupo dbname="inmprodu.prod_grupo" initial="empty" )
 column=(type=char(3) updatewhereclause=yes name=inmprodu_prod_clase dbname="inmprodu.prod_clase" initial="empty" )
 column=(type=decimal(2) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" initial="0" )
 column=(type=decimal(6) updatewhereclause=yes name=indmovim_dmov_cantidad dbname="indmovim.dmov_cantidad" )
 column=(type=decimal(0) updatewhereclause=yes name=indmovim_dmov_cant1 dbname="indmovim.dmov_cant1" )
 column=(type=char(2) updatewhereclause=yes name=indmovim_dmov_unidad_medida dbname="indmovim.dmov_unidad_medida" )
 column=(type=char(100) updatewhereclause=yes name=dgmempre_empr_razon_social dbname="dgmempre.empr_razon_social" )
 column=(type=char(255) updatewhereclause=yes name=dgmempre_empr_icono dbname="dgmempre.empr_icono" )
 column=(type=char(120) updatewhereclause=yes name=dgmempre_empr_logo_f dbname="dgmempre.empr_logo_f" )
 column=(type=datetime updatewhereclause=yes name=indmovim_dmov_fecha_agotado dbname="indmovim.dmov_fecha_agotado" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"indmovim~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"dgmempre~" ) COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_entrada_fecha~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_can~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_doc~") COLUMN(NAME=~"inmprodu.prod_grupo~") COLUMN(NAME=~"inmprodu.prod_clase~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"indmovim.dmov_cantidad~") COLUMN(NAME=~"indmovim.dmov_cant1~") COLUMN(NAME=~"indmovim.dmov_unidad_medida~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_icono~") COLUMN(NAME=~"dgmempre.empr_logo_f~") COLUMN(NAME=~"indmovim.dmov_fecha_agotado~")    JOIN (LEFT=~"indmovim.dmov_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"indmovim.dmov_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"indmovim.dmov_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"indmovim.dmov_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"indmovim.dmov_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )WHERE(    EXP1 =~"( ( indmovim.dmov_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( indmovim.dmov_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( indmovim.dmov_fecha_agotado~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"indmovim.dmov_fecha_agotado~"   OP =~"<=~"    EXP2 =~":fecha2) ) ~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("g_financiero", number),("empresa", number),("fecha1", datetime),("fecha2", datetime)) )
