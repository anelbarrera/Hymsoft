//objectcomments D.W. del informe de las mercancías agotadas, tomando en consideración los pedidos reservados.
release 7;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 HTMLDW=no print.documentname="" print.orientation = 2 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 1 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=840 color="536870912" )
summary(height=112 color="536870912" )
footer(height=84 color="536870912" )
detail(height=84 color="536870912"  height.autosize=yes)
table(column=(type=char(20) updatewhereclause=yes name=fadagota_agot_producto dbname="fadagota.agot_producto" )
 column=(type=char(5) updatewhereclause=yes name=fadagota_agot_bodega dbname="fadagota.agot_bodega" )
 column=(type=char(5) updatewhereclause=yes name=fadagota_agot_ubicacion dbname="fadagota.agot_ubicacion" )
 column=(type=datetime updatewhereclause=yes name=fadagota_agot_fecha_agotado dbname="fadagota.agot_fecha_agotado" )
 column=(type=char(50) updatewhereclause=yes name=inmprodu_prod_descripcion dbname="inmprodu.prod_descripcion" initial="empty" )
 column=(type=char(5) updatewhereclause=yes name=inmprodu_prod_grupo dbname="inmprodu.prod_grupo" initial="empty" )
 column=(type=char(3) updatewhereclause=yes name=inmprodu_prod_clase dbname="inmprodu.prod_clase" initial="empty" )
 column=(type=decimal(2) updatewhereclause=yes name=inmprodu_prod_empaque dbname="inmprodu.prod_empaque" initial="0" )
 column=(type=char(10) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_doc dbname="inmprodu.prod_ultima_entrada_doc" initial="empty" )
 column=(type=decimal(0) updatewhereclause=yes name=inmprodu_prod_ultima_entrada_can dbname="inmprodu.prod_ultima_entrada_can" initial="0" )
 column=(type=datetime updatewhereclause=yes name=inmprodu_prod_entrada_fecha dbname="inmprodu.prod_entrada_fecha" )
 column=(type=char(8) updatewhereclause=yes name=fadagota_agot_no_pedido dbname="fadagota.agot_no_pedido" )
 column=(type=char(3) updatewhereclause=yes name=prod_division dbname="inmprodu.prod_division" )
 column=(type=char(6) updatewhereclause=yes name=sub_grupo dbname="inmprodu.prod_sub_grupo" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"fadagota~" )  TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"fadagota.agot_producto~") COLUMN(NAME=~"fadagota.agot_bodega~") COLUMN(NAME=~"fadagota.agot_ubicacion~") COLUMN(NAME=~"fadagota.agot_fecha_agotado~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_grupo~") COLUMN(NAME=~"inmprodu.prod_clase~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_doc~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_can~") COLUMN(NAME=~"inmprodu.prod_entrada_fecha~") COLUMN(NAME=~"fadagota.agot_no_pedido~") COLUMN(NAME=~"inmprodu.prod_division~") COLUMN(NAME=~"inmprodu.prod_sub_grupo~")    JOIN (LEFT=~"fadagota.agot_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"fadagota.agot_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"fadagota.agot_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )WHERE(    EXP1 =~"fadagota.agot_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadagota.agot_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadagota.agot_fecha_agotado~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fadagota.agot_fecha_agotado~"   OP =~"<=~"    EXP2 =~":fecha2~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("g_financiero", number),("empresa", number),("fecha1", datetime),("fecha2", datetime)) )
