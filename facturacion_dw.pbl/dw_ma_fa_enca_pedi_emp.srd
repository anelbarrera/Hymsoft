table(column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_g_financiero dbname="fatpedid.pedi_g_financiero" dbalias="p.pedi_g_financiero" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_empresa dbname="fatpedid.pedi_empresa" dbalias="p.pedi_empresa" )
 column=(type=char(3) updatewhereclause=yes name=fatpedid_pedi_tipo dbname="fatpedid.pedi_tipo" dbalias="p.pedi_tipo" )
 column=(type=char(8) updatewhereclause=yes name=fatpedid_pedi_no_pedido dbname="fatpedid.pedi_no_pedido" dbalias="p.pedi_no_pedido" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_ann dbname="fatpedid.pedi_ann" dbalias="p.pedi_ann" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_cliente dbname="fatpedid.pedi_cliente" dbalias="p.pedi_cliente" )
 column=(type=char(20) updatewhereclause=yes name=fatpedid_pedi_ruc_cliente dbname="fatpedid.pedi_ruc_cliente" dbalias="p.pedi_ruc_cliente" )
 column=(type=char(2) updatewhereclause=yes name=fatpedid_pedi_condicion_pago dbname="fatpedid.pedi_condicion_pago" dbalias="p.pedi_condicion_pago" values="CONTADO	CO/CRÉDITO	CR/C.O.D	CD/" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_tipo_venta dbname="fatpedid.pedi_tipo_venta" dbalias="p.pedi_tipo_venta" )
 column=(type=char(1) updatewhereclause=yes name=fatpedid_pedi_tipo_movimiento dbname="fatpedid.pedi_tipo_movimiento" dbalias="p.pedi_tipo_movimiento" values="OTROS	O/TRASPASO	T/SALIDA	S/" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_no_traspaso dbname="fatpedid.pedi_no_traspaso" dbalias="p.pedi_no_traspaso" )
 column=(type=datetime updatewhereclause=yes name=fatpedid_pedi_fecha dbname="fatpedid.pedi_fecha" dbalias="p.pedi_fecha" )
 column=(type=datetime updatewhereclause=yes name=fatpedid_pedi_fecha_creacion dbname="fatpedid.pedi_fecha_creacion" dbalias="p.pedi_fecha_creacion" initial="today" )
 column=(type=datetime updatewhereclause=yes name=fatpedid_pedi_fecha_modificacion dbname="fatpedid.pedi_fecha_modificacion" dbalias="p.pedi_fecha_modificacion" initial="today" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_dias_pago dbname="fatpedid.pedi_dias_pago" dbalias="p.pedi_dias_pago" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_consignado dbname="fatpedid.pedi_consignado" dbalias="p.pedi_consignado" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_a_nombre dbname="fatpedid.pedi_a_nombre" dbalias="p.pedi_a_nombre" )
 column=(type=char(250) updatewhereclause=yes name=fatpedid_pedi_a_nombre_direccion dbname="fatpedid.pedi_a_nombre_direccion" dbalias="p.pedi_a_nombre_direccion" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_despachado dbname="fatpedid.pedi_despachado" dbalias="p.pedi_despachado" )
 column=(type=char(2) updatewhereclause=yes name=fatpedid_pedi_via dbname="fatpedid.pedi_via" dbalias="p.pedi_via" initial="OT" values="AÉREA	AE/MARÍTIMA	MR/TERRESTRE	TR/OTROS	OT/" )
 column=(type=char(15) updatewhereclause=yes name=fatpedid_pedi_con_emb_no dbname="fatpedid.pedi_con_emb_no" dbalias="p.pedi_con_emb_no" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_marca dbname="fatpedid.pedi_marca" dbalias="p.pedi_marca" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_bultos_total dbname="fatpedid.pedi_bultos_total" dbalias="p.pedi_bultos_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_cubicaje_total dbname="fatpedid.pedi_cubicaje_total" dbalias="p.pedi_cubicaje_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_peso_total dbname="fatpedid.pedi_peso_total" dbalias="p.pedi_peso_total" initial="0" )
 column=(type=char(3) updatewhereclause=yes name=fatpedid_pedi_unidad_peso dbname="fatpedid.pedi_unidad_peso" dbalias="p.pedi_unidad_peso" )
 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_gastos_total dbname="fatpedid.pedi_gastos_total" dbalias="p.pedi_gastos_total" initial="0" )
 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_monto_total dbname="fatpedid.pedi_monto_total" dbalias="p.pedi_monto_total" initial="0" )
 column=(type=char(1) updatewhereclause=yes name=fatpedid_pedi_descu_subt_deta dbname="fatpedid.pedi_descu_subt_deta" dbalias="p.pedi_descu_subt_deta" initial="N" )
 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_por_descuento dbname="fatpedid.pedi_por_descuento" dbalias="p.pedi_por_descuento" initial="0" )
 column=(type=char(3) updatewhereclause=yes name=fatpedid_pedi_supervisor dbname="fatpedid.pedi_supervisor" dbalias="p.pedi_supervisor" )
 column=(type=decimal(4) updatewhereclause=yes name=fatpedid_pedi_monto_final dbname="fatpedid.pedi_monto_final" dbalias="p.pedi_monto_final" initial="0" )
 column=(type=char(250) updatewhereclause=yes name=fatpedid_pedi_comentario dbname="fatpedid.pedi_comentario" dbalias="p.pedi_comentario" )
 column=(type=char(1) updatewhereclause=yes name=fatpedid_pedi_estado dbname="fatpedid.pedi_estado" dbalias="p.pedi_estado" initial="A" values="ACTIVO	A/ELIMINADO	E/PASADO	P/APROBADO	R/" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" dbalias="t.terc_descripcion" )
 column=(type=char(5) updatewhereclause=yes name=fatpedid_pedi_autorizacion dbname="fatpedid.pedi_autorizacion" dbalias="p.pedi_autorizacion" )
 retrieve=" SELECT 
    p.pedi_g_financiero,   
    p.pedi_empresa,   
    p.pedi_tipo,   
    p.pedi_no_pedido,   
    p.pedi_ann,   
    p.pedi_cliente,   
    p.pedi_ruc_cliente,   
    p.pedi_condicion_pago,   
    p.pedi_tipo_venta,   
    p.pedi_tipo_movimiento,   
    p.pedi_no_traspaso,   
    p.pedi_fecha,   
    p.pedi_fecha_creacion,   
    p.pedi_fecha_modificacion,   
    p.pedi_dias_pago,   
    p.pedi_consignado,   
    p.pedi_a_nombre,   
    p.pedi_a_nombre_direccion,   
    p.pedi_despachado,   
    p.pedi_via,   
    p.pedi_con_emb_no,   
    p.pedi_marca,   
    p.pedi_bultos_total,   
    p.pedi_cubicaje_total,   
    p.pedi_peso_total,   
    p.pedi_unidad_peso,   
    p.pedi_gastos_total,   
    p.pedi_monto_total,   
    p.pedi_descu_subt_deta,   
    p.pedi_por_descuento,   
    p.pedi_supervisor,   
    p.pedi_monto_final,   
    p.pedi_comentario,   
    p.pedi_estado,   
    t.terc_descripcion,   
    p.pedi_autorizacion  
FROM fatpedid p
INNER JOIN dgmterce t 
    ON t.terc_tercero = p.pedi_cliente
WHERE p.pedi_g_financiero = :g_financiero
  AND p.pedi_empresa = :empresa
  AND p.pedi_estado not in ('A','P');
" retrieve.asneeded=yes arguments=(("g_financiero", number),("empresa", number))  sort="fatpedid_pedi_no_pedido A fatpedid_pedi_ann A " )
