table(column=(type=datetime updatewhereclause=yes name=fatdiari_fact_fecha dbname="fatdiari.fact_fecha" dbalias=".fact_fecha" )
 column=(type=char(8) updatewhereclause=yes name=fatdiari_fact_no_factura dbname="fatdiari.fact_no_factura" dbalias=".fact_no_factura" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
 column=(type=char(3) updatewhereclause=yes name=fatdiari_fact_tipo dbname="fatdiari.fact_tipo" dbalias=".fact_tipo" )
 column=(type=char(100) updatewhereclause=yes name=dgmempre_empr_razon_social dbname="dgmempre.empr_razon_social" dbalias=".empr_razon_social" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"dgmempre~" ) COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"dgmempre.empr_razon_social~")    JOIN (LEFT=~"fatdiari.fact_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":inicio~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~"<=~"    EXP2 =~":final~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_no_factura~"   OP =~"<>~"    EXP2 =~"'0'~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"inicio~" TYPE = date)  ARG(NAME = ~"final~" TYPE = date) " arguments=(("grupo", number),("empresa", number),("inicio", date),("final", date))  sort="long(fatdiari_fact_no_factura) A fatdiari_fact_fecha A " )
