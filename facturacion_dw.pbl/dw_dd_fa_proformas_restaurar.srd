release 7;
datawindow(units=0 timer_interval=0 color=79741120 processing=0 HTMLDW=no print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=64 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=72 color="536870912" )
table(column=(type=char(3) updatewhereclause=yes name=prof_tipo dbname="fatprofo.prof_tipo" )
 column=(type=char(8) updatewhereclause=yes name=prof_no_proforma dbname="fatprofo.prof_no_proforma" )
 column=(type=decimal(0) updatewhereclause=yes name=prof_ann dbname="fatprofo.prof_ann" )
 column=(type=datetime updatewhereclause=yes name=prof_fecha dbname="fatprofo.prof_fecha" )
 column=(type=char(100) updatewhereclause=yes name=prof_a_nombre dbname="fatprofo.prof_a_nombre" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"faaparam~" )  TABLE(NAME=~"fatprofo~" ) COLUMN(NAME=~"fatprofo.prof_tipo~") COLUMN(NAME=~"fatprofo.prof_no_proforma~") COLUMN(NAME=~"fatprofo.prof_ann~") COLUMN(NAME=~"fatprofo.prof_fecha~") COLUMN(NAME=~"fatprofo.prof_a_nombre~")    JOIN (LEFT=~"fatprofo.prof_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatprofo.prof_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )    JOIN (LEFT=~"fatprofo.prof_ann~"    OP =~"=~"RIGHT=~"faaparam.fara_fact_ano~" )WHERE(    EXP1 =~"fatprofo.prof_g_financiero~"   OP =~"=~"    EXP2 =~":pedi_grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatprofo.prof_empresa~"   OP =~"=~"    EXP2 =~":pedi_empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatprofo.prof_estado~"   OP =~"=~"    EXP2 =~"'P'~" ) ) ARG(NAME = ~"pedi_grupo~" TYPE = number)  ARG(NAME = ~"pedi_empresa~" TYPE = number) " arguments=(("pedi_grupo", number),("pedi_empresa", number))  sort="prof_no_proforma A prof_fecha A " )
