 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fadempaq~" ) COLUMN(NAME=~"fadempaq.empa_linea_original~") COLUMN(NAME=~"fadempaq.empa_codigo_producto~") COLUMN(NAME=~"fadempaq.empa_cantidad~") COLUMN(NAME=~"fadempaq.empa_unidad~") COLUMN(NAME=~"fadempaq.empa_bodega~") COLUMN(NAME=~"fadempaq.empa_ubicacion~")WHERE(    EXP1 =~"fadempaq.empa_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadempaq.empa_empresa~"   OP =~"=~"    EXP2 =~":emrpresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadempaq.empa_ann~"   OP =~"=~"    EXP2 =~":anio~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadempaq.empa_lista_empaque~"   OP =~"=~"    EXP2 =~":lista_empaque~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"emrpresa~" TYPE = number)  ARG(NAME = ~"anio~" TYPE = number)  ARG(NAME = ~"lista_empaque~" TYPE = string) " arguments=(("grupo", number),("emrpresa", number),("anio", number),("lista_empaque", string)) )
