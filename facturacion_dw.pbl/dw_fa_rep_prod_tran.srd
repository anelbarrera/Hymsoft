 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatpedid~" )  TABLE(NAME=~"fadpedid~" )  TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"inamedid~" ) COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_cliente~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fadpedid.dped_codigo_item~") COLUMN(NAME=~"fadpedid.dped_descripcion_alterna~") COLUMN(NAME=~"fadpedid.dped_precio_unidad_producto~") COLUMN(NAME=~"fadpedid.dped_unidad_venta~") COLUMN(NAME=~"fadpedid.dped_cantidad~") COLUMN(NAME=~"fadpedid.dped_fraccion~") COLUMN(NAME=~"fadpedid.dped_monto_total~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_um~") COLUMN(NAME=~"inmprodu.prod_empaque_caja~") COLUMN(NAME=~"inamedid.medi_descripcion~") COLUMN(NAME=~"inamedid.medi_cantidad~") COLUMN(NAME=~"inamedid.medi_abre~") COLUMN(NAME=~"fadpedid.dped_index~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~")    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"fadpedid.dped_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"fadpedid.dped_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_no_pedido~"    OP =~"=~"RIGHT=~"fadpedid.dped_no_pedido~" )    JOIN (LEFT=~"fatpedid.pedi_ann~"    OP =~"=~"RIGHT=~"fadpedid.dped_ann~" )    JOIN (LEFT=~"fadpedid.dped_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"fadpedid.dped_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"fadpedid.dped_codigo_item~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~" )    JOIN (LEFT=~"inamedid.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_medida~" )WHERE(    EXP1 =~"fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":an_g_financiero~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":an_empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatpedid.pedi_fecha~"   OP =~">=~"    EXP2 =~":fecha_i~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatpedid.pedi_fecha~"   OP =~"<=~"    EXP2 =~":fecha_f~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fadpedid.dped_reserva_origen~"   OP =~"=~"    EXP2 =~"'T'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_estado~"   OP =~"=~"    EXP2 =~"'A'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fadpedid.dped_cantidad + fadpedid.dped_fraccion~"   OP =~">~"    EXP2 =~"0~" ) ) ARG(NAME = ~"an_g_financiero~" TYPE = number)  ARG(NAME = ~"an_empresa~" TYPE = number)  ARG(NAME = ~"fecha_i~" TYPE = date)  ARG(NAME = ~"fecha_f~" TYPE = date) " arguments=(("an_g_financiero", number),("an_empresa", number),("fecha_i", date),("fecha_f", date))  sort="fadpedid_dped_codigo_item A fatpedid_pedi_fecha A " )
