 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatempaq~" )  TABLE(NAME=~"fatpedid~" )  TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"fatpedid.pedi_cliente~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~") COLUMN(NAME=~"fatempaq.enca_lista_empaque~") COLUMN(NAME=~"fatempaq.enca_ann~") COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_ann~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatempaq.enca_fecha_despachado~") COLUMN(NAME=~"fatpedid.pedi_tipo~") COLUMN(NAME=~"fatpedid.pedi_condicion_pago~") COLUMN(NAME=~"fatpedid.pedi_tipo_venta~") COLUMN(NAME=~"fatpedid.pedi_tipo_movimiento~") COLUMN(NAME=~"fatpedid.pedi_no_traspaso~") COLUMN(NAME=~"fatpedid.pedi_dias_pago~") COLUMN(NAME=~"fatpedid.pedi_consignado~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fatpedid.pedi_a_nombre_direccion~") COLUMN(NAME=~"fatpedid.pedi_despachado~") COLUMN(NAME=~"fatpedid.pedi_via~") COLUMN(NAME=~"fatpedid.pedi_con_emb_no~") COLUMN(NAME=~"fatpedid.pedi_marca~") COLUMN(NAME=~"fatpedid.pedi_descu_subt_deta~") COLUMN(NAME=~"fatpedid.pedi_por_descuento~") COLUMN(NAME=~"fatpedid.pedi_supervisor~") COLUMN(NAME=~"fatpedid.pedi_comentario~") COLUMN(NAME=~"fatpedid.pedi_estado~") COLUMN(NAME=~"fatpedid.pedi_autorizacion~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_fecha_creacion~") COLUMN(NAME=~"fatpedid.pedi_fecha_modificacion~") COLUMN(NAME=~"fatempaq.enca_pasado~")    JOIN (LEFT=~"fatempaq.enca_g_financiero~"    OP =~"=~"RIGHT=~"fatpedid.pedi_g_financiero~" )    JOIN (LEFT=~"fatempaq.enca_empresa~"    OP =~"=~"RIGHT=~"fatpedid.pedi_empresa~" )    JOIN (LEFT=~"fatempaq.enca_no_pedido~"    OP =~"=~"RIGHT=~"fatpedid.pedi_no_pedido~" )    JOIN (LEFT=~"fatempaq.enca_ann_pedido~"    OP =~"=~"RIGHT=~"fatpedid.pedi_ann~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"fatpedid.pedi_cliente~" )WHERE(    EXP1 =~"( ( fatempaq.enca_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatempaq.enca_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatempaq.enca_pasado~"   OP =~"<>~"    EXP2 =~"~~~"S~~~" )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatempaq.enca_no_pedido~"   OP =~"=~"    EXP2 =~":pedido )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatempaq.enca_ann_pedido~"   OP =~"=~"    EXP2 =~":anno )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatempaq.enca_tipo~"   OP =~"=~"    EXP2 =~":tipo)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatempaq.enca_fuente~"   OP =~"=~"    EXP2 =~":fuente ) )~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"anno~" TYPE = number)  ARG(NAME = ~"tipo~" TYPE = string)  ARG(NAME = ~"fuente~" TYPE = string) " arguments=(("g_financiero", number),("empresa", number),("pedido", string),("anno", number),("tipo", string),("fuente", string)) )
