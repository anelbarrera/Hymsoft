//objectcomments D.W. del informe de las mercancías agotadas, tomando en consideración los pedidos reservados.
release 7;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 HTMLDW=no print.documentname="" print.orientation = 2 print.margin.left = 110 print.margin.right = 110 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 1 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=844 color="536870912" )
summary(height=112 color="536870912" )
footer(height=12 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(20) updatewhereclause=yes name=fadagota_agot_producto dbname="fadagota.agot_producto" )
 column=(type=char(5) updatewhereclause=yes name=fadagota_agot_bodega dbname="fadagota.agot_bodega" )
 column=(type=char(5) updatewhereclause=yes name=fadagota_agot_ubicacion dbname="fadagota.agot_ubicacion" )
 column=(type=datetime updatewhereclause=yes name=fadagota_agot_fecha_agotado dbname="fadagota.agot_fecha_agotado" )
 column=(type=char(100) updatewhereclause=yes name=dgmempre_empr_razon_social dbname="dgmempre.empr_razon_social" )
 column=(type=char(255) updatewhereclause=yes name=dgmempre_empr_icono dbname="dgmempre.empr_icono" )
 column=(type=char(120) updatewhereclause=yes name=dgmempre_empr_logo_f dbname="dgmempre.empr_logo_f" )
 column=(type=char(8) updatewhereclause=yes name=fadagota_agot_no_pedido dbname="fadagota.agot_no_pedido" )
 column=(type=decimal(0) updatewhereclause=yes name=fatpedid_pedi_no_traspaso dbname="fatpedid.pedi_no_traspaso" )
 column=(type=datetime updatewhereclause=yes name=fatpedid_pedi_fecha dbname="fatpedid.pedi_fecha" )
 column=(type=char(1) updatewhereclause=yes name=fatpedid_pedi_estado dbname="fatpedid.pedi_estado" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_a_nombre dbname="fatpedid.pedi_a_nombre" )
 column=(type=decimal(0) updatewhereclause=yes name=fadagota_agot_anno dbname="fadagota.agot_anno" )
 column=(type=char(3) updatewhereclause=yes name=fadagota_agot_tipo dbname="fadagota.agot_tipo" )
 column=(type=char(20) updatewhereclause=yes name=fatpedid_pedi_ruc_cliente dbname="fatpedid.pedi_ruc_cliente" )
 column=(type=long updatewhereclause=yes name=agot_viene_de_factura dbname="fadagota.agot_viene_de_factura" )
 column=(type=char(255) updatewhereclause=yes name=fadpedid_dped_descripcion_alterna dbname="fadpedid.dped_descripcion_alterna" )
 retrieve="PBSELECT( VERSION(400) DISTINCT ()TABLE(NAME=~"fadagota~" )  TABLE(NAME=~"fadpedid~" )  TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"fatpedid~" ) COLUMN(NAME=~"fadagota.agot_producto~") COLUMN(NAME=~"fadagota.agot_bodega~") COLUMN(NAME=~"fadagota.agot_ubicacion~") COLUMN(NAME=~"fadagota.agot_fecha_agotado~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_icono~") COLUMN(NAME=~"dgmempre.empr_logo_f~") COLUMN(NAME=~"fadagota.agot_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_no_traspaso~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_estado~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fadagota.agot_anno~") COLUMN(NAME=~"fadagota.agot_tipo~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~") COLUMN(NAME=~"fadagota.agot_viene_de_factura~") COLUMN(NAME=~"fadpedid.dped_descripcion_alterna~")    JOIN (LEFT=~"fadpedid.dped_g_financiero~"    OP =~"=~"RIGHT=~"fadagota.agot_g_financiero~" )    JOIN (LEFT=~"fadpedid.dped_empresa~"    OP =~"=~"RIGHT=~"fadagota.agot_empresa~" )    JOIN (LEFT=~"fadpedid.dped_no_pedido~"    OP =~"=~"RIGHT=~"fadagota.agot_no_pedido~" )    JOIN (LEFT=~"fadpedid.dped_ann~"    OP =~"=~"RIGHT=~"fadagota.agot_anno~" )    JOIN (LEFT=~"fadpedid.dped_linea~"    OP =~"=~"RIGHT=~"fadagota.agot_linea~" )    JOIN (LEFT=~"fadpedid.dped_codigo_item~"    OP =~"=~"RIGHT=~"fadagota.agot_producto~" )    JOIN (LEFT=~"fadagota.agot_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fadagota.agot_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"fadpedid.dped_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"fadpedid.dped_empresa~" )    JOIN (LEFT=~"fatpedid.pedi_no_pedido~"    OP =~"=~"RIGHT=~"fadpedid.dped_no_pedido~" )    JOIN (LEFT=~"fatpedid.pedi_ann~"    OP =~"=~"RIGHT=~"fadpedid.dped_ann~" )WHERE(    EXP1 =~"( ( fadagota.agot_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadagota.agot_empresa~"   OP =~"=~"    EXP2 =~":empresa )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fadagota.agot_no_pedido~"   OP =~"=~"    EXP2 =~":pedido)~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"( fadagota.agot_anno~"   OP =~"=~"    EXP2 =~":anio)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fadagota.agot_fecha_agotado~"   OP =~"=~"    EXP2 =~"convert(datetime,convert( varchar(10), fadpedid.dped_fecha_reg,103 )  ,103) ) )~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"anio~" TYPE = number) " arguments=(("g_financiero", number),("empresa", number),("pedido", string),("anio", number)) )
