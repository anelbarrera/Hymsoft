 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_tipo~") COLUMN(NAME=~"fatdiari.fact_ann~") COLUMN(NAME=~"fatdiari.fact_estado~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_a_nombre~")WHERE(    EXP1 =~"fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_fac_key~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa_fac_key~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_ann~"   OP =~"=~"    EXP2 =~":ann_fac_key~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_no_pedido~"   OP =~"not like~"    EXP2 =~"'%NC%'~" ) ) ARG(NAME = ~"grupo_fac_key~" TYPE = number)  ARG(NAME = ~"empresa_fac_key~" TYPE = number)  ARG(NAME = ~"ann_fac_key~" TYPE = number) " retrieve.asneeded=yes arguments=(("grupo_fac_key", number),("empresa_fac_key", number),("ann_fac_key", number))  sort="fact_no_factura A real(fact_no_pedido) A fact_ann A fact_fecha A " )
