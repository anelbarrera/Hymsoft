table(column=(type=char(8) updatewhereclause=yes name=pedi_no_pedido dbname="fatpedid.pedi_no_pedido" )
 column=(type=decimal(0) updatewhereclause=yes name=pedi_ann dbname="fatpedid.pedi_ann" )
 column=(type=char(100) updatewhereclause=yes name=fatpedid_pedi_a_nombre dbname="fatpedid.pedi_a_nombre" )
 column=(type=datetime updatewhereclause=yes name=fatpedid_pedi_fecha dbname="fatpedid.pedi_fecha" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatpedid~" ) COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_ann~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"fatpedid.pedi_fecha~")WHERE(    EXP1 =~"fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_ped_key~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa_ped_key~" ) ) ARG(NAME = ~"grupo_ped_key~" TYPE = number)  ARG(NAME = ~"empresa_ped_key~" TYPE = number) " retrieve.asneeded=yes arguments=(("grupo_ped_key", number),("empresa_ped_key", number))  sort="pedi_no_pedido A fatpedid_pedi_fecha A " )
