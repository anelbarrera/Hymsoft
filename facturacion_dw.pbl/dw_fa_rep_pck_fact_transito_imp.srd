//objectcomments Data Windows para el reporte de los Packing List pendientes de Factura
release 7;
datawindow(units=0 timer_interval=60000 color=1090519039 processing=0 HTMLDW=no print.documentname="" print.orientation = 2 print.margin.left = 110 print.margin.right = 55 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 1 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=740 color="536870912" )
summary(height=128 color="-1" )
footer(height=4 color="-1" )
detail(height=72 color="-1"  height.autosize=yes)
table(column=(type=decimal(0) updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" initial="0" )
 column=(type=char(20) updatewhereclause=yes name=terc_identificacion dbname="dgmterce.terc_identificacion" initial="spaces" )
 column=(type=char(40) updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" initial="spaces" )
 column=(type=char(100) updatewhereclause=yes name=dgmempre_empr_razon_social dbname="dgmempre.empr_razon_social" )
 column=(type=char(255) updatewhereclause=yes name=dgmempre_empr_icono dbname="dgmempre.empr_icono" )
 column=(type=char(120) updatewhereclause=yes name=dgmempre_empr_logo_f dbname="dgmempre.empr_logo_f" )
 column=(type=char(100) updatewhereclause=yes name=dgapais_pais_descripcion dbname="dgapais.pais_descripcion" )
 column=(type=char(100) updatewhereclause=yes name=dgaregio_regi_descripcion dbname="dgaregio.regi_descripcion" )
 column=(type=char(8) updatewhereclause=yes name=vi_pedi_transito_pedi_no_pedido dbname="vi_pedi_transito.pedi_no_pedido" )
 column=(type=decimal(0) updatewhereclause=yes name=vi_pedi_transito_pedi_ann dbname="vi_pedi_transito.pedi_ann" )
 column=(type=datetime updatewhereclause=yes name=vi_pedi_transito_pedi_fecha dbname="vi_pedi_transito.pedi_fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=vi_pedi_transito_pedi_monto_final dbname="vi_pedi_transito.pedi_monto_final" )
 column=(type=char(1) updatewhereclause=yes name=vi_pedi_transito_dped_reserva_origen dbname="vi_pedi_transito.dped_reserva_origen" values="Tránsito	T/Confirmación	C/" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaregio~" )  TABLE(NAME=~"vi_pedi_transito~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_icono~") COLUMN(NAME=~"dgmempre.empr_logo_f~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"dgaregio.regi_descripcion~") COLUMN(NAME=~"vi_pedi_transito.pedi_no_pedido~") COLUMN(NAME=~"vi_pedi_transito.pedi_ann~") COLUMN(NAME=~"vi_pedi_transito.pedi_fecha~") COLUMN(NAME=~"vi_pedi_transito.pedi_monto_final~") COLUMN(NAME=~"vi_pedi_transito.dped_reserva_origen~")    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgaregio.regi_pais~" )    JOIN (LEFT=~"dgmterce.terc_region~"    OP =~"=~"RIGHT=~"dgaregio.regi_codigo_region~" )    JOIN (LEFT=~"vi_pedi_transito.pedi_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"vi_pedi_transito.pedi_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"vi_pedi_transito.pedi_cliente~" )WHERE(    EXP1 =~"( ( vi_pedi_transito.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( vi_pedi_transito.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_pedi_transito.pedi_fecha~"   OP =~">=~"    EXP2 =~":fecha)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(vi_pedi_transito.pedi_fecha~"   OP =~"<=~"    EXP2 =~":fecha_h)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"vi_pedi_transito.dped_reserva_origen~"   OP =~"in~"    EXP2 =~":reserva_origen~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"fecha_h~" TYPE = datetime)  ARG(NAME = ~"reserva_origen~" TYPE = stringlist) " arguments=(("g_financiero", number),("empresa", number),("fecha", datetime),("fecha_h", datetime),("reserva_origen", stringlist))  sort="vi_pedi_transito_dped_reserva_origen A dias_pendientes D vi_pedi_transito_pedi_no_pedido A vi_pedi_transito_pedi_ann A " )
group(level=1 header.height=152 trailer.height=8 by=("vi_pedi_transito_dped_reserva_origen" ) header.color="536870912" trailer.color="536870912" )
