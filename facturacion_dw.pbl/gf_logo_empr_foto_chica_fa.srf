//objectcomments  
global type gf_logo_empr_foto_chica_fa from function_object
end type

forward prototypes
global function string gf_logo_empr_foto_chica_fa ()
end prototypes

global function string gf_logo_empr_foto_chica_fa ();String ls_logote
  SELECT isnull(faaparam.fara_logo_f ," ")
     INTO :ls_logote  
    FROM faaparam  
   WHERE ( faaparam.fara_g_financiero = :str.g_financiero ) AND  
         ( faaparam.fara_empresa = :str.empresa )   ;
			
		if sqlca.sqlcode = -1 then
			mensaje("Aviso","Error al seleccionar el logo chico",sqlca.sqlerrtext)
			return ''
		end if
//faaparam.fara_logo,   
Return ls_logote


end function

