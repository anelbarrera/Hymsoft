 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" )  TABLE(NAME=~"cracolor~" )  TABLE(NAME=~"cramarca~" )  TABLE(NAME=~"craespec~" )  TABLE(NAME=~"cratipos~" )  TABLE(NAME=~"craprodu~" )  TABLE(NAME=~"cracltam~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_a~" )  TABLE(NAME=~"inmbodeg~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_b~" )  TABLE(NAME=~"inamedid~" ALIAS=~"inamedid_c~" ) COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~") COLUMN(NAME=~"inmprodu.prod_producto_dos~") COLUMN(NAME=~"inmprodu.prod_descripcion_dos~") COLUMN(NAME=~"inmprodu.prod_medida~") COLUMN(NAME=~"inmprodu.prod_peso~") COLUMN(NAME=~"inmprodu.prod_cubicaje~") COLUMN(NAME=~"inmprodu.prod_empaque~") COLUMN(NAME=~"inmprodu.prod_empaque_descripcion~") COLUMN(NAME=~"inmprodu.prod_peso_descripcion~") COLUMN(NAME=~"cracolor.acol_nombre_color~") COLUMN(NAME=~"inmprodu.prod_fecha_creacion~") COLUMN(NAME=~"inmprodu.prod_owner~") COLUMN(NAME=~"cramarca.amar_nombre_marca~") COLUMN(NAME=~"cramarca.amar_num_marca~") COLUMN(NAME=~"cracolor.acol_num_color~") COLUMN(NAME=~"inmprodu.prod_barra~") COLUMN(NAME=~"inmprodu.prod_arancel~") COLUMN(NAME=~"inmprodu.prod_codigo_modelo~") COLUMN(NAME=~"inmprodu.prod_cod_alternativo~") COLUMN(NAME=~"cratipos.atip_descripcion_tipo~") COLUMN(NAME=~"craespec.aesp_descripcion_espec~") COLUMN(NAME=~"craprodu.apro_nombre_prod~") COLUMN(NAME=~"cracltam.acta_descripcion~") COLUMN(NAME=~"inmprodu.prod_ultima_actualizacion~") COLUMN(NAME=~"inmprodu.prod_foto_dir~") COLUMN(NAME=~"inamedid_a.medi_descripcion~") COLUMN(NAME=~"inmbodeg.mbod_bodega~") COLUMN(NAME=~"inmbodeg.mbod_ubicacion~") COLUMN(NAME=~"inmprodu.prod_ultima_salida_doc~") COLUMN(NAME=~"inmprodu.prod_salida_fecha~") COLUMN(NAME=~"inmprodu.prod_entrada_fecha~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_doc~") COLUMN(NAME=~"inmprodu.prod_ultima_entrada_can~") COLUMN(NAME=~"inmbodeg.mbod_cantidad~") COLUMN(NAME=~"inmbodeg.mbod_precio_mayor~") COLUMN(NAME=~"inmbodeg.mbod_precio_menor~") COLUMN(NAME=~"inmbodeg.mbod_precio_afiliadas~") COLUMN(NAME=~"inmbodeg.mbod_precio_otros~") COLUMN(NAME=~"inmbodeg.mbod_precio_especial~") COLUMN(NAME=~"inmbodeg.mbod_reserva~") COLUMN(NAME=~"inmprodu.prod_cant_transito~") COLUMN(NAME=~"inmprodu.prod_reserva_total~") COLUMN(NAME=~"inmprodu.prod_existencia_total~") COLUMN(NAME=~"inmbodeg.mbod_costo_cif~") COLUMN(NAME=~"inamedid_b.medi_cantidad~") COLUMN(NAME=~"inmprodu.prod_precio_mayor~") COLUMN(NAME=~"inmprodu.prod_precio_menor~") COLUMN(NAME=~"inmprodu.prod_precio_afiliadas~") COLUMN(NAME=~"inmprodu.prod_precio_otros~") COLUMN(NAME=~"inmprodu.prod_precio_especial~") COMPUTE(NAME=~"convert(numeric(10,0),(inmprodu.prod_reserva_total/inamedid_b.medi_cantidad)) rentero~") COMPUTE(NAME=~"inmprodu.prod_reserva_total - (convert(numeric(10,0),(inmprodu.prod_reserva_total/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) rfraccion~") COMPUTE(NAME=~"convert(numeric(10,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) /inamedid_b.medi_cantidad)) dentero~") COMPUTE(NAME=~"(inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) - (convert(numeric(10,0),((inmprodu.prod_existencia_total - inmprodu.prod_reserva_total) /inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) dfraccion~") COMPUTE(NAME=~"convert(numeric(10,0),(inmprodu.prod_existencia_total/inamedid_b.medi_cantidad)) entero~") COMPUTE(NAME=~"inmprodu.prod_existencia_total - (convert(numeric(10,0),(inmprodu.prod_existencia_total/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) fraccion~") COMPUTE(NAME=~"convert(numeric(10,0),(inmprodu.prod_cant_transito  /inamedid_b.medi_cantidad)) tran_entero~") COMPUTE(NAME=~"inmprodu.prod_cant_transito - (convert(numeric(10,0),(inmprodu.prod_cant_transito/inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) tran_fraccion~") COLUMN(NAME=~"inamedid_b.medi_descripcion~") COLUMN(NAME=~"inmprodu.prod_reserva_trans~") COMPUTE(NAME=~"inmprodu.prod_reserva_trans - (convert(numeric(10,0),(inmprodu.prod_reserva_trans /inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) tran_rfraccion~") COMPUTE(NAME=~"convert(numeric(10,0),((inmprodu.prod_cant_transito - inmprodu.prod_reserva_trans) /inamedid_b.medi_cantidad)) tran_dentero~") COMPUTE(NAME=~"convert(numeric(10,0),(inmprodu.prod_reserva_trans /inamedid_b.medi_cantidad)) tran_rentero~") COMPUTE(NAME=~"(inmprodu.prod_cant_transito - inmprodu.prod_reserva_trans) - (convert(numeric(10,0),((inmprodu.prod_cant_transito - inmprodu.prod_reserva_trans) /inamedid_b.medi_cantidad)) * inamedid_b.medi_cantidad) tran_dfraccion~") COLUMN(NAME=~"inamedid_c.medi_abre~") COLUMN(NAME=~"inmprodu.prod_costo_cif~")    JOIN (LEFT=~"cracolor.acol_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~"    OUTER2 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cracolor.acol_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~"    OUTER2 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cracolor.acol_num_color~"    OP =~"=~"RIGHT=~"inmprodu.prod_color~"    OUTER2 =~"inmprodu.prod_color~" )    JOIN (LEFT=~"cramarca.amar_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~"    OUTER2 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cramarca.amar_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~"    OUTER2 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cramarca.amar_num_marca~"    OP =~"=~"RIGHT=~"inmprodu.prod_marca~"    OUTER2 =~"inmprodu.prod_marca~" )    JOIN (LEFT=~"craespec.aesp_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~"    OUTER2 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"craespec.aesp_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~"    OUTER2 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"craespec.aesp_num_especificacion~"    OP =~"=~"RIGHT=~"inmprodu.prod_compuesto~"    OUTER2 =~"inmprodu.prod_compuesto~" )    JOIN (LEFT=~"cratipos.atip_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~"    OUTER2 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cratipos.atip_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~"    OUTER2 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cratipos.atip_num_tipo~"    OP =~"=~"RIGHT=~"inmprodu.prod_num_tipo~"    OUTER2 =~"inmprodu.prod_num_tipo~" )    JOIN (LEFT=~"craprodu.apro_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~"    OUTER2 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"craprodu.apro_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~"    OUTER2 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"craprodu.apro_num_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_num_producto~"    OUTER2 =~"inmprodu.prod_num_producto~" )    JOIN (LEFT=~"cracltam.acta_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~"    OUTER2 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"cracltam.acta_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~"    OUTER2 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"cracltam.acta_cod_clase_tam~"    OP =~"=~"RIGHT=~"inmprodu.prod_cod_clase_tam~"    OUTER2 =~"inmprodu.prod_cod_clase_tam~" )    JOIN (LEFT=~"inmbodeg.mbod_g_financiero~"    OP =~"=~"RIGHT=~"inmprodu.prod_g_financiero~"    OUTER2 =~"inmprodu.prod_g_financiero~" )    JOIN (LEFT=~"inmbodeg.mbod_empresa~"    OP =~"=~"RIGHT=~"inmprodu.prod_empresa~"    OUTER2 =~"inmprodu.prod_empresa~" )    JOIN (LEFT=~"inmbodeg.mbod_producto~"    OP =~"=~"RIGHT=~"inmprodu.prod_producto~"    OUTER2 =~"inmprodu.prod_producto~" )    JOIN (LEFT=~"inamedid_a.medi_medida~"    OP =~"=~"RIGHT=~"inmprodu.prod_peso_unidad_medida~" )    JOIN (LEFT=~"inmprodu.prod_medida~"    OP =~"=~"RIGHT=~"inamedid_b.medi_medida~" )    JOIN (LEFT=~"inmprodu.prod_empaque_um~"    OP =~"=~"RIGHT=~"inamedid_c.medi_medida~" )WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_producto~"   OP =~"=~"    EXP2 =~":producto~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_status~"   OP =~"=~"    EXP2 =~"1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmbodeg.mbod_bodega+inmbodeg.mbod_ubicacion~"   OP =~"<>~"    EXP2 =~":bod_ubica~" ) ) ORDER(NAME=~"inmprodu.prod_producto~" ASC=yes ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"producto~" TYPE = string)  ARG(NAME = ~"bod_ubica~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("producto", string),("bod_ubica", string))  sort="inmbodeg_mbod_bodega A inmbodeg_mbod_ubicacion A " )
