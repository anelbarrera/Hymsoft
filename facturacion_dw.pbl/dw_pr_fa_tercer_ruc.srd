table(column=(type=decimal(0) update=yes updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" dbalias=".terc_tercero" )
 column=(type=char(20) update=yes updatewhereclause=yes name=terc_identificacion dbname="dgmterce.terc_identificacion" dbalias=".terc_identificacion" )
 column=(type=char(60) update=yes updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
 column=(type=char(250) updatewhereclause=yes name=terc_direccion dbname="dgmterce.terc_direccion" dbalias=".terc_direccion" )
 column=(type=char(154) updatewhereclause=yes name=descrip dbname="descrip" )
 column=(type=decimal(0) updatewhereclause=yes name=clie_limite_morosidad dbname="ccmclien.clie_limite_morosidad" dbalias=".clie_limite_morosidad" )
 column=(type=char(100) updatewhereclause=yes name=pais_descripcion dbname="dgapais.pais_descripcion" dbalias=".pais_descripcion" )
 column=(type=char(15) updatewhereclause=yes name=clie_ref_anterior dbname="ccmclien.clie_ref_anterior" dbalias=".clie_ref_anterior" )
 column=(type=char(3) updatewhereclause=yes name=clie_tipo_factura dbname="ccmclien.clie_tipo_factura" dbalias=".clie_tipo_factura" )
 column=(type=long updatewhereclause=yes name=clie_clasificacion dbname="ccmclien.clie_clasificacion" dbalias=".clie_clasificacion" )
 column=(type=decimal(0) updatewhereclause=yes name=terc_provincia dbname="dgmterce.terc_provincia" dbalias=".terc_provincia" )
 column=(type=decimal(0) updatewhereclause=yes name=terc_distrito dbname="dgmterce.terc_distrito" dbalias=".terc_distrito" )
 column=(type=decimal(0) updatewhereclause=yes name=terc_corregimiento dbname="dgmterce.terc_corregimiento" dbalias=".terc_corregimiento" )
 column=(type=char(1) updatewhereclause=yes name=terc_tipo_fact dbname="dgmterce.terc_tipo_fact" dbalias=".terc_tipo_fact" )
 column=(type=char(2) updatewhereclause=yes name=terc_digito_verificador dbname="dgmterce.terc_digito_verificador" dbalias=".terc_digito_verificador" )
 column=(type=char(20) updatewhereclause=yes name=terc_ruc dbname="dgmterce.terc_ruc" dbalias=".terc_ruc" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"ccmclien~" )  TABLE(NAME=~"dgapais~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmterce.terc_direccion~") COMPUTE(NAME=~"dgmterce.terc_descripcion+~~~"                                                                                    ~~~"+convert(varchar(10),dgmterce.terc_tercero) descrip~") COLUMN(NAME=~"ccmclien.clie_limite_morosidad~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"ccmclien.clie_ref_anterior~") COLUMN(NAME=~"ccmclien.clie_tipo_factura~") COLUMN(NAME=~"ccmclien.clie_clasificacion~") COLUMN(NAME=~"dgmterce.terc_provincia~") COLUMN(NAME=~"dgmterce.terc_distrito~") COLUMN(NAME=~"dgmterce.terc_corregimiento~") COLUMN(NAME=~"dgmterce.terc_tipo_fact~") COLUMN(NAME=~"dgmterce.terc_digito_verificador~") COLUMN(NAME=~"dgmterce.terc_ruc~")    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )WHERE(    EXP1 =~"( ccmclien.clie_g_financiero~"   OP =~"=~"    EXP2 =~":clie_grupo )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( ccmclien.clie_empresa~"   OP =~"=~"    EXP2 =~":clie_empresa )~" ) ) ARG(NAME = ~"clie_grupo~" TYPE = number)  ARG(NAME = ~"clie_empresa~" TYPE = number) " retrieve.asneeded=yes arguments=(("clie_grupo", number),("clie_empresa", number))  sort="terc_identificacion A terc_descripcion A " )
