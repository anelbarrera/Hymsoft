footer(height=0 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.count="0" gradient.repetition.length="100" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
detail(height=177 color="536870912" transparency="0" gradient.color="8421504" gradient.transparency="0" gradient.angle="0" brushmode="0" gradient.repetition.mode="0" gradient.repetition.count="0" gradient.repetition.length="100" gradient.focus="0" gradient.scale="100" gradient.spread="100" )
table(column=(type=char(100) updatewhereclause=yes name=dgapais_pais_descripcion dbname="dgapais.pais_descripcion" dbalias=".pais_descripcion" )
 column=(type=char(100) updatewhereclause=yes name=dgaregio_regi_descripcion dbname="dgaregio.regi_descripcion" dbalias=".regi_descripcion" )
 column=(type=decimal(0) updatewhereclause=yes name=dgmterce_terc_tercero dbname="dgmterce.terc_tercero" dbalias=".terc_tercero" )
 column=(type=char(20) updatewhereclause=yes name=dgmterce_terc_identificacion dbname="dgmterce.terc_identificacion" dbalias=".terc_identificacion" )
 column=(type=char(60) updatewhereclause=yes name=dgmterce_terc_descripcion dbname="dgmterce.terc_descripcion" dbalias=".terc_descripcion" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_pedido dbname="fatdiari.fact_no_pedido" dbalias=".fact_no_pedido" )
 column=(type=char(8) updatewhereclause=yes name=fact_no_factura dbname="fatdiari.fact_no_factura" dbalias=".fact_no_factura" )
 column=(type=decimal(0) updatewhereclause=yes name=fact_cliente dbname="fatdiari.fact_cliente" dbalias=".fact_cliente" )
 column=(type=datetime updatewhereclause=yes name=fact_fecha dbname="fatdiari.fact_fecha" dbalias=".fact_fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_peso_total dbname="fatdiari.fact_peso_total" dbalias=".fact_peso_total" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_gastos_total dbname="fatdiari.fact_gastos_total" dbalias=".fact_gastos_total" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_fact_total dbname="fatdiari.fact_monto_fact_total" dbalias=".fact_monto_fact_total" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_por_descuento dbname="fatdiari.fact_por_descuento" dbalias=".fact_por_descuento" )
 column=(type=decimal(4) updatewhereclause=yes name=fact_monto_final dbname="fatdiari.fact_monto_final" dbalias=".fact_monto_final" )
 column=(type=char(1) updatewhereclause=yes name=fatdiari_fact_estado dbname="fatdiari.fact_estado" dbalias=".fact_estado" )
 column=(type=char(100) updatewhereclause=yes name=dgmempre_empr_razon_social dbname="dgmempre.empr_razon_social" dbalias=".empr_razon_social" )
 column=(type=char(255) updatewhereclause=yes name=dgmempre_empr_icono dbname="dgmempre.empr_icono" dbalias=".empr_icono" )
 column=(type=char(120) updatewhereclause=yes name=dgmempre_empr_logo_t dbname="dgmempre.empr_logo_t" dbalias=".empr_logo_t" )
 column=(type=char(100) updatewhereclause=yes name=fact_a_nombre dbname="fatdiari.fact_a_nombre" dbalias=".fact_a_nombre" )
 column=(type=char(20) updatewhereclause=yes name=fact_ruc_cliente dbname="fatdiari.fact_ruc_cliente" dbalias=".fact_ruc_cliente" )
 column=(type=char(2) updatewhereclause=yes name=fatdiari_fact_condicion_pago dbname="fatdiari.fact_condicion_pago" dbalias=".fact_condicion_pago" )
 column=(type=char(1) updatewhereclause=yes name=fact_tipo_movimiento dbname="fatdiari.fact_tipo_movimiento" dbalias=".fact_tipo_movimiento" )
 column=(type=char(100) updatewhereclause=yes name=fact_despachado dbname="fatdiari.fact_despachado" dbalias=".fact_despachado" )
 column=(type=char(3) updatewhereclause=yes name=clie_tipo_factura dbname="clie_tipo_factura" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaregio~" )  TABLE(NAME=~"fatdiari~" )  TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"dgaregio.regi_descripcion~") COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatdiari.fact_no_pedido~") COLUMN(NAME=~"fatdiari.fact_no_factura~") COLUMN(NAME=~"fatdiari.fact_cliente~") COLUMN(NAME=~"fatdiari.fact_fecha~") COLUMN(NAME=~"fatdiari.fact_peso_total~") COLUMN(NAME=~"fatdiari.fact_gastos_total~") COLUMN(NAME=~"fatdiari.fact_monto_fact_total~") COLUMN(NAME=~"fatdiari.fact_por_descuento~") COLUMN(NAME=~"fatdiari.fact_monto_final~") COLUMN(NAME=~"fatdiari.fact_estado~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_icono~") COLUMN(NAME=~"dgmempre.empr_logo_t~") COLUMN(NAME=~"fatdiari.fact_a_nombre~") COLUMN(NAME=~"fatdiari.fact_ruc_cliente~") COLUMN(NAME=~"fatdiari.fact_condicion_pago~") COLUMN(NAME=~"fatdiari.fact_tipo_movimiento~") COLUMN(NAME=~"fatdiari.fact_despachado~") COMPUTE(NAME=~"( select c.clie_tipo_factura from ccmclien c where c.clie_g_financiero = fatdiari.fact_g_financiero and c.clie_empresa = fatdiari.fact_empresa and c.clie_tercero = fatdiari.fact_cliente ) as clie_tipo_factura~")    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"dgmempre.empr_g_financiero~"    OP =~"=~"RIGHT=~"fatdiari.fact_g_financiero~" )    JOIN (LEFT=~"dgmempre.empr_empresa~"    OP =~"=~"RIGHT=~"fatdiari.fact_empresa~" )    JOIN (LEFT=~"dgmterce.terc_region~"    OP =~"=~"RIGHT=~"dgaregio.regi_codigo_region~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgaregio.regi_pais~" )    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"fatdiari.fact_cliente~" )WHERE(    EXP1 =~"((fatdiari.fact_g_financiero~"   OP =~"=~"    EXP2 =~":grupo)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_empresa~"   OP =~"=~"    EXP2 =~":empresa)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~":fecha_desde)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatdiari.fact_fecha~"   OP =~"<~"    EXP2 =~"dateadd(dd,1,:fecha_hasta)))~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatdiari.fact_estado~"   OP =~"=~"    EXP2 =~":estado~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha_desde~" TYPE = date)  ARG(NAME = ~"fecha_hasta~" TYPE = date)  ARG(NAME = ~"estado~" TYPE = string) " arguments=(("grupo", number),("empresa", number),("fecha_desde", date),("fecha_hasta", date),("estado", string)) )
