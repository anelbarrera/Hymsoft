 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatpedid~" )  TABLE(NAME=~"faaparam~" ) COLUMN(NAME=~"fatpedid.pedi_no_pedido~") COLUMN(NAME=~"fatpedid.pedi_fecha~") COLUMN(NAME=~"fatpedid.pedi_monto_total~") COLUMN(NAME=~"fatpedid.pedi_ruc_cliente~") COLUMN(NAME=~"fatpedid.pedi_a_nombre~") COLUMN(NAME=~"faaparam.fara_logo~") COLUMN(NAME=~"fatpedid.pedi_g_financiero~") COLUMN(NAME=~"fatpedid.pedi_empresa~")    JOIN (LEFT=~"fatpedid.pedi_g_financiero~"    OP =~"=~"RIGHT=~"faaparam.fara_g_financiero~" )    JOIN (LEFT=~"fatpedid.pedi_empresa~"    OP =~"=~"RIGHT=~"faaparam.fara_empresa~" )WHERE(    EXP1 =~"fatpedid.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_fecha~"   OP =~">=~"    EXP2 =~":fecha1~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatpedid.pedi_fecha~"   OP =~"<=~"    EXP2 =~":fecha2~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"fatpedid.pedi_no_pedido~"   OP =~"not in~" NEST = PBSELECT( VERSION(400) TABLE(NAME=~"fatempaq~" ) COLUMN(NAME=~"fatempaq.enca_no_pedido~")WHERE(    EXP1 =~"fatempaq.enca_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatempaq.enca_empresa~"   OP =~"=~"    EXP2 =~":empresa~" ) )) ) ORDER(NAME=~"fatpedid.pedi_g_financiero~" ASC=yes )  ORDER(NAME=~"fatpedid.pedi_empresa~" ASC=yes )  ORDER(NAME=~"fatpedid.pedi_no_pedido~" ASC=yes ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha1~" TYPE = datetime)  ARG(NAME = ~"fecha2~" TYPE = datetime) " arguments=(("g_financiero", number),("empresa", number),("fecha1", datetime),("fecha2", datetime))  sort="pedi_fecha A " )
