//objectcomments Data Windows para el reporte de los Packing List pendientes de Factura
release 7;
datawindow(units=0 timer_interval=60000 color=1090519039 processing=0 HTMLDW=no print.documentname="" print.orientation = 2 print.margin.left = 110 print.margin.right = 55 print.margin.top = 97 print.margin.bottom = 97 print.paper.source = 0 print.paper.size = 1 print.prompt=no print.buttons=no print.preview.buttons=no )
header(height=740 color="536870912" )
summary(height=128 color="-1" )
footer(height=80 color="-1" )
detail(height=72 color="-1"  height.autosize=yes)
table(column=(type=decimal(0) updatewhereclause=yes name=terc_tercero dbname="dgmterce.terc_tercero" initial="0" )
 column=(type=char(20) updatewhereclause=yes name=terc_identificacion dbname="dgmterce.terc_identificacion" initial="spaces" )
 column=(type=char(60) updatewhereclause=yes name=terc_descripcion dbname="dgmterce.terc_descripcion" initial="spaces" )
 column=(type=char(100) updatewhereclause=yes name=dgmempre_empr_razon_social dbname="dgmempre.empr_razon_social" )
 column=(type=char(255) updatewhereclause=yes name=dgmempre_empr_icono dbname="dgmempre.empr_icono" )
 column=(type=char(120) updatewhereclause=yes name=dgmempre_empr_logo_f dbname="dgmempre.empr_logo_f" )
 column=(type=char(100) updatewhereclause=yes name=dgapais_pais_descripcion dbname="dgapais.pais_descripcion" )
 column=(type=char(100) updatewhereclause=yes name=dgaregio_regi_descripcion dbname="dgaregio.regi_descripcion" )
 column=(type=char(8) updatewhereclause=yes name=fatprofo_prof_no_proforma dbname="fatprofo.prof_no_proforma" )
 column=(type=decimal(0) updatewhereclause=yes name=fatprofo_prof_ann dbname="fatprofo.prof_ann" )
 column=(type=datetime updatewhereclause=yes name=fatprofo_prof_fecha dbname="fatprofo.prof_fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=fatprofo_prof_monto_final dbname="fatprofo.prof_monto_final" )
 column=(type=char(100) updatewhereclause=yes name=fatprofo_prof_a_nombre dbname="fatprofo.prof_a_nombre" )
 column=(type=char(2) updatewhereclause=yes name=fatprofo_prof_condicion_pago dbname="fatprofo.prof_condicion_pago" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"dgmempre~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaregio~" )  TABLE(NAME=~"fatprofo~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgmempre.empr_razon_social~") COLUMN(NAME=~"dgmempre.empr_icono~") COLUMN(NAME=~"dgmempre.empr_logo_f~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"dgaregio.regi_descripcion~") COLUMN(NAME=~"fatprofo.prof_no_proforma~") COLUMN(NAME=~"fatprofo.prof_ann~") COLUMN(NAME=~"fatprofo.prof_fecha~") COLUMN(NAME=~"fatprofo.prof_monto_final~") COLUMN(NAME=~"fatprofo.prof_a_nombre~") COLUMN(NAME=~"fatprofo.prof_condicion_pago~")    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"dgmterce.terc_pais~"    OP =~"=~"RIGHT=~"dgaregio.regi_pais~" )    JOIN (LEFT=~"dgmterce.terc_region~"    OP =~"=~"RIGHT=~"dgaregio.regi_codigo_region~" )    JOIN (LEFT=~"fatprofo.prof_g_financiero~"    OP =~"=~"RIGHT=~"dgmempre.empr_g_financiero~" )    JOIN (LEFT=~"fatprofo.prof_empresa~"    OP =~"=~"RIGHT=~"dgmempre.empr_empresa~" )    JOIN (LEFT=~"fatprofo.prof_cliente~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )WHERE(    EXP1 =~"( ( fatprofo.prof_g_financiero~"   OP =~"=~"    EXP2 =~":g_financiero )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"( fatprofo.prof_empresa~"   OP =~"=~"    EXP2 =~":empresa ) )~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatprofo.prof_fecha~"   OP =~">=~"    EXP2 =~":fecha)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"(fatprofo.prof_fecha~"   OP =~"<=~"    EXP2 =~":fecha_h)~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"fatprofo.prof_estado~"   OP =~"=~"    EXP2 =~"'A'~" ) ) ARG(NAME = ~"g_financiero~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"fecha~" TYPE = datetime)  ARG(NAME = ~"fecha_h~" TYPE = datetime) " arguments=(("g_financiero", number),("empresa", number),("fecha", datetime),("fecha_h", datetime))  sort="dias_pendientes D fatprofo_prof_no_proforma A fatprofo_prof_ann A " )
