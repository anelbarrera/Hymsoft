detail(height=68 color="536870912" )
table(column=(type=char(1) updatewhereclause=yes name=fatprofo_prof_estado dbname="fatprofo.prof_estado" values="ACTIVA	A/ELIMINADA	E/PASADA A PEDIDOS	P/PARCIALMENTE A PEDIDOS	R/" )
 column=(type=char(8) updatewhereclause=yes name=fatprofo_prof_no_proforma dbname="fatprofo.prof_no_proforma" )
 column=(type=char(3) updatewhereclause=yes name=fatprofo_prof_tipo dbname="fatprofo.prof_tipo" )
