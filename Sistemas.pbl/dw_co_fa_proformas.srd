 column=(type=datetime updatewhereclause=yes name=fatprofo_prof_fecha dbname="fatprofo.prof_fecha" initial="today" )
 column=(type=char(100) updatewhereclause=yes name=fatprofo_prof_a_nombre dbname="fatprofo.prof_a_nombre" )
 column=(type=decimal(0) updatewhereclause=yes name=fatprofo_prof_ann dbname="fatprofo.prof_ann" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"fatprofo~" )  TABLE(NAME=~"dgmterce~" ) COLUMN(NAME=~"fatprofo.prof_estado~") COLUMN(NAME=~"fatprofo.prof_no_proforma~") COLUMN(NAME=~"fatprofo.prof_tipo~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"fatprofo.prof_ruc_cliente~") COLUMN(NAME=~"fatprofo.prof_condicion_pago~") COLUMN(NAME=~"fatprofo.prof_fecha~") COLUMN(NAME=~"fatprofo.prof_a_nombre~") COLUMN(NAME=~"fatprofo.prof_ann~")    JOIN (LEFT=~"dgmterce.terc_tercero~"    OP =~"=~"RIGHT=~"fatprofo.prof_cliente~" )) " sort="real(fatprofo_prof_no_proforma) A fatprofo_prof_ann A " )
