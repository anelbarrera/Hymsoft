 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pedidos~" ) COLUMN(NAME=~"pedidos.pedi_g_financiero~") COLUMN(NAME=~"pedidos.pedi_empresa~") COLUMN(NAME=~"pedidos.pedi_no_pedido~") COLUMN(NAME=~"pedidos.pedi_ann~") COLUMN(NAME=~"pedidos.pedi_cliente~") COLUMN(NAME=~"pedidos.pedi_a_nombre_de~") COLUMN(NAME=~"pedidos.pedi_fecha~") COLUMN(NAME=~"pedidos.pedi_tipo_venta~") COLUMN(NAME=~"pedidos.pedi_estado~") COLUMN(NAME=~"pedidos.pedi_comentario~") COLUMN(NAME=~"pedidos.pedi_peso_total~") COLUMN(NAME=~"pedidos.pedi_cubicaje_total~") COLUMN(NAME=~"pedidos.pedi_bultos_total~") COLUMN(NAME=~"pedidos.pedi_monto_final~") COLUMN(NAME=~"pedidos.pedi_tipo~")WHERE(    EXP1 =~"pedidos.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"pedidos.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"pedidos.pedi_no_pedido~"   OP =~"=~"    EXP2 =~":pedido~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"pedidos.pedi_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="pedidos" updatewhere=1 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("pedido", string),("ann", number)) )
