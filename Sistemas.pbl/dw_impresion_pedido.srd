 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"productos~" )  TABLE(NAME=~"unidades~" )  TABLE(NAME=~"pedidos~" )  TABLE(NAME=~"pedidos_detalle~" )  TABLE(NAME=~"clientes~" ) COLUMN(NAME=~"unidades.medi_descripcion~") COLUMN(NAME=~"productos.prod_descripcion~") COLUMN(NAME=~"pedidos.pedi_cliente~") COLUMN(NAME=~"pedidos.pedi_a_nombre_de~") COLUMN(NAME=~"pedidos.pedi_fecha~") COLUMN(NAME=~"pedidos.pedi_tipo_venta~") COLUMN(NAME=~"pedidos.pedi_estado~") COLUMN(NAME=~"pedidos.pedi_no_pedido~") COLUMN(NAME=~"pedidos.pedi_ann~") COLUMN(NAME=~"pedidos.pedi_comentario~") COLUMN(NAME=~"pedidos_detalle.dped_producto~") COLUMN(NAME=~"pedidos_detalle.dped_descripcion~") COLUMN(NAME=~"pedidos_detalle.dped_precio~") COLUMN(NAME=~"pedidos_detalle.dped_cantidad~") COLUMN(NAME=~"pedidos_detalle.dped_monto~") COLUMN(NAME=~"pedidos_detalle.dped_bultos~") COLUMN(NAME=~"pedidos_detalle.dped_peso~") COLUMN(NAME=~"pedidos_detalle.dped_cubicaje~") COLUMN(NAME=~"clientes.clie_direccion~") COLUMN(NAME=~"clientes.clie_email~") COLUMN(NAME=~"clientes.clie_telefono~") COLUMN(NAME=~"pedidos_detalle.dped_linea~") COLUMN(NAME=~"pedidos.pedi_tipo~")    JOIN (LEFT=~"unidades.medi_unidad~"    OP =~"=~"RIGHT=~"productos.prod_unidad~" )    JOIN (LEFT=~"pedidos_detalle.dped_g_financiero~"    OP =~"=~"RIGHT=~"pedidos.pedi_g_financiero~" )    JOIN (LEFT=~"pedidos_detalle.dped_empresa~"    OP =~"=~"RIGHT=~"pedidos.pedi_empresa~" )    JOIN (LEFT=~"pedidos_detalle.dped_no_pedido~"    OP =~"=~"RIGHT=~"pedidos.pedi_no_pedido~" )    JOIN (LEFT=~"pedidos_detalle.dped_ann~"    OP =~"=~"RIGHT=~"pedidos.pedi_ann~" )    JOIN (LEFT=~"pedidos_detalle.dped_g_financiero~"    OP =~"=~"RIGHT=~"productos.prod_g_financiero~" )    JOIN (LEFT=~"pedidos_detalle.dped_empresa~"    OP =~"=~"RIGHT=~"productos.prod_empresa~" )    JOIN (LEFT=~"pedidos_detalle.dped_producto~"    OP =~"=~"RIGHT=~"productos.prod_producto~" )    JOIN (LEFT=~"clientes.clie_codigo~"    OP =~"=~"RIGHT=~"pedidos.pedi_cliente~" )WHERE(    EXP1 =~"pedidos.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"pedidos.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"pedidos.pedi_no_pedido~"   OP =~"=~"    EXP2 =~":secuencia~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"pedidos.pedi_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"secuencia~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("secuencia", string),("ann", number))  sort="pedidos_detalle_dped_linea A " )
