 column=(type=decimal(4) updatewhereclause=yes name=ccmclien_clie_saldo_moroso dbname="ccmclien.clie_saldo_moroso" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"dgmterce~" )  TABLE(NAME=~"dgapais~" )  TABLE(NAME=~"dgaregio~" )  TABLE(NAME=~"ccmclien~" ) COLUMN(NAME=~"dgmterce.terc_tercero~") COLUMN(NAME=~"dgmterce.terc_identificacion~") COLUMN(NAME=~"dgmterce.terc_descripcion~") COLUMN(NAME=~"dgaregio.regi_descripcion~") COLUMN(NAME=~"dgapais.pais_descripcion~") COLUMN(NAME=~"ccmclien.clie_limite_credito~") COLUMN(NAME=~"ccmclien.clie_saldo_actual~") COLUMN(NAME=~"ccmclien.clie_saldo_moroso~")    JOIN (LEFT=~"dgaregio.regi_codigo_region~"    OP =~"=~"RIGHT=~"dgmterce.terc_region~" )    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgmterce.terc_pais~" )    JOIN (LEFT=~"dgaregio.regi_pais~"    OP =~"=~"RIGHT=~"dgapais.pais_pais~" )    JOIN (LEFT=~"ccmclien.clie_tercero~"    OP =~"=~"RIGHT=~"dgmterce.terc_tercero~" )    JOIN (LEFT=~"dgmterce.terc_identificacion~"    OP =~"=~"RIGHT=~"ccmclien.clie_ruc_tercero~" )WHERE(    EXP1 =~"ccmclien.clie_g_financiero~"   OP =~"=~"    EXP2 =~":cli_grupo ~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"ccmclien.clie_empresa~"   OP =~"=~"    EXP2 =~":cli_empresa ~" ) ) ARG(NAME = ~"cli_grupo~" TYPE = number)  ARG(NAME = ~"cli_empresa~" TYPE = number) "  arguments=(("cli_grupo", number),("cli_empresa", number)) )
