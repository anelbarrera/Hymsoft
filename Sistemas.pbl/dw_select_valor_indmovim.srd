table(column=(type=decimal(0) updatewhereclause=yes name=tmov_anual dbname="intmovim.tmov_anual" dbalias=".tmov_anual" )
 column=(type=char(30) updatewhereclause=yes name=tmov_descripcion dbname="intmovim.tmov_descripcion" dbalias=".tmov_descripcion" )
 column=(type=datetime updatewhereclause=yes name=tmov_fecha dbname="intmovim.tmov_fecha" dbalias=".tmov_fecha" )
 column=(type=char(18) updatewhereclause=yes name=tmov_documento dbname="intmovim.tmov_documento" dbalias=".tmov_documento" )
 column=(type=decimal(14) updatewhereclause=yes name=valor dbname="valor" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"intmovim~" ) COLUMN(NAME=~"intmovim.tmov_anual~") COLUMN(NAME=~"intmovim.tmov_descripcion~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"intmovim.tmov_documento~") COMPUTE(NAME=~"valor = (  SELECT round(sum(dmov_cantidad * dmov_costo_fob),2)  FROM indmovim  WHERE ( intmovim.tmov_g_financiero = indmovim.dmov_g_financiero ) and ( intmovim.tmov_empresa = indmovim.dmov_empresa ) and ( intmovim.tmov_aplicacion = indmovim.dmov_aplicacion ) and  ( intmovim.tmov_tipo_transaccion = indmovim.dmov_tipo_transaccion ) and  ( intmovim.tmov_secuencia = indmovim.dmov_secuencia ) and  ( intmovim.tmov_anual = indmovim.dmov_anual ) and   ( intmovim.tmov_concepto = indmovim.dmov_concepto )    )~")WHERE(    EXP1 =~"intmovim.tmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN'~" ) ) " )
