event clicked;OLEObject ole_object 
Integer li_rc 
String ls_ruta 

  SELECT isnull(dgmempre.empr_ruta_de_manual,'')  
    INTO :ls_ruta  
    FROM dgmempre  
   WHERE ( dgmempre.empr_g_financiero = :str.g_financiero ) AND  
         ( dgmempre.empr_empresa = :str.empresa )   ;
	if sqlca.sqlcode = -1 then
		gf_mensaje('','Error al buscar ruta '+sqlca.sqlerrtext,1,1,'E')
	end if

if fileexists(ls_ruta) then
	
else
	//ls_ruta = " C:\Sistemas\Documentos\hymsoft.pdf" 
	gf_mensaje('','Ubique la ruta del manual, Verifique !!!',1,1,'E')
	return
end if

ls_ruta = " "+ls_ruta

ole_object = CREATE OleObject 
li_rc = ole_object.ConnectToNewObject( "WScript.Shell" ) 

IF li_rc<>0 THEN 
DESTROY ole_object 
MessageBox("Error", "No puede conectarse a Acrobat ") 
RETURN 
END IF 

ole_object.run("AcroRd32"+ls_ruta) //, Maximized!) 

end event

type m_prueba from menu within m_ayuda
end type

event clicked;//parentwindow.SetRedraw ( false )
//OpenSheet(aa_borrar_importacion,parentwindow, 9,Original! )
//OpenSheet(w_subir_saldos_clientes,parentwindow, 9,Original! )
//parentwindow.SetRedraw ( True )


string ls_error, ls_prod
long i
 sqlca.autocommit = true 
 
	 //Sql que actualiza las cantidades existentes del maestro de producto
yield()
	 str.frame.setmicrohelp("Eliminando Tabla Temporal de las Existencias de los Productos .............por favor Espere")		
yield()		

delete from incantidades
where cant_g_financiero = :str.g_financiero and
		 cant_empresa = :str.empresa;
			if sqlca.sqlcode = -1 then
				gf_mensaje('','Error al Eliminar en tabla temporal  '+ sqlca.sqlerrtext,1,1,'E')
				return
			end if

	 str.frame.setmicrohelp("Recuperando las Existencias de los Productos .............por favor Espere")		
	 
  INSERT INTO incantidades  
         ( cant_g_financiero,   
           cant_empresa,   
           cant_producto,   
		  cant_bodega,
           cant_cantidad )  
	select  max(inmprodu.prod_g_financiero),
			 max(inmprodu.prod_empresa),
			 inmprodu.prod_producto,
			 dmov_bodega,
			 sum((case intmovim.tmov_tipo when 'D' then 1 else - 1 end ) * round((((indmovim.dmov_cantidad * inamedid.medi_cantidad ) + isnull(indmovim.dmov_cant1,0))),2))
			 FROM indmovim,
					intmovim,
					inamedid,
					inmprodu
			WHERE ( intmovim.tmov_g_financiero = indmovim.dmov_g_financiero ) and
					( intmovim.tmov_empresa = indmovim.dmov_empresa ) and
					( intmovim.tmov_aplicacion = indmovim.dmov_aplicacion ) and
					( intmovim.tmov_tipo_transaccion = indmovim.dmov_tipo_transaccion ) and
					( intmovim.tmov_secuencia = indmovim.dmov_secuencia ) and
					( intmovim.tmov_anual = indmovim.dmov_anual ) and
					( intmovim.tmov_concepto = indmovim.dmov_concepto ) and		
					( inamedid.medi_medida = indmovim.dmov_unidad_medida ) and
					( indmovim.dmov_g_financiero = inmprodu.prod_g_financiero ) and
					( indmovim.dmov_empresa = inmprodu.prod_empresa ) and	
					( inmprodu.prod_g_financiero = :str.g_financiero ) and (inmprodu.prod_empresa = :str.empresa) and 
					( indmovim.dmov_producto = inmprodu.prod_producto )	 group by prod_producto, dmov_bodega;
			if sqlca.sqlcode = -1 then
				gf_mensaje('','Error al insertar en tabla temporal  '+ sqlca.sqlerrtext,1,1,'E')
				return
			end if

//Update existencia_total
	str.frame.setmicrohelp("Actualizando las Existencia Total de los Productos .............por favor Espere")	
update inmprodu
set     inmprodu.prod_existencia_total = 
	isnull(( select sum( incantidades.cant_cantidad)   
    FROM incantidades
   WHERE ( inmprodu.prod_g_financiero = incantidades.cant_g_financiero ) and  
         ( inmprodu.prod_empresa = incantidades.cant_empresa ) and  
         ( inmprodu.prod_producto = incantidades.cant_producto ) and  
         ( ( incantidades.cant_g_financiero = :str.g_financiero ) AND  
         ( incantidades.cant_empresa = :str.empresa ) ) ),0)
Where inmprodu.prod_g_financiero = :str.g_financiero and
		 inmprodu.prod_empresa = :str.empresa ;     

			if sqlca.sqlcode = -1 then
				gf_mensaje('','Error al Actualizar Existencia Total  '+ sqlca.sqlerrtext,1,1,'E')
				return
			end if

