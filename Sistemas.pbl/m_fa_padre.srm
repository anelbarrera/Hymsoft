on m_prueba.create
call super::create
this.text = "Actualiza"
this.menustyle = contemporarymenu!
this.menutextcolor = 134217735
this.menubackcolor = 134217732
this.menuhighlightcolor = 8388608
this.textsize = 8
this.weight = 400
this.facename = "Tahoma"
this.titlebackcolor = 134217730
this.bitmapbackcolor = 12632256
this.menubitmaps = true
this.titlegradient = true
this.toolbarstyle = contemporarytoolbar!
this.toolbartextcolor = 134217746
this.toolbarbackcolor = 15780518
this.toolbarhighlightcolor = 8388608
this.toolbargradient = true
this.bitmapgradient = true
end on

on m_prueba.destroy
call super::destroy
end on

type m_reserva0 from menu within m_ayuda
end type

event clicked;string ls_error
sqlca.autocommit = true

 str.frame.setmicrohelp("Actualizando las Reservas de los Productos .............por favor Espere")		
yield()

 UPDATE inmprodu  
     SET prod_reserva_total = 
			ISNULL( ( 
 			  SELECT sum(fadpedid.dped_cantidad * inamedid.medi_cantidad + 
                  fadpedid.dped_fraccion - dped_pasada) 
			  FROM fadpedid,inamedid
			  WHERE ( fadpedid.dped_unidad_venta = inamedid.medi_medida ) and
			        ( fadpedid.dped_g_financiero = inmprodu.prod_g_financiero  ) and  
         		  ( fadpedid.dped_empresa = inmprodu.prod_empresa ) and  
			        ( fadpedid.dped_codigo_item = inmprodu.prod_producto) and
			        ( fadpedid.dped_reserva_origen = 'E')),0) + 
			isnull( (
			  SELECT  sum(faddiari.facd_cantidad * inamedid.medi_cantidad + 
			  			 faddiari.facd_cantidad_fraccion ) 
		     FROM faddiari,
       			 inamedid,
			       fatdiari
			  WHERE ( faddiari.facd_unidad_venta = inamedid.medi_medida ) and
					  ( faddiari.facd_g_financiero = inmprodu.prod_g_financiero  ) and  
			        ( faddiari.facd_empresa = inmprodu.prod_empresa ) and  
					  ( faddiari.facd_codigo_item = inmprodu.prod_producto) and
		           ( fatdiari.fact_g_financiero = faddiari.facd_g_financiero ) and
	              ( fatdiari.fact_empresa = faddiari.facd_empresa ) and
			        ( fatdiari.fact_tipo = faddiari.facd_tipo ) and
	              ( fatdiari.fact_no_pedido = faddiari.facd_no_pedido ) and
			        ( fatdiari.fact_ann = faddiari.facd_ann ) and
			        ( fatdiari.fact_estado = 'A' ))
          ,0)					  
    FROM inmprodu
   WHERE ( inmprodu.prod_g_financiero = :str.g_financiero) and
			( inmprodu.prod_empresa = :str.empresa) ;

			  if sqlca.sqlcode = -1 then
				ls_error = sqlca.sqlerrtext
				rollback;
				mensaje("Aviso","Error al Actualizar las Reservas de los Productos ",ls_error)
				sqlca.autocommit = true
				return
			  end if

commit;
yield()
 str.frame.setmicrohelp("Actualizando las Reservas 1 de los Productos .............por favor Espere")		
 
 UPDATE inmprodu  
     SET prod_reserva1 = 
			ISNULL( ( 
 			  SELECT sum( case when dped_bodega = '1' then fadpedid.dped_cantidad * inamedid.medi_cantidad + 
                  fadpedid.dped_fraccion - dped_pasada end) 
			  FROM fadpedid,inamedid
			  WHERE ( fadpedid.dped_unidad_venta = inamedid.medi_medida ) and
			        ( fadpedid.dped_g_financiero = inmprodu.prod_g_financiero  ) and  
         		  ( fadpedid.dped_empresa = inmprodu.prod_empresa ) and  
			        ( fadpedid.dped_codigo_item = inmprodu.prod_producto) and
			        ( fadpedid.dped_reserva_origen = 'E')),0) + 
			isnull( (
			  SELECT  sum( case when facd_bodega = '1' then faddiari.facd_cantidad * inamedid.medi_cantidad + 
			  			 faddiari.facd_cantidad_fraccion end ) 
		     FROM faddiari,
       			 inamedid,
			       fatdiari
			  WHERE ( faddiari.facd_unidad_venta = inamedid.medi_medida ) and
					  ( faddiari.facd_g_financiero = inmprodu.prod_g_financiero  ) and  
			        ( faddiari.facd_empresa = inmprodu.prod_empresa ) and  
					  ( faddiari.facd_codigo_item = inmprodu.prod_producto) and
		           ( fatdiari.fact_g_financiero = faddiari.facd_g_financiero ) and
	              ( fatdiari.fact_empresa = faddiari.facd_empresa ) and
			        ( fatdiari.fact_tipo = faddiari.facd_tipo ) and
