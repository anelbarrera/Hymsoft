event clicked; str.frame.setmicrohelp("Actualizando las Cantidades de las Ordenes .............por favor Espere")		
 
update inmprodu set prod_cant_confirma = 
 ( SELECT isnull(sum(convert(numeric(17,0), orden_detalle.deta_cantidad * inamedid.medi_cantidad) ),0) 
    FROM orden,   
         orden_detalle,   
         inamedid  
   WHERE ( orden_detalle.deta_g_financiero = orden.enca_g_financiero ) and  
         ( orden_detalle.deta_empresa = orden.enca_empresa ) and  
         ( orden_detalle.deta_secuencia = orden.enca_secuencia ) and  
         ( orden_detalle.deta_ann = orden.enca_ann ) and  
         ( orden_detalle.deta_unidad = inamedid.medi_medida ) and  
         ( ( orden.enca_g_financiero = :str.g_financiero ) AND  
         ( orden.enca_empresa = :str.empresa ) AND  
         ( (orden_detalle.deta_cantidad * medi_cantidad ) - isnull(orden_detalle.deta_pasada,0) > 0 ) AND  
         ( orden.enca_tipo = 0 ) ) and 
		( orden_detalle.deta_g_financiero = inmprodu.prod_g_financiero  and orden_detalle.deta_empresa = inmprodu.prod_empresa  and orden_detalle.deta_referencia = inmprodu.prod_producto) 
		 )
  from inmprodu
where prod_g_financiero = :str.g_financiero and prod_empresa = :str.empresa and prod_status = 1;
if sqlca.sqlcode = -1 then
	gf_mensaje('','Error al Actualizar Cantidades de las Ordenes '+sqlca.sqlerrtext,1,1,'E')
	 str.frame.setmicrohelp("")
	 return
end if

 str.frame.setmicrohelp("Ordenes Actualizadas")		
end event

type m_actualizatransitos from menu within m_ayuda
end type

event clicked; str.frame.setmicrohelp("Actualizando las Cantidades de las Facturas del Proveedor .............por favor Espere")		
 
update inmprodu set prod_cant_transito = 
 ( SELECT isnull(sum(convert(numeric(17,0), transito_detalle.deta_cantidad * inamedid.medi_cantidad) ),0) 
    FROM transito,   
         transito_detalle,   
         inamedid  
   WHERE ( transito_detalle.deta_g_financiero = transito.enca_g_financiero ) and  
         ( transito_detalle.deta_empresa = transito.enca_empresa ) and  
         ( transito_detalle.deta_secuencia = transito.enca_secuencia ) and  
         ( transito_detalle.deta_ann = transito.enca_ann ) and  
         ( transito_detalle.deta_unidad = inamedid.medi_medida ) and  
         ( ( transito.enca_g_financiero = :str.g_financiero ) AND  
         ( transito.enca_empresa = :str.empresa ) AND  
         ( (transito_detalle.deta_cantidad * medi_cantidad ) - isnull(transito_detalle.deta_pasada,0) > 0 ) AND  
         ( transito.enca_tipo = 0 ) ) and 
		( transito_detalle.deta_g_financiero = inmprodu.prod_g_financiero  and transito_detalle.deta_empresa = inmprodu.prod_empresa  and transito_detalle.deta_referencia = inmprodu.prod_producto) 
		 )
  from inmprodu
where prod_g_financiero = :str.g_financiero and prod_empresa = :str.empresa and prod_status = 1;
if sqlca.sqlcode = -1 then
	gf_mensaje('','Error al Actualizar Cantidades de los Transitos '+sqlca.sqlerrtext,1,1,'E')
	 str.frame.setmicrohelp("")
	 return
end if

 str.frame.setmicrohelp("Transitos Actualizados")		
end event

