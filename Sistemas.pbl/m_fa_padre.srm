//ACTUALIZAR EXISTENCIAS EN TRANSITO
delete from incantidadesoc
where cant_g_financiero = :str.g_financiero and
		 cant_empresa = :str.empresa;
			if sqlca.sqlcode = -1 then
				gf_mensaje('','Error al Eliminar en tabla temporal  '+ sqlca.sqlerrtext,1,1,'E')
				return
			end if

	 str.frame.setmicrohelp("Recuperando las Existencias de los Productos OC .............por favor Espere")		

	   INSERT INTO incantidadesoc  
         ( cant_g_financiero,   
           cant_empresa,   
           cant_producto,   
           cant_cantidad )  
  SELECT max(orden_detalle.deta_g_financiero),
  			max(orden_detalle.deta_empresa),
			orden_detalle.deta_referencia,	
			sum(orden_detalle.deta_cantidad * inamedid.medi_cantidad - isnull(orden_detalle.deta_pasada,0) )  
    FROM inamedid,   
         orden,   
         orden_detalle  
   WHERE ( orden_detalle.deta_g_financiero = orden.enca_g_financiero ) and  
         ( orden_detalle.deta_empresa = orden.enca_empresa ) and  
         ( orden_detalle.deta_secuencia = orden.enca_secuencia ) and  
         ( orden_detalle.deta_ann = orden.enca_ann ) and  
         ( orden_detalle.deta_unidad = inamedid.medi_medida ) and  
         ( ( orden.enca_g_financiero = :str.g_financiero ) AND  
         ( orden.enca_empresa = :str.empresa ) AND  
         ( orden.enca_estado = 'E' ) AND  
         ( isnull(orden_detalle.deta_pasada,0) < orden_detalle.deta_cantidad * inamedid.medi_cantidad ) AND  
         ( orden.enca_tipo <> 2 ) )   
	GROUP BY orden_detalle.deta_referencia   ;
			if sqlca.sqlcode = -1 then
				gf_mensaje('','Error al Actualizar Existencia en Tabla de OCs '+ sqlca.sqlerrtext,1,1,'E')
				return
			end if

