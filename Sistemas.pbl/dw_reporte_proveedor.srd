 column=(type=char(150) updatewhereclause=yes name=pedidos_pedi_a_nombre_de dbname="pedidos.pedi_a_nombre_de" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"productos~" )  TABLE(NAME=~"unidades~" )  TABLE(NAME=~"proveedores~" )  TABLE(NAME=~"pedidos~" )  TABLE(NAME=~"pedidos_detalle~" ) COLUMN(NAME=~"unidades.medi_descripcion~") COLUMN(NAME=~"productos.prod_descripcion~") COLUMN(NAME=~"proveedores.prov_descripcion~") COLUMN(NAME=~"proveedores.prov_direccion~") COLUMN(NAME=~"pedidos_detalle.dped_producto~") COLUMN(NAME=~"pedidos_detalle.dped_cantidad~") COLUMN(NAME=~"pedidos.pedi_tipo~") COLUMN(NAME=~"pedidos.pedi_a_nombre_de~")    JOIN (LEFT=~"unidades.medi_unidad~"    OP =~"=~"RIGHT=~"productos.prod_unidad~" )    JOIN (LEFT=~"pedidos_detalle.dped_g_financiero~"    OP =~"=~"RIGHT=~"pedidos.pedi_g_financiero~" )    JOIN (LEFT=~"pedidos_detalle.dped_empresa~"    OP =~"=~"RIGHT=~"pedidos.pedi_empresa~" )    JOIN (LEFT=~"pedidos_detalle.dped_no_pedido~"    OP =~"=~"RIGHT=~"pedidos.pedi_no_pedido~" )    JOIN (LEFT=~"pedidos_detalle.dped_ann~"    OP =~"=~"RIGHT=~"pedidos.pedi_ann~" )    JOIN (LEFT=~"pedidos_detalle.dped_g_financiero~"    OP =~"=~"RIGHT=~"productos.prod_g_financiero~" )    JOIN (LEFT=~"pedidos_detalle.dped_empresa~"    OP =~"=~"RIGHT=~"productos.prod_empresa~" )    JOIN (LEFT=~"pedidos_detalle.dped_producto~"    OP =~"=~"RIGHT=~"productos.prod_producto~" )    JOIN (LEFT=~"productos.prod_proveedor~"    OP =~"=~"RIGHT=~"proveedores.prov_codigo~" )WHERE(    EXP1 =~"pedidos.pedi_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"pedidos.pedi_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"productos.prod_proveedor~"   OP =~"=~"    EXP2 =~":proveedor~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"proveedor~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("proveedor", number))  sort="pedidos_pedi_tipo A pedidos_detalle_dped_producto A " )
