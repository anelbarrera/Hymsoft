 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coddiari~" ) COLUMN(NAME=~"coddiari.ddia_g_financiero~") COLUMN(NAME=~"coddiari.ddia_empresa~") COLUMN(NAME=~"coddiari.ddia_aplicacion_mg~") COLUMN(NAME=~"coddiari.ddia_tipo_transaccion~") COLUMN(NAME=~"coddiari.ddia_sub_trans~") COLUMN(NAME=~"coddiari.ddia_no_documento~") COLUMN(NAME=~"coddiari.ddia_no_referencia~") COLUMN(NAME=~"coddiari.ddia_banco_cuenta~") COLUMN(NAME=~"coddiari.ddia_ann~") COLUMN(NAME=~"coddiari.ddia_linea~") COLUMN(NAME=~"coddiari.ddia_mg_cuenta~") COLUMN(NAME=~"coddiari.ddia_monto~") COLUMN(NAME=~"coddiari.ddia_naturaleza~") COLUMN(NAME=~"coddiari.ddia_id~") COLUMN(NAME=~"coddiari.ddia_fecha~") COLUMN(NAME=~"coddiari.ddia_tercero~") COLUMN(NAME=~"coddiari.ddia_centro_costo~") COLUMN(NAME=~"coddiari.ddia_documento_anexo~") COLUMN(NAME=~"coddiari.ddia_tipo~") COLUMN(NAME=~"coddiari.ddia_transito~") COLUMN(NAME=~"coddiari.ddia_cargado_a~") COLUMN(NAME=~"coddiari.ddia_class~") COLUMN(NAME=~"coddiari.ddia_comentario_detalle~") COLUMN(NAME=~"coddiari.ddia_codigo_cte_prov~") COLUMN(NAME=~"coddiari.ddia_sucursal~") COLUMN(NAME=~"coddiari.ddia_cuenta_anterior~")WHERE(    EXP1 =~"coddiari.ddia_tipo_transaccion+coddiari.ddia_sub_trans+coddiari.ddia_no_documento+coddiari.ddia_no_referencia+coddiari.ddia_banco_cuenta+convert(varchar(4),coddiari.ddia_ann)~"   OP =~"not in~" NEST = PBSELECT( VERSION(400) TABLE(NAME=~"cotdiari~" ) COMPUTE(NAME=~"cotdiari.diar_tipo_transaccion+cotdiari.diar_sub_trans+cotdiari.diar_no_documento+cotdiari.diar_no_referencia+cotdiari.diar_banco_cuenta+convert(varchar(4),cotdiari.diar_ann)~"))) ) " update="coddiari" updatewhere=1 updatekeyinplace=no )
