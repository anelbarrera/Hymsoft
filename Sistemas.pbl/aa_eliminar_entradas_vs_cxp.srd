table(column=(type=char(20) updatewhereclause=yes name=cptmovim_movi_documento dbname="cptmovim.movi_documento" dbalias=".movi_documento" )
 column=(type=char(18) updatewhereclause=yes name=intmovim_tmov_documento dbname="intmovim.tmov_documento" dbalias=".tmov_documento" )
 column=(type=char(8) updatewhereclause=yes name=cptmovim_movi_referencia dbname="cptmovim.movi_referencia" dbalias=".movi_referencia" )
 column=(type=char(15) updatewhereclause=yes name=cptmovim_movi_entrada dbname="cptmovim.movi_entrada" dbalias=".movi_entrada" )
 column=(type=char(15) updatewhereclause=yes name=intmovim_tmov_documento_entrada dbname="intmovim.tmov_documento_entrada" dbalias=".tmov_documento_entrada" )
 column=(type=datetime updatewhereclause=yes name=cptmovim_movi_fecha_tran dbname="cptmovim.movi_fecha_tran" dbalias=".movi_fecha_tran" )
 column=(type=datetime updatewhereclause=yes name=intmovim_tmov_fecha dbname="intmovim.tmov_fecha" dbalias=".tmov_fecha" )
 column=(type=decimal(4) updatewhereclause=yes name=movi_monto dbname="cptmovim.movi_monto" dbalias=".movi_monto" )
 column=(type=decimal(14) updatewhereclause=yes name=valor dbname="valor" )
 column=(type=decimal(0) updatewhereclause=yes name=cptmovim_movi_empresa dbname="cptmovim.movi_empresa" dbalias=".movi_empresa" )
 column=(type=decimal(4) updatewhereclause=yes name=intmovim_tmov_total_cargos_final dbname="tmov_total_cargos_final" )
 column=(type=decimal(14) updatewhereclause=yes name=valor2 dbname="valor2" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cptmovim~" )  TABLE(NAME=~"intmovim~" ) COLUMN(NAME=~"cptmovim.movi_documento~") COLUMN(NAME=~"intmovim.tmov_documento~") COLUMN(NAME=~"cptmovim.movi_referencia~") COLUMN(NAME=~"cptmovim.movi_entrada~") COLUMN(NAME=~"intmovim.tmov_documento_entrada~") COLUMN(NAME=~"cptmovim.movi_fecha_tran~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"cptmovim.movi_monto~") COMPUTE(NAME=~"valor = (   SELECT sum(round(dmov_cantidad * dmov_costo_fob,2))  FROM indmovim  WHERE ( intmovim.tmov_g_financiero = indmovim.dmov_g_financiero ) and  ( intmovim.tmov_empresa = indmovim.dmov_empresa ) and  ( intmovim.tmov_aplicacion = indmovim.dmov_aplicacion ) and  ( intmovim.tmov_tipo_transaccion = indmovim.dmov_tipo_transaccion ) and  ( intmovim.tmov_secuencia = indmovim.dmov_secuencia ) and  ( intmovim.tmov_anual = indmovim.dmov_anual ) and  ( intmovim.tmov_concepto = indmovim.dmov_concepto ) and  ( indmovim.dmov_tipo_transaccion = 'EN' ) )~") COLUMN(NAME=~"cptmovim.movi_empresa~") COMPUTE(NAME=~"isnull(tmov_total_cargos_final,0) as tmov_total_cargos_final~") COMPUTE(NAME=~"valor2 = isnull(tmov_total_cargos_final,0) +  (   SELECT sum(round(dmov_cantidad * dmov_costo_fob,2))  FROM indmovim  WHERE ( intmovim.tmov_g_financiero = indmovim.dmov_g_financiero ) and  ( intmovim.tmov_empresa = indmovim.dmov_empresa ) and  ( intmovim.tmov_aplicacion = indmovim.dmov_aplicacion ) and  ( intmovim.tmov_tipo_transaccion = indmovim.dmov_tipo_transaccion ) and  ( intmovim.tmov_secuencia = indmovim.dmov_secuencia ) and  ( intmovim.tmov_anual = indmovim.dmov_anual ) and  ( intmovim.tmov_concepto = indmovim.dmov_concepto ) and  ( indmovim.dmov_tipo_transaccion = 'EN' ) )~")    JOIN (LEFT=~"cptmovim.movi_g_financiero~"    OP =~"=~"RIGHT=~"intmovim.tmov_g_financiero~" )    JOIN (LEFT=~"cptmovim.movi_empresa~"    OP =~"=~"RIGHT=~"intmovim.tmov_empresa~" )    JOIN (LEFT=~"intmovim.tmov_documento~"    OP =~"=~"RIGHT=~"cptmovim.movi_documento~" )    JOIN (LEFT=~"cptmovim.movi_anno~"    OP =~"=~"RIGHT=~"intmovim.tmov_anual~" )WHERE(    EXP1 =~"cptmovim.movi_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'FF'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"intmovim.tmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN'~" ) ) "  sort="intmovim_tmov_fecha A " )
