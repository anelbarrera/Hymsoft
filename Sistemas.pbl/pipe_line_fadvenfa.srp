PIPELINE(source_connect=FOSTER,destination_connect=FOSTER,type=update,commit=100,errors=100,keyname="aaa_fadvenfa")
SOURCE(name="fadvenfa/fatdiari",COLUMN(type=decimal,name="fadvenfa.vfac_g_financiero",dbtype="decimal(2,0)",key=yes,nulls_allowed=no)
 COLUMN(type=decimal,name="fadvenfa.vfac_empresa",dbtype="decimal(3,0)",key=yes,nulls_allowed=no)
 COLUMN(type=char,name="fadvenfa.vfac_tipo",dbtype="char(3)",key=yes,nulls_allowed=no)
 COLUMN(type=varchar,name="fadvenfa.vfac_no_pedido",dbtype="varchar(8)",key=yes,nulls_allowed=no)
 COLUMN(type=decimal,name="fadvenfa.vfac_ann",dbtype="decimal(4,0)",key=yes,nulls_allowed=no)
 COLUMN(type=decimal,name="fadvenfa.vfac_vendedor",dbtype="decimal(3,0)",key=yes,nulls_allowed=no))
RETRIEVE(statement="PBSELECT( VERSION(400) TABLE(NAME=~"fadvenfa~" )  TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fadvenfa.vfac_g_financiero~") COLUMN(NAME=~"fadvenfa.vfac_empresa~") COLUMN(NAME=~"fadvenfa.vfac_tipo~") COLUMN(NAME=~"fadvenfa.vfac_no_pedido~") COLUMN(NAME=~"fadvenfa.vfac_ann~") COLUMN(NAME=~"fadvenfa.vfac_vendedor~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"fadvenfa.vfac_ann~" )WHERE(    EXP1 =~"fatdiari.fact_fecha~"   OP =~">=~"    EXP2 =~"'03/01/2015'~" ) ) ")
DESTINATION(name="aaa_fadvenfa",COLUMN(type=decimal,name="vfac_g_financiero",dbtype="decimal(2,0)",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=decimal,name="vfac_empresa",dbtype="decimal(3,0)",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=char,name="vfac_tipo",dbtype="char(3)",key=yes,nulls_allowed=no,initial_value="spaces")
 COLUMN(type=varchar,name="vfac_no_pedido",dbtype="varchar(8)",key=yes,nulls_allowed=no,initial_value="spaces")
 COLUMN(type=decimal,name="vfac_ann",dbtype="decimal(4,0)",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=decimal,name="vfac_vendedor",dbtype="decimal(3,0)",key=yes,nulls_allowed=no,initial_value="0"))
