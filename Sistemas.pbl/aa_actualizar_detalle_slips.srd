 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"cctslips~" ) COLUMN(NAME=~"cctslips.slip_g_financiero~") COLUMN(NAME=~"cctslips.slip_empresa~") COLUMN(NAME=~"cctslips.slip_documento~") COLUMN(NAME=~"cctslips.slip_referencia~") COLUMN(NAME=~"cctslips.slip_ann~") COLUMN(NAME=~"cctslips.slip_banco~") COLUMN(NAME=~"cctslips.slip_cuenta~") COLUMN(NAME=~"cctslips.slip_fecha~") COLUMN(NAME=~"cctslips.slip_observacion~") COLUMN(NAME=~"cctslips.slip_monto~") COLUMN(NAME=~"cctslips.slip_id~")WHERE(    EXP1 =~"cctslips.slip_empresa~"   OP =~"=~"    EXP2 =~":emp~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"cctslips.slip_documento~"   OP =~">=~"    EXP2 =~"0~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"cctslips.slip_estado~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"emp~" TYPE = number) " update="cctslips" updatewhere=1 updatekeyinplace=no arguments=(("emp", number))  sort="slip_documento A " )
