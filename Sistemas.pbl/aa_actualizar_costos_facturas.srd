 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"coddiari~" ) COLUMN(NAME=~"coddiari.ddia_monto~") COLUMN(NAME=~"coddiari.ddia_naturaleza~") COLUMN(NAME=~"coddiari.ddia_no_documento~") COLUMN(NAME=~"coddiari.ddia_no_referencia~") COLUMN(NAME=~"coddiari.ddia_fecha~")WHERE(    EXP1 =~"coddiari.ddia_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_aplicacion_mg~"   OP =~"=~"    EXP2 =~"'FA'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'CV'~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_no_documento~"   OP =~"=~"    EXP2 =~":factura~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"coddiari.ddia_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"factura~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " arguments=(("grupo", number),("empresa", number),("factura", string),("ann", number)) )
