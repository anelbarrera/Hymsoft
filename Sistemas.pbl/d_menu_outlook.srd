//objectcomments  
release 10;
datawindow(units=0 timer_interval=0 color=16777215 processing=0 HTMLDW=no grid.lines=0 )
header(height=0 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=92 color="536870912" )
table(column=(type=long updatewhereclause=yes name=tipo dbname="tipo" )
 column=(type=long updatewhereclause=yes name=cat_id dbname="cat_id" )
 column=(type=long updatewhereclause=yes name=orden dbname="orden" )
 column=(type=char(120) updatewhereclause=yes name=titulo dbname="titulo" )
 column=(type=char(80) updatewhereclause=yes name=ventana dbname="ventana" )
 column=(type=char(20) updatewhereclause=yes name=icono dbname="icono" )
 column=(type=long updatewhereclause=yes name=is_hover dbname="is_hover" )
 column=(type=long updatewhereclause=yes name=is_selected dbname="is_selected" )
 column=(type=long updatewhereclause=yes name=is_expanded dbname="is_expanded" )
 sort="cat_id A, orden A " )
rectangle(band=detail x="0" y="0" height="92" width="1200"  name=r_bg visible="1" brush.hatch="7" brush.color="if(tipo = 1, rgb(30, 41, 59), if(is_selected = 1, rgb(239, 246, 255), if(is_hover = 1, rgb(241, 245, 249), rgb(255, 255, 255))))" pen.style="5" pen.width="0" pen.color="0"  background.mode="2" background.color="1073741824" )
rectangle(band=detail x="0" y="4" height="84" width="10"  name=r_accent visible="if(tipo = 2 and is_selected = 1, 1, 0)" brush.hatch="7" brush.color="rgb(37, 99, 235)" pen.style="5" pen.width="0" pen.color="0"  background.mode="2" background.color="1073741824" )
compute(band=detail alignment="0" expression="if(tipo = 1, if(is_expanded = 1, '▾', '▸'), '')"border="0" color="rgb(148, 163, 184)" x="20" y="16" height="60" width="40" format="[general]" name=c_chevron visible="if(tipo = 1, 1, 0)" font.face="Segoe UI" font.height="-10" font.weight="700" background.mode="1" )
compute(band=detail alignment="0" expression="icono" border="0" color="if(tipo = 1, rgb(255, 255, 255), if(is_selected = 1, rgb(37, 99, 235), rgb(100, 116, 139)))" x="65" y="14" height="64" width="70" format="[general]" name=c_icono visible="1" font.face="Segoe UI Emoji" font.height="-10" font.weight="400" background.mode="1" )
compute(band=detail alignment="0" expression="titulo" border="0" color="if(tipo = 1, rgb(255, 255, 255), if(is_selected = 1, rgb(30, 58, 138), rgb(51, 65, 85)))" x="145" y="16" height="60" width="950" format="[general]" name=c_titulo visible="1" font.face="Segoe UI" font.height="-9" font.weight="if(tipo = 1 or is_selected = 1, 700, 400)" background.mode="1" pointer="HyperLink!" )
line(band=detail x1="0" y1="91" x2="1200" y2="91"  name=l_sep visible="if(tipo = 1, 0, 1)" pen.style="0" pen.width="1" pen.color="16119285" background.mode="2" )