PIPELINE(source_connect=FOSTER,destination_connect=FOSTER,type=update,commit=100,errors=100,keyname="aaa_fadcargo")
SOURCE(name="fadcargo/fatdiari",COLUMN(type=decimal,name="fadcargo.dcar_g_financiero",dbtype="decimal(2,0)",key=yes,nulls_allowed=no)
 COLUMN(type=decimal,name="fadcargo.dcar_empresa",dbtype="decimal(3,0)",key=yes,nulls_allowed=no)
 COLUMN(type=char,name="fadcargo.dcar_tipo",dbtype="char(3)",key=yes,nulls_allowed=no)
 COLUMN(type=varchar,name="fadcargo.dcar_no_pedido",dbtype="varchar(8)",key=yes,nulls_allowed=no)
 COLUMN(type=decimal,name="fadcargo.dcar_ann",dbtype="decimal(4,0)",key=yes,nulls_allowed=no)
 COLUMN(type=decimal,name="fadcargo.dcar_codigo",dbtype="decimal(3,0)",key=yes,nulls_allowed=no)
 COLUMN(type=money,name="fadcargo.dcar_monto",dbtype="money",nulls_allowed=no)
 COLUMN(type=money,name="fadcargo.dcar_monto_subf",dbtype="money",nulls_allowed=yes))
RETRIEVE(statement="PBSELECT( VERSION(400) TABLE(NAME=~"fadcargo~" )  TABLE(NAME=~"fatdiari~" ) COLUMN(NAME=~"fadcargo.dcar_g_financiero~") COLUMN(NAME=~"fadcargo.dcar_empresa~") COLUMN(NAME=~"fadcargo.dcar_tipo~") COLUMN(NAME=~"fadcargo.dcar_no_pedido~") COLUMN(NAME=~"fadcargo.dcar_ann~") COLUMN(NAME=~"fadcargo.dcar_codigo~") COLUMN(NAME=~"fadcargo.dcar_monto~") COLUMN(NAME=~"fadcargo.dcar_monto_subf~")    JOIN (LEFT=~"fatdiari.fact_g_financiero~"    OP =~"=~"RIGHT=~"fadcargo.dcar_g_financiero~" )    JOIN (LEFT=~"fatdiari.fact_empresa~"    OP =~"=~"RIGHT=~"fadcargo.dcar_empresa~" )    JOIN (LEFT=~"fatdiari.fact_tipo~"    OP =~"=~"RIGHT=~"fadcargo.dcar_tipo~" )    JOIN (LEFT=~"fatdiari.fact_no_pedido~"    OP =~"=~"RIGHT=~"fadcargo.dcar_no_pedido~" )    JOIN (LEFT=~"fatdiari.fact_ann~"    OP =~"=~"RIGHT=~"fadcargo.dcar_ann~" )WHERE(    EXP1 =~"fatdiari.fact_fecha_creacion~"   OP =~">=~"    EXP2 =~"'03/27/2015'~" ) )")
DESTINATION(name="aaa_fadcargo",COLUMN(type=decimal,name="dcar_g_financiero",dbtype="decimal(2,0)",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=decimal,name="dcar_empresa",dbtype="decimal(3,0)",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=char,name="dcar_tipo",dbtype="char(3)",key=yes,nulls_allowed=no,initial_value="spaces")
 COLUMN(type=varchar,name="dcar_no_pedido",dbtype="varchar(8)",key=yes,nulls_allowed=no,initial_value="spaces")
 COLUMN(type=decimal,name="dcar_ann",dbtype="decimal(4,0)",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=decimal,name="dcar_codigo",dbtype="decimal(3,0)",key=yes,nulls_allowed=no,initial_value="0")
 COLUMN(type=money,name="dcar_monto",dbtype="money",nulls_allowed=no,initial_value="0")
 COLUMN(type=money,name="dcar_monto_subf",dbtype="money",nulls_allowed=yes))
