table(column=(type=decimal(4) update=yes updatewhereclause=yes name=tmov_total_cargos dbname="intmovim.tmov_total_cargos" dbalias=".tmov_total_cargos" )
 column=(type=decimal(4) update=yes updatewhereclause=yes name=tmov_total_cargos_final dbname="intmovim.tmov_total_cargos_final" dbalias=".tmov_total_cargos_final" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=tmov_g_financiero dbname="intmovim.tmov_g_financiero" dbalias=".tmov_g_financiero" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=tmov_empresa dbname="intmovim.tmov_empresa" dbalias=".tmov_empresa" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=tmov_aplicacion dbname="intmovim.tmov_aplicacion" dbalias=".tmov_aplicacion" )
 column=(type=char(2) update=yes updatewhereclause=yes key=yes name=tmov_tipo_transaccion dbname="intmovim.tmov_tipo_transaccion" dbalias=".tmov_tipo_transaccion" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=tmov_secuencia dbname="intmovim.tmov_secuencia" dbalias=".tmov_secuencia" )
 column=(type=char(3) update=yes updatewhereclause=yes key=yes name=tmov_concepto dbname="intmovim.tmov_concepto" dbalias=".tmov_concepto" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=tmov_anual dbname="intmovim.tmov_anual" dbalias=".tmov_anual" )
 column=(type=char(30) update=yes updatewhereclause=yes name=tmov_descripcion dbname="intmovim.tmov_descripcion" dbalias=".tmov_descripcion" )
 column=(type=datetime update=yes updatewhereclause=yes name=tmov_fecha dbname="intmovim.tmov_fecha" dbalias=".tmov_fecha" )
 column=(type=char(18) update=yes updatewhereclause=yes name=tmov_documento dbname="intmovim.tmov_documento" dbalias=".tmov_documento" )
 column=(type=decimal(0) update=yes updatewhereclause=yes name=tmov_terceros dbname="intmovim.tmov_terceros" dbalias=".tmov_terceros" )
 column=(type=char(200) update=yes updatewhereclause=yes name=tmov_comentario dbname="intmovim.tmov_comentario" dbalias=".tmov_comentario" )
 column=(type=decimal(14) update=yes updatewhereclause=yes name=valor dbname="valor" )
 column=(type=char(15) updatewhereclause=yes name=tmov_documento_entrada dbname="intmovim.tmov_documento_entrada" dbalias=".tmov_documento_entrada" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"intmovim~" ) COLUMN(NAME=~"intmovim.tmov_total_cargos~") COLUMN(NAME=~"intmovim.tmov_total_cargos_final~") COLUMN(NAME=~"intmovim.tmov_g_financiero~") COLUMN(NAME=~"intmovim.tmov_empresa~") COLUMN(NAME=~"intmovim.tmov_aplicacion~") COLUMN(NAME=~"intmovim.tmov_tipo_transaccion~") COLUMN(NAME=~"intmovim.tmov_secuencia~") COLUMN(NAME=~"intmovim.tmov_concepto~") COLUMN(NAME=~"intmovim.tmov_anual~") COLUMN(NAME=~"intmovim.tmov_descripcion~") COLUMN(NAME=~"intmovim.tmov_fecha~") COLUMN(NAME=~"intmovim.tmov_documento~") COLUMN(NAME=~"intmovim.tmov_terceros~") COLUMN(NAME=~"intmovim.tmov_comentario~") COMPUTE(NAME=~"valor = (select round(sum(dmov_costo_fob * dmov_cantidad),2) from    indmovim  WHERE ( indmovim.dmov_g_financiero = intmovim.tmov_g_financiero ) and  ( indmovim.dmov_empresa = intmovim.tmov_empresa ) and  ( indmovim.dmov_aplicacion = intmovim.tmov_aplicacion ) and  ( indmovim.dmov_tipo_transaccion = intmovim.tmov_tipo_transaccion ) and  ( indmovim.dmov_secuencia = intmovim.tmov_secuencia ) and  ( indmovim.dmov_anual = intmovim.tmov_anual ) and  ( indmovim.dmov_concepto = intmovim.tmov_concepto ) )~") COLUMN(NAME=~"intmovim.tmov_documento_entrada~")WHERE(    EXP1 =~"intmovim.tmov_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"intmovim.tmov_tipo_transaccion~"   OP =~"=~"    EXP2 =~"'EN'~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"intmovim.tmov_fecha~"   OP =~">=~"    EXP2 =~"'01/01/2025'~" ) ) ARG(NAME = ~"empresa~" TYPE = number) " update="intmovim" updatewhere=1 updatekeyinplace=no arguments=(("empresa", number))  sort="tmov_secuencia A " )
