 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"pedidos_detalle~" ) COLUMN(NAME=~"pedidos_detalle.dped_g_financiero~") COLUMN(NAME=~"pedidos_detalle.dped_empresa~") COLUMN(NAME=~"pedidos_detalle.dped_no_pedido~") COLUMN(NAME=~"pedidos_detalle.dped_ann~") COLUMN(NAME=~"pedidos_detalle.dped_linea~") COLUMN(NAME=~"pedidos_detalle.dped_producto~") COLUMN(NAME=~"pedidos_detalle.dped_descripcion~") COLUMN(NAME=~"pedidos_detalle.dped_precio~") COLUMN(NAME=~"pedidos_detalle.dped_cantidad~") COLUMN(NAME=~"pedidos_detalle.dped_monto~") COLUMN(NAME=~"pedidos_detalle.dped_bultos~") COLUMN(NAME=~"pedidos_detalle.dped_peso~") COLUMN(NAME=~"pedidos_detalle.dped_cubicaje~")WHERE(    EXP1 =~"pedidos_detalle.dped_g_financiero~"   OP =~"=~"    EXP2 =~":grupo~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"pedidos_detalle.dped_empresa~"   OP =~"=~"    EXP2 =~":empresa~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"pedidos_detalle.dped_no_pedido~"   OP =~"=~"    EXP2 =~":pedido~"    LOGIC =~"And~" ) WHERE(    EXP1 =~"pedidos_detalle.dped_ann~"   OP =~"=~"    EXP2 =~":ann~" ) ) ARG(NAME = ~"grupo~" TYPE = number)  ARG(NAME = ~"empresa~" TYPE = number)  ARG(NAME = ~"pedido~" TYPE = string)  ARG(NAME = ~"ann~" TYPE = number) " update="pedidos_detalle" updatewhere=1 updatekeyinplace=no arguments=(("grupo", number),("empresa", number),("pedido", string),("ann", number)) )
