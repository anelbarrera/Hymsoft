table(column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=prod_g_financiero dbname="inmprodu.prod_g_financiero" dbalias=".prod_g_financiero" initial="0" )
 column=(type=decimal(0) update=yes updatewhereclause=yes key=yes name=prod_empresa dbname="inmprodu.prod_empresa" dbalias=".prod_empresa" initial="0" )
 column=(type=char(20) update=yes updatewhereclause=yes key=yes name=prod_producto dbname="inmprodu.prod_producto" dbalias=".prod_producto" initial="empty" )
 column=(type=char(65) update=yes updatewhereclause=yes name=prod_descripcion dbname="inmprodu.prod_descripcion" dbalias=".prod_descripcion" initial="empty" )
 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inmprodu~" ) COLUMN(NAME=~"inmprodu.prod_g_financiero~") COLUMN(NAME=~"inmprodu.prod_empresa~") COLUMN(NAME=~"inmprodu.prod_producto~") COLUMN(NAME=~"inmprodu.prod_descripcion~")WHERE(    EXP1 =~"inmprodu.prod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_inmprodu~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_empresa~"   OP =~"=~"    EXP2 =~":empresa_inmprodu~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmprodu.prod_status~"   OP =~"=~"    EXP2 =~"1~" ) ) ARG(NAME = ~"grupo_inmprodu~" TYPE = number)  ARG(NAME = ~"empresa_inmprodu~" TYPE = number) " update="inmprodu" updatewhere=1 updatekeyinplace=no arguments=(("grupo_inmprodu", number),("empresa_inmprodu", number))  sort="prod_producto A " )
