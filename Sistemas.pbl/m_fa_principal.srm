//objectcomments Menu Principal de Facturacion (Menu de las Ventanas)
forward
global type m_fa_principal from m_fa_padre
end type
end forward

global type m_fa_principal from m_fa_padre
end type
global m_fa_principal m_fa_principal

forward prototypes
public subroutine mf_set_menu (string tipo_serv_pro)
end prototypes

public subroutine mf_set_menu (string tipo_serv_pro);If not IsValid(m_fa_principal) Then 
	w_fa_frame.changemenu(m_fa_principal)
End If
end subroutine

on m_fa_principal.create
m_fa_principal=this
call super::create
end on

on m_fa_principal.destroy
call super::destroy
end on

type m_archivo from m_fa_padre`m_archivo within m_fa_principal
end type

on m_archivo.create
