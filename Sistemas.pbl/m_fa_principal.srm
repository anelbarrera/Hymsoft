type m_cerrar from m_fa_padre`m_cerrar within m_archivo
end type

event m_cerrar::clicked;call super::clicked;close(parentwindow)
end event

on m_cerrar.create
call super::create
this.tag = "m_fa_principal.m_archivo.m_cerrar"
this.visible = true
this.microhelp = "Cierra la Ventana"
this.toolbaritemname = "custom009!"
this.toolbaritemdownname = "RunSCC!"
this.menuimage = "custom009!"
this.menuanimation = true
end on

on m_cerrar.destroy
call super::destroy
end on

