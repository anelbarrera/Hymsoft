 retrieve="PBSELECT( VERSION(400) TABLE(NAME=~"inabodeg~" )  TABLE(NAME=~"inmbodeg~" ) COLUMN(NAME=~"inabodeg.abod_g_financiero~") COLUMN(NAME=~"inabodeg.abod_empresa~") COLUMN(NAME=~"inabodeg.abod_descripcion~") COLUMN(NAME=~"inabodeg.abod_bodega~") COLUMN(NAME=~"inmbodeg.mbod_ubicacion~") COLUMN(NAME=~"inmbodeg.mbod_cantidad~") COLUMN(NAME=~"inmbodeg.mbod_reserva~") COMPUTE(NAME=~"0 exist_frac, 0 res_frac,  0 disp_frac , 0 uni_coversion~")    JOIN (LEFT=~"inmbodeg.mbod_g_financiero~"    OP =~"=~"RIGHT=~"inabodeg.abod_g_financiero~" )    JOIN (LEFT=~"inmbodeg.mbod_empresa~"    OP =~"=~"RIGHT=~"inabodeg.abod_empresa~" )    JOIN (LEFT=~"inmbodeg.mbod_bodega~"    OP =~"=~"RIGHT=~"inabodeg.abod_bodega~" )WHERE(    EXP1 =~"inabodeg.abod_g_financiero~"   OP =~"=~"    EXP2 =~":grupo_b~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inabodeg.abod_empresa~"   OP =~"=~"    EXP2 =~":empresa_b~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmbodeg.mbod_producto~"   OP =~"=~"    EXP2 =~":producto_b~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmbodeg.mbod_bodega~"   OP =~"=~"    EXP2 =~":bodega_b~"    LOGIC =~"and~" ) WHERE(    EXP1 =~"inmbodeg.mbod_cantidad~"   OP =~"<>~"    EXP2 =~"0~" ) ) ARG(NAME = ~"grupo_b~" TYPE = number)  ARG(NAME = ~"empresa_b~" TYPE = number)  ARG(NAME = ~"producto_b~" TYPE = string)  ARG(NAME = ~"bodega_b~" TYPE = string) " arguments=(("grupo_b", number),("empresa_b", number),("producto_b", string),("bodega_b", string)) )
